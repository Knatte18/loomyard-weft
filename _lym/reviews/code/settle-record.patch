+					return call.Text == apiErrorRetryLine
+				}) {
+					t.Errorf("texts typed = %v; want no API-error re-send", h.reed.SendTextCalls)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			h := newWaitRelaunchHarness(t, tt)
