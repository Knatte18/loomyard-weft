diff --git a/internal/testkit/permkit/permkit.go b/internal/testkit/permkit/permkit.go
new file mode 100644
index 00000000..2417a918
--- /dev/null
+++ b/internal/testkit/permkit/permkit.go
@@ -0,0 +1,29 @@
+// Package permkit changes a test path's permission bits for the length of one test.
+//
+// A test that needs a read-only or unreadable path takes it from Chmod,
+// so the restore that lets the test's temp tree be removed is registered in one place.
+// A test binary killed before its cleanups run leaves the path as Chmod set it;
+// the dead-owner sweep of the lym temp root makes such a tree owner-writable before it removes it.
+// The kit imports the standard library only.
+package permkit
+
+import (
+	"io/fs"
+	"os"
+	"testing"
+)
+
+// Chmod sets path's permission bits to mode and registers a cleanup that restores the bits path had before.
+// It fails the test when path cannot be read or changed.
+// The restore drops its own error, so a test may remove path itself before it ends.
+func Chmod(tb testing.TB, path string, mode fs.FileMode) {
+	tb.Helper()
+	info, err := os.Stat(path)
+	if err != nil {
+		tb.Fatalf("permkit: stat %s: %v", path, err)
+	}
+	if err := os.Chmod(path, mode); err != nil {
+		tb.Fatalf("permkit: chmod %s to %v: %v", path, mode, err)
+	}
+	tb.Cleanup(func() { _ = os.Chmod(path, info.Mode().Perm()) })
+}
diff --git a/internal/testkit/permkit/permkit_test.go b/internal/testkit/permkit/permkit_test.go
new file mode 100644
index 00000000..485bc01a
--- /dev/null
+++ b/internal/testkit/permkit/permkit_test.go
@@ -0,0 +1,49 @@
+package permkit_test
+
+import (
+	"io/fs"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/permkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestChmod_SetsTheModeAndRestoresItAtCleanup(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("Windows keeps only the owner write bit of a mode")
+	}
+	dir := filepath.Join(t.TempDir(), "dir")
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		t.Fatalf("Mkdir(%s): %v", dir, err)
+	}
+	const before fs.FileMode = 0o750
+	if err := os.Chmod(dir, before); err != nil {
+		t.Fatalf("Chmod(%s): %v", dir, err)
+	}
+
+	// Not parallel: the outer test reads the mode once the subtest's cleanups have run.
+	t.Run("Inside", func(t *testing.T) {
+		permkit.Chmod(t, dir, 0o555)
+		if got := permOf(t, dir); got != 0o555 {
+			t.Errorf("mode inside the test = %v; want %v", got, fs.FileMode(0o555))
+		}
+	})
+	if got := permOf(t, dir); got != before {
+		t.Errorf("mode after the test = %v; want %v", got, before)
+	}
+}
+
+// permOf returns path's permission bits.
+func permOf(t *testing.T, path string) fs.FileMode {
+	t.Helper()
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("Stat(%s): %v", path, err)
+	}
+	return info.Mode().Perm()
+}
