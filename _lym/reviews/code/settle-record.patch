+			if got.ComparedHead != recheckComparedHead || !got.ComparePassed {
+				t.Errorf("profile head %q: compared head %q, passed %v; want the earlier compare untouched", profileHead, got.ComparedHead, got.ComparePassed)
+			}
+		}
+	})
+}
