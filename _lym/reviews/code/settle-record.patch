+++ b/internal/fabriclayout/origin_test.go
@@ -0,0 +1,67 @@
+// origin_test.go — unit tests for the Origin provenance record type.
+
+package fabriclayout_test
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabriclayout"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestOrigin_JSONRoundTrip asserts that Origin marshals and unmarshals its parent_branch and parent_worktree wire keys.
+// A record without the parent_worktree key still decodes, with that field empty.
+//
+//testtiming:keep Origin's parent_branch and parent_worktree wire keys round-tripping and a legacy record decoding with an empty ParentWorktree; coverage of its blocks by other tests does not show an assertion of this
+func TestOrigin_JSONRoundTrip(t *testing.T) {
+	tiergate.Require(t, 0)
+	tests := []struct {
+		name    string
+		want    fabriclayout.Origin
+		wantKey string
+	}{
+		{"parent_branch", fabriclayout.Origin{ParentBranch: "main"}, `"parent_branch":"main"`},
+		{"parent_worktree", fabriclayout.Origin{ParentBranch: "main", ParentWorktree: "prime"}, `"parent_worktree":"prime"`},
+		{"beam", fabriclayout.Origin{ParentBranch: "main", Beam: true}, `"beam":true`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			data, err := json.Marshal(tt.want)
+			if err != nil {
+				t.Fatalf("Marshal() error = %v", err)
+			}
+			if !strings.Contains(string(data), tt.wantKey) {
+				t.Errorf("Marshal() = %s; want it to contain %s", data, tt.wantKey)
+			}
+
+			var got fabriclayout.Origin
+			if err := json.Unmarshal(data, &got); err != nil {
+				t.Fatalf("Unmarshal() error = %v", err)
+			}
+			if got != tt.want {
+				t.Errorf("Unmarshal() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+
+	var legacy fabriclayout.Origin
+	if err := json.Unmarshal([]byte(`{"parent_branch":"main"}`), &legacy); err != nil {
+		t.Fatalf("Unmarshal(legacy) error = %v", err)
+	}
+	if legacy.ParentWorktree != "" {
+		t.Errorf("legacy ParentWorktree = %q; want empty", legacy.ParentWorktree)
+	}
+	if legacy.Beam {
+		t.Errorf("legacy Beam = true; want false")
+	}
+
+	data, err := json.Marshal(fabriclayout.Origin{ParentBranch: "main"})
+	if err != nil {
+		t.Fatalf("Marshal(no beam) error = %v", err)
+	}
+	if strings.Contains(string(data), `"beam"`) {
+		t.Errorf("Marshal(no beam) = %s; want no beam key", data)
+	}
+}
diff --git a/internal/fabriclayout/origintypes.go b/internal/fabriclayout/origintypes.go
new file mode 100644
index 000000000..f437d0163
--- /dev/null
+++ b/internal/fabriclayout/origintypes.go
@@ -0,0 +1,414 @@
+// origintypes.go holds plain result types and the pure methods that read them.
+// They carry what the origin reconcile, the parent tips, the teardown, the hand-over and the records replay report.
+
+package fabriclayout
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+// cleanupRerun is the re-entry a printed stop of a dirty, gone or busy branch appends to its way forward.
+const cleanupRerun = "then re-run lym cleanup --apply from the prime"
+
+// ReconcileScope names what one reconcile judges.
+// An empty Run is the hub scope: Bolt, the prime's code and records branches, and those of every local pair.
+// A slug is the run scope: Bolt, the run's parent branch on both sides, read from the pair's origin record;
+// the run's own pair is judged too.
+// JudgeOnly judges and fetches objects but moves no ref, for a dry run.
+// PairMayBeAbsent is meaningful only with Run set.
+// It lets the run scope judge a run whose task worktree is not a registered worktree of the code repository.
+// It also covers a task worktree that is registered with its directory gone.
+// Such a run's entry is judged from origin's board, with no branch of its own and no parent branch.
+// Otherwise the reconcile refuses the run.
+type ReconcileScope struct {
+	Run             string
+	JudgeOnly       bool
+	PairMayBeAbsent bool
+}
+
+// EndedTeardown asks the teardown seam to remove the local pair of an entry origin has ended.
+// Force marks the case where the pair's uncommitted work is snapshotted and removed instead of refusing the removal.
+// EarlierSnapshot is set when the weft repository already holds a snapshot tag of the slug.
+// An earlier force-case run leaves such a tag.
+type EndedTeardown struct {
+	Slug            string
+	Force           bool
+	EarlierSnapshot bool
+}
+
+// The values a busy teardown waits on.
+const (
+	// BusyOnDriver means the pair's driver is still running.
+	BusyOnDriver = "driver"
+	// BusyOnLock means the teardown lock, the weft write lock or a detached push holds the pair.
+	BusyOnLock = "lock"
+)
+
+// TeardownReport is what the teardown seam reports about one removal.
+// It holds the tags the removal kept work under and the reasons it kept anything.
+// It also holds whether the removal was busy and the error it stopped on.
+// BusyOn names what a busy removal waits on, BusyOnDriver or BusyOnLock.
+// It embeds MutationRecord, filled from the removal's own record.
+type TeardownReport struct {
+	MutationRecord
+	Tags   []string
+	Kept   []string
+	Busy   bool
+	BusyOn string
+	Error  error
+}
+
+// BranchState is the verdict on one local branch against origin's head for it.
+type BranchState string
+
+// The verdicts, the first group from judging alone and the rest from the moves that follow it.
+const (
+	// BranchLevel means the branch and origin's head are the same commit.
+	BranchLevel BranchState = "level"
+	// BranchFastForward means the local tip is an ancestor of origin's head and nothing local is lost by moving to it.
+	BranchFastForward BranchState = "fast_forward"
+	// BranchAhead means origin's head is an ancestor of the local tip.
+	BranchAhead BranchState = "ahead"
+	// BranchRewound means origin reset the branch back past commits this machine holds.
+	BranchRewound BranchState = "rewound"
+	// BranchRewritten means origin replaced the branch's history with commits this machine never held.
+	BranchRewritten BranchState = "rewritten"
+	// BranchDiverged means a code branch both sides moved, or a records branch whose replay stopped on a conflict.
+	BranchDiverged BranchState = "diverged"
+	// BranchNeedsReplay means a records branch both sides moved, which a moving reconcile replays.
+	BranchNeedsReplay BranchState = "needs_replay"
+	// BranchGone means origin no longer has the branch.
+	BranchGone BranchState = "gone"
+	// BranchDirty means an uncommitted change blocks the move.
+	BranchDirty BranchState = "dirty"
+	// BranchBusy means a lock on the branch is held.
+	BranchBusy BranchState = "busy"
+	// BranchLive means the branch belongs to a pair that is live, which a reconcile never moves.
+	BranchLive BranchState = "live"
+	// BranchAnchorStopped means a weft branch was left unmoved.
+	// Taking origin's tip in would cross a change of its anchor marker, or its own marker is empty.
+	BranchAnchorStopped BranchState = "anchor_stopped"
+)
+
+// Stops reports whether a branch in this state stops its entry or the scope.
+func (s BranchState) Stops() bool {
+	switch s {
+	case BranchRewound, BranchRewritten, BranchDiverged, BranchGone, BranchDirty, BranchBusy, BranchLive, BranchAnchorStopped:
+		return true
+	}
+	return false
+}
+
+// BranchOutcome is the verdict on one judged branch, with what a reader of a stop needs.
+// Repo is the repository side: "code", "records" or "bolt".
+// Worktree is where the branch is checked out;
+// CodeWorktree is the pair's code worktree, where every fabric verb of a records branch runs.
+// Paths are the conflicting or dirty paths, and Commits those a rewind dropped or a replay stopped on.
+// BusyLock names the held lock of a busy branch;
+// PushLockHeld is set when it was the push lock, which a parked push holds.
+// WayForward is the one line every reader of a stop takes, the repair step alone, with no re-entry verb.
+// Anchor is the anchor an anchor_stopped branch's way forward names;
+// it is empty when the stop is the weft's own empty marker.
+// MoveWayForward is the way forward of an anchor_stopped branch whose weft carries a move record;
+// it replaces the one the anchor would name.
+// Moved is set by a moving reconcile once it brought the branch up to origin's head.
+// State then reads level, or ahead when replayed commits sit on it.
+// Warning is the text of a failed worktree event fired for a code branch the reconcile moved, empty otherwise.
+type BranchOutcome struct {
+	Branch         string
+	Repo           string
+	Slug           string
+	Prime          bool
+	Worktree       string
+	CodeWorktree   string
+	State          BranchState
+	OriginHead     string
+	Paths          []string
+	Commits        []string
+	BusyLock       string
+	PushLockHeld   bool
+	WayForward     string
+	Anchor         string
+	MoveWayForward string
+	Moved          bool
+	Warning        string
+}
+
+// rerunsCleanup reports whether the way forward of this stop is followed by a re-run of `lym cleanup --apply`.
+func (b BranchOutcome) rerunsCleanup() bool {
+	switch b.State {
+	case BranchDirty, BranchGone:
+		return true
+	case BranchBusy:
+		return !b.PushLockHeld
+	}
+	return false
+}
+
+// EntryState is the verdict on one entry, the run a pair carries.
+type EntryState string
+
+// The verdicts of an entry.
+const (
+	// EntryActive means nothing about the entry stops it.
+	EntryActive EntryState = "active"
+	// EntryEnded means origin's board shows the entry done or removed.
+	EntryEnded EntryState = "ended"
+	// EntryStopped means a branch of the entry or a records stop keeps it from carrying on.
+	EntryStopped EntryState = "stopped"
+	// EntryOwnedElsewhere means origin's board records another machine as the entry's owner.
+	EntryOwnedElsewhere EntryState = "owned_elsewhere"
+)
+
+// EntryOutcome is the verdict a reconcile reaches on one judged entry.
+// Busy marks an ended entry whose driver or branch is busy, so its pair is not yet removed;
+// WayForward then names what lets the next run remove it.
+// An ended entry also carries How origin ended it, "done" or "removed";
+// Local is set when this machine holds a part of its pair.
+// Removed is set once the teardown removed that pair, with the Tags it kept work under and the reasons it Kept anything.
+// Error is the message of a teardown that failed for any reason other than being busy.
+// The pair is left for a later `lym cleanup --apply`.
+// Owner names the machine that owns an owned_elsewhere entry.
+// AdoptSubject is the beam or `root` that `lym adopt` takes to move it; an empty AdoptSubject reads as the slug.
+// PairAbsent marks the run scope's own entry when its task worktree was not a registered worktree,
+// so the entry was judged with no branch of its own.
+type EntryOutcome struct {
+	Slug         string
+	State        EntryState
+	Owner        string
+	AdoptSubject string
+	Busy         bool
+	WayForward   string
+	How          string
+	Local        bool
+	Removed      bool
+	Tags         []string
+	Kept         []string
+	Error        string
+	PairAbsent   bool `json:"pair_absent,omitempty"`
+}
+
+// AdoptTarget returns what `lym adopt` takes to move the entry: AdoptSubject, or the slug when it is empty.
+func (e EntryOutcome) AdoptTarget() string {
+	if e.AdoptSubject == "" {
+		return e.Slug
+	}
+	return e.AdoptSubject
+}
+
+// OriginReport is the outcome of one reconcile: its branch and entry verdicts, and whether origin was reachable.
+// Unreachable means a transport failure outlasted the retry bound, so nothing was judged against origin or moved.
+// It embeds MutationRecord, filled by the moves.
+type OriginReport struct {
+	MutationRecord
+	Unreachable bool
+	Branches    []BranchOutcome
+	Entries     []EntryOutcome
+}
+
+// Summary renders the report in a few lines for an operator.
+// It names what moved, what stopped with its way forward, and which entries another machine owns.
+// It also names which entries ended and whether origin was unreachable.
+// A stop of a dirty, gone or busy-on-a-write-lock branch is followed by the re-entry that retries it.
+// An empty report renders as the empty string.
+func (r OriginReport) Summary() string {
+	var lines []string
+	if r.Unreachable {
+		lines = append(lines, "unreachable: origin could not be reached, so nothing was judged against it or moved")
+	}
+
+	var moved []string
+	for _, branch := range r.Branches {
+		if branch.Moved {
+			moved = append(moved, branch.Branch)
+		}
+	}
+	if len(moved) > 0 {
+		lines = append(lines, "moved: "+strings.Join(moved, ", "))
+	}
+
+	for _, branch := range r.Branches {
+		if branch.Warning != "" {
+			lines = append(lines, fmt.Sprintf("warning: %s: %s", branch.Branch, branch.Warning))
+		}
+	}
+
+	for _, branch := range r.Branches {
+		if !branch.State.Stops() {
+			continue
+		}
+		line := fmt.Sprintf("stopped: %s (%s): %s", branch.Branch, branch.State, branch.WayForward)
+		if branch.rerunsCleanup() {
+			line += "; " + cleanupRerun
+		}
+		lines = append(lines, line)
+	}
+
+	for _, entry := range r.Entries {
+		if entry.State == EntryOwnedElsewhere {
+			lines = append(lines, fmt.Sprintf("owned elsewhere: %s by %s; `lym adopt %s` takes it over", entry.Slug, entry.Owner, entry.AdoptTarget()))
+		}
+	}
+
+	for _, entry := range r.Entries {
+		if entry.PairAbsent {
+			lines = append(lines, fmt.Sprintf("pair absent: %s (%s); its task worktree is gone, so it was judged from origin's board alone", entry.Slug, entry.State))
+		}
+	}
+
+	var ended []string
+	for _, entry := range r.Entries {
+		switch {
+		case entry.State != EntryEnded || !entry.Local:
+		case entry.Busy:
+			lines = append(lines, fmt.Sprintf("ended, not yet removed: %s: %s", entry.Slug, entry.WayForward))
+		case entry.Error != "":
+			lines = append(lines, fmt.Sprintf("ended, not yet removed: %s: %s; a later `lym cleanup --apply` retries the removal", entry.Slug, entry.Error))
+		default:
+			ended = append(ended, entry.Slug)
+		}
+	}
+	if len(ended) > 0 {
+		lines = append(lines, "ended: "+strings.Join(ended, ", "))
+	}
+	return strings.Join(lines, "\n")
+}
+
+// ParentRelation names how a branch's local tip stands to its upstream tip.
+type ParentRelation string
+
+const (
+	// ParentEqual means the local and upstream tips are the same commit.
+	ParentEqual ParentRelation = "equal"
+	// ParentBehind means local is an ancestor of upstream, so a fast-forward reaches upstream.
+	ParentBehind ParentRelation = "behind"
+	// ParentAhead means upstream is an ancestor of local.
+	ParentAhead ParentRelation = "ahead"
+	// ParentDiverged means each tip holds a commit the other lacks.
+	ParentDiverged ParentRelation = "diverged"
+	// ParentNoUpstream means the branch tracks no remote branch, or the tracked one was never fetched.
+	ParentNoUpstream ParentRelation = "no-upstream"
+)
+
+// ParentTips is a branch's local and upstream tips and how they relate.
+type ParentTips struct {
+	// Local is the SHA of refs/heads/<branch>.
+	Local string
+	// Upstream is the SHA of the remote-tracking ref the branch tracks, empty when Relation is ParentNoUpstream.
+	Upstream string
+	// Relation is how Local stands to Upstream.
+	Relation ParentRelation
+}
+
+// FastForwardRefusal names why a fast-forward left the pair unmoved without returning an error.
+type FastForwardRefusal string
+
+const (
+	// FastForwardDirty means the code worktree carries uncommitted tracked changes.
+	FastForwardDirty FastForwardRefusal = "dirty"
+	// FastForwardMergeInProgress means a fabric merge record exists on the pair.
+	FastForwardMergeInProgress FastForwardRefusal = "merge-in-progress"
+	// FastForwardNotFastForward means the local head is not an ancestor of the freshly fetched upstream.
+	FastForwardNotFastForward FastForwardRefusal = "not-fast-forward"
+)
+
+// FastForwardResult reports what a fast-forward did to the pair.
+// It embeds MutationRecord, which is empty on a refusal.
+type FastForwardResult struct {
+	MutationRecord
+	// Refusal is set when the pair was left unmoved, and is empty otherwise.
+	Refusal FastForwardRefusal
+	// NewHead is the upstream SHA the code side moved to, empty when it did not move.
+	NewHead string
+}
+
+// CodeTipReading is what a read of a run's code tip on origin found.
+type CodeTipReading struct {
+	// Tip is the code tip the run's last transition on origin names, empty when origin holds no such transition.
+	Tip string
+	// Missing reports whether origin's fetched code branch lacks Tip.
+	Missing bool
+	// Machine is the machine of the last history entry of the run's child record at that transition.
+	Machine string
+	// At is the commit time of that transition.
+	At time.Time
+}
+
+// PendingTeardown is the record of a remote teardown handed to a detached child.
+// The command writes it before the handover, and the child removes it once the job has run with no failed step.
+// A record whose slug's teardown lock no process holds therefore names a teardown that did not finish:
+// its child ended before the job did, killed outright for instance, or a remote step of the job failed.
+// Either can leave the pair's branches on origin.
+// A record whose pair is gone everywhere stays until it is settled.
+type PendingTeardown struct {
+	Slug     string    `json:"slug"`
+	Kind     string    `json:"kind"`
+	HandedAt time.Time `json:"handed_at"`
+	// Worktree is the code worktree the teardown ran from.
+	Worktree string `json:"worktree,omitempty"`
+	// WeftTip is the local records tip the teardown tagged before it deleted the branch, empty when it found none.
+	WeftTip string `json:"weft_tip,omitempty"`
+	// TaskTip is the local task tip a discard tagged before it deleted the branch, empty when it found none.
+	TaskTip string `json:"task_tip,omitempty"`
+	// Rerun is the command whose re-run retries a discard or a removal, empty when its caller named none.
+	Rerun string `json:"rerun,omitempty"`
+	// WayForward is what finishes the teardown.
+	// A record on disk holds one only once a remote step failed; a listed record always holds one.
+	WayForward string `json:"way_forward,omitempty"`
+}
+
+// HandOverMark records that this machine handed a run over to the machine of a takeover entry.
+type HandOverMark struct {
+	// Machine is the machine the takeover entry names.
+	Machine string `json:"machine"`
+	// At is the time the takeover entry was recorded.
+	At string `json:"at"`
+	// Written is the time this machine wrote the mark.
+	Written time.Time `json:"written"`
+}
+
+// LedgerRun is one run as the run ledger records it.
+// Created is the zero time when the run's creation is unknown.
+type LedgerRun struct {
+	Slug    string
+	Ended   bool
+	Created time.Time
+}
+
+// ReplayFile is one Bolt file a local commit touches, with its bytes at the merge base, before the commit and after it.
+// Path is relative to the Bolt root and slash-separated,
+// and a nil slice means the file is absent at that point.
+type ReplayFile struct {
+	Path   string
+	Base   []byte
+	Before []byte
+	After  []byte
+}
+
+// ReplayRequest is one local commit's changes to a replayer's files, to re-apply onto origin's tip.
+// Dir is the Bolt checkout at origin's tip, and Files holds the commit's files that replayer claims.
+type ReplayRequest struct {
+	Dir   string
+	Files []ReplayFile
+}
+
+// ReplayFinding names one entry-level or file-level change a replay did not apply and why.
+// Field is empty when the whole entry is concerned.
+// Local is the local side's value of the field when it was lost to origin's.
+type ReplayFinding struct {
+	Entry  string
+	Field  string
+	Reason string
+	Local  string
+}
+
+// ReplayResult reports what a replayer applied.
+// Empty is true when no change survived, so nothing was written.
+// Lost holds the local values origin's side won, and Refused the changes the replayer's own checks refused.
+type ReplayResult struct {
+	Empty   bool
+	Lost    []ReplayFinding
+	Refused []ReplayFinding
+}
diff --git a/internal/fabriclayout/pushtypes.go b/internal/fabriclayout/pushtypes.go
new file mode 100644
index 000000000..b1189696b
--- /dev/null
+++ b/internal/fabriclayout/pushtypes.go
@@ -0,0 +1,180 @@
+// pushtypes.go holds the plain data of the push path:
+// the failed-push record and its classes, the push notice, the lock waits, the options and results of a push,
+// and the names of the repository sides.
+
+package fabriclayout
+
+import (
+	"path/filepath"
+	"slices"
+	"time"
+)
+
+// PushFailureClass names why a push did not land.
+type PushFailureClass string
+
+const (
+	// PushFailureNotFastForward means origin holds commits the pushed branch lacks.
+	PushFailureNotFastForward PushFailureClass = "not_fast_forward"
+	// PushFailureTransport means origin could not be reached.
+	PushFailureTransport PushFailureClass = "transport"
+	// PushFailureAuth means origin refused this machine's credentials or permissions.
+	PushFailureAuth PushFailureClass = "auth"
+	// PushFailureGone means origin no longer has the branch.
+	PushFailureGone PushFailureClass = "gone"
+	// PushFailureOther means the push failed for a reason no other class names, so the record carries git's own error.
+	PushFailureOther PushFailureClass = "other"
+	// PushFailureDeferred means the push was held back, not refused, and is retried by the next push of the branch.
+	PushFailureDeferred PushFailureClass = "deferred"
+	// PushFailureTeardownLock means a removal or another push of the pair held its teardown lock past the push's wait.
+	// The push is owed and retried once the lock is free.
+	PushFailureTeardownLock PushFailureClass = "teardown_lock"
+	// PushFailureRewound means origin rewound the branch past commits this machine holds,
+	// so the push is held back instead of restoring them.
+	PushFailureRewound PushFailureClass = "rewound"
+	// PushFailureAnchorChange means the push was held back because the upstream carries another anchor marker than the weft.
+	// It also covers a weft whose own marker is empty.
+	// The record carries the way forward the stop named.
+	PushFailureAnchorChange PushFailureClass = "anchor_change"
+)
+
+// The repository sides a branch outcome or failed-push record names in its Repo field.
+const (
+	// RepoCode is the Repo of a branch of a pair's code repository.
+	RepoCode = "code"
+	// RepoRecords is the Repo of a branch of a pair's records repository.
+	RepoRecords = "records"
+	// RepoBolt is the Repo of a branch of the records repository's board branch.
+	RepoBolt = "bolt"
+)
+
+// FailedPush is the record of a push origin refused, one per repository side and branch.
+// Repo is "code", "records" or "bolt", the last being the records repository's board branch.
+// CodeWorktree is set for a records record only: the pair's code worktree, where every fabric verb runs.
+// Prime marks a code record of the hub prime's own branch.
+// Paths, Commits and OriginHead are set where the failure has them, such as a replay stop or a rewind.
+// WayForward is set for the anchor-change class only, which carries its own commands.
+// Runs names the runs whose pushes failed the record, unioned across failures of one branch.
+type FailedPush struct {
+	Repo         string           `json:"repo"`
+	RepoPath     string           `json:"repo_path"`
+	CodeWorktree string           `json:"code_worktree,omitempty"`
+	Branch       string           `json:"branch"`
+	Prime        bool             `json:"prime,omitempty"`
+	Class        PushFailureClass `json:"class"`
+	Error        string           `json:"error,omitempty"`
+	Paths        []string         `json:"paths,omitempty"`
+	Commits      []string         `json:"commits,omitempty"`
+	OriginHead   string           `json:"origin_head,omitempty"`
+	WayForward   string           `json:"way_forward,omitempty"`
+	Runs         []string         `json:"runs,omitempty"`
+	FirstSeen    time.Time        `json:"first_seen"`
+	LastSeen     time.Time        `json:"last_seen"`
+	Count        int              `json:"count"`
+	Notified     bool             `json:"notified"`
+}
+
+// PairSlug names the pair whose branch f records.
+// It is the base name of the pair's code worktree, which the hub names by its slug.
+// The prime's code branch, the board branch and a records branch with no paired code worktree answer empty.
+// A records branch with a paired code worktree answers that worktree's name.
+// That includes the prime's, since a records record never marks the prime.
+// No pair's teardown shares the prime's name, so none drops that mail.
+func (f FailedPush) PairSlug() string {
+	switch {
+	case f.Repo == RepoRecords && f.CodeWorktree != "":
+		return filepath.Base(f.CodeWorktree)
+	case f.Repo == RepoCode && !f.Prime:
+		return filepath.Base(f.RepoPath)
+	default:
+		return ""
+	}
+}
+
+// PushNotice is the mail a failed push sends the orch.
+type PushNotice struct {
+	// Line names the branch, the class, the error and the way forward.
+	Line string
+	// Topic names the repository side and branch, so a newer notice of the branch replaces one still unread.
+	Topic string
+	// Run is the slug of the pair whose branch failed, empty for the prime's code branch and the board branch.
+	// The pair's teardown drops the notice while it is unread.
+	Run string
+}
+
+// StatusPushLockWait is the wait for the push lock and for the pair's teardown lock.
+// A worktree's pusher and Worktree-Teardown pass it.
+// It is also the default for a pair's teardown lock.
+// It is long enough to ride out a detached push child, and short enough that a stuck holder never stalls a run.
+const StatusPushLockWait = 30 * time.Second
+
+// LockWaitUnbounded is the lockWait value that blocks until the push lock is free.
+const LockWaitUnbounded time.Duration = 0
+
+// MachineNames carries the names that read as this machine.
+// Current is the machine's present name and Former the names it carried before.
+// The caller fills it, since fabric reads no board.
+// The zero value turns the takeover read off.
+type MachineNames struct {
+	Current string
+	Former  []string
+}
+
+// Holds reports whether name is one of the names that read as this machine, its current name or a former one.
+func (n MachineNames) Holds(name string) bool {
+	return name != "" && (name == n.Current || slices.Contains(n.Former, name))
+}
+
+// IsZero reports whether n carries no name, which turns the takeover read off.
+func (n MachineNames) IsZero() bool {
+	return n.Current == "" && len(n.Former) == 0
+}
+
+// PairPush carries what a pair push takes beyond the sync options.
+// LockWait bounds the wait for the push lock, and LockWaitUnbounded blocks.
+// TeardownWait bounds the wait for the pair's teardown lock: zero makes one try, and a longer wait owes the push.
+// RunSlug names the run whose records a rejected prime push reads.
+// Here names this machine, for a takeover read; its zero value turns that read off.
+// OwedUnrecorded returns an owed push's error with no failed-push record, for a caller that retries the owed push itself.
+type PairPush struct {
+	LockWait       time.Duration
+	TeardownWait   time.Duration
+	RunSlug        string
+	Here           MachineNames
+	OwedUnrecorded bool
+}
+
+// PushSpawn is one detached push request.
+// WarpPath and WeftPath name the worktrees to push, either empty to leave that side out.
+// PauseSlug is the slug the child's network calls are held under, empty for the hub's prime.
+// TeardownSlug is the pair whose teardown the child yields to, empty when no teardown can remove what the child pushes.
+// ParentLocked reports that the pair's parent lock was held when the child was spawned;
+// the child never exits for a pause covering it.
+// WorkDir is the directory the child starts in.
+type PushSpawn struct {
+	WarpPath     string
+	WeftPath     string
+	PauseSlug    string
+	TeardownSlug string
+	ParentLocked bool
+	WorkDir      string
+}
+
+// SpawnResult reports what a status push spawn did.
+// Spawned reports whether a child was requested, and Request is what it was asked to push.
+type SpawnResult struct {
+	Spawned bool
+	Request PushSpawn
+}
+
+// PushResult carries the mutation record of a push.
+// Every push returns this type, whatever side it pushes and whatever primitive it uses.
+// That lets a composed push verb concatenate homogeneous records.
+//
+// CodePushSkipped is non-empty only when the push ran in the hub's prime,
+// and it left the code side's unpushed commits alone.
+// It names the branch and says it was left for the operator to push.
+type PushResult struct {
+	MutationRecord
+	CodePushSkipped string `json:"code_push_skipped,omitempty"`
+}
diff --git a/internal/fabriclayout/readtypes.go b/internal/fabriclayout/readtypes.go
new file mode 100644
index 000000000..fe26d1733
--- /dev/null
+++ b/internal/fabriclayout/readtypes.go
@@ -0,0 +1,272 @@
+// readtypes.go holds the plain result types of the read verbs, their constants and pure methods.
+
+package fabriclayout
+
+import "time"
+
+// CheckoutState is the state of one checkout of a pair.
+// Every path list is slash-separated, relative to Root, sorted and never nil.
+type CheckoutState struct {
+	// Root is the checkout's absolute directory.
+	Root string
+	// Head is the checkout's HEAD commit, empty when it has no commit yet.
+	Head string
+	// Changed holds the tracked paths that differ from HEAD, staged, unstaged or deleted.
+	Changed []string
+	// Untracked holds every untracked path outside the ignore rules and `.git/info/exclude`.
+	Untracked []string
+}
+
+// CodeWorktree names one code worktree of a hub.
+type CodeWorktree struct {
+	// Path is the worktree root, cleaned and in native path separators.
+	Path string
+	// Anchor is the worktree's anchor dir, where its _lym/config lives.
+	Anchor string
+	// Main is true for the hub's main worktree, the prime.
+	Main bool
+}
+
+// WorktreeEntry represents a single worktree of a repository, as `git worktree list` reports it.
+type WorktreeEntry struct {
+	Path     string `json:"path"`
+	Head     string `json:"head"`
+	Branch   string `json:"branch"`
+	Main     bool   `json:"main"`
+	Prunable bool   `json:"prunable"`
+}
+
+// WorktreeEvent is what the worktree seam is told about one worktree.
+// Root is the worktree's root.
+// Anchor is its anchor directory, where the repository's own files sit; it equals Root in a worktree with no anchor.
+// ScratchDir is the pair's never-tracked `.lym` directory.
+// BoltDir is the hub's Bolt checkout.
+// Excluded holds the anchor-relative paths the warp exclude list names;
+// they are already seeded into the repository's exclude file.
+// Paths holds the root-relative paths that differ between the old and the new head, empty for "made".
+type WorktreeEvent struct {
+	Root       string
+	Anchor     string
+	ScratchDir string
+	BoltDir    string
+	Excluded   []string
+	Paths      []string
+}
+
+// AnchoredFileVersion is one committed version of an anchored file on the records branch's first-parent line.
+type AnchoredFileVersion struct {
+	// SHA is the full object name of the commit that changed the file.
+	SHA string
+	// Position is that commit's first-parent position on the records branch:
+	// the number of first-parent steps from the branch's root commit, so the root is 0 and each later commit is one more.
+	Position int
+	// Data is the file's contents at that commit.
+	Data []byte
+}
+
+// ConfigChanges is the set of per-worktree config files a task changed on its weft branch.
+// A change counts only when the task's copy differs from both its fork point and its parent's current copy.
+type ConfigChanges struct {
+	// Files are the changed files, repository-relative and slash-separated, sorted.
+	Files []string
+	// Base is the merge-base SHA of the task's and the parent's weft branches, the task's fork point.
+	Base string
+	// Tip is the SHA of the task's weft branch tip.
+	Tip string
+	// ParentTip is the SHA of the parent's weft branch tip.
+	ParentTip string
+	// Contents holds, per file in Files, the file's bytes at each of the three revisions.
+	Contents map[string]ConfigFileContents
+}
+
+// ConfigFileContents is one config file's bytes at the task's fork point, the task's tip and the parent's tip;
+// a file absent at a revision is nil there.
+type ConfigFileContents struct {
+	Base, Tip, Parent []byte
+}
+
+// ChangeSide names which repo of a warp<->weft pair a changed path belongs to.
+type ChangeSide string
+
+// The two sides of a warp<->weft pair that a changed path can be labelled with.
+const (
+	SideWarp ChangeSide = "warp"
+	SideWeft ChangeSide = "weft"
+)
+
+// ChangeEntry is one repo-relative path that changed on one side of a warp<->weft pair.
+// Its Side field names that side.
+type ChangeEntry struct {
+	Path string
+	Side ChangeSide
+}
+
+// DiffResult is the merged, side-labelled set of paths that changed across a warp<->weft pair since a warp SHA.
+// NoWeftCorrespondence reports whether that warp SHA predates any recorded weft correspondence;
+// in that case Entries holds only warp-side changes.
+type DiffResult struct {
+	Entries              []ChangeEntry
+	NoWeftCorrespondence bool
+}
+
+// HealthCause names the condition that made a health check fail,
+// so a caller can classify the failure without parsing a display string.
+type HealthCause string
+
+// The closed set of causes a failed health check can report, one per drift shape.
+const (
+	// CauseBranchMismatch reports that the weft worktree is not on the paired weft branch.
+	CauseBranchMismatch HealthCause = "branch-mismatch"
+	// CauseConfigLoadFailed reports that the wired name-set could not be loaded from fabric.yaml.
+	CauseConfigLoadFailed HealthCause = "config-load-failed"
+	// CauseJunctionMissing reports that a warp junction entry does not exist on disk.
+	CauseJunctionMissing HealthCause = "junction-missing"
+	// CauseNotAJunction reports that a warp junction entry exists but is not a link.
+	CauseNotAJunction HealthCause = "not-a-junction"
+	// CauseJunctionPointsElsewhere reports that a warp junction link resolves to the wrong target.
+	CauseJunctionPointsElsewhere HealthCause = "junction-points-elsewhere"
+)
+
+// HealthReason describes why a health check failed.
+// Cause is the drift shape a caller switches on.
+// Detail is a display string, worded for fabric, that a caller may print verbatim.
+// The zero value carries no reason, as it does for a passing check or an error.
+type HealthReason struct {
+	Cause  HealthCause
+	Detail string
+}
+
+// LineChange is the tree difference between two commits of a pair's code repository.
+type LineChange struct {
+	// Paths are the sorted changed paths, a rename counted at both its old and its new path.
+	Paths []string
+	// Lines is the added plus the deleted lines.
+	// A pure rename adds none, and a binary file counts as one line, so it is never free.
+	Lines int
+	// AddedLines is the text of every added line, without its leading plus.
+	AddedLines []string
+}
+
+// DiffSize is the size of the tree difference between two commits of a pair's code repository.
+type DiffSize struct {
+	// LinesAdded and LinesDeleted are the added and deleted lines, a pure rename adding and deleting none.
+	LinesAdded   int
+	LinesDeleted int
+	// FilesChanged counts each changed file once, renamed and binary files included; binary files add and delete no lines.
+	FilesChanged int
+}
+
+// FileDiff is one file's committed change: its repository-relative, slash-separated Path and its own Diff text.
+type FileDiff struct {
+	Path string
+	Diff string
+}
+
+// TaskPatch is the warp working tree's change against a merge base.
+// Head is the commit HEAD stands at, Full the full diff bytes in a stable order, and FullHash the hex SHA-256 of Full.
+// PatchID is git's stable patch-id of the zero-context form of the same diff.
+// It survives a rebase that moves the context around the change, and it is empty when the diff has no change.
+type TaskPatch struct {
+	Head     string
+	Full     []byte
+	FullHash string
+	PatchID  string
+}
+
+// MoveRecord is the record of an anchor change under way.
+// It is written before the weft is touched and removed once the change is finished or undone.
+// A is the anchor the weft is moving from and B the one it is moving to.
+// Kind is MoveKindMove or MoveKindIntegrate.
+// U is the upstream tip an integration rebuilds on, empty until that step is reached.
+// PID and StartTime identify the process that holds the move lock,
+// so a reader can tell a live change from an interrupted one.
+type MoveRecord struct {
+	A         string `json:"a"`
+	B         string `json:"b"`
+	Kind      string `json:"kind"`
+	U         string `json:"u,omitempty"`
+	PID       int    `json:"pid"`
+	StartTime string `json:"start_time,omitempty"`
+}
+
+// Origin is fabric's provenance record for one worktree pair.
+// It is written once at pair creation and read thereafter, never inferred.
+// It names the branch and the worktree the pair was created from.
+type Origin struct {
+	// ParentBranch is the warp branch the pair was forked from.
+	ParentBranch string `json:"parent_branch"`
+	// ParentWorktree is the WorktreeName of the worktree the pair was added from.
+	// A run's parent agent name is resolved from it.
+	// A record that lacks the field, such as a legacy-worktree repair whose creator is unknown, leaves it empty.
+	ParentWorktree string `json:"parent_worktree,omitempty"`
+	// Beam marks the pair as a beam.
+	// A record that lacks the field decodes with it false.
+	Beam bool `json:"beam,omitempty"`
+}
+
+// PairParts reports which parts of a pair are present, read locally with no network call.
+type PairParts struct {
+	// TaskWorktree reports a registered linked worktree at the pair's location.
+	TaskWorktree bool
+	// RecordsWorktree reports a directory at the pair's records worktree path.
+	RecordsWorktree bool
+	// RecordsBranch reports the local sibling branch.
+	RecordsBranch bool
+	// TaskBranch reports the local task branch.
+	TaskBranch bool
+	// StrayPath reports an unregistered path at the pair's task worktree location, such as one a late writer refilled.
+	StrayPath bool
+}
+
+// Any reports whether any part of the pair is present.
+func (p PairParts) Any() bool {
+	return p.TaskWorktree || p.RecordsWorktree || p.RecordsBranch || p.TaskBranch || p.StrayPath
+}
+
+// RecordsTag is one tag of a slug's records history:
+// an archive tag a teardown pushed, or a set-aside tag a local removal kept.
+type RecordsTag struct {
+	// Name is the tag's short name.
+	Name string
+	// Commit is the full hex object name of the commit the tag names, an annotated tag peeled.
+	Commit string
+	// OnOrigin is true when origin holds the tag.
+	OnOrigin bool
+	// OriginOnly is true when only origin holds the tag.
+	OriginOnly bool
+	// CommitterTime is the committer time of Commit.
+	CommitterTime time.Time
+	// Files holds the content of each requested path found at Commit, keyed by the requested path;
+	// a path absent there is left out.
+	Files map[string][]byte
+}
+
+// Trailer is one git trailer a commit message ends with.
+type Trailer struct {
+	// Key is the trailer's key, matching [A-Za-z][A-Za-z0-9-]*.
+	Key string
+	// Value is the trailer's value: non-empty and on one line.
+	Value string
+}
+
+// TrailerCommit is a weft commit that carries a trailer key.
+type TrailerCommit struct {
+	// SHA is the weft commit's full object name.
+	SHA string
+	// Value is the last value of the searched key in the commit's message.
+	Value string
+	// CodeHead is the commit's Warp-SHA value, the code checkout's HEAD the commit was made at, empty when it carries none.
+	CodeHead string
+	// Position is the commit's first-parent position on the records branch:
+	// the number of first-parent steps from the branch's root commit, so the root is 0 and each later commit is one more.
+	// Positions from different reads of the same branch compare as long as no history is rewritten.
+	Position int
+}
+
+// PollutionEntry describes a path tracked in the warp index that belongs in the weft, such as one under _lym.
+type PollutionEntry struct {
+	// Path is the relative path reported by git ls-files.
+	Path string `json:"path"`
+	// Remedy is the command that untracks the path and keeps it on disk. Empty when no remedy applies.
+	Remedy string `json:"remedy,omitempty"`
+}
diff --git a/internal/fabriclayout/refnames.go b/internal/fabriclayout/refnames.go
new file mode 100644
index 000000000..c6fc8a21a
--- /dev/null
+++ b/internal/fabriclayout/refnames.go
@@ -0,0 +1,195 @@
+// refnames.go holds fabric's branch, tag, ref-namespace, trailer-key, flag and commit-subject names,
+// and the pure functions that compose and parse them.
+
+package fabriclayout
+
+import (
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/weftname"
+)
+
+// WeftWarpSlug parses a weft sibling directory name and returns the warp slug it corresponds to.
+// It reports whether name ends with weftname.Suffix and the stripped prefix is non-empty.
+func WeftWarpSlug(name string) (slug string, ok bool) {
+	if !strings.HasSuffix(name, weftname.Suffix) {
+		return "", false
+	}
+	s := strings.TrimSuffix(name, weftname.Suffix)
+	if s == "" {
+		return "", false
+	}
+	return s, true
+}
+
+// ArchiveTagSHALen is how many leading hex digits of the tip SHA the archive tag name carries.
+const ArchiveTagSHALen = 12
+
+// ArchiveTagPrefix is the short-name prefix every archive tag carries.
+const ArchiveTagPrefix = "archive/"
+
+// ArchiveTagSlug returns the slug of the short tag name archive/<slug>/<sha>.
+// The bool is false unless name has the archive prefix, a non-empty slug segment, and a non-empty final segment.
+func ArchiveTagSlug(name string) (string, bool) {
+	rest, ok := strings.CutPrefix(name, ArchiveTagPrefix)
+	if !ok {
+		return "", false
+	}
+	slug, tip, ok := strings.Cut(rest, "/")
+	if !ok || slug == "" || tip == "" {
+		return "", false
+	}
+	return slug, true
+}
+
+// ArchiveTagName returns the archive tag name of a tip: archive/<slug>/<first 12 hex of tip>.
+// The tip must hold at least ArchiveTagSHALen characters.
+func ArchiveTagName(slug, tip string) string {
+	return ArchiveTagPrefix + slug + "/" + tip[:ArchiveTagSHALen]
+}
+
+// OwnerArchiveTagPrefix is the short-name prefix every owner archive tag carries.
+// No reader of ArchiveTagPrefix tags matches it,
+// so the owner archive of a live run or the prime never reads as an archived run.
+const OwnerArchiveTagPrefix = "archive-owner/"
+
+// OwnerArchiveTagName returns the owner archive tag name of a tip: archive-owner/<slug>/<first 12 hex of tip>.
+// The tip must hold at least ArchiveTagSHALen characters.
+func OwnerArchiveTagName(slug, tip string) string {
+	return OwnerArchiveTagPrefix + slug + "/" + tip[:ArchiveTagSHALen]
+}
+
+// The repository sides an owner archive tag sits in.
+const (
+	OwnerArchiveSideCode    = "code"
+	OwnerArchiveSideRecords = "records"
+)
+
+// The one-repository layout keeps a hub's records store under origin's refs/lym/ namespace.
+const (
+	// RecordsNamespaceRoot is the origin ref prefix that holds the records store's branches and tags.
+	RecordsNamespaceRoot = "refs/lym/"
+	// RecordsNamespaceHeads is the part of the namespace under RecordsNamespaceRoot that holds branches.
+	RecordsNamespaceHeads = "heads/"
+	// RecordsNamespaceTags is the part of the namespace under RecordsNamespaceRoot that holds tags.
+	RecordsNamespaceTags = "tags/"
+	// RecordsNamespaceCodeTags is the part under RecordsNamespaceRoot that holds the code store's archive tags.
+	// No fetch refspec of either store maps it, so the records store never lists or fetches a code commit through it.
+	RecordsNamespaceCodeTags = "code-tags/"
+	// OneRepositoryBoardBranch is the fixed branch of the board in a one-repository hub.
+	// It is a branch lym owns inside its records namespace, never read from git.
+	OneRepositoryBoardBranch = "main"
+	// PrimeRecordsBranchKey is the records store's git config key that names the prime's records branch.
+	PrimeRecordsBranchKey = "lym.primeRecordsBranch"
+)
+
+// WarpBindingFileName is the filename of the recorded warp-URL binding at the board root (<boardDir>/.lym-warp).
+// It holds only the warp URL string, plus a trailing newline.
+// This is a structural per-repo record, written once at clone and read on every subsequent clone or reconcile.
+// It is never a config or env override.
+// The anchor file says where in warp lym is rooted; this file says which warp repo the weft pairs with.
+// Exported so other packages and tests can name the file.
+const WarpBindingFileName = ".lym-warp"
+
+// ShortnameFileName is the filename of the recorded repo shortname at the board root (<boardDir>/.lym-shortname).
+// It holds only the shortname, plus a trailing newline.
+const ShortnameFileName = ".lym-shortname"
+
+// WarpSHATrailerKey is the git-trailer key fabric writes into every weft commit message as "Warp-SHA: <sha>".
+const WarpSHATrailerKey = "Warp-SHA"
+
+// TransitionTrailerKey is the git-trailer key of a records commit marking a run's transition.
+// It is written as "Run-Transition: <run id>".
+// Only a run's transition commits, its code-tip give-up and webster's reset of the code branch write it.
+// The newest commit carrying it thus names the run's last transition.
+// Fabric's other records commits carry a Warp-SHA trailer too, but never this one.
+const TransitionTrailerKey = "Run-Transition"
+
+// SnapshotTrailerKey is the git-trailer key fabric writes into a weft commit message.
+// It is written once per caller-supplied snapshot tag, alongside the Warp-SHA trailer.
+const SnapshotTrailerKey = "Snapshot"
+
+// originRecordSubjectPrefix is the commit subject prefix of the commit that records a new pair's origin.
+const originRecordSubjectPrefix = "fabric: record parent branch for "
+
+// OriginRecordSubject returns the commit subject of the origin-record commit that opens the pair for slug.
+// That commit is the oldest commit of the pair's own records history: everything below it is the parent's.
+func OriginRecordSubject(slug string) string {
+	return originRecordSubjectPrefix + slug
+}
+
+// OriginRecordSlug returns the slug an origin-record commit subject names.
+// The second result is false for any other subject and for an empty slug.
+func OriginRecordSlug(subject string) (string, bool) {
+	slug, ok := strings.CutPrefix(subject, originRecordSubjectPrefix)
+	if !ok || slug == "" {
+		return "", false
+	}
+	return slug, true
+}
+
+// DefaultCommitMessage is the commit message for a weft commit that does not need a custom one.
+const DefaultCommitMessage = "weft sync"
+
+const (
+	// PauseSlugFlag is the hidden flag naming the slug a push child's network calls are held under; empty for the prime.
+	PauseSlugFlag = "pause-slug"
+	// TeardownSlugFlag is the hidden fabric flag that tells a detached push child the pair whose teardown it yields to.
+	TeardownSlugFlag = "teardown-slug"
+	// ParentLockedFlag is the hidden flag marking a child spawned under a held parent lock; it never exits for coverage.
+	ParentLockedFlag = "parent-locked"
+)
+
+// The hidden fabric verb and flags that start the teardown child.
+const (
+	// TeardownChildVerb is the hidden fabric subcommand that runs the remote half of a teardown.
+	TeardownChildVerb = "remote-teardown"
+	// TeardownChildSlugFlag names the slug whose teardown lock the child holds.
+	TeardownChildSlugFlag = "slug"
+	// TeardownChildTryFlag makes the child take the lock by one attempt instead of waiting for it.
+	TeardownChildTryFlag = "try"
+	// TeardownChildWaitFlag bounds the child's wait for the lock.
+	TeardownChildWaitFlag = "wait"
+)
+
+// The verbs a fabric merge-state record carries.
+const (
+	// MergeVerbMergeIn is the verb of a record written by a merge-in of a source branch into the current pair.
+	MergeVerbMergeIn = "merge-in"
+	// MergeVerbMerge is the verb of a record written by a merge of a source branch into a target pair.
+	MergeVerbMerge = "merge"
+)
+
+// The kinds of anchor change a move record stands for.
+const (
+	// MoveKindMove re-roots the weft's content at the new anchor.
+	MoveKindMove = "move"
+	// MoveKindIntegrate re-roots the weft's content and carries its local commits across an upstream anchor change.
+	MoveKindIntegrate = "integrate"
+)
+
+// FabricReaderVerbs returns the names of the `lym fabric` verbs that only read:
+// list, pairs, status, diff, shortname, prune and cleanup.
+// It declares names only; the arguments each verb may take without mutating stay with the consumer that applies them.
+// Every call returns a fresh slice, so no caller can change another's set.
+func FabricReaderVerbs() []string {
+	return []string{"list", "pairs", "status", "diff", "shortname", "prune", "cleanup"}
+}
+
+// SeedSubjectPrefix opens the commit subject of a seeding commit.
+const SeedSubjectPrefix = "lym: seed "
+
+// syncSubjectPrefix opens the commit subject of an operator-requested sync commit.
+const syncSubjectPrefix = "lym: sync "
+
+// SeedCommitMessage returns the subject of a seeding commit for a subtree (`stencils` or `specs`).
+// label is the parenthesised binary label.
+func SeedCommitMessage(subtree, label string) string {
+	return SeedSubjectPrefix + subtree + " " + label
+}
+
+// SyncCommitMessage returns the subject of a commit that an operator-requested `lym stencil sync` makes for a subtree.
+// label is the parenthesised binary label.
+func SyncCommitMessage(subtree, label string) string {
+	return syncSubjectPrefix + subtree + " " + label
+}
diff --git a/internal/fabriclayout/refnames_test.go b/internal/fabriclayout/refnames_test.go
new file mode 100644
index 000000000..d0af5dd55
--- /dev/null
+++ b/internal/fabriclayout/refnames_test.go
@@ -0,0 +1,83 @@
+// refnames_test.go covers the readers and composers of the weft sibling name and the archive tag names.
+
+package fabriclayout
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestWeftWarpSlug checks that WeftWarpSlug round-trips a weft sibling directory name,
+// and that it rejects names without the weftname.Suffix tail or with an empty stripped prefix.
+func TestWeftWarpSlug(t *testing.T) {
+	tiergate.Require(t, 0)
+	tests := []struct {
+		name     string
+		input    string
+		wantSlug string
+		wantOK   bool
+	}{
+		{"plain_slug", "feat-weft", "feat", true},
+		{"nested_prefix_slug", "hanf/foo-weft", "hanf/foo", true},
+		{"no_suffix", "feat", "", false},
+		{"suffix_only_empty_prefix", "-weft", "", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			gotSlug, gotOK := WeftWarpSlug(tt.input)
+			if gotOK != tt.wantOK {
+				t.Errorf("WeftWarpSlug(%q) ok = %v; want %v", tt.input, gotOK, tt.wantOK)
+			}
+			if gotSlug != tt.wantSlug {
+				t.Errorf("WeftWarpSlug(%q) = %q; want %q", tt.input, gotSlug, tt.wantSlug)
+			}
+		})
+	}
+}
+
+// TestArchiveTagSlug covers the accepted archive/<slug>/<sha> shape.
+// It also covers the names that carry the prefix without a slug or tip, and those with another prefix.
+func TestArchiveTagSlug(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	tests := []struct {
+		name     string
+		tag      string
+		wantSlug string
+		wantOK   bool
+	}{
+		{"slug and tip", "archive/my-slug/0123456789ab", "my-slug", true},
+		{"no tip segment", "archive/x", "", false},
+		{"empty slug", "archive//abc", "", false},
+		{"empty tip", "archive/x/", "", false},
+		{"another prefix", "snapshot/x/abc", "", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			slug, ok := ArchiveTagSlug(tt.tag)
+			if slug != tt.wantSlug || ok != tt.wantOK {
+				t.Errorf("ArchiveTagSlug(%q) = (%q, %v); want (%q, %v)", tt.tag, slug, ok, tt.wantSlug, tt.wantOK)
+			}
+		})
+	}
+}
+
+// TestOwnerArchiveTagName pins the owner archive tag's name,
+// and that no archive tag reader takes it for an archived run.
+func TestOwnerArchiveTagName(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	tag := OwnerArchiveTagName("root", "0123456789abcdef0123")
+	if want := "archive-owner/root/0123456789ab"; tag != want {
+		t.Errorf("OwnerArchiveTagName() = %q; want %q", tag, want)
+	}
+	if slug, ok := ArchiveTagSlug(tag); ok {
+		t.Errorf("ArchiveTagSlug(%q) = (%q, true); want no archived run", tag, slug)
+	}
+	if strings.HasPrefix(tag, ArchiveTagPrefix) {
+		t.Errorf("%q carries the archive tag prefix %q; want it outside every archive tag listing", tag, ArchiveTagPrefix)
+	}
+}
diff --git a/internal/fabriclayout/structuraldirs.go b/internal/fabriclayout/structuraldirs.go
