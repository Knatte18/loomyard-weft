diff --git a/internal/adoptcli/steprun.go b/internal/adoptcli/steprun.go
new file mode 100644
index 00000000..0ff3d45a
--- /dev/null
+++ b/internal/adoptcli/steprun.go
@@ -0,0 +1,343 @@
+// steprun.go runs adopt's steps in order and records each one.
+// It holds the step run the steps share, the loop that drives them, the error that stops one,
+// and the outcome part each step contributes to the adopt record and to the end envelope merged from it.
+
+package adoptcli
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"slices"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/adoptrecord"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// stepRun is one adopt in flight, shared by its steps.
+// Outcomes are the slug outcomes merged from the steps that ended in this process.
+// Part and PartSlugs are the working outcome of the step running now, which the loop merges into them when the step ends.
+// A step reads earlier steps' marks from Outcomes and writes its own into Part, through slot for a slug.
+// The last group carries the reconcile step's decisions to the steps up to the owner write, which share one process.
+// Save, when set, persists the record after each step ends and when one starts.
+type stepRun struct {
+	Deps      adoptDeps
+	Req       request
+	Here      string
+	Slugs     []string
+	RootNamed bool
+	Owners    boardengine.Owners
+	Outcomes  map[string]*slugOutcome
+	Mutations *fabricengine.Mutations
+	Report    fabricengine.OriginReport
+	Record    adoptrecord.Record
+	Save      func(adoptrecord.Record) error
+	Now       func() time.Time
+	// Stopped is the error that ended the record stopped, nil while the record runs or after it ended done.
+	Stopped error
+
+	Part      outcome
+	PartSlugs map[string]*slugOutcome
+
+	LocalRuns []string
+	RunSlugs  []string
+	Acted     []string
+	Projects  map[string]string
+	Stops     map[string]bool
+	Held      map[string]bool
+	HeldBack  map[string]bool
+}
+
+// stopError is the error that ends a step: what went wrong, and the clause that names what to do next.
+type stopError struct {
+	err        error
+	wayForward string
+}
+
+func (e *stopError) Error() string { return e.err.Error() + "; " + e.wayForward }
+
+func (e *stopError) Unwrap() error { return e.err }
+
+// stopWith returns the error that stops a step with the message format and args describe, followed by wayForward.
+func stopWith(wayForward, format string, args ...any) error {
+	return &stopError{err: fmt.Errorf(format, args...), wayForward: wayForward}
+}
+
+// outcomePart is the JSON of the outcome fields one step set.
+// Its keys are the envelope's own, except slugs, an object keyed by slug that holds only the entries the step touched.
+// A list field holds only the items the step appended.
+type outcomePart struct {
+	Reconcile        *fabricengine.OriginReport `json:"reconcile,omitempty"`
+	Mutations        []fabricengine.Mutation    `json:"mutations,omitempty"`
+	Deploy           *deployOutcome             `json:"deploy,omitempty"`
+	PrimeRecorded    bool                       `json:"prime_recorded,omitempty"`
+	PrimeLost        string                     `json:"prime_lost_to,omitempty"`
+	Slugs            map[string]slugOutcome     `json:"slugs,omitempty"`
+	Warnings         []string                   `json:"warnings,omitempty"`
+	PrimeBeamSteps   *beamStepsOutcome          `json:"prime_beam_steps,omitempty"`
+	PrimeBeamWarning string                     `json:"prime_beam_warning,omitempty"`
+	Checks           []suiteStart               `json:"checks,omitempty"`
+	SuiteMessage     string                     `json:"message,omitempty"`
+	CheckWarnings    []string                   `json:"check_warnings,omitempty"`
+	Runs             []runReport                `json:"runs,omitempty"`
+}
+
+// runSteps runs the steps of adoptrecord.Steps from the step named from, in order, and records each in run.Record.
+// It seeds an outcome for each slug the record names that no outcome holds yet.
+// It does so before the first step and after each step, so a later step never meets a missing one.
+// On every call it then reads the local runs and refuses an anchor change standing under the subjects or those runs;
+// a refusal ends the record stopped at from and runs no step.
+// A step's error ends the record stopped at that step, with the part the step gathered before it failed,
+// and no later step runs.
+// The step's error is left in run.Stopped; runSteps itself returns only an error from saving the record.
+func runSteps(run *stepRun, from string) error {
+	run.seedOutcomes()
+	run.Stopped = nil
+	run.Record.State = adoptrecord.StateRunning
+	run.Record.Error, run.Record.WayForward = "", ""
+
+	if err := run.refuseBeforeSteps(); err != nil {
+		return run.stop(from, err, nil)
+	}
+	for _, name := range adoptrecord.Steps[slices.Index(adoptrecord.Steps, from):] {
+		run.Record.InFlight = name
+		if err := run.save(); err != nil {
+			return err
+		}
+
+		run.beginPart()
+		mutated := run.Mutations.Len()
+		stepErr := stepFunc(name)(run)
+		part := run.endPart(mutated)
+		raw, err := json.Marshal(part)
+		if err != nil {
+			return fmt.Errorf("lym adopt: encode the part of the %s step: %w", name, err)
+		}
+		if err := mergeSlugs(run.Outcomes, part.Slugs); err != nil {
+			return err
+		}
+		run.seedOutcomes()
+		if stepErr != nil {
+			return run.stop(name, stepErr, raw)
+		}
+
+		run.recordStep(name, raw)
+		if err := run.save(); err != nil {
+			return err
+		}
+	}
+	run.Record.State = adoptrecord.StateDone
+	return run.save()
+}
+
+// stepFunc returns the function of the step named name.
+func stepFunc(name string) func(*stepRun) error {
+	switch name {
+	case adoptrecord.StepReconcile:
+		return stepReconcile
+	case adoptrecord.StepPairs:
+		return stepPairs
+	case adoptrecord.StepPause:
+		return stepPause
+	case adoptrecord.StepOwner:
+		return stepOwner
+	case adoptrecord.StepDeploy:
+		return stepDeploy
+	case adoptrecord.StepBeam:
+		return stepBeam
+	case adoptrecord.StepCheck:
+		return stepCheck
+	case adoptrecord.StepDone:
+		return stepDone
+	}
+	panic("adoptcli: no adopt step is named " + name)
+}
+
+// seedOutcomes gives each slug the record's subjects, runs and paused slugs name an outcome, when none holds one.
+// The word `root` gets none.
+func (run *stepRun) seedOutcomes() {
+	seedOutcomes(run.Outcomes, run.Record)
+}
+
+// seedOutcomes gives each slug the record's subjects, runs and paused slugs name an outcome in outcomes.
+// A slug that already holds one keeps it, and the word `root` gets none.
+func seedOutcomes(outcomes map[string]*slugOutcome, record adoptrecord.Record) {
+	inputs := record.Inputs
+	for _, slug := range slices.Concat(record.Subjects, inputs.Runs, inputs.Paused) {
+		if slug == boardengine.RootSubject {
+			continue
+		}
+		if outcomes[slug] == nil {
+			outcomes[slug] = &slugOutcome{Slug: slug}
+		}
+	}
+}
+
+// refuseBeforeSteps reads the runs under the subjects as this machine's records hold them.
+// It refuses an anchor change standing in a worktree the steps would act under.
+// It keeps the runs for the reconcile step to record.
+func (run *stepRun) refuseBeforeSteps() error {
+	localRuns, err := movedRuns(run.Deps, run.Owners, run.Slugs, run.RootNamed)
+	if err != nil {
+		return stopWith(reentry, "lym adopt: read the runs under the adopted projects, so nothing ran: %w", err)
+	}
+	if err := refuseStandingMove(run.Deps, append(slices.Clone(run.Slugs), localRuns...)); err != nil {
+		return err
+	}
+	run.LocalRuns = localRuns
+	return nil
+}
+
+// beginPart gives the step about to run an empty working outcome.
+func (run *stepRun) beginPart() {
+	run.Part = outcome{}
+	run.PartSlugs = map[string]*slugOutcome{}
+	for slug := range run.Outcomes {
+		run.PartSlugs[slug] = &slugOutcome{Slug: slug}
+	}
+}
+
+// slot returns the working outcome of slug in the step running now, creating it when the slug has none.
+func (run *stepRun) slot(slug string) *slugOutcome {
+	out := run.PartSlugs[slug]
+	if out == nil {
+		out = &slugOutcome{Slug: slug}
+		run.PartSlugs[slug] = out
+	}
+	return out
+}
+
+// endPart returns the part the step that just ended contributes.
+// mutated is the length of the mutation record when the step began.
+func (run *stepRun) endPart(mutated int) outcomePart {
+	part := outcomePart{
+		Mutations:        run.Mutations.Entries()[mutated:],
+		Deploy:           run.Part.Deploy,
+		PrimeRecorded:    run.Part.PrimeRecorded,
+		PrimeLost:        run.Part.PrimeLost,
+		Warnings:         run.Part.Warnings,
+		PrimeBeamSteps:   run.Part.PrimeBeamSteps,
+		PrimeBeamWarning: run.Part.PrimeBeamWarning,
+		Checks:           run.Part.Checks,
+		SuiteMessage:     run.Part.SuiteMessage,
+		CheckWarnings:    run.Part.CheckWarnings,
+		Runs:             run.Part.Runs,
+	}
+	if !reflect.DeepEqual(run.Part.Reconcile, fabricengine.OriginReport{}) {
+		report := run.Part.Reconcile
+		part.Reconcile = &report
+	}
+	for slug, out := range run.PartSlugs {
+		if reflect.DeepEqual(*out, slugOutcome{Slug: slug}) {
+			continue
+		}
+		if part.Slugs == nil {
+			part.Slugs = map[string]slugOutcome{}
+		}
+		part.Slugs[slug] = *out
+	}
+	return part
+}
+
+// recordStep lists the step as ended with the part raw, replacing an entry of the same name.
+// It clears the part a stop left, since the step that gathered it has run again.
+func (run *stepRun) recordStep(name string, raw json.RawMessage) {
+	ended := adoptrecord.StepRecord{Name: name, EndedAt: run.Now(), Outcome: raw}
+	index := slices.IndexFunc(run.Record.Steps, func(done adoptrecord.StepRecord) bool { return done.Name == name })
+	if index < 0 {
+		run.Record.Steps = append(run.Record.Steps, ended)
+	} else {
+		run.Record.Steps[index] = ended
+	}
+	run.Record.InFlight = ""
+	run.Record.StoppedPart = nil
+}
+
+// stop ends the record stopped at step with err.
+// raw is the part the step gathered before it failed, nil for a refusal that ran no step.
+// InFlight keeps the step the record stopped at.
+func (run *stepRun) stop(step string, err error, raw json.RawMessage) error {
+	run.Stopped = err
+	run.Record.State = adoptrecord.StateStopped
+	run.Record.InFlight = step
+	var stopErr *stopError
+	if errors.As(err, &stopErr) {
+		run.Record.Error, run.Record.WayForward = stopErr.err.Error(), stopErr.wayForward
+	} else {
+		run.Record.Error, run.Record.WayForward = err.Error(), ""
+	}
+	run.Record.StoppedPart = nil
+	if len(raw) > 0 && string(raw) != "{}" {
+		run.Record.StoppedPart = raw
+	}
+	return run.save()
+}
+
+// save persists the record through Save, when one is set.
+func (run *stepRun) save() error {
+	if run.Save == nil {
+		return nil
+	}
+	if err := run.Save(run.Record); err != nil {
+		return fmt.Errorf("lym adopt: save the adopt record: %w", err)
+	}
+	return nil
+}
+
+// mergePart merges part into result and outcomes.
+// A list field is appended and a scalar or object field the part holds replaces the merged one.
+// A slug's entry overlays only the fields the part holds.
+func mergePart(result *outcome, outcomes map[string]*slugOutcome, part outcomePart) error {
+	if part.Reconcile != nil {
+		result.Reconcile = *part.Reconcile
+	}
+	result.Mutations = append(result.Mutations, part.Mutations...)
+	result.Partial = len(result.Mutations) > 0
+	if part.Deploy != nil {
+		result.Deploy = part.Deploy
+	}
+	result.PrimeRecorded = result.PrimeRecorded || part.PrimeRecorded
+	if part.PrimeLost != "" {
+		result.PrimeLost = part.PrimeLost
+	}
+	result.Warnings = append(result.Warnings, part.Warnings...)
+	if part.PrimeBeamSteps != nil {
+		result.PrimeBeamSteps = part.PrimeBeamSteps
+	}
+	if part.PrimeBeamWarning != "" {
+		result.PrimeBeamWarning = part.PrimeBeamWarning
+	}
+	result.Checks = append(result.Checks, part.Checks...)
+	if part.SuiteMessage != "" {
+		result.SuiteMessage = part.SuiteMessage
+	}
+	result.CheckWarnings = append(result.CheckWarnings, part.CheckWarnings...)
+	if part.Runs != nil {
+		result.Runs = part.Runs
+	}
+	return mergeSlugs(outcomes, part.Slugs)
+}
+
+// mergeSlugs overlays each entry of entries onto the outcome of its slug in outcomes.
+// It creates the outcome when none stands.
+// An entry overlays only the fields it holds.
+func mergeSlugs(outcomes map[string]*slugOutcome, entries map[string]slugOutcome) error {
+	for slug, entry := range entries {
+		merged := outcomes[slug]
+		if merged == nil {
+			merged = &slugOutcome{Slug: slug}
+			outcomes[slug] = merged
+		}
+		data, err := json.Marshal(entry)
+		if err != nil {
+			return fmt.Errorf("lym adopt: encode the outcome of %s: %w", slug, err)
+		}
+		if err := json.Unmarshal(data, merged); err != nil {
+			return fmt.Errorf("lym adopt: merge the outcome of %s: %w", slug, err)
+		}
+	}
+	return nil
+}
diff --git a/internal/adoptcli/steps.go b/internal/adoptcli/steps.go
new file mode 100644
index 00000000..8ad549e2
--- /dev/null
+++ b/internal/adoptcli/steps.go
@@ -0,0 +1,329 @@
+// steps.go holds the eight steps of an adopt, in the order the worker runs them:
+// reconcile, pairs, pause, owner, deploy, beam, check and done.
+// Each is a function over the step run that writes its outcome into the run's working part.
+
+package adoptcli
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/adoptrecord"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+)
+
+// stepReconcile reconciles the hub against origin and judges which entries a takeover would stop.
+// It clears every input but the paused slugs first, so a restart never carries an earlier run's decisions.
+// It refuses an unreachable origin, a reconcile error and a stop on a shared branch.
+// It reads the runs the reconcile may have brought.
+// It decides which projects a local-commit or live-pair stop holds back.
+func stepReconcile(run *stepRun) error {
+	deps := run.Deps
+	inputs := &run.Record.Inputs
+	*inputs = adoptrecord.Inputs{Paused: inputs.Paused, LocalRuns: run.LocalRuns}
+
+	report, err := deps.Reconcile()
+	run.Report = report
+	run.Part.Reconcile = report
+	run.Mutations.Extend(report.Mutations)
+	if err != nil {
+		return stopWith("repair what the error names, "+reentry, "lym adopt: the origin reconcile failed, so nothing ran: %w", err)
+	}
+	if report.Unreachable {
+		return stopWith(reentry+" once origin answers", "lym adopt: origin was unreachable, so nothing was judged against it and nothing ran")
+	}
+	if stops := sharedStopText(report); stops != "" {
+		return stopWith(stops, "lym adopt: the origin reconcile stopped, so nothing ran")
+	}
+
+	// The reconcile may have brought the run records of the other machine's runs,
+	// so the moved runs are read again.
+	moved, err := movedRuns(deps, run.Owners, run.Slugs, run.RootNamed)
+	if err != nil {
+		return stopWith(reentry, "lym adopt: read the runs under the adopted projects, so nothing ran: %w", err)
+	}
+	inputs.Moved = moved
+
+	// A beam that keeps its own owner on another machine is moved by an adopted root as a run only:
+	// it is reported, and neither taken over nor resumed.
+	run.RunSlugs = nil
+	for _, slug := range moved {
+		entry := run.Owners.Entries[slug]
+		keepsOwner := entry.IsProject && entry.Beam && boardengine.OwnedElsewhere(entry.Owner, run.Here) && !slices.Contains(run.Slugs, slug)
+		out := run.slot(slug)
+		if keepsOwner {
+			out.Run = ownedElsewhereRun
+			out.OwnedBy = entry.Owner
+			continue
+		}
+		run.RunSlugs = append(run.RunSlugs, slug)
+	}
+
+	// A project one of whose runs stops is held back whole,
+	// so no owner is written over a pair that still holds local state.
+	run.Acted = slices.Clone(run.Slugs)
+	for _, slug := range run.RunSlugs {
+		if !slices.Contains(run.Slugs, slug) {
+			run.Acted = append(run.Acted, slug)
+		}
+	}
+	run.Projects = map[string]string{}
+	run.Stops = map[string]bool{}
+	run.Held = map[string]bool{}
+	run.HeldBack = map[string]bool{}
+	for _, slug := range run.Acted {
+		project, err := projectOf(deps, run.Slugs, slug)
+		if err != nil {
+			return stopWith(reentry, "lym adopt: read the parent of %s, so nothing ran: %w", slug, err)
+		}
+		run.Projects[slug] = project
+		stopped, err := wouldStop(deps, run.Req, report, slug)
+		if err != nil {
+			return stopWith(reentry, "lym adopt: read whether the pair of %s is live, so nothing ran: %w", slug, err)
+		}
+		if stopped {
+			run.Stops[slug] = true
+			run.Held[project] = true
+			run.HeldBack[project] = true
+		}
+	}
+	return nil
+}
+
+// stepPairs takes over each entry the reconcile left going and adds the pairs this machine lacks.
+// It decides which beams are adoptable and whether the prime goes, and which projects a stop held back.
+func stepPairs(run *stepRun) error {
+	for _, slug := range run.Acted {
+		project := run.Projects[slug]
+		out := run.slot(slug)
+		if run.Held[project] && !run.Stops[slug] {
+			out.Warning = fmt.Sprintf("not taken over: another run under `%s` stopped, so the adopt holds it back whole", project)
+			continue
+		}
+		if !takeOverSlug(run.Deps, run.Req, run.Mutations, run.Report, run.Owners, project, out) {
+			run.Held[project] = true
+			if out.Stopped {
+				run.HeldBack[project] = true
+			}
+		}
+	}
+
+	var adoptable []string
+	for _, slug := range run.Slugs {
+		if run.Held[slug] {
+			run.slot(slug).Warning = "not adopted: it or a run under it stopped, so its owner stays; the stop names the way forward"
+			continue
+		}
+		adoptable = append(adoptable, slug)
+	}
+
+	inputs := &run.Record.Inputs
+	inputs.Runs = run.RunSlugs
+	inputs.Adoptable = adoptable
+	inputs.RootGoing = !run.Held[boardengine.RootSubject] && (run.RootNamed || (run.Owners.Prime == "" && len(adoptable) > 0))
+	inputs.HeldBack = nil
+	for project := range run.HeldBack {
+		inputs.HeldBack = append(inputs.HeldBack, project)
+	}
+	slices.Sort(inputs.HeldBack)
+	return nil
+}
+
+// stepPause pauses the runs and released tasks picked from the owners as the reconcile left them,
+// and the adopted beams that hold an owner pause of their own.
+// A pause lasts until an operator lifts it.
+// A slug whose scope another caller already pauses keeps that entry and is not paused.
+func stepPause(run *stepRun) error {
+	deps := run.Deps
+	inputs := &run.Record.Inputs
+	if len(inputs.Adoptable) == 0 && !inputs.RootGoing {
+		return nil
+	}
+	reconciled, err := deps.ReadOwners()
+	if err != nil {
+		return stopWith(reentry, "lym adopt: read the board's owners after the reconcile: %w, so no owner was recorded", err)
+	}
+	tasks, err := deps.Tasks()
+	if err != nil {
+		return stopWith(reentry, "lym adopt: read the board's entries: %w, so no owner was recorded", err)
+	}
+	targets, err := pauseTargets(deps, run.Here, reconciled, tasks, inputs.Runs, inputs.Adoptable, inputs.RootGoing, run.Outcomes)
+	if err != nil {
+		return stopWith(reentry, "lym adopt: %w, so no owner was recorded", err)
+	}
+	if len(targets)+len(inputs.Adoptable) == 0 {
+		return nil
+	}
+
+	var paused []string
+	var other map[string]string
+	if err := deps.UpdatePause(func(record *pauserecord.Record, now time.Time) error {
+		paused, other = pauseEntries(record, targets, inputs.Adoptable, inputs.Paused, now)
+		return nil
+	}); err != nil {
+		return stopWith("re-run `"+adoptrecord.Request(run.Req).Command()+"`", "lym adopt: pause the runs in the pause record: %w, so no owner was recorded", err)
+	}
+
+	inputs.Paused = append(inputs.Paused, paused...)
+	slices.Sort(inputs.Paused)
+	inputs.Paused = slices.Compact(inputs.Paused)
+	// Every slug the record lists reports its pause, including one an earlier process paused.
+	// A re-run of this step replaces that process's part of it.
+	for _, slug := range inputs.Paused {
+		out := run.slot(slug)
+		out.AdoptPaused = true
+		out.Run = pausedRun
+		out.PauseStanding = fmt.Sprintf("paused by adopt: `lym tender resume %s` lifts it", slug)
+	}
+	for slug, caller := range other {
+		run.slot(slug).PauseStanding = fmt.Sprintf("a pause of its own scope by %s covers it: `lym tender resume %s` lifts it", caller, slug)
+	}
+	return nil
+}
+
+// stepOwner writes this machine as the owner of every beam not held back, and of the prime when it goes.
+// It reads the owners back and settles each adopted beam and each run moved with them that no stop or error kept back.
+// It ends with the warnings for the branches the reconcile left unmoved.
+func stepOwner(run *stepRun) error {
+	deps := run.Deps
+	inputs := &run.Record.Inputs
+	inputs.OwnerStood = nil
+	inputs.PrimeRecorded = false
+
+	var adopted []string
+	if len(inputs.Adoptable) > 0 || inputs.RootGoing {
+		write, err := deps.SetOwners(boardengine.OwnerRequest{Machine: run.Here, Slugs: inputs.Adoptable, Prime: inputs.RootGoing, Takeover: true, ParentOf: deps.ParentOf})
+		if err != nil {
+			return ownerWriteError(err)
+		}
+		for _, slug := range write.Recorded {
+			if slug == boardengine.OwnerWritePrime {
+				run.Part.PrimeRecorded = true
+				inputs.PrimeRecorded = true
+				continue
+			}
+			run.slot(slug).OwnerRecorded = true
+			adopted = append(adopted, slug)
+		}
+		for slug, owner := range write.Lost {
+			if slug == boardengine.OwnerWritePrime {
+				run.Part.PrimeLost = owner
+				continue
+			}
+			run.slot(slug).Error = fmt.Sprintf("another machine recorded %s as the owner while this write was in flight, so the adopt check of %s starts nothing for it: `lym adopt %s` takes it over again", owner, slug, slug)
+		}
+	}
+	inputs.OwnerStood = adopted
+
+	if len(adopted) > 0 || inputs.PrimeRecorded {
+		after, err := deps.ReadOwners()
+		if err != nil {
+			return stopWith(reentry, "lym adopt: the owners were recorded, but reading them back failed, so the beam steps did not run: %w", err)
+		}
+		// Settled in slug order: the adopted beams, then the runs moved with them that no stop or error kept back.
+		settled := slices.Clone(adopted)
+		for _, slug := range inputs.Runs {
+			out := run.Outcomes[slug]
+			if !slices.Contains(settled, slug) && !out.Stopped && out.Error == "" && out.Warning == "" {
+				settled = append(settled, slug)
+			}
+		}
+		slices.Sort(settled)
+		for _, slug := range settled {
+			resumeSlug(deps, run.Here, after, run.slot(slug), slices.Contains(inputs.Paused, slug))
+		}
+	}
+
+	run.Part.Warnings = reconcileWarnings(run.Report, adopted, run.Outcomes, run.Req)
+	return nil
+}
+
+// stepDeploy runs the landing deploy when the prime goes and its head is ahead of the running lym's build.
+// The owner is written and the adopted runs are paused by then, so a failed deploy stops the record with none going on.
+func stepDeploy(run *stepRun) error {
+	if !run.Record.Inputs.RootGoing {
+		return nil
+	}
+	deployed, warning, err := deployStale(run.Deps)
+	run.Part.Deploy = deployed
+	if err != nil {
+		return err
+	}
+	if warning != "" {
+		run.Part.Warnings = append(run.Part.Warnings, warning)
+	}
+	return nil
+}
+
+// stepBeam runs the beam steps of the prime when its owner was recorded, then of each beam whose owner write stood.
+// It works over the owners as they read now.
+func stepBeam(run *stepRun) error {
+	inputs := run.Record.Inputs
+	if !inputs.PrimeRecorded && len(inputs.OwnerStood) == 0 {
+		return nil
+	}
+	after, err := run.Deps.ReadOwners()
+	if err != nil {
+		return stopWith(reentry, "lym adopt: the owners were recorded, but reading them back failed, so the beam steps did not run: %w", err)
+	}
+	run.Part.PrimeRecorded = inputs.PrimeRecorded
+	for _, slug := range inputs.OwnerStood {
+		run.slot(slug).AdoptPaused = slices.Contains(inputs.Paused, slug)
+	}
+	runBeamSteps(run.Deps, run.Here, after, inputs.OwnerStood, run.Req.NoOrch, &run.Part, run.PartSlugs)
+	return nil
+}
+
+// stepCheck starts the adopt check of root when the prime's owner was recorded.
+// It then starts the check of each beam whose owner write stood.
+// It resets each subject's fix-try count first.
+// It ends by building the per-run report over the runs the takeover moved and paused.
+func stepCheck(run *stepRun) error {
+	deps := run.Deps
+	inputs := run.Record.Inputs
+	for _, subject := range checkSubjects(inputs.PrimeRecorded, inputs.OwnerStood) {
+		if err := deps.ResetTries(subject); err != nil {
+			run.Part.CheckWarnings = append(run.Part.CheckWarnings, fmt.Sprintf("the adopt check of %s was not started (%v); way forward: re-run lym adopt %s", subject, err, subject))
+			continue
+		}
+		start, err := deps.StartSuite(subject)
+		if err != nil {
+			run.Part.CheckWarnings = append(run.Part.CheckWarnings, fmt.Sprintf("the adopt check of %s was not started (%v); way forward: re-run lym adopt %s", subject, err, subject))
+			continue
+		}
+		run.Part.Checks = append(run.Part.Checks, start)
+	}
+	run.Part.SuiteMessage = suiteMessage(run.Part.Checks)
+
+	// The subjects whose runs this call reports: the ones it names, and root when the prime's owner is written.
+	named := slices.Clone(run.Slugs)
+	if run.RootNamed || inputs.RootGoing {
+		named = append(named, boardengine.RootSubject)
+	}
+	reports, err := reportRuns(deps, run.Here, inputs.LocalRuns, inputs.Moved, inputs.Paused, named)
+	if err != nil {
+		run.Part.Warnings = append(run.Part.Warnings, fmt.Sprintf("the report of the runs was not built (%v); way forward: fix the cause it names, %s", err, reentry))
+	}
+	run.Part.Runs = reports
+	return nil
+}
+
+// stepDone ends the adopt.
+// It stops the record when a local-commit or live-pair stop held a project back.
+// The stop names the re-run that records the owner over it and the one that drops the local commits.
+// Each re-run names the subjects of the whole adopt, so the standing record resumes under it.
+func stepDone(run *stepRun) error {
+	heldBack := run.Record.Inputs.HeldBack
+	if len(heldBack) == 0 {
+		return nil
+	}
+	rerun := adoptrecord.Request(run.Req)
+	keep, drop := rerun, rerun
+	keep.KeepLocal, keep.DropLocal = true, false
+	drop.KeepLocal, drop.DropLocal = false, true
+	wayForward := fmt.Sprintf("`%s` records the owner over the local state, and `%s` keeps each local tip under an archive tag and moves the branches to origin's", keep.Command(), drop.Command())
+	return stopWith(wayForward, "lym adopt: %s held back by a stop on local commits origin lacks or on a live pair, so its owner stays", strings.Join(heldBack, ", "))
+}
diff --git a/internal/adoptcli/worker.go b/internal/adoptcli/worker.go
new file mode 100644
index 00000000..c41e6efa
--- /dev/null
+++ b/internal/adoptcli/worker.go
@@ -0,0 +1,364 @@
+// worker.go runs the steps of an adopt as the hidden worker does.
+// It holds the worker's seams and its run under adopt.lock, the request checks and the judgement of a standing record,
+// and the end envelope the worker merges from the parts its steps recorded.
+
+package adoptcli
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/adoptrecord"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/proc"
+)
+
+// workerDeps holds the seams of the worker: the step deps, the process facts it records, and the record and lock access.
+// ReadRecord and WriteRecord read and replace the adopt record.
+// TryLock takes adopt.lock without blocking, and reports false when another process holds it;
+// release gives it up.
+// Alive reports whether the worker named by a pid and start ticks is running.
+type workerDeps struct {
+	Steps       adoptDeps
+	PID         int
+	StartTicks  string
+	Now         func() time.Time
+	ReadRecord  func() (adoptrecord.Record, bool, error)
+	WriteRecord func(record adoptrecord.Record) error
+	TryLock     func() (release func() error, acquired bool, err error)
+	Alive       func(pid int, startTicks string) bool
+}
+
+// hubWorkerDeps fills workerDeps over the hub the prime belongs to, with the machine's name read through machine.
+// The record and the lock sit in the hub's adopt scratch directory.
+func hubWorkerDeps(prime *lymcwd.Location, machine func() (string, error)) (workerDeps, error) {
+	steps, err := hubDepsAs(prime, machine)
+	if err != nil {
+		return workerDeps{}, err
+	}
+	hubPath := prime.HubPath
+	pid := os.Getpid()
+	ticks, _ := proc.StartTime(pid)
+	return workerDeps{
+		Steps:       steps,
+		PID:         pid,
+		StartTicks:  ticks,
+		Now:         time.Now,
+		ReadRecord:  func() (adoptrecord.Record, bool, error) { return adoptrecord.Read(hubPath) },
+		WriteRecord: func(record adoptrecord.Record) error { return adoptrecord.Write(hubPath, record) },
+		TryLock:     func() (func() error, bool, error) { return tryAdoptLock(hubPath) },
+		Alive:       adoptrecord.WorkerAlive,
+	}, nil
+}
+
+// tryAdoptLock takes the hub's adopt.lock without blocking, creating the adopt scratch directory it sits in.
+// It reports false when another process holds the lock.
+func tryAdoptLock(hubPath string) (release func() error, acquired bool, err error) {
+	path := adoptrecord.LockPath(hubPath)
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return nil, false, fmt.Errorf("create the adopt scratch directory: %w", err)
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(path)
+	if err != nil || !acquired {
+		return nil, false, err
+	}
+	return held.Release, true, nil
+}
+
+// recorded returns the request as the adopt record stores it.
+func (r request) recorded() adoptrecord.Request {
+	return adoptrecord.Request(r)
+}
+
+// requestOf returns the request a recorded one stands for.
+func requestOf(recorded adoptrecord.Request) request {
+	return request(recorded)
+}
+
+// normalizedRequest returns req with the word `root` among its slugs turned into Root.
+func normalizedRequest(req request) request {
+	if !slices.Contains(req.Slugs, boardengine.RootSubject) {
+		return req
+	}
+	req.Root = true
+	req.Slugs = slices.DeleteFunc(slices.Clone(req.Slugs), func(slug string) bool { return slug == boardengine.RootSubject })
+	return req
+}
+
+// validateRequest holds the checks an adopt makes before any step.
+// It refuses a request that names no subject, one that pairs --all with slugs, and --keep-local with --drop-local.
+// It then resolves the request over the board's owners and returns the beam slugs it adopts and whether it adopts root.
+func validateRequest(deps adoptDeps, req request) (slugs []string, root bool, err error) {
+	req = normalizedRequest(req)
+	if req.KeepLocal && req.DropLocal {
+		return nil, false, errors.New("lym adopt: --keep-local and --drop-local answer the same local commits in opposite ways: pass one of them")
+	}
+	if req.All && len(req.Slugs) > 0 {
+		return nil, false, errors.New("lym adopt: --all takes no slug: drop the slugs, or drop --all")
+	}
+	if len(req.Slugs) == 0 && !req.Root && !req.All {
+		return nil, false, errors.New("lym adopt: name a beam project or `root`, or pass --all: `lym board list` shows the entries")
+	}
+	owners, err := deps.ReadOwners()
+	if err != nil {
+		return nil, false, fmt.Errorf("lym adopt: read the board's owners: %w", err)
+	}
+	return namedEntries(deps, owners, req)
+}
+
+// standingVerdict says what a worker does with the adopt record it finds.
+type standingVerdict string
+
+const (
+	// verdictFresh starts a new adopt: no record stands, or the one that does is done.
+	verdictFresh standingVerdict = "fresh"
+	// verdictFollow leaves an unfinished record of the same subjects to its running worker.
+	verdictFollow standingVerdict = "follow"
+	// verdictResume continues an unfinished record of the same subjects whose worker is gone or stopped.
+	verdictResume standingVerdict = "resume"
+)
+
+// judgeStanding judges the record found, if any, against a call, over the state the record reads in.
+// An unfinished record of other subjects is refused with the re-run that finishes it and the discard that removes it.
+func judgeStanding(record adoptrecord.Record, found bool, state string, call adoptrecord.Request) (standingVerdict, error) {
+	if !found || state == adoptrecord.StateDone {
+		return verdictFresh, nil
+	}
+	if !record.Request.SameSubjects(call) {
+		step := record.InFlight
+		if step == "" {
+			step = record.ResumeStep()
+		}
+		return "", fmt.Errorf("lym adopt: an unfinished adopt of %s stands at the %s step: finish it with `%s`, or remove its record with `lym adopt --discard`, before adopting other subjects",
+			strings.Join(record.Subjects, ", "), step, record.Request.Command())
+	}
+	if state == adoptrecord.StateRunning {
+		return verdictFollow, nil
+	}
+	return verdictResume, nil
+}
+
+// mergeRequest returns the request a resumed adopt runs: the recorded one with the call's flags added.
+// A call's --keep-local or --drop-local replaces the recorded other one.
+// restart reports that the merged request answers local commits differently from the recorded one,
+// so the resume starts again at the reconcile.
+func mergeRequest(recorded, call adoptrecord.Request) (merged adoptrecord.Request, restart bool) {
+	merged = recorded
+	if call.KeepLocal {
+		merged.KeepLocal, merged.DropLocal = true, false
+	}
+	if call.DropLocal {
+		merged.KeepLocal, merged.DropLocal = false, true
+	}
+	merged.NoOrch = recorded.NoOrch || call.NoOrch
+	restart = merged.KeepLocal != recorded.KeepLocal || merged.DropLocal != recorded.DropLocal
+	return merged, restart
+}
+
+// runWorker runs the steps of an adopt for req under adopt.lock and records each in the adopt record.
+// A refused request, a held lock and a record of other subjects, or one whose worker still runs, return before any step.
+// An unfinished record of the same subjects is resumed from its first step not done, over the subjects it recorded.
+// The resume keeps the steps already listed, unless the call changed how local commits are answered, which clears them.
+// It returns the end envelope, the final record, and the error of the step that stopped the adopt, if one did.
+func runWorker(deps workerDeps, req request) (outcome, adoptrecord.Record, error) {
+	req = normalizedRequest(req)
+	if _, _, err := validateRequest(deps.Steps, req); err != nil {
+		return outcome{}, adoptrecord.Record{}, err
+	}
+	release, acquired, err := deps.TryLock()
+	if err != nil {
+		return outcome{}, adoptrecord.Record{}, fmt.Errorf("lym adopt: take the adopt lock: %w", err)
+	}
+	if !acquired {
+		return outcome{}, adoptrecord.Record{}, errors.New("lym adopt: another adopt holds the adopt lock, so this one did nothing: `lym beam status` shows it")
+	}
+	defer func() { _ = release() }()
+
+	record, found, err := deps.ReadRecord()
+	if err != nil {
+		return outcome{}, adoptrecord.Record{}, err
+	}
+	verdict, err := judgeStanding(record, found, record.ReadState(deps.Alive), req.recorded())
+	if err != nil {
+		return outcome{}, adoptrecord.Record{}, err
+	}
+	if verdict == verdictFollow {
+		return outcome{}, adoptrecord.Record{}, fmt.Errorf("lym adopt: an adopt of the same subjects is running as process %d, so this one did nothing: `lym beam status` shows it, and `lym adopt --discard` removes its record if that process is not an adopt", record.PID)
+	}
+
+	from := adoptrecord.StepReconcile
+	restart := false
+	if verdict == verdictResume {
+		var merged adoptrecord.Request
+		merged, restart = mergeRequest(record.Request, req.recorded())
+		req = requestOf(merged)
+		if next := record.ResumeStep(); !restart && next != "" {
+			from = next
+		}
+	}
+
+	here, err := deps.Steps.Machine()
+	if err != nil {
+		return outcome{}, adoptrecord.Record{}, fmt.Errorf("lym adopt: read this machine's name: %w", err)
+	}
+	owners, err := deps.Steps.ReadOwners()
+	if err != nil {
+		return outcome{}, adoptrecord.Record{}, fmt.Errorf("lym adopt: read the board's owners: %w", err)
+	}
+	var slugs []string
+	var rootNamed bool
+	if verdict == verdictResume {
+		slugs, rootNamed = splitSubjects(record.Subjects)
+		// A beam the board no longer holds, landed or removed since the interruption, is not adopted.
+		slugs = slices.DeleteFunc(slugs, func(slug string) bool {
+			_, held := owners.Entries[slug]
+			return !held
+		})
+	} else {
+		slugs, rootNamed, err = namedEntries(deps.Steps, owners, req)
+		if err != nil {
+			return outcome{}, adoptrecord.Record{}, err
+		}
+		subjects := slices.Clone(slugs)
+		if rootNamed {
+			subjects = append(subjects, boardengine.RootSubject)
+		}
+		record = adoptrecord.Record{Subjects: subjects}
+	}
+	if restart {
+		record.Steps, record.StoppedPart = nil, nil
+	}
+	record.Request = req.recorded()
+	record.PID, record.StartTicks, record.Start = deps.PID, deps.StartTicks, deps.Now()
+	record.State, record.InFlight, record.Envelope = adoptrecord.StateRunning, from, nil
+
+	var result outcome
+	var final adoptrecord.Record
+	run := &stepRun{
+		Deps:      deps.Steps,
+		Req:       req,
+		Here:      here,
+		Slugs:     slugs,
+		RootNamed: rootNamed,
+		Owners:    owners,
+		Outcomes:  map[string]*slugOutcome{},
+		Mutations: fabricengine.NewMutations(deps.Steps.HubPath),
+		Record:    record,
+		Now:       deps.Now,
+	}
+	run.Save = func(saved adoptrecord.Record) error {
+		if saved.State != adoptrecord.StateRunning {
+			merged, err := envelopeOf(saved)
+			if err != nil {
+				return err
+			}
+			result = merged
+			saved.Envelope = adoptFields(merged)
+		}
+		final = saved
+		return deps.WriteRecord(saved)
+	}
+	if err := run.save(); err != nil {
+		return outcome{}, adoptrecord.Record{}, err
+	}
+	if err := runSteps(run, from); err != nil {
+		return result, final, err
+	}
+	return result, final, run.Stopped
+}
+
+// splitSubjects returns the beam slugs a record's subjects name and whether they name root.
+func splitSubjects(subjects []string) (slugs []string, rootNamed bool) {
+	for _, subject := range subjects {
+		if subject == boardengine.RootSubject {
+			rootNamed = true
+			continue
+		}
+		slugs = append(slugs, subject)
+	}
+	return slugs, rootNamed
+}
+
+// reconcileWire is the part of a reconcile report a recorded step part holds that decodes back.
+// The report's mutation record is left out: it has no decoder, and the part's own mutations list the same entries.
+// So the envelope's reconcile object carries no mutations, and its top-level mutations field holds the record.
+type reconcileWire struct {
+	Unreachable bool
+	Branches    []fabricengine.BranchOutcome
+	Entries     []fabricengine.EntryOutcome
+}
+
+// partWire is an outcomePart as decoded from a record, its reconcile report read through reconcileWire.
+type partWire struct {
+	outcomePart
+	Reconcile *reconcileWire `json:"reconcile,omitempty"`
+}
+
+// decodePart decodes the outcome part a step recorded.
+func decodePart(raw json.RawMessage) (outcomePart, error) {
+	var wire partWire
+	if err := json.Unmarshal(raw, &wire); err != nil {
+		return outcomePart{}, err
+	}
+	part := wire.outcomePart
+	if wire.Reconcile != nil {
+		part.Reconcile = &fabricengine.OriginReport{Unreachable: wire.Reconcile.Unreachable, Branches: wire.Reconcile.Branches, Entries: wire.Reconcile.Entries}
+	}
+	return part, nil
+}
+
+// envelopeOf merges the outcome parts of the record into the adopt's end envelope.
+// It takes the part of every step the record lists as done, an earlier process's steps included, in step order.
+// It then takes the part a stopped step gathered before its error, without listing that step as done.
+// A scalar field of a later part replaces an earlier one.
+// Slugs merge per slug and per field, and list fields concatenate.
+// Every slug the record's subjects, runs and paused slugs name has an entry, even when no part holds a field of it.
+// The slugs the record's subjects name, root apart, and that a part holds come first, in the subjects' order.
+func envelopeOf(record adoptrecord.Record) (outcome, error) {
+	var result outcome
+	outcomes := map[string]*slugOutcome{}
+	merge := func(step string, raw json.RawMessage) error {
+		if len(raw) == 0 {
+			return nil
+		}
+		part, err := decodePart(raw)
+		if err != nil {
+			return fmt.Errorf("lym adopt: decode the part of the %s step: %w", step, err)
+		}
+		return mergePart(&result, outcomes, part)
+	}
+	for _, step := range adoptrecord.Steps {
+		index := slices.IndexFunc(record.Steps, func(done adoptrecord.StepRecord) bool { return done.Name == step })
+		if index < 0 {
+			continue
+		}
+		if err := merge(step, record.Steps[index].Outcome); err != nil {
+			return outcome{}, err
+		}
+	}
+	if err := merge(record.InFlight, record.StoppedPart); err != nil {
+		return outcome{}, err
+	}
+
+	if result.Mutations == nil {
+		result.Mutations = []fabricengine.Mutation{}
+	}
+	seedOutcomes(outcomes, record)
+	var named []string
+	for _, subject := range record.Subjects {
+		if subject != boardengine.RootSubject {
+			named = append(named, subject)
+		}
+	}
+	result.Slugs = collect(named, outcomes)
+	return result, nil
+}
