+//go:build tier1
+
+// render_integration_test.go proves a render leaves a hub's prime free of untracked files.
+
+package heddleengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/heddleengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+)
+
+// TestRender_LeavesNoUntrackedFile renders both file targets into a hub's prime from the event fabric builds, and expects git to see nothing untracked.
+func TestRender_LeavesNoUntrackedFile(t *testing.T) {
+	t.Parallel()
+	hub := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	store := heddleengine.Store{Entries: []heddleengine.Entry{
+		{Slug: "claude", Text: "claude text", Order: 1, Targets: []string{"claude-file"}},
+		{Slug: "codex", Text: "codex text", Order: 2, Targets: []string{"codex-file"}},
+	}}
+	if err := heddleengine.Save(hub.BoardDir(), store); err != nil {
+		t.Fatal(err)
+	}
+
+	event, err := fabricengine.EventFor(hub.Location, nil)
+	if err != nil {
+		t.Fatalf("EventFor() = %v", err)
+	}
+	report, err := heddleengine.Renderer{}.Render(heddleengine.RenderRequest{
+		Root: event.Root, ScratchDir: event.ScratchDir, BoltDir: event.BoltDir, Excluded: event.Excluded,
+	})
+	if err != nil {
+		t.Fatalf("Render() = %v", err)
+	}
+	if len(report.Warnings) != 0 {
+		t.Errorf("Render() warnings = %v; want none", report.Warnings)
+	}
+	for _, name := range []string{"CLAUDE.local.md", "AGENTS.override.md"} {
+		if _, err := os.Stat(filepath.Join(hub.PrimeWorktree(), name)); err != nil {
+			t.Errorf("%s was not rendered: %v", name, err)
+		}
+	}
+	if status := gitkit.Git(t, hub.PrimeWorktree(), "status", "--porcelain", "--untracked-files=all"); status != "" {
+		t.Errorf("git status in the prime = %q; want it empty", status)
+	}
+}
diff --git a/internal/heddleengine/render_test.go b/internal/heddleengine/render_test.go
new file mode 100644
index 00000000..3dc69cd2
--- /dev/null
+++ b/internal/heddleengine/render_test.go
@@ -0,0 +1,390 @@
+//go:build tier0
+
+// render_test.go drives Render, Show and Passages over temporary directories standing in for a worktree's root, its scratch directory and the Bolt checkout.
+
+package heddleengine
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+)
+
+// observeWindow is how long a test watches a blocked render stay blocked.
+const observeWindow = 50 * time.Millisecond
+
+// renderFixture is the three directories a render works over, with the exclude list a seeded worktree holds.
+type renderFixture struct {
+	root     string
+	scratch  string
+	bolt     string
+	excluded []string
+}
+
+func newRenderFixture(t *testing.T, store Store) renderFixture {
+	t.Helper()
+	fixture := renderFixture{
+		root:     t.TempDir(),
+		scratch:  t.TempDir(),
+		bolt:     t.TempDir(),
+		excluded: []string{"CLAUDE.local.md", "AGENTS.override.md", ".heddle"},
+	}
+	saveStore(t, fixture.bolt, store)
+	return fixture
+}
+
+func (f renderFixture) request(only ...string) RenderRequest {
+	return RenderRequest{Root: f.root, ScratchDir: f.scratch, BoltDir: f.bolt, Excluded: f.excluded, Only: only}
+}
+
+func (f renderFixture) writeRoot(t *testing.T, rel, content string) {
+	t.Helper()
+	path := filepath.Join(f.root, filepath.FromSlash(rel))
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (f renderFixture) readRoot(t *testing.T, rel string) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(f.root, filepath.FromSlash(rel)))
+	if err != nil {
+		t.Fatalf("read %s: %v", rel, err)
+	}
+	return string(data)
+}
+
+func (f renderFixture) rootHas(rel string) bool {
+	_, err := os.Lstat(filepath.Join(f.root, filepath.FromSlash(rel)))
+	return err == nil
+}
+
+// entryFor builds an entry aimed at one or more targets.
+func entryFor(slug, text string, order int, targets ...string) Entry {
+	return Entry{Slug: slug, Text: text, Order: order, Targets: targets}
+}
+
+// renderOutcome is what a render running in a goroutine returned.
+type renderOutcome struct {
+	report Report
+	err    error
+}
+
+// renderInBackground starts the render and returns the channel its outcome arrives on.
+func renderInBackground(r Renderer, req RenderRequest) <-chan renderOutcome {
+	done := make(chan renderOutcome, 1)
+	go func() {
+		report, err := r.Render(req)
+		done <- renderOutcome{report, err}
+	}()
+	return done
+}
+
+// requireStillBlocked fails when the render finished within the observe window.
+func requireStillBlocked(t *testing.T, done <-chan renderOutcome) {
+	t.Helper()
+	select {
+	case outcome := <-done:
+		t.Fatalf("render finished while its lock was held: %+v", outcome)
+	case <-time.After(observeWindow):
+	}
+}
+
+// requireFinished waits for the render and fails on an error.
+func requireFinished(t *testing.T, done <-chan renderOutcome) Report {
+	t.Helper()
+	select {
+	case outcome := <-done:
+		if outcome.err != nil {
+			t.Fatalf("Render() = %v", outcome.err)
+		}
+		return outcome.report
+	case <-time.After(30 * time.Second):
+		t.Fatal("render did not finish after its lock was released")
+		return Report{}
+	}
+}
+
+func mustRender(t *testing.T, f renderFixture, only ...string) Report {
+	t.Helper()
+	report, err := Renderer{}.Render(f.request(only...))
+	if err != nil {
+		t.Fatalf("Render() = %v", err)
+	}
+	return report
+}
+
+func TestRender(t *testing.T) {
+	t.Parallel()
+
+	claudeStore := Store{Entries: []Entry{
+		entryFor("second", "two", 2, "claude-file"),
+		entryFor("first", "one", 1, "claude-file"),
+	}}
+
+	t.Run("ClaudeFileJoinsEntriesInOrder", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, claudeStore)
+		report := mustRender(t, f)
+		if want := Marker + "\n\none\n\ntwo\n"; f.readRoot(t, "CLAUDE.local.md") != want {
+			t.Errorf("CLAUDE.local.md = %q; want %q", f.readRoot(t, "CLAUDE.local.md"), want)
+		}
+		if !slices.Equal(report.Written, []string{"CLAUDE.local.md"}) || len(report.Warnings) != 0 {
+			t.Errorf("report = %+v; want only CLAUDE.local.md written", report)
+		}
+		if f.rootHas(".heddle") {
+			t.Error(".heddle left behind")
+		}
+	})
+
+	t.Run("ClaudeFileImportsAgentsFiles", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name  string
+			files []string
+			want  string
+		}{
+			{"RootAgents", []string{"AGENTS.md"}, "@AGENTS.md\n\n"},
+			{"ClaudeDirAgents", []string{".claude/AGENTS.md"}, "@.claude/AGENTS.md\n\n"},
+			{"BothAgents", []string{"AGENTS.md", ".claude/AGENTS.md"}, "@AGENTS.md\n@.claude/AGENTS.md\n\n"},
+			{"RootClaude", []string{"AGENTS.md", "CLAUDE.md"}, ""},
+			{"ClaudeDirClaude", []string{"AGENTS.md", ".claude/CLAUDE.md"}, ""},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				f := newRenderFixture(t, Store{Entries: []Entry{entryFor("only", "text", 1, "claude-file")}})
+				for _, rel := range tt.files {
+					f.writeRoot(t, rel, "base\n")
+				}
+				mustRender(t, f)
+				if want := Marker + "\n\n" + tt.want + "text\n"; f.readRoot(t, "CLAUDE.local.md") != want {
+					t.Errorf("CLAUDE.local.md = %q; want %q", f.readRoot(t, "CLAUDE.local.md"), want)
+				}
+			})
+		}
+	})
+
+	t.Run("CodexFileOpensWithRootAgents", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, Store{Entries: []Entry{entryFor("c", "codex text", 1, "codex-file")}})
+		f.writeRoot(t, "AGENTS.md", "repository rules\n")
+		mustRender(t, f)
+		if want := Marker + "\n\nrepository rules\n\ncodex text\n"; f.readRoot(t, "AGENTS.override.md") != want {
+			t.Errorf("AGENTS.override.md = %q; want %q", f.readRoot(t, "AGENTS.override.md"), want)
+		}
+		if f.rootHas("CLAUDE.local.md") {
+			t.Error("CLAUDE.local.md written with no claude-file entry")
+		}
+	})
+
+	t.Run("StaleMarkedRenderIsRemovedEvenOffExcluded", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, Store{Entries: []Entry{entryFor("c", "codex text", 1, "codex-file")}})
+		f.excluded = nil
+		f.writeRoot(t, "CLAUDE.local.md", Marker+"\n\nold\n")
+		report := mustRender(t, f)
+		if f.rootHas("CLAUDE.local.md") || !slices.Equal(report.Removed, []string{"CLAUDE.local.md"}) {
+			t.Errorf("stale render kept or not reported: removed %v", report.Removed)
+		}
+	})
+
+	t.Run("UnmarkedFileIsLeftAlone", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, claudeStore)
+		f.writeRoot(t, "CLAUDE.local.md", "mine\n")
+		report := mustRender(t, f)
+		if f.readRoot(t, "CLAUDE.local.md") != "mine\n" {
+			t.Error("unmarked CLAUDE.local.md was overwritten")
+		}
+		if len(report.Warnings) != 1 || !strings.Contains(report.Warnings[0], "CLAUDE.local.md") {
+			t.Errorf("warnings = %v; want one naming CLAUDE.local.md", report.Warnings)
+		}
+
+		f = newRenderFixture(t, Store{Entries: []Entry{entryFor("c", "codex", 1, "codex-file")}})
+		f.writeRoot(t, "CLAUDE.local.md", "mine\n")
+		mustRender(t, f)
+		if f.readRoot(t, "CLAUDE.local.md") != "mine\n" {
+			t.Error("unmarked CLAUDE.local.md was removed")
+		}
+	})
+
+	t.Run("OffExcludedTargetIsNotWritten", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name     string
+			excluded []string
+			want     string
+		}{
+			{"TargetOff", []string{".heddle"}, fabricengine.ExcludeWayForward("CLAUDE.local.md")},
+			{"TempDirOff", []string{"CLAUDE.local.md"}, fabricengine.ExcludeWayForward(".heddle")},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				f := newRenderFixture(t, claudeStore)
+				f.excluded = tt.excluded
+				report := mustRender(t, f)
+				if f.rootHas("CLAUDE.local.md") || f.rootHas(".heddle") {
+					t.Error("a file was written although the exclude list lacks a path")
+				}
+				if !slices.Contains(report.Warnings, tt.want) {
+					t.Errorf("warnings = %v; want %q", report.Warnings, tt.want)
+				}
+			})
+		}
+	})
+
+	t.Run("BlockedTempDirWritesNoFile", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name  string
+			setup func(f renderFixture, t *testing.T)
+		}{
+			{"File", func(f renderFixture, t *testing.T) { f.writeRoot(t, ".heddle", "x") }},
+			{"DirWithOtherFile", func(f renderFixture, t *testing.T) { f.writeRoot(t, ".heddle/notes.txt", "x") }},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				f := newRenderFixture(t, claudeStore)
+				tt.setup(f, t)
+				report := mustRender(t, f)
+				if f.rootHas("CLAUDE.local.md") {
+					t.Error("CLAUDE.local.md written although .heddle is blocked")
+				}
+				if len(report.Warnings) != 1 || !strings.Contains(report.Warnings[0], ".heddle") || !strings.Contains(report.Warnings[0], "lym heddle render") {
+					t.Errorf("warnings = %v; want one naming .heddle and lym heddle render", report.Warnings)
+				}
+			})
+		}
+	})
+
+	t.Run("LeftoverTempFileIsOverwritten", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, claudeStore)
+		f.writeRoot(t, ".heddle/CLAUDE.local.md.tmp", "half a render")
+		mustRender(t, f)
+		if !strings.HasPrefix(f.readRoot(t, "CLAUDE.local.md"), Marker) || f.rootHas(".heddle") {
+			t.Error("leftover temp file not overwritten, or .heddle left behind")
+		}
+	})
+
+	t.Run("OnlyLimitsTheTargets", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, Store{Entries: []Entry{entryFor("both", "t", 1, "claude-file", "codex-file")}})
+		mustRender(t, f, "codex-file")
+		if f.rootHas("CLAUDE.local.md") || !f.rootHas("AGENTS.override.md") {
+			t.Error("Only codex-file did not leave CLAUDE.local.md unwritten and AGENTS.override.md written")
+		}
+	})
+
+	t.Run("HeldBoltLockFailsTheRender", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, claudeStore)
+		held, err := lock.AcquireWriteLock(filepath.Join(f.bolt, fabricengine.BoardWriteLockFile))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer func() { _ = held.Release() }()
+		_, err = Renderer{BoltLockWait: observeWindow}.Render(f.request())
+		if err == nil || !strings.Contains(err.Error(), "lym heddle render") {
+			t.Errorf("Render() = %v; want an error naming lym heddle render", err)
+		}
+		if f.rootHas("CLAUDE.local.md") || f.rootHas(".heddle") {
+			t.Error("a failed render wrote something")
+		}
+	})
+
+	t.Run("ReadWaitsForTheBoltLock", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, Store{})
+		if err := os.Remove(filepath.Join(f.bolt, FileName)); err != nil {
+			t.Fatal(err)
+		}
+		held, err := lock.AcquireWriteLock(filepath.Join(f.bolt, fabricengine.BoardWriteLockFile))
+		if err != nil {
+			t.Fatal(err)
+		}
+		done := renderInBackground(Renderer{BoltLockWait: 30 * time.Second}, f.request())
+		requireStillBlocked(t, done)
+		if f.rootHas("CLAUDE.local.md") {
+			t.Error("a file was written while the Bolt lock was held")
+		}
+		saveStore(t, f.bolt, claudeStore)
+		if err := held.Release(); err != nil {
+			t.Fatal(err)
+		}
+		requireFinished(t, done)
+		if want := Marker + "\n\none\n\ntwo\n"; f.readRoot(t, "CLAUDE.local.md") != want {
+			t.Errorf("CLAUDE.local.md = %q; want the new store's text", f.readRoot(t, "CLAUDE.local.md"))
+		}
+	})
+
+	t.Run("RenderLockSerializesRenders", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, claudeStore)
+		lockDir := filepath.Join(f.scratch, lymdirs.HeddleDirName)
+		if err := os.MkdirAll(lockDir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		held, err := lock.AcquireWriteLock(filepath.Join(lockDir, "render.lock"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		done := renderInBackground(Renderer{}, f.request())
+		requireStillBlocked(t, done)
+		if f.rootHas("CLAUDE.local.md") || f.rootHas(".heddle") {
+			t.Error("a render wrote while another held the render lock")
+		}
+		if err := held.Release(); err != nil {
+			t.Fatal(err)
+		}
+		requireFinished(t, done)
+		if !f.rootHas("CLAUDE.local.md") {
+			t.Error("the render did not complete after the render lock was released")
+		}
+	})
+
+	t.Run("ShowAndPassagesWriteNothing", func(t *testing.T) {
+		t.Parallel()
+		f := newRenderFixture(t, Store{Entries: []Entry{
+			entryFor("b", "prompt two", 2, "claude-prompt"),
+			entryFor("a", "prompt one", 1, "claude-prompt"),
+			entryFor("c", "file text", 3, "claude-file"),
+		}})
+		r := Renderer{}
+		shown, err := r.Show(f.bolt, "claude-file", f.root)
+		if err != nil || shown != Marker+"\n\nfile text\n" {
+			t.Errorf("Show(claude-file) = %q, %v", shown, err)
+		}
+		shown, err = r.Show(f.bolt, "claude-prompt", f.root)
+		if err != nil || shown != "prompt one\n\nprompt two" {
+			t.Errorf("Show(claude-prompt) = %q, %v", shown, err)
+		}
+		if _, err := r.Show(f.bolt, "nope", f.root); err == nil || !strings.Contains(err.Error(), "claude-file") {
+			t.Errorf("Show(nope) = %v; want an error naming the valid targets", err)
+		}
+		claude, err := r.Passages(f.bolt, "claude")
+		if err != nil || !slices.Equal(claude, []string{"prompt one", "prompt two"}) {
+			t.Errorf("Passages(claude) = %v, %v", claude, err)
+		}
+		codex, err := r.Passages(f.bolt, "codex")
+		if err != nil || len(codex) != 0 {
+			t.Errorf("Passages(codex) = %v, %v; want none", codex, err)
+		}
+		if f.rootHas("CLAUDE.local.md") || f.rootHas(".heddle") {
+			t.Error("Show or Passages wrote a file")
+		}
+	})
+}
diff --git a/internal/heddleengine/replayer.go b/internal/heddleengine/replayer.go
new file mode 100644
index 00000000..326814f3
--- /dev/null
+++ b/internal/heddleengine/replayer.go
@@ -0,0 +1,177 @@
+// replayer.go holds heddle's Bolt replayer: the by-entry merge of a local heddle.json commit onto origin's store.
+
+package heddleengine
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/entrymerge"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// Replayer is heddle's Bolt replayer, named heddle.
+// It holds no state, claims the store file alone and is no run ledger.
+type Replayer struct{}
+
+var _ fabricengine.BoltReplayer = Replayer{}
+
+// Name returns the replayer's registry name.
+func (Replayer) Name() string { return "heddle" }
+
+// Claims reports whether path, a Bolt-root-relative slash path, is the store file.
+func (Replayer) Claims(path string) bool { return path == FileName }
+
+// entryFields is the merge's table over Entry, keyed by slug.
+// Unknown keys are not fields: they stay as origin holds them.
+var entryFields = entrymerge.Table[Entry]{
+	Key: func(e Entry) string { return e.Slug },
+	Fields: []entrymerge.Field[Entry]{
+		{Name: "text", Get: func(e Entry) any { return e.Text }, Set: func(dst *Entry, src Entry) { dst.Text = src.Text }},
+		{Name: "order", Get: func(e Entry) any { return e.Order }, Set: func(dst *Entry, src Entry) { dst.Order = src.Order }},
+		{Name: "targets", Get: func(e Entry) any {
+			if e.Targets == nil {
+				return []string{}
+			}
+			return e.Targets
+		}, Set: func(dst *Entry, src Entry) { dst.Targets = slices.Clone(src.Targets) }},
+	},
+}
+
+// replayRun is the state of one Apply: origin's store, what the commit's three sides held and what has been applied or set aside so far.
+type replayRun struct {
+	store   Store
+	base    Store
+	result  fabricengine.ReplayResult
+	applied bool
+}
+
+// Apply re-applies the request's heddle.json commit onto origin's store in req.Dir by entry, and reports what it kept and what it set aside.
+// A changed entry merges field by field with origin winning a field both sides changed, an added entry is appended unless origin added the slug too, and a removed entry is dropped only while origin still holds it as the commit's parent did.
+// A change to an entry origin no longer holds is reported lost.
+// An entry that fails ValidateEntry is reported refused and the rest of the commit still lands.
+// It saves through Save, so every unknown key stays as origin holds it, and writes nothing when no change survived.
+// It takes no lock, since its caller holds the Bolt write and push locks.
+func (Replayer) Apply(req fabricengine.ReplayRequest) (fabricengine.ReplayResult, error) {
+	var baseBytes, parentBytes, commitBytes []byte
+	for _, file := range req.Files {
+		if file.Path == FileName {
+			baseBytes, parentBytes, commitBytes = file.Base, file.Before, file.After
+		}
+	}
+	base, err := Decode(baseBytes)
+	if err != nil {
+		return fabricengine.ReplayResult{}, fmt.Errorf("merge base %s: %w", FileName, err)
+	}
+	parent, err := Decode(parentBytes)
+	if err != nil {
+		return fabricengine.ReplayResult{}, fmt.Errorf("parent %s: %w", FileName, err)
+	}
+	commit, err := Decode(commitBytes)
+	if err != nil {
+		return fabricengine.ReplayResult{}, fmt.Errorf("commit %s: %w", FileName, err)
+	}
+	origin, err := Load(req.Dir)
+	if err != nil {
+		return fabricengine.ReplayResult{}, err
+	}
+
+	run := &replayRun{store: origin, base: base}
+	run.store.Entries = slices.Clone(origin.Entries)
+	for _, entry := range commit.Entries {
+		if before, existed := parent.Get(entry.Slug); existed {
+			run.changeEntry(before, entry)
+		} else {
+			run.addEntry(entry)
+		}
+	}
+	for _, before := range parent.Entries {
+		if _, kept := commit.Get(before.Slug); !kept {
+			run.removeEntry(before)
+		}
+	}
+
+	run.result.Empty = !run.applied
+	if run.result.Empty {
+		return run.result, nil
+	}
+	if err := Save(req.Dir, run.store); err != nil {
+		return fabricengine.ReplayResult{}, fmt.Errorf("save %s: %w", FileName, err)
+	}
+	return run.result, nil
+}
+
+func (r *replayRun) lost(entry, field, reason, local string) {
+	r.result.Lost = append(r.result.Lost, fabricengine.ReplayFinding{Entry: entry, Field: field, Reason: reason, Local: local})
+}
+
+func (r *replayRun) refuse(entry, field string, err error) {
+	r.result.Refused = append(r.result.Refused, fabricengine.ReplayFinding{Entry: entry, Field: field, Reason: err.Error()})
+}
+
+// originIndex returns the index of the entry origin holds under slug, or -1.
+func (r *replayRun) originIndex(slug string) int {
+	return slices.IndexFunc(r.store.Entries, func(entry Entry) bool { return entry.Slug == slug })
+}
+
+// changeEntry applies the fields commit changed against before onto origin's entry.
+// A field origin already holds is skipped, a field origin moved to a third value is reported lost, and an entry origin no longer holds reports the change lost.
+func (r *replayRun) changeEntry(before, commit Entry) {
+	if len(entryFields.Changed(before, commit)) == 0 {
+		return
+	}
+	index := r.originIndex(commit.Slug)
+	if index < 0 {
+		r.lost(commit.Slug, "", "origin does not hold the entry", "")
+		return
+	}
+	origin := r.store.Entries[index]
+	origin.Targets = slices.Clone(origin.Targets)
+	base, _ := r.base.Get(commit.Slug)
+	merged, applied, losses := entryFields.Change(base, before, origin, commit)
+	for _, loss := range losses {
+		r.lost(loss.Entry, loss.Field, loss.Reason, loss.Local)
+	}
+	if len(applied) == 0 {
+		return
+	}
+	if err := ValidateEntry(merged); err != nil {
+		r.refuse(commit.Slug, strings.Join(applied, ", "), err)
+		return
+	}
+	r.store.Entries[index] = merged
+	r.applied = true
+}
+
+// addEntry appends commit's entry when origin holds none under its slug.
+// Where origin holds one, each field the commit's entry carries differently is reported lost.
+func (r *replayRun) addEntry(commit Entry) {
+	if index := r.originIndex(commit.Slug); index >= 0 {
+		for _, clash := range entryFields.AddClash(r.store.Entries[index], commit) {
+			r.lost(clash.Entry, clash.Field, clash.Reason, clash.Local)
+		}
+		return
+	}
+	if err := ValidateEntry(commit); err != nil {
+		r.refuse(commit.Slug, "", err)
+		return
+	}
+	r.store.Entries = append(r.store.Entries, commit)
+	r.applied = true
+}
+
+// removeEntry drops before's entry from origin's store while origin still holds it as the commit's parent did.
+// An entry origin changed is kept and reported lost, and one origin already dropped needs nothing.
+func (r *replayRun) removeEntry(before Entry) {
+	index := r.originIndex(before.Slug)
+	if index < 0 {
+		return
+	}
+	if !entryFields.Same(r.store.Entries[index], before) {
+		r.lost(before.Slug, "", "origin changed the entry this commit removes", "")
+		return
+	}
+	r.store.Entries = slices.Delete(r.store.Entries, index, index+1)
+	r.applied = true
+}
diff --git a/internal/heddleengine/replayer_test.go b/internal/heddleengine/replayer_test.go
new file mode 100644
index 00000000..16ee1642
--- /dev/null
+++ b/internal/heddleengine/replayer_test.go
@@ -0,0 +1,177 @@
+//go:build tier0
+
+// replayer_test.go drives heddle's Bolt replayer over a temporary directory standing in for the Bolt checkout.
+
+package heddleengine
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// storeBytes encodes a store as the commit side of a replay request.
+func storeBytes(t *testing.T, entries ...Entry) []byte {
+	t.Helper()
+	data, err := json.Marshal(Store{Entries: entries})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// compacted returns raw without insignificant whitespace, since a saved store re-indents the raw values it keeps.
+func compacted(t *testing.T, raw json.RawMessage) string {
+	t.Helper()
+	var buffer bytes.Buffer
+	if err := json.Compact(&buffer, raw); err != nil {
+		t.Fatal(err)
+	}
+	return buffer.String()
+}
+
+// replayEntry builds an entry aimed at claude-file.
+func replayEntry(slug, text string, order int) Entry {
+	return entryFor(slug, text, order, "claude-file")
+}
+
+// applyReplay saves origin into a fresh directory, replays one commit onto it and returns the result and the store afterwards.
+func applyReplay(t *testing.T, origin Store, base, parent, commit []byte) (fabricengine.ReplayResult, Store) {
+	t.Helper()
+	dir := t.TempDir()
+	saveStore(t, dir, origin)
+	result, err := Replayer{}.Apply(fabricengine.ReplayRequest{
+		Dir:   dir,
+		Files: []fabricengine.ReplayFile{{Path: FileName, Base: base, Before: parent, After: commit}},
+	})
+	if err != nil {
+		t.Fatalf("Apply() = %v", err)
+	}
+	return result, loadStore(t, dir)
+}
+
+func TestReplayer(t *testing.T) {
+	t.Parallel()
+
+	a, b := replayEntry("a", "A", 1), replayEntry("b", "B", 2)
+
+	t.Run("NameAndClaims", func(t *testing.T) {
+		t.Parallel()
+		r := Replayer{}
+		if r.Name() != "heddle" || !r.Claims("heddle.json") || r.Claims("board.json") || r.Claims("sub/heddle.json") {
+			t.Error("Replayer must be named heddle and claim exactly heddle.json at the root")
+		}
+		if _, isLedger := any(r).(fabricengine.RunLedger); isLedger {
+			t.Error("Replayer is a run ledger")
+		}
+	})
+
+	t.Run("TextOnlyTheCommitChangedIsApplied", func(t *testing.T) {
+		t.Parallel()
+		changed := replayEntry("a", "A local", 1)
+		result, store := applyReplay(t, Store{Entries: []Entry{a, b}}, storeBytes(t, a, b), storeBytes(t, a, b), storeBytes(t, changed, b))
+		if got, _ := store.Get("a"); got.Text != "A local" || result.Empty || len(result.Lost) != 0 {
+			t.Errorf("entry a = %+v, result = %+v; want the local text applied", got, result)
+		}
+	})
+
+	t.Run("OrderChangedOnBothSidesKeepsOriginsAndReportsLost", func(t *testing.T) {
+		t.Parallel()
+		local, origin := replayEntry("a", "A", 5), replayEntry("a", "A", 7)
+		result, store := applyReplay(t, Store{Entries: []Entry{origin}}, storeBytes(t, a), storeBytes(t, a), storeBytes(t, local))
+		if got, _ := store.Get("a"); got.Order != 7 {
+			t.Errorf("order = %d; want origin's 7", got.Order)
+		}
+		if len(result.Lost) != 1 || result.Lost[0].Field != "order" || result.Lost[0].Local != "5" || !result.Empty {
+			t.Errorf("result = %+v; want the local order 5 lost and nothing applied", result)
+		}
+	})
+
+	t.Run("UnknownKeysSurviveAReplayedText", func(t *testing.T) {
+		t.Parallel()
+		withUnknown := a
+		withUnknown.Unknown = map[string]json.RawMessage{"extra": json.RawMessage(`{"k":1}`)}
+		changed := replayEntry("a", "A local", 1)
+		_, store := applyReplay(t, Store{Entries: []Entry{withUnknown}, Unknown: map[string]json.RawMessage{"top": json.RawMessage(`true`)}},
+			storeBytes(t, a), storeBytes(t, a), storeBytes(t, changed))
+		got, _ := store.Get("a")
+		if got.Text != "A local" || compacted(t, got.Unknown["extra"]) != `{"k":1}` || compacted(t, store.Unknown["top"]) != "true" {
+			t.Errorf("entry = %+v, store unknown = %v; want the text replayed and every unknown key kept", got, store.Unknown)
+		}
+	})
+
+	t.Run("AddedEntryIsAppendedAndRemovedOneDropped", func(t *testing.T) {
+		t.Parallel()
+		c := replayEntry("c", "C", 3)
+		_, store := applyReplay(t, Store{Entries: []Entry{a, b}}, storeBytes(t, a, b), storeBytes(t, a, b), storeBytes(t, b, c))
+		if _, held := store.Get("a"); held {
+			t.Error("a was not dropped")
+		}
+		if got := store.Entries; len(got) != 2 || got[0].Slug != "b" || got[1].Slug != "c" {
+			t.Errorf("entries = %+v; want b then c", got)
+		}
+	})
+
+	t.Run("InvalidAddedEntryIsRefusedAndTheRestLands", func(t *testing.T) {
+		t.Parallel()
+		empty := replayEntry("c", "  ", 3)
+		changed := replayEntry("a", "A local", 1)
+		result, store := applyReplay(t, Store{Entries: []Entry{a, b}}, storeBytes(t, a, b), storeBytes(t, a, b), storeBytes(t, changed, b, empty))
+		if len(result.Refused) != 1 || result.Refused[0].Entry != "c" {
+			t.Errorf("refused = %+v; want c refused", result.Refused)
+		}
+		if _, held := store.Get("c"); held {
+			t.Error("the refused entry was added")
+		}
+		if got, _ := store.Get("a"); got.Text != "A local" {
+			t.Errorf("a.Text = %q; want the rest of the commit applied", got.Text)
+		}
+	})
+
+	t.Run("CommitWithNoEntryChangeIsEmptyAndWritesNothing", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		result, err := Replayer{}.Apply(fabricengine.ReplayRequest{
+			Dir:   dir,
+			Files: []fabricengine.ReplayFile{{Path: FileName, Base: storeBytes(t, a), Before: storeBytes(t, a), After: storeBytes(t, a)}},
+		})
+		if err != nil || !result.Empty {
+			t.Fatalf("Apply() = %+v, %v; want Empty", result, err)
+		}
+		if got := loadStore(t, dir); len(got.Entries) != 0 {
+			t.Errorf("store after an empty replay = %+v; want it unwritten", got)
+		}
+	})
+
+	t.Run("ChangeToAnEntryOriginNoLongerHoldsIsLost", func(t *testing.T) {
+		t.Parallel()
+		changed := replayEntry("a", "A local", 1)
+		result, store := applyReplay(t, Store{Entries: []Entry{b}}, storeBytes(t, a, b), storeBytes(t, a, b), storeBytes(t, changed, b))
+		if _, held := store.Get("a"); held || len(result.Lost) != 1 || result.Lost[0].Entry != "a" {
+			t.Errorf("result = %+v, store = %+v; want a reported lost and not added back", result, store)
+		}
+	})
+
+	t.Run("RemovalOfAnEntryOriginChangedIsLostAndTheEntryKept", func(t *testing.T) {
+		t.Parallel()
+		originChanged := replayEntry("a", "A origin", 1)
+		result, store := applyReplay(t, Store{Entries: []Entry{originChanged, b}}, storeBytes(t, a, b), storeBytes(t, a, b), storeBytes(t, b))
+		if got, held := store.Get("a"); !held || got.Text != "A origin" || len(result.Lost) != 1 {
+			t.Errorf("result = %+v, store = %+v; want the removal lost and a kept as origin holds it", result, store)
+		}
+	})
+
+	t.Run("EntryAddedOnBothSidesReportsEachDifferingFieldLost", func(t *testing.T) {
+		t.Parallel()
+		local, origin := replayEntry("c", "local text", 3), replayEntry("c", "origin text", 3)
+		result, store := applyReplay(t, Store{Entries: []Entry{origin}}, storeBytes(t), storeBytes(t), storeBytes(t, local))
+		if got, _ := store.Get("c"); got.Text != "origin text" {
+			t.Errorf("c.Text = %q; want origin's", got.Text)
+		}
+		if len(result.Lost) != 1 || result.Lost[0].Field != "text" || !result.Empty {
+			t.Errorf("lost = %+v; want only the text field lost", result.Lost)
+		}
+	})
+}
diff --git a/internal/heddleengine/seam.go b/internal/heddleengine/seam.go
new file mode 100644
index 00000000..fa5e2c83
--- /dev/null
+++ b/internal/heddleengine/seam.go
@@ -0,0 +1,55 @@
+// seam.go implements fabric's worktree seam: the file targets are rendered when a worktree is made, and re-rendered when a take-in changes a path they are built from.
+
+package heddleengine
+
+import (
+	"slices"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// Seam renders heddle's file targets on the events fabric fires for a worktree.
+// A change to the store itself is never an event, so a Bolt pull re-renders nothing and the next take-in or a hand render takes the store as it then stands.
+type Seam struct {
+	Renderer Renderer
+}
+
+var _ fabricengine.WorktreeSeam = Seam{}
+
+// Made renders every file target into the event's root.
+func (s Seam) Made(ev fabricengine.WorktreeEvent) error {
+	return s.render(requestOf(ev, nil))
+}
+
+// TookIn renders the file targets whose re-render paths include one of the event's paths.
+// With none selected it renders nothing and takes no lock.
+func (s Seam) TookIn(ev fabricengine.WorktreeEvent) error {
+	var selected []string
+	for _, target := range targetTable {
+		if target.Delivery != DeliveryFile {
+			continue
+		}
+		if slices.ContainsFunc(ev.Paths, func(path string) bool { return slices.Contains(target.ReRender, path) }) {
+			selected = append(selected, target.Name)
+		}
+	}
+	if len(selected) == 0 {
+		return nil
+	}
+	return s.render(requestOf(ev, selected))
+}
+
+// render runs the render and logs each of its warnings at Warn, naming the worktree.
+func (s Seam) render(req RenderRequest) error {
+	report, err := s.Renderer.Render(req)
+	for _, warning := range report.Warnings {
+		logger.Warn("heddleengine: render warning (non-fatal)", "worktree", req.Root, "warning", warning)
+	}
+	return err
+}
+
+// requestOf copies the event's root, scratch directory, Bolt checkout and exclude list into a render request for the targets only names.
+func requestOf(ev fabricengine.WorktreeEvent, only []string) RenderRequest {
+	return RenderRequest{Root: ev.Root, ScratchDir: ev.ScratchDir, BoltDir: ev.BoltDir, Excluded: ev.Excluded, Only: only}
+}
diff --git a/internal/heddleengine/seam_integration_test.go b/internal/heddleengine/seam_integration_test.go
new file mode 100644
index 00000000..d7e88ed4
--- /dev/null
+++ b/internal/heddleengine/seam_integration_test.go
@@ -0,0 +1,119 @@
+//go:build tier1
+
+// seam_integration_test.go proves the worktree seam, installed in fabric, renders what a pull takes in and ignores a Bolt pull.
+// It installs the process-wide seam, so it runs without t.Parallel.
+
+package heddleengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/heddleengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+)
+
+// pushHeddleFile commits a heddle.json holding store to the branch of the hub's Bolt checkout on the records remote, through a clone of its own.
+func pushHeddleFile(t *testing.T, hub *hubforge.Hub, store heddleengine.Store) {
+	t.Helper()
+	branch := gitkit.CurrentBranch(t, hub.BoardDir())
+	clone := filepath.Join(t.TempDir(), "bolt-clone")
+	gitkit.Git(t, filepath.Dir(clone), "clone", "--branch", branch, hub.RecordsBare, clone)
+	if err := heddleengine.Save(clone, store); err != nil {
+		t.Fatal(err)
+	}
+	gitkit.Git(t, clone, "add", "--", heddleengine.FileName)
+	gitkit.Git(t, clone, "commit", "-m", "heddle store", "--", heddleengine.FileName)
+	gitkit.Git(t, clone, "push", "origin", branch)
+}
+
+// pullBolt pulls the hub's Bolt checkout from its remote.
+func pullBolt(t *testing.T, hub *hubforge.Hub) {
+	t.Helper()
+	if _, _, err := fabricengine.NewBolt(hub.BoardDir()).Pull(fabricengine.SyncOptions{}, fabricengine.NewMutations(hub.Path)); err != nil {
+		t.Fatalf("Bolt Pull() = %v", err)
+	}
+}
+
+// stripExcludeLines removes the lines a seeded exclude list left in the exclude file of the repository checked out at worktree.
+func stripExcludeLines(t *testing.T, worktree string, paths []string) {
+	t.Helper()
+	commonDir := gitkit.Git(t, worktree, "rev-parse", "--git-common-dir")
+	if !filepath.IsAbs(commonDir) {
+		commonDir = filepath.Join(worktree, commonDir)
+	}
+	excludePath := filepath.Join(commonDir, "info", "exclude")
+	content, err := os.ReadFile(excludePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var kept []string
+	for _, line := range strings.Split(string(content), "\n") {
+		if !slices.Contains(paths, strings.TrimPrefix(line, "/")) {
+			kept = append(kept, line)
+		}
+	}
+	if err := os.WriteFile(excludePath, []byte(strings.Join(kept, "\n")), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// TestSeam_PullTakeIn pulls a commit that changes AGENTS.md into a hub whose Bolt checkout holds a codex-file entry, and expects the render to follow the take-in and a Bolt pull to render nothing.
+func TestSeam_PullTakeIn(t *testing.T) {
+	hub := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	second := hubforge.CloneSecond(t, hub)
+	entry := func(text string) heddleengine.Store {
+		return heddleengine.Store{Entries: []heddleengine.Entry{{Slug: "codex", Text: text, Order: 1, Targets: []string{"codex-file"}}}}
+	}
+	pushHeddleFile(t, hub, entry("codex text"))
+	pullBolt(t, hub)
+	t.Cleanup(fabricengine.InstallWorktreeSeam(heddleengine.Seam{}))
+
+	excluded := []string{"CLAUDE.local.md", "AGENTS.override.md", ".heddle"}
+	stripExcludeLines(t, hub.PrimeWorktree(), excluded)
+	gitkit.CommitFile(t, second.PrimeWorktree(), "AGENTS.md", "new rules\n", "change AGENTS.md")
+	gitkit.Git(t, second.PrimeWorktree(), "push", "origin", "HEAD")
+
+	if _, err := hubforge.OpenFabric(t, hub).Pull(fabricengine.SyncOptions{}); err != nil {
+		t.Fatalf("Pull() = %v", err)
+	}
+	overridePath := filepath.Join(hub.PrimeWorktree(), "AGENTS.override.md")
+	rendered, err := os.ReadFile(overridePath)
+	if err != nil {
+		t.Fatalf("AGENTS.override.md was not rendered by the pull: %v", err)
+	}
+	if want := heddleengine.Marker + "\n\nnew rules\n\ncodex text\n"; string(rendered) != want {
+		t.Errorf("AGENTS.override.md = %q; want %q", rendered, want)
+	}
+	exclude := gitkit.Git(t, hub.PrimeWorktree(), "rev-parse", "--git-path", "info/exclude")
+	if !filepath.IsAbs(exclude) {
+		exclude = filepath.Join(hub.PrimeWorktree(), exclude)
+	}
+	lines, err := os.ReadFile(exclude)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range excluded {
+		if !slices.Contains(strings.Split(string(lines), "\n"), "/"+path) {
+			t.Errorf("exclude line for %s is missing after the pull", path)
+		}
+	}
+	if status := gitkit.Git(t, hub.PrimeWorktree(), "status", "--porcelain", "--untracked-files=all"); status != "" {
+		t.Errorf("git status in the prime = %q; want it empty", status)
+	}
+
+	pushHeddleFile(t, second, entry("changed text"))
+	pullBolt(t, hub)
+	after, err := os.ReadFile(overridePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(after) != string(rendered) {
+		t.Errorf("AGENTS.override.md after a Bolt pull = %q; want it unchanged", after)
+	}
+}
