--- a/docs/overview.md
+++ b/docs/overview.md
@@ -602,6 +602,7 @@ User-facing modules each get one `lym <module>` namespace:
   A tapestry run's tail is `Webster → Parent-Align → Drift-Verify → Code-Review → Describe → PR-Review → Finalize`, where `Code-Review` is the Code-Perch of `Code-Bouncer`, `Code-Burler-Review` and `Code-Burler-Fix`;
   a darn run's tail is `Darn-Write → Drift-Verify → Code-Review → Describe → PR-Review → Finalize`, with no `Parent-Align`.
   The three regression rows, `Drift-Baseline` before `Parts-Write` in loom and before `Drift-Await` in darn, `Drift-Await` before `Webster` in loom and before `Darn-Write` in darn, and `Drift-Verify` as above, each carry the entry gate `drift.enabled` of the hub-wide `drift.yaml`, so a hub that leaves it off records each of them skipped and spawns or runs nothing for them.
+  Each Drift producer also reads `drift.enabled` at every pass, so switching it off, in the hub or in one task's local layer, lets a resume pass a Drift row the run already entered.
   `Parent-Align` merges the parent's upstream tip into the task with no parent lock, verifies the merged tree through the `parent-align` gate key and runs the merge fixer in parent-align mode, which settles a conflict or a failing tree and aligns the task to what the parent brought in; it writes the merge record with the aligned tip, and the Code-Perch then reviews the task's code against that.
   `PR-Review` lands the task through a GitHub pull request when the resolver says so: it pushes the task branch, opens or finds the pull request, sets its title and body from the change description, records it and waits on it, and otherwise passes.
   The wait takes no parent lock: it gates and pushes the agent's commits through the `pr-review` gate key, never onto a merged pull request, and mails a failure to the agent, reads the pull request at most once a minute and before each gate, and ends Done when the pull request is merged or approved at the gated head, or when the operator's `lym loom pr-continue` makes the row close it, and Stuck on any other ending; a pause that covers the run holds it, and the driver strand's mark reads `PR #<n>`.
diff --git a/internal/driftcli/anchor_integration_test.go b/internal/driftcli/anchor_integration_test.go
new file mode 100644
index 00000000..b3f45167
--- /dev/null
+++ b/internal/driftcli/anchor_integration_test.go
@@ -0,0 +1,106 @@
+//go:build !windows
+
+// anchor_integration_test.go drives the built `lym drift` verbs in a hub whose anchor is a subdirectory, and checks that the detached capture child and every drift command run in the anchored directory, not the worktree root.
+
+package driftcli_test
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/driftengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/testkit/lymbin"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestDrift_RunsInTheAnchoredDirectory covers the main capture's child, the compare and the side capture of a hub anchored at a subdirectory:
+// each declared command records its working directory, and every one must be the anchored directory.
+// A capture child started anywhere but the anchored directory cannot resolve its worktree and never records its start.
+func TestDrift_RunsInTheAnchoredDirectory(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	bin := lymbin.Build(t)
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "backend", Pairs: []string{pairSlug}})
+	pair := h.PairCodeWorktree(pairSlug)
+	anchor := filepath.Join(pair, "backend")
+	loc, err := lymcwd.Resolve(anchor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loc.AnchorPath() != anchor || loc.AnchorPath() == loc.WorktreePath() {
+		t.Fatalf("anchored path = %q, worktree = %q; want an anchor below the worktree root", loc.AnchorPath(), loc.WorktreePath())
+	}
+
+	cwds := filepath.Join(t.TempDir(), "cwds")
+	driftYAML := fmt.Sprintf(`capture:
+  command: |
+    pwd >> %q
+    mkdir -p {baseline_dir} && echo ok > {baseline_dir}/profile.txt
+  timeout_min: 1
+compare:
+  command: 'pwd >> %q; : {baseline_dir}'
+  timeout_min: 1
+verify_max_runs: 3
+`, cwds, cwds)
+	driftFile := configengine.ConfigFile(h.BoardDir(), "drift")
+	if err := os.MkdirAll(filepath.Dir(driftFile), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(driftFile, []byte(driftYAML), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := shedrun.WriteSeed(loc, shedrun.SelfRunID, shedrun.Seed{Recipe: shedrun.RecipeTapestry, Driver: shedrun.DriverGo}); err != nil {
+		t.Fatal(err)
+	}
+	writeStatus := func(row string, status shedengine.State) {
+		t.Helper()
+		lockPath := shedrun.StatusLock(loc, shedrun.SelfRunID)
+		if err := os.MkdirAll(filepath.Dir(lockPath), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := state.WriteJSON(shedrun.StatusFile(loc, shedrun.SelfRunID), lockPath, shedengine.Status{CurrentProducer: row, State: status}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	writeStatus("Drift-Await", shedengine.StateBlocked)
+	if env := lymRun(t, bin, anchor, "capture"); !env.OK {
+		t.Fatalf("lym drift capture: %s", env.Error)
+	}
+	waitFor(t, "the capture record to read passed", func() bool { return captureState(statusBody(t, bin, anchor)) == driftengine.CapturePassed })
+
+	writeStatus("Drift-Verify", shedengine.StateRunning)
+	for _, args := range [][]string{{"compare"}, {"capture", "--side"}} {
+		if env := lymRun(t, bin, anchor, args...); !env.OK {
+			t.Fatalf("lym drift %v: %s", args, env.Error)
+		}
+	}
+
+	want, err := filepath.EvalSymlinks(anchor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(cwds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := strings.Split(strings.TrimSpace(string(data)), "\n")
+	if len(got) != 3 {
+		t.Fatalf("recorded working directories = %q; want one each from the main capture, the compare and the side capture", got)
+	}
+	for i, dir := range got {
+		if dir != want {
+			t.Errorf("command %d ran in %q; want the anchored directory %q", i, dir, want)
+		}
+	}
+}
