+			result, err := NewPartPlanGate(anchorPath, worktreeRoot, "", tt.part, index, PlanContext{})()
+			if err != nil || result.Passed != tt.wantPassed || !strings.Contains(result.Findings, tt.wantFind) {
+				t.Errorf("NewPartPlanGate(%s)() = %+v, %v; want Passed %v with %q", tt.part, result, err, tt.wantPassed, tt.wantFind)
+			}
+			acceptErr := NewPartAccept(anchorPath, worktreeRoot, tt.part, index, PlanContext{})(shuttleengine.Result{})
+			if tt.wantPassed != (acceptErr == nil) || (acceptErr != nil && !strings.Contains(acceptErr.Error(), tt.wantFind)) {
+				t.Errorf("NewPartAccept(%s) = %v; want nil only for a passing part, else an error with %q", tt.part, acceptErr, tt.wantFind)
+			}
+		}
+
+		// A part directory the plan parser rejects is the gate's findings, not its error.
+		writeSplit(t, anchorPath, strings.Replace(splitPartsFile(newThing, newFile), "## Part: wiring", "## Part: broken", 1))
+		if err := os.WriteFile(partsparser.PartOverview(anchorPath, "broken"), []byte("not an overview\n"), 0o644); err != nil {
+			t.Fatalf("WriteFile() = %v; want nil", err)
+		}
+		result, err := NewPartPlanGate(anchorPath, worktreeRoot, "", "broken", index, PlanContext{})()
+		if err != nil || result.Passed || result.Findings == "" {
+			t.Errorf("NewPartPlanGate(broken)() = %+v, %v; want a failed gate carrying the parse error", result, err)
+		}
+	})
+}
+
+func TestJoinParts(t *testing.T) {
+	t.Parallel()
+
+	index := planglyph.NewIndex(fabricengine.NewReferenceRule())
+	newThing, newFile := "plan:internal/x#NewThing", "internal/x/newfile.go"
+
+	seed := func(t *testing.T, wiring plankit.Card) (anchorPath, worktreeRoot string) {
+		t.Helper()
+		anchorPath, worktreeRoot = t.TempDir(), splitWorktree(t)
+		writeSplit(t, anchorPath, splitPartsFile(newThing, newFile))
+		writeSplitPart(t, anchorPath, "core", coreCreatingBothExports())
+		writeSplitPart(t, anchorPath, "wiring", wiring)
+		return anchorPath, worktreeRoot
+	}
+
+	t.Run("two valid parts join into the plan directory", func(t *testing.T) {
+		t.Parallel()
+		anchorPath, worktreeRoot := seed(t, wiringUsing(newThing))
+		result, err := JoinParts(anchorPath, worktreeRoot, index, PlanContext{})
+		if err != nil {
+			t.Fatalf("JoinParts() error = %v; want nil", err)
+		}
+		if len(result.Cards) != 2 || result.Cards[0].Part != "core" || result.Cards[1].Part != "wiring" {
+			t.Errorf("JoinParts() cards = %+v; want core's card then wiring's", result.Cards)
+		}
+		if _, err := planparser.ParsePlan(planparser.PlanDir(anchorPath)); err != nil {
+			t.Errorf("ParsePlan(joined) error = %v; want nil", err)
+		}
+	})
+
+	t.Run("refusals name the part and a way forward", func(t *testing.T) {
+		t.Parallel()
+		missingOverview, missingWorktree := seed(t, wiringUsing(newThing))
+		if err := os.Remove(partsparser.PartOverview(missingOverview, "wiring")); err != nil {
+			t.Fatalf("Remove() = %v; want nil", err)
+		}
+		failing, failingWorktree := seed(t, wiringUsing("plan:internal/z#Nope"))
+		absent, absentWorktree := t.TempDir(), splitWorktree(t)
+		// Two parts that both create one handle pass their own checks, so the format writer's refusal is passed through.
+		clash, clashWorktree := seed(t, splitCard(1, "wire", "Create", "plan:internal/x#NewThing` -> `func NewThing()"))
+
+		for _, tt := range []struct {
+			name         string
+			anchor, tree string
+			want         []string
+			// passedThrough marks the format writer's own refusal, which JoinParts returns unchanged.
+			passedThrough bool
+		}{
+			{"absent parts file", absent, absentWorktree, []string{"lym loom goto --to Parts-Write"}, false},
+			{"missing part overview", missingOverview, missingWorktree, []string{`part "wiring"`, partsparser.PartOverview(missingOverview, "wiring")}, false},
+			{"part failing its check", failing, failingWorktree, []string{`part "wiring"`, "handle-dangling", "lym loom join-parts"}, false},
+			{"planparser refusal", clash, clashWorktree, []string{"both create"}, true},
+		} {
+			_, err := JoinParts(tt.anchor, tt.tree, index, PlanContext{})
+			if err == nil {
+				t.Errorf("%s: JoinParts() error = nil; want a refusal", tt.name)
+				continue
+			}
+			for _, want := range tt.want {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("%s: JoinParts() error = %q; want it to contain %q", tt.name, err, want)
+				}
+			}
+			if tt.passedThrough && !errors.Is(err, planparser.ErrJoinRefused) {
+				t.Errorf("%s: JoinParts() error = %v; want it to wrap planparser.ErrJoinRefused", tt.name, err)
+			}
+		}
+	})
+}
diff --git a/internal/loomshed/partsrotate.go b/internal/loomshed/partsrotate.go
new file mode 100644
index 00000000..e9140797
--- /dev/null
+++ b/internal/loomshed/partsrotate.go
@@ -0,0 +1,104 @@
+// partsrotate.go implements the fresh-spawn preparations of the Parts-Write and Parts-Plan-Write rows:
+// the rotations that archive an earlier attempt's parts file, part plans and join record before a new session starts.
+
+package loomshed
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/partsparser"
+)
+
+// NewPartsDirRotator returns Parts-Write's fresh-spawn preparation: the closure that archives every entry of the parts directory under anchorPath, so the new session starts from an empty directory.
+// Entries move into a new archive-<stamp>[-N] directory under the parts directory, and earlier archives stay in place.
+// An absent parts directory, or one with nothing to move, is a no-op that creates nothing.
+// The closure returns an empty prompt amendment.
+// A nil now defaults to time.Now.
+func NewPartsDirRotator(anchorPath string, now func() time.Time) func() (string, error) {
+	return func() (string, error) {
+		if err := archivePartsEntries(anchorPath, func(string) bool { return false }, now); err != nil {
+			return "", fmt.Errorf("loomshed: rotate stale parts directory: %w", err)
+		}
+		return "", nil
+	}
+}
+
+// NewPartsPlanRotator returns Parts-Plan-Write's fresh-spawn preparation: the closure that archives every part directory and the join record under anchorPath, keeping the parts file, and then rotates the plan directory.
+// The parts archive goes first, so a retry never loses the prior-plan block:
+// a failed parts archive leaves the plan in place, and a failed plan rotation leaves it in place too, while the retry's parts archive finds nothing left to move and the retried plan rotation still announces the prior plan.
+// The closure returns the plan rotation's prompt amendment, which the producer sets as the chair's prior-plan block.
+// stencilsDir and archiveWebster are the plan rotation's, told by the caller; a nil now defaults to time.Now.
+func NewPartsPlanRotator(anchorPath, stencilsDir string, archiveWebster func(dest string) error, now func() time.Time) func() (string, error) {
+	rotatePlan := NewPlanDirRotator(anchorPath, stencilsDir, archiveWebster, now)
+	partsFileName := filepath.Base(partsparser.File(anchorPath))
+	return func() (string, error) {
+		if err := archivePartsEntries(anchorPath, func(name string) bool { return name == partsFileName }, now); err != nil {
+			return "", fmt.Errorf("loomshed: rotate stale parts directory: %w", err)
+		}
+		return rotatePlan()
+	}
+}
+
+// archivePartsEntries moves every top-level entry of the parts directory under anchorPath that does not begin with partsparser.ArchivePrefix and that keep does not keep, into a new archive-<stamp>[-N] directory under it.
+// Earlier archives stay in place, so archives never nest.
+// An absent parts directory, or one with nothing to move, is a no-op that creates nothing.
+// A nil now defaults to time.Now.
+func archivePartsEntries(anchorPath string, keep func(name string) bool, now func() time.Time) error {
+	if now == nil {
+		now = time.Now
+	}
+	partsDir := partsparser.Dir(anchorPath)
+	entries, err := os.ReadDir(partsDir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return err
+	}
+	var moving []string
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), partsparser.ArchivePrefix) || keep(entry.Name()) {
+			continue
+		}
+		moving = append(moving, entry.Name())
+	}
+	if len(moving) == 0 {
+		return nil
+	}
+
+	archiveDir, err := firstFreePartsArchivePath(partsDir, now().UTC().Format(archiveTimestampFormat))
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(archiveDir, 0o755); err != nil {
+		return err
+	}
+	for _, name := range moving {
+		if err := os.Rename(filepath.Join(partsDir, name), filepath.Join(archiveDir, name)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// firstFreePartsArchivePath returns the first archive directory path under partsDir, named partsparser.ArchivePrefix, stamp and a suffix from the sequence "", "-1", "-2", ..., that does not already exist.
+// Any os.Stat error other than not-exist is returned as-is.
+func firstFreePartsArchivePath(partsDir, stamp string) (string, error) {
+	for n := 0; ; n++ {
+		suffix := ""
+		if n > 0 {
+			suffix = fmt.Sprintf("-%d", n)
+		}
+		candidate := filepath.Join(partsDir, partsparser.ArchivePrefix+stamp+suffix)
+		if _, err := os.Stat(candidate); err != nil {
+			if os.IsNotExist(err) {
+				return candidate, nil
+			}
+			return "", err
+		}
+	}
+}
diff --git a/internal/loomshed/partsrotate_test.go b/internal/loomshed/partsrotate_test.go
new file mode 100644
index 00000000..fc489e1c
--- /dev/null
+++ b/internal/loomshed/partsrotate_test.go
@@ -0,0 +1,170 @@
+//go:build tier0
+
+// partsrotate_test.go exercises the Parts-Write and Parts-Plan-Write fresh-spawn rotations over a temp anchor with a fixed clock.
+
+package loomshed
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/partsparser"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// setupPartsDir writes an earlier attempt's parts directory under a new anchor: the parts file, two part directories each holding an overview, the join record and an earlier archive.
+func setupPartsDir(t *testing.T) (anchorPath string) {
+	t.Helper()
+	anchorPath = t.TempDir()
+	partsDir := partsparser.Dir(anchorPath)
+	for _, rel := range []string{"parts.md", "join.md", "alpha/00-overview.md", "beta/00-overview.md", partsparser.ArchivePrefix + "20260101T000000Z/parts.md"} {
+		path := filepath.Join(partsDir, filepath.FromSlash(rel))
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatalf("MkdirAll(%q) error = %v", filepath.Dir(path), err)
+		}
+		if err := os.WriteFile(path, []byte(rel), 0o644); err != nil {
+			t.Fatalf("WriteFile(%q) error = %v", path, err)
+		}
+	}
+	return anchorPath
+}
+
+// partsDirEntries returns the top-level entry names of the parts directory under anchorPath, sorted.
+func partsDirEntries(t *testing.T, anchorPath string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(partsparser.Dir(anchorPath))
+	if err != nil {
+		t.Fatalf("ReadDir(parts directory) error = %v", err)
+	}
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	return names
+}
+
+// requireFiles fails the test when any of rels, relative to dir, is not a file.
+func requireFiles(t *testing.T, dir string, rels ...string) {
+	t.Helper()
+	for _, rel := range rels {
+		if info, err := os.Stat(filepath.Join(dir, filepath.FromSlash(rel))); err != nil || info.IsDir() {
+			t.Errorf("Stat(%s) = %v, %v; want a file", filepath.Join(dir, rel), info, err)
+		}
+	}
+}
+
+// TestPartsRotators verifies Parts-Write's rotation archives the whole parts directory, Parts-Plan-Write's keeps the parts file and rotates the plan, and a retry after a failed plan rotation still announces the prior plan.
+func TestPartsRotators(t *testing.T) {
+	t.Parallel()
+	stamp := fixedPlanClock().UTC().Format(archiveTimestampFormat)
+	archiveName := partsparser.ArchivePrefix + stamp
+
+	t.Run("Parts-Write archives every entry into one archive and takes a -1 suffix in the same second", func(t *testing.T) {
+		t.Parallel()
+		anchorPath := setupPartsDir(t)
+		rotate := NewPartsDirRotator(anchorPath, fixedPlanClock)
+
+		amendment, err := rotate()
+		if err != nil || amendment != "" {
+			t.Fatalf("rotate() = %q, %v; want an empty amendment and nil error", amendment, err)
+		}
+		partsDir := partsparser.Dir(anchorPath)
+		if got, want := partsDirEntries(t, anchorPath), []string{partsparser.ArchivePrefix + "20260101T000000Z", archiveName}; !slices.Equal(got, want) {
+			t.Errorf("parts directory entries = %v; want %v", got, want)
+		}
+		requireFiles(t, filepath.Join(partsDir, archiveName), "parts.md", "join.md", "alpha/00-overview.md", "beta/00-overview.md")
+		requireFiles(t, filepath.Join(partsDir, partsparser.ArchivePrefix+"20260101T000000Z"), "parts.md")
+
+		// A second attempt in the same second archives into the first free suffix.
+		if err := os.WriteFile(partsparser.File(anchorPath), []byte("again"), 0o644); err != nil {
+			t.Fatalf("WriteFile(parts file) error = %v", err)
+		}
+		if _, err := rotate(); err != nil {
+			t.Fatalf("second rotate() error = %v; want nil", err)
+		}
+		requireFiles(t, filepath.Join(partsDir, archiveName+"-1"), "parts.md")
+		if _, err := os.Stat(filepath.Join(partsDir, archiveName, archiveName+"-1")); !os.IsNotExist(err) {
+			t.Errorf("an archive nested inside an earlier archive; want archives side by side")
+		}
+	})
+
+	t.Run("Parts-Plan-Write keeps the parts file, rotates the plan and returns the prior-plan amendment", func(t *testing.T) {
+		t.Parallel()
+		anchorPath := setupPartsDir(t)
+		planDir := planparser.PlanDir(anchorPath)
+		if err := os.MkdirAll(planDir, 0o755); err != nil {
+			t.Fatalf("MkdirAll(%q) error = %v", planDir, err)
+		}
+		if err := os.WriteFile(filepath.Join(planDir, "00-overview.md"), []byte("overview"), 0o644); err != nil {
+			t.Fatalf("WriteFile(plan overview) error = %v", err)
+		}
+
+		amendment, err := NewPartsPlanRotator(anchorPath, seedPriorPlanStencils(t), noWebsterArchive, fixedPlanClock)()
+		if err != nil {
+			t.Fatalf("rotate() error = %v; want nil", err)
+		}
+		if !strings.Contains(amendment, "00-overview.md") {
+			t.Errorf("rotate() amendment = %q; want the prior-plan block naming 00-overview.md", amendment)
+		}
+		if got, want := partsDirEntries(t, anchorPath), []string{partsparser.ArchivePrefix + "20260101T000000Z", archiveName, "parts.md"}; !slices.Equal(got, want) {
+			t.Errorf("parts directory entries = %v; want the parts file kept and the rest archived %v", got, want)
+		}
+		requireFiles(t, filepath.Join(partsparser.Dir(anchorPath), archiveName), "join.md", "alpha/00-overview.md", "beta/00-overview.md")
+		if _, err := os.Stat(filepath.Join(planDir, "00-overview.md")); !os.IsNotExist(err) {
+			t.Errorf("plan overview still in place after the rotation; want it archived")
+		}
+	})
+
+	t.Run("a failed plan rotation leaves the plan in place and the retry still announces it", func(t *testing.T) {
+		t.Parallel()
+		anchorPath := setupPartsDir(t)
+		planDir := planparser.PlanDir(anchorPath)
+		if err := os.MkdirAll(planDir, 0o755); err != nil {
+			t.Fatalf("MkdirAll(%q) error = %v", planDir, err)
+		}
+		if err := os.WriteFile(filepath.Join(planDir, "00-overview.md"), []byte("overview"), 0o644); err != nil {
+			t.Fatalf("WriteFile(plan overview) error = %v", err)
+		}
+		stencilsDir := seedPriorPlanStencils(t)
+
+		failing := func(string) error { return errors.New("webster holds its run lock") }
+		if _, err := NewPartsPlanRotator(anchorPath, stencilsDir, failing, fixedPlanClock)(); err == nil {
+			t.Fatal("rotate() with a failing archiveWebster = nil error; want the failure")
+		}
+		requireFiles(t, planDir, "00-overview.md")
+		requireFiles(t, filepath.Join(partsparser.Dir(anchorPath), archiveName), "join.md", "alpha/00-overview.md")
+
+		amendment, err := NewPartsPlanRotator(anchorPath, stencilsDir, noWebsterArchive, fixedPlanClock)()
+		if err != nil {
+			t.Fatalf("retried rotate() error = %v; want nil", err)
+		}
+		if !strings.Contains(amendment, "00-overview.md") {
+			t.Errorf("retried rotate() amendment = %q; want the prior-plan block naming 00-overview.md", amendment)
+		}
+	})
+
+	t.Run("an absent parts directory is a no-op for both rotations", func(t *testing.T) {
+		t.Parallel()
+		for name, rotate := range map[string]func(anchorPath string) func() (string, error){
+			"Parts-Write": func(anchorPath string) func() (string, error) {
+				return NewPartsDirRotator(anchorPath, fixedPlanClock)
+			},
+			"Parts-Plan-Write": func(anchorPath string) func() (string, error) {
+				return NewPartsPlanRotator(anchorPath, seedPriorPlanStencils(t), noWebsterArchive, fixedPlanClock)
+			},
+		} {
+			anchorPath := t.TempDir()
+			amendment, err := rotate(anchorPath)()
+			if err != nil || amendment != "" {
+				t.Errorf("%s rotate() = %q, %v; want an empty amendment and nil error", name, amendment, err)
+			}
+			if _, err := os.Stat(partsparser.Dir(anchorPath)); !os.IsNotExist(err) {
+				t.Errorf("%s rotate() created the parts directory; want a no-op", name)
+			}
+		}
+	})
+}
