diff --git a/internal/raddleparser/proposal.go b/internal/raddleparser/proposal.go
new file mode 100644
index 00000000..4a7b1ad4
--- /dev/null
+++ b/internal/raddleparser/proposal.go
@@ -0,0 +1,185 @@
+// proposal.go declares the raddle proposal's types, Parse, which decodes the file and refuses an unknown key, and Hash, the approval hash.
+
+package raddleparser
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"maps"
+	"reflect"
+	"slices"
+	"strings"
+)
+
+// specPath is the format contract the proposal is written against.
+const specPath = "contracts/specs/raddle-proposal-spec.md"
+
+// The shapes a proposal may take.
+const (
+	ShapeTapestry = "tapestry"
+	ShapeTasks    = "tasks"
+	ShapeProject  = "project"
+	ShapeBeam     = "beam"
+)
+
+// The recipes a part may name.
+const (
+	RecipeTapestry = "tapestry"
+	RecipeDarn     = "darn"
+)
+
+// TypeSketch is the board's type label of a Sketch, which no filed entry may carry.
+const TypeSketch = "sketch"
+
+// Proposal is the decoded proposal file.
+// Project is nil when the file holds no project key.
+type Proposal struct {
+	Sketch       string       `json:"sketch"`
+	Shape        string       `json:"shape"`
+	Project      *Project     `json:"project,omitempty"`
+	BoardChecked []BoardCheck `json:"board_checked"`
+	Parts        []Part       `json:"parts"`
+	Cost         Cost         `json:"cost"`
+}
+
+// Project is the project a `project` or `beam` shape files: its slug, title and the board type label the agent picked for it.
+type Project struct {
+	Slug  string `json:"slug"`
+	Title string `json:"title"`
+	Type  string `json:"type"`
+}
+
+// BoardCheck is a board entry the agent weighed, with the `revised` stamp it read, RFC 3339.
+type BoardCheck struct {
+	Slug    string `json:"slug"`
+	Revised string `json:"revised"`
+}
+
+// Part is one entry the proposal files.
+// ExpectedCostUSD is nil when a cell the figure rests on reads "too few runs".
+type Part struct {
+	Slug            string    `json:"slug"`
+	Title           string    `json:"title"`
+	Type            string    `json:"type"`
+	Recipe          string    `json:"recipe"`
+	Profile         string    `json:"profile"`
+	Decisions       []string  `json:"decisions"`
+	Packages        []Package `json:"packages"`
+	Contract        Contract  `json:"contract"`
+	DependsOn       []string  `json:"depends_on"`
+	OpenRisks       []string  `json:"open_risks"`
+	Criteria        []string  `json:"criteria"`
+	PatternChanges  []string  `json:"pattern_changes"`
+	ExpectedCostUSD *float64  `json:"expected_cost_usd"`
+	CostLine        string    `json:"cost_line"`
+}
+
+// Package is a package a part changes and the rough number of changed lines.
+type Package struct {
+	Path string `json:"path"`
+	Size int    `json:"size"`
+}
+
+// Contract is what a part takes in, delivers and exports.
+type Contract struct {
+	Takes    string `json:"takes"`
+	Delivers string `json:"delivers"`
+	Exports  string `json:"exports"`
+}
+
+// Cost is the proposal's expected cost, the next-best split and the cost cells both rest on.
+// ExpectedUSD is nil when a cell the figure rests on reads "too few runs".
+type Cost struct {
+	ExpectedUSD *float64   `json:"expected_usd"`
+	Line        string     `json:"line"`
+	NextBest    NextBest   `json:"next_best"`
+	Cells       []CostCell `json:"cells"`
+}
+
+// NextBest is the next-best split in one line, with its expected cost.
+type NextBest struct {
+	Split       string   `json:"split"`
+	ExpectedUSD *float64 `json:"expected_usd"`
+	Line        string   `json:"line"`
+}
+
+// CostCell names a `lym report cost` cell a cost figure rests on.
+type CostCell struct {
+	Recipe       string `json:"recipe"`
+	Profile      string `json:"profile"`
+	StoredRecord bool   `json:"stored_record"`
+}
+
+// Parse decodes the bytes of a proposal file.
+// It refuses a file that is not one JSON object of the spec's form, a value of the wrong type and a key the spec does not pin, each with an error naming the way forward.
+// It finds an unknown key by reading each object a second time as a map of raw values and comparing its keys with the json tags of the type that receives it, and never asks the decoder to disallow unknown fields.
+func Parse(data []byte) (Proposal, error) {
+	var raw json.RawMessage
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return Proposal{}, fmt.Errorf("raddleparser: the proposal is not valid JSON: %w; way forward: write one JSON object in the form of %s", err, specPath)
+	}
+	if err := rejectUnknownKeys(raw, reflect.TypeOf(Proposal{}), "the proposal"); err != nil {
+		return Proposal{}, err
+	}
+	var proposal Proposal
+	if err := json.Unmarshal(raw, &proposal); err != nil {
+		return Proposal{}, fmt.Errorf("raddleparser: the proposal does not fit its format: %w; way forward: write each value in the form %s pins", err, specPath)
+	}
+	return proposal, nil
+}
+
+// rejectUnknownKeys walks raw alongside typ and returns an error naming the first object key, in sorted order, that no json tag of the receiving struct holds.
+// A value of the wrong shape is left to the typed decode, which names it.
+func rejectUnknownKeys(raw json.RawMessage, typ reflect.Type, path string) error {
+	for typ.Kind() == reflect.Pointer {
+		typ = typ.Elem()
+	}
+	switch typ.Kind() {
+	case reflect.Slice:
+		var items []json.RawMessage
+		if json.Unmarshal(raw, &items) != nil {
+			return nil
+		}
+		for i, item := range items {
+			if err := rejectUnknownKeys(item, typ.Elem(), fmt.Sprintf("%s[%d]", path, i)); err != nil {
+				return err
+			}
+		}
+	case reflect.Struct:
+		var fields map[string]json.RawMessage
+		if json.Unmarshal(raw, &fields) != nil {
+			return nil
+		}
+		known := jsonFieldTypes(typ)
+		for _, key := range slices.Sorted(maps.Keys(fields)) {
+			fieldType, ok := known[key]
+			if !ok {
+				return fmt.Errorf("raddleparser: %s holds the unknown key %q; way forward: remove it, or write only the keys %s pins", path, key, specPath)
+			}
+			if err := rejectUnknownKeys(fields[key], fieldType, path+"."+key); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// jsonFieldTypes maps each json key of the struct type typ to the type of its field.
+func jsonFieldTypes(typ reflect.Type) map[string]reflect.Type {
+	fields := map[string]reflect.Type{}
+	for i := 0; i < typ.NumField(); i++ {
+		name, _, _ := strings.Cut(typ.Field(i).Tag.Get("json"), ",")
+		if name != "" && name != "-" {
+			fields[name] = typ.Field(i).Type
+		}
+	}
+	return fields
+}
+
+// Hash returns the hex SHA-256 of the proposal file's bytes, the approval hash.
+func Hash(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
diff --git a/internal/raddleparser/proposal_test.go b/internal/raddleparser/proposal_test.go
new file mode 100644
index 00000000..1cfbf3d1
--- /dev/null
+++ b/internal/raddleparser/proposal_test.go
@@ -0,0 +1,69 @@
+// proposal_test.go covers Parse over a valid proposal, an unknown key at two depths, a malformed file and a value of the wrong type, and Hash.
+
+package raddleparser
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestParse covers a valid proposal and each refusal, which must name the offending key or form and a way forward.
+func TestParse(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	valid, err := json.Marshal(validProposal())
+	if err != nil {
+		t.Fatalf("marshal the valid proposal: %v", err)
+	}
+	tests := []struct {
+		name    string
+		data    string
+		wantErr []string
+	}{
+		{"ValidProposal", string(valid), nil},
+		{"UnknownTopLevelKey", `{"sketch":"s","colour":"red"}`, []string{`"colour"`, "way forward"}},
+		{"UnknownKeyInAPart", `{"parts":[{"slug":"a","priority":1}]}`, []string{`"priority"`, "parts[0]", "way forward"}},
+		{"MalformedFile", `{"sketch":`, []string{"not valid JSON", "way forward"}},
+		{"ValueOfTheWrongType", `{"sketch":3}`, []string{"does not fit", "way forward"}},
+		{"NotAnObject", `[]`, []string{"does not fit", "way forward"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := Parse([]byte(tt.data))
+			if tt.wantErr == nil {
+				if err != nil {
+					t.Fatalf("Parse() error = %v; want nil", err)
+				}
+				if want := validProposal(); !reflect.DeepEqual(got, want) {
+					t.Errorf("Parse() = %+v; want %+v", got, want)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatalf("Parse() = %+v, nil; want an error", got)
+			}
+			for _, want := range tt.wantErr {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("Parse() error = %q; want it to contain %q", err, want)
+				}
+			}
+		})
+	}
+}
+
+// TestHash pins the approval hash to the hex SHA-256 of the bytes.
+func TestHash(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const want = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
+	if got := Hash([]byte("abc")); got != want {
+		t.Errorf("Hash(%q) = %q; want %q", "abc", got, want)
+	}
+}
diff --git a/internal/raddleparser/recheck.go b/internal/raddleparser/recheck.go
new file mode 100644
index 00000000..75470c7b
--- /dev/null
+++ b/internal/raddleparser/recheck.go
@@ -0,0 +1,66 @@
+// recheck.go implements RecheckBoard, the proposal's second look at the board at approval and at filing.
+
+package raddleparser
+
+import (
+	"fmt"
+	"slices"
+	"time"
+)
+
+// Recheck is the result of RecheckBoard.
+// Failures are the rules the board now breaks.
+// Landed names the board_checked entries now done or gone from the board; they fail nothing.
+// Dropped names, only when BoardContext.Filing is set, the board_checked entries gone from the board that a part depends on, which Raddle-File drops.
+type Recheck struct {
+	Failures []Finding
+	Landed   []string
+	Dropped  []string
+}
+
+// RecheckBoard judges p against the board as it is now.
+// It fails a board_checked entry still open with another `revised` stamp, an open task or project that carries a module label of the Sketch and is absent from board_checked, whenever it was created or promoted, and a filed slug now taken.
+func RecheckBoard(p Proposal, board BoardContext) Recheck {
+	var result Recheck
+	for _, checked := range p.BoardChecked {
+		entryAt := slices.IndexFunc(board.Entries, func(entry BoardEntry) bool { return entry.Slug == checked.Slug })
+		if entryAt < 0 || !board.Entries[entryAt].Open {
+			result.Landed = append(result.Landed, checked.Slug)
+			continue
+		}
+		if !sameStamp(board.Entries[entryAt].Revised, checked.Revised) {
+			result.Failures = append(result.Failures, Finding{Check: CheckRevisedMoved, Detail: fmt.Sprintf("the entry %q was revised at %s after the proposal read %s", checked.Slug, board.Entries[entryAt].Revised, checked.Revised)})
+		}
+	}
+	for _, slug := range uncheckedEntries(p, board) {
+		result.Failures = append(result.Failures, Finding{Check: CheckBoardUnchecked, Detail: fmt.Sprintf("the open entry %q carries a module label of the Sketch and is not in board_checked", slug)})
+	}
+	for _, slug := range filedSlugs(p) {
+		if takenSlug(slug, board) {
+			result.Failures = append(result.Failures, Finding{Check: CheckSlugTaken, Part: slug, Detail: fmt.Sprintf("the slug %q is already on the board or in the raddle store", slug)})
+		}
+	}
+
+	if board.Filing {
+		for _, part := range p.Parts {
+			for _, dep := range part.DependsOn {
+				gone := slices.ContainsFunc(p.BoardChecked, func(checked BoardCheck) bool { return checked.Slug == dep }) &&
+					!slices.ContainsFunc(board.Entries, func(entry BoardEntry) bool { return entry.Slug == dep })
+				if gone && !slices.Contains(result.Dropped, dep) {
+					result.Dropped = append(result.Dropped, dep)
+				}
+			}
+		}
+	}
+	return result
+}
+
+// sameStamp reports whether two RFC 3339 stamps name one instant, and falls back to comparing the text when either does not parse.
+func sameStamp(a, b string) bool {
+	first, firstErr := time.Parse(time.RFC3339, a)
+	second, secondErr := time.Parse(time.RFC3339, b)
+	if firstErr != nil || secondErr != nil {
+		return a == b
+	}
+	return first.Equal(second)
+}
diff --git a/internal/raddleparser/recheck_test.go b/internal/raddleparser/recheck_test.go
new file mode 100644
index 00000000..44be96e0
--- /dev/null
+++ b/internal/raddleparser/recheck_test.go
@@ -0,0 +1,69 @@
+// recheck_test.go covers RecheckBoard: the board unchanged, an entry revised, an open entry added, a slug taken, and a weighed entry landed.
+
+package raddleparser
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestRecheckBoard starts from a board the valid proposal passes and moves it one way per row.
+func TestRecheckBoard(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		mutate      func(p *Proposal, b *BoardContext)
+		wantFail    []string
+		wantLanded  []string
+		wantDropped []string
+	}{
+		{"BoardUnchanged", func(*Proposal, *BoardContext) {}, nil, nil, nil},
+		{"RevisedStampMoved", func(_ *Proposal, b *BoardContext) { b.Entries[1].Revised = "2026-11-02T10:00:00Z" }, []string{CheckRevisedMoved}, nil, nil},
+		{"SameInstantInAnotherZoneIsUnmoved", func(_ *Proposal, b *BoardContext) { b.Entries[1].Revised = "2026-11-01T11:00:00+01:00" }, nil, nil, nil},
+		{"OpenEntryCreatedAfterTheRead", func(_ *Proposal, b *BoardContext) {
+			b.Entries = append(b.Entries, BoardEntry{Slug: "new-task", Kind: KindTask, Labels: []string{"mod-a"}, Open: true, Revised: "2026-11-03T10:00:00Z"})
+		}, []string{CheckBoardUnchecked}, nil, nil},
+		{"NotePromotedWithItsOldDates", func(_ *Proposal, b *BoardContext) {
+			b.Entries = append(b.Entries, BoardEntry{Slug: "promoted", Kind: KindTask, Labels: []string{"mod-a"}, Open: true, Revised: "2025-01-01T00:00:00Z"})
+		}, []string{CheckBoardUnchecked}, nil, nil},
+		{"SlugTakenOnTheBoard", func(p *Proposal, _ *BoardContext) { p.Parts[1].Slug = "other-open" }, []string{CheckSlugTaken}, nil, nil},
+		{"SlugTakenInTheStore", func(p *Proposal, b *BoardContext) {
+			p.Parts[1].Slug = "stored"
+			b.Store = []string{"stored"}
+		}, []string{CheckSlugTaken}, nil, nil},
+		{"WeighedEntryNowDone", func(_ *Proposal, b *BoardContext) { b.Entries[1].Open = false }, nil, []string{"other-open"}, nil},
+		{"WeighedEntryGoneFromTheBoard", func(_ *Proposal, b *BoardContext) { b.Entries = b.Entries[:1] }, nil, []string{"other-open"}, nil},
+		{"DependencyOnAGoneEntryNotDroppedOutsideFiling", func(p *Proposal, b *BoardContext) {
+			p.Parts[1].DependsOn = append(p.Parts[1].DependsOn, "other-open")
+			b.Entries = b.Entries[:1]
+		}, nil, []string{"other-open"}, nil},
+		{"DependencyOnAGoneEntryDroppedWhileFiling", func(p *Proposal, b *BoardContext) {
+			p.Parts[1].DependsOn = append(p.Parts[1].DependsOn, "other-open")
+			b.Entries = b.Entries[:1]
+			b.Filing = true
+		}, nil, []string{"other-open"}, []string{"other-open"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			proposal, board := validProposal(), validBoard()
+			tt.mutate(&proposal, &board)
+
+			got := RecheckBoard(proposal, board)
+
+			if failed := checkNames(got.Failures); !slices.Equal(failed, tt.wantFail) {
+				t.Errorf("RecheckBoard() failures = %v; want %v", failed, tt.wantFail)
+			}
+			if !slices.Equal(got.Landed, tt.wantLanded) {
+				t.Errorf("RecheckBoard() landed = %v; want %v", got.Landed, tt.wantLanded)
+			}
+			if !slices.Equal(got.Dropped, tt.wantDropped) {
+				t.Errorf("RecheckBoard() dropped = %v; want %v", got.Dropped, tt.wantDropped)
+			}
+		})
+	}
+}
