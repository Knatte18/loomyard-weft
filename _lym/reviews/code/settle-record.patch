+	_, _, err = fabricengine.CommitAnchoredPaths(fabricengine.NewMutations(""), location, []string{loomengine.LandingDirRel()}, fmt.Sprintf("loom: move the landing of %s off a retired row", slug), fabricengine.EnvSyncOptions())
