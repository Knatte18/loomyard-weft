+// awaitFile waits until the agent wrote the named file.
+func (c *claudeScenario) awaitFile(name string) {
+	c.t.Helper()
+	c.await("the agent to write "+name, func() bool {
+		_, err := os.Stat(c.file(name))
+		return err == nil
+	})
