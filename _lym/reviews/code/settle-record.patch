+					t.Errorf("state = %+v; want one return with the reason recorded and the approval cleared", got)
+				}
+				for _, dir := range []string{f.deps.StageDir, f.deps.RecordsDir} {
+					if _, err := os.Stat(dir); !os.IsNotExist(err) {
