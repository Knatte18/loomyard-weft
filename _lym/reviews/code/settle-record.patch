+	if err != nil {
+		t.Fatalf("FileTask(b-merge-in) = %v; want nil", err)
+	}
+
+	tasks, err := deps.Tasks()
+	if err != nil {
+		t.Fatalf("Tasks() = %v; want nil", err)
+	}
+	var filed *boardengine.Task
+	for i := range tasks {
+		if tasks[i].Slug == "b-merge-in" {
