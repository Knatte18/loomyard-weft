+		{name: "CarriesAnUnknownId", ctx: round(nil), prior: []PriorEntry{entry("E1", PriorResolved)}, findings: []Finding{carrying(finding("F1", SeverityMedium, "a.go:10"), "E9")}, wantErr: "not an open `prior` entry"},
+		{
