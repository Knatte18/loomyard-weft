+func (tc Toolchain) ProfileBlocks(bin, dir, profile string) ([]ProfileBlock, error) {
+	cmd, ctx, cancel := tc.command(tc.TestTimeout, bin, "-test.run=^$", "-test.coverprofile="+profile)
