+func OriginParentRunStatus(prime *lymcwd.Location, slug, parent string) (status shedengine.Status, found bool, err error) {
+	location := prime
+	if parent != "" {
+		location, err = lymcwd.NamedWorktree(prime.HubPath, parent)
+		if err != nil {
