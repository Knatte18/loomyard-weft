diff --git a/tools/retro/facts.awk b/tools/retro/facts.awk
new file mode 100644
index 00000000..6b885c1c
--- /dev/null
+++ b/tools/retro/facts.awk
@@ -0,0 +1,25 @@
+# facts.awk reads one review perch's newest round facts file and prints its figures, tab-separated:
+#   F  round column value   one row per cell of the rounds table, the Round cell left out
+#   K  key rounds           one row per ledger key listed under the recurring keys heading
+# The rounds table's header row opens with "| Round |", and every data row opens with a round number.
+
+/^\| *Round *\|/ {
+  ncols = split($0, header, "|")
+  for (i = 2; i < ncols; i++) gsub(/^ +| +$/, "", header[i])
+  next
+}
+/^\| *[0-9]+ *\|/ && ncols > 0 {
+  n = split($0, cell, "|")
+  round = cell[2]; gsub(/ /, "", round)
+  for (i = 3; i < n && i < ncols; i++) {
+    value = cell[i]; gsub(/^ +| +$/, "", value)
+    print "F\t" round "\t" header[i] "\t" value
+  }
+  next
+}
+/^## / { recurring = ($0 ~ /^## Recurring keys/); next }
+recurring && /^- `[^`]+`: rounds / {
+  key = $0; sub(/^- `/, "", key); sub(/`.*$/, "", key)
+  rounds = $0; sub(/^.*: rounds /, "", rounds)
+  print "K\t" key "\t" rounds
+}
diff --git a/tools/retro/figures.jq b/tools/retro/figures.jq
new file mode 100644
index 00000000..91dbcf1e
--- /dev/null
+++ b/tools/retro/figures.jq
@@ -0,0 +1,74 @@
+# figures.jq renders the retro figures as markdown from the files retro.sh writes,
+# each passed slurped under its own name: $sessions, $refusals, $rows, $facts, $keys, $missing and $usage.
+# A producer's outlier is a session of a row with at least three sessions,
+# whose turns or cost reach twice the row's median.
+
+def median: sort | if length == 0 then 0 elif length % 2 == 1 then .[length / 2 | floor] else (.[length / 2 - 1] + .[length / 2]) / 2 end;
+def money: . * 100 | round / 100 | tostring | "$" + .;
+def cell: tostring | gsub("\\|"; "\\|");
+
+($sessions | map(select(.kind == "main"))) as $main
+| ([$sessions[].slug, $rows[].slug, $usage[].slug] | unique) as $slugs
+| "# Retro figures",
+  "",
+  "## Runs",
+  "",
+  "| Run | Sessions | Forks | Cost | Verify gate runs | Verify reworks | Gate-fixer sessions | Review rounds |",
+  "| --- | --- | --- | --- | --- | --- | --- | --- |",
+  ($slugs[] as $s
+   | ([$facts[] | select(.slug == $s)] | group_by(.perch) | map("\(.[0].perch) \(map(.round) | max)") | join(", ")) as $rounds
+   | "| \($s) | \([$main[] | select(.slug == $s)] | length) | \([$sessions[] | select(.slug == $s and .kind == "fork")] | length)"
+     + " | \([$usage[] | select(.slug == $s) | .cost] | add // 0 | money)"
+     + " | \([$rows[] | select(.slug == $s) | .verify_runs] | add // 0) | \([$rows[] | select(.slug == $s) | .verify_reworks] | add // 0)"
+     + " | \([$main[] | select(.slug == $s and (.title | endswith(":gate-fixer")))] | length) | \(if $rounds == "" then "none" else $rounds end) |"),
+  "",
+  "## Producers against their medians",
+  "",
+  "| Row | Sessions | Median turns | Median cost | Outliers |",
+  "| --- | --- | --- | --- | --- |",
+  ($main | map(select(.row != "")) | group_by(.row)[]
+   | (map(.turns) | median) as $mt | (map(.cost) | median) as $mc
+   | (if length >= 3 then [.[] | select(.turns >= 2 * $mt or .cost >= 2 * $mc) | "\(.slug) \(.session[0:8]) (\(.turns) turns, \(.cost | money))"] else [] end) as $out
+   | "| \(.[0].row) | \(length) | \($mt) | \($mc | money) | \(if ($out | length) == 0 then "-" else $out | join("; ") end) |"),
+  "",
+  "## Serial single lookups",
+  "",
+  "Turns that made one read or search right after a turn that did the same, per session with any.",
+  "",
+  "| Run | Session | Kind | Title | Turns | Lookup turns | Serial |",
+  "| --- | --- | --- | --- | --- | --- | --- |",
+  ($sessions | map(select(.serial_saved > 0)) | sort_by(-.serial_saved)[]
+   | "| \(.slug) | \(.session[0:8]) | \(.kind) | \(.title | cell) | \(.turns) | \(.lookup_turns) | \(.serial_saved) |"),
+  "",
+  "## Refused commands",
+  "",
+  "| Refusal | Count |",
+  "| --- | --- |",
+  ($refusals | group_by(.refusal[0:60]) | sort_by(-length)[] | "| \(.[0].refusal[0:60] | cell) | \(length) |"),
+  "",
+  "| Run | Session | Kind | Turn | Tool | Refusal |",
+  "| --- | --- | --- | --- | --- | --- |",
+  ($refusals[] | "| \(.slug) | \(.session[0:8]) | \(.kind) | \(.turn) | \(.tool) | \(.refusal | cell) |"),
+  "",
+  "## Agent gate runs",
+  "",
+  "| Run | Session | Title | Gate runs | Failed |",
+  "| --- | --- | --- | --- | --- |",
+  ($sessions | map(select(.gate_runs > 0))[] | "| \(.slug) | \(.session[0:8]) | \(.title | cell) | \(.gate_runs) | \(.gate_fails) |"),
+  "",
+  "## Review findings by column",
+  "",
+  "Each review perch's rounds summed over the runs; a column is a severity or a finding kind of the facts table.",
+  "",
+  "| Perch | Column | Total |",
+  "| --- | --- | --- |",
+  ($facts | map(select(.value | test("^[0-9]+$"))) | group_by([.perch, .column])[]
+   | "| \(.[0].perch) | \(.[0].column) | \(map(.value | tonumber) | add) |"),
+  "",
+  "## Ledger keys open in more than one round",
+  "",
+  ($keys[] | "- \(.slug) \(.perch): `\(.key)`, rounds \(.rounds)"),
+  "",
+  "## Missing records",
+  "",
+  ($missing[] | "- \(.slug): no \(.what)")
diff --git a/tools/retro/retro.sh b/tools/retro/retro.sh
new file mode 100755
index 00000000..60183e62
--- /dev/null
+++ b/tools/retro/retro.sh
@@ -0,0 +1,121 @@
+#!/usr/bin/env bash
+# Usage: retro.sh <out-dir> <slug>...
+# Reads the records and the Claude Code transcripts of the named landed runs and writes the retro figures to <out-dir>:
+#   sessions.jsonl  one object per session and fork: slug session kind title row model cost
+#                   turns calls lookup_turns serial_saved refusals gate_runs gate_fails
+#   refusals.jsonl  one object per refused call: slug session kind turn tool refusal
+#   rows.jsonl      one object per recipe row a run went through: slug idx producer outcome
+#                   gate_attempts verify_runs verify_reworks routed_to
+#   facts.jsonl     one object per review round cell: slug perch round column value
+#   keys.jsonl      one object per ledger key that recurred across a perch's rounds: slug perch key rounds
+#   missing.jsonl   one object per run with no archive tag or no transcript directory: slug what
+#   usage.jsonl     one object per usage record of a session: slug session row role model cost
+#   figures.md      the tables figures.jq renders from the files above
+# A run's records are read at its newest archive tag; its transcripts from the transcript directory of its worktree.
+# The transcript layout is Claude Code's:
+# a run on another agent engine has no such directory and is listed in missing.jsonl.
+# A session's row, model and cost come from the run's usage record of that session, and stay empty for a fork.
+# Environment: PROJECTS names the transcript root (default ~/.claude/projects);
+# HUB the directory holding the runs' worktrees (default: the parent of the prime worktree);
+# RECORDS the records repository holding the archive tags (default: the prime worktree's path with -weft appended).
+# Needs bash, jq, awk and git; writes only under <out-dir>.
+set -euo pipefail
+# The records' paths, inside an archive tag.
+USAGE_DIR=_lym/usage
+SHED_DIR=_lym/shed
+REVIEWS_DIR=_lym/reviews
+if [ $# -lt 2 ]; then
+  echo "usage: retro.sh <out-dir> <slug>..." >&2
+  exit 2
+fi
+out=$1
+shift
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+projects=${PROJECTS:-$HOME/.claude/projects}
+if [ -z "${HUB:-}" ] || [ -z "${RECORDS:-}" ]; then
+  prime=$(git -C "$here" worktree list --porcelain | awk 'NR == 1 { print $2 }')
+fi
+hub=${HUB:-$(dirname "$prime")}
+records=${RECORDS:-$prime-weft}
+
+mkdir -p "$out"
+for name in sessions refusals rows facts keys missing usage; do
+  : > "$out/$name.jsonl"
+done
+
+# encode turns a worktree path into the name of its directory under the transcript root.
+encode() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }
+
+# transcript appends the rows of one transcript file to sessions.jsonl and refusals.jsonl.
+transcript() { # file slug session kind
+  local file=$1 slug=$2 session=$3 kind=$4
+  jq -rs -f "$here/transcript.jq" "$file" |
+    jq -cR --arg slug "$slug" --arg session "$session" --arg kind "$kind" --slurpfile usage "$out/usage.jsonl" '
+      split("\t") as $f
+      | ([$usage[] | select(.session == $session)] | first // {}) as $u
+      | if $f[0] == "S" then
+          {slug: $slug, session: $session, kind: $kind, title: $f[1], row: ($u.row // ""), model: ($u.model // ""), cost: ($u.cost // 0),
+           turns: ($f[2] | tonumber), calls: ($f[3] | tonumber), lookup_turns: ($f[4] | tonumber), serial_saved: ($f[5] | tonumber),
+           refusals: ($f[6] | tonumber), gate_runs: ($f[7] | tonumber), gate_fails: ($f[8] | tonumber)}
+        else
+          {slug: $slug, session: $session, kind: $kind, turn: ($f[1] | tonumber), tool: $f[2], refusal: $f[3]}
+        end' |
+    while IFS= read -r line; do
+      if [[ $line == *'"refusal":'* ]]; then printf '%s\n' "$line" >> "$out/refusals.jsonl"; else printf '%s\n' "$line" >> "$out/sessions.jsonl"; fi
+    done
+}
+
+for slug in "$@"; do
+  tag=$(git -C "$records" for-each-ref --sort=-creatordate --format='%(refname:short)' "refs/tags/archive/$slug/" | head -n 1)
+  if [ -z "$tag" ]; then
+    jq -cn --arg slug "$slug" '{slug: $slug, what: "archive tag"}' >> "$out/missing.jsonl"
+  else
+    git -C "$records" ls-tree -r --name-only "$tag" -- "$USAGE_DIR" | { grep -E '/session-[^/]*\.json$' || true; } |
+      while read -r path; do
+        git -C "$records" show "$tag:$path" |
+          jq -c --arg slug "$slug" '{slug: $slug, session: .session_id, row: (.row // ""), role: (.role // ""), model: (.model // ""), cost: (.cost_usd // 0)}'
+      done >> "$out/usage.jsonl"
+    if status=$(git -C "$records" show "$tag:$SHED_DIR/$slug/status.json" 2>/dev/null); then
+      jq -c --arg slug "$slug" '
+        [.history[]? | select(.at != null)] | to_entries[] | .key as $i | .value as $r
+        | {slug: $slug, idx: $i, producer: $r.producer, outcome: $r.outcome, gate_attempts: ($r.gate_attempts // 0),
+           verify_runs: ([$r.gate_spans[]? | select(.gate == "verify" and .kind == "gate")] | length),
+           verify_reworks: ([$r.gate_spans[]? | select(.gate == "verify" and .kind == "rework")] | length),
+           routed_to: ($r.routed_to // "")}' <<< "$status" >> "$out/rows.jsonl"
+    fi
+    # A facts file lists every round up to its own, so the newest file of a perch holds them all.
+    git -C "$records" ls-tree -r --name-only "$tag" -- "$REVIEWS_DIR" | { grep -E '/round-[0-9]+-facts\.md$' || true; } |
+      awk -F/ '{ dir = $0; sub(/\/[^\/]*$/, "", dir); n = $NF; gsub(/[^0-9]/, "", n); if (n + 0 >= best[dir] + 0) { best[dir] = n; path[dir] = $0 } } END { for (dir in path) print path[dir] }' |
+      while read -r path; do
+        perch=$(basename "$(dirname "$path")")
+        git -C "$records" show "$tag:$path" | awk -f "$here/facts.awk" |
+          jq -cR --arg slug "$slug" --arg perch "$perch" '
+            split("\t") as $f
+            | if $f[0] == "F" then {slug: $slug, perch: $perch, round: ($f[1] | tonumber), column: $f[2], value: $f[3]}
+              else {slug: $slug, perch: $perch, key: $f[1], rounds: $f[2]} end' |
+          while IFS= read -r line; do
+            if [[ $line == *'"key":'* ]]; then printf '%s\n' "$line" >> "$out/keys.jsonl"; else printf '%s\n' "$line" >> "$out/facts.jsonl"; fi
+          done
+      done
+  fi
+
+  dir=$projects/$(encode "$hub/$slug")
+  if [ ! -d "$dir" ]; then
+    jq -cn --arg slug "$slug" '{slug: $slug, what: "transcript directory (Claude Code layout)"}' >> "$out/missing.jsonl"
+    continue
+  fi
+  for f in "$dir"/*.jsonl; do
+    [ -e "$f" ] || continue
+    sid=$(basename "$f" .jsonl)
+    transcript "$f" "$slug" "$sid" main
+    for sub in "$dir/$sid"/subagents/*.jsonl; do
+      [ -e "$sub" ] || continue
+      transcript "$sub" "$slug" "$(basename "$sub" .jsonl)" fork
+    done
+  done
+done
+
+jq -rn -f "$here/figures.jq" \
+  --slurpfile sessions "$out/sessions.jsonl" --slurpfile refusals "$out/refusals.jsonl" --slurpfile rows "$out/rows.jsonl" \
+  --slurpfile facts "$out/facts.jsonl" --slurpfile keys "$out/keys.jsonl" --slurpfile missing "$out/missing.jsonl" \
+  --slurpfile usage "$out/usage.jsonl" > "$out/figures.md"
diff --git a/tools/retro/retro_integration_test.go b/tools/retro/retro_integration_test.go
new file mode 100644
index 00000000..1a0fbead
--- /dev/null
+++ b/tools/retro/retro_integration_test.go
@@ -0,0 +1,241 @@
+//go:build !windows
+
+// retro_integration_test.go runs retro.sh over a fixture records repository and transcript root.
+// It checks the tables the script writes and a row of the figures it renders.
+
+package retro
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// session is one row of sessions.jsonl.
+type session struct {
+	Slug        string  `json:"slug"`
+	Session     string  `json:"session"`
+	Kind        string  `json:"kind"`
+	Title       string  `json:"title"`
+	Row         string  `json:"row"`
+	Model       string  `json:"model"`
+	Cost        float64 `json:"cost"`
+	Turns       int     `json:"turns"`
+	Calls       int     `json:"calls"`
+	LookupTurns int     `json:"lookup_turns"`
+	SerialSaved int     `json:"serial_saved"`
+	Refusals    int     `json:"refusals"`
+	GateRuns    int     `json:"gate_runs"`
+	GateFails   int     `json:"gate_fails"`
+}
+
+// writeFile writes content to path, creating its directory.
+func writeFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// readLines returns the lines of path, failing the test when it cannot be read.
+func readLines(t *testing.T, path string) []string {
+	t.Helper()
+	content, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var lines []string
+	scanner := bufio.NewScanner(bytes.NewReader(content))
+	for scanner.Scan() {
+		lines = append(lines, scanner.Text())
+	}
+	return lines
+}
+
+// buildRecords makes a records repository with an archive tag for run-a.
+// The tag holds three usage records of one row, a shed status and two review facts files.
+func buildRecords(t *testing.T, dir string) {
+	t.Helper()
+	gitkit.Git(t, dir, "init", "-b", "main")
+	// s1 is an outlier on turns alone and s3 on cost alone, so the rule must be turns or cost.
+	writeFile(t, filepath.Join(dir, lymdirs.LymDirName, "usage", "session-s1.json"),
+		`{"session_id":"s1","row":"Darn-Write","role":"darn","model":"claude-opus-5-5","cost_usd":0.6}`)
+	writeFile(t, filepath.Join(dir, lymdirs.LymDirName, "usage", "session-s2.json"),
+		`{"session_id":"s2","row":"Darn-Write","role":"darn","model":"claude-opus-5-5","cost_usd":0.5}`)
+	writeFile(t, filepath.Join(dir, lymdirs.LymDirName, "usage", "session-s3.json"),
+		`{"session_id":"s3","row":"Darn-Write","role":"darn","model":"claude-opus-5-5","cost_usd":1.2}`)
+	writeFile(t, filepath.Join(dir, lymdirs.LymDirName, "shed", "run-a", "status.json"), `{"history":[
+		{"producer":"Darn-Write","outcome":"done","at":"2026-11-10T11:00:00Z","gate_attempts":2,"gate_spans":[
+			{"gate":"verify","kind":"gate","start":"2026-11-10T10:00:00Z","end":"2026-11-10T10:05:00Z"},
+			{"gate":"verify","kind":"rework","start":"2026-11-10T10:05:00Z","end":"2026-11-10T10:20:00Z"},
+			{"gate":"verify","kind":"gate","start":"2026-11-10T10:20:00Z","end":"2026-11-10T10:25:00Z"}]},
+		{"producer":"Finalize","outcome":"done","at":"2026-11-10T12:00:00Z"}]}`)
+	writeFile(t, filepath.Join(dir, lymdirs.LymDirName, "reviews", "code", "round-1-facts.md"), "# Round 1 facts\n\n"+
+		"| Round | Findings | BLOCKING | design | Gating |\n| --- | --- | --- | --- | --- |\n| 1 | 9 | 9 | 9 | 9 |\n")
+	writeFile(t, filepath.Join(dir, lymdirs.LymDirName, "reviews", "code", "round-2-facts.md"), "# Round 2 facts\n\n"+
+		"| Round | Findings | BLOCKING | design | Gating |\n| --- | --- | --- | --- | --- |\n"+
+		"| 1 | 3 | 1 | 2 | 1 |\n| 2 | 1 | 0 | 1 | 0 |\n\n"+
+		"## Recurring keys (ledger rounds each key was open in)\n\n- `stale-doc`: rounds 1, 2\n\n"+
+		"## Keys open in an earlier round (ledger rounds each key was open in)\n\n- `other-key`: rounds 1\n")
+	gitkit.Git(t, dir, "add", "-A")
+	gitkit.Git(t, dir, "commit", "-m", "run-a records")
+	gitkit.Git(t, dir, "tag", "archive/run-a/abc123")
+}
+
+// transcriptLines returns the lines of a transcript whose session made the given calls.
+// Each call takes one turn and is answered by the matching result.
+func transcriptLines(title string, calls []map[string]any, results []string) string {
+	var lines []string
+	if title != "" {
+		line, _ := json.Marshal(map[string]any{"type": "custom-title", "customTitle": title})
+		lines = append(lines, string(line))
+	}
+	for i, call := range calls {
+		id := "t" + string(rune('a'+i))
+		call["type"], call["id"] = "tool_use", id
+		stamp := "2026-11-10T10:0" + string(rune('0'+i)) + ":00Z"
+		turn, _ := json.Marshal(map[string]any{"type": "assistant", "timestamp": stamp,
+			"message": map[string]any{"id": "m" + id, "content": []any{call}}})
+		result, _ := json.Marshal(map[string]any{"type": "user", "timestamp": stamp,
+			"message": map[string]any{"content": []any{map[string]any{"type": "tool_result", "tool_use_id": id, "content": results[i]}}}})
+		lines = append(lines, string(turn), string(result))
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
+
+func TestRetroScript_WritesTheFiguresOfEachRun(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+	for _, tool := range []string{"jq", "awk", "bash"} {
+		if _, err := exec.LookPath(tool); err != nil {
+			t.Fatalf("retro.sh tests need %s on PATH: %v", tool, err)
+		}
+	}
+
+	root := t.TempDir()
+	records, projects, hub, out := filepath.Join(root, "records"), filepath.Join(root, "projects"), filepath.Join(root, "hub"), filepath.Join(root, "out")
+	if err := os.MkdirAll(records, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	buildRecords(t, records)
+	runDir := filepath.Join(projects, strings.Map(func(r rune) rune {
+		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') {
+			return r
+		}
+		return '-'
+	}, filepath.Join(hub, "run-a")))
+	// The sixth call, a gate run moved to the background, fails only in the task notification that follows it.
+	notification, _ := json.Marshal(map[string]any{"type": "queue-operation",
+		"content": "<task-notification><tool-use-id>tf</tool-use-id><summary>Background command failed (exit code 1)</summary></task-notification>"})
+	writeFile(t, filepath.Join(runDir, "s1.jsonl"), transcriptLines("ly:run-a:darn",
+		[]map[string]any{
+			{"name": "Read", "input": map[string]any{"file_path": "/w/a.go"}},
+			{"name": "Bash", "input": map[string]any{"command": "grep -rn Foo internal/"}},
+			{"name": "Bash", "input": map[string]any{"command": "rm -rf $DIR"}},
+			{"name": "Bash", "input": map[string]any{"command": "lym gate test ./internal/x"}},
+			{"name": "Edit", "input": map[string]any{"file_path": "/w/a.go"}},
+			{"name": "Bash", "input": map[string]any{"command": "lym gate test ./internal/y"}},
+		},
+		[]string{"package a", "a.go:1:Foo", "PreToolUse:Bash hook error: rm on a computed path is refused here", "Exit code 1\nFAIL", "ok",
+			"Command was moved to the background with ID: b1"})+string(notification)+"\n")
+	edit := []map[string]any{{"name": "Edit", "input": map[string]any{"file_path": "/w/a.go"}}}
+	writeFile(t, filepath.Join(runDir, "s2.jsonl"), transcriptLines("ly:run-a:darn", append(edit, edit...), []string{"ok", "ok"}))
+	writeFile(t, filepath.Join(runDir, "s3.jsonl"), transcriptLines("ly:run-a:darn", edit, []string{"ok"}))
+	writeFile(t, filepath.Join(runDir, "s4.jsonl"), transcriptLines("ly:run-a:gate-fixer", edit, []string{"ok"}))
+	writeFile(t, filepath.Join(runDir, "s1/subagents/agent-f1.jsonl"), transcriptLines("",
+		[]map[string]any{{"name": "Glob", "input": map[string]any{"pattern": "*.go"}}}, []string{"a.go"}))
+
+	script, err := filepath.Abs("retro.sh")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("bash", script, out, "run-a", "run-gone")
+	cmd.Dir = root
+	cmd.Env = append(os.Environ(), "PROJECTS="+projects, "HUB="+hub, "RECORDS="+records)
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("retro.sh = %v; want success:\n%s", err, output)
+	}
+
+	var got []session
+	for _, line := range readLines(t, filepath.Join(out, "sessions.jsonl")) {
+		var row session
+		if err := json.Unmarshal([]byte(line), &row); err != nil {
+			t.Fatalf("sessions.jsonl line %q: %v", line, err)
+		}
+		got = append(got, row)
+	}
+	want := []session{
+		{Slug: "run-a", Session: "s1", Kind: "main", Title: "ly:run-a:darn", Row: "Darn-Write", Model: "claude-opus-5-5", Cost: 0.6,
+			Turns: 6, Calls: 6, LookupTurns: 2, SerialSaved: 1, Refusals: 1, GateRuns: 2, GateFails: 2},
+		{Slug: "run-a", Session: "agent-f1", Kind: "fork", Turns: 1, Calls: 1, LookupTurns: 1},
+		{Slug: "run-a", Session: "s2", Kind: "main", Title: "ly:run-a:darn", Row: "Darn-Write", Model: "claude-opus-5-5", Cost: 0.5, Turns: 2, Calls: 2},
+		{Slug: "run-a", Session: "s3", Kind: "main", Title: "ly:run-a:darn", Row: "Darn-Write", Model: "claude-opus-5-5", Cost: 1.2, Turns: 1, Calls: 1},
+		{Slug: "run-a", Session: "s4", Kind: "main", Title: "ly:run-a:gate-fixer", Turns: 1, Calls: 1},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("sessions.jsonl = %+v; want %+v", got, want)
+	}
+
+	tables := []struct {
+		file string
+		want []string
+	}{
+		{"refusals.jsonl", []string{`{"slug":"run-a","session":"s1","kind":"main","turn":3,"tool":"Bash","refusal":"rm on a computed path is refused here"}`}},
+		{"rows.jsonl", []string{
+			`{"slug":"run-a","idx":0,"producer":"Darn-Write","outcome":"done","gate_attempts":2,"verify_runs":2,"verify_reworks":1,"routed_to":""}`,
+			`{"slug":"run-a","idx":1,"producer":"Finalize","outcome":"done","gate_attempts":0,"verify_runs":0,"verify_reworks":0,"routed_to":""}`,
+		}},
+		{"facts.jsonl", []string{
+			`{"slug":"run-a","perch":"code","round":1,"column":"Findings","value":"3"}`,
+			`{"slug":"run-a","perch":"code","round":1,"column":"BLOCKING","value":"1"}`,
+			`{"slug":"run-a","perch":"code","round":1,"column":"design","value":"2"}`,
+			`{"slug":"run-a","perch":"code","round":1,"column":"Gating","value":"1"}`,
+			`{"slug":"run-a","perch":"code","round":2,"column":"Findings","value":"1"}`,
+			`{"slug":"run-a","perch":"code","round":2,"column":"BLOCKING","value":"0"}`,
+			`{"slug":"run-a","perch":"code","round":2,"column":"design","value":"1"}`,
+			`{"slug":"run-a","perch":"code","round":2,"column":"Gating","value":"0"}`,
+		}},
+		{"usage.jsonl", []string{
+			`{"slug":"run-a","session":"s1","row":"Darn-Write","role":"darn","model":"claude-opus-5-5","cost":0.6}`,
+			`{"slug":"run-a","session":"s2","row":"Darn-Write","role":"darn","model":"claude-opus-5-5","cost":0.5}`,
+			`{"slug":"run-a","session":"s3","row":"Darn-Write","role":"darn","model":"claude-opus-5-5","cost":1.2}`,
+		}},
+		{"keys.jsonl", []string{`{"slug":"run-a","perch":"code","key":"stale-doc","rounds":"1, 2"}`}},
+		{"missing.jsonl", []string{`{"slug":"run-gone","what":"archive tag"}`, `{"slug":"run-gone","what":"transcript directory (Claude Code layout)"}`}},
+	}
+	for _, table := range tables {
+		if got := readLines(t, filepath.Join(out, table.file)); !reflect.DeepEqual(got, table.want) {
+			t.Errorf("%s = %q; want %q", table.file, got, table.want)
+		}
+	}
+
+	figures := readLines(t, filepath.Join(out, "figures.md"))
+	for _, want := range []string{
+		"| run-a | 4 | 1 | $2.3 | 2 | 1 | 1 | code 2 |",
+		"| Darn-Write | 3 | 2 | $0.6 | run-a s1 (6 turns, $0.6); run-a s3 (1 turns, $1.2) |",
+		"| code | Findings | 4 |",
+		"| code | design | 3 |",
+		"- run-a code: `stale-doc`, rounds 1, 2",
+	} {
+		found := false
+		for _, line := range figures {
+			found = found || line == want
+		}
+		if !found {
+			t.Errorf("figures.md has no line %q:\n%s", want, strings.Join(figures, "\n"))
+		}
+	}
+}
