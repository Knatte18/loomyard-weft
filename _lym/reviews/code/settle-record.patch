diff --git a/contracts/recipes/hardener-recipe.yaml b/contracts/recipes/hardener-recipe.yaml
new file mode 100644
index 00000000..3d76e3f0
--- /dev/null
+++ b/contracts/recipes/hardener-recipe.yaml
@@ -0,0 +1,157 @@
+# hardener-recipe.yaml is the hardener task recipe: Record-Write writes the decision record from the board entry,
+# the Harden ring drives a live-substrate lym module against throwaway sandbox hubs round after round,
+# Describe rewrites the change description from the final diff, then PR-Review and Finalize land it.
+# It is embedded into the binary by the sibling recipes.go rather than read from disk. The row names below are the
+# durable on-disk identities pinned against internal/loomshed's Name* constants.
+#
+# The decision record's `## Goal` is the campaign's charter: the module under test, its code paths and its scenarios.
+# The ring's answer key is that record alone, and its open findings land in the record's `## Open risks`.
+# The recipe has no Drift rows and no writer row: the fix row of the ring is the one build row.
+#
+# Harden-Bouncer, Harden-Burler-Review and Harden-Burler-Fix are the Harden-Review ring.
+# It is the shared-segment ring of the Code-Review perch: the Bouncer's on_stuck names the review row,
+# the review row's on_stuck names the fix row, the fix row's on_stuck names the Bouncer,
+# and each Burler row's on_done names the same row as its on_stuck, since neither ever returns Done.
+# Every row of the ring carries `harden_round: true` where it takes the campaign's round seams,
+# or is the HardenFix engine, whose gates are fixed to clean, verify and live, so the fix row declares no `gates` key.
+# The segment's rows declare no max_bounces: their budget is the hub's resolved Harden-Review budget,
+# applied by internal/loomrecipe.
+#
+# The fix row is the recipe's one build row, placed for the loom contract's order clause at Harden-Bouncer.
+#
+# Preflight and Finalize carry no on_stuck: nothing in the list produces what each of them gates,
+# so a human is the only thing that can fix them.
+# Record-Write and Describe carry none either, and a Stuck of one halts the run for the parent.
+# PR-Review carries no on_stuck because its Stuck halts the run, and no entry_gate:
+# whether it opens a pull request reads the parent's anchor, a board field and the origin, which the row decides in its own call.
+# Friction-Reflect carries no on_stuck because it never returns Stuck.
+# Finalize declares no on_reroute: it settles a fixer change in place and never sends the run back to the ring.
+
+version: 1
+entry: Preflight
+# The recipe declares the loom contract, which Shed checks when it builds the recipe; verify_source names where the verify targets come from.
+contract: loom
+verify_source: tree_scope
+terminals:
+  - Friction-Reflect
+
+producers:
+  - name: Preflight
+    engine: Preflight
+    on_done: Record-Write
+
+  # Record-Write is a Go row: it writes the decision record and support log from the task's board entry, with no agent, and commits them.
+  # It writes only a file that is missing, so a resume or a goto back to it keeps every entry added after Discussion.
+  - name: Record-Write
+    engine: RecordWrite
+    on_done: Harden-Bouncer
+
+  - name: Harden-Bouncer
+    engine: Bouncer
+    segment: Harden-Review
+    on_stuck: Harden-Burler-Review
+    on_done: Describe
+    config:
+      run_subdir: harden
+      subject: code
+      role_prefix: harden
+      reviewer_fan_setting: hardener.reviewer_fan
+      auto_accept_setting: hardener.auto_accept
+      # The subject under review is the campaign's code, which artifact_paths cannot name; the key
+      # names the answer key instead: the decision record. The rubric names the code as the subject.
+      artifact_paths:
+        - _lym/discussion/decision-record.md
+      rubric_stencil: harden-rubric-review
+      # commit_seam names the campaign's commit seam, which commits each round's files.
+      commit_seam: harden
+      # carry_over names this row's own segment: the Bouncer files the round's still-open findings
+      # under it in the decision record's Open risks section, and a test pins it equal to segment.
+      carry_over: Harden-Review
+      harden_round: true
+
+  - name: Harden-Burler-Review
+    engine: BurlerReview
+    segment: Harden-Review
+    on_stuck: Harden-Burler-Fix
+    # BurlerReviewProducer never returns Done, so this edge is unreachable -- but an empty on_done
+    # is load-bearing and ends the whole run silently, so it names the row it can never reach.
+    on_done: Harden-Burler-Fix
+    config:
+      # The same run_subdir value as Harden-Bouncer is what makes the three rows write into one
+      # shared run directory.
+      run_subdir: harden
+      role_prefix: harden
+      reviewer_fan_setting: hardener.reviewer_fan
+      fixer_fan_setting: hardener.fixer_fan
+      harden_round: true
+      profile:
+        target:
+          # No paths key: the charter's code paths sit in the decision record, which the instructions name.
+          instructions: >
+            The subject under review is the code the charter in the decision record names:
+            read the record's `## Goal` for the module under test and its code paths, and review those paths.
+            The rubric supplied in this prompt is the single definition of the review range.
+        fasit:
+          paths:
+            - _lym/discussion/decision-record.md
+          instructions: >
+            The decision record named above is the campaign's charter: the board entry's body under
+            `## Goal`, as amended by the record's `Added after Discussion` entries, which win where
+            they differ. The round's job is to find and fix behaviour that departs from that charter.
+        rubric_stencil: harden-rubric-review
+        # fix-scope: source: the target is the repo's own source files, and a fixer that cannot
+        # write and commit source cannot fix the module under test.
+        fix-scope: source
+        # tool-use is required: the round reads the live report and the sandbox hubs' state.
+        tool-use: true
+        # The round reviews code, so its seats load the hub's language skills after their own.
+        language-skills: true
+
+  - name: Harden-Burler-Fix
+    engine: HardenFix
+    segment: Harden-Review
+    on_stuck: Harden-Bouncer
+    # HardenFix never returns Done, so this edge is unreachable -- but an empty on_done is
+    # load-bearing and ends the whole run silently, so it names the row it can never reach.
+    on_done: Harden-Bouncer
+    config:
+      run_subdir: harden
+      role_prefix: harden
+      fixer_fan_setting: hardener.fixer_fan
+      review_row: Harden-Burler-Review
+      # No gates key: the engine fixes the row's gates to clean, verify and live.
+      profile:
+        # No target key: the fixer finds its files from the review's findings and the gates' findings alone.
+        fix-scope: source
+        # The round fixes code, so its seat loads the hub's language skills after its own.
+        language-skills: true
+
+  # Describe writes the change description from the final diff, replacing the earlier one.
+  - name: Describe
+    engine: Describe
+    on_done: PR-Review
+    config:
+      gates:
+        - name: description
+          attempts: 3
+
+  # PR-Review lands the task through a GitHub pull request when the pull-request resolver says so.
+  # It carries no entry_gate and no on_stuck, because its Stuck halts the run.
+  - name: PR-Review
+    engine: PRReview
+    on_done: Finalize
+
+  # Finalize takes the parent lock first, merges the parent into the task branch, runs the landing
+  # gate and the merge fixer, then fast-forwards the parent and releases the lock on every way out.
+  - name: Finalize
+    engine: Finalize
+    # Hands off to the reflection row rather than ending the run.
+    on_done: Friction-Reflect
+
+  # Friction-Reflect runs the Tier 2 friction reflection under the run lock and is the recipe's
+  # sole terminal, so the engine persists state.
+  - name: Friction-Reflect
+    engine: FrictionReflect
+    # on_done is explicitly empty: the empty value is load-bearing and is what ends the whole run
+    # quietly, per shedengine.ProducerDef.OnDone's own field doc.
+    on_done: ""
