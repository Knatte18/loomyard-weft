+	if len(marks.Files) > 0 {
+		parts = append(parts, "files "+quote(marks.Files))
+	}
+	if len(marks.Keys) > 0 {
+		parts = append(parts, "keys "+quote(marks.Keys))
+	}
+	return []string{"- Left out as capture metadata, not results: " + strings.Join(parts, "; ") + "."}
