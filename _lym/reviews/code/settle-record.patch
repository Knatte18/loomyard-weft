diff --git a/internal/retroengine/doc.go b/internal/retroengine/doc.go
new file mode 100644
index 00000000..4a25e532
--- /dev/null
+++ b/internal/retroengine/doc.go
@@ -0,0 +1,13 @@
+// Package retroengine plans a retro:
+// the landed runs it covers, the stamp that names it and the board task that audits them.
+//
+// A retro is one darn task.
+// Its writer runs the retro's scripts over the runs' records and transcripts.
+// It reads what their figures point at and writes a report of proposals under the retro report directory.
+// The task's slug and the report's directory share one name, the slug prefix and the UTC end of the window covered.
+// So the newest such name, among the report directories and the board's entries, is the last retro,
+// and a retro still in flight counts as one.
+//
+// The engine reads nothing itself: a caller hands it the landed runs, the names to search for the last retro,
+// and the stencils directory the task body renders from.
+package retroengine
diff --git a/internal/retroengine/retro.go b/internal/retroengine/retro.go
new file mode 100644
index 00000000..cfbf7992
--- /dev/null
+++ b/internal/retroengine/retro.go
@@ -0,0 +1,274 @@
+// retro.go chooses the runs a retro covers, finds the last retro, and renders the retro task's board fields.
+
+package retroengine
+
+import (
+	"fmt"
+	"path"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/stencil"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+)
+
+const (
+	// ReportDirRel is the worktree-relative directory holding one report directory per retro, named by its slug.
+	ReportDirRel = "docs/research/retro"
+
+	// ResearchIndexRel is the worktree-relative index that lists every research report, the retro reports included.
+	ResearchIndexRel = "docs/research/README.md"
+
+	// ToolsDirRel is the worktree-relative directory of the retro's own scripts.
+	ToolsDirRel = "tools/retro"
+
+	// SlugPrefix opens the slug of every retro task and the name of every retro report directory.
+	SlugPrefix = "retro-"
+
+	// stampLayout is the form of the UTC time that follows SlugPrefix: the end of the window a retro covers.
+	stampLayout = "20060102-150405"
+
+	// StencilName names the stencil the retro task's body renders from.
+	StencilName = "retro-template-task"
+
+	// TaskProfile is the run profile of the retro task, the darn profile for prose work.
+	TaskProfile = "docs"
+
+	// TaskLabel is the type label of the retro task.
+	TaskLabel = "research"
+
+	// DefaultMaxRuns is the most runs one retro covers when the caller sets no cap.
+	DefaultMaxRuns = 10
+
+	// ReadCap is the most transcript spans, stencils and instruction passages the retro's writer reads.
+	ReadCap = 12
+
+	// DefaultWindow is how far back a retro reaches when it has no earlier retro and no start of its own.
+	DefaultWindow = 7 * 24 * time.Hour
+
+	// NamedLookback is how far back a named run may have landed.
+	NamedLookback = 60 * 24 * time.Hour
+)
+
+// Run is one landed run: its slug and the time of the commit that landed it on the parent branch.
+type Run struct {
+	Slug   string
+	Landed time.Time
+}
+
+// Window says which runs a retro covers: the named runs, or the runs landed in a span of time.
+type Window struct {
+	// Slugs names the runs to cover; when it holds any, Since and Until are zero.
+	Slugs []string
+
+	// Since is the time after which a landed run is covered; zero means after the last retro.
+	Since time.Time
+
+	// Until is the time up to which a landed run is covered; zero means Now.
+	Until time.Time
+
+	// Now is the time the retro is filed.
+	Now time.Time
+
+	// MaxRuns is the most runs the retro covers, at least one.
+	MaxRuns int
+}
+
+// Plan is one retro: its slug, the window it covers and the runs in it, oldest first.
+type Plan struct {
+	Slug  string
+	From  time.Time
+	Until time.Time
+	Runs  []Run
+}
+
+// LastRetro returns the newest stamp among names that carry the retro form, SlugPrefix and then a stamp.
+// The bool is false when no name does.
+func LastRetro(names []string) (time.Time, bool) {
+	var newest time.Time
+	found := false
+	for _, name := range names {
+		rest, ok := strings.CutPrefix(name, SlugPrefix)
+		if !ok {
+			continue
+		}
+		stamp, err := time.ParseInLocation(stampLayout, rest, time.UTC)
+		if err != nil {
+			continue
+		}
+		if !found || stamp.After(newest) {
+			newest, found = stamp, true
+		}
+	}
+	return newest, found
+}
+
+// Start returns the earliest landing time the window can cover, given the last retro's stamp when hasLast holds.
+// A caller reads the landings from this time on.
+func (w Window) Start(last time.Time, hasLast bool) time.Time {
+	switch {
+	case len(w.Slugs) > 0:
+		return w.Now.Add(-NamedLookback)
+	case !w.Since.IsZero():
+		return w.Since
+	case hasLast:
+		return last
+	default:
+		return w.end().Add(-DefaultWindow)
+	}
+}
+
+// end returns the time up to which the window covers runs.
+func (w Window) end() time.Time {
+	if w.Until.IsZero() {
+		return w.Now
+	}
+	return w.Until
+}
+
+// Select chooses the runs a retro covers from landed, the runs landed on the parent branch, and names the retro.
+// last is the stamp of the newest earlier retro, and hasLast reports whether one exists.
+// Named slugs are covered exactly, and the retro's stamp is the newest one's landing;
+// its window starts a second before the oldest one's landing, so every named run landed after it.
+// A name with no landing within NamedLookback is refused, and so are more names than MaxRuns.
+// Otherwise the retro covers the runs landed after the window's start and up to its end.
+// Past MaxRuns it keeps the oldest and ends its window at the last kept landing,
+// so the next retro starts with the first run left out;
+// runs landed in the same second as the first one left out are left out too, so no second is split across retros,
+// and a cap that falls inside the oldest landing's second keeps that whole second.
+// A window with no run in it is refused.
+func Select(landed []Run, last time.Time, hasLast bool, w Window) (Plan, error) {
+	newest := map[string]time.Time{}
+	for _, run := range landed {
+		if at, ok := newest[run.Slug]; !ok || run.Landed.After(at) {
+			newest[run.Slug] = run.Landed
+		}
+	}
+
+	if len(w.Slugs) > 0 {
+		var runs []Run
+		for _, slug := range w.Slugs {
+			at, ok := newest[slug]
+			if !ok {
+				return Plan{}, fmt.Errorf("retro: run %q has no landing on the parent branch within the last %d days, since %s: "+
+					"name only runs landed within them (a misspelt slug and an unlanded run have none), or cover an older run with --since and --until",
+					slug, int(NamedLookback.Hours()/24), w.Start(last, hasLast).UTC().Format(time.RFC3339))
+			}
+			if !slices.ContainsFunc(runs, func(r Run) bool { return r.Slug == slug }) {
+				runs = append(runs, Run{Slug: slug, Landed: at})
+			}
+		}
+		if len(runs) > w.MaxRuns {
+			return Plan{}, fmt.Errorf("retro: %d runs named, more than the cap of %d: name fewer runs, or raise --max-runs", len(runs), w.MaxRuns)
+		}
+		sortByLanding(runs)
+		return newPlan(runs[0].Landed.Add(-time.Second), runs[len(runs)-1].Landed, runs), nil
+	}
+
+	from, until := w.Start(last, hasLast), w.end()
+	var runs []Run
+	for slug, at := range newest {
+		if at.After(from) && !at.After(until) {
+			runs = append(runs, Run{Slug: slug, Landed: at})
+		}
+	}
+	if len(runs) == 0 {
+		return Plan{}, fmt.Errorf("retro: no run landed after %s and up to %s: name the runs to cover, or pass an earlier --since",
+			from.UTC().Format(time.RFC3339), until.UTC().Format(time.RFC3339))
+	}
+	sortByLanding(runs)
+	if len(runs) > w.MaxRuns {
+		// The next retro starts after the last kept landing.
+		// A run landed in the first left-out run's second must not be split from it, so those runs are all kept or all left out.
+		firstLeftOut := runs[w.MaxRuns].Landed
+		cut := w.MaxRuns
+		for cut > 0 && runs[cut-1].Landed.Equal(firstLeftOut) {
+			cut--
+		}
+		if cut == 0 {
+			// The cap falls inside the oldest landing's second, so that whole second is kept, past the cap.
+			for cut < len(runs) && runs[cut].Landed.Equal(firstLeftOut) {
+				cut++
+			}
+		}
+		runs = runs[:cut]
+		until = runs[len(runs)-1].Landed
+	}
+	return newPlan(from, until, runs), nil
+}
+
+// sortByLanding orders runs oldest landing first, and by slug between runs landed at the same time.
+func sortByLanding(runs []Run) {
+	slices.SortFunc(runs, func(a, b Run) int {
+		if c := a.Landed.Compare(b.Landed); c != 0 {
+			return c
+		}
+		return strings.Compare(a.Slug, b.Slug)
+	})
+}
+
+// newPlan names the retro over runs by the end of its window.
+func newPlan(from, until time.Time, runs []Run) Plan {
+	return Plan{Slug: SlugPrefix + until.UTC().Format(stampLayout), From: from, Until: until, Runs: runs}
+}
+
+// ReportDir returns the worktree-relative directory the retro's report goes in.
+func (p Plan) ReportDir() string {
+	return path.Join(ReportDirRel, p.Slug)
+}
+
+// Slugs returns the covered runs' slugs, oldest landing first.
+func (p Plan) Slugs() []string {
+	slugs := make([]string, len(p.Runs))
+	for i, run := range p.Runs {
+		slugs[i] = run.Slug
+	}
+	return slugs
+}
+
+// Body renders the board body of the retro task from the retro stencil under stencilsDir.
+func (p Plan) Body(stencilsDir string) (string, error) {
+	template, err := stencilstore.Read(stencilsDir, StencilName)
+	if err != nil {
+		return "", err
+	}
+	lines := make([]string, len(p.Runs))
+	for i, run := range p.Runs {
+		lines[i] = fmt.Sprintf("- `%s`, landed %s", run.Slug, run.Landed.UTC().Format(time.RFC3339))
+	}
+	slugs := p.Slugs()
+	body, err := stencil.Fill(template, map[string]string{
+		"runs":           strings.Join(lines, "\n"),
+		"run_slugs":      strings.Join(slugs, " "),
+		"run_list":       strings.Join(slugs, ","),
+		"from":           p.From.UTC().Format(time.RFC3339),
+		"until":          p.Until.UTC().Format(time.RFC3339),
+		"report_dir":     p.ReportDir(),
+		"retro_dir":      ReportDirRel,
+		"research_index": ResearchIndexRel,
+		"tools_dir":      ToolsDirRel,
+		"read_cap":       strconv.Itoa(ReadCap),
+	})
+	if err != nil {
+		return "", fmt.Errorf("retro: render stencil %q: %w", StencilName, err)
+	}
+	return strings.TrimSpace(stencil.StripLeadingComment(string(body))) + "\n", nil
+}
+
+// TaskFields returns the board fields of the retro task with body: a darn task on the docs profile.
+func (p Plan) TaskFields(body string) map[string]any {
+	return map[string]any{
+		"slug":    p.Slug,
+		"title":   fmt.Sprintf("Retro of %d landed runs up to %s", len(p.Runs), p.Until.UTC().Format(time.RFC3339)),
+		"brief":   "Audit the runs from their records and transcripts, and propose fixes, most severe first",
+		"kind":    boardengine.KindTask,
+		"recipe":  shedrun.RecipeDarn,
+		"profile": TaskProfile,
+		"labels":  []string{TaskLabel},
+		"body":    body,
+	}
+}
diff --git a/internal/retroengine/retro_test.go b/internal/retroengine/retro_test.go
new file mode 100644
index 00000000..fdb3e82c
--- /dev/null
+++ b/internal/retroengine/retro_test.go
@@ -0,0 +1,248 @@
+// retro_test.go covers how a retro finds the last retro, chooses its runs and renders its task body.
+
+package retroengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/contracts/stencils"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/retroengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// at returns the UTC time of day on 2026-11-16 for hour, minute and second.
+func at(hour, minute, second int) time.Time {
+	return time.Date(2026, 11, 16, hour, minute, second, 0, time.UTC)
+}
+
+func TestLastRetro(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name      string
+		names     []string
+		want      time.Time
+		wantFound bool
+	}{
+		{"no names", nil, time.Time{}, false},
+		{"no retro form among the names", []string{"lym-retro", "retro-notes", "retro-2026-11-16"}, time.Time{}, false},
+		{"the newest stamp wins over older and foreign names", []string{"retro-20261110-090000", "board-task", "retro-20261116-140550", "retro-20261112-235959"}, at(14, 5, 50), true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, found := retroengine.LastRetro(tt.names)
+			if !got.Equal(tt.want) || found != tt.wantFound {
+				t.Errorf("LastRetro(%v) = %v, %v; want %v, %v", tt.names, got, found, tt.want, tt.wantFound)
+			}
+		})
+	}
+}
+
+func TestSelect(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	landed := []retroengine.Run{
+		{Slug: "old", Landed: at(8, 0, 0)},
+		{Slug: "a", Landed: at(10, 0, 0)},
+		{Slug: "b", Landed: at(11, 0, 0)},
+		{Slug: "relanded", Landed: at(9, 0, 0)},
+		{Slug: "relanded", Landed: at(12, 0, 0)},
+		{Slug: "late", Landed: at(15, 0, 0)},
+	}
+	now := at(14, 0, 0)
+	tests := []struct {
+		name string
+		// landed replaces the shared landings when set.
+		landed   []retroengine.Run
+		last     time.Time
+		hasLast  bool
+		window   retroengine.Window
+		want     retroengine.Plan
+		wantErrs []string
+	}{
+		{
+			name:    "after the last retro and up to now, each run at its newest landing",
+			last:    at(9, 30, 0),
+			hasLast: true,
+			window:  retroengine.Window{Now: now, MaxRuns: 10},
+			want: retroengine.Plan{Slug: "retro-20261116-140000", From: at(9, 30, 0), Until: now,
+				Runs: []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(11, 0, 0)}, {Slug: "relanded", Landed: at(12, 0, 0)}}},
+		},
+		{
+			name:   "with no earlier retro, the default window before now",
+			window: retroengine.Window{Now: at(14, 0, 0).Add(retroengine.DefaultWindow - 5*time.Hour), MaxRuns: 10},
+			want: retroengine.Plan{Slug: "retro-20261123-090000", From: at(9, 0, 0), Until: at(14, 0, 0).Add(retroengine.DefaultWindow - 5*time.Hour),
+				Runs: []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(11, 0, 0)}, {Slug: "relanded", Landed: at(12, 0, 0)}, {Slug: "late", Landed: at(15, 0, 0)}}},
+		},
+		{
+			name:    "a given since and until replace the last retro and now",
+			last:    at(11, 30, 0),
+			hasLast: true,
+			window:  retroengine.Window{Since: at(7, 0, 0), Until: at(10, 0, 0), Now: now, MaxRuns: 10},
+			want: retroengine.Plan{Slug: "retro-20261116-100000", From: at(7, 0, 0), Until: at(10, 0, 0),
+				Runs: []retroengine.Run{{Slug: "old", Landed: at(8, 0, 0)}, {Slug: "a", Landed: at(10, 0, 0)}}},
+		},
+		{
+			name:    "past the cap the oldest runs are kept and the window ends at the last kept landing",
+			last:    at(7, 0, 0),
+			hasLast: true,
+			window:  retroengine.Window{Now: now, MaxRuns: 2},
+			want: retroengine.Plan{Slug: "retro-20261116-100000", From: at(7, 0, 0), Until: at(10, 0, 0),
+				Runs: []retroengine.Run{{Slug: "old", Landed: at(8, 0, 0)}, {Slug: "a", Landed: at(10, 0, 0)}}},
+		},
+		{
+			name: "a cap between runs landed in one second leaves that second to the next retro",
+			landed: []retroengine.Run{
+				{Slug: "x", Landed: at(8, 0, 0)}, {Slug: "y", Landed: at(10, 0, 0)}, {Slug: "z", Landed: at(10, 0, 0)}, {Slug: "w", Landed: at(11, 0, 0)},
+			},
+			last:    at(7, 0, 0),
+			hasLast: true,
+			window:  retroengine.Window{Now: now, MaxRuns: 2},
+			want: retroengine.Plan{Slug: "retro-20261116-080000", From: at(7, 0, 0), Until: at(8, 0, 0),
+				Runs: []retroengine.Run{{Slug: "x", Landed: at(8, 0, 0)}}},
+		},
+		{
+			name:    "a cap inside the oldest landing's second keeps that whole second",
+			landed:  []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(10, 0, 0)}, {Slug: "c", Landed: at(10, 0, 0)}, {Slug: "d", Landed: at(11, 0, 0)}},
+			last:    at(7, 0, 0),
+			hasLast: true,
+			window:  retroengine.Window{Now: now, MaxRuns: 2},
+			want: retroengine.Plan{Slug: "retro-20261116-100000", From: at(7, 0, 0), Until: at(10, 0, 0),
+				Runs: []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(10, 0, 0)}, {Slug: "c", Landed: at(10, 0, 0)}}},
+		},
+		{
+			name:    "a cap inside a second that holds every run keeps them all",
+			landed:  []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(10, 0, 0)}},
+			last:    at(7, 0, 0),
+			hasLast: true,
+			window:  retroengine.Window{Now: now, MaxRuns: 1},
+			want: retroengine.Plan{Slug: "retro-20261116-100000", From: at(7, 0, 0), Until: at(10, 0, 0),
+				Runs: []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(10, 0, 0)}}},
+		},
+		{
+			name:    "named runs are covered exactly, whatever the last retro, from just before the oldest landing",
+			last:    at(13, 0, 0),
+			hasLast: true,
+			window:  retroengine.Window{Slugs: []string{"late", "old", "late"}, Now: now, MaxRuns: 2},
+			want: retroengine.Plan{Slug: "retro-20261116-150000", From: at(7, 59, 59), Until: at(15, 0, 0),
+				Runs: []retroengine.Run{{Slug: "old", Landed: at(8, 0, 0)}, {Slug: "late", Landed: at(15, 0, 0)}}},
+		},
+		{
+			name:     "a named run with no landing within the lookback is refused with the lookback's start",
+			window:   retroengine.Window{Slugs: []string{"a", "never-landed"}, Now: now, MaxRuns: 10},
+			wantErrs: []string{`"never-landed"`, "within the last 60 days", "since 2026-09-17T14:00:00Z", "--since and --until"},
+		},
+		{
+			name:     "more named runs than the cap are refused",
+			window:   retroengine.Window{Slugs: []string{"a", "b", "old"}, Now: now, MaxRuns: 2},
+			wantErrs: []string{"3 runs named", "cap of 2", "--max-runs"},
+		},
+		{
+			name:     "a window with no landed run is refused",
+			last:     at(12, 0, 0),
+			hasLast:  true,
+			window:   retroengine.Window{Now: now, MaxRuns: 10},
+			wantErrs: []string{"no run landed after 2026-11-16T12:00:00Z and up to 2026-11-16T14:00:00Z", "--since"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			runs := landed
+			if tt.landed != nil {
+				runs = tt.landed
+			}
+			got, err := retroengine.Select(runs, tt.last, tt.hasLast, tt.window)
+			if len(tt.wantErrs) > 0 {
+				if err == nil {
+					t.Fatalf("Select() = %+v, nil; want an error", got)
+				}
+				for _, want := range tt.wantErrs {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("Select() error = %q; want it to contain %q", err, want)
+					}
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Select() = _, %v; want nil error", err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("Select() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestPlan_TaskFieldsFilesOneDarnTaskOnTheDocsProfile(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	plan := retroengine.Plan{Slug: "retro-20261116-140000", From: at(9, 0, 0), Until: at(14, 0, 0),
+		Runs: []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(11, 0, 0)}}}
+
+	got := plan.TaskFields("the body\n")
+
+	for key, want := range map[string]any{
+		"slug":    "retro-20261116-140000",
+		"title":   "Retro of 2 landed runs up to 2026-11-16T14:00:00Z",
+		"kind":    boardengine.KindTask,
+		"recipe":  shedrun.RecipeDarn,
+		"profile": "docs",
+		"labels":  []string{"research"},
+		"body":    "the body\n",
+	} {
+		if !reflect.DeepEqual(got[key], want) {
+			t.Errorf("TaskFields()[%q] = %v; want %v", key, got[key], want)
+		}
+	}
+}
+
+func TestPlan_BodyFillsTheShippedStencil(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	dir := t.TempDir()
+	shipped, ok := stencils.Registry().Default(retroengine.StencilName)
+	if !ok {
+		t.Fatalf("stencil %q is not registered", retroengine.StencilName)
+	}
+	file := stencilstore.Path(dir, retroengine.StencilName)
+	if err := os.MkdirAll(filepath.Dir(file), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, shipped, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	plan := retroengine.Plan{Slug: "retro-20261116-140000", From: at(9, 0, 0), Until: at(14, 0, 0),
+		Runs: []retroengine.Run{{Slug: "a", Landed: at(10, 0, 0)}, {Slug: "b", Landed: at(11, 0, 0)}}}
+
+	body, err := plan.Body(dir)
+	if err != nil {
+		t.Fatalf("Body() = _, %v; want nil error", err)
+	}
+	for _, want := range []string{
+		"- `a`, landed 2026-11-16T10:00:00Z\n- `b`, landed 2026-11-16T11:00:00Z",
+		"`tools/retro/retro.sh docs/research/retro/retro-20261116-140000 a b`",
+		"--runs a,b ",
+		"docs/research/retro/retro-20261116-140000/report.md",
+	} {
+		if !strings.Contains(body, want) {
+			t.Errorf("Body() does not contain %q:\n%s", want, body)
+		}
+	}
+	if strings.Contains(body, "{{") || strings.Contains(body, "<no value>") {
+		t.Errorf("Body() left a marker unfilled:\n%s", body)
+	}
+}
