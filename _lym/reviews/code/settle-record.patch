+}
diff --git a/internal/driftengine/expectation.go b/internal/driftengine/expectation.go
new file mode 100644
index 00000000..67004edf
--- /dev/null
+++ b/internal/driftengine/expectation.go
@@ -0,0 +1,396 @@
+// expectation.go — the sole parser of `_lym/drift/expected.yaml`, the expectation the expect agent writes, and the model that says which cells it covers.
+
+package driftengine
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Expectation is the changes the expect agent expects a task to make to the captures.
+// The zero Expectation is the empty expectation, which is valid and covers nothing.
+type Expectation struct {
+	// Cases maps a case name to what is expected of it.
+	Cases map[string]ExpectedCase
+	// Added lists the cases only the current capture is expected to hold.
+	Added []CaseEntry
+	// Removed lists the cases only the baseline capture is expected to hold.
+	Removed []CaseEntry
+}
+
+// ExpectedCase is what is expected of one case.
+// Under DiffLines it holds Keys and Lines and no Why; under DiffCommand it holds a Why and nothing else.
+type ExpectedCase struct {
+	// Keys are the keyed values expected to change.
+	Keys []KeyEntry
+	// Lines are the unkeyed line ranges expected to change.
+	Lines []LineEntry
+	// Why is why the case's compare is expected to differ, under DiffCommand only.
+	Why string
+}
+
+// KeyEntry expects a keyed value to change.
+type KeyEntry struct {
+	// Key is the key of the value.
+	Key string
+	// N is the occurrence of the key among the file's lines holding it, counted from 1; zero covers every occurrence.
+	N int
+	// Added marks a key the baseline does not hold, which the expectation expects the current capture to add.
+	Added bool
+	// Why is why the change is expected.
+	Why string
+}
+
+// LineEntry expects unkeyed lines to change.
+type LineEntry struct {
+	// Range is `12`, `12-20` or the open `12-`, positions among the file's unkeyed lines counted from 1.
+	Range string `yaml:"range"`
+	// Why is why the change is expected.
+	Why string `yaml:"why"`
+}
+
+// CaseEntry expects a whole case to appear or disappear.
+type CaseEntry struct {
+	// Case is the case's name.
+	Case string `yaml:"case"`
+	// Why is why the case is expected to appear or disappear.
+	Why string `yaml:"why"`
+}
+
+// Coverage is what covers a cell: the covering entry's why, and whether that entry is an open range.
+type Coverage struct {
+	Why  string
+	Open bool
+}
+
+// rawKeyEntry is a key entry as expected.yaml spells it; N is a pointer so an absent `n` reads apart from `n: 0`.
+type rawKeyEntry struct {
+	Key   string `yaml:"key"`
+	N     *int   `yaml:"n"`
+	Added bool   `yaml:"added"`
+	Why   string `yaml:"why"`
+}
+
+// rawCase is an expected case as expected.yaml spells it.
+type rawCase struct {
+	Keys  []rawKeyEntry `yaml:"keys"`
+	Lines []LineEntry   `yaml:"lines"`
+	Why   string        `yaml:"why"`
+}
+
+// rawExpectation is expected.yaml as it is spelled, before validation.
+type rawExpectation struct {
+	Cases   map[string]rawCase `yaml:"cases"`
+	Added   []CaseEntry        `yaml:"added"`
+	Removed []CaseEntry        `yaml:"removed"`
+}
+
+// lineRange is a parsed range of unkeyed line positions; an open range has no upper bound.
+type lineRange struct {
+	low, high int
+	open      bool
+}
+
+// parseLineRange parses `N`, `N-M` with 1 <= N <= M, or the open `N-`.
+func parseLineRange(text string) (lineRange, error) {
+	low, high, hasDash := strings.Cut(text, "-")
+	first, err := strconv.Atoi(low)
+	if err != nil || first < 1 {
+		return lineRange{}, fmt.Errorf("range %q is not N, N-M or N- with N at least 1", text)
+	}
+	switch {
+	case !hasDash:
+		return lineRange{low: first, high: first}, nil
+	case high == "":
+		return lineRange{low: first, open: true}, nil
+	}
+	last, err := strconv.Atoi(high)
+	if err != nil || last < first {
+		return lineRange{}, fmt.Errorf("range %q is not N, N-M or N- with N at most M", text)
+	}
+	return lineRange{low: first, high: last}, nil
+}
+
+// holds reports whether position lies in the range.
+func (r lineRange) holds(position int) bool {
+	return position >= r.low && (r.open || position <= r.high)
+}
+
+// ParseExpectation parses expected.yaml's bytes under mode, DiffLines or DiffCommand, against the baseline's case listings.
+// The file is agent-written, so an unknown key is refused.
+// An empty file and an empty document parse as the empty expectation.
+//
+// Under DiffLines it refuses a case in neither baseline nor `added`, a `removed` case absent from baseline, a key entry the case's baseline listing lacks unless it carries `added: true`, a range that is not `N`, `N-M` or `N-`, and a case-level `why`.
+// Under DiffCommand it refuses a `keys` or `lines` entry and checks no case name against baseline.
+// Under both it refuses a blank `why`, an `n` below 1 and an unknown key.
+// Each refusal names the entry and the rule.
+func ParseExpectation(data []byte, mode string, baseline []CaseListing) (Expectation, error) {
+	if mode != DiffLines && mode != DiffCommand {
+		return Expectation{}, fmt.Errorf("expected.yaml: mode %q is neither %q nor %q", mode, DiffLines, DiffCommand)
+	}
+	decoder := yaml.NewDecoder(bytes.NewReader(data))
+	decoder.KnownFields(true)
+	var raw rawExpectation
+	if err := decoder.Decode(&raw); err != nil && !errors.Is(err, io.EOF) {
+		return Expectation{}, fmt.Errorf("expected.yaml: %w", err)
+	}
+
+	listings := make(map[string]CaseListing, len(baseline))
+	for _, listing := range baseline {
+		listings[listing.Case] = listing
+	}
+	added, err := checkCaseEntries("added", raw.Added, nil)
+	if err != nil {
+		return Expectation{}, err
+	}
+	var removedAgainst map[string]CaseListing
+	if mode == DiffLines {
+		removedAgainst = listings
+	}
+	if _, err := checkCaseEntries("removed", raw.Removed, removedAgainst); err != nil {
+		return Expectation{}, err
+	}
+
+	expectation := Expectation{Added: raw.Added, Removed: raw.Removed}
+	names := make([]string, 0, len(raw.Cases))
+	for name := range raw.Cases {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		parsed, err := checkCase(name, raw.Cases[name], mode, listings, added)
+		if err != nil {
+			return Expectation{}, err
+		}
+		if expectation.Cases == nil {
+			expectation.Cases = map[string]ExpectedCase{}
+		}
+		expectation.Cases[name] = parsed
+	}
+	return expectation, nil
+}
+
+// checkCaseEntries checks each entry of an `added` or `removed` list, naming the list, and returns the case names it holds.
+// With against set, every named case must be one of its listings.
+func checkCaseEntries(list string, entries []CaseEntry, against map[string]CaseListing) (map[string]bool, error) {
+	names := make(map[string]bool, len(entries))
+	for _, entry := range entries {
+		if entry.Case == "" {
+			return nil, fmt.Errorf("expected.yaml: an entry under %q has no case", list)
+		}
+		if strings.TrimSpace(entry.Why) == "" {
+			return nil, fmt.Errorf("expected.yaml: %s case %q has an empty why", list, entry.Case)
+		}
+		if against != nil {
+			if _, inBaseline := against[entry.Case]; !inBaseline {
+				return nil, fmt.Errorf("expected.yaml: %s case %q is not a case of the baseline", list, entry.Case)
+			}
+		}
+		names[entry.Case] = true
+	}
+	return names, nil
+}
+
+// checkCase validates one expected case and returns it as the model.
+func checkCase(name string, raw rawCase, mode string, listings map[string]CaseListing, added map[string]bool) (ExpectedCase, error) {
+	if mode == DiffCommand {
+		if len(raw.Keys) > 0 || len(raw.Lines) > 0 {
+			return ExpectedCase{}, fmt.Errorf("expected.yaml: case %q holds keys or lines, which only diff %q takes; under diff %q a case holds one why", name, DiffLines, DiffCommand)
+		}
+		if strings.TrimSpace(raw.Why) == "" {
+			return ExpectedCase{}, fmt.Errorf("expected.yaml: case %q has an empty why", name)
+		}
+		return ExpectedCase{Why: raw.Why}, nil
+	}
+
+	listing, inBaseline := listings[name]
+	if !inBaseline && !added[name] {
+		return ExpectedCase{}, fmt.Errorf("expected.yaml: case %q is neither a case of the baseline nor listed under added", name)
+	}
+	if raw.Why != "" {
+		return ExpectedCase{}, fmt.Errorf("expected.yaml: case %q has a case-level why, which only diff %q takes; give each key and line entry its own", name, DiffCommand)
+	}
+
+	occurrences := map[string]int{}
+	for _, line := range listing.Lines {
+		if line.Identity.Key != "" {
+			occurrences[line.Identity.Key]++
+		}
+	}
+	parsed := ExpectedCase{}
+	for _, entry := range raw.Keys {
+		keyEntry, err := checkKeyEntry(name, entry, occurrences)
+		if err != nil {
+			return ExpectedCase{}, err
+		}
+		parsed.Keys = append(parsed.Keys, keyEntry)
+	}
+	for _, entry := range raw.Lines {
+		if _, err := parseLineRange(entry.Range); err != nil {
+			return ExpectedCase{}, fmt.Errorf("expected.yaml: case %q lines entry: %w", name, err)
+		}
+		if strings.TrimSpace(entry.Why) == "" {
+			return ExpectedCase{}, fmt.Errorf("expected.yaml: case %q lines entry %q has an empty why", name, entry.Range)
+		}
+		parsed.Lines = append(parsed.Lines, entry)
+	}
+	return parsed, nil
+}
+
+// checkKeyEntry validates one key entry of the named case against the occurrences of each key in the case's baseline listing.
+func checkKeyEntry(caseName string, entry rawKeyEntry, occurrences map[string]int) (KeyEntry, error) {
+	label := fmt.Sprintf("case %q keys entry %q", caseName, entry.Key)
+	if entry.Key == "" {
+		return KeyEntry{}, fmt.Errorf("expected.yaml: case %q has a keys entry with no key", caseName)
+	}
+	occurrence := 0
+	if entry.N != nil {
+		if *entry.N < 1 {
+			return KeyEntry{}, fmt.Errorf("expected.yaml: %s has n %d, which is below 1", label, *entry.N)
+		}
+		occurrence = *entry.N
+	}
+	if strings.TrimSpace(entry.Why) == "" {
+		return KeyEntry{}, fmt.Errorf("expected.yaml: %s has an empty why", label)
+	}
+	if !entry.Added && occurrences[entry.Key] < max(occurrence, 1) {
+		if occurrence > 0 && occurrences[entry.Key] > 0 {
+			return KeyEntry{}, fmt.Errorf("expected.yaml: %s names occurrence %d, but the baseline holds %d; mark it added: true if the current capture adds it", label, occurrence, occurrences[entry.Key])
+		}
+		return KeyEntry{}, fmt.Errorf("expected.yaml: %s is not a key of the baseline's case; mark it added: true if the current capture adds it", label)
+	}
+	return KeyEntry{Key: entry.Key, N: occurrence, Added: entry.Added, Why: entry.Why}, nil
+}
+
+// Merge returns the receiver's entries followed by more's, so containment reads the sealed file and every amendment as one expectation.
+// A case in both keeps the receiver's why when it has one.
+func (e Expectation) Merge(more Expectation) Expectation {
+	merged := Expectation{
+		Added:   append(append([]CaseEntry(nil), e.Added...), more.Added...),
+		Removed: append(append([]CaseEntry(nil), e.Removed...), more.Removed...),
+	}
+	if len(e.Cases)+len(more.Cases) > 0 {
+		merged.Cases = map[string]ExpectedCase{}
+	}
+	for _, source := range []map[string]ExpectedCase{e.Cases, more.Cases} {
+		for name, expected := range source {
+			into := merged.Cases[name]
+			into.Keys = append(into.Keys, expected.Keys...)
+			into.Lines = append(into.Lines, expected.Lines...)
+			if into.Why == "" {
+				into.Why = expected.Why
+			}
+			merged.Cases[name] = into
+		}
+	}
+	return merged
+}
+
+// coversKey reports whether a key entry of caseName covers the keyed cell.
+func coversKey(caseName string, entry KeyEntry, cell Cell) bool {
+	return cell.Case == caseName && cell.Identity.Key == entry.Key && (entry.N == 0 || entry.N == cell.Identity.N)
+}
+
+// coversLine reports whether a line entry of caseName covers the unkeyed cell; an entry whose range does not parse covers nothing.
+func coversLine(caseName string, entry LineEntry, cell Cell) (covers, open bool) {
+	if cell.Case != caseName || cell.Identity.Key != "" || cell.Identity.Line < 1 {
+		return false, false
+	}
+	span, err := parseLineRange(entry.Range)
+	if err != nil {
+		return false, false
+	}
+	return span.holds(cell.Identity.Line), span.open
+}
+
+// Cover returns the first entry that covers the cell, and false when none does.
+// An added case cell is covered by an `added` entry, a removed case cell by a `removed` entry, a keyed cell by a key entry of its case with its key and either no `n` or its occurrence, and an unkeyed cell by a line entry whose range holds its position.
+// A line entry never covers a keyed cell.
+func (e Expectation) Cover(c Cell) (Coverage, bool) {
+	switch c.Kind {
+	case CellAddedCase:
+		return coverCase(e.Added, c.Case)
+	case CellRemovedCase:
+		return coverCase(e.Removed, c.Case)
+	}
+	expected := e.Cases[c.Case]
+	if c.Identity.Key != "" {
+		for _, entry := range expected.Keys {
+			if coversKey(c.Case, entry, c) {
+				return Coverage{Why: entry.Why}, true
+			}
+		}
+		return Coverage{}, false
+	}
+	for _, entry := range expected.Lines {
+		if covers, open := coversLine(c.Case, entry, c); covers {
+			return Coverage{Why: entry.Why, Open: open}, true
+		}
+	}
+	return Coverage{}, false
+}
+
+// coverCase returns the first entry naming caseName.
+func coverCase(entries []CaseEntry, caseName string) (Coverage, bool) {
+	for _, entry := range entries {
+		if entry.Case == caseName {
+			return Coverage{Why: entry.Why}, true
+		}
+	}
+	return Coverage{}, false
+}
+
+// Uncovering names every entry that covers none of cells, as `added case "x"`, `removed case "x"`, `key "k" (n 2) of case "x"` or `lines 12-20 of case "x"`.
+// The names are in a fixed order: added, removed, then each case by name with its keys before its lines.
+func (e Expectation) Uncovering(cells []Cell) []string {
+	var uncovered []string
+	for _, entry := range e.Added {
+		if !anyCell(cells, func(cell Cell) bool { return cell.Kind == CellAddedCase && cell.Case == entry.Case }) {
+			uncovered = append(uncovered, fmt.Sprintf("added case %q", entry.Case))
+		}
+	}
+	for _, entry := range e.Removed {
+		if !anyCell(cells, func(cell Cell) bool { return cell.Kind == CellRemovedCase && cell.Case == entry.Case }) {
+			uncovered = append(uncovered, fmt.Sprintf("removed case %q", entry.Case))
+		}
+	}
+	names := make([]string, 0, len(e.Cases))
+	for name := range e.Cases {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		for _, entry := range e.Cases[name].Keys {
+			if !anyCell(cells, func(cell Cell) bool { return coversKey(name, entry, cell) }) {
+				label := fmt.Sprintf("key %q", entry.Key)
+				if entry.N > 0 {
+					label += fmt.Sprintf(" (n %d)", entry.N)
+				}
+				uncovered = append(uncovered, fmt.Sprintf("%s of case %q", label, name))
+			}
+		}
+		for _, entry := range e.Cases[name].Lines {
+			if !anyCell(cells, func(cell Cell) bool { covers, _ := coversLine(name, entry, cell); return covers }) {
+				uncovered = append(uncovered, fmt.Sprintf("lines %s of case %q", entry.Range, name))
+			}
+		}
+	}
+	return uncovered
+}
+
+// anyCell reports whether match holds for any of cells.
+func anyCell(cells []Cell, match func(Cell) bool) bool {
+	for _, cell := range cells {
+		if match(cell) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/driftengine/expectation_test.go b/internal/driftengine/expectation_test.go
new file mode 100644
index 00000000..c4d885ba
--- /dev/null
+++ b/internal/driftengine/expectation_test.go
@@ -0,0 +1,192 @@
+// expectation_test.go — tier 0 tests for the expectation parser and for which cells an expectation covers.
+
+package driftengine
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// expectationBaseline is a baseline with a keyed case holding `Test #3` twice and an unkeyed case.
+func expectationBaseline() []CaseListing {
+	return []CaseListing{
+		{Case: "keyed.txt", Lines: []ListedLine{
+			{Identity: Identity{Key: "Test #3", N: 1}},
+			{Identity: Identity{Key: "Test #3", N: 2}},
+			{Identity: Identity{Key: "other", N: 1}},
+		}},
+		{Case: "plain.txt", Lines: []ListedLine{{Identity: Identity{Line: 1}}, {Identity: Identity{Line: 2}}}},
+		{Case: "gone.txt"},
+	}
+}
+
+// TestParseExpectation covers the shapes both modes accept and each refusal, naming the rule it must state.
+func TestParseExpectation(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		mode    string
+		data    string
+		want    Expectation
+		wantErr string
+	}{
+		{name: "EmptyFile", mode: DiffLines, data: "", want: Expectation{}},
+		{name: "EmptyDocument", mode: DiffLines, data: "{}\n", want: Expectation{}},
+		{
+			name: "KeyWithAndWithoutN",
+			mode: DiffLines,
+			data: "cases:\n  keyed.txt:\n    keys:\n      - {key: 'Test #3', why: all moved}\n      - {key: 'Test #3', n: 2, why: second only}\n",
+			want: Expectation{Cases: map[string]ExpectedCase{"keyed.txt": {Keys: []KeyEntry{
+				{Key: "Test #3", Why: "all moved"},
+				{Key: "Test #3", N: 2, Why: "second only"},
+			}}}},
+		},
+		{
+			name: "ClosedAndOpenRanges",
+			mode: DiffLines,
+			data: "cases:\n  plain.txt:\n    lines:\n      - {range: '1', why: a}\n      - {range: 1-2, why: b}\n      - {range: 2-, why: c}\n",
+			want: Expectation{Cases: map[string]ExpectedCase{"plain.txt": {Lines: []LineEntry{
+				{Range: "1", Why: "a"}, {Range: "1-2", Why: "b"}, {Range: "2-", Why: "c"},
+			}}}},
+		},
+		{
+			name: "AddedKeyAddedCaseAndRemovedCase",
+			mode: DiffLines,
+			data: "added:\n  - {case: new.txt, why: new file}\nremoved:\n  - {case: gone.txt, why: dropped}\ncases:\n  new.txt:\n    keys:\n      - {key: fresh, added: true, why: new key}\n  keyed.txt:\n    keys:\n      - {key: extra, added: true, why: new key}\n",
+			want: Expectation{
+				Added:   []CaseEntry{{Case: "new.txt", Why: "new file"}},
+				Removed: []CaseEntry{{Case: "gone.txt", Why: "dropped"}},
+				Cases: map[string]ExpectedCase{
+					"new.txt":   {Keys: []KeyEntry{{Key: "fresh", Added: true, Why: "new key"}}},
+					"keyed.txt": {Keys: []KeyEntry{{Key: "extra", Added: true, Why: "new key"}}},
+				},
+			},
+		},
+		{name: "UnknownCase", mode: DiffLines, data: "cases:\n  nope.txt:\n    lines:\n      - {range: 1, why: a}\n", wantErr: `case "nope.txt" is neither a case of the baseline nor listed under added`},
+		{name: "RemovedCaseMissingFromBaseline", mode: DiffLines, data: "removed:\n  - {case: nope.txt, why: a}\n", wantErr: `removed case "nope.txt" is not a case of the baseline`},
+		{name: "UnknownKeyNotMarkedAdded", mode: DiffLines, data: "cases:\n  keyed.txt:\n    keys:\n      - {key: missing, why: a}\n", wantErr: `keys entry "missing" is not a key of the baseline's case`},
+		{name: "OccurrenceBeyondBaseline", mode: DiffLines, data: "cases:\n  keyed.txt:\n    keys:\n      - {key: other, n: 2, why: a}\n", wantErr: `names occurrence 2, but the baseline holds 1`},
+		{name: "MalformedRange", mode: DiffLines, data: "cases:\n  plain.txt:\n    lines:\n      - {range: 3-1, why: a}\n", wantErr: `range "3-1"`},
+		{name: "RangeBelowOne", mode: DiffLines, data: "cases:\n  plain.txt:\n    lines:\n      - {range: 0-2, why: a}\n", wantErr: `range "0-2"`},
+		{name: "EmptyWhy", mode: DiffLines, data: "cases:\n  plain.txt:\n    lines:\n      - {range: 1, why: '  '}\n", wantErr: "has an empty why"},
+		{name: "OccurrenceBelowOne", mode: DiffLines, data: "cases:\n  keyed.txt:\n    keys:\n      - {key: other, n: 0, why: a}\n", wantErr: "is below 1"},
+		{name: "CaseLevelWhyUnderLines", mode: DiffLines, data: "cases:\n  plain.txt:\n    why: whole file\n", wantErr: "case-level why"},
+		{name: "UnknownField", mode: DiffLines, data: "cases:\n  plain.txt:\n    lines:\n      - {range: 1, why: a, extra: b}\n", wantErr: "extra"},
+		{name: "UnknownTopLevelField", mode: DiffLines, data: "extra: 1\n", wantErr: "extra"},
+		{name: "CommandCaseAbsentFromBaseline", mode: DiffCommand, data: "cases:\n  anything:\n    why: compare differs\n", want: Expectation{Cases: map[string]ExpectedCase{"anything": {Why: "compare differs"}}}},
+		{name: "CommandKeysEntry", mode: DiffCommand, data: "cases:\n  anything:\n    keys:\n      - {key: k, why: a}\n", wantErr: "holds keys or lines"},
+		{name: "CommandLinesEntry", mode: DiffCommand, data: "cases:\n  anything:\n    lines:\n      - {range: 1, why: a}\n", wantErr: "holds keys or lines"},
+		{name: "CommandEmptyWhy", mode: DiffCommand, data: "cases:\n  anything:\n    why: ''\n", wantErr: "has an empty why"},
+		{name: "UnknownMode", mode: "other", data: "", wantErr: `mode "other"`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := ParseExpectation([]byte(tt.data), tt.mode, expectationBaseline())
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("ParseExpectation() error = %v; want it to contain %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("ParseExpectation() error = %v; want nil", err)
+			}
+			if diff := cmp.Diff(tt.want, got); diff != "" {
+				t.Errorf("ParseExpectation() mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+// TestExpectationCover covers which entry covers each kind of cell, the merge of an amendment and the entries that cover no cell.
+func TestExpectationCover(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	expectation := Expectation{
+		Added:   []CaseEntry{{Case: "new.txt", Why: "new file"}},
+		Removed: []CaseEntry{{Case: "gone.txt", Why: "dropped"}},
+		Cases: map[string]ExpectedCase{
+			"keyed.txt": {Keys: []KeyEntry{
+				{Key: "all", Why: "every occurrence"},
+				{Key: "second", N: 2, Why: "second only"},
+			}},
+			"plain.txt": {Lines: []LineEntry{
+				{Range: "2-3", Why: "closed"},
+				{Range: "10-", Why: "open"},
+			}},
+		},
+	}
+	keyed := func(key string, n int) Cell {
+		return Cell{Case: "keyed.txt", Identity: Identity{Key: key, N: n}, Kind: CellChanged}
+	}
+	unkeyed := func(line int) Cell {
+		return Cell{Case: "plain.txt", Identity: Identity{Line: line}, Kind: CellChanged}
+	}
+
+	tests := []struct {
+		name string
+		cell Cell
+		want Coverage
+		ok   bool
+	}{
+		{"KeyWithoutNCoversEveryOccurrence", keyed("all", 3), Coverage{Why: "every occurrence"}, true},
+		{"KeyWithNCoversThatOccurrence", keyed("second", 2), Coverage{Why: "second only"}, true},
+		{"KeyWithNSkipsOtherOccurrence", keyed("second", 1), Coverage{}, false},
+		{"LineInClosedRange", unkeyed(3), Coverage{Why: "closed"}, true},
+		{"LineOutsideRange", unkeyed(4), Coverage{}, false},
+		{"LineInOpenRange", unkeyed(500), Coverage{Why: "open", Open: true}, true},
+		{"LineEntryNeverCoversKeyedCell", Cell{Case: "plain.txt", Identity: Identity{Key: "k", N: 1}, Kind: CellChanged}, Coverage{}, false},
+		{"AddedCase", Cell{Case: "new.txt", Kind: CellAddedCase}, Coverage{Why: "new file"}, true},
+		{"RemovedCase", Cell{Case: "gone.txt", Kind: CellRemovedCase}, Coverage{Why: "dropped"}, true},
+		{"UnlistedAddedCase", Cell{Case: "other.txt", Kind: CellAddedCase}, Coverage{}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, ok := expectation.Cover(tt.cell)
+			if ok != tt.ok || got != tt.want {
+				t.Errorf("Cover(%+v) = %+v, %v; want %+v, %v", tt.cell, got, ok, tt.want, tt.ok)
+			}
+		})
+	}
+
+	t.Run("MergeLetsAnAmendmentCover", func(t *testing.T) {
+		t.Parallel()
+		cell := keyed("amended", 1)
+		if _, ok := expectation.Cover(cell); ok {
+			t.Fatalf("Cover(%+v) before the merge = true; want false", cell)
+		}
+		amendment := Expectation{Cases: map[string]ExpectedCase{"keyed.txt": {Keys: []KeyEntry{{Key: "amended", Why: "later"}}}}}
+		merged := expectation.Merge(amendment)
+		if got, ok := merged.Cover(cell); !ok || got.Why != "later" {
+			t.Errorf("merged Cover(%+v) = %+v, %v; want the amendment's entry", cell, got, ok)
+		}
+		if got, ok := merged.Cover(keyed("all", 1)); !ok || got.Why != "every occurrence" {
+			t.Errorf("merged Cover() lost the sealed entry: %+v, %v", got, ok)
+		}
+		if _, ok := expectation.Cover(cell); ok {
+			t.Errorf("Merge changed its receiver")
+		}
+	})
+
+	t.Run("UncoveringListsEntriesWithNoCell", func(t *testing.T) {
+		t.Parallel()
+		cells := []Cell{keyed("all", 1), unkeyed(2), {Case: "new.txt", Kind: CellAddedCase}}
+		want := []string{
+			`removed case "gone.txt"`,
+			`key "second" (n 2) of case "keyed.txt"`,
+			`lines 10- of case "plain.txt"`,
+		}
+		if diff := cmp.Diff(want, expectation.Uncovering(cells)); diff != "" {
+			t.Errorf("Uncovering() mismatch (-want +got):\n%s", diff)
+		}
+	})
+}
diff --git a/internal/driftengine/judge.go b/internal/driftengine/judge.go
new file mode 100644
index 00000000..5634638a
--- /dev/null
+++ b/internal/driftengine/judge.go
@@ -0,0 +1,212 @@
+// judge.go — the judge's seat table, the request Drift-Verify hands it and the `judgement` gate entry that checks what it writes.
+
+package driftengine
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// The judge's role and the stencil that opens it.
+const (
+	judgeRole        = "drift-judge"
+	judgeStencilName = "drift-template-judge"
+)
+
+// judgeTimeout is the judge session's timeout, since drift.yaml declares no timeout key.
+const judgeTimeout = 60 * time.Minute
+
+// judgeSkills are the skills the judge's spawn loads, in order.
+var judgeSkills = []string{"scribe:prose"}
+
+// The judge stencil's mode text, autonomous and with the operator in the pane.
+const (
+	autonomousJudgeMode = "No operator is present, so make best-judgment rulings and never block on a dialog."
+	operatorJudgeMode   = "The operator is present at your pane and decides each ruling: you present each cell or case, discuss it and record the operator's ruling.\n" +
+		"Ask in plain text in the pane and wait for the operator's typed reply; never call the `AskUserQuestion` tool, whose modal dialog the run cannot drive."
+)
+
+// judgeRequestLockName names the lock of the judge request file.
+const judgeRequestLockName = "judge-request.json"
+
+// JudgeIdentity names the line of a judged cell the way an Identity does, with the keys a reader of the request file expects.
+type JudgeIdentity struct {
+	Key  string `json:"key,omitempty"`
+	N    int    `json:"n,omitempty"`
+	Line int    `json:"line,omitempty"`
+}
+
+// JudgeCell is one cell the judge rules on.
+type JudgeCell struct {
+	// ID is the cell id the judgement must rule on.
+	ID       string        `json:"id"`
+	Case     string        `json:"case"`
+	Identity JudgeIdentity `json:"identity"`
+	Kind     CellKind      `json:"kind"`
+	Old      string        `json:"old"`
+	New      string        `json:"new"`
+	// Why is the covering expectation entry's why.
+	Why string `json:"why"`
+	// OpenRange reports that the covering entry is an open range.
+	OpenRange bool `json:"open_range,omitempty"`
+	// File is the absolute path of the case's file: in the current capture's scratch directory for an added case, in the baseline directory for a removed case, and empty for any other cell.
+	File string `json:"file,omitempty"`
+}
+
+// JudgeOpenRange is an open range of the expectation that covers a judged cell.
+type JudgeOpenRange struct {
+	Case string `json:"case"`
+	// Range is the range as the expectation spells it.
+	Range string `json:"range"`
+	// Why is the entry's why.
+	Why string `json:"why"`
+}
+
+// JudgeRequest is what one judge spawn is handed, written before the spawn.
+// Under DiffLines it holds Cells and OpenRanges, and under DiffCommand CompareLog.
+type JudgeRequest struct {
+	// SpawnID names the spawn; the judgement must carry it back.
+	SpawnID string `json:"spawn_id"`
+	// Mode is DiffLines or DiffCommand.
+	Mode string `json:"mode"`
+	// Cells are the cells the judge rules on, under DiffLines.
+	Cells []JudgeCell `json:"cells,omitempty"`
+	// OpenRanges are the open ranges covering a judged cell, under DiffLines.
+	OpenRanges []JudgeOpenRange `json:"open_ranges,omitempty"`
+	// CompareLog is the absolute path of the failing compare's log, under DiffCommand.
+	CompareLog string `json:"compare_log,omitempty"`
+	// Expectation is the sealed expectation as text.
+	Expectation string `json:"expectation"`
+	// Amendments are the parent's amendments as text, and empty when there is none.
+	Amendments string `json:"amendments,omitempty"`
+}
+
+// WriteJudgeRequest writes the judge request to p's request file through internal/state.
+func WriteJudgeRequest(p Paths, req JudgeRequest) error {
+	lock, err := recordLock(p, judgeRequestLockName)
+	if err != nil {
+		return err
+	}
+	if err := state.WriteJSON(p.JudgeRequest, lock, req); err != nil {
+		return fmt.Errorf("drift: write the judge request: %w", err)
+	}
+	return nil
+}
+
+// readJudgeRequest reads the judge request, answering found false when none was written.
+func readJudgeRequest(p Paths) (JudgeRequest, bool, error) {
+	lock, err := recordLock(p, judgeRequestLockName)
+	if err != nil {
+		return JudgeRequest{}, false, err
+	}
+	req, found, err := state.ReadJSON[JudgeRequest](p.JudgeRequest, lock)
+	if err != nil {
+		return JudgeRequest{}, false, fmt.Errorf("drift: read the judge request: %w", err)
+	}
+	return req, found, nil
+}
+
+// want returns what the judgement must answer in full: every cell and open range of the request.
+func (r JudgeRequest) want() JudgementWant {
+	want := JudgementWant{Mode: r.Mode, SpawnID: r.SpawnID, CompareFailed: r.CompareLog != ""}
+	for _, cell := range r.Cells {
+		want.CellIDs = append(want.CellIDs, cell.ID)
+	}
+	for _, open := range r.OpenRanges {
+		want.OpenRanges = append(want.OpenRanges, OpenRangeNote{Case: open.Case, Range: open.Range})
+	}
+	return want
+}
+
+// JudgeInputs are the told values one judge spawn is composed from.
+type JudgeInputs struct {
+	// Subject is SubjectDecisionRecord or SubjectBoardEntry.
+	Subject string
+	// Slug is the board entry's slug; required for SubjectBoardEntry.
+	Slug string
+	// DecisionRecordPath is the absolute path of the task's decision record.
+	DecisionRecordPath string
+	// RequestPath is the absolute path of the judge request file.
+	RequestPath string
+	// JudgementPath is the absolute path the judge writes judgement.yaml to.
+	JudgementPath string
+}
+
+// JudgeTable builds the seatengine.Table of one judge spawn: one lead on the review segment whose only output is judgement.yaml.
+// An empty required field of in is refused by name, and cfg.JudgeModel is resolved against reg.
+// With cfg.JudgeInteractive the lead is interactive, and its prompt has it present each cell or case to the operator and record the operator's ruling.
+// The judge changes nothing but its output, so the table carries no PATTERN directive, and it carries no gate; the producer sets it.
+func JudgeTable(in JudgeInputs, cfg Config, reg modelspec.Registry) (seatengine.Table, error) {
+	err := requireTold("JudgeTable", []struct{ field, value string }{
+		{"DecisionRecordPath", in.DecisionRecordPath},
+		{"RequestPath", in.RequestPath},
+		{"JudgementPath", in.JudgementPath},
+	})
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+	reading, err := subjectFields{in.Subject, in.Slug, in.DecisionRecordPath}.reading()
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("drift: JudgeTable: %w", err)
+	}
+	choice, err := resolveModel("JudgeTable", cfg.JudgeModel, reg)
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+	mode := autonomousJudgeMode
+	if cfg.JudgeInteractive {
+		mode = operatorJudgeMode
+	}
+
+	return seatengine.Table{
+		RolePrefix:  judgeRole,
+		Segment:     segmentcolor.Review,
+		Timeout:     judgeTimeout,
+		Interactive: cfg.JudgeInteractive,
+		Values: map[string]string{
+			"mode_rules":      mode,
+			"subject_reading": reading,
+			"request_path":    in.RequestPath,
+			"judgement_path":  in.JudgementPath,
+		},
+		Seats: []seatengine.Seat{{
+			Stencil:     judgeStencilName,
+			ModelChoice: choice,
+			Outputs:     []string{in.JudgementPath},
+			Skills:      append([]string(nil), judgeSkills...),
+		}},
+	}, nil
+}
+
+// NewJudgementGate returns the gate of the `judgement` entry of the judge's table.
+// It reads the judge request and parses judgement.yaml with ParseJudgement against the JudgementWant the request implies.
+// A parse failure fails the gate with the parser's message, which re-prompts the judge.
+// A missing file fails the gate asking for it.
+func NewJudgementGate(d Deps) shuttleengine.Gate {
+	return func() (shuttleengine.GateResult, error) {
+		request, found, err := readJudgeRequest(d.Paths)
+		if err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("drift: the judgement gate: %w", err)
+		}
+		if !found {
+			return shuttleengine.GateResult{}, fmt.Errorf("drift: the judgement gate: no judge request at %s", d.Paths.JudgeRequest)
+		}
+		data, present, err := readRecordFile(d.Paths.Judgement)
+		if err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("drift: the judgement gate: %w", err)
+		}
+		if !present {
+			return shuttleengine.GateResult{Findings: fmt.Sprintf("judgement.yaml is missing; write the rulings to %s and end your turn again.", d.Paths.Judgement)}, nil
+		}
+		if _, err := ParseJudgement(data, request.want()); err != nil {
+			return shuttleengine.GateResult{Findings: err.Error() + "\nCorrect judgement.yaml and end your turn again."}, nil
+		}
+		return shuttleengine.GateResult{Passed: true}, nil
+	}
+}
