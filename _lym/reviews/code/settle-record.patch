 // IsLoom, HasEngine, RecordEngine, VerifySource and RetiredRows answer a recipe's contract, engines, record engine, verify source and retired rows by recipe name, so a consumer reads the recipe's rows and keys instead of comparing its name.
 // An empty recipe name reads as the tapestry recipe, and a name that selects no embedded recipe is refused.
 //
+// GateFixerSetting answers which setting a writer row's gate element names for its cold fixer's model-spec, so a caller reads whether a row's fixer is on from the recipe's own `fixer` key rather than from a row name.
+//
 // CodePerchGate answers the entry gate of a recipe's Code-Review Bouncer row, built over a told Env, and nil for a recipe whose perch carries none (tapestry, darn, pawl):
 // a reader of whether the perch is off follows that gate as well as the budget.
 //
diff --git a/internal/loomrecipe/recipekeys.go b/internal/loomrecipe/recipekeys.go
index 5e1d913e..0b6a7985 100644
--- a/internal/loomrecipe/recipekeys.go
+++ b/internal/loomrecipe/recipekeys.go
@@ -4,6 +4,7 @@
 package loomrecipe
 
 import (
+	"fmt"
 	"slices"
 
 	"github.com/Knatte18/loomyard/internal/loomshed"
@@ -72,6 +73,40 @@ func EngineRow(recipe, engine string) (string, bool, error) {
 	return "", false, nil
 }
 
+// GateFixerSetting returns the `fixer` value of the gate element named gate on the first row of the named recipe that runs engine: the `<module>.<key>` setting that holds the row's cold fixer model-spec.
+// It is empty when the row has no such element or the element carries no `fixer`.
+// An empty recipe name reads as the tapestry recipe; a name that selects no embedded recipe, a recipe with no row running engine, and a `fixer` that is not a string are refused.
+func GateFixerSetting(recipe, engine, gate string) (string, error) {
+	parsed, err := parseEmbeddedRecipe(recipe)
+	if err != nil {
+		return "", err
+	}
+	for _, row := range parsed.Producers {
+		if row.Engine != engine {
+			continue
+		}
+		elements, _ := row.Config["gates"].([]any)
+		for _, element := range elements {
+			fields, _ := element.(map[string]any)
+			if fields["name"] != gate {
+				continue
+			}
+			value, present := fields["fixer"]
+			if !present {
+				return "", nil
+			}
+			setting, isString := value.(string)
+			if !isString {
+				return "", fmt.Errorf("loomrecipe: the %s recipe's %s row names a gate fixer on element %q that is %v, not a setting string", recipe, row.Name, gate, value)
+			}
+			return setting, nil
+		}
+		return "", nil
+	}
+
+	return "", fmt.Errorf("loomrecipe: the %s recipe has no row running the %s engine", recipe, engine)
+}
+
 // CodePerchGate returns the entry gate of the named recipe's Code-Review segment Bouncer row, built over env.
 // It is nil for a recipe with no such row and for a Bouncer row with no entry_gate, which leaves the perch's on or off to its budget alone.
 // An empty recipe name reads as the tapestry recipe, and a name that selects no embedded recipe is refused.
