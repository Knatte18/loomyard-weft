-	if err == nil {
-		guards, err = impactset.FindGuardTests(root, []string{dir})
-	}
-	switch {
-	case impactset.IsGuardScanError(err):
-		entry.label = "miss: " + err.Error()
-		return entry
-	case err != nil:
-		entry.label = "miss: " + testcover.Miss{Reason: testcover.MissParse, Detail: err.Error()}.String()
-		return entry
