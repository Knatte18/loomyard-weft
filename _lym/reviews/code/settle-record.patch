+func TestHubHoldCheckDeps_FilledSeamsNameTheRerun(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+	boardkit.InstallReplay(t)
+
+	const rerun = "lym adopt b root"
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
