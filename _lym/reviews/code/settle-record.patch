+	"github.com/Knatte18/loomyard/internal/shedrecipe"
+)
+
+// Expand inlines the sub-recipe of every block row of r and returns the resulting Recipe; r itself is never mutated.
+// resolve maps a recipe name to its bytes, and each sub-recipe is parsed through Parse and expanded in turn, so a block may hold blocks.
+// A recipe with no block row is returned as it is, whatever resolve is.
+//
+// A block row is emitted with engine shedrecipe.EngineBlock, on_done the sub-recipe's entry and SkipTo the block's exit, followed by the sub-recipe's rows under their own names.
+// The block's exit is the row's on_done as its recipe file sets it, or, when that is empty, the exit of the block enclosing it.
+// An inlined row's empty on_done, and an inlined block row's empty skip target, become the exit of the innermost block enclosing the row.
+// Each inlined row's BlockPath is the names of the block rows enclosing it, outermost first, joined by "/".
+// A sub-recipe's terminals are not read; the parent's stay the run's.
+//
+// Every refusal names the block row and a way forward: a recipe the resolver cannot give, a nil resolver, a recipe that includes itself, a row name or segment an inlined row shares with a row outside its block, an inlined edge naming no row of its recipe, an outermost block row with no on_done, an on_done inside the block, and a sub-recipe setting a key that belongs to the run.
+func Expand(r Recipe, resolve func(name string) ([]byte, error)) (Recipe, error) {
+	if !slices.ContainsFunc(r.Producers, func(row Row) bool { return row.Block != "" }) {
+		return r, nil
+	}
+
+	e := &expander{
+		resolve:  resolve,
+		names:    make(map[string]bool, len(r.Producers)),
+		segments: make(map[string]bool),
+	}
+	e.register(r.Producers)
+
+	rows, err := e.expandRows(r.Producers, "", "", nil)
+	if err != nil {
+		return Recipe{}, err
+	}
+	r.Producers = rows
+	return r, nil
+}
+
+// expander carries the told resolver and the row names and segments of every row seen outside the block being inlined.
+type expander struct {
+	resolve  func(name string) ([]byte, error)
+	names    map[string]bool
+	segments map[string]bool
+}
+
+// register records the names and non-empty segments of rows as rows outside every block inlined after them.
+func (e *expander) register(rows []Row) {
+	for _, row := range rows {
+		e.names[row.Name] = true
+		if row.Segment != "" {
+			e.segments[row.Segment] = true
+		}
+	}
+}
+
+// expandRows returns rows with every block row replaced by its block row and inlined rows.
+// exit is the exit of the innermost enclosing block, empty at the top level; path is the block path of rows, and chain the names of the recipes entered to reach them.
+func (e *expander) expandRows(rows []Row, exit, path string, chain []string) ([]Row, error) {
+	out := make([]Row, 0, len(rows))
+	for _, row := range rows {
+		if row.Block == "" {
+			if exit != "" && row.OnDone == "" {
+				row.OnDone = exit
+			}
+			row.BlockPath = path
+			out = append(out, row)
+			continue
+		}
+
+		blockExit := row.OnDone
+		if blockExit == "" {
+			if exit == "" {
+				return nil, blockError(row, "on_done is empty; way forward: set on_done to the row the run takes after the block")
+			}
+			blockExit = exit
+		}
+		inlined, entry, err := e.inline(row, blockExit, path, chain)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, Row{
+			Name:      row.Name,
+			Engine:    shedrecipe.EngineBlock,
+			OnDone:    entry,
+			SkipTo:    blockExit,
+			Block:     row.Block,
+			BlockGate: row.BlockGate,
+			BlockPath: path,
+		})
+		out = append(out, inlined...)
+	}
+	return out, nil
+}
+
+// inline resolves, parses and expands the recipe block names, returning its rows ready to follow the block row and the recipe's entry.
+// exit is the block's exit, path the block path of the block row, and chain the names of the recipes entered to reach it.
+func (e *expander) inline(block Row, exit, path string, chain []string) (rows []Row, entry string, err error) {
+	if at := slices.Index(chain, block.Block); at >= 0 {
+		loop := append(slices.Clone(chain[at:]), block.Block)
+		return nil, "", blockError(block, "recipe %q includes itself through %s; way forward: remove the block that closes the cycle", block.Block, strings.Join(loop, " -> "))
+	}
+	if e.resolve == nil {
+		return nil, "", blockError(block, "no recipe resolver is told; way forward: expand the recipe through a caller that tells the resolver of its embedded recipes")
+	}
+	data, err := e.resolve(block.Block)
+	if err != nil {
+		return nil, "", blockError(block, "recipe %q: %w; way forward: set block to an embedded recipe's name", block.Block, err)
+	}
+	sub, err := Parse(data)
+	if err != nil {
+		return nil, "", blockError(block, "recipe %q: %w; way forward: set block to an embedded recipe's name", block.Block, err)
+	}
+
+	for _, key := range []struct {
+		name string
+		set  bool
+	}{
+		{"contract", sub.Contract != ""},
+		{"verify_source", sub.VerifySource != ""},
+		{"amendment_target", sub.AmendmentTarget != ""},
+		{"profile_recipe", sub.ProfileRecipe != ""},
+	} {
+		if key.set {
+			return nil, "", blockError(block, "recipe %q sets %s, which belongs to the run; way forward: remove %s from the block's recipe", block.Block, key.name, key.name)
+		}
+	}
+
+	own := make(map[string]bool, len(sub.Producers))
+	for _, row := range sub.Producers {
+		own[row.Name] = true
+	}
+	for _, row := range sub.Producers {
+		for _, edge := range []struct{ key, target string }{{"on_done", row.OnDone}, {"on_stuck", row.OnStuck}, {"on_reroute", row.OnReroute}} {
+			if edge.target != "" && !own[edge.target] {
+				return nil, "", blockError(block, "row %q of recipe %q sets %s %q, which names no row of that recipe; way forward: route the row inside its recipe, or leave on_done empty to reach the block's exit", row.Name, block.Block, edge.key, edge.target)
+			}
+		}
+	}
+	for _, row := range sub.Producers {
+		if e.names[row.Name] {
+			return nil, "", blockError(block, "row %q of recipe %q is also a row outside the block; way forward: rename one of the two rows, or use the recipe in one block only", row.Name, block.Block)
+		}
+	}
+	for _, row := range sub.Producers {
+		if row.Segment != "" && e.segments[row.Segment] {
+			return nil, "", blockError(block, "segment %q of row %q is also used outside the block; way forward: give the block's rows a segment of their own", row.Segment, row.Name)
+		}
+	}
+	e.register(sub.Producers)
+
+	blockPath := block.Name
+	if path != "" {
+		blockPath = path + "/" + block.Name
+	}
+	rows, err = e.expandRows(sub.Producers, exit, blockPath, append(slices.Clone(chain), block.Block))
+	if err != nil {
+		return nil, "", err
+	}
+
+	if block.OnDone != "" {
+		inside := block.OnDone == block.Name
+		for _, row := range rows {
+			inside = inside || row.Name == block.OnDone
+		}
+		if inside {
+			return nil, "", blockError(block, "on_done %q lies inside the block; way forward: set on_done to a row outside the block", block.OnDone)
+		}
+	}
+	return rows, sub.Entry, nil
+}
+
+// blockError returns a refusal prefixed with the block row's name, formatting the case and its way forward from format and args.
+func blockError(block Row, format string, args ...any) error {
+	return fmt.Errorf("shedbuild: block %q: "+format, append([]any{block.Name}, args...)...)
+}
diff --git a/internal/shedbuild/expand_test.go b/internal/shedbuild/expand_test.go
new file mode 100644
index 00000000..bc8c0397
--- /dev/null
+++ b/internal/shedbuild/expand_test.go
@@ -0,0 +1,310 @@
+// expand_test.go covers Expand over a map resolver of YAML sources built from Stub rows: the shape an expansion yields and each refusal it makes.
+
+package shedbuild
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// stubRowYAML returns a producers-list item for a Stub row, with each key a "key: value" line of the row.
+func stubRowYAML(name string, keys ...string) string {
+	return rowYAML(name, append([]string{"engine: Stub"}, keys...))
+}
+
+// blockRowForExpand returns a producers-list item for a block row running recipe behind the always check, with each key a "key: value" line of the row.
+func blockRowForExpand(name, recipe string, keys ...string) string {
+	return rowYAML(name, append([]string{"block: " + recipe, "block_gate: always"}, keys...))
+}
+
+func rowYAML(name string, lines []string) string {
+	row := "  - name: " + name + "\n"
+	for _, line := range lines {
+		row += "    " + line + "\n"
+	}
+	return row
+}
+
+// recipeYAML returns a recipe document whose entry is entry and whose rows are rows.
+func recipeYAML(entry string, rows ...string) string {
+	return "version: 1\nentry: " + entry + "\nterminals: [Post]\nproducers:\n" + strings.Join(rows, "")
+}
+
+// mapResolver resolves a recipe name against sources and refuses any other name.
+func mapResolver(sources map[string]string) func(string) ([]byte, error) {
+	return func(name string) ([]byte, error) {
+		source, ok := sources[name]
+		if !ok {
+			return nil, fmt.Errorf("no recipe named %q", name)
+		}
+		return []byte(source), nil
+	}
+}
+
+// parentYAML is a parent recipe with one block row, Blk, running recipe sub between Pre and Post.
+func parentYAML(blockKeys ...string) string {
+	return recipeYAML("Pre",
+		stubRowYAML("Pre", "on_done: Blk"),
+		blockRowForExpand("Blk", "sub", blockKeys...),
+		stubRowYAML("Post"),
+	)
+}
+
+func TestExpand(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	subRows := []string{stubRowYAML("S1", "on_done: S2", "segment: seg"), stubRowYAML("S2")}
+	sub := recipeYAML("S1", subRows...)
+
+	t.Run("shape", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name    string
+			parent  string
+			sources map[string]string
+			want    []Row
+		}{
+			{
+				name:    "one block yields the block row then the sub-recipe's rows under their own names with every empty on_done set to the exit",
+				parent:  parentYAML("on_done: Post"),
+				sources: map[string]string{"sub": sub},
+				want: []Row{
+					{Name: "Pre", Engine: "Stub", OnDone: "Blk"},
+					{Name: "Blk", Engine: "Block", OnDone: "S1", SkipTo: "Post", Block: "sub", BlockGate: "always"},
+					{Name: "S1", Engine: "Stub", OnDone: "S2", Segment: "seg", BlockPath: "Blk"},
+					{Name: "S2", Engine: "Stub", OnDone: "Post", BlockPath: "Blk"},
+					{Name: "Post", Engine: "Stub"},
+				},
+			},
+			{
+				name:   "a block inside a block carries the joined path, takes its innermost exit and an empty on_done inherits the outer exit as its skip target",
+				parent: parentYAML("on_done: Post"),
+				sources: map[string]string{
+					"sub": recipeYAML("O1",
+						stubRowYAML("O1", "on_done: Inner"),
+						blockRowForExpand("Inner", "inner"),
+						stubRowYAML("O2"),
+					),
+					"inner": recipeYAML("I1", stubRowYAML("I1")),
+				},
+				want: []Row{
+					{Name: "Pre", Engine: "Stub", OnDone: "Blk"},
+					{Name: "Blk", Engine: "Block", OnDone: "O1", SkipTo: "Post", Block: "sub", BlockGate: "always"},
+					{Name: "O1", Engine: "Stub", OnDone: "Inner", BlockPath: "Blk"},
+					{Name: "Inner", Engine: "Block", OnDone: "I1", SkipTo: "Post", Block: "inner", BlockGate: "always", BlockPath: "Blk"},
+					{Name: "I1", Engine: "Stub", OnDone: "Post", BlockPath: "Blk/Inner"},
+					{Name: "O2", Engine: "Stub", OnDone: "Post", BlockPath: "Blk"},
+					{Name: "Post", Engine: "Stub"},
+				},
+			},
+			{
+				name:   "an inner block with an on_done of its own exits there",
+				parent: parentYAML("on_done: Post"),
+				sources: map[string]string{
+					"sub": recipeYAML("O1",
+						stubRowYAML("O1", "on_done: Inner"),
+						blockRowForExpand("Inner", "inner", "on_done: O2"),
+						stubRowYAML("O2"),
+					),
+					"inner": recipeYAML("I1", stubRowYAML("I1")),
+				},
+				want: []Row{
+					{Name: "Pre", Engine: "Stub", OnDone: "Blk"},
+					{Name: "Blk", Engine: "Block", OnDone: "O1", SkipTo: "Post", Block: "sub", BlockGate: "always"},
+					{Name: "O1", Engine: "Stub", OnDone: "Inner", BlockPath: "Blk"},
+					{Name: "Inner", Engine: "Block", OnDone: "I1", SkipTo: "O2", Block: "inner", BlockGate: "always", BlockPath: "Blk"},
+					{Name: "I1", Engine: "Stub", OnDone: "O2", BlockPath: "Blk/Inner"},
+					{Name: "O2", Engine: "Stub", OnDone: "Post", BlockPath: "Blk"},
+					{Name: "Post", Engine: "Stub"},
+				},
+			},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				parent, err := Parse([]byte(tt.parent))
+				if err != nil {
+					t.Fatalf("Parse(parent) = _, %v; want nil", err)
+				}
+				before, _ := Parse([]byte(tt.parent))
+
+				got, err := Expand(parent, mapResolver(tt.sources))
+				if err != nil {
+					t.Fatalf("Expand(...) = _, %v; want nil", err)
+				}
+				if !reflect.DeepEqual(got.Producers, tt.want) {
+					t.Errorf("Expand(...).Producers mismatch:\n got  %+v\n want %+v", got.Producers, tt.want)
+				}
+				if !reflect.DeepEqual(parent, before) {
+					t.Errorf("Expand mutated its argument: %+v; want %+v", parent, before)
+				}
+			})
+		}
+	})
+
+	t.Run("the parent's terminals stay the run's whatever the sub-recipe's terminals name", func(t *testing.T) {
+		t.Parallel()
+		parent, err := Parse([]byte(parentYAML("on_done: Post")))
+		if err != nil {
+			t.Fatalf("Parse(parent) = _, %v; want nil", err)
+		}
+		foreign := strings.Replace(sub, "terminals: [Post]", "terminals: [NotMine]", 1)
+		got, err := Expand(parent, mapResolver(map[string]string{"sub": foreign}))
+		if err != nil {
+			t.Fatalf("Expand(...) = _, %v; want nil", err)
+		}
+		if !reflect.DeepEqual(got.Terminals, []string{"Post"}) {
+			t.Errorf("Expand(...).Terminals = %v; want the parent's [Post]", got.Terminals)
+		}
+	})
+
+	t.Run("a recipe with no block is returned unchanged with a nil resolver", func(t *testing.T) {
+		t.Parallel()
+		plain, err := Parse([]byte(sub))
+		if err != nil {
+			t.Fatalf("Parse(sub) = _, %v; want nil", err)
+		}
+		got, err := Expand(plain, nil)
+		if err != nil || !reflect.DeepEqual(got, plain) {
+			t.Errorf("Expand(plain, nil) = %+v, %v; want the recipe unchanged and nil", got, err)
+		}
+	})
+
+	withKey := func(source, key string) string {
+		return strings.Replace(source, "producers:\n", key+"\nproducers:\n", 1)
+	}
+	refusals := []struct {
+		name       string
+		parent     string
+		sources    map[string]string
+		noResolver bool
+		want       string
+	}{
+		{
+			name:    "the resolver refusing the recipe",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{},
+			want:    `shedbuild: block "Blk": recipe "sub": no recipe named "sub"; way forward: set block to an embedded recipe's name`,
+		},
+		{
+			name:       "a nil resolver",
+			parent:     parentYAML("on_done: Post"),
+			noResolver: true,
+			want:       `shedbuild: block "Blk": no recipe resolver is told; way forward: expand the recipe through a caller that tells the resolver of its embedded recipes`,
+		},
+		{
+			name:   "a block naming its own recipe",
+			parent: parentYAML("on_done: Post"),
+			sources: map[string]string{
+				"sub": recipeYAML("S1", stubRowYAML("S1"), blockRowForExpand("Again", "sub", "on_done: S1")),
+			},
+			want: `shedbuild: block "Again": recipe "sub" includes itself through sub -> sub; way forward: remove the block that closes the cycle`,
+		},
+		{
+			name:   "a block reaching its own recipe through an inner block",
+			parent: parentYAML("on_done: Post"),
+			sources: map[string]string{
+				"sub": recipeYAML("S1", stubRowYAML("S1"), blockRowForExpand("ToB", "b", "on_done: S1")),
+				"b":   recipeYAML("B1", stubRowYAML("B1"), blockRowForExpand("ToSub", "sub", "on_done: B1")),
+			},
+			want: `shedbuild: block "ToSub": recipe "sub" includes itself through sub -> b -> sub; way forward: remove the block that closes the cycle`,
+		},
+		{
+			name:    "an inlined row named like a row outside the block",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": recipeYAML("Pre", stubRowYAML("Pre"))},
+			want:    `shedbuild: block "Blk": row "Pre" of recipe "sub" is also a row outside the block; way forward: rename one of the two rows, or use the recipe in one block only`,
+		},
+		{
+			name: "an inlined segment used outside the block",
+			parent: recipeYAML("Pre",
+				stubRowYAML("Pre", "on_done: Blk", "segment: seg"),
+				blockRowForExpand("Blk", "sub", "on_done: Post"),
+				stubRowYAML("Post"),
+			),
+			sources: map[string]string{"sub": sub},
+			want:    `shedbuild: block "Blk": segment "seg" of row "S1" is also used outside the block; way forward: give the block's rows a segment of their own`,
+		},
+		{
+			name:    "an inlined on_done naming no row of its recipe",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": recipeYAML("S1", stubRowYAML("S1", "on_done: Ghost"))},
+			want:    `shedbuild: block "Blk": row "S1" of recipe "sub" sets on_done "Ghost", which names no row of that recipe; way forward: route the row inside its recipe, or leave on_done empty to reach the block's exit`,
+		},
+		{
+			name:    "an inlined on_stuck naming no row of its recipe",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": recipeYAML("S1", stubRowYAML("S1", "on_stuck: Ghost"))},
+			want:    `row "S1" of recipe "sub" sets on_stuck "Ghost", which names no row of that recipe`,
+		},
+		{
+			name:    "an inlined on_reroute naming no row of its recipe",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": recipeYAML("S1", stubRowYAML("S1", "on_reroute: Ghost"))},
+			want:    `row "S1" of recipe "sub" sets on_reroute "Ghost", which names no row of that recipe`,
+		},
+		{
+			name:    "an outermost block row with an empty on_done",
+			parent:  parentYAML(),
+			sources: map[string]string{"sub": sub},
+			want:    `shedbuild: block "Blk": on_done is empty; way forward: set on_done to the row the run takes after the block`,
+		},
+		{
+			name:    "an on_done naming the block row itself",
+			parent:  parentYAML("on_done: Blk"),
+			sources: map[string]string{"sub": sub},
+			want:    `shedbuild: block "Blk": on_done "Blk" lies inside the block; way forward: set on_done to a row outside the block`,
+		},
+		{
+			name:    "an on_done naming an inlined row",
+			parent:  parentYAML("on_done: S2"),
+			sources: map[string]string{"sub": sub},
+			want:    `shedbuild: block "Blk": on_done "S2" lies inside the block; way forward: set on_done to a row outside the block`,
+		},
+		{
+			name:    "a sub-recipe setting contract",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": withKey(sub, "contract: loom")},
+			want:    `shedbuild: block "Blk": recipe "sub" sets contract, which belongs to the run; way forward: remove contract from the block's recipe`,
+		},
+		{
+			name:    "a sub-recipe setting verify_source",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": withKey(sub, "verify_source: plan")},
+			want:    `recipe "sub" sets verify_source, which belongs to the run; way forward: remove verify_source from the block's recipe`,
+		},
+		{
+			name:    "a sub-recipe setting amendment_target",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": withKey(sub, "amendment_target: S1")},
+			want:    `recipe "sub" sets amendment_target, which belongs to the run; way forward: remove amendment_target from the block's recipe`,
+		},
+		{
+			name:    "a sub-recipe setting profile_recipe",
+			parent:  parentYAML("on_done: Post"),
+			sources: map[string]string{"sub": withKey(sub, "profile_recipe: sub")},
+			want:    `recipe "sub" sets profile_recipe, which belongs to the run; way forward: remove profile_recipe from the block's recipe`,
+		},
+	}
+	for _, tt := range refusals {
+		t.Run("refuses "+tt.name, func(t *testing.T) {
+			t.Parallel()
+			parent, err := Parse([]byte(tt.parent))
+			if err != nil {
+				t.Fatalf("Parse(parent) = _, %v; want nil", err)
+			}
+			resolve := mapResolver(tt.sources)
+			if tt.noResolver {
+				resolve = nil
+			}
+			if _, err := Expand(parent, resolve); err == nil || !strings.Contains(err.Error(), tt.want) {
+				t.Errorf("Expand(...) error = %v; want it to contain %q", err, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/shedbuild/newshed.go b/internal/shedbuild/newshed.go
index 6842184f..7f8a56e3 100644
--- a/internal/shedbuild/newshed.go
+++ b/internal/shedbuild/newshed.go
@@ -62,6 +62,9 @@ type ShedPaths struct {
 // Each of NewShed's two callers wraps a non-nil returned error with its own single package prefix,
 // so NewShed must not add a second one on top.
 //
+// NewShed builds the recipe without expanding it, so a recipe holding a block row is refused:
+// it goes through Expand and then NewShedFrom.
+//
 // NewShed never calls Check -- internal/shedcheck/doc.go and internal/shedbuild/check.go both state
 // that Check is authoring-time only, because a resumed run legitimately starts mid-graph and
