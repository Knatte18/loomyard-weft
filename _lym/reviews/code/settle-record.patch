+func TestDescribeCmd_DraftFlagReachesTheDraftSeam(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		args         []string
+		wantDrafted  bool
+		wantRecorded bool
