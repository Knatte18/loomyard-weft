+  "## Tapestry runs\n",
+  table(["Run", "Start", "Period", "Class", "Lines", "Active", "Setup", "Discussion", "Plan", "Webster", "Merge", "Publish and Finalize", "Land", "Waits", "Sleep", "Gate wall"];
+    $tap | sort_by(.start)
+    | map((if .slug == "cold-gate-fixer" then "excluded: no Discussion or Plan"
