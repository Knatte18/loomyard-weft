+func (c processCap) countable(pids []int) []int {
+	if c.commands == nil {
+		return pids
+	}
+	tree, err := c.sample(c.root)
+	if err != nil {
+		return pids
+	}
+	parents := make(map[int]int, len(tree))
+	for _, process := range tree {
+		parents[process.PID] = process.Parent
+	}
