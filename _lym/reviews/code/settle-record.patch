+			t.Errorf("calls = %v; want %v", fixture.log, want)
+		}
+		if _, statErr := os.Stat(filepath.Join(fixture.runDir, "harden-commits-1.json")); !errors.Is(statErr, os.ErrNotExist) {
+			t.Errorf("commits file: %v; want it absent", statErr)
+		}
+		if len(fixture.commitPaths) != 0 {
+			t.Errorf("archive commits = %v; want none", fixture.commitPaths)
+		}
+	})
+
+	t.Run("FailingReapAndFailingArchiveAreJoinedWithTheirWayForward", func(t *testing.T) {
+		t.Parallel()
+		innerErr := errors.New("inner failed")
+		reapErr := errors.New("reap failed")
+		commitErr := errors.New("commit failed")
+
+		reaping := newRowFixture(t, RowReview)
+		reaping.reapErr = reapErr
+		inner := fakeProducer(func() (shedengine.Outcome, shedengine.OutputPointer, error) {
+			return "", shedengine.OutputPointer{}, innerErr
+		})
+		_, _, err := WrapRow(inner, reaping.deps).Call(context.Background())
+		const clear = "run lym harden sandbox clear in the task worktree, then lym loom resume"
+		if !errors.Is(err, innerErr) || !errors.Is(err, reapErr) || !strings.Contains(err.Error(), clear) {
+			t.Errorf("Call() error = %v; want it to wrap the inner and reap errors and name %q", err, clear)
+		}
+
+		archiving := newRowFixture(t, RowFix)
+		archiving.commitErr = commitErr
+		writeFile(t, archiving.runDir, "round-1-review.md", "review")
+		ok := fakeProducer(func() (shedengine.Outcome, shedengine.OutputPointer, error) {
+			return shedengine.Stuck, shedengine.OutputPointer{}, nil
+		})
+		_, _, err = WrapRow(ok, archiving.deps).Call(context.Background())
+		if !errors.Is(err, commitErr) || !strings.HasSuffix(err.Error(), "way forward: run lym loom resume") || strings.Contains(err.Error(), "sandbox clear") {
+			t.Errorf("Call() error = %v; want it to wrap the commit error and name only lym loom resume", err)
+		}
+	})
+}
+
+func TestArchiveRound(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	runDir, anchor := t.TempDir(), t.TempDir()
+	var committed [][]string
+	deps := ArchiveDeps{
+		RunDir:     runDir,
+		AnchorRoot: anchor,
+		Commit:     func(relPaths []string, _ string) error { committed = append(committed, relPaths); return nil },
+	}
+	writeFile(t, runDir, "round-1-review.md", "review one")
+	writeFile(t, runDir, "round-2-review.md", "review two")
+	writeFile(t, runDir, "round-1-bouncer-ledger.md", "ledger one")
+	writeFile(t, runDir, "round-2-bouncer-ledger.md", "ledger two")
+	writeFile(t, runDir, "harden-live-1.json", "{}")
+	writeFile(t, runDir, "harden-live-12.json", "{}")
+
+	if err := ArchiveRound(deps, 1); err != nil {
+		t.Fatalf("ArchiveRound(1) error = %v", err)
+	}
+	archived := filepath.Join(anchor, "_lym", "harden", "round-1")
+	entries, err := os.ReadDir(archived)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	if want := []string{"harden-live-1.json", "round-1-bouncer-ledger.md", "round-1-review.md", "round-2-bouncer-ledger.md"}; !slices.Equal(names, want) {
+		t.Errorf("archived files = %v; want %v", names, want)
+	}
+	if want := [][]string{{"_lym/harden/round-1"}}; !reflect.DeepEqual(committed, want) {
+		t.Errorf("commits = %v; want %v", committed, want)
+	}
+
+	writeFile(t, runDir, "round-1-review.md", "review one, edited")
+	if err := ArchiveRound(deps, 1); err != nil {
+		t.Fatalf("second ArchiveRound(1) error = %v", err)
+	}
+	if content, err := os.ReadFile(filepath.Join(archived, "round-1-review.md")); err != nil || string(content) != "review one, edited" {
+		t.Errorf("archived review after a second archive = %q, %v; want the edited content", content, err)
+	}
+
+	if err := ArchiveFinalLedger(deps); err != nil {
+		t.Fatalf("ArchiveFinalLedger() error = %v", err)
+	}
+	if content, err := os.ReadFile(filepath.Join(anchor, "_lym", "harden", "round-2-bouncer-ledger.md")); err != nil || string(content) != "ledger two" {
+		t.Errorf("final ledger = %q, %v; want the latest ledger", content, err)
+	}
+	if last := committed[len(committed)-1]; !reflect.DeepEqual(last, []string{"_lym/harden/round-2-bouncer-ledger.md"}) {
+		t.Errorf("final ledger commit = %v; want its path", last)
+	}
+
+	if err := ArchiveFinalLedger(ArchiveDeps{RunDir: t.TempDir(), AnchorRoot: anchor, Commit: deps.Commit}); err == nil {
+		t.Error("ArchiveFinalLedger() over a run directory with no ledger = nil; want an error")
+	}
+}
+
+func TestCampaignArchivesUnderTheAnchorPath(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	runDir, anchor, worktree := t.TempDir(), t.TempDir(), t.TempDir()
+	writeFile(t, runDir, "round-2-bouncer-ledger.md", "ledger two")
+	var committed [][]string
+	campaign := &Campaign{
+		AnchorPath:   anchor,
+		WorktreeRoot: worktree,
+		Commit:       func(relPaths []string, _ string) error { committed = append(committed, relPaths); return nil },
+	}
+
+	if err := campaign.ArchiveFinal(runDir); err != nil {
+		t.Fatalf("ArchiveFinal() error = %v", err)
+	}
+	if content, err := os.ReadFile(filepath.Join(anchor, "_lym", "harden", "round-2-bouncer-ledger.md")); err != nil || string(content) != "ledger two" {
+		t.Errorf("ledger under the anchor = %q, %v; want the run directory's ledger", content, err)
+	}
+	if _, err := os.Stat(filepath.Join(worktree, "_lym")); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("Stat(_lym under the worktree) = %v; want it absent, the archive sitting under the anchor alone", err)
+	}
+	if want := [][]string{{"_lym/harden/round-2-bouncer-ledger.md"}}; !reflect.DeepEqual(committed, want) {
+		t.Errorf("commits = %v; want the anchor-relative path %v", committed, want)
+	}
+}
diff --git a/internal/hardenshed/sandbox.go b/internal/hardenshed/sandbox.go
new file mode 100644
index 00000000..85076155
--- /dev/null
+++ b/internal/hardenshed/sandbox.go
@@ -0,0 +1,146 @@
+// sandbox.go builds and lists the throwaway sandbox hubs a campaign's live tests run against.
+
+package hardenshed
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/buildvcs"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// hubListFileName is the file under the sandbox root that records the hubs made there.
+const hubListFileName = "hubs.json"
+
+// hubListLockSuffix names the lock of the hub list beside it, under the root.
+const hubListLockSuffix = ".lock"
+
+// SandboxRoot returns the directory a run's sandbox hubs are made under.
+// It lies below the told worktree's never-tracked directory.
+// Every process of a run derives the same root, and the root goes with the worktree.
+func SandboxRoot(worktreeRoot string) string {
+	return filepath.Join(worktreeRoot, lymdirs.DotLymDirName, lymdirs.HardenSandboxDirName)
+}
+
+// SandboxDeps is what NewSandbox needs told.
+type SandboxDeps struct {
+	// Root is the sandbox root; NewSandbox writes only under it.
+	Root string
+	// Seed creates the code bare and the records bare a hub is cloned from under dir.
+	Seed func(dir string) (codeBare, recordsBare string, err error)
+	// Clone clones a hub from the two bares into container, with no GitHub remote, and returns the hub's path.
+	Clone func(codeBare, recordsBare, container string) (hubPath string, err error)
+	// CommitOverride commits the hub's sandbox config onto its prime records before any pair exists.
+	CommitOverride func(hubPath string) error
+	// DevBinLym is the absolute path of the worktree's `.dev-bin` lym, the binary the sandbox hubs run.
+	DevBinLym string
+	// Head returns the revision of the worktree's HEAD.
+	Head func() (string, error)
+	// Revision returns the build identity of the binary at path.
+	Revision func(path string) (buildvcs.Identity, error)
+	// Deploy rebuilds the `.dev-bin` lym from the worktree.
+	Deploy func() error
+}
+
+// SandboxHub is a hub NewSandbox made and the lym binary to drive it with.
+type SandboxHub struct {
+	// Hub is the absolute path of the sandbox hub.
+	Hub string
+	// Lym is the absolute path of the `.dev-bin` lym that runs in it.
+	Lym string
+}
+
+// hubList is the sandbox root's record of the hubs made under it.
+type hubList struct {
+	Hubs []string `json:"hubs"`
+}
+
+// hubListPaths returns the hub list file under root and the lock that guards it.
+// The lock sits under root too, so a sandbox writes nothing outside its root.
+func hubListPaths(root string) (path, lockPath string) {
+	path = filepath.Join(root, hubListFileName)
+	return path, path + hubListLockSuffix
+}
+
+// NewSandbox makes a fresh throwaway hub under deps.Root, records it in the root's hub list, and returns it with its lym.
+// It seeds the two bares and clones the hub in a container of its own, then has the sandbox config committed.
+// It rebuilds the `.dev-bin` lym only when its revision is not the worktree HEAD's or it is marked modified.
+// The hub list is written under a lock, so another process lists the hub.
+// A failure after the container is made removes the container, the seeded bares included, before the error returns.
+func NewSandbox(deps SandboxDeps) (SandboxHub, error) {
+	if err := os.MkdirAll(deps.Root, 0o755); err != nil {
+		return SandboxHub{}, fmt.Errorf("create the sandbox root: %w", err)
+	}
+	container, err := os.MkdirTemp(deps.Root, "hub-*")
+	if err != nil {
+		return SandboxHub{}, fmt.Errorf("create a sandbox hub container: %w", err)
+	}
+	hub, err := buildSandboxHub(deps, container)
+	if err != nil {
+		if removeErr := os.RemoveAll(container); removeErr != nil {
+			return SandboxHub{}, fmt.Errorf("%w; the container %s could not be removed: %v", err, container, removeErr)
+		}
+		return SandboxHub{}, err
+	}
+	return hub, nil
+}
+
+// buildSandboxHub seeds, clones and records the hub inside container, and settles the lym that runs it.
+func buildSandboxHub(deps SandboxDeps, container string) (SandboxHub, error) {
+	codeBare, recordsBare, err := deps.Seed(container)
+	if err != nil {
+		return SandboxHub{}, fmt.Errorf("seed the sandbox bares: %w", err)
+	}
+	hubPath, err := deps.Clone(codeBare, recordsBare, container)
+	if err != nil {
+		return SandboxHub{}, fmt.Errorf("clone the sandbox hub: %w", err)
+	}
+	if err := deps.CommitOverride(hubPath); err != nil {
+		return SandboxHub{}, fmt.Errorf("commit the sandbox config override: %w", err)
+	}
+	if err := deployWhenStale(deps); err != nil {
+		return SandboxHub{}, err
+	}
+	path, lockPath := hubListPaths(deps.Root)
+	err = state.UpdateJSON(path, lockPath, func(cur hubList, _ bool) (hubList, error) {
+		cur.Hubs = append(cur.Hubs, hubPath)
+		return cur, nil
+	})
+	if err != nil {
+		return SandboxHub{}, fmt.Errorf("record the sandbox hub: %w", err)
+	}
+	return SandboxHub{Hub: hubPath, Lym: deps.DevBinLym}, nil
+}
+
+// deployWhenStale rebuilds the `.dev-bin` lym unless it was built from the worktree's HEAD and is unmodified.
+func deployWhenStale(deps SandboxDeps) error {
+	head, err := deps.Head()
+	if err != nil {
+		return fmt.Errorf("read the worktree HEAD: %w", err)
+	}
+	built, err := deps.Revision(deps.DevBinLym)
+	if err != nil {
+		return fmt.Errorf("read the revision of %s: %w", deps.DevBinLym, err)
+	}
+	if built.Revision == head && !built.Modified {
+		return nil
+	}
+	if err := deps.Deploy(); err != nil {
+		return fmt.Errorf("deploy the .dev-bin lym: %w", err)
+	}
+	return nil
+}
+
+// ListSandbox returns the hubs recorded under root, in the order they were made.
+// It reads the hub list alone, so an entry outlives its directory until a reap prunes it.
+func ListSandbox(root string) ([]string, error) {
+	path, lockPath := hubListPaths(root)
+	list, _, err := state.ReadJSON[hubList](path, lockPath)
+	if err != nil {
+		return nil, fmt.Errorf("read the sandbox hub list: %w", err)
+	}
+	return list.Hubs, nil
+}
diff --git a/internal/hardenshed/sandbox_test.go b/internal/hardenshed/sandbox_test.go
new file mode 100644
index 00000000..a6ece3ca
--- /dev/null
+++ b/internal/hardenshed/sandbox_test.go
@@ -0,0 +1,154 @@
+// sandbox_test.go covers NewSandbox and ListSandbox over fake seams.
+
+package hardenshed
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/buildvcs"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// fakeSandboxDeps returns deps over root whose seams make a bare directory pair and a hub directory in the container.
+// The .dev-bin lym is built from head and unmodified, so Deploy is never called until a test changes the revision.
+func fakeSandboxDeps(root string, deployed *int) SandboxDeps {
+	return SandboxDeps{
+		Root: root,
+		Seed: func(dir string) (string, string, error) {
+			code, records := filepath.Join(dir, "code-bare"), filepath.Join(dir, "records-bare")
+			for _, bare := range []string{code, records} {
+				if err := os.Mkdir(bare, 0o755); err != nil {
+					return "", "", err
+				}
+			}
+			return code, records, nil
+		},
+		Clone: func(_, _, container string) (string, error) {
+			hub := filepath.Join(container, "tst-LYMHUB")
+			return hub, os.Mkdir(hub, 0o755)
+		},
+		CommitOverride: func(string) error { return nil },
+		DevBinLym:      "/worktree/.dev-bin/lym",
+		Head:           func() (string, error) { return "head", nil },
+		Revision:       func(string) (buildvcs.Identity, error) { return buildvcs.Identity{Revision: "head"}, nil },
+		Deploy:         func() error { *deployed++; return nil },
+	}
+}
+
+func TestNewSandbox(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("MakesHubsUnderTheRootAndListsThem", func(t *testing.T) {
+		t.Parallel()
+		parent := t.TempDir()
+		root := SandboxRoot(filepath.Join(parent, "worktree"))
+		var deployed int
+		deps := fakeSandboxDeps(root, &deployed)
+
+		first, err := NewSandbox(deps)
+		if err != nil {
+			t.Fatalf("NewSandbox() error = %v", err)
+		}
+		second, err := NewSandbox(deps)
+		if err != nil {
+			t.Fatalf("NewSandbox() error = %v", err)
+		}
+
+		if first.Hub == second.Hub {
+			t.Errorf("both sandboxes are the hub %s; want distinct hubs", first.Hub)
+		}
+		if first.Lym != deps.DevBinLym {
+			t.Errorf("SandboxHub.Lym = %q; want %q", first.Lym, deps.DevBinLym)
+		}
+		for _, hub := range []string{first.Hub, second.Hub} {
+			if !strings.HasPrefix(hub, root+string(filepath.Separator)) {
+				t.Errorf("hub %s lies outside the root %s", hub, root)
+			}
+		}
+		listed, err := ListSandbox(root)
+		if err != nil {
+			t.Fatalf("ListSandbox() error = %v", err)
+		}
+		if want := []string{first.Hub, second.Hub}; !reflect.DeepEqual(listed, want) {
+			t.Errorf("ListSandbox() = %v; want %v", listed, want)
+		}
+		if entries, err := os.ReadDir(filepath.Join(parent, "worktree")); err != nil || len(entries) != 1 {
+			t.Errorf("the worktree directory holds %v, %v; want only the .lym directory", entries, err)
+		}
+	})
+
+	t.Run("ListsNothingBeforeAnyHubIsMade", func(t *testing.T) {
+		t.Parallel()
+		listed, err := ListSandbox(SandboxRoot(t.TempDir()))
+		if err != nil || len(listed) != 0 {
+			t.Errorf("ListSandbox() = %v, %v; want no hub and no error", listed, err)
+		}
+	})
+
+	deployTests := []struct {
+		name         string
+		built        buildvcs.Identity
+		wantDeployed int
+	}{
+		{"DeploysWhenTheRevisionDiffers", buildvcs.Identity{Revision: "older"}, 1},
+		{"DeploysWhenTheBuildIsModified", buildvcs.Identity{Revision: "head", Modified: true}, 1},
+		{"SkipsDeployWhenTheBuildIsHeads", buildvcs.Identity{Revision: "head"}, 0},
+	}
+	for _, tt := range deployTests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			var deployed int
+			deps := fakeSandboxDeps(SandboxRoot(t.TempDir()), &deployed)
+			deps.Revision = func(string) (buildvcs.Identity, error) { return tt.built, nil }
+			if _, err := NewSandbox(deps); err != nil {
+				t.Fatalf("NewSandbox() error = %v", err)
+			}
+			if deployed != tt.wantDeployed {
+				t.Errorf("Deploy calls = %d; want %d", deployed, tt.wantDeployed)
+			}
+		})
+	}
+
+	failureTests := []struct {
+		name   string
+		mutate func(*SandboxDeps)
+	}{
+		{"FailingSeed", func(d *SandboxDeps) {
+			d.Seed = func(string) (string, string, error) { return "", "", errors.New("no seed") }
+		}},
+		{"FailingClone", func(d *SandboxDeps) {
+			d.Clone = func(string, string, string) (string, error) { return "", errors.New("no clone") }
+		}},
+		{"FailingCommitOverride", func(d *SandboxDeps) { d.CommitOverride = func(string) error { return errors.New("no commit") } }},
+		{"FailingDeploy", func(d *SandboxDeps) {
+			d.Revision = func(string) (buildvcs.Identity, error) { return buildvcs.Identity{}, nil }
+			d.Deploy = func() error { return errors.New("no deploy") }
+		}},
+	}
+	for _, tt := range failureTests {
+		t.Run(tt.name+"RecordsNoHubAndLeavesNoContainer", func(t *testing.T) {
+			t.Parallel()
+			root := SandboxRoot(t.TempDir())
+			var deployed int
+			deps := fakeSandboxDeps(root, &deployed)
+			tt.mutate(&deps)
+
+			if _, err := NewSandbox(deps); err == nil {
+				t.Fatal("NewSandbox() error = nil; want the seam's failure")
+			}
+			// The root is read before the listing, which creates the hub list's lock file there.
+			if entries, err := os.ReadDir(root); err != nil || len(entries) != 0 {
+				t.Errorf("the root holds %v, %v; want it empty", entries, err)
+			}
+			if listed, err := ListSandbox(root); err != nil || len(listed) != 0 {
+				t.Errorf("ListSandbox() = %v, %v; want no hub", listed, err)
+			}
+		})
+	}
+}
diff --git a/internal/hardenshed/template.yaml b/internal/hardenshed/template.yaml
new file mode 100644
