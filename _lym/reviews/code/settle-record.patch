new file mode 100644
index 00000000..0da40151
--- /dev/null
+++ b/internal/shedadapters/parentseat.go
@@ -0,0 +1,216 @@
+// parentseat.go implements the parent seat of a review row.
+// It decides which round asks the run's parent orch to review.
+// It posts the ask's one creel line and settles a round's ask once its review is accepted.
+// The ask itself lives in burlerengine's never-tracked ask record; this file only decides, posts and settles.
+
+package shedadapters
+
+import (
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// ParentReviewSeat is a review segment's parent seat.
+// A round of the segment may ask the run's parent orch to review the decision record beside the reviewer.
+// The chair keeps every finding the parent reports.
+type ParentReviewSeat struct {
+	// Files locates the run's ask record and the parent's reports.
+	Files burlerengine.ParentReviewFiles
+	// Slug is the run's slug and RecordPath the decision record's path in the task worktree; the ask's line names both.
+	Slug       string
+	RecordPath string
+	// AskEnabled reads discussion_review_ask_parent for the round about to start.
+	// It decides only whether the round sends a new ask; an ask the round already holds is carried through whatever it reads.
+	AskEnabled func() bool
+	// Wait returns the time from an ask to its deadline,
+	// and a non-empty reason when the chair's timeout leaves the parent no time, so the round sends no ask.
+	Wait func() (time.Duration, string)
+	// RecordWrittenAt returns the latest time the run's history records a Discussion-Write call, the zero time when none.
+	RecordWrittenAt func() (time.Time, error)
+	// Resolve answers the orch strand an ask goes to and whether that orch's state records one.
+	Resolve func() (strand string, recorded bool, err error)
+	// Post sends line to strand as creel mail signed as lym's loom program.
+	Post func(strand, line string) error
+}
+
+// ParentAskLineTag opens every line that asks the parent orch to review a Discussion-Review round.
+const ParentAskLineTag = "[discussion-review request]"
+
+// parentDeadlineLayout renders an ask's deadline in the line as a wall-clock time.
+const parentDeadlineLayout = "2006-01-02 15:04:05 MST"
+
+// roundSeed returns the identity of runDir's review generation: the write time of its round-1 focus file.
+// The time is in RFC 3339 with nanoseconds.
+// A fresh start, a new generation and a clear each write that file anew; a goto, a resume and a restarted row keep it.
+func roundSeed(runDir string) (string, error) {
+	info, err := os.Stat(focusPath(runDir, 1))
+	if err != nil {
+		return "", err
+	}
+	return info.ModTime().UTC().Format(time.RFC3339Nano), nil
+}
+
+// readParentAsks returns the run's ask record and the seed of runDir's generation.
+// ok is false when the row has no parent seat or either read failed, which it logs.
+func (p *BurlerReviewProducer) readParentAsks(round int) (record burlerengine.ParentAskRecord, seed string, ok bool) {
+	if p.parent == nil {
+		return burlerengine.ParentAskRecord{}, "", false
+	}
+	seed, err := roundSeed(p.runDir)
+	if err != nil {
+		logger.Warn("shedadapters: the review generation's seed is unreadable; the round goes on without the parent", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "error", err)
+		return burlerengine.ParentAskRecord{}, "", false
+	}
+	record, _, err = burlerengine.ReadParentAsks(p.parent.Files)
+	if err != nil {
+		logger.Warn("shedadapters: the parent-review ask record is unreadable; the round goes on without the parent", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "error", err)
+		return burlerengine.ParentAskRecord{}, "", false
+	}
+	return record, seed, true
+}
+
+// roundParentAsk returns the number of round's parent-review ask, sending a new ask when the round asks.
+// It returns 0 when the round holds none.
+// An ask the round already holds is never sent again, whatever discussion_review_ask_parent now reads.
+// One still pending-post is posted again to the strand it records.
+// A new ask goes out only when the key is on and parentAskDue says the round asks.
+// A failure to read or write the ask record is logged, and the round goes on without the parent.
+func (p *BurlerReviewProducer) roundParentAsk(round int) int {
+	record, seed, ok := p.readParentAsks(round)
+	if !ok {
+		return 0
+	}
+	if ask, held := record.RoundAsk(seed, round); held {
+		if ask.State == burlerengine.ParentAskPendingPost {
+			p.postParentAsk(ask)
+		}
+		return ask.Number
+	}
+	if !p.parent.AskEnabled() || !p.parentAskDue(record, seed, round) {
+		return 0
+	}
+	return p.sendParentAsk(seed, round)
+}
+
+// parentAskDue reports whether round of the generation seed asks the parent, read against the run's latest ask.
+// It asks when the run has no ask yet or the latest ask has another seed.
+// It asks when the run's history records a Discussion-Write call after the latest ask.
+// Within the same seed it asks when the round before ended done with findings, so the parent confirms their fixes.
+// Within the same seed it asks when an earlier round's ask was not-sent, so a raised chair timeout takes effect.
+func (p *BurlerReviewProducer) parentAskDue(record burlerengine.ParentAskRecord, seed string, round int) bool {
+	latest, ok := record.Latest()
+	if !ok || latest.Seed != seed {
+		return true
+	}
+	rewrittenAt, err := p.parent.RecordWrittenAt()
+	switch {
+	case err != nil:
+		logger.Warn("shedadapters: the run's history is unreadable; judging the round as though the record was not rewritten", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "error", err)
+	case rewrittenAt.After(latest.AskedAt):
+		return true
+	}
+	switch {
+	case latest.Round == round-1 && latest.State == burlerengine.ParentAskDone:
+		report, err := burlerengine.ReadParentReport(latest.Report)
+		if err != nil {
+			logger.Warn("shedadapters: the previous round's parent report is unreadable; asking the parent again", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "error", err)
+			return true
+		}
+		return len(report.Findings) > 0
+	case latest.Round < round && latest.State == burlerengine.ParentAskNotSent:
+		return true
+	}
+	return false
+}
+
+// sendParentAsk records round's new ask and posts it, returning its number, or 0 when the record could not be written.
+// A wait the chair's timeout leaves no room for records the ask not-sent with that reason,
+// and a parent that does not resolve, or records no orch strand, records it no-parent; neither posts anything.
+// Otherwise the destination strand is resolved once.
+// The ask is recorded pending-post with its deadline and that strand, then posted.
+func (p *BurlerReviewProducer) sendParentAsk(seed string, round int) int {
+	seat := p.parent
+	now := p.now()
+	ask := burlerengine.ParentAsk{Round: round, Seed: seed, AskedAt: now}
+	wait, skipReason := seat.Wait()
+	if skipReason != "" {
+		ask.State, ask.Reason = burlerengine.ParentAskNotSent, skipReason
+	} else {
+		strand, recorded, err := seat.Resolve()
+		switch {
+		case err != nil:
+			ask.State, ask.Reason = burlerengine.ParentAskNoParent, fmt.Sprintf("the run's parent orch could not be resolved: %s", err)
+		case !recorded:
+			ask.State, ask.Reason = burlerengine.ParentAskNoParent, "no orch strand is recorded at the run's parent"
+		default:
+			ask.State, ask.Strand, ask.Deadline = burlerengine.ParentAskPendingPost, strand, now.Add(wait)
+		}
+	}
+	recorded, err := burlerengine.RecordParentAsk(seat.Files, ask)
+	if err != nil {
+		logger.Warn("shedadapters: the round's parent-review ask was not recorded; the round goes on without the parent", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "error", err)
+		return 0
+	}
+	if recorded.State == burlerengine.ParentAskPendingPost {
+		p.postParentAsk(recorded)
+	} else {
+		logger.Warn("shedadapters: the round's parent-review ask did not go out; the round goes on without the parent", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "ask", recorded.Number, "state", recorded.State, "reason", recorded.Reason)
+	}
+	return recorded.Number
+}
+
+// postParentAsk posts ask's line to the strand it records and sets the ask open.
+// A failed post sets the ask no-parent with the error as its reason, and the round goes on without the parent.
+func (p *BurlerReviewProducer) postParentAsk(ask burlerengine.ParentAsk) {
+	seat := p.parent
+	if err := seat.Post(ask.Strand, ParentAskLine(seat.Slug, seat.RecordPath, ask)); err != nil {
+		logger.Warn("shedadapters: the parent-review request was not delivered; the round goes on without the parent", "producer", p.name, "engine", burlerReviewEngineLabel, "round", ask.Round, "ask", ask.Number, "error", err)
+		if _, _, endErr := burlerengine.EndParentAsk(seat.Files, ask.Number, burlerengine.ParentAskNoParent, fmt.Sprintf("the request was not delivered: %s", err)); endErr != nil {
+			logger.Warn("shedadapters: the undelivered parent-review ask was not set no-parent", "producer", p.name, "engine", burlerReviewEngineLabel, "ask", ask.Number, "error", endErr)
+		}
+		return
+	}
+	if err := burlerengine.MarkParentAskPosted(seat.Files, ask.Number); err != nil {
+		logger.Warn("shedadapters: the posted parent-review ask was not set open", "producer", p.name, "engine", burlerReviewEngineLabel, "ask", ask.Number, "error", err)
+	}
+}
+
+// ParentAskLine renders the one creel line that asks the parent to review the decision record at recordPath under ask.
+// It names the slug, the round, the ask number, and the record's path.
+// It also names the deadline as a wall-clock time and the answer verb with its --ask flag filled in.
+func ParentAskLine(slug, recordPath string, ask burlerengine.ParentAsk) string {
+	answer := fmt.Sprintf("lym loom parent-review answer %s --ask %d", slug, ask.Number)
+	return fmt.Sprintf(`%s %s round %d ask %d: review the decision record %s and answer by %s with "%s --satisfied" or "%s --findings-file <path>"`,
+		ParentAskLineTag, slug, ask.Round, ask.Number, recordPath, ask.Deadline.Local().Format(parentDeadlineLayout), answer, answer)
+}
+
+// settleRoundParentAsk settles round's ask once the review at reviewPath is accepted:
+// an ask still pending-post or open is set timeout, and a done report not yet copied is copied beside the review.
+// A round with no ask settles nothing, and a failure is logged, since the parent seat never fails the round.
+func (p *BurlerReviewProducer) settleRoundParentAsk(round, number int, reviewPath string) {
+	if p.parent == nil || number == 0 {
+		return
+	}
+	copied, err := burlerengine.SettleParentAsk(p.parent.Files, number, reviewPath)
+	if err != nil {
+		logger.Warn("shedadapters: the round's parent-review ask was not settled", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "ask", number, "error", err)
+		return
+	}
+	if copied != "" {
+		logger.Info("shedadapters: copied the parent's report beside the accepted review", "producer", p.name, "engine", burlerReviewEngineLabel, "round", round, "ask", number, "copy", copied)
+	}
+}
+
+// heldParentAsk returns the number of the ask round already holds, 0 when it holds none; it sends nothing.
+func (p *BurlerReviewProducer) heldParentAsk(round int) int {
+	record, seed, ok := p.readParentAsks(round)
+	if !ok {
+		return 0
+	}
+	ask, _ := record.RoundAsk(seed, round)
+	return ask.Number
+}
diff --git a/internal/shedadapters/parentseat_test.go b/internal/shedadapters/parentseat_test.go
new file mode 100644
index 00000000..efe95ee9
--- /dev/null
+++ b/internal/shedadapters/parentseat_test.go
@@ -0,0 +1,572 @@
+// parentseat_test.go pins the parent seat of BurlerReviewProducer over shedfake.BurlerHalfRunner.
+// It covers which rounds ask the run's parent orch and how an ask that cannot go out ends.
+// It also covers the ask's creel line and how an accepted review settles its round's ask.
+// Every test runs against a real ask record in a temp directory and fake closures for the seat's collaborators.
+
+package shedadapters
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/testkit/shedfake"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+const (
+	parentSlug       = "disc-slug"
+	parentRecordPath = "/worktree/_lym/discussion/decision-record.md"
+	// parentWait is the time from an ask to its deadline that the fixture's Wait answers.
+	parentWait = 20 * time.Minute
+	// resolvedStrand is the strand the fixture's Resolve answers; storedStrand is the one a prior ask already records.
+	resolvedStrand = "orch-strand"
+	storedStrand   = "stored-strand"
+	// parentSeed is the RFC 3339 form of the round-1 focus file's write time the fixture sets.
+	parentSeed      = "2026-08-16T14:00:00Z"
+	otherParentSeed = "2026-08-16T13:00:00Z"
+)
+
+var (
+	parentSeedTime = time.Date(2026, 8, 16, 14, 0, 0, 0, time.UTC)
+	// priorAskedAt and priorDeadline are the times every prior ask the fixture records carries.
+	priorAskedAt  = archiveTestInstant.Add(-time.Hour)
+	priorDeadline = archiveTestInstant.Add(30 * time.Minute)
+)
+
+// parentPost is one line the fixture's Post received.
+type parentPost struct {
+	strand string
+	line   string
+}
+
+// priorAsk is an ask recorded before the call under test.
+// An ask in state done is answered with findings, a satisfied report when there are none.
+// An empty Seed takes the fixture's seed.
+type priorAsk struct {
+	ask      burlerengine.ParentAsk
+	findings []burlerengine.ParentFinding
+}
+
+// parentFixture is a run directory seeded with a round-1 focus file, and a parent seat whose collaborators it scripts.
+type parentFixture struct {
+	runDir string
+	files  burlerengine.ParentReviewFiles
+	seat   *ParentReviewSeat
+
+	keyOn      bool
+	skipReason string
+	writtenAt  time.Time
+	writtenErr error
+	unrecorded bool
+	resolveErr error
+	postErr    error
+
+	posts        []parentPost
+	resolveCalls int
+}
+
+// newParentFixture builds a fixture whose seed is parentSeed and whose key is off.
+func newParentFixture(t *testing.T) *parentFixture {
+	t.Helper()
+	f := &parentFixture{runDir: t.TempDir(), files: burlerengine.ParentReviewFilesOf(t.TempDir())}
+	focus := writeFocusFile(t, f.runDir, 1, focusFile{Round: 1, Focus: []string{"look at the seam"}})
+	if err := os.Chtimes(focus, parentSeedTime, parentSeedTime); err != nil {
+		t.Fatalf("Chtimes(%s): %v", focus, err)
+	}
+	f.seat = &ParentReviewSeat{
+		Files:           f.files,
+		Slug:            parentSlug,
+		RecordPath:      parentRecordPath,
+		AskEnabled:      func() bool { return f.keyOn },
+		Wait:            func() (time.Duration, string) { return parentWait, f.skipReason },
+		RecordWrittenAt: func() (time.Time, error) { return f.writtenAt, f.writtenErr },
+		Resolve: func() (string, bool, error) {
+			f.resolveCalls++
+			return resolvedStrand, !f.unrecorded, f.resolveErr
+		},
+		Post: func(strand, line string) error {
+			f.posts = append(f.posts, parentPost{strand: strand, line: line})
+			return f.postErr
+		},
+	}
+	return f
+}
+
+// producer returns a review producer over the fixture's run directory and seat.
+func (f *parentFixture) producer(t *testing.T, runner *shedfake.BurlerHalfRunner) *BurlerReviewProducer {
+	t.Helper()
+	spec := newHalfSpec()
+	spec.parent = f.seat
+	return newReviewProducer(t, f.runDir, runner, spec)
+}
+
+// judgeRounds writes rounds 1 through n as judged, so the producer's next round is n+1.
+func (f *parentFixture) judgeRounds(t *testing.T, n int) {
+	t.Helper()
+	for round := 1; round <= n; round++ {
+		writeJudgedRound(t, f.runDir, round)
+	}
+}
+
+// recordAsk records prior in the fixture's ask record, answering it when its state is done.
+func (f *parentFixture) recordAsk(t *testing.T, prior priorAsk) {
+	t.Helper()
+	ask := prior.ask
+	if ask.Seed == "" {
+		ask.Seed = parentSeed
+	}
+	ask.AskedAt, ask.Deadline = priorAskedAt, priorDeadline
+	answered := ask.State == burlerengine.ParentAskDone
+	if answered {
+		ask.State = burlerengine.ParentAskOpen
+	}
+	recorded, err := burlerengine.RecordParentAsk(f.files, ask)
+	if err != nil {
+		t.Fatalf("RecordParentAsk() error = %v; want nil", err)
+	}
+	if answered {
+		if _, err := burlerengine.AnswerParentAsk(f.files, recorded.Number, priorAskedAt.Add(time.Minute), prior.findings); err != nil {
+			t.Fatalf("AnswerParentAsk() error = %v; want nil", err)
+		}
+	}
+}
+
+// readAsks returns the fixture's ask record, failing the test when it cannot be read.
+func (f *parentFixture) readAsks(t *testing.T) burlerengine.ParentAskRecord {
+	t.Helper()
+	record, _, err := burlerengine.ReadParentAsks(f.files)
+	if err != nil {
+		t.Fatalf("ReadParentAsks() error = %v; want nil", err)
+	}
+	return record
+}
+
+// setNanosecondWriteTime sets path's write time to at.
+// It skips the test when the file system rounds away the nanoseconds.
+func setNanosecondWriteTime(t *testing.T, path string, at time.Time) {
+	t.Helper()
+	if err := os.Chtimes(path, at, at); err != nil {
+		t.Fatalf("Chtimes(%s): %v", path, err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("Stat(%s): %v", path, err)
+	}
+	if !info.ModTime().Equal(at) {
+		t.Skipf("the file system stores write times as %v; want the exact %v", info.ModTime(), at)
+	}
+}
+
+// TestBurlerReviewProducer_Call_ParentAskingRule table-drives which rounds send the parent an ask.
+// Each row sets the run's prior ask, the key and the history.
+// It then reads the post, the recorded ask and the number the round's review table is told.
+// The review fails after its table starts, so a posted ask is still open when the record is read.
+func TestBurlerReviewProducer_Call_ParentAskingRule(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	findings := []burlerengine.ParentFinding{{Change: "tighten the seam"}}
+	tests := []struct {
+		name string
+		// judged is the number of judged rounds before the call, so the call's round is judged+1.
+		judged int
+		keyOn  bool
+		prior  *priorAsk
+		// rewritten sets the history's latest Discussion-Write call after the prior ask.
+		rewritten bool
+		// writtenErr is the error the history read fails with.
+		writtenErr error
+		// focusOffset moves the round-1 focus file's write time past the fixture's seed.
+		focusOffset time.Duration
+		// dropReport removes the prior ask's report file before the call.
+		dropReport bool
+		// held marks a round whose ask was recorded before the call.
+		held       bool
+		wantPosts  int
+		wantAsk    int
+		wantState  burlerengine.ParentAskState
+		wantAsksOn int
+	}{
+		{name: "no ask yet and the key on asks", keyOn: true, wantPosts: 1, wantAsk: 1, wantState: burlerengine.ParentAskOpen, wantAsksOn: 1},
+		{name: "no ask yet and the key off asks nothing"},
+		{
+			name: "a previous round done with findings asks", judged: 1, keyOn: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskDone}, findings: findings},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "a previous round done satisfied asks nothing", judged: 1, keyOn: true,
+			prior: &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskDone}}, wantAsksOn: 1,
+		},
+		{
+			name: "a previous round that timed out asks nothing", judged: 1, keyOn: true,
+			prior: &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskTimeout}}, wantAsksOn: 1,
+		},
+		{
+			name: "a previous round with no parent asks nothing", judged: 1, keyOn: true,
+			prior: &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskNoParent}}, wantAsksOn: 1,
+		},
+		{
+			name: "an earlier round not sent asks", judged: 2, keyOn: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskNotSent, Reason: "no room"}},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "another seed asks whatever its answer was: satisfied", keyOn: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Seed: otherParentSeed, Round: 1, State: burlerengine.ParentAskDone}},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "another seed asks whatever its answer was: timeout", keyOn: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Seed: otherParentSeed, Round: 1, State: burlerengine.ParentAskTimeout}},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "a record rewritten after the latest ask asks", judged: 1, keyOn: true, rewritten: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskTimeout}},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "a seed one nanosecond past the prior ask's asks whatever its answer was", keyOn: true, focusOffset: time.Nanosecond,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskDone}},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "an unreadable history is judged as a record not rewritten", judged: 1, keyOn: true, writtenErr: errors.New("boom"),
+			prior: &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskTimeout}}, wantAsksOn: 1,
+		},
+		{
+			name: "a previous round done whose report is missing asks", judged: 1, keyOn: true, dropReport: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskDone}, findings: findings},
+			wantPosts: 1, wantAsk: 2, wantState: burlerengine.ParentAskOpen, wantAsksOn: 2,
+		},
+		{
+			name: "an ask still pending-post is posted again to its stored strand with the key off", held: true,
+			prior:     &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskPendingPost, Strand: storedStrand}},
+			wantPosts: 1, wantAsk: 1, wantState: burlerengine.ParentAskOpen, wantAsksOn: 1,
+		},
+		{
+			name: "an open ask is neither posted again nor given a new deadline", keyOn: true, held: true,
+			prior:   &priorAsk{ask: burlerengine.ParentAsk{Round: 1, State: burlerengine.ParentAskOpen, Strand: storedStrand}},
+			wantAsk: 1, wantState: burlerengine.ParentAskOpen, wantAsksOn: 1,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newParentFixture(t)
+			f.keyOn = tt.keyOn
+			f.judgeRounds(t, tt.judged)
+			if tt.prior != nil {
+				f.recordAsk(t, *tt.prior)
+			}
+			if tt.dropReport {
+				if err := os.Remove(f.files.ReportPath(1)); err != nil {
+					t.Fatalf("remove the prior ask's report: %v", err)
+				}
+			}
+			if tt.focusOffset != 0 {
+				setNanosecondWriteTime(t, focusPath(f.runDir, 1), parentSeedTime.Add(tt.focusOffset))
+			}
+			seed := parentSeedTime.Add(tt.focusOffset).Format(time.RFC3339Nano)
+			if tt.rewritten {
+				f.writtenAt = priorAskedAt.Add(time.Minute)
+			}
+			f.writtenErr = tt.writtenErr
+			round := tt.judged + 1
+			runner := &shedfake.BurlerHalfRunner{ReviewErrs: []error{errors.New("review stopped")}}
+
+			_, _, err := f.producer(t, runner).Call(context.Background())
+
+			if err == nil || !strings.Contains(err.Error(), "review stopped") || runner.ReviewCalls != 1 {
+				t.Fatalf("Call() error = %v with %d Review calls; want the review table started and stopped", err, runner.ReviewCalls)
+			}
+			if got := runner.GotReviewOpts[0].ParentAsk; got != tt.wantAsk {
+				t.Errorf("review opts ParentAsk = %d; want %d", got, tt.wantAsk)
+			}
+			record := f.readAsks(t)
+			if len(record.Asks) != tt.wantAsksOn {
+				t.Errorf("recorded asks = %d; want %d", len(record.Asks), tt.wantAsksOn)
+			}
+			ask, found := record.RoundAsk(seed, round)
+			if tt.wantAsk == 0 {
+				if found {
+					t.Errorf("round %d holds ask %+v; want none", round, ask)
+				}
+				if len(f.posts) != 0 {
+					t.Errorf("posts = %+v; want none", f.posts)
+				}
+				return
+			}
+			wantStrand, wantAskedAt, wantDeadline, wantResolves := resolvedStrand, archiveTestInstant, archiveTestInstant.Add(parentWait), 1
+			if tt.held {
+				wantStrand, wantAskedAt, wantDeadline, wantResolves = storedStrand, priorAskedAt, priorDeadline, 0
+			}
+			if !found || ask.Number != tt.wantAsk || ask.State != tt.wantState || ask.Round != round || ask.Strand != wantStrand {
+				t.Errorf("round %d ask = %+v, found %v; want number %d, state %s, strand %q", round, ask, found, tt.wantAsk, tt.wantState, wantStrand)
+			}
+			if !ask.AskedAt.Equal(wantAskedAt) || !ask.Deadline.Equal(wantDeadline) {
+				t.Errorf("ask times = %v, %v; want asked at %v with deadline %v", ask.AskedAt, ask.Deadline, wantAskedAt, wantDeadline)
+			}
+			if f.resolveCalls != wantResolves {
+				t.Errorf("Resolve calls = %d; want %d", f.resolveCalls, wantResolves)
+			}
+			var wantPosts []parentPost
+			if tt.wantPosts > 0 {
+				wantPosts = []parentPost{{strand: wantStrand, line: ParentAskLine(parentSlug, parentRecordPath, ask)}}
+			}
+			if !reflect.DeepEqual(f.posts, wantPosts) {
+				t.Errorf("posts = %+v; want %+v", f.posts, wantPosts)
+			}
+		})
+	}
+}
