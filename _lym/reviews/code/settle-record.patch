+// spawn_test.go covers SpawnOrAttach: attach to a live record, the spawn's spec and record, and each failure that must leave no unrecorded strand.
+
+package gatefixer
+
+import (
+	"errors"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestSpawnOrAttach pins the attach, the spawn's spec, record and registration, and the failures a spawn must not outlive.
+func TestSpawnOrAttach(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("LiveRecordAttachesAndStartsNothing", func(t *testing.T) {
+		t.Parallel()
+		fx := newFixture(t)
+		live := &Record{StrandGUID: "live-guid"}
+		fx.store.records = []*Record{{StrandGUID: "old", Status: StatusDead}, live}
+
+		rec, spawned, err := SpawnOrAttach(fx.deps, fx.store, fx.spec)
+		if err != nil || spawned || rec != live {
+			t.Fatalf("SpawnOrAttach() = %p, %v, %v; want an attach to %p", rec, spawned, err, live)
+		}
+		if len(fx.starter.specs) != 0 || len(fx.registered) != 0 {
+			t.Errorf("starts = %d, registrations = %v; want none", len(fx.starter.specs), fx.registered)
+		}
+	})
+
+	t.Run("SpawnStartsRegistersAndSavesTheRecord", func(t *testing.T) {
+		t.Parallel()
+		fx := newFixture(t)
+		if err := os.WriteFile(fx.replyPath, []byte("stale"), 0o644); err != nil {
+			t.Fatalf("seed stale reply: %v", err)
+		}
+
+		rec := fx.spawn(t)
+		if _, err := os.Stat(fx.replyPath); !os.IsNotExist(err) {
+			t.Errorf("stat stale reply = %v; want it removed before the spawn", err)
+		}
+		spec := fx.engine.LastSpec
+		if spec.Role != RoleGateFixer || spec.ModelChoice.Model != "fixer-model" || !slices.Equal(spec.OutputFiles, []string{fx.replyPath}) || !slices.Equal(spec.Skills, []string{"scribe:prose"}) {
+			t.Errorf("started spec = role %q, model %q, output files %v, skills %v; want the fixer's role, model, the reply as only output file and its skills", spec.Role, spec.ModelChoice.Model, spec.OutputFiles, spec.Skills)
+		}
+		if fx.engine.LastPrompt != "fix the failures" {
+			t.Errorf("started prompt = %q; want the spec's prompt", fx.engine.LastPrompt)
+		}
+		if !slices.Equal(fx.registered, []string{rec.StrandGUID}) {
+			t.Errorf("registered = %v; want the spawned strand %q", fx.registered, rec.StrandGUID)
+		}
+		if len(fx.store.records) != 1 || fx.store.records[0] != rec {
+			t.Fatalf("store = %+v; want the one spawned record", fx.store.records)
+		}
+		if rec.StrandGUID == "" || rec.ShuttleRunDir == "" || rec.EventsPath == "" || rec.SpawnedAt != "1970-01-01T00:00:00Z" || rec.ReportPath != "/lym/report.md" || rec.ReplyPath != fx.replyPath || rec.Status != "" {
+			t.Errorf("record = %+v; want the strand, run dir, events, the clock's spawn time, both paths and no status", rec)
+		}
+		if len(fx.stopper.guids) != 0 {
+			t.Errorf("stopped = %v; want nothing stopped", fx.stopper.guids)
+		}
+
+		again, spawned, err := SpawnOrAttach(fx.deps, fx.store, fx.spec)
+		if err != nil || spawned || again != rec || len(fx.starter.specs) != 1 {
+			t.Errorf("second call = %p, %v, %v with %d starts; want an attach to %p and no second spawn", again, spawned, err, len(fx.starter.specs), rec)
+		}
+	})
+
+	t.Run("NilRegisterRegistersNothing", func(t *testing.T) {
+		t.Parallel()
+		fx := newFixture(t)
+		fx.deps.Register = nil
+		fx.spawn(t)
+		if len(fx.registered) != 0 || len(fx.store.records) != 1 {
+			t.Errorf("registrations = %v, records = %d; want none registered and the record saved", fx.registered, len(fx.store.records))
+		}
+	})
+
+	failures := []struct {
+		name        string
+		arrange     func(t *testing.T, fx *fixture)
+		wantStopped bool
+		wantText    string
+	}{
+		{
+			name:     "StartFailureSavesAndStopsNothing",
+			arrange:  func(_ *testing.T, fx *fixture) { fx.starter.err = errors.New("provider never ready") },
+			wantText: "provider never ready",
+		},
+		{
+			name:        "UnresolvedRunStopsTheStrand",
+			arrange:     func(t *testing.T, fx *fixture) { fx.deps.ShuttleCfg.RunDir = t.TempDir() },
+			wantStopped: true,
+			wantText:    "resolve the spawned",
+		},
+		{
+			name: "FailedRegistrationStopsTheStrand",
+			arrange: func(_ *testing.T, fx *fixture) {
+				fx.deps.Register = func(string) error { return errors.New("no pane") }
+			},
+			wantStopped: true,
+			wantText:    "no pane",
+		},
+		{
+			name:        "FailedSaveStopsTheStrand",
+			arrange:     func(_ *testing.T, fx *fixture) { fx.store.saveErr = errors.New("disk full") },
+			wantStopped: true,
+			wantText:    "disk full",
+		},
+	}
+	for _, tt := range failures {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			fx := newFixture(t)
+			tt.arrange(t, fx)
+
+			rec, spawned, err := SpawnOrAttach(fx.deps, fx.store, fx.spec)
+			if err == nil || rec != nil || spawned {
+				t.Fatalf("SpawnOrAttach() = %v, %v, %v; want the failure", rec, spawned, err)
+			}
+			if !strings.Contains(err.Error(), tt.wantText) {
+				t.Errorf("SpawnOrAttach() error = %q; want it to contain %q", err, tt.wantText)
+			}
+			if class := shedengine.TransientOf(err); class != shedengine.TransientAgentStart {
+				t.Errorf("transient class = %q; want %q", class, shedengine.TransientAgentStart)
+			}
+			wantStops := 0
+			if tt.wantStopped {
+				wantStops = 1
+			}
+			if len(fx.stopper.guids) != wantStops {
+				t.Errorf("stopped = %v; want %d stop", fx.stopper.guids, wantStops)
+			}
+			if len(fx.store.records) != 0 {
+				t.Errorf("store = %+v; want no record of a failed spawn", fx.store.records)
+			}
+		})
+	}
+
+	t.Run("RoleOutsideTheSetIsRefused", func(t *testing.T) {
+		t.Parallel()
+		fx := newFixture(t)
+		fx.spec.Role = "implementer"
+		_, _, err := SpawnOrAttach(fx.deps, fx.store, fx.spec)
+		if err == nil || !strings.Contains(err.Error(), `"implementer"`) || !strings.Contains(err.Error(), RoleGateFixer) || !strings.Contains(err.Error(), RoleVerifyFixer) {
+			t.Fatalf("SpawnOrAttach() error = %v; want a refusal naming the role and the fixer roles", err)
+		}
+		if len(fx.starter.specs) != 0 {
+			t.Errorf("starts = %d; want none", len(fx.starter.specs))
+		}
+	})
+}
diff --git a/internal/gatefixer/strand.go b/internal/gatefixer/strand.go
new file mode 100644
index 00000000..ea990b59
--- /dev/null
+++ b/internal/gatefixer/strand.go
@@ -0,0 +1,88 @@
+// strand.go reads a fixer strand's state from outside: whether reed still tracks it as live, and whether its newest turn has ended.
+
+package gatefixer
+
+import (
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// StrandLive reports whether guid names a strand reed currently tracks as live.
+// guid absent from the result reports (false, nil).
+// Liveness is NEVER read from persisted reed state;
+// only a live Status() query can answer this.
+func StrandLive(reed shuttleengine.ReedOps, guid string) (bool, error) {
+	status, err := reed.Status()
+	if err != nil {
+		return false, fmt.Errorf("gatefixer: reed status: %w", err)
+	}
+	for _, s := range status.Strands {
+		if s.GUID == guid {
+			return s.Live, nil
+		}
+	}
+	return false, nil
+}
+
+// turnEndSettle is how long a strand's newest turn end must stand before it counts:
+// a background shell that finished just before the turn ended queues its completion notification, which starts the strand's next turn an instant after the turn end.
+const turnEndSettle = 5 * time.Second
+
+// TurnEndRead carries what TurnEndedAfter's reading needs besides the events file: the read's time.
+type TurnEndRead struct {
+	Now time.Time
+}
+
+// TurnEndedAfter reports whether a strand's newest turn, read from the events at byte offset on, has ended with nothing it still waits on, so the turn end counts.
+// The offset skips the skill-load turns shuttle ran before the prompt; an offset past the file's end reads no events.
+// With an engine that has the SessionSignalParser capability the newest turn start or turn end decides:
+// a turn start, or no turn signal, is a strand still working;
+// a turn end with nothing outstanding counts once it has stood for turnEndSettle, since a just-finished shell's notification starts the next turn;
+// a turn end left waiting on any task, a shell of either signal or a fork, never counts, so that strand keeps running until its report exists or its own timeout.
+// A turn end with no hook time counts at once.
+// An engine without the capability counts the newest ParseEvents event when it is an EventStop, and ParseEvents errors propagate.
+// A missing events file reports (false, nil).
+func TurnEndedAfter(eventsPath string, offset int64, engine shuttleengine.Engine, read TurnEndRead) (bool, error) {
+	data, err := os.ReadFile(eventsPath)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return false, nil
+		}
+		return false, fmt.Errorf("gatefixer: read events file %s: %w", eventsPath, err)
+	}
+	if offset > int64(len(data)) {
+		offset = int64(len(data))
+	}
+	data = data[offset:]
+	if len(data) == 0 {
+		return false, nil
+	}
+
+	parser, ok := engine.(shuttleengine.SessionSignalParser)
+	if !ok {
+		events, err := engine.ParseEvents(data)
+		if err != nil {
+			return false, fmt.Errorf("gatefixer: parse events %s: %w", eventsPath, err)
+		}
+		return len(events) > 0 && events[len(events)-1].Kind == shuttleengine.EventStop, nil
+	}
+
+	signals, _ := parser.ParseSessionSignals(data)
+	var newest *shuttleengine.SessionSignal
+	for i := range signals {
+		switch signals[i].Kind {
+		case shuttleengine.SessionSignalTurnStart, shuttleengine.SessionSignalTurnEnd:
+			newest = &signals[i]
+		}
+	}
+	if newest == nil || newest.Kind == shuttleengine.SessionSignalTurnStart {
+		return false, nil
+	}
+	if len(newest.Outstanding) != 0 {
+		return false, nil
+	}
+	return newest.At.IsZero() || read.Now.Sub(newest.At) >= turnEndSettle, nil
+}
diff --git a/internal/gatefixer/strand_test.go b/internal/gatefixer/strand_test.go
new file mode 100644
index 00000000..9e6c1be2
--- /dev/null
+++ b/internal/gatefixer/strand_test.go
@@ -0,0 +1,159 @@
+// strand_test.go covers StrandLive against a shuttlefake.Reed (present/live, present/not-live, absent) and TurnEndedAfter against a shuttlefake.Engine (newest stop event, no stop event, missing events file, a ParseEvents error, the load-turn offset).
+
+package gatefixer
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/reedengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/shuttlefake"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestStrandLive pins StrandLive's live, not-live, absent and probe-error results.
+func TestStrandLive(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("guid present and live", func(t *testing.T) {
+		t.Parallel()
+		reed := &shuttlefake.Reed{Strands: []reedengine.StrandStatus{
+			{GUID: "other", Live: false},
+			{GUID: "target", Live: true},
+		}}
+		live, err := StrandLive(reed, "target")
+		if err != nil {
+			t.Fatalf("StrandLive() error = %v; want nil", err)
+		}
+		if !live {
+			t.Errorf("StrandLive() = false; want true")
+		}
+	})
+
+	t.Run("guid present and not live", func(t *testing.T) {
+		t.Parallel()
+		reed := &shuttlefake.Reed{Strands: []reedengine.StrandStatus{{GUID: "target", Live: false}}}
+		live, err := StrandLive(reed, "target")
+		if err != nil {
+			t.Fatalf("StrandLive() error = %v; want nil", err)
+		}
+		if live {
+			t.Errorf("StrandLive() = true; want false")
+		}
+	})
+
+	t.Run("guid absent from Status is false, nil", func(t *testing.T) {
+		t.Parallel()
+		reed := &shuttlefake.Reed{Strands: []reedengine.StrandStatus{{GUID: "someone-else", Live: true}}}
+		live, err := StrandLive(reed, "target")
+		if err != nil {
+			t.Fatalf("StrandLive() error = %v; want nil", err)
+		}
+		if live {
+			t.Errorf("StrandLive() = true for an absent guid; want false")
+		}
+	})
+
+	t.Run("reed Status error propagates", func(t *testing.T) {
+		t.Parallel()
+		wantErr := errors.New("reed unreachable")
+		_, err := StrandLive(&shuttlefake.Reed{StatusErr: wantErr}, "target")
+		if err == nil {
+			t.Fatalf("StrandLive() error = nil; want a wrapped error")
+		}
+		if !errors.Is(err, wantErr) {
+			t.Errorf("StrandLive() error = %v; want it to wrap %v", err, wantErr)
+		}
+	})
+}
+
+// TestTurnEndedAfter pins TurnEndedAfter over an engine without the SessionSignalParser capability: the newest ParseEvents event decides, and the offset skips the load turns.
+func TestTurnEndedAfter(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	dir := t.TempDir()
+	eventsPath := filepath.Join(dir, "events.jsonl")
+	// turnEnded reads the events from the start of the file.
+	turnEnded := func(path string, engine shuttleengine.Engine) (bool, error) {
+		return TurnEndedAfter(path, 0, engine, TurnEndRead{})
+	}
+
+	t.Run("missing events file is false, nil", func(t *testing.T) {
+		t.Parallel()
+		ended, err := turnEnded(filepath.Join(dir, "absent.jsonl"), &shuttlefake.Engine{})
+		if err != nil {
+			t.Fatalf("TurnEndedAfter() error = %v; want nil", err)
+		}
+		if ended {
+			t.Errorf("TurnEndedAfter() = true for a missing events file; want false")
+		}
+	})
+
+	if err := os.WriteFile(eventsPath, []byte("irrelevant bytes; the engine ignores them"), 0o644); err != nil {
+		t.Fatalf("write events file %s: %v", eventsPath, err)
+	}
+
+	t.Run("no Stop event is false", func(t *testing.T) {
+		t.Parallel()
+		ended, err := turnEnded(eventsPath, &shuttlefake.Engine{Events: []shuttleengine.Event{{Kind: shuttleengine.EventAsk, Message: "still working"}}})
+		if err != nil {
+			t.Fatalf("TurnEndedAfter() error = %v; want nil", err)
+		}
+		if ended {
+			t.Errorf("TurnEndedAfter() = true with only an EventAsk; want false")
+		}
+	})
+
+	t.Run("a newest Stop event is true", func(t *testing.T) {
+		t.Parallel()
+		ended, err := turnEnded(eventsPath, &shuttlefake.Engine{Events: []shuttleengine.Event{
+			{Kind: shuttleengine.EventAsk, Message: "mid-turn probe"},
+			{Kind: shuttleengine.EventStop, Message: "final message"},
+		}})
+		if err != nil {
+			t.Fatalf("TurnEndedAfter() error = %v; want nil", err)
+		}
+		if !ended {
+			t.Errorf("TurnEndedAfter() = false with a Stop event present; want true")
+		}
+	})
+
+	t.Run("a ParseEvents error propagates", func(t *testing.T) {
+		t.Parallel()
+		wantErr := errors.New("boom")
+		_, err := turnEnded(eventsPath, &shuttlefake.Engine{EventsErr: wantErr})
+		if err == nil {
+			t.Fatalf("TurnEndedAfter() error = nil; want a wrapped error")
+		}
+		if !errors.Is(err, wantErr) {
+			t.Errorf("TurnEndedAfter() error = %v; want it to wrap %v", err, wantErr)
+		}
+	})
+
+	t.Run("a skill-load turn end before the offset is not counted", func(t *testing.T) {
+		t.Parallel()
+		loadTurn := "load-turn-stop\n"
+		path := filepath.Join(dir, "offset-events.jsonl")
+		if err := os.WriteFile(path, []byte(loadTurn+"prompt-turn-working\n"), 0o644); err != nil {
+			t.Fatalf("write events file %s: %v", path, err)
+		}
+		engine := &shuttlefake.Engine{ParseEventsFn: func(data []byte) ([]shuttleengine.Event, error) {
+			if strings.Contains(string(data), "load-turn-stop") {
+				return []shuttleengine.Event{{Kind: shuttleengine.EventStop, Message: "skills loaded"}}, nil
+			}
+			return nil, nil
+		}}
+		if ended, err := TurnEndedAfter(path, 0, engine, TurnEndRead{}); err != nil || !ended {
+			t.Fatalf("TurnEndedAfter(offset 0) = %v, %v; want true, nil (the load turn's Stop is in range)", ended, err)
+		}
+		if ended, err := TurnEndedAfter(path, int64(len(loadTurn)), engine, TurnEndRead{}); err != nil || ended {
+			t.Errorf("TurnEndedAfter(past the load turn) = %v, %v; want false, nil", ended, err)
+		}
+	})
+}
