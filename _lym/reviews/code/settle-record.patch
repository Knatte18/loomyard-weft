new file mode 100644
index 00000000..76c5db44
--- /dev/null
+++ b/internal/slackengine/outbound.go
@@ -0,0 +1,243 @@
+// outbound.go is the relay's read of its own mailbox: it posts the orchs' and programs' mail for `<shortname>:SLACK` to the channel at least once and never twice for one acknowledged read.
+
+package slackengine
+
+import (
+	"cmp"
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+const (
+	// outboundReadTimeout bounds one read of the mailbox: the wait for mail, the posting and creel's confirmation together.
+	outboundReadTimeout = 60 * time.Second
+	// postingBudget is how long one read posts before it releases the rest, inside creel's 30-second acknowledgement window.
+	postingBudget = 25 * time.Second
+	// staleMailAge is the age past which mail is acknowledged without being posted.
+	staleMailAge = 24 * time.Hour
+	// refusalCap is how many times Slack may refuse one message with an error code before the relay drops it.
+	refusalCap = 5
+)
+
+// errReadBudget is what a read's handler returns when its posting budget ended, so creel releases the read with the rest unposted.
+var errReadBudget = errors.New("slack: the posting budget of one read ended; the rest waits for the next read")
+
+// errOutboxWrite marks a failed write of the outbox file.
+var errOutboxWrite = errors.New("slack: write the outbox file")
+
+// outboxRecord is the outbox file's content.
+// Handled holds the messages of a read not yet acknowledged that are done.
+// Refusals holds how often Slack refused each other message.
+// Stale counts the done messages that were stale mail whose count line is not yet posted.
+type outboxRecord struct {
+	Handled  []int64       `json:"handled,omitempty"`
+	Refusals map[int64]int `json:"refusals,omitempty"`
+	Stale    int           `json:"stale,omitempty"`
+}
+
+// outbound is the relay's outbound read of its mailbox.
+type outbound struct {
+	geom    Geometry
+	mailbox Mailbox
+	slack   SlackClient
+	clock   Clock
+	wait    *loopWait
+}
+
+func newOutbound(geom Geometry, mailbox Mailbox, slack SlackClient, clock Clock, floor *sharedFloor) *outbound {
+	return &outbound{geom: geom, mailbox: mailbox, slack: slack, clock: clock, wait: newLoopWait(floor)}
+}
+
+// read waits for mail in the relay's mailbox and posts it to the channel, and returns how long to wait before the next read.
+// The wait is the floor after mail arrived, doubled after a read with none, and a rate limit's retry wait.
+// The mail is acknowledged only when creel confirms it, and the outbox record keeps each message already handled until then, so a read creel redelivers posts nothing twice.
+// A failed post returns its error with the read released; the record stays until a confirmed acknowledgement clears it.
+func (out *outbound) read(ctx context.Context) (time.Duration, error) {
+	setup, found, err := ReadSetup(out.geom.SetupPath)
+	if err != nil {
+		return out.wait.afterIdle(), err
+	}
+	if !found {
+		return out.wait.afterIdle(), fmt.Errorf("slack: the setup file %s is gone; way forward: run `lym slack setup --channel <id> --operator <user-id>` from the operator's terminal", out.geom.SetupPath)
+	}
+	handlerRan := false
+	err = out.mailbox.ReadWait(outboundReadTimeout, func(messages []creelengine.Message) error {
+		handlerRan = true
+		return out.post(ctx, setup, messages)
+	})
+	switch {
+	case err == nil:
+		return out.wait.afterActivity(), writeOutbox(out.geom, outboxRecord{})
+	case errors.Is(err, errReadBudget):
+		return out.wait.afterActivity(), nil
+	case errors.Is(err, creelengine.ErrWaitTimeout) && !handlerRan:
+		return out.wait.afterIdle(), nil
+	}
+	if limit, ok := isRateLimit(err); ok {
+		return out.wait.afterRateLimit(limit), err
+	}
+	if handlerRan {
+		return out.wait.afterActivity(), err
+	}
+	return out.wait.afterIdle(), err
+}
+
+// post is the read's handler: it posts each message not yet in the outbox record, oldest first, and records each once it is done.
+// Whether the messages all posted or the read ends early, it then posts the one line naming the stale mail the record counts, so that line survives a failed read.
+// A line that fails to post stays counted in the record for the next read; its failure is returned only when the messages themselves posted.
+// The line waits for the next read when the read ended on a rate limit, which a further call would only prolong, or on a failed write of the record, which would let the line post twice.
+func (out *outbound) post(ctx context.Context, setup Setup, messages []creelengine.Message) error {
+	record, err := readOutbox(out.geom)
+	if err != nil {
+		return err
+	}
+	postErr := out.postMessages(ctx, setup, &record, messages)
+	if _, limited := isRateLimit(postErr); limited || errors.Is(postErr, errOutboxWrite) {
+		return postErr
+	}
+	reportErr := out.reportStale(ctx, setup, &record)
+	if postErr != nil {
+		if reportErr != nil {
+			logger.Warn("slackengine: the line about stale mail was not posted", "error", reportErr)
+		}
+		return postErr
+	}
+	return reportErr
+}
+
+// reportStale posts the line naming the stale mail the record counts, then clears the count in the record and writes it.
+// It posts nothing when the record counts none, and on a failed post leaves the count in place.
+func (out *outbound) reportStale(ctx context.Context, setup Setup, record *outboxRecord) error {
+	if record.Stale == 0 {
+		return nil
+	}
+	line := fmt.Sprintf("%d messages older than 24 hours were not posted; read them with `lym creel log --to %s`", record.Stale, out.relayName())
+	if err := out.slack.PostMessage(ctx, setup.ChannelID, line); err != nil {
+		return fmt.Errorf("slack: post the line about stale mail: %w", err)
+	}
+	record.Stale = 0
+	return writeOutbox(out.geom, *record)
+}
+
+// postMessages posts each message of messages not yet in record, oldest first, and writes the record after each one it is done with.
+// Mail older than staleMailAge is counted in the record instead of posted.
+// It returns errReadBudget once the posting budget ends, and the error of a failed post or write.
+func (out *outbound) postMessages(ctx context.Context, setup Setup, record *outboxRecord, messages []creelengine.Message) error {
+	messages = slices.Clone(messages)
+	slices.SortFunc(messages, func(a, b creelengine.Message) int { return cmp.Compare(a.ID, b.ID) })
+	started := out.clock.Now()
+	for _, message := range messages {
+		if slices.Contains(record.Handled, message.ID) {
+			continue
+		}
+		if out.clock.Now().Sub(started) >= postingBudget {
+			return errReadBudget
+		}
+		if out.clock.Now().Sub(message.Posted) > staleMailAge {
+			record.Stale++
+		} else if text, ok := outboundText(out.geom.Shortname, message); !ok {
+			logger.Warn("slackengine: dropped mail from a sender the relay does not post", "id", message.ID, "from", message.From)
+		} else if err := out.slack.PostMessage(ctx, setup.ChannelID, text); err != nil {
+			dropped, refuseErr := out.refused(ctx, setup, record, message, err)
+			if !dropped {
+				return refuseErr
+			}
+		}
+		record.Handled = append(record.Handled, message.ID)
+		delete(record.Refusals, message.ID)
+		if err := writeOutbox(out.geom, *record); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// refused counts Slack's refusal of message in the record and writes it.
+// It reports dropped true once the refusal count reaches refusalCap, after posting one line that names the message;
+// a failure that is no refusal, a transport failure, a server error or a rate limit, counts toward no cap.
+// Otherwise it returns err so the read is released with the message queued.
+func (out *outbound) refused(ctx context.Context, setup Setup, record *outboxRecord, message creelengine.Message, err error) (bool, error) {
+	if _, ok := isAPIError(err); !ok {
+		return false, err
+	}
+	if record.Refusals == nil {
+		record.Refusals = map[int64]int{}
+	}
+	record.Refusals[message.ID]++
+	if record.Refusals[message.ID] < refusalCap {
+		if writeErr := writeOutbox(out.geom, *record); writeErr != nil {
+			return false, errors.Join(err, writeErr)
+		}
+		return false, err
+	}
+	line := fmt.Sprintf("message %d from %s was refused by Slack %d times and is dropped; read it with `lym creel log --to %s`", message.ID, message.From, refusalCap, out.relayName())
+	if postErr := out.slack.PostMessage(ctx, setup.ChannelID, line); postErr != nil {
+		logger.Warn("slackengine: the line about a dropped message was not posted", "id", message.ID, "error", postErr)
+	}
+	return true, nil
+}
+
+// relayName returns the relay's creel program name, `<shortname>:SLACK`.
+func (out *outbound) relayName() string {
+	return out.geom.Shortname + ":" + SlackProgram
+}
+
+// outboundText renders mail for the channel as `[<sender>] <body>`, escaped, and reports false for a sender the relay does not post.
+// The relay posts an orch strand and any program of the hub but the one for an unplaced sender.
+// Mail from a beam ends with how to answer it, `(answer: @<slug> …)`.
+func outboundText(shortname string, message creelengine.Message) (string, bool) {
+	slug := ""
+	if creelengine.IsOrchStrand(message.From) {
+		slug = agentname.TaskSlug(message.From)
+	} else {
+		programShortname, name, err := agentname.ParseProgram(message.From)
+		if err != nil || programShortname != shortname || name == agentname.External {
+			return "", false
+		}
+		slug = programSlug(message.From, programShortname, name)
+	}
+	text := slackEscape.Replace(fmt.Sprintf("[%s] %s", message.From, message.Body))
+	if slug != "" {
+		text += fmt.Sprintf(" (answer: @%s …)", slug)
+	}
+	return text, true
+}
+
+// programSlug returns the beam slug of a program sender of the form `<shortname>:<slug>:<NAME>`, empty for the two-segment form.
+func programSlug(from, shortname, name string) string {
+	middle, found := strings.CutPrefix(from, shortname+":")
+	if !found {
+		return ""
+	}
+	slug, found := strings.CutSuffix(middle, ":"+name)
+	if !found || agentname.ValidateSlug(slug) != nil {
+		return ""
+	}
+	return slug
+}
+
+// readOutbox returns the outbox record, empty when none is written.
+func readOutbox(geom Geometry) (outboxRecord, error) {
+	record, _, err := state.ReadJSON[outboxRecord](geom.OutboxPath, recordLockPath(geom.OutboxPath))
+	if err != nil {
+		return outboxRecord{}, fmt.Errorf("slack: read the outbox file %s: %w", geom.OutboxPath, err)
+	}
+	return record, nil
+}
+
+// writeOutbox stores record in the outbox file.
+func writeOutbox(geom Geometry, record outboxRecord) error {
+	if err := state.WriteJSON(geom.OutboxPath, recordLockPath(geom.OutboxPath), record); err != nil {
+		return fmt.Errorf("%w %s: %w", errOutboxWrite, geom.OutboxPath, err)
+	}
+	return nil
+}
diff --git a/internal/slackengine/outbound_test.go b/internal/slackengine/outbound_test.go
new file mode 100644
index 00000000..0f670b48
--- /dev/null
+++ b/internal/slackengine/outbound_test.go
@@ -0,0 +1,323 @@
+// outbound_test.go covers the outbound read of the relay's mailbox over the in-memory seams of inbound_test.go.
+
+package slackengine_test
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/slackengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// outboundHarness is an outbound read over the harness's seams.
+type outboundHarness struct {
+	*harness
+	out *slackengine.Outbound
+}
+
+func newOutboundHarness(t *testing.T) *outboundHarness {
+	t.Helper()
+	h := newHarness(t)
+	return &outboundHarness{harness: h, out: slackengine.NewOutbound(h.geom, h.mailbox, h.slack, h.clock)}
+}
+
+// mailFrom returns a message of id from sender, posted a minute before the harness's clock.
+func (h *outboundHarness) mailFrom(id int64, from, body string) creelengine.Message {
+	return creelengine.Message{ID: id, From: from, Body: body, Kind: "mail", Posted: h.clock.Now().Add(-time.Minute)}
+}
+
+func (h *outboundHarness) read() (time.Duration, error) {
+	h.t.Helper()
+	return h.out.Read(context.Background())
+}
+
+func (h *outboundHarness) mustRead() time.Duration {
+	h.t.Helper()
+	wait, err := h.read()
+	if err != nil {
+		h.t.Fatalf("Read = %v", err)
+	}
+	return wait
+}
+
+func (h *outboundHarness) wantAcks(want ...[]int64) {
+	h.t.Helper()
+	if got := h.mailbox.acknowledged(); !cmp.Equal(got, append([][]int64(nil), want...)) && !(len(got) == 0 && len(want) == 0) {
+		h.t.Errorf("acknowledgements mismatch (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestOutboundRead(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("MailFromOrchProgramAndReplyIsPostedOnceAndAcknowledged", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		reply := h.mailFrom(3, "ly:orch", "answer")
+		reply.Kind, reply.ReplyTo = "reply", 9
+		h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{
+			h.mailFrom(1, "ly:orch", "hello"), h.mailFrom(2, "ly:BATTEN", "done"), reply,
+		}})
+		if wait := h.mustRead(); wait != slackengine.Floor {
+			t.Errorf("Read wait = %s; want the floor %s", wait, slackengine.Floor)
+		}
+		h.wantAnswers("[ly:orch] hello", "[ly:BATTEN] done", "[ly:orch] answer")
+		h.wantAcks([]int64{1, 2, 3})
+	})
+
+	t.Run("TextIsEscapedAndBeamMailCarriesTheAnswerHint", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{
+			h.mailFrom(1, "ly:orch", "a & <b>"),
+			h.mailFrom(2, "ly:payments:orch", "x"),
+			h.mailFrom(3, "ly:payments:DOBBY", "y"),
+		}})
+		h.mustRead()
+		h.wantAnswers(
+			"[ly:orch] a &amp; &lt;b&gt;",
+			"[ly:payments:orch] x (answer: @payments …)",
+			"[ly:payments:DOBBY] y (answer: @payments …)",
+		)
+	})
+
+	t.Run("NonOrchStrandAndExternalMailIsDroppedAndAcknowledged", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{
+			h.mailFrom(1, "ly:payments:worker", "from a strand"),
+			h.mailFrom(2, "ly:EXTERNAL", "from outside"),
+		}})
+		h.mustRead()
+		h.wantAnswers()
+		h.wantAcks([]int64{1, 2})
+	})
+
+	t.Run("SlackFailureMidReadPostsEachMessageExactlyOnce", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		batch := []creelengine.Message{h.mailFrom(1, "ly:orch", "one"), h.mailFrom(2, "ly:orch", "two"), h.mailFrom(3, "ly:orch", "three")}
+		h.mailbox.scriptReadWait(readStep{messages: batch}, readStep{messages: batch})
+		h.slack.failPosts(nil, errors.New("slack down"))
+		if wait, err := h.read(); err == nil || wait != slackengine.Floor {
+			t.Fatalf("Read = %s, %v; want the post error and the floor", wait, err)
+		}
+		h.wantAcks()
+		h.mustRead()
+		h.wantAnswers("[ly:orch] one", "[ly:orch] two", "[ly:orch] three")
+		h.wantAcks([]int64{1, 2, 3})
+	})
+
+	t.Run("MessageSlackRefusesFiveTimesIsDroppedWhetherOrNotTheReplacementLinePosts", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name string
+			// replacementFailure is what the post of the replacement line itself answers; nil posts it.
+			replacementFailure error
+			wantLine           bool
+		}{
+			{"ReplacementLinePosts", nil, true},
+			{"ReplacementLinePostFails", errors.New("slack down"), false},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newOutboundHarness(t)
+				refusal := &slackengine.APIError{Method: "chat.postMessage", Code: "msg_too_long"}
+				h.slack.failPosts(refusal, refusal, refusal, refusal, refusal, tt.replacementFailure)
+				for range 5 {
+					h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{h.mailFrom(7, "ly:orch", "huge")}})
+				}
+				for i := range 4 {
+					if _, err := h.read(); !errors.Is(err, refusal) {
+						t.Fatalf("Read #%d = %v; want the refusal", i+1, err)
+					}
+				}
+				h.wantAcks()
+				h.mustRead()
+				answers := h.slack.texts()
+				switch {
+				case tt.wantLine && (len(answers) != 1 || !strings.Contains(answers[0], "message 7") || !strings.Contains(answers[0], "ly:orch") || !strings.Contains(answers[0], "lym creel log --to ly:SLACK")):
+					t.Errorf("answers = %q; want one line naming message 7, its sender and the log command", answers)
+				case !tt.wantLine && len(answers) != 0:
+					t.Errorf("answers = %q; want none, the replacement line failed", answers)
+				}
+				h.wantAcks([]int64{7})
+				if calls := h.slack.callCount(); calls != 6 {
+					t.Errorf("Slack calls = %d; want 6, five refusals and one try of the replacement line, so the message is not retried", calls)
+				}
+				record, err := os.ReadFile(h.geom.OutboxPath)
+				if err != nil || strings.Contains(string(record), "refusals") {
+					t.Errorf("outbox record = %q, %v; want no refusal count after the acknowledgement", record, err)
+				}
+			})
+		}
+	})
+
+	t.Run("TransportFailureAndServerErrorNeverCapOutAMessage", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name string
+			err  error
+		}{
+			{"TransportFailure", errors.New("slack: call chat.postMessage: connection reset")},
+			{"ServerError", errors.New("slack: chat.postMessage answered HTTP 500")},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newOutboundHarness(t)
+				for range 7 {
+					h.slack.failPosts(tt.err)
+					h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{h.mailFrom(1, "ly:orch", "keep me")}})
+					if _, err := h.read(); !errors.Is(err, tt.err) {
+						t.Fatalf("Read = %v; want the failure", err)
+					}
+				}
+				h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{h.mailFrom(1, "ly:orch", "keep me")}})
+				h.mustRead()
+				h.wantAnswers("[ly:orch] keep me")
+				h.wantAcks([]int64{1})
+			})
+		}
+	})
+
+	t.Run("BacklogPastThePostingBudgetIsReleasedAndPostedOnceAcrossReads", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		h.slack.onPost = func() { h.clock.Advance(15 * time.Second) }
+		batch := []creelengine.Message{h.mailFrom(1, "ly:orch", "one"), h.mailFrom(2, "ly:orch", "two"), h.mailFrom(3, "ly:orch", "three")}
+		h.mailbox.scriptReadWait(readStep{messages: batch}, readStep{messages: batch})
+		h.mustRead()
+		h.wantAnswers("[ly:orch] one", "[ly:orch] two")
+		h.wantAcks()
+		h.mustRead()
+		h.wantAnswers("[ly:orch] one", "[ly:orch] two", "[ly:orch] three")
+		h.wantAcks([]int64{1, 2, 3})
+	})
+
+	t.Run("MailOlderThanADayIsAcknowledgedUnpostedWithOneCountLine", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		old1, old2 := h.mailFrom(1, "ly:orch", "old"), h.mailFrom(2, "ly:orch", "older")
+		old1.Posted, old2.Posted = h.clock.Now().Add(-25*time.Hour), h.clock.Now().Add(-48*time.Hour)
+		h.mailbox.scriptReadWait(readStep{messages: []creelengine.Message{old1, old2, h.mailFrom(3, "ly:orch", "fresh")}})
+		h.mustRead()
+		answers := h.slack.texts()
+		if len(answers) != 2 || answers[0] != "[ly:orch] fresh" || !strings.Contains(answers[1], "2 messages") || !strings.Contains(answers[1], "lym creel log --to ly:SLACK") {
+			t.Errorf("answers = %q; want the fresh mail and one line naming the count and the log command", answers)
+		}
+		h.wantAcks([]int64{1, 2, 3})
+	})
+
+	t.Run("StaleMailCountLineSurvivesAFailedReadAndPostsOnce", func(t *testing.T) {
+		t.Parallel()
+		slackDown := errors.New("slack down")
+		tests := []struct {
+			name string
+			// failures are the answers of the first posts: the fresh message's, then the count line's.
+			failures []error
+			// wantLineIndex is where the count line stands among the texts Slack accepted.
+			wantLineIndex int
+		}{
+			{"LinePostsBeforeTheFailedReadReleases", []error{slackDown}, 0},
+			{"LineThatFailsToPostWaitsForTheNextRead", []error{slackDown, slackDown}, 1},
+			{"LineWaitsOutARateLimitInsteadOfPostingIntoIt", []error{&slackengine.RateLimitError{Method: "chat.postMessage", RetryAfter: time.Second}}, 1},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newOutboundHarness(t)
+				old1, old2 := h.mailFrom(1, "ly:orch", "old"), h.mailFrom(2, "ly:orch", "older")
+				old1.Posted, old2.Posted = h.clock.Now().Add(-25*time.Hour), h.clock.Now().Add(-48*time.Hour)
+				batch := []creelengine.Message{old1, old2, h.mailFrom(3, "ly:orch", "fresh")}
+				h.mailbox.scriptReadWait(readStep{messages: batch}, readStep{messages: batch})
+				h.slack.failPosts(tt.failures...)
+				if _, err := h.read(); !errors.Is(err, tt.failures[0]) {
+					t.Fatalf("Read = %v; want the failed post", err)
+				}
+				h.wantAcks()
+				h.mustRead()
+				answers := h.slack.texts()
+				if len(answers) != 2 || answers[1-tt.wantLineIndex] != "[ly:orch] fresh" ||
+					!strings.Contains(answers[tt.wantLineIndex], "2 messages") || !strings.Contains(answers[tt.wantLineIndex], "lym creel log --to ly:SLACK") {
+					t.Errorf("answers = %q; want the fresh mail once and one count line naming 2 messages at index %d", answers, tt.wantLineIndex)
+				}
+				h.wantAcks([]int64{1, 2, 3})
+			})
+		}
+	})
+
+	t.Run("RefusedAcknowledgementKeepsTheRecordSoNothingIsRepostedTwice", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		batch := []creelengine.Message{h.mailFrom(1, "ly:orch", "once")}
+		h.mailbox.scriptReadWait(readStep{messages: batch, ackErr: errors.New("daemon refused")}, readStep{messages: batch})
+		if _, err := h.read(); err == nil {
+			t.Fatalf("Read = nil; want the refused acknowledgement")
+		}
+		h.mustRead()
+		h.wantAnswers("[ly:orch] once")
+		h.wantAcks([]int64{1})
+	})
+
+	t.Run("RateLimitReturnsItsRetryAfterAndRaisesTheFloor", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		batch := []creelengine.Message{h.mailFrom(1, "ly:orch", "limited")}
+		h.mailbox.scriptReadWait(readStep{messages: batch}, readStep{messages: batch})
+		h.slack.failPosts(&slackengine.RateLimitError{Method: "chat.postMessage", RetryAfter: 7 * time.Second})
+		var limit *slackengine.RateLimitError
+		if wait, err := h.read(); !errors.As(err, &limit) || wait != 7*time.Second {
+			t.Fatalf("Read = %s, %v; want the 7-second retry wait", wait, err)
+		}
+		if wait := h.mustRead(); wait != 2*slackengine.Floor {
+			t.Errorf("Read wait after the limit = %s; want the doubled floor %s", wait, 2*slackengine.Floor)
+		}
+	})
+
+	t.Run("EmptyWaitBacksOffAndKeepsTheRecord", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		batch := []creelengine.Message{h.mailFrom(1, "ly:orch", "once")}
+		h.mailbox.scriptReadWait(readStep{messages: batch, ackErr: errors.New("daemon refused")})
+		if _, err := h.read(); err == nil {
+			t.Fatalf("Read = nil; want the refused acknowledgement")
+		}
+		var waits []time.Duration
+		for range 6 {
+			waits = append(waits, h.mustRead())
+		}
+		if want := []time.Duration{2 * slackengine.Floor, 4 * slackengine.Floor, 8 * slackengine.Floor, slackengine.Ceiling, slackengine.Ceiling, slackengine.Ceiling}; !cmp.Equal(waits, want) {
+			t.Errorf("idle waits = %v; want %v", waits, want)
+		}
+		h.mailbox.scriptReadWait(readStep{messages: batch})
+		h.mustRead()
+		h.wantAnswers("[ly:orch] once")
+	})
+
+	t.Run("TimeoutAfterTheHandlerRanKeepsTheRecordAndReturnsTheFloor", func(t *testing.T) {
+		t.Parallel()
+		h := newOutboundHarness(t)
+		batch := []creelengine.Message{h.mailFrom(1, "ly:orch", "once")}
+		h.mailbox.scriptReadWait(
+			readStep{messages: batch, timeoutAfterHandler: true},
+			readStep{messages: batch, timeoutAfterHandler: true},
+		)
+		for i := range 2 {
+			if wait, err := h.read(); wait != slackengine.Floor || !errors.Is(err, creelengine.ErrWaitTimeout) {
+				t.Fatalf("Read #%d = %s, %v; want the floor with the lost confirmation", i+1, wait, err)
+			}
+		}
+		h.wantAnswers("[ly:orch] once")
+	})
+}
diff --git a/internal/slackengine/presence.go b/internal/slackengine/presence.go
new file mode 100644
index 00000000..1e651b71
--- /dev/null
+++ b/internal/slackengine/presence.go
@@ -0,0 +1,76 @@
+// presence.go holds the hub's presence record: whether the operator is at the terminal or in Slack.
+
+package slackengine
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// Presence says where the operator is: at the terminal or in Slack.
+type Presence string
+
+const (
+	// PresenceTerminal means the operator works at the terminal; it is the presence of a hub with no record.
+	PresenceTerminal Presence = "terminal"
+	// PresenceSlack means the operator is away and talks to the hub through Slack.
+	PresenceSlack Presence = "slack"
+)
+
+// presenceRecord is the presence file's content.
+type presenceRecord struct {
+	Presence  Presence  `json:"presence"`
+	ChangedAt time.Time `json:"changed_at"`
+}
+
+// valid reports whether presence is one of the two values the record may hold.
+func (presence Presence) valid() bool {
+	return presence == PresenceTerminal || presence == PresenceSlack
+}
+
+// unknownPresenceError is the error of a presence file holding a value that is neither presence.
+func unknownPresenceError(path string, presence Presence) error {
+	return fmt.Errorf("slack: the presence file %s holds %q; want %q or %q", path, presence, PresenceTerminal, PresenceSlack)
+}
+
+// ReadPresence returns the presence stored at path, PresenceTerminal when no file exists.
+// A stored value that is neither presence is an error naming the file.
+func ReadPresence(path string) (Presence, error) {
+	record, found, err := state.ReadJSON[presenceRecord](path, recordLockPath(path))
+	if err != nil {
+		return "", fmt.Errorf("slack: read the presence file %s: %w", path, err)
+	}
+	if !found {
+		return PresenceTerminal, nil
+	}
+	if !record.Presence.valid() {
+		return "", unknownPresenceError(path, record.Presence)
+	}
+	return record.Presence, nil
+}
+
+// WritePresence stores presence at path with now as its change time, and reports whether the stored value changed, so a caller sends its notices only on a change.
+// A missing file counts as PresenceTerminal; a stored value that is neither presence is an error naming the file.
+func WritePresence(path string, presence Presence, now time.Time) (bool, error) {
+	changed := false
+	err := state.UpdateJSON(path, recordLockPath(path), func(current presenceRecord, found bool) (presenceRecord, error) {
+		stored := PresenceTerminal
+		if found {
+			if !current.Presence.valid() {
+				return current, unknownPresenceError(path, current.Presence)
+			}
+			stored = current.Presence
+		}
+		if found && stored == presence {
+			return current, nil
+		}
+		changed = stored != presence
+		return presenceRecord{Presence: presence, ChangedAt: now}, nil
+	})
+	if err != nil {
+		return false, fmt.Errorf("slack: write the presence file %s: %w", path, err)
+	}
+	return changed, nil
+}
diff --git a/internal/slackengine/relay.go b/internal/slackengine/relay.go
new file mode 100644
index 00000000..0e91c8f7
--- /dev/null
+++ b/internal/slackengine/relay.go
@@ -0,0 +1,344 @@
+// relay.go is the relay process's life: its lock, first creel read, inbound loop, outbound goroutine, re-exec onto a replaced binary and log, and the wait before it takes its lock.
+
+package slackengine
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// ErrRelayInStrandPane is what RunRelay returns when creel refused the relay's program claim because the relay runs in a strand's pane that is no orch's.
+var ErrRelayInStrandPane = errors.New("slack: the relay runs in a strand pane that is no orch's")
+
+// errFirstReadAccepted is what the first read's handler returns, so the read is accepted and any mail it saw stays unread for the outbound read.
+var errFirstReadAccepted = errors.New("slack: the first read was accepted and its mail left for the outbound read")
+
+// RelayDeps is every seam RunRelay is told.
+type RelayDeps struct {
+	// Mailbox is the relay's creel mailbox.
+	Mailbox Mailbox
+	// Slack is the Slack client; RunRelay records each of its successful calls.
+	Slack SlackClient
+	// Hub reads the hub's beams and pauses.
+	Hub Hub
+	// Clock is the relay's time.
+	Clock Clock
+	// PID returns the relay's process id.
+	PID func() int
+	// ReexecLockWait is how long a re-exec waits for the lock its old image released at the exec; zero waits only lock.ProbeGrace.
+	ReexecLockWait time.Duration
+	// CheckBinary re-execs onto a replaced lym binary and returns when the binary is unchanged.
+	// It calls beforeExec right before an exec and failed with the error of an exec that failed.
+	CheckBinary func(beforeExec func(), failed func(error))
+	// ReapInherited waits in the background on the children the replaced image started.
+	ReapInherited func() error
+	// Register records the relay process in the hub's run-process owner records.
+	Register func() error
+}
+
+// relayLock is the lock a live relay holds, which a re-exec gives up and takes back.
+type relayLock struct {
+	path string
+	held *lock.FileLock
+}
+
+// release gives up the lock; releasing a lock not held does nothing.
+func (l *relayLock) release() {
+	if l.held == nil {
+		return
+	}
+	if err := l.held.Release(); err != nil {
+		logger.Warn("slackengine: could not release the relay lock", "path", l.path, "error", err)
+	}
+	l.held = nil
+}
+
+// retake takes the lock again, waiting lock.ProbeGrace for a probe that holds it for a moment, and reports whether it did.
+func (l *relayLock) retake() bool {
+	held, acquired, err := lock.AcquireWriteLockWithin(l.path, lock.ProbeGrace)
+	if err != nil || !acquired {
+		return false
+	}
+	l.held = held
+	return true
+}
+
+// relayLog writes the relay's failures to its log file, and to the process log once per episode.
+type relayLog struct {
+	geom     Geometry
+	clock    Clock
+	episodes logger.EpisodeSet
+}
+
+// fail appends a line for err under key to the relay log and counts it in key's episode.
+func (l *relayLog) fail(key string, err error) {
+	l.episodes.Fail(key, "slackengine: the relay hit a failure", "kind", key, "error", err)
+	l.appendLine(fmt.Sprintf("%s %s: %v", l.clock.Now().UTC().Format(time.RFC3339), key, err))
+}
+
+// recovered ends key's episode.
+func (l *relayLog) recovered(key string) {
+	l.episodes.Recover(key, "slackengine: the relay recovered", "kind", key)
+}
+
+// appendLine appends line to the relay log; a log that cannot be written is logged at Debug.
+func (l *relayLog) appendLine(line string) {
+	if err := os.MkdirAll(filepath.Dir(l.geom.LogPath), privateDirMode); err != nil {
+		logger.Debug("slackengine: could not create the relay log directory", "path", l.geom.LogPath, "error", err)
+		return
+	}
+	file, err := os.OpenFile(l.geom.LogPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o600)
+	if err != nil {
+		logger.Debug("slackengine: could not open the relay log", "path", l.geom.LogPath, "error", err)
+		return
+	}
+	defer file.Close()
+	if _, err := fmt.Fprintln(file, line); err != nil {
+		logger.Debug("slackengine: could not write the relay log", "path", l.geom.LogPath, "error", err)
+	}
+}
+
+// recordingSlack is a SlackClient that stamps LastSlackOK in the relay state after each call that succeeds.
+type recordingSlack struct {
+	inner SlackClient
+	geom  Geometry
+	clock Clock
+	log   *relayLog
+}
+
+func (s *recordingSlack) stamp(err error) {
+	if err != nil {
+		return
+	}
+	now := s.clock.Now()
+	if writeErr := updateRelayState(s.geom, func(relayState *RelayState) { relayState.LastSlackOK = now }); writeErr != nil {
+		s.log.fail("relay-state", writeErr)
+	}
+}
+
+func (s *recordingSlack) History(ctx context.Context, channel, oldest string) ([]Message, error) {
+	messages, err := s.inner.History(ctx, channel, oldest)
+	s.stamp(err)
+	return messages, err
+}
+
+func (s *recordingSlack) Latest(ctx context.Context, channel string) (string, bool, error) {
+	ts, found, err := s.inner.Latest(ctx, channel)
+	s.stamp(err)
+	return ts, found, err
+}
+
+func (s *recordingSlack) PostMessage(ctx context.Context, channel, text string) error {
+	err := s.inner.PostMessage(ctx, channel, text)
+	s.stamp(err)
+	return err
+}
+
+// updateRelayState applies mutate to the relay state under the record's lock, so the relay's writes and the starter's keep each other's fields.
+func updateRelayState(geom Geometry, mutate func(*RelayState)) error {
+	err := state.UpdateJSON(geom.RelayStatePath, recordLockPath(geom.RelayStatePath), func(current RelayState, _ bool) (RelayState, error) {
+		mutate(&current)
+		return current, nil
+	})
+	if err != nil {
+		return fmt.Errorf("slack: write the relay state %s: %w", geom.RelayStatePath, err)
+	}
+	return nil
+}
+
+// waitFor waits d on clock and reports false when ctx ended first.
+func waitFor(ctx context.Context, clock Clock, d time.Duration) bool {
+	select {
+	case <-clock.After(d):
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
+
+// RunRelay runs the hub's relay until ctx ends, and returns nil when it ends or another relay holds the lock.
+// It refuses a hub with no token or no setup file.
+// It takes the relay lock, registers itself and records its pid, makes its first creel read before any Slack call, then polls the channel and reads its own mailbox, each loop on its own wait.
+// A creel refusal of the program claim from a strand's pane that is no orch's returns ErrRelayInStrandPane with the lock released; any other first-read refusal is retried while the lock is held.
+// At each poll it checks whether the lym binary was replaced and re-execs onto it, so a relay that cannot re-exec retakes its lock, or exits when another relay holds it.
+func RunRelay(ctx context.Context, geom Geometry, deps RelayDeps) error {
+	if _, _, err := RequireConfigured(geom); err != nil {
+		return err
+	}
+	if err := deps.ReapInherited(); err != nil {
+		logger.Warn("slackengine: could not wait on the children the replaced image started", "error", err)
+	}
+	heldLock, err := takeRelayLock(geom, deps)
+	if err != nil {
+		return err
+	}
+	if heldLock == nil {
+		logger.Info("slackengine: another relay holds the lock; this one exits", "lock", geom.LockPath)
+		return nil
+	}
+	defer heldLock.release()
+
+	if err := deps.Register(); err != nil {
+		return fmt.Errorf("slack: register the relay: %w", err)
+	}
+	pid := deps.PID()
+	startTime, _ := proc.StartTime(pid)
+	if err := updateRelayState(geom, func(relayState *RelayState) {
+		relayState.PID, relayState.StartTime = pid, startTime
+		relayState.FirstReadAt, relayState.FirstReadRefusal = time.Time{}, ""
+	}); err != nil {
+		return err
+	}
+
+	log := &relayLog{geom: geom, clock: deps.Clock}
+	floor := newSharedFloor()
+	if err := firstRead(ctx, geom, deps, heldLock, log, floor); err != nil {
+		return err
+	}
+
+	loopCtx, stopLoops := context.WithCancel(ctx)
+	defer stopLoops()
+	slack := &recordingSlack{inner: deps.Slack, geom: geom, clock: deps.Clock, log: log}
+	go runOutbound(loopCtx, newOutbound(geom, deps.Mailbox, slack, deps.Clock, floor), deps.Clock, log)
+	poller := &inbound{geom: geom, mailbox: deps.Mailbox, slack: slack, hub: deps.Hub, clock: deps.Clock}
+	return runInbound(loopCtx, poller, deps, heldLock, log, floor)
+}
+
+// takeRelayLock takes the relay lock, and returns nil when another relay holds it.
+// A relay whose recorded pid is its own is a re-exec and waits up to deps.ReexecLockWait for the lock its old image released;
+// any other start waits only lock.ProbeGrace, so a liveness probe that holds the lock for a moment never makes a starting relay exit.
+func takeRelayLock(geom Geometry, deps RelayDeps) (*relayLock, error) {
+	previous, found, err := ReadRelayState(geom)
+	if err != nil {
+		return nil, err
+	}
+	wait := lock.ProbeGrace
+	if found && previous.PID == deps.PID() {
+		wait = max(wait, deps.ReexecLockWait)
+	}
+	if err := os.MkdirAll(filepath.Dir(geom.LockPath), privateDirMode); err != nil {
+		return nil, fmt.Errorf("slack: create the directory of the relay lock %s: %w", geom.LockPath, err)
+	}
+	held, acquired, err := lock.AcquireWriteLockWithin(geom.LockPath, wait)
+	if err != nil {
+		return nil, fmt.Errorf("slack: take the relay lock %s: %w", geom.LockPath, err)
+	}
+	if !acquired {
+		return nil, nil
+	}
+	return &relayLock{path: geom.LockPath, held: held}, nil
+}
+
+// firstRead makes the relay's first creel read as the program, before any Slack call, and records the outcome in the relay state.
+// The read is accepted with or without mail, the mail staying unread.
+// A refusal of a program claim from a strand's pane returns ErrRelayInStrandPane with the lock released; any other refusal is retried with the poll's backoff while the lock is held, and a stop of ctx ends the wait.
+func firstRead(ctx context.Context, geom Geometry, deps RelayDeps, heldLock *relayLock, log *relayLog, floor *sharedFloor) error {
+	retryWait := newLoopWait(floor)
+	for {
+		err := deps.Mailbox.ReadAll(func([]creelengine.Message) error { return errFirstReadAccepted })
+		if err == nil || errors.Is(err, errFirstReadAccepted) {
+			now := deps.Clock.Now()
+			log.recovered("first-read")
+			return updateRelayState(geom, func(relayState *RelayState) {
+				relayState.FirstReadAt, relayState.FirstReadRefusal = now, ""
+			})
+		}
+		refusal := err.Error()
+		if writeErr := updateRelayState(geom, func(relayState *RelayState) { relayState.FirstReadRefusal = refusal }); writeErr != nil {
+			return writeErr
+		}
+		log.fail("first-read", err)
+		if errors.Is(err, creelengine.ErrProgramClaimInStrandPane) {
+			heldLock.release()
+			return fmt.Errorf("%w: %w; way forward: start the relay with `lym slack start` from the operator's terminal or an orch's pane", ErrRelayInStrandPane, err)
+		}
+		if !waitFor(ctx, deps.Clock, retryWait.afterIdle()) {
+			return nil
+		}
+	}
+}
+
+// runOutbound reads the relay's mailbox until ctx ends, waiting between reads as each read asks.
+func runOutbound(ctx context.Context, out *outbound, clock Clock, log *relayLog) {
+	for ctx.Err() == nil {
+		wait, err := out.read(ctx)
+		if err != nil {
+			log.fail("outbound", err)
+		} else {
+			log.recovered("outbound")
+		}
+		if !waitFor(ctx, clock, wait) {
+			return
+		}
+	}
+}
+
+// runInbound polls the channel until ctx ends, then checks for a replaced binary and waits.
+// The wait is the shared floor after activity, doubled while polls find nothing or fail, and a rate limit's retry wait.
+func runInbound(ctx context.Context, in *inbound, deps RelayDeps, heldLock *relayLock, log *relayLog, floor *sharedFloor) error {
+	wait := newLoopWait(floor)
+	exiting := false
+	for ctx.Err() == nil {
+		activity, err := in.poll(ctx)
+		var pause time.Duration
+		limit, rateLimited := isRateLimit(err)
+		switch {
+		case rateLimited:
+			log.fail("inbound", err)
+			pause = wait.afterRateLimit(limit)
+		case err != nil:
+			log.fail("inbound", err)
+			pause = wait.afterIdle()
+			if activity {
+				pause = wait.afterActivity()
+			}
+		case activity:
+			log.recovered("inbound")
+			pause = wait.afterActivity()
+		default:
+			log.recovered("inbound")
+			pause = wait.afterIdle()
+		}
+
+		deps.CheckBinary(
+			heldLock.release,
+			func(execErr error) {
+				log.appendLine(fmt.Sprintf("%s re-exec failed: %v", deps.Clock.Now().UTC().Format(time.RFC3339), execErr))
+				if !heldLock.retake() {
+					log.appendLine("another relay holds the lock; this one exits")
+					exiting = true
+				}
+			},
+		)
+		if exiting {
+			return nil
+		}
+		if !waitFor(ctx, deps.Clock, pause) {
+			return nil
+		}
+	}
+	return nil
+}
+
+// AwaitReparent waits until the process is no longer a child of intermediate, reading its parent once a second, and errors after bound.
+// A relay started through a double fork calls it before it takes its lock, so it never runs in its starter's tree.
+func AwaitReparent(intermediate int, parentPID func() int, clock Clock, bound time.Duration) error {
+	started := clock.Now()
+	for parentPID() == intermediate {
+		if clock.Now().Sub(started) >= bound {
+			return fmt.Errorf("slack: the relay is still a child of its start process %d after %s; way forward: run `lym slack start` again from the operator's terminal", intermediate, bound)
+		}
+		<-clock.After(time.Second)
+	}
+	return nil
+}
diff --git a/internal/slackengine/relay_test.go b/internal/slackengine/relay_test.go
new file mode 100644
index 00000000..87900878
--- /dev/null
+++ b/internal/slackengine/relay_test.go
@@ -0,0 +1,901 @@
+// relay_test.go covers the relay process, its starter and the waits of a start, over the in-memory seams of inbound_test.go and temp-dir files.
+
+package slackengine_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/slackengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+const (
+	// fakePID is the process id the relay under test reports for itself.
+	fakePID = 7
+	// gonePID is a process id no process holds.
+	gonePID = 2147483000
+)
+
+// readAllCount returns how many times the mailbox's ReadAll was called.
+func (m *fakeMailbox) readAllCount() int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.readAllCalls
+}
+
+// writeRelayStateJSON writes content as the relay state file of geom.
+func writeRelayStateJSON(t *testing.T, geom slackengine.Geometry, content string) {
+	t.Helper()
+	if err := os.MkdirAll(geom.Dir, 0o700); err != nil {
+		t.Fatalf("MkdirAll = %v", err)
+	}
+	if err := os.WriteFile(geom.RelayStatePath, []byte(content), 0o600); err != nil {
+		t.Fatalf("write the relay state = %v", err)
+	}
+}
+
+// holdRelayLock takes the relay lock of geom and releases it at cleanup, standing for another relay.
+func holdRelayLock(t *testing.T, geom slackengine.Geometry) *lock.FileLock {
+	t.Helper()
+	if err := os.MkdirAll(geom.Dir, 0o700); err != nil {
+		t.Fatalf("MkdirAll = %v", err)
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(geom.LockPath)
+	if err != nil || !acquired {
+		t.Fatalf("TryAcquireWriteLock = %v, %v; want the lock", acquired, err)
+	}
+	var once sync.Once
+	t.Cleanup(func() { once.Do(func() { _ = held.Release() }) })
+	return held
+}
+
+// relayRun is a relay over a configured harness, run synchronously until a test stops it.
+type relayRun struct {
+	*harness
+	deps       slackengine.RelayDeps
+	registered atomic.Int32
+	waits      atomic.Int32
+	mu         sync.Mutex
+	cancel     context.CancelFunc
+}
+
+// newRelayRun returns a relay whose outbound read blocks as a long poll with no mail does.
+func newRelayRun(t *testing.T) *relayRun {
+	t.Helper()
+	h := newHarness(t)
+	block := make(chan struct{})
+	h.mailbox.blockReadWait = block
+	t.Cleanup(func() {
+		// The blocked outbound read wakes once the block closes and takes one more wait; no hook of a finished test may run then.
+		h.clock.mu.Lock()
+		h.clock.onWait = nil
+		h.clock.mu.Unlock()
+		close(block)
+	})
+	r := &relayRun{harness: h}
+	r.deps = slackengine.RelayDeps{
+		Mailbox:       h.mailbox,
+		Slack:         h.slack,
+		Hub:           h.hub.hub(),
+		Clock:         h.clock,
+		PID:           func() int { return fakePID },
+		CheckBinary:   func(func(), func(error)) {},
+		ReapInherited: func() error { return nil },
+		Register:      func() error { r.registered.Add(1); return nil },
+	}
+	return r
+}
+
+func (r *relayRun) setPID(pid int) { r.deps.PID = func() int { return pid } }
+
+// onWait runs hook after each wait the relay takes on the clock, with the wait's 1-based number and length.
+func (r *relayRun) onWait(hook func(n int, d time.Duration)) {
+	r.waits.Store(0)
+	r.clock.onWait = func(d time.Duration) { hook(int(r.waits.Add(1)), d) }
+}
+
+// stop ends the run in progress.
+func (r *relayRun) stop() {
+	r.mu.Lock()
+	cancel := r.cancel
+	r.mu.Unlock()
+	cancel()
+}
+
+// run runs the relay until it returns.
+func (r *relayRun) run() error {
+	ctx, cancel := context.WithCancel(context.Background())
+	r.mu.Lock()
+	r.cancel = cancel
+	r.mu.Unlock()
+	defer cancel()
+	return slackengine.RunRelay(ctx, r.geom, r.deps)
+}
+
+func (r *relayRun) relayState() slackengine.RelayState {
+	r.t.Helper()
+	relayState, _, err := slackengine.ReadRelayState(r.geom)
+	if err != nil {
+		r.t.Fatalf("ReadRelayState = %v", err)
+	}
+	return relayState
+}
+
+// stopAtFirstWait ends the run at the relay's first wait, after one pass of its loop.
+func (r *relayRun) stopAtFirstWait() {
+	r.onWait(func(int, time.Duration) { r.stop() })
+}
+
+func TestRunRelay(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("HubWithNoTokenOrNoSetupIsRefusedAndTakesNoLock", func(t *testing.T) {
+		t.Parallel()
+		r := newRelayRun(t)
+		if err := os.Remove(r.geom.TokenPath); err != nil {
+			t.Fatalf("Remove = %v", err)
+		}
+		if err := r.run(); err == nil || !strings.Contains(err.Error(), "lym slack login") {
+			t.Errorf("RunRelay(no token) = %v; want an error naming lym slack login", err)
+		}
+		if err := slackengine.WriteToken(r.geom.TokenPath, "xoxb-secret"); err != nil {
+			t.Fatalf("WriteToken = %v", err)
+		}
+		if err := os.Remove(r.geom.SetupPath); err != nil {
+			t.Fatalf("Remove = %v", err)
+		}
