new file mode 100644
index 00000000..95ece117
--- /dev/null
+++ b/internal/fronttask/doc.go
@@ -0,0 +1,45 @@
+// Package fronttask files, removes and settles a front task: a board task lym files ahead of its worktree's other starts, which runs a registered action once it lands.
+// It knows nothing of the adopt check but the `adopt-check` row of its action table.
+//
+// # The task
+//
+// A front task is a task entry whose `front` field is true.
+// It is open while its status is empty or a run status; done, draft or any other status is closed.
+// Only `File` creates one, through the board's one write that sets `front` and `on_land`, so no board edit can make a task a front task or change its action.
+// While one is open, the dobby of its worktree starts no other task there, and a worktree holds at most one open front task: `File` refuses a second.
+//
+// # Filing
+//
+// `File` refuses an `OnLand` outside the action table and a project that already holds an open front task, both before any write.
+// It then creates the entry as a draft, runs the caller's `between` step, releases the entry and records its action and project under its slug.
+// A `between` error or a release error leaves the draft entry, which is closed and holds no start.
+// A record write that fails after the release is logged and `File` returns nil, since the released entry starts and `Settle` records it.
+//
+// # The record
+//
+// The record file `records.json` sits in the front-task directory of the hub's never-tracked scratch tree, with its own lock.
+// It maps a slug to the action to run and the project that holds the task.
+// It outlives a dobby restart, so a front task that lands while its dobby is down gets its action at the next settle.
+//
+// # Removing
+//
+// `Remove` cancels the slug's run when one exists, drops its record and removes its entry.
+// The last two steps run under the record's lock, which `Settle` holds across its read of the board and its writes, so a settle running beside a removal never runs the action of an entry the removal is deleting.
+// A failing step stops the removal with a `*RemoveError` that names the hand removal.
+//
+// # Settling
+//
+// A dobby calls `Settle` each tick for its worktree's project.
+// When this machine does not own the worktree's subject, it drops the project's records and runs nothing.
+// Otherwise it records each open front entry that has no record, so a filing that died between its release and its record is healed before dobby starts the task.
+// It then runs the action of each record whose entry is gone or done, once, and drops the record.
+// A failed action keeps its record for the next settle and is returned with the hand step from the table.
+// An entry that is draft, halted or in any other status keeps its record and runs nothing.
+//
+// The action table is closed: a record naming a key outside it runs nothing, so no board edit makes dobby run a command.
+//
+// # Hub wiring
+//
+// `HubDeps` and `HubSettleDeps` fill the seams over a hub; a test fakes them.
+// The action runs as a detached spawn of the running `lym` executable in the prime's anchor, with its output appended to a file in the front-task directory.
+package fronttask
diff --git a/internal/fronttask/fronttask.go b/internal/fronttask/fronttask.go
new file mode 100644
index 00000000..150fc742
--- /dev/null
+++ b/internal/fronttask/fronttask.go
@@ -0,0 +1,313 @@
+// fronttask.go implements filing, removing and settling a front task, with the open and lookup rules over board entries, the action table and the record file.
+
+package fronttask
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/battencli"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// ActionAdoptCheck is the action key of the adopt check of the subject whose worktree holds the front task.
+const ActionAdoptCheck = "adopt-check"
+
+// action is one row of the closed action table: the lym arguments that run it and the step an operator takes by hand when it fails.
+type action struct {
+	args     func(subject string) []string
+	handStep func(subject string) string
+}
+
+// actions is the closed action table; no record or board entry adds a row.
+var actions = map[string]action{
+	ActionAdoptCheck: {
+		args:     func(subject string) []string { return []string{"adopt", "check", subject} },
+		handStep: func(subject string) string { return "lym adopt " + subject },
+	},
+}
+
+// actionKeys returns the keys of the action table, sorted.
+func actionKeys() []string {
+	keys := make([]string, 0, len(actions))
+	for key := range actions {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// Request is the task File files: its board fields, the project that holds it and the action it runs once it lands.
+type Request struct {
+	Slug    string
+	Title   string
+	Body    string
+	Labels  []string
+	Recipe  string
+	Profile string
+	// Project is the beam the task belongs to, empty for the prime.
+	Project string
+	// OnLand is the key of the action table's row that runs once the task lands.
+	OnLand string
+}
+
+// Deps is every seam over the hub that File and Remove read.
+type Deps struct {
+	// Tasks returns the local board's entries.
+	Tasks func() ([]boardengine.Task, error)
+	// Create creates or updates the entry fields describe as a front task with action onLand.
+	Create func(fields map[string]any, onLand string) (boardengine.Task, error)
+	// Release clears the entry's draft status.
+	Release func(slug string) error
+	// RemoveEntry removes the entry from the board.
+	RemoveEntry func(slug string) error
+	// HasRun reports whether the slug has a run claim, a batten run record or a pair.
+	HasRun func(slug string) (bool, error)
+	// Cancel ends the slug's run for good and removes what it left.
+	Cancel func(ctx context.Context, slug string) error
+	// RecordPath is the record file; its lock sits beside it.
+	RecordPath string
+}
+
+// SettleDeps is every seam Settle reads, for the worktree of one project.
+type SettleDeps struct {
+	// Project is the worktree's project: the beam's slug, empty for the prime.
+	Project string
+	// Subject is what the worktree's adopt takes: the beam's slug, `root` for the prime.
+	Subject string
+	// Tasks returns the local board's entries.
+	Tasks func() ([]boardengine.Task, error)
+	// OwnedHere reports whether this machine is the effective owner of the subject.
+	OwnedHere func() (bool, error)
+	// RecordPath is the record file; its lock sits beside it.
+	RecordPath string
+	// RunAction starts the action of the table's key for subject.
+	RunAction func(action, subject string) error
+}
+
+// RecordEntry is what the record holds of one front task: the action to run once it lands and the project that holds it.
+type RecordEntry struct {
+	OnLand  string `json:"on_land"`
+	Project string `json:"project"`
+}
+
+// records is the record file: one entry per front task, by slug.
+type records struct {
+	Entries map[string]RecordEntry `json:"entries"`
+}
+
+// lockPathOf returns the lock file beside the record file at recordPath.
+func lockPathOf(recordPath string) string {
+	return strings.TrimSuffix(recordPath, filepath.Ext(recordPath)) + ".lock"
+}
+
+// RemoveError is a removal that stopped at one step, with the earlier steps left done.
+type RemoveError struct {
+	Slug string
+	// Step is `cancel`, `record` or `entry`.
+	Step string
+	Err  error
+}
+
+// Error reports the step, its error and the hand removal.
+func (e *RemoveError) Error() string {
+	return fmt.Sprintf("remove front task %s: the %s step failed: %v; way forward: %s", e.Slug, e.Step, e.Err, e.HandRemoval())
+}
+
+// Unwrap returns the step's error.
+func (e *RemoveError) Unwrap() error { return e.Err }
+
+// HandRemoval names the commands that finish the removal by hand: the cancel and the board removal after a failed cancel, the board removal alone after a later step.
+func (e *RemoveError) HandRemoval() string {
+	if e.Step == "cancel" {
+		return fmt.Sprintf("run `lym batten cancel %s --remove`, then `lym board remove %s`", e.Slug, e.Slug)
+	}
+	return fmt.Sprintf("run `lym board remove %s`", e.Slug)
+}
+
+// IsOpen reports whether task is an open front task: a task entry with Front set whose status is empty or a run status.
+// A done, draft or otherwise-statused front task is closed.
+func IsOpen(task boardengine.Task) bool {
+	return task.Kind == boardengine.KindTask && task.Front &&
+		(boardengine.IsEmptyStatus(task.Status) || boardengine.IsRunStatus(task.Status))
+}
+
+// isDone reports whether task carries the done status.
+func isDone(task boardengine.Task) bool {
+	return task.Status != nil && *task.Status == "done"
+}
+
+// OpenFront returns the open front entry of project, "" for the prime, found by its Front field and project and never by slug.
+func OpenFront(tasks []boardengine.Task, project string) (boardengine.Task, bool) {
+	for _, task := range tasks {
+		if IsOpen(task) && task.Project == project {
+			return task, true
+		}
+	}
+	return boardengine.Task{}, false
+}
+
+// FrontOf returns the front entry of project whose action is onLand and that is not done, whatever its status, so a draft or halted one is found too.
+func FrontOf(tasks []boardengine.Task, project, onLand string) (boardengine.Task, bool) {
+	for _, task := range tasks {
+		if task.Front && task.Project == project && task.OnLand == onLand && !isDone(task) {
+			return task, true
+		}
+	}
+	return boardengine.Task{}, false
+}
+
+// File files req as a front task: it creates the entry, runs between when it is not nil, releases the entry and records its action and project under its slug.
+// It refuses an action outside the table and a project that already holds an open front task, both before any write.
+// A between error or a release error leaves the entry as a draft, which is closed and holds no start.
+// A failed record write after the release is logged and File returns nil, since the released entry starts and Settle heals the missing record.
+func File(deps Deps, req Request, between func() error) error {
+	if _, known := actions[req.OnLand]; !known {
+		return fmt.Errorf("front task %s: the action %q is not in the action table; way forward: use one of %s", req.Slug, req.OnLand, strings.Join(actionKeys(), ", "))
+	}
+	tasks, err := deps.Tasks()
+	if err != nil {
+		return fmt.Errorf("front task %s: read the board: %w", req.Slug, err)
+	}
+	if open, found := OpenFront(tasks, req.Project); found {
+		return fmt.Errorf("front task %s: the front task %s stands open in this worktree, and one front task stands open per worktree; way forward: let %s land, or remove it with `lym batten cancel %s --remove` then `lym board remove %s`, which runs its action", req.Slug, open.Slug, open.Slug, open.Slug, open.Slug)
+	}
+
+	fields := map[string]any{"slug": req.Slug, "title": req.Title, "kind": boardengine.KindTask, "body": req.Body, "labels": req.Labels}
+	if req.Recipe != "" {
+		fields["recipe"] = req.Recipe
+	}
+	if req.Profile != "" {
+		fields["profile"] = req.Profile
+	}
+	if req.Project != "" {
+		fields["project"] = req.Project
+	}
+	if _, err := deps.Create(fields, req.OnLand); err != nil {
+		return fmt.Errorf("front task %s: create the entry: %w", req.Slug, err)
+	}
+	if between != nil {
+		if err := between(); err != nil {
+			return fmt.Errorf("front task %s: %w", req.Slug, err)
+		}
+	}
+	if err := deps.Release(req.Slug); err != nil {
+		return fmt.Errorf("front task %s: release the entry: %w", req.Slug, err)
+	}
+	err = state.UpdateJSON(deps.RecordPath, lockPathOf(deps.RecordPath), func(cur records, _ bool) (records, error) {
+		if cur.Entries == nil {
+			cur.Entries = map[string]RecordEntry{}
+		}
+		cur.Entries[req.Slug] = RecordEntry{OnLand: req.OnLand, Project: req.Project}
+		return cur, nil
+	})
+	if err != nil {
+		// The entry is released and starts, so the filing stands; Settle records an open front entry that has no record.
+		logger.Warn("fronttask: the record of a filed front task was not written; Settle records it from the entry", "slug", req.Slug, "error", err)
+	}
+	return nil
+}
+
+// Remove removes the front task slug in three steps: the cancel of its run, when it has one, the drop of its record and the removal of its entry.
+// A cancel that finds nothing left counts as done; any other cancel error stops the removal before the record is touched, so no action runs for it.
+// The record's drop and the entry's removal run under the record's lock, so a concurrent Settle either reads the record still there or reads the entry gone with no record.
+// A failing step returns a *RemoveError, the earlier steps left done.
+func Remove(deps Deps, slug string) error {
+	hasRun, err := deps.HasRun(slug)
+	if err != nil {
+		return &RemoveError{Slug: slug, Step: "cancel", Err: err}
+	}
+	if hasRun {
+		if err := deps.Cancel(context.Background(), slug); err != nil && !errors.Is(err, battencli.ErrNothingLeft) {
+			return &RemoveError{Slug: slug, Step: "cancel", Err: err}
+		}
+	}
+
+	// The entry's removal error is carried out of the locked update, since an error returned from it would skip the record write that drops the record.
+	var entryErr error
+	err = state.UpdateJSON(deps.RecordPath, lockPathOf(deps.RecordPath), func(cur records, _ bool) (records, error) {
+		delete(cur.Entries, slug)
+		entryErr = deps.RemoveEntry(slug)
+		return cur, nil
+	})
+	if err != nil {
+		return &RemoveError{Slug: slug, Step: "record", Err: err}
+	}
+	if entryErr != nil {
+		return &RemoveError{Slug: slug, Step: "entry", Err: entryErr}
+	}
+	return nil
+}
+
+// Settle runs the land actions of the worktree's front tasks and keeps its record true, under the record's lock.
+// When this machine does not own the subject it drops the project's records and runs nothing.
+// Otherwise it records each open front entry that has no record, then runs once the action of each record whose entry is gone or done and drops that record.
+// A record whose entry stands in any other status is left, a record naming an action outside the table is dropped with a warning, and a failed action keeps its record.
+// The error of a failed action names the slug, the action, the failure and the hand step from the table.
+func Settle(deps SettleDeps) error {
+	var failures []error
+	err := state.UpdateJSON(deps.RecordPath, lockPathOf(deps.RecordPath), func(cur records, _ bool) (records, error) {
+		if cur.Entries == nil {
+			cur.Entries = map[string]RecordEntry{}
+		}
+		owned, err := deps.OwnedHere()
+		if err != nil {
+			return cur, fmt.Errorf("read the owner of %s: %w", deps.Subject, err)
+		}
+		if !owned {
+			for slug, entry := range cur.Entries {
+				if entry.Project == deps.Project {
+					delete(cur.Entries, slug)
+				}
+			}
+			return cur, nil
+		}
+		tasks, err := deps.Tasks()
+		if err != nil {
+			return cur, fmt.Errorf("read the board: %w", err)
+		}
+		for _, task := range tasks {
+			if _, recorded := cur.Entries[task.Slug]; !recorded && IsOpen(task) && task.Project == deps.Project {
+				cur.Entries[task.Slug] = RecordEntry{OnLand: task.OnLand, Project: task.Project}
+			}
+		}
+
+		slugs := make([]string, 0, len(cur.Entries))
+		for slug, entry := range cur.Entries {
+			if entry.Project == deps.Project {
+				slugs = append(slugs, slug)
+			}
+		}
+		slices.Sort(slugs)
+		for _, slug := range slugs {
+			entry := cur.Entries[slug]
+			index := slices.IndexFunc(tasks, func(task boardengine.Task) bool { return task.Slug == slug })
+			if index >= 0 && !isDone(tasks[index]) {
+				continue
+			}
+			row, known := actions[entry.OnLand]
+			if !known {
+				logger.Warn("fronttask: a record names an action outside the table; it is dropped", "slug", slug, "action", entry.OnLand)
+				delete(cur.Entries, slug)
+				continue
+			}
+			if err := deps.RunAction(entry.OnLand, deps.Subject); err != nil {
+				failures = append(failures, fmt.Errorf("front task %s: the action %s failed: %w; way forward: run `%s`", slug, entry.OnLand, err, row.handStep(deps.Subject)))
+				continue
+			}
+			delete(cur.Entries, slug)
+		}
+		return cur, nil
+	})
+	if err != nil {
+		return fmt.Errorf("settle the front tasks of %s: %w", deps.Subject, err)
+	}
+	return errors.Join(failures...)
+}
