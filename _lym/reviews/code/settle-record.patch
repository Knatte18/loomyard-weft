+			template := "set-option -t " + tmuxString(exactSessionWindowTarget(req.Session)) + " " + buttonAnswerOption + ` "\` + buttonAnswerMarker + `%%%" ; run-shell -b ` + tmuxQuote(line)
 			argv = []string{"command-prompt", "-t", req.Client, "-p", ask + " ", template}
