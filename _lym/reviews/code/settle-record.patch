+// TestTriageLines pins which triage lines a failure report yields per failed test, and that a log with none yields none.
+func TestTriageLines(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	report := func(lines ...string) string {
