diff --git a/internal/desktophook/config.go b/internal/desktophook/config.go
new file mode 100644
index 00000000..48a2bcf3
--- /dev/null
+++ b/internal/desktophook/config.go
@@ -0,0 +1,63 @@
+// config.go defines desktop.yaml: the Config type, the template and spec accessors, and LoadConfig.
+
+package desktophook
+
+import (
+	_ "embed"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed template.yaml
+var configTemplate string
+
+// ConfigTemplate returns the default YAML template for the desktop config module.
+func ConfigTemplate() string {
+	return configTemplate
+}
+
+// configModule is the config module name desktop.yaml is loaded under.
+const configModule = "desktop"
+
+// Config represents the resolved desktop.yaml configuration.
+type Config struct {
+	// WindowCommand is the shell command run after lym opens a window; empty runs nothing.
+	WindowCommand string `yaml:"window_command"`
+	// WindowWaitMs is the milliseconds lym waits after opening a window before it runs WindowCommand.
+	WindowWaitMs int `yaml:"window_wait_ms"`
+}
+
+// ConfigSpec returns the desktop module's layered-load spec.
+// Both keys describe the machine's desktop, so each machine sets them in its own machine override and the local layer refuses them.
+func ConfigSpec() configengine.Spec {
+	return configengine.Spec{
+		Name:     configModule,
+		Template: []byte(ConfigTemplate()),
+		HubWide:  true,
+		Categories: map[string]configengine.Category{
+			"window_command": configengine.CategoryMachine,
+			"window_wait_ms": configengine.CategoryMachine,
+		},
+	}
+}
+
+// LoadConfig loads and unmarshals the desktop module's configuration through the hub-wide layer stack under dirs.
+// A hub whose base file is absent resolves the template under the machine and local layers present, so opening a window never fails on a hub not yet reconciled.
+// It refuses a negative window_wait_ms, naming the key.
+func LoadConfig(dirs configengine.Dirs) (Config, error) {
+	resolved, err := configengine.LoadOrTemplate(dirs, ConfigSpec())
+	if err != nil {
+		return Config{}, err
+	}
+
+	var cfg Config
+	if err := yaml.Unmarshal(resolved, &cfg); err != nil {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("unmarshal desktop config: %w", err))
+	}
+	if cfg.WindowWaitMs < 0 {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("desktop config key %q holds %d; want an integer of at least 0", "window_wait_ms", cfg.WindowWaitMs))
+	}
+	return cfg, nil
+}
diff --git a/internal/desktophook/config_test.go b/internal/desktophook/config_test.go
new file mode 100644
index 00000000..5e361f6c
--- /dev/null
+++ b/internal/desktophook/config_test.go
@@ -0,0 +1,68 @@
+//go:build tier0
+
+// config_test.go covers desktophook.LoadConfig over a bare board and anchor, with no hub and no spawn.
+
+package desktophook_test
+
+import (
+	"errors"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/desktophook"
+)
+
+// TestLoadConfig covers the template defaults, a machine override setting both keys, a refused negative wait and a local override refused for a machine key.
+func TestLoadConfig(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		machine string
+		local   string
+		want    desktophook.Config
+		wantErr string
+	}{
+		{name: "TemplateDefaults", machine: "", want: desktophook.Config{WindowWaitMs: 1500}},
+		{
+			name:    "MachineOverrideSetsBothKeys",
+			machine: "window_command: \"~/.local/bin/arrange-to-tiles.sh\"\nwindow_wait_ms: 200\n",
+			want:    desktophook.Config{WindowCommand: "~/.local/bin/arrange-to-tiles.sh", WindowWaitMs: 200},
+		},
+		{name: "NegativeWaitRefused", machine: "window_wait_ms: -1\n", wantErr: `desktop config key "window_wait_ms" holds -1`},
+		{name: "LocalOverrideRefused", local: "window_command: \"true\"\n", wantErr: "window_command"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			dirs := newDirsWithMachineConfig(t, tt.machine)
+			if tt.local != "" {
+				// The anchor gets a _lym/config/ too, since a worktree with no _lym/ stacks no local layer.
+				for _, dir := range []string{configengine.ConfigDir(dirs.Anchor), configengine.ScratchDir(dirs.Anchor)} {
+					if err := os.MkdirAll(dir, 0o755); err != nil {
+						t.Fatalf("MkdirAll(%q) = %v; want nil", dir, err)
+					}
+				}
+				if err := os.WriteFile(configengine.LocalFile(dirs.Anchor, "desktop"), []byte(tt.local), 0o644); err != nil {
+					t.Fatalf("WriteFile local override = %v; want nil", err)
+				}
+			}
+
+			got, err := desktophook.LoadConfig(dirs)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) || !errors.Is(err, configengine.ErrInvalid) {
+					t.Fatalf("LoadConfig() error = %v; want an ErrInvalid error containing %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig() error = %v; want nil", err)
+			}
+			if got != tt.want {
+				t.Errorf("LoadConfig() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+}
