+
+	repo := fabricengine.NewPlainWarpRepoForTest(t)
+	first := gitkit.CommitFile(t, repo, "a.txt", "first\n", "first a")
+	gitkit.CommitFile(t, repo, "a.txt", "second \n\n", "second a")
+	gitkit.CommitFile(t, repo, "dir/empty", "", "empty file")
