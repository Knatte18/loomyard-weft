-	for {
-		if _, err := os.Stat(path); err == nil {
-			return
-		}
-		if time.Now().After(deadline) {
-			t.Fatalf("%s did not appear within %s", path, standInDeadline)
-		}
-		time.Sleep(standInPollTick)
-	}
-}
