new file mode 100644
index 00000000..9339a853
--- /dev/null
+++ b/internal/hardenshed/doc.go
@@ -0,0 +1,115 @@
+// Package hardenshed holds the Hardener campaign's engine.
+// The campaign is the autonomous behaviour review that drives a live-substrate module against throwaway sandbox hubs.
+// The package takes absolute paths and told seams.
+// It imports neither `internal/fabriccli`, `internal/configreg` nor `internal/lymcwd`,
+// so `configreg` can register its config unit without a cycle; the CLI layer tells it what needs either.
+//
+// # Config
+//
+// The hub-wide `hardener` config module is `hardener.yaml`, whose keys Config mirrors with the defaults of template.yaml.
+// ConfigSpec classifies `auto_accept`, `reviewer_fan`, `fixer_fan` and `tree_scope` as guard keys.
+// Only the hub file sets a guard key, and a task's `run_settings` setting one is refused at seed with that way forward.
+// Every other key is open to a task's `run_settings`.
+// `tree_scope` is an open map, which ConfigOpenMaps names.
+// LoadConfig loads the unit strictly through `configengine`, then runs CheckValues over the resolved document.
+// It normalizes `tree_scope` through the one tree-key rule darn's `tree_scope` takes.
+// CheckValues refuses a `concurrency`, `live_attempts`, `verify_attempts` or `hard_max_bounces` below 1.
+// It refuses a negative `max_bounces`.
+// It refuses a `reviewer`, `fixer`, `judge` or `seed` entry whose model-spec does not parse.
+// A refusal of LoadConfig names the write for the layer the value comes from, then `lym loom resume`.
+//
+// # Campaign check
+//
+// CheckCampaign is Preflight's check of a campaign, and returns the first refusal in a fixed order.
+// Each refusal names its way forward and ends with `lym loom resume`.
+// It refuses a campaign with no package or a package the worktree lacks, and a live gate key the hub did not set.
+// It refuses a live key naming the billed tier, and a copies key naming more than one tier while copies run.
+// It refuses a package holding no test of a tier a live key runs.
+// It refuses a reviewer list that repeats a model in neighbouring rounds, and a soft round cap above the hard one.
+// Copies run when the live tests drive no LLM session and the concurrency is above 1.
+// Rotate expands a per-round model list cyclically, so a round past the list's length never clamps to its last entry.
+//
+// # Live gate
+//
+// NewLiveGate is Go's independent check of each fix round, run through `lym gate test` calls that take their own slots.
+// Each call runs the `harden-live` key once.
+// It then runs the `harden-live-copies` key with the configured copies.
+// That second run is made only when the live tests drive no LLM session and the concurrency is above 1.
+// The gate names keys only, never a tier.
+// It writes the round's live report, `harden-live-<round>.json` in the run directory.
+// ReadLiveReport is the report's sole reader.
+// The report's mark is red when the `harden-live` run failed or started no test binary, and green otherwise.
+// A copies run never changes the mark: a red copies run, one that started none and a refused one are recorded beside it.
+// A red report lists the `harden-live` run's failing lines as deferred findings.
+// The report also names the packages whose test files hold no `tmuxkit.Main(` call, as outside the stray-state cover.
+// A refused `harden-live` call, or a call that could not run, is returned as an error and writes no report.
+//
+// # Sandbox hubs
+//
+// NewSandbox makes a throwaway hub for the live tests, writing only under the run's sandbox root.
+// SandboxRoot derives that root from the worktree root, so every process of a run names the same directory.
+// The package names the hub's two bares by role, the code bare and the records bare, and never by side name.
+// A hub is made in a container of its own: the bares are seeded, the hub is cloned, and the sandbox config is committed.
+// The `.dev-bin` lym is rebuilt only when its revision is not the worktree HEAD's or it is marked modified.
+// The root's hub list, `hubs.json`, records every hub made, and ListSandbox reads it alone.
+// A failure after the container is made removes the container before the error returns.
+//
+// # Sandbox reaper
+//
+// Reap ends what the sandbox hubs left running, then empties the sandbox root, at each ReapPoint a campaign names.
+// It ends each recorded hub's registered processes through the run-process owner's end sequence, sparing the caller.
+// It stops each recorded hub's reed server whether or not the hub's directory is still there.
+// It prunes the hub's list entry once the server is stopped or none was live.
+// Only a process that names the root and that no record names is ended as an orphan, never the caller or its ancestors.
+// It returns one StrayEntry per server and process it found.
+// A ReapStart entry is marked as left by an interrupted row.
+// Off Linux the process scan is skipped and only the servers are stopped.
+// Every entry under the root but the hub list is removed, so no bare repository is left for a cleanup to refuse.
+//
+// # Round rows
+//
+// WrapRow decorates a Harden round row, a RowReview or a RowFix, with a reap at its start and at its end.
+// It fixes the row's round once, at the start of the call, so a resumed row keeps the round it began.
+// A review row writes the round's models file, `harden-models-<round>.json`.
+// A fix row records the head it first started at in the round's head file, `harden-head-<round>.json`.
+// A call resumed after a crash reuses that head, so the commits file lists every commit the round's calls made.
+// A fix row writes the round's commits file, `harden-commits-<round>.json`, when its call returned no error.
+// Every reap adds its strays to the round's stray report, `harden-strays-<round>.json`.
+// A fix row whose call returned no error then archives the round through ArchiveRound.
+// ArchiveRound copies the round's files and the latest Bouncer ledger into `_lym/harden/round-<round>/` and commits them.
+// It replaces the directory, so a second archive of one round is harmless.
+// ArchiveFinalLedger copies the latest ledger into `_lym/harden/`.
+//
+// # Method
+//
+// A campaign hardens a live-substrate module before it merges, by running it rather than reading it.
+// Such a module drives real processes, sockets or a tmux server,
+// and its defects hide in composed, stateful, timing-sensitive behaviour that a green hermetic test does not prove.
+// Text review reads an artifact and judges it; behaviour review drives the substrate and judges what it does.
+// The tell that a module needs a campaign is that its unit tests pass but nobody trusts it under load.
+// A crash or a concurrency defect is the usual cause.
+//
+// Each round is independent.
+// A fresh reviewer forms its own findings, then a fixer works them, and neither grades its own work.
+// A fixer that has just fixed something is motivated to declare it fixed.
+// So a round's own "merge-ready" verdict never gates the campaign.
+// Go gates each round instead, by re-running the live gate on the committed tree and believing only what it observes.
+// Rounds rotate models, since different models miss different things.
+// Agreement across models is stronger evidence than repeated passes by one.
+// A round's assignment follows from the previous round's residue, never from "review it again".
+// When findings repeat a shape, the round enumerates that shape.
+// When the countable classes are closed, it drives the regions no round has reached.
+//
+// The merge bar is one green live run with zero stray state.
+// A concurrent run of the suite is a diagnostic amplifier that drives out teardown races and leaked state.
+// It is never a merge gate, because a timeout under an artificial load is not a defect.
+//
+// A clean run proves only that its scenario reached the code.
+// A green scenario that never entered the mechanism it claims to exercise is indistinguishable from a fix,
+// so a regression test is proven by sabotaging the mechanism and watching the test fail.
+//
+// A converged campaign proves what its rounds covered and no more.
+// A round with no finding in an enumerated class shows that class clean, not the module.
+// A scenario that cannot be driven on the host, such as another platform's path behaviour, stays an unproven gap.
+// A convergence verdict names those limits, so the next campaign does not learn to claim more than it proved.
+package hardenshed
diff --git a/internal/hardenshed/live.go b/internal/hardenshed/live.go
new file mode 100644
index 00000000..97651376
--- /dev/null
+++ b/internal/hardenshed/live.go
@@ -0,0 +1,219 @@
+// live.go holds the live gate, Go's independent check of each fix round, and the round's live report it writes.
+
+package hardenshed
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// The marks a live report carries.
+const (
+	// MarkRed says the round's `harden-live` run failed or started no test binary.
+	MarkRed = "red"
+	// MarkGreen says the round's `harden-live` run passed and started a test binary.
+	MarkGreen = "green"
+)
+
+// strayCoverCall is the call that puts a package's strays under the test kit's check when its test files hold it.
+const strayCoverCall = "tmuxkit.Main("
+
+// copiesClampPrefix opens the line a copies call prints when the pool's slots hold fewer copies than were asked for.
+const copiesClampPrefix = "gate test: --copies asked for"
+
+// liveWayForward closes the error of a live run that could not be started or awaited.
+const liveWayForward = "way forward: check the key with lym config gate, fix it from the prime, then run lym loom resume"
+
+// LiveRun is the outcome of one `lym gate test` call the live gate made.
+type LiveRun struct {
+	// Passed reports whether the call exited green.
+	Passed bool
+	// Output is the call's output, its started lines included.
+	Output string
+	// Refused is the refusal text when the call refused before running any tier, empty otherwise.
+	Refused string
+}
+
+// LiveDeps is what the live gate needs told.
+type LiveDeps struct {
+	// RunDir is the run directory the round's live report is written in.
+	RunDir string
+	// WorktreeRoot is the absolute worktree root the Packages are relative to.
+	WorktreeRoot string
+	// Round names the round being fixed.
+	Round func() (int, error)
+	// Packages are the worktree-relative package directories the campaign drives.
+	Packages []string
+	// LLMDriving says the live tests drive a billed LLM session, which turns the copies off.
+	LLMDriving bool
+	// Concurrency is the copies the copies call asks for; one or less runs none.
+	Concurrency int
+	// Run makes one `lym gate test` call of the gate key with the copies and packages, as a call taking its own slots.
+	// A spawn or wait failure is its error; a refusal before any tier ran is LiveRun.Refused.
+	Run func(key string, copies int, packages []string) (LiveRun, error)
+}
+
+// LiveRunReport is what the live report records of one call.
+type LiveRunReport struct {
+	// Passed reports whether the call exited green.
+	Passed bool `json:"passed"`
+	// Started is the number of test binaries the call started, summed over its runs.
+	Started int `json:"started"`
+	// FailingLines are the lines of the call's output that name a failure.
+	FailingLines []string `json:"failing_lines,omitempty"`
+	// Clamp is the line the call printed when the pool held fewer copies than were asked for.
+	Clamp string `json:"clamp,omitempty"`
+	// Refused is the refusal text of a call that refused before running any tier.
+	Refused string `json:"refused,omitempty"`
+}
+
+// LiveReport is one round's live report, written as `harden-live-<round>.json` in the run directory.
+type LiveReport struct {
+	// Round is the round the report is of.
+	Round int `json:"round"`
+	// Mark is MarkRed or MarkGreen; the copies run never changes it.
+	Mark string `json:"mark"`
+	// Live is the `harden-live` call.
+	Live LiveRunReport `json:"live"`
+	// Copies is the `harden-live-copies` call, nil when none was made.
+	Copies *LiveRunReport `json:"copies,omitempty"`
+	// OutsideStrayCover are the packages whose test files hold no `tmuxkit.Main(` call.
+	OutsideStrayCover []string `json:"outside_stray_cover,omitempty"`
+	// Deferred are the failing lines of a red `harden-live` call, deferred to the run's findings.
+	// A red call whose output names no failing test defers one line naming the report instead.
+	Deferred []string `json:"deferred,omitempty"`
+}
+
+// liveReportPath returns the path of the live report of round in runDir.
+func liveReportPath(runDir string, round int) string {
+	return filepath.Join(runDir, fmt.Sprintf("harden-live-%d.json", round))
+}
+
+// ReadLiveReport reads the live report of round from runDir, and reports whether one was written.
+func ReadLiveReport(runDir string, round int) (LiveReport, bool, error) {
+	path := liveReportPath(runDir, round)
+	return state.ReadJSON[LiveReport](path, lock.TrackedFileLockPath(path, ".lock"))
+}
+
+// failingLine reports whether a line of a gate call's output names a failure.
+func failingLine(line string) bool {
+	trimmed := strings.TrimSpace(line)
+	return strings.HasPrefix(trimmed, "--- FAIL") || strings.HasPrefix(trimmed, "FAIL") || strings.HasPrefix(trimmed, "panic:")
+}
+
+// reportRun summarises one gate call's output.
+func reportRun(run LiveRun) LiveRunReport {
+	report := LiveRunReport{Passed: run.Passed, Refused: run.Refused}
+	for _, started := range gateslot.ParseStartedLines(run.Output) {
+		report.Started += started.Started
+	}
+	for _, line := range strings.Split(run.Output, "\n") {
+		line = strings.TrimRight(line, "\r")
+		if failingLine(line) {
+			report.FailingLines = append(report.FailingLines, strings.TrimSpace(line))
+		}
+		if report.Clamp == "" && strings.HasPrefix(line, copiesClampPrefix) {
+			report.Clamp = line
+		}
+	}
+	return report
+}
+
+// packagesOutsideStrayCover returns the packages whose test files, read under root, hold no `tmuxkit.Main(` call.
+func packagesOutsideStrayCover(root string, packages []string) ([]string, error) {
+	var outside []string
+	for _, pkg := range packages {
+		tests, err := filepath.Glob(filepath.Join(root, pkg, "*_test.go"))
+		if err != nil {
+			return nil, fmt.Errorf("list the test files of package %q: %w", pkg, err)
+		}
+		covered := false
+		for _, test := range tests {
+			source, err := os.ReadFile(test)
+			if err != nil {
+				return nil, fmt.Errorf("read test file %q: %w", test, err)
+			}
+			if strings.Contains(string(source), strayCoverCall) {
+				covered = true
+				break
+			}
+		}
+		if !covered {
+			outside = append(outside, pkg)
+		}
+	}
+	return outside, nil
+}
+
+// NewLiveGate returns the live gate, which runs the campaign's live tests after a fix round and reports the round.
+// Each call runs `harden-live` once.
+// It then runs `harden-live-copies` when the tests drive no LLM session and concurrency is above 1.
+// It writes the round's live report and fails when the mark is red.
+// The mark is red when the `harden-live` run failed or started no test binary.
+// A refused `harden-live` call, or a call that could not run, returns an error and writes no report.
+// A refused copies call is recorded as refused and leaves the mark alone.
+func NewLiveGate(deps LiveDeps) shuttleengine.Gate {
+	return func() (shuttleengine.GateResult, error) {
+		round, err := deps.Round()
+		if err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("live gate: name the round: %w", err)
+		}
+		live, err := deps.Run(LiveGateKey, 0, deps.Packages)
+		if err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("live gate: run %s: %w; %s", LiveGateKey, err, liveWayForward)
+		}
+		if live.Refused != "" {
+			return shuttleengine.GateResult{}, fmt.Errorf("live gate: %w", errors.New(live.Refused))
+		}
+		report := LiveReport{Round: round, Live: reportRun(live)}
+		if !deps.LLMDriving && deps.Concurrency > 1 {
+			copies, err := deps.Run(LiveCopiesGateKey, deps.Concurrency, deps.Packages)
+			if err != nil {
+				return shuttleengine.GateResult{}, fmt.Errorf("live gate: run %s: %w; %s", LiveCopiesGateKey, err, liveWayForward)
+			}
+			copiesReport := reportRun(copies)
+			report.Copies = &copiesReport
+		}
+		if report.OutsideStrayCover, err = packagesOutsideStrayCover(deps.WorktreeRoot, deps.Packages); err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("live gate: %w", err)
+		}
+
+		path := liveReportPath(deps.RunDir, round)
+		report.Mark = MarkGreen
+		if !report.Live.Passed || report.Live.Started == 0 {
+			report.Mark = MarkRed
+			report.Deferred = report.Live.FailingLines
+			if len(report.Deferred) == 0 {
+				report.Deferred = []string{fmt.Sprintf("the `%s` run failed or started no test binary and its output names no failing test; read %s", LiveGateKey, path)}
+			}
+		}
+		if err := state.WriteJSON(path, lock.TrackedFileLockPath(path, ".lock"), report); err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("live gate: write the live report: %w", err)
+		}
+		if report.Mark == MarkGreen {
+			return shuttleengine.GateResult{Passed: true}, nil
+		}
+		return shuttleengine.GateResult{Findings: redFindings(path, report.Live)}, nil
+	}
+}
+
+// redFindings renders the findings of a red live run: the report to read and the failing lines.
+func redFindings(path string, live LiveRunReport) string {
+	var findings strings.Builder
+	fmt.Fprintf(&findings, "The live run of %s is red; its report is %s.\n", LiveGateKey, path)
+	if live.Started == 0 {
+		fmt.Fprintf(&findings, "It started no test binary, so no live test ran.\n")
+	}
+	for _, line := range live.FailingLines {
+		fmt.Fprintf(&findings, "- %s\n", line)
+	}
+	return findings.String()
+}
diff --git a/internal/hardenshed/live_test.go b/internal/hardenshed/live_test.go
new file mode 100644
index 00000000..c27b60bb
--- /dev/null
+++ b/internal/hardenshed/live_test.go
@@ -0,0 +1,209 @@
+// live_test.go covers the live gate's verdicts and the live report it writes.
+
+package hardenshed
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestLiveGate(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	started := func(run string, count int) string { return gateslot.FormatStartedLine(run, count) + "\n" }
+	green := LiveRun{Passed: true, Output: started("tier2", 2)}
+	clamp := "gate test: --copies asked for 3 copies of tier2 and 2 ran, as the pool's slots hold no more"
+	noFailingLine := "the `harden-live` run failed or started no test binary and its output names no failing test; read {report}"
+
+	tests := []struct {
+		name        string
+		llmDriving  bool
+		concurrency int
+		live        LiveRun
+		liveErr     error
+		copies      LiveRun
+		copiesErr   error
+		withMain    bool
+
+		wantPassed     bool
+		wantErr        []string
+		wantNoReport   bool
+		wantMark       string
+		wantDeferred   []string
+		wantCopies     *LiveRunReport
+		wantCallKeys   []string
+		wantOutside    []string
+		wantFindingsIn []string
+	}{
+		{
+			name: "GreenLivePasses", concurrency: 1, live: green, withMain: true,
+			wantPassed: true, wantMark: MarkGreen, wantCallKeys: []string{LiveGateKey},
+		},
+		{
+			name: "RedLiveFailsWithDeferredLines", concurrency: 1, withMain: true,
+			live:     LiveRun{Passed: false, Output: started("tier2", 1) + "--- FAIL: TestA (0.1s)\nok pkg\nFAIL\tpkg\t0.2s\n"},
+			wantMark: MarkRed, wantCallKeys: []string{LiveGateKey},
+			wantDeferred:   []string{"--- FAIL: TestA (0.1s)", "FAIL\tpkg\t0.2s"},
+			wantFindingsIn: []string{"harden-live-1.json", "--- FAIL: TestA (0.1s)"},
+		},
+		{
+			name: "PassingLiveStartingNoBinaryIsRed", concurrency: 1, withMain: true,
+			live:     LiveRun{Passed: true, Output: started("tier2", 0)},
+			wantMark: MarkRed, wantCallKeys: []string{LiveGateKey},
+			wantDeferred:   []string{noFailingLine},
+			wantFindingsIn: []string{"started no test binary"},
+		},
+		{
+			name: "PassingLiveWithoutStartedLineIsRed", concurrency: 1, withMain: true,
+			live:     LiveRun{Passed: true, Output: "ok pkg\n"},
+			wantMark: MarkRed, wantCallKeys: []string{LiveGateKey},
+			wantDeferred:   []string{noFailingLine},
+			wantFindingsIn: []string{"started no test binary"},
+		},
+		{
+			name: "FailedLiveNamingNoFailingTestIsRedWithItsReportDeferred", concurrency: 1, withMain: true,
+			live:     LiveRun{Passed: false, Output: started("tier2", 1) + "build step failed\n"},
+			wantMark: MarkRed, wantCallKeys: []string{LiveGateKey},
+			wantDeferred:   []string{noFailingLine},
+			wantFindingsIn: []string{"harden-live-1.json"},
+		},
+		{
+			name: "RedCopiesStaysGreenAndIsRecorded", concurrency: 3, withMain: true, live: green,
+			copies:     LiveRun{Passed: false, Output: started("tier2 copy 1", 1) + started("tier2 copy 2", 1) + "--- FAIL: TestB\n" + clamp + "\n"},
+			wantPassed: true, wantMark: MarkGreen, wantCallKeys: []string{LiveGateKey, LiveCopiesGateKey},
+			wantCopies: &LiveRunReport{Started: 2, FailingLines: []string{"--- FAIL: TestB"}, Clamp: clamp},
+		},
+		{
+			name: "CopiesStartingNoneStaysGreenAndIsRecorded", concurrency: 3, withMain: true, live: green,
+			copies:     LiveRun{Passed: true, Output: started("tier2 copy 1", 0)},
+			wantPassed: true, wantMark: MarkGreen, wantCallKeys: []string{LiveGateKey, LiveCopiesGateKey},
+			wantCopies: &LiveRunReport{Passed: true},
+		},
+		{
+			name: "LLMDrivingMakesNoCopiesCall", llmDriving: true, concurrency: 3, withMain: true, live: green,
+			wantPassed: true, wantMark: MarkGreen, wantCallKeys: []string{LiveGateKey},
+		},
+		{
+			name: "RefusedCopiesIsRecordedNotFailed", concurrency: 3, withMain: true, live: green,
+			copies:     LiveRun{Refused: "gate test: refused; way forward: lower the copies"},
+			wantPassed: true, wantMark: MarkGreen, wantCallKeys: []string{LiveGateKey, LiveCopiesGateKey},
+			wantCopies: &LiveRunReport{Refused: "gate test: refused; way forward: lower the copies"},
+		},
+		{
+			name: "PackageWithoutTmuxkitMainIsOutsideTheCover", concurrency: 1, live: green,
+			wantPassed: true, wantMark: MarkGreen, wantCallKeys: []string{LiveGateKey}, wantOutside: []string{"pkg"},
+		},
+		{
+			name: "RunErrorCarriesItsWayForwardAndWritesNoReport", concurrency: 1, withMain: true,
+			liveErr: errors.New("spawn failed"), wantNoReport: true, wantCallKeys: []string{LiveGateKey},
+			wantErr: []string{"spawn failed", "way forward: check the key with lym config gate, fix it from the prime, then run lym loom resume"},
+		},
+		{
+			name: "RefusedLiveIsAnErrorWithItsRefusalAndWritesNoReport", concurrency: 3, withMain: true,
+			live:         LiveRun{Refused: "gate test: gates.harden-live is not set; way forward: set it"},
+			wantNoReport: true, wantCallKeys: []string{LiveGateKey},
+			wantErr: []string{"gates.harden-live is not set; way forward: set it"},
+		},
+		{
+			name: "CopiesRunErrorCarriesItsWayForwardAndWritesNoReport", concurrency: 3, withMain: true, live: green,
+			copiesErr: errors.New("wait failed"), wantNoReport: true, wantCallKeys: []string{LiveGateKey, LiveCopiesGateKey},
+			wantErr: []string{"wait failed", "way forward:"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			root, runDir := t.TempDir(), t.TempDir()
+			pkgDir := filepath.Join(root, "pkg")
+			if err := os.MkdirAll(pkgDir, 0o755); err != nil {
+				t.Fatal(err)
+			}
+			source := "package pkg\n"
+			if tt.withMain {
+				source += "func TestMain(m *testing.M) { os.Exit(tmuxkit.Main(m)) }\n"
+			}
+			if err := os.WriteFile(filepath.Join(pkgDir, "a_test.go"), []byte(source), 0o644); err != nil {
+				t.Fatal(err)
+			}
+
+			var keys []string
+			gate := NewLiveGate(LiveDeps{
+				RunDir: runDir, WorktreeRoot: root, Packages: []string{"pkg"},
+				Round:      func() (int, error) { return 1, nil },
+				LLMDriving: tt.llmDriving, Concurrency: tt.concurrency,
+				Run: func(key string, copies int, packages []string) (LiveRun, error) {
+					keys = append(keys, key)
+					if !reflect.DeepEqual(packages, []string{"pkg"}) {
+						t.Errorf("Run(%s) packages = %v; want [pkg]", key, packages)
+					}
+					if wantCopies := map[string]int{LiveGateKey: 0, LiveCopiesGateKey: tt.concurrency}[key]; copies != wantCopies {
+						t.Errorf("Run(%s) copies = %d; want %d", key, copies, wantCopies)
+					}
+					if key == LiveCopiesGateKey {
+						return tt.copies, tt.copiesErr
+					}
+					return tt.live, tt.liveErr
+				},
+			})
+			result, err := gate()
+
+			if !reflect.DeepEqual(keys, tt.wantCallKeys) {
+				t.Errorf("gate keys run = %v; want %v", keys, tt.wantCallKeys)
+			}
+			if len(tt.wantErr) > 0 {
+				if err == nil {
+					t.Fatalf("gate() error = nil; want one holding %v", tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("gate() error = %q; want it to hold %q", err, want)
+					}
+				}
+			} else if err != nil {
+				t.Fatalf("gate() error = %v", err)
+			}
+			report, found, readErr := ReadLiveReport(runDir, 1)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			if tt.wantNoReport {
+				if found {
+					t.Errorf("a live report was written; want none")
+				}
+				return
+			}
+			if result.Passed != tt.wantPassed {
+				t.Errorf("gate() passed = %v; want %v", result.Passed, tt.wantPassed)
+			}
+			for _, want := range tt.wantFindingsIn {
+				if !strings.Contains(result.Findings, want) {
+					t.Errorf("gate() findings = %q; want it to hold %q", result.Findings, want)
+				}
+			}
+			if !found || report.Round != 1 || report.Mark != tt.wantMark {
+				t.Errorf("report = %+v, found %v; want round 1 and mark %s", report, found, tt.wantMark)
+			}
+			var wantDeferred []string
+			for _, line := range tt.wantDeferred {
+				wantDeferred = append(wantDeferred, strings.ReplaceAll(line, "{report}", liveReportPath(runDir, 1)))
+			}
+			if !reflect.DeepEqual(report.Deferred, wantDeferred) {
+				t.Errorf("report deferred = %v; want %v", report.Deferred, wantDeferred)
+			}
+			if !reflect.DeepEqual(report.Copies, tt.wantCopies) {
+				t.Errorf("report copies = %+v; want %+v", report.Copies, tt.wantCopies)
+			}
+			if !reflect.DeepEqual(report.OutsideStrayCover, tt.wantOutside) {
+				t.Errorf("report outside_stray_cover = %v; want %v", report.OutsideStrayCover, tt.wantOutside)
+			}
+		})
+	}
+}
