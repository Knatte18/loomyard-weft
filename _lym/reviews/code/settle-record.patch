+// export_linux_test.go exposes the capped run of a host with no user manager to the external tests.
+
+package proc
+
+import "os/exec"
+
+// RunMemoryCappedWithStarter runs cmd capped at limit bytes in a scope that starter, standing in for systemd-run, starts.
+func RunMemoryCappedWithStarter(cmd *exec.Cmd, limit int64, starter string) (killed bool, err error) {
+	return runMemoryCapped(cmd, limit, memoryScope{starter: starter})
+}
+
+// RunMemoryCappedWithoutScope runs cmd capped at limit bytes as a host whose user manager cannot cap a scope does.
+func RunMemoryCappedWithoutScope(cmd *exec.Cmd, limit int64) (killed bool, err error) {
+	return runMemoryCapped(cmd, limit, memoryScope{})
+}
diff --git a/internal/proc/memorycap.go b/internal/proc/memorycap.go
new file mode 100644
index 00000000..a6e36ea7
--- /dev/null
+++ b/internal/proc/memorycap.go
@@ -0,0 +1,27 @@
+// memorycap.go runs a command with the memory of its process tree capped, by whatever means the platform has.
+
+package proc
+
+import "os/exec"
+
+// RunMemoryCapped runs cmd as cmd.Run does, with a cap of limit bytes on the memory cmd and the processes it starts hold.
+// It exists so a runaway command is ended alone, before it takes the memory of everything beside it.
+// On Linux, cmd runs in a transient scope of the systemd user manager whose memory limit is limit, with no swap.
+// The kernel kills a command that passes the limit, and killed reports that kill.
+// cmd keeps its pid and process group there, so a cancel that kills the group still reaches it.
+// On a Linux host whose user manager cannot cap a scope's memory, the data segment of each process is limited instead.
+// On Windows, cmd runs in a job object whose memory limit is limit, and a cancel ends the whole job.
+// cmd joins the job a moment after it starts, so a process it starts in that moment is outside the limit and the cancel.
+// Under those two an allocation past the limit fails in the process that asks for it, and killed stays false.
+// In a scope cmd.ExtraFiles is replaced, so cmd sets none.
+// The error is cmd.Run's, or reports a cap that could not be set, which includes a scope that never ran cmd.
+func RunMemoryCapped(cmd *exec.Cmd, limit int64) (killed bool, err error) {
+	return runMemoryCappedPlatform(cmd, limit)
+}
+
+// MemoryCapCoversTree reports whether a memory cap bounds a command's whole process tree as one.
+// It is false where the cap limits each process alone.
+// The processes of one command can then hold the limit several times over, so a caller runs one capped command at a time.
+func MemoryCapCoversTree() bool {
+	return memoryCapCoversTreePlatform()
+}
diff --git a/internal/proc/memorycap_linux.go b/internal/proc/memorycap_linux.go
new file mode 100644
index 00000000..65d3fd6f
--- /dev/null
+++ b/internal/proc/memorycap_linux.go
@@ -0,0 +1,170 @@
+// memorycap_linux.go caps a command's memory with a transient scope of the systemd user manager.
+// On a host whose user manager cannot cap a scope's memory, it limits the data segment of each process instead.
+
+package proc
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// systemdRun names the command that starts a transient scope.
+const systemdRun = "systemd-run"
+
+// memoryController is the cgroup controller a scope's memory limit needs.
+const memoryController = "memory"
+
+// probeMemoryCap is the memory limit of the scope the probe starts.
+const probeMemoryCap = 64 << 20
+
+// probeTimeout bounds the probe's scope, so a user manager that does not answer reads as a host that cannot cap one.
+// probeWaitDelay bounds the wait for the probe's output once it is killed.
+const (
+	probeTimeout   = 5 * time.Second
+	probeWaitDelay = time.Second
+)
+
+// scopeStartScript is what a scope runs ahead of its command, with the command and its arguments as the script's own.
+// It writes a line to file descriptor 3, which tells the caller the scope started.
+// It then closes the descriptor and becomes the command, so the command's process is the shell's.
+const scopeStartScript = `echo >&3; exec 3>&-; exec "$@"`
+
+// markerReadBound bounds the read of the scope's start line, which a scope that started or failed answers at once.
+const markerReadBound = time.Second
+
+// memoryScope is how the host runs a command in a memory-capped scope; its zero value is a host that cannot.
+type memoryScope struct {
+	// starter is the path of systemd-run, empty on a host that cannot cap a scope's memory.
+	starter string
+}
+
+// hostMemoryScope probes the host once per process.
+var hostMemoryScope = sync.OnceValue(probeMemoryScope)
+
+// probeMemoryScope starts one capped scope and returns the host's memoryScope.
+// The scope prints its own cgroup,
+// and the host can cap one when that cgroup's parent hands the memory controller down.
+// A user manager without that controller starts the scope all the same and caps nothing.
+// A scope that outlasts probeTimeout counts as one the host cannot start.
+func probeMemoryScope() memoryScope {
+	starter, err := exec.LookPath(systemdRun)
+	if err != nil {
+		return memoryScope{}
+	}
+	bounded, cancel := context.WithTimeout(context.Background(), probeTimeout)
+	defer cancel()
+	probe := exec.CommandContext(bounded, starter, memoryScopeArgs(probeMemoryCap, "cat", selfCgroupFile)...)
+	probe.WaitDelay = probeWaitDelay
+	listing, err := probe.Output()
+	if err != nil {
+		return memoryScope{}
+	}
+	cgroup, ok := cgroupV2Path(string(listing))
+	if !ok {
+		return memoryScope{}
+	}
+	controllers, err := os.ReadFile(filepath.Join(cgroupMount, filepath.FromSlash(path.Dir(cgroup)), "cgroup.subtree_control"))
+	if err != nil || !slices.Contains(strings.Fields(string(controllers)), memoryController) {
+		return memoryScope{}
+	}
+	return memoryScope{starter: starter}
+}
+
+// memoryScopeArgs returns systemd-run's arguments for running command in a scope capped at limit bytes with no swap.
+// The scope is collected once it ends, whatever ended it.
+func memoryScopeArgs(limit int64, command ...string) []string {
+	return append([]string{
+		"--user", "--scope", "--quiet", "--collect",
+		"-p", "MemoryMax=" + strconv.FormatInt(limit, 10), "-p", "MemorySwapMax=0", "--",
+	}, command...)
+}
+
+// runMemoryCappedPlatform runs cmd capped at limit bytes by the means the probe found.
+func runMemoryCappedPlatform(cmd *exec.Cmd, limit int64) (bool, error) {
+	return runMemoryCapped(cmd, limit, hostMemoryScope())
+}
+
+// memoryCapCoversTreePlatform reports whether the host caps a command in a scope, which holds its whole tree.
+func memoryCapCoversTreePlatform() bool {
+	return hostMemoryScope().starter != ""
+}
+
+// runMemoryCapped runs cmd capped at limit bytes: in a scope when scope can start one, else under a data segment limit.
+// In a scope, killed reports a command the kernel ended with SIGKILL when no cancel of cmd sent one.
+// A scope that never ran the command returns an error that is no *exec.ExitError, so it never reads as a failing command.
+// The scope path uses cmd.ExtraFiles, so cmd must carry none.
+func runMemoryCapped(cmd *exec.Cmd, limit int64, scope memoryScope) (killed bool, err error) {
+	if scope.starter == "" {
+		return false, runDataLimited(cmd, limit)
+	}
+	started, marker, err := os.Pipe()
+	if err != nil {
+		return false, fmt.Errorf("create the pipe that marks the scope's start: %w", err)
+	}
+	defer started.Close()
+	// systemd-run moves itself into the scope and then becomes the shell, which becomes the command,
+	// so the pid and process group stay cmd's own.
+	shell := []string{"/bin/sh", "-c", scopeStartScript, "sh", cmd.Path}
+	cmd.Args = append([]string{systemdRun}, memoryScopeArgs(limit, append(shell, cmd.Args[1:]...)...)...)
+	cmd.Path = scope.starter
+	cmd.ExtraFiles = []*os.File{marker}
+	var cancelled atomic.Bool
+	if cancel := cmd.Cancel; cancel != nil {
+		cmd.Cancel = func() error {
+			cancelled.Store(true)
+			return cancel()
+		}
+	}
+	err = cmd.Start()
+	marker.Close()
+	if err != nil {
+		return false, err
+	}
+	err = cmd.Wait()
+	if cmd.ProcessState == nil || cancelled.Load() {
+		return false, err
+	}
+	if !scopeStarted(started) {
+		return false, fmt.Errorf("the scope did not run the command, and %s ended with: %v", systemdRun, err)
+	}
+	status, ok := cmd.ProcessState.Sys().(syscall.WaitStatus)
+	return ok && status.Signaled() && status.Signal() == syscall.SIGKILL, err
+}
+
+// scopeStarted reports whether the scope's shell wrote its start line to started, the read end of the scope's start pipe.
+func scopeStarted(started *os.File) bool {
+	_ = started.SetReadDeadline(time.Now().Add(markerReadBound))
+	_, err := started.Read(make([]byte, 1))
+	return err == nil
+}
+
+// runDataLimited runs cmd with the data segment of its process limited to limit bytes.
+// Every process cmd starts from then on inherits the limit as its own.
+// The limit counts the memory a process maps to write to, not the address space it only reserves.
+// It is set once cmd has started, since a command cannot be started with one.
+func runDataLimited(cmd *exec.Cmd, limit int64) error {
+	if err := cmd.Start(); err != nil {
+		return err
+	}
+	bound := unix.Rlimit{Cur: uint64(limit), Max: uint64(limit)}
+	if err := unix.Prlimit(cmd.Process.Pid, unix.RLIMIT_DATA, &bound, nil); err != nil && !errors.Is(err, unix.ESRCH) {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		return fmt.Errorf("limit the data segment of process %d: %w", cmd.Process.Pid, err)
+	}
+	return cmd.Wait()
+}
diff --git a/internal/proc/memorycap_linux_test.go b/internal/proc/memorycap_linux_test.go
new file mode 100644
index 00000000..5696af9f
--- /dev/null
+++ b/internal/proc/memorycap_linux_test.go
@@ -0,0 +1,94 @@
+// memorycap_linux_test.go covers what a memory-capped run does on Linux alone.
+// A scope reports the kernel's kill, and a host with no user manager fails the child's own allocation.
+// A scope that never starts is an error, and a cancel still ends a capped run through its process group.
+
+package proc_test
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"os/exec"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestRunMemoryCapped_EndsAChildOverTheCapByTheHostsMeans(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		run  func(cmd *exec.Cmd, limit int64) (bool, error)
+		// needsScope is set for a row that runs only where the user manager can cap a scope's memory.
+		needsScope bool
+		wantKilled bool
+	}{
+		{"AScopeReportsTheKernelsKill", proc.RunMemoryCapped, true, true},
+		{"WithNoUserManagerTheChildFailsItsOwnAllocation", proc.RunMemoryCappedWithoutScope, false, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if tt.needsScope && !proc.MemoryCapCoversTree() {
+				t.Skip("this host has no systemd user manager that caps a scope's memory")
+			}
+			killed, err := tt.run(memoryHog(t, hogOverCap), testMemoryCap)
+			if err == nil || killed != tt.wantKilled {
+				t.Errorf("capped run of a child keeping %d MB under %d = killed %v, %v; want killed %v and an error", hogOverCap, testMemoryCap, killed, err, tt.wantKilled)
+			}
+		})
+	}
+}
+
+func TestRunMemoryCapped_AScopeThatNeverStartsIsAnErrorAndNotTheCommandsExit(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	// /bin/false stands in for a systemd-run that cannot create the scope: it exits 1 before it runs the command.
+	killed, err := proc.RunMemoryCappedWithStarter(exec.Command("echo", "never runs"), testMemoryCap, "/bin/false")
+	var exitErr *exec.ExitError
+	if err == nil || errors.As(err, &exitErr) || killed {
+		t.Errorf("RunMemoryCapped with a starter that fails at once = killed %v, %v; want no kill and an error that is no *exec.ExitError", killed, err)
+	}
+}
+
+func TestRunMemoryCapped_ACancelEndsTheRunAndIsNoCapKill(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	// The shell becomes a sleep that outlasts the minute the test allows, so only the cancel ends the run.
+	cmd := exec.CommandContext(ctx, "sh", "-c", "echo started; exec sleep 300")
+	proc.ConfigureGroupKill(cmd, func(int, error) {})
+	reader, writer := io.Pipe()
+	cmd.Stdout = writer
+	type outcome struct {
+		killed bool
+		err    error
+	}
+	done := make(chan outcome, 1)
+	go func() {
+		killed, err := proc.RunMemoryCapped(cmd, testMemoryCap)
+		writer.Close()
+		done <- outcome{killed, err}
+	}()
+	if line, err := bufio.NewReader(reader).ReadString('\n'); err != nil || line != "started\n" {
+		t.Fatalf("the capped command printed %q, %v; want its started line", line, err)
+	}
+
+	cancel()
+	select {
+	case got := <-done:
+		if got.killed || got.err == nil {
+			t.Errorf("RunMemoryCapped after a cancel = killed %v, %v; want no cap kill and the cancelled command's error", got.killed, got.err)
+		}
+	case <-time.After(time.Minute):
+		t.Fatal("the capped command was still running a minute after its cancel")
+	}
+}
diff --git a/internal/proc/memorycap_test.go b/internal/proc/memorycap_test.go
