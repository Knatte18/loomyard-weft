+// usersetup_test.go covers the user-setup source: the CLAUDE.md files it returns and the skill listing it builds.
+
+package claudeengine
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
