+	})
+
+	t.Run("RelaySettlesAcceptedMessagesBeforeAnyTakeAndPostsTheRest", func(t *testing.T) {
+		t.Parallel()
+		r := newRelayRun(t)
+		approvePeer(t, r.geom, r.harness.clock.Now())
+		if err := os.MkdirAll(r.geom.Dir, 0o700); err != nil {
+			t.Fatalf("MkdirAll = %v", err)
+		}
+		if err := os.WriteFile(r.geom.BridgePostsPath, []byte(`{"accepted":{"9":"1.000009"}}`), 0o600); err != nil {
+			t.Fatalf("WriteFile = %v", err)
+		}
+		accepted := creelengine.MachineOutbound{ID: 9, From: primeOrch, To: peerOrch, ReceivingMachine: "osl", Body: "old", Posted: r.harness.clock.Now()}
+		fresh := creelengine.MachineOutbound{ID: 10, From: primeOrch, To: peerOrch, ReceivingMachine: "osl", Body: "new", Posted: r.harness.clock.Now()}
+		r.mailbox.setPending(accepted, fresh)
+		r.start()
+		eventually(t, "the relay to post the fresh message", func() bool { return len(r.slack.logged("PostTimestamped")) == 1 })
+		eventually(t, "both messages to be settled", func() bool { return len(r.mailbox.machineLog("SettleDelivered")) == 2 })
+		settles := r.mailbox.machineLog("SettleDelivered")
+		if settles[0] != (machineCall{Verb: "SettleDelivered", ID: 9, Arg: "1.000009"}) {
+			t.Errorf("first settle = %+v; want the accepted message settled with its recorded timestamp", settles[0])
+		}
+		if posts := r.slack.logged("PostTimestamped"); posts[0].Arg != envelopeText(10, "new") {
+			t.Errorf("post = %q; want the fresh message", posts[0].Arg)
+		}
+	})
+}
diff --git a/internal/slackengine/bridgepoll.go b/internal/slackengine/bridgepoll.go
new file mode 100644
index 00000000..8ab430b6
--- /dev/null
+++ b/internal/slackengine/bridgepoll.go
@@ -0,0 +1,116 @@
+// bridgepoll.go is the bridge poll: the loop that runs the relay's bridge round, backing off while nothing is new.
+
+package slackengine
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	// bridgePollBase is the wait after a round that posted or delivered something new, and the first wait of the loop.
+	bridgePollBase = 5 * time.Second
+	// bridgePollCeiling is the longest wait between two rounds.
+	bridgePollCeiling = 60 * time.Second
+)
+
+// bridgeRound is one round of the relay's bridge work.
+// It sends the machine mail creel holds.
+// Then it looks for bridge channels the hub lacks when a look is due, and reads the channels.
+// One goroutine runs it, the bridge poll's.
+type bridgeRound struct {
+	sender *bridgeSender
+	reader *bridgeReader
+	clock  Clock
+	log    *relayLog
+	// resyncWanted is set by the wake loop when the socket holder saw an event in a channel no map holds.
+	resyncWanted *atomic.Bool
+	// lastResync is when the previous look for bridge channels began, the zero time before the first.
+	lastResync time.Time
+}
+
+// run makes one round and reports whether it posted or delivered something new.
+// The look for bridge channels is due at the first round and when the wake loop marked one wanted.
+// It is also due once bridgePollCeiling has passed since the previous look.
+func (b *bridgeRound) run(ctx context.Context) bool {
+	posted, err := b.sender.send(ctx)
+	if err != nil {
+		b.log.fail("bridge-send", err)
+	} else {
+		b.log.recovered("bridge-send")
+	}
+	now := b.clock.Now()
+	if b.resyncWanted.Swap(false) || now.Sub(b.lastResync) >= bridgePollCeiling {
+		b.lastResync = now
+		if err := b.reader.resync(ctx); err != nil {
+			b.log.fail("bridge-resync", err)
+		} else {
+			b.log.recovered("bridge-resync")
+		}
+	}
+	delivered, err := b.reader.read(ctx)
+	if err != nil {
+		b.log.fail("bridge-read", err)
+	} else {
+		b.log.recovered("bridge-read")
+	}
+	return posted || delivered
+}
+
+// bridgePoll runs a round of the relay's bridge work in a loop.
+type bridgePoll struct {
+	clock Clock
+	// woken holds one pending wake, which ends the loop's next wait at once.
+	woken chan struct{}
+}
+
+// newBridgePoll returns a bridge poll that waits on clock.
+func newBridgePoll(clock Clock) *bridgePoll {
+	return &bridgePoll{clock: clock, woken: make(chan struct{}, 1)}
+}
+
+// wake ends the current wait at once, and the next one when no wait is current.
+// The loop never starts a round within wakeFloor of the previous round's start.
+func (p *bridgePoll) wake() {
+	select {
+	case p.woken <- struct{}{}:
+	default:
+	}
+}
+
+// run calls round until ctx ends, waiting between rounds.
+// round reports whether it posted or delivered something new; a held message it read again is not new.
+// The wait is bridgePollBase after such a round, and otherwise the previous wait doubled up to bridgePollCeiling.
+func (p *bridgePoll) run(ctx context.Context, round func(ctx context.Context) bool) {
+	delay := bridgePollBase
+	for ctx.Err() == nil {
+		started := p.clock.Now()
+		progressed := round(ctx)
+		if progressed {
+			delay = bridgePollBase
+		}
+		if !p.await(ctx, delay, started) {
+			return
+		}
+		if !progressed {
+			delay = min(delay*2, bridgePollCeiling)
+		}
+	}
+}
+
+// await waits delay, or until a wake ends the wait once wakeFloor has passed since started.
+// It reports false when ctx ended first.
+func (p *bridgePoll) await(ctx context.Context, delay time.Duration, started time.Time) bool {
+	select {
+	case <-p.clock.After(delay):
+		return true
+	case <-p.woken:
+		if rest := wakeFloor - p.clock.Now().Sub(started); rest > 0 {
+			return waitFor(ctx, p.clock, rest)
+		}
+		return ctx.Err() == nil
+	case <-ctx.Done():
+		return false
+	}
+}
diff --git a/internal/slackengine/bridgerecords.go b/internal/slackengine/bridgerecords.go
new file mode 100644
index 00000000..df2c428b
--- /dev/null
+++ b/internal/slackengine/bridgerecords.go
@@ -0,0 +1,86 @@
+// bridgerecords.go holds the hub's two records of the relay's bridge sending.
+// They are the posts Slack accepted and the notices sent.
+
+package slackengine
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// bridgePosts is the record of the machine mail the relay posted to bridge channels.
+// It is apart from the outbox record of orch mail, so a confirmed orch-mail read never clears it.
+type bridgePosts struct {
+	// Accepted maps the id of each message Slack accepted to the timestamp Slack gave it, until creel has settled it.
+	Accepted map[int64]string `json:"accepted,omitempty"`
+	// Refusals counts how often Slack refused each message with an error code.
+	Refusals map[int64]int `json:"refusals,omitempty"`
+}
+
+// bridgeNotices is the record of the bridge notices already sent.
+// It keeps a restarted relay from posting a second notice per episode.
+type bridgeNotices struct {
+	// Marks maps the key of each notice sent to when it was sent.
+	Marks map[string]time.Time `json:"marks,omitempty"`
+}
+
+// readBridgePosts reads the bridge-post record at path, and reads a missing file as an empty record.
+func readBridgePosts(path string) (bridgePosts, error) {
+	posts, _, err := state.ReadJSON[bridgePosts](path, recordLockPath(path))
+	if err != nil {
+		return bridgePosts{}, fmt.Errorf("slack: read the bridge-post record %s: %w", path, err)
+	}
+	return posts, nil
+}
+
+// writeBridgePosts stores posts at path, keeping any key of the file that bridgePosts does not declare.
+func writeBridgePosts(path string, posts bridgePosts) error {
+	if err := state.WriteJSON(path, recordLockPath(path), posts); err != nil {
+		return fmt.Errorf("slack: write the bridge-post record %s: %w", path, err)
+	}
+	return nil
+}
+
+// readBridgeNotices reads the bridge-notice record at path, and reads a missing file as an empty record.
+func readBridgeNotices(path string) (bridgeNotices, error) {
+	notices, _, err := state.ReadJSON[bridgeNotices](path, recordLockPath(path))
+	if err != nil {
+		return bridgeNotices{}, fmt.Errorf("slack: read the bridge-notice record %s: %w", path, err)
+	}
+	return notices, nil
+}
+
+// markBridgeNotice sets key in the bridge-notice record at path.
+// It answers true only when the key was unset, so the caller that gets true sends the notice.
+func markBridgeNotice(path, key string) (bool, error) {
+	marked := false
+	err := state.UpdateJSON(path, recordLockPath(path), func(current bridgeNotices, _ bool) (bridgeNotices, error) {
+		if _, set := current.Marks[key]; set {
+			return current, nil
+		}
+		if current.Marks == nil {
+			current.Marks = map[string]time.Time{}
+		}
+		current.Marks[key] = time.Now().UTC()
+		marked = true
+		return current, nil
+	})
+	if err != nil {
+		return false, fmt.Errorf("slack: write the bridge-notice record %s: %w", path, err)
+	}
+	return marked, nil
+}
+
+// clearBridgeNotice drops key from the bridge-notice record at path, so the next episode of the notice sends it again.
+func clearBridgeNotice(path, key string) error {
+	err := state.UpdateJSON(path, recordLockPath(path), func(current bridgeNotices, _ bool) (bridgeNotices, error) {
+		delete(current.Marks, key)
+		return current, nil
+	})
+	if err != nil {
+		return fmt.Errorf("slack: write the bridge-notice record %s: %w", path, err)
+	}
+	return nil
+}
