+		}
+		var branch string
+		var err error
+		if slug == primeSlug {
+			branch, err = gitrepo.New(prime.WorktreePath()).CurrentBranch()
+		} else {
+			branch, err = t.PairTaskBranchOrOrigin(prime, slug)
+		}
+		if err != nil {
+			return "", fmt.Errorf("read the code branch of %s: %w", slug, err)
+		}
+		codeBranches[slug] = branch
+		return branch, nil
