+
+func (b *templateBuildTB) Fatal(args ...any) {
+	b.Error(args...)
+	runtime.Goexit()
+}
+
+func (b *templateBuildTB) Fatalf(format string, args ...any) {
+	b.Errorf(format, args...)
+	runtime.Goexit()
