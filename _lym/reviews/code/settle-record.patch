-	case err != nil:
-		entry.label = "miss: " + testcover.Miss{Reason: testcover.MissParse, Detail: err.Error()}.String()
-		return entry
-	}
-	entry.tests = coverageUnion(declared, selection, guards[dir])
-	entry.whole = false
-	entry.label = coverageNone
