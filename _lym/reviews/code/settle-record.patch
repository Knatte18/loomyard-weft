@@ -0,0 +1,155 @@
+// codexengine.go defines the Codex type, its constructors and Prepare, which readies the lym Codex home and writes the run's prompt file before returning the launch.
+
+package codexengine
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/shell"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// engineName is the name the engine registers under, which the standing passages are keyed by.
+const engineName = "codex"
+
+// defaultSubmitRedrawSettleMS is the redraw settle New uses, matching the shipped shuttle template.
+const defaultSubmitRedrawSettleMS = 300
+
+// Codex implements shuttleengine.Engine for the Codex CLI's interactive TUI.
+// Prepare and CheckAfterStartup read codex.yaml through the Dirs fixed at construction, and every other method is a pure function of its arguments, its settle and the files it is pointed at,
+// so a Codex is safe to share across concurrent runs.
+type Codex struct {
+	// dirs locate the layered codex.yaml, the anchor a launch starts in and the records checkout the session may write; the zero value makes Prepare refuse, so an engine built by New serves reading uses only.
+	dirs configengine.Dirs
+	// submitRedrawSettleMS is the wait after an Enter before the composer is read, so Codex has redrawn it.
+	submitRedrawSettleMS int
+	// warn logs what a launch goes on despite; tests replace it to read the warnings of one engine.
+	warn func(msg string, args ...any)
+}
+
+var (
+	_ shuttleengine.Engine         = (*Codex)(nil)
+	_ shuttleengine.StartupChecker = (*Codex)(nil)
+)
+
+// New returns a Codex engine with the default redraw settle and no Dirs.
+func New() *Codex {
+	return &Codex{submitRedrawSettleMS: defaultSubmitRedrawSettleMS, warn: logger.Warn}
+}
+
+// NewFromConfig returns a Codex engine whose redraw settle is cfg.SubmitRedrawSettleMS and which reads codex.yaml and its anchor from dirs.
+func NewFromConfig(cfg shuttleengine.Config, dirs configengine.Dirs) *Codex {
+	return &Codex{dirs: dirs, submitRedrawSettleMS: cfg.SubmitRedrawSettleMS, warn: logger.Warn}
+}
+
+// Legal Spec.PermissionMode values: empty and bypass, the mode every launch runs in.
+const permissionModeBypass = "bypass"
+
+// validateSpec refuses what a Codex launch cannot realize, before anything is written: a version pin, a permission mode other than bypass, a resumed session, the publish guard, and an effort codex.yaml does not list.
+func validateSpec(spec shuttleengine.Spec, codex Config) error {
+	if spec.Version != "" {
+		return fmt.Errorf("codexengine: version %q given, but Codex takes a model slug and no version pin; way forward: name the slug as the model-spec's model", spec.Version)
+	}
+	if spec.PermissionMode != "" && spec.PermissionMode != permissionModeBypass {
+		return fmt.Errorf("codexengine: permission mode %q is not realizable; every Codex launch runs -a never, the bypass mode; way forward: leave it empty or set %q", spec.PermissionMode, permissionModeBypass)
+	}
+	if spec.ResumeSessionID != "" {
+		return fmt.Errorf("codexengine: Codex sessions cannot be resumed by a new run; way forward: start a fresh session")
+	}
+	if spec.DenyPublish {
+		return fmt.Errorf("codexengine: the publish guard is not installed on Codex yet; way forward: run the role on the claude engine")
+	}
+	return validateEffort(spec.Effort, codex)
+}
+
+// Prepare readies a Codex launch and returns its lines.
+// It validates the spec, reads the checkout the anchor sits in and refuses under committed Codex rules before anything is written;
+// it then readies the lym home, trusting the worktree root and a linked worktree's main checkout root, and writes prompt.md into runDir.
+// The prompt file opens with the standing passages heddle holds for engine codex and the spec's role, then the spec's prompt.
+// The launch line's writable root is the records checkout the engine is told through its Dirs, symlink-resolved and kept as told with a Warn when it cannot be resolved, so the session writes its report through the anchor's `.lym` and `_lym` links; outside a hub it is empty and the line adds none.
+// The launch records session starts, carries no creel hooks and names no session id, since Codex mints its own at the first turn.
+func (c *Codex) Prepare(runDir string, spec shuttleengine.Spec, cfg shuttleengine.Config) (shuttleengine.Launch, error) {
+	codex, err := loadConfigOrRefuse(c.dirs)
+	if err != nil {
+		return shuttleengine.Launch{}, err
+	}
+	if err := validateSpec(spec, codex); err != nil {
+		return shuttleengine.Launch{}, err
+	}
+	homes, err := resolveHomes(codex)
+	if err != nil {
+		return shuttleengine.Launch{}, err
+	}
+	anchor := c.dirs.Anchor
+	if anchor == "" || !filepath.IsAbs(anchor) {
+		return shuttleengine.Launch{}, fmt.Errorf("codexengine: the engine was told no absolute anchor (%q), so it cannot locate the checkout a launch starts in", anchor)
+	}
+	found, err := readCheckout(anchor)
+	if err != nil {
+		return shuttleengine.Launch{}, err
+	}
+	if err := c.checkCodexFolders(found, anchor); err != nil {
+		return shuttleengine.Launch{}, err
+	}
+	if err := c.prepareHome(homes, found.trustRoots()); err != nil {
+		return shuttleengine.Launch{}, err
+	}
+
+	absRunDir, err := filepath.Abs(runDir)
+	if err != nil {
+		return shuttleengine.Launch{}, fmt.Errorf("codexengine: resolve run directory %s: %w", runDir, err)
+	}
+	promptPath := filepath.Join(absRunDir, "prompt.md")
+	// The told Board dir is the hub's Bolt checkout, empty outside a hub.
+	passages := shuttleengine.StandingPassages(c.dirs.Board, engineName, spec.Role)
+	if err := os.WriteFile(promptPath, []byte(promptText(passages, spec.Prompt)), 0o644); err != nil {
+		return shuttleengine.Launch{}, fmt.Errorf("codexengine: write prompt: %w", err)
+	}
+
+	var writableRoots []string
+	if c.dirs.Records != "" {
+		// Codex keys a linked path by its resolved target, as it does the trust roots.
+		records, err := filepath.EvalSymlinks(c.dirs.Records)
+		if err != nil {
+			c.warn("codexengine: records checkout not resolvable, using the told path as the writable root", "path", c.dirs.Records, "error", err)
+			records = c.dirs.Records
+		}
+		writableRoots = []string{records}
+	}
+	sh := shell.ForGOOS()
+	return shuttleengine.Launch{
+		Cmd: buildLaunchCmd(sh, launchLine{
+			bin:           codexBinary(codex),
+			home:          homes.lym,
+			writableRoots: writableRoots,
+			model:         spec.Model,
+			effort:        spec.Effort,
+			hooks:         hookSettings(filepath.Join(absRunDir, "events.jsonl")),
+			firstTurn:     launchPointer(promptPath),
+		}),
+		ResumeCmd:            buildResumeCmd(sh),
+		RecordsSessionStarts: true,
+	}, nil
+}
+
+// promptText returns the prompt file's text: each passage, then prompt, separated by blank lines.
+func promptText(passages []string, prompt string) string {
+	return strings.Join(append(slices.Clone(passages), prompt), "\n\n")
+}
+
+// PromptCacheLifetime returns zero: Codex states no warm lifetime for its prompt cache, so a caller keeps nothing warm.
+func (c *Codex) PromptCacheLifetime(shuttleengine.Spec, shuttleengine.Config) (time.Duration, error) {
+	return 0, nil
+}
+
+// KeepWarmCaps returns zero caps: with no warm lifetime to keep, a Codex session blocks to the end of a wait.
+func (c *Codex) KeepWarmCaps(string) (time.Duration, time.Duration, error) {
+	return 0, 0, nil
+}
diff --git a/internal/shuttleengine/codexengine/command.go b/internal/shuttleengine/codexengine/command.go
new file mode 100644
index 00000000..6dff171a
--- /dev/null
+++ b/internal/shuttleengine/codexengine/command.go
@@ -0,0 +1,173 @@
+// command.go composes the pane-shell lines Prepare hands back as a Launch, and the `-c` hook settings the launch line carries.
+// The launch line starts the Codex TUI under the lym home with its first turn as the positional argument, then exits the pane's shell, so a Codex exit leaves a dead pane.
+// The resume line exits the pane's shell alone and starts no Codex.
+// Every hook is a plain POSIX sh command that appends a stamp line and its payload to the run's events file, or touches the run's activity stamp.
+// Argument quoting and statement chaining are pane-shell mechanics owned by internal/shell.
+
+package codexengine
+
+import (
+	"path"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/shell"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// codexHomeEnvKey is the variable Codex reads its home directory from.
+// It rides the pane line because reed's server environment is scrubbed of every CODEX_ key.
+const codexHomeEnvKey = "CODEX_HOME"
+
+// instructionFallbackFile is the file Codex loads as project instructions in a directory with no AGENTS.md.
+const instructionFallbackFile = "CLAUDE.md"
+
+// launchPointer returns the first turn of a session that loads no skills: a pointer to the prompt file at promptPath.
+func launchPointer(promptPath string) string {
+	return "Read " + promptPath + " in full first; it is your complete, authoritative instructions."
+}
+
+// launchLine is what buildLaunchCmd composes a launch line from.
+type launchLine struct {
+	// bin is the Codex executable.
+	bin string
+	// home is the lym Codex home the session runs under.
+	home string
+	// writableRoots are the folders outside the workspace the sandbox lets the session write.
+	writableRoots []string
+	// model is the model slug; empty takes Codex's default.
+	model string
+	// effort is the reasoning effort; empty takes Codex's default.
+	effort string
+	// hooks are the `-c` hook settings, each one `hooks.<Event>=[…]` value.
+	hooks []string
+	// firstTurn is the session's first turn, typed as the positional prompt.
+	firstTurn string
+}
+
+// buildLaunchCmd composes the pane-shell line that starts a Codex session and exits the pane's shell when Codex exits.
+// The line runs `-a never -s workspace-write`, so no approval prompt shows and the sandbox bounds writes to the workspace, the writable roots and the temporary folders.
+// It passes every hook setting with `--dangerously-bypass-hook-trust`, since a hook given by `-c` otherwise waits on a review prompt,
+// and it loads CLAUDE.md as the project instructions of a directory with no AGENTS.md.
+// CODEX_HOME names the lym home as a command-scoped assignment.
+func buildLaunchCmd(sh shell.Shell, line launchLine) string {
+	cmd := sh.Invoke(line.bin) + " --no-alt-screen -a never -s workspace-write"
+	if len(line.writableRoots) > 0 {
+		cmd += " -c " + sh.Quote("sandbox_workspace_write.writable_roots="+tomlArray(line.writableRoots))
+	}
+	if line.model != "" {
+		cmd += " -m " + sh.Quote(line.model)
+	}
+	if line.effort != "" {
+		cmd += " -c " + sh.Quote("model_reasoning_effort="+tomlString(line.effort))
+	}
+	cmd += " -c " + sh.Quote("project_doc_fallback_filenames="+tomlArray([]string{instructionFallbackFile}))
+	for _, hook := range line.hooks {
+		cmd += " -c " + sh.Quote(hook)
+	}
+	cmd += " --dangerously-bypass-hook-trust " + sh.Quote(line.firstTurn)
+	return sh.Chain(sh.WithEnv(codexHomeEnvKey, line.home, cmd), sh.Exit())
+}
+
+// buildResumeCmd composes the line reed replays to revive the strand: an exit of the pane's shell and no Codex.
+// Codex mints its session id at the first turn, which a line written before the launch cannot name, so a revive ends the run as died instead of starting a second session.
+func buildResumeCmd(sh shell.Shell) string {
+	return sh.Exit()
+}
+
+// Stamp line keys: a stamp line is {"lym_stamp":"<hook event name>","lym_at":"<RFC 3339 UTC>"}, written by a recording hook before its payload.
+const (
+	stampHookKey = "lym_stamp"
+	stampAtKey   = "lym_at"
+)
+
+// Hook event names, as Codex's hook settings key them and its payloads carry them in hook_event_name.
+const (
+	hookEventSessionStart      = "SessionStart"
+	hookEventUserPromptSubmit  = "UserPromptSubmit"
+	hookEventStop              = "Stop"
+	hookEventPermissionRequest = "PermissionRequest"
+	hookEventPostToolUse       = "PostToolUse"
+)
+
+// recordedHookEvents are the hooks whose payloads the events file records, in the order their settings ride the launch line.
+var recordedHookEvents = []string{hookEventSessionStart, hookEventUserPromptSubmit, hookEventStop, hookEventPermissionRequest}
+
+// emptyHookOutput is what every hook prints: an empty decision, which leaves the session's behaviour unchanged.
+const emptyHookOutput = "printf '{}\\n'"
+
+// recordingCommand returns the hook command that appends one hook event to the events file at eventsPath:
+// a stamp line naming hookEventName with the hook-side time, then the payload on standard input and a newline, then the empty hook output.
+// A failed `date` leaves the stamp's time empty, which the parser reads as no time.
+func recordingCommand(hookEventName, eventsPath string) string {
+	quoted := shell.Posix().Quote(eventsPath)
+	stamp := `printf '{"` + stampHookKey + `":"` + hookEventName + `","` + stampAtKey + `":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> ` + quoted
+	payload := "cat >> " + quoted + " && printf '\\n' >> " + quoted
+	return stamp + "; " + payload + "; " + emptyHookOutput
+}
+
+// activityCommand returns the hook command that touches the activity stamp beside the events file at eventsPath and prints the empty hook output, so a failed touch never blocks the session.
+func activityCommand(eventsPath string) string {
+	stampPath := path.Join(path.Dir(eventsPath), shuttleengine.ActivityStampFileName)
+	return "touch " + shell.Posix().Quote(stampPath) + "; " + emptyHookOutput
+}
+
+// toolMatcherAll is the matcher a tool hook takes to run on every tool.
+const toolMatcherAll = "*"
+
+// hookSettings returns the `-c` hook settings of a run whose events file is eventsPath: a recording hook per recorded event, then the activity hook after every tool call.
+func hookSettings(eventsPath string) []string {
+	settings := make([]string, 0, len(recordedHookEvents)+1)
+	for _, event := range recordedHookEvents {
+		settings = append(settings, hookSetting(event, "", recordingCommand(event, eventsPath)))
+	}
+	return append(settings, hookSetting(hookEventPostToolUse, toolMatcherAll, activityCommand(eventsPath)))
+}
+
+// hookSetting returns one `hooks.<event>=[…]` setting running command, with matcher when non-empty.
+func hookSetting(event, matcher, command string) string {
+	entry := "{"
+	if matcher != "" {
+		entry += "matcher=" + tomlString(matcher) + ","
+	}
+	entry += `hooks=[{type="command",command=` + tomlString(command) + "}]}"
+	return "hooks." + event + "=[" + entry + "]"
+}
+
+// tomlString returns s as a TOML basic string.
+func tomlString(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"':
+			b.WriteString(`\"`)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r == '\n':
+			b.WriteString(`\n`)
+		case r == '\t':
+			b.WriteString(`\t`)
+		case r < 0x20 || r == 0x7f:
+			b.WriteString(`\u00` + hexByte(byte(r)))
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// hexByte returns b as two uppercase hex digits.
+func hexByte(b byte) string {
+	const digits = "0123456789ABCDEF"
+	return string([]byte{digits[b>>4], digits[b&0x0f]})
+}
+
+// tomlArray returns values as a TOML array of basic strings.
+func tomlArray(values []string) string {
+	quoted := make([]string, len(values))
+	for i, value := range values {
+		quoted[i] = tomlString(value)
+	}
+	return "[" + strings.Join(quoted, ",") + "]"
+}
diff --git a/internal/shuttleengine/codexengine/command_test.go b/internal/shuttleengine/codexengine/command_test.go
new file mode 100644
index 00000000..a51b1b4f
--- /dev/null
+++ b/internal/shuttleengine/codexengine/command_test.go
@@ -0,0 +1,96 @@
+// command_test.go pins the launch and resume lines, the `-c` hook settings and the TOML quoting they carry.
+
+package codexengine
+
+import (
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shell"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestBuildLaunchCmd pins the POSIX launch line: CODEX_HOME leading, every flag of the spike's line with the writable root, model and effort when set, each hook setting, the bypass flag, the first turn, and the shell exit.
+func TestBuildLaunchCmd(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		line launchLine
+		want string
+	}{
+		{
+			name: "EveryInput",
+			line: launchLine{bin: "codex", home: "/h", writableRoots: []string{"/links"}, model: "gpt-6-luna", effort: "low", hooks: []string{`hooks.Stop=[{hooks=[]}]`}, firstTurn: "Read it"},
+			want: `CODEX_HOME='/h' 'codex' --no-alt-screen -a never -s workspace-write -c 'sandbox_workspace_write.writable_roots=["/links"]' -m 'gpt-6-luna' -c 'model_reasoning_effort="low"' -c 'project_doc_fallback_filenames=["CLAUDE.md"]' -c 'hooks.Stop=[{hooks=[]}]' --dangerously-bypass-hook-trust 'Read it'; exit`,
+		},
+		{
+			name: "NoWritableRootModelOrEffort",
+			line: launchLine{bin: "codex", home: "/h", firstTurn: "it's"},
+			want: `CODEX_HOME='/h' 'codex' --no-alt-screen -a never -s workspace-write -c 'project_doc_fallback_filenames=["CLAUDE.md"]' --dangerously-bypass-hook-trust 'it'\''s'; exit`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := buildLaunchCmd(shell.Posix(), tt.line); got != tt.want {
+				t.Errorf("buildLaunchCmd() = %s; want %s", got, tt.want)
+			}
+		})
+	}
+	if got := buildResumeCmd(shell.Posix()); got != "exit" {
+		t.Errorf("buildResumeCmd() = %q; want exit", got)
+	}
+}
+
+// TestHookSettings pins one setting per recorded hook in order, then the activity hook on every tool, each running the command for the run's events file.
+func TestHookSettings(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	events := "/run/events.jsonl"
+	got := hookSettings(events)
+	want := []string{
+		hookSetting(hookEventSessionStart, "", recordingCommand(hookEventSessionStart, events)),
+		hookSetting(hookEventUserPromptSubmit, "", recordingCommand(hookEventUserPromptSubmit, events)),
+		hookSetting(hookEventStop, "", recordingCommand(hookEventStop, events)),
+		hookSetting(hookEventPermissionRequest, "", recordingCommand(hookEventPermissionRequest, events)),
+		hookSetting(hookEventPostToolUse, "*", activityCommand(events)),
+	}
+	if len(got) != len(want) {
+		t.Fatalf("hookSettings() = %d settings; want %d", len(got), len(want))
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("hookSettings()[%d] = %s; want %s", i, got[i], want[i])
+		}
+	}
+	if got, want := hookSetting("PostToolUse", "*", `touch '/a'; printf '{}\n'`), `hooks.PostToolUse=[{matcher="*",hooks=[{type="command",command="touch '/a'; printf '{}\\n'"}]}]`; got != want {
+		t.Errorf("hookSetting() = %s; want %s", got, want)
+	}
+	if got, want := activityCommand(events), `touch '/run/activity-stamp'; printf '{}\n'`; got != want {
+		t.Errorf("activityCommand() = %s; want %s", got, want)
+	}
+}
+
+// TestTOMLString pins the basic-string escapes: quote, backslash, newline, tab and other control characters.
+func TestTOMLString(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		in, want string
+	}{
+		{`plain`, `"plain"`},
+		{`a "b" c\d`, `"a \"b\" c\\d"`},
+		{"line\nnext\ttab\x01", `"line\nnext\ttab\u0001"`},
+	}
+	for _, tt := range tests {
+		if got := tomlString(tt.in); got != tt.want {
+			t.Errorf("tomlString(%q) = %s; want %s", tt.in, got, tt.want)
+		}
+	}
+	if got, want := tomlArray([]string{"/a", "/b"}), `["/a","/b"]`; got != want {
+		t.Errorf("tomlArray() = %s; want %s", got, want)
+	}
+}
diff --git a/internal/shuttleengine/codexengine/config.go b/internal/shuttleengine/codexengine/config.go
new file mode 100644
index 00000000..bcc7b2e9
--- /dev/null
+++ b/internal/shuttleengine/codexengine/config.go
@@ -0,0 +1,130 @@
+// config.go declares the codex engine's config module, codex.yaml: its template, its layered-load spec, LoadConfig and the resolution of its home paths.
+
+package codexengine
+
+import (
+	_ "embed"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+)
+
+//go:embed template.yaml
+var configTemplate string
+
+// ConfigTemplate returns codex.yaml's default YAML template.
+func ConfigTemplate() string {
+	return configTemplate
+}
+
+// Config is the resolved codex.yaml: the Codex binary, the shared lym Codex home and the operator's own, the efforts a launch may take and the skill roots.
+type Config struct {
+	// Binary is the path to the codex executable; empty falls back to "codex" on PATH.
+	Binary string `yaml:"binary"`
+	// Home is the shared lym Codex home every launch runs under; a leading "~/" names the user's home directory.
+	Home string `yaml:"home"`
+	// OperatorHome is the operator's own Codex home, which lym never writes; a leading "~/" names the user's home directory.
+	OperatorHome string `yaml:"operator_home"`
+	// Efforts are the reasoning efforts a launch may take.
+	Efforts []string `yaml:"efforts"`
+	// SkillRoots are the directories a skill is looked up under when a session loads skills.
+	SkillRoots []string `yaml:"skill_roots"`
+}
+
+// ConfigSpec returns codex.yaml's layered-load spec: a per-worktree module whose binary a local override may not set.
+func ConfigSpec() configengine.Spec {
+	return configengine.Spec{
+		Name:     "codex",
+		Template: []byte(ConfigTemplate()),
+		Categories: map[string]configengine.Category{
+			"binary":        configengine.CategoryExecutable,
+			"home":          configengine.CategoryNone,
+			"operator_home": configengine.CategoryNone,
+			"efforts":       configengine.CategoryNone,
+			"skill_roots":   configengine.CategoryNone,
+		},
+	}
+}
+
+// LoadConfig resolves codex.yaml from the layer stack under dirs.
+// An absent file in every layer resolves the template; a layer file that exists but is invalid is an error.
+func LoadConfig(dirs configengine.Dirs) (Config, error) {
+	resolved, err := configengine.LoadOrTemplate(dirs, ConfigSpec())
+	if err != nil {
+		return Config{}, err
+	}
+	var cfg Config
+	if err := yaml.Unmarshal(resolved, &cfg); err != nil {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("unmarshal codex config: %w", err))
+	}
+	return cfg, nil
+}
+
+// loadConfigOrRefuse loads codex.yaml from dirs.
+// A load error keeps configengine's text naming the file and key and its invalid mark, and gains the way forward.
+func loadConfigOrRefuse(dirs configengine.Dirs) (Config, error) {
+	codex, err := LoadConfig(dirs)
+	if err != nil {
+		return Config{}, fmt.Errorf("codexengine: %w; way forward: correct or remove the key in the file the error names, with lym config codex --layer <default|worktree|local> (or --set for a value)", err)
+	}
+	return codex, nil
+}
+
+// codexBinary returns codex.Binary if set, otherwise "codex".
+func codexBinary(codex Config) string {
+	if codex.Binary != "" {
+		return codex.Binary
+	}
+	return "codex"
+}
+
+// homeDirs is the pair of Codex homes a launch uses, both absolute.
+type homeDirs struct {
+	// lym is the shared lym Codex home the launch runs under.
+	lym string
+	// operator is the operator's own Codex home the lym home links into.
+	operator string
+}
+
+// resolveHomes resolves codex.yaml's home and operator_home keys into absolute paths, refusing an empty or relative value by its key.
+func resolveHomes(codex Config) (homeDirs, error) {
+	lym, err := expandHomePath("home", codex.Home)
+	if err != nil {
+		return homeDirs{}, err
+	}
+	operator, err := expandHomePath("operator_home", codex.OperatorHome)
+	if err != nil {
+		return homeDirs{}, err
+	}
+	return homeDirs{lym: lym, operator: operator}, nil
+}
+
+// expandHomePath returns value with a leading "~/" replaced by the user's home directory, refusing a value that is then empty or relative.
+// key names the codex.yaml entry the value came from, so the refusal points at what to fix.
+func expandHomePath(key, value string) (string, error) {
+	if rest, ok := strings.CutPrefix(value, "~/"); ok {
+		userHome, err := os.UserHomeDir()
+		if err != nil {
+			return "", fmt.Errorf("codexengine: resolve codex.yaml's %s %q: %w", key, value, err)
+		}
+		value = filepath.Join(userHome, rest)
+	}
+	if value == "" || !filepath.IsAbs(value) {
+		return "", fmt.Errorf("codexengine: codex.yaml's %s %q is not an absolute path or one under ~/; way forward: set it with lym config codex", key, value)
+	}
+	return filepath.Clean(value), nil
+}
+
+// validateEffort refuses a non-empty effort that codex.yaml's efforts does not list, naming the key.
+func validateEffort(effort string, codex Config) error {
+	if effort == "" || slices.Contains(codex.Efforts, effort) {
+		return nil
+	}
+	return fmt.Errorf("codexengine: effort %q is not in codex.yaml's efforts %v; way forward: name one of them in the model-spec, or add it to efforts with lym config codex", effort, codex.Efforts)
+}
diff --git a/internal/shuttleengine/codexengine/doc.go b/internal/shuttleengine/codexengine/doc.go
new file mode 100644
index 00000000..92fd6ec1
--- /dev/null
+++ b/internal/shuttleengine/codexengine/doc.go
@@ -0,0 +1,26 @@
+// Package codexengine implements shuttleengine.Engine for the Codex CLI, driving its interactive TUI in a reed pane.
+// Only internal/shuttleengines constructs it; it registers there as codex, with its config module codex.yaml.
+//
+// Every launch runs under one shared lym Codex home, codex.yaml's home, set as CODEX_HOME on the launch line; the operator's own Codex home is never written.
+// The lym home links auth.json and sessions to the operator home's, so one login and its token refresh serve both and rollouts land where the operator's tools read them.
+// lym keeps the home's trusted roots in a record of its own and renders config.toml whole from it on every launch, under a file lock: Codex keys folder trust on a git root, and a `-c` flag cannot set it.
+// Prepare trusts the worktree root and a linked worktree's main checkout root, read from the `.git` entries, and drops recorded roots whose folder is gone, so no teardown step is needed.
+// A login made in the lym home leaves a regular auth.json, which Prepare names in a Warn rather than replaces.
+// After startup the engine reads config.toml back and warns about a root Codex's own write dropped; the trust prompt's accept is the backstop.
+//
+// The launch line runs `-a never -s workspace-write`, so no approval prompt shows, and adds the records checkout it is told through its Dirs as a writable root, symlink-resolved as the trusted roots are and kept as told, with a Warn, when it cannot be resolved,
+// so the session writes under the anchor's `.lym` as a Claude seat does; outside a hub it is told none and adds none.
+// A committed `.codex/rules` folder refuses the launch, since an allow rule there lifts the sandbox; a committed `.codex/config.toml` is named in a Warn, since its hooks run unreviewed.
+// The first turn is the positional prompt pointer, and the pane's shell exits after Codex, so a Codex exit reads as a dead pane;
+// the resume line starts no Codex, since Codex mints its session id at the first turn.
+//
+// Hooks given by `-c` append a stamp line and the payload of SessionStart, UserPromptSubmit, Stop and PermissionRequest to the run's events file, and PostToolUse touches the activity stamp.
+// A Stop is the turn end and carries the reply; an interrupt fires no Stop, so a newest turn_aborted in the rollout the payloads name marks the turn interrupted.
+// The rollout's newest token_count gives the context size.
+// Codex keeps no session registry, so liveness reads unproven.
+//
+// The pane readings follow the spike's table: the `›` composer, the `Working (… esc to interrupt)` busy line and the folder-trust prompt, whose accept presses nothing unless the option sits by the caret.
+// A send pastes the text and leaves the Enter to shuttle's guarded send, since Codex drops an Enter typed inside a burst of characters.
+//
+// The engine has no skill loading, no shell guard, no fork audit, no transcript reading and no creel hooks, and refuses a spec that needs the publish guard.
+package codexengine
diff --git a/internal/shuttleengine/codexengine/events.go b/internal/shuttleengine/codexengine/events.go
new file mode 100644
index 00000000..e0cae0e4
--- /dev/null
+++ b/internal/shuttleengine/codexengine/events.go
@@ -0,0 +1,160 @@
+// events.go reads a run's events file, where the launch's hooks append a stamp line and a payload line per hook event.
+// ParseEvents yields the turn ends the run loop classifies outcomes from, and ParseSessionSignals the session signals a session state folds.
+// All Codex payload-shape knowledge the events file needs lives in this file, per PATTERN-shuttle-provider-seam.
+
+package codexengine
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+var _ shuttleengine.SessionSignalParser = (*Codex)(nil)
+
+// ParseEvents parses the events file into Events: each Stop payload becomes an EventStop carrying its last_assistant_message.
+// Codex fires no Stop for an interrupted turn, so an interrupt yields no event.
+// It is lenient: stamp lines, malformed lines and other hooks yield nothing, since the file may still be growing.
+func (c *Codex) ParseEvents(data []byte) ([]shuttleengine.Event, error) {
+	var events []shuttleengine.Event
+	for _, line := range strings.Split(string(data), "\n") {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+		var payload struct {
+			HookEventName        string `json:"hook_event_name"`
+			LastAssistantMessage string `json:"last_assistant_message"`
+		}
+		if err := json.Unmarshal([]byte(trimmed), &payload); err != nil || payload.HookEventName != hookEventStop {
+			continue
+		}
+		events = append(events, shuttleengine.Event{
+			Kind:    shuttleengine.EventStop,
+			Message: payload.LastAssistantMessage,
+			Raw:     []byte(line),
+		})
+	}
+	return events, nil
+}
+
+// pendingStamp is a stamp line not yet taken by a payload line.
+type pendingStamp struct {
+	hook string
+	at   time.Time
+}
+
+// ParseSessionSignals parses events file bytes into session signals, in file order.
+// SessionStart reads as a session start, UserPromptSubmit as a turn start, Stop as a turn end and PermissionRequest as an ask.
+// A payload line takes its time from the nearest preceding untaken stamp naming its hook, and reads a zero time when there is none or the stamp's time is empty or malformed.
+// consumed ends at the last newline-terminated line, except that it stops before the earliest line of the trailing run of stamp lines, which have no payload line after them yet.
+// It is lenient: malformed lines, stamp lines and unknown hooks yield no signal.
+func (c *Codex) ParseSessionSignals(data []byte) ([]shuttleengine.SessionSignal, int) {
+	var signals []shuttleengine.SessionSignal
+	var pending []pendingStamp
+	holdFrom := -1
+	offset := 0
+
+	for offset < len(data) {
+		newline := bytes.IndexByte(data[offset:], '\n')
+		if newline < 0 {
+			break
+		}
+		lineStart := offset
+		line := data[offset : offset+newline]
+		offset += newline + 1
+
+		trimmed := bytes.TrimSpace(line)
+		if len(trimmed) == 0 {
+			continue
+		}
+		var fields map[string]any
+		if err := json.Unmarshal(trimmed, &fields); err != nil {
+			holdFrom = -1
+			continue
+		}
+		if hook, ok := fields[stampHookKey].(string); ok {
+			pending = append(pending, pendingStamp{hook: hook, at: parseStampTime(fields)})
+			if holdFrom < 0 {
+				holdFrom = lineStart
+			}
+			continue
+		}
+		holdFrom = -1
+
+		hookName, ok := fields["hook_event_name"].(string)
+		if !ok {
+			continue
+		}
+		var at time.Time
+		for i := len(pending) - 1; i >= 0; i-- {
+			if pending[i].hook == hookName {
+				at = pending[i].at
+				pending = append(pending[:i], pending[i+1:]...)
+				break
+			}
+		}
+		if signal, ok := signalFromPayload(hookName, fields); ok {
+			signal.At = at
+			signal.SessionID, _ = fields["session_id"].(string)
+			signal.Raw = append([]byte(nil), line...)
+			signals = append(signals, signal)
+		}
+	}
+
+	if holdFrom >= 0 {
+		return signals, holdFrom
+	}
+	return signals, offset
+}
+
+// parseStampTime reads a stamp line's RFC 3339 time, or the zero time when it is empty or malformed.
+func parseStampTime(fields map[string]any) time.Time {
+	text, _ := fields[stampAtKey].(string)
+	at, err := time.Parse(time.RFC3339, text)
+	if err != nil {
+		return time.Time{}
+	}
+	return at.UTC()
+}
+
+// signalFromPayload reads the signal a payload line of the named hook carries, or false when the hook yields none.
+func signalFromPayload(hookName string, fields map[string]any) (shuttleengine.SessionSignal, bool) {
+	switch hookName {
+	case hookEventStop:
+		return shuttleengine.SessionSignal{Kind: shuttleengine.SessionSignalTurnEnd, Event: true}, true
+	case hookEventUserPromptSubmit:
+		prompt, _ := fields["prompt"].(string)
+		return shuttleengine.SessionSignal{Kind: shuttleengine.SessionSignalTurnStart, Instruction: typedInstruction(prompt)}, true
+	case hookEventPermissionRequest:
+		return shuttleengine.SessionSignal{Kind: shuttleengine.SessionSignalAsk}, true
+	case hookEventSessionStart:
+		source, _ := fields["source"].(string)
+		return shuttleengine.SessionSignal{Kind: shuttleengine.SessionSignalSessionStart, Source: sessionStartSource(source)}, true
+	}
+	return shuttleengine.SessionSignal{}, false
+}
+
+// typedInstruction returns a UserPromptSubmit prompt as a typed instruction, or "" for a slash command, which is a command to Codex's own interface.
+// A prompt is a slash command when its first word starts with "/" and holds no further "/", so one that opens with a multi-segment path is an instruction.
+func typedInstruction(prompt string) string {
+	trimmed := strings.TrimSpace(prompt)
+	if words := strings.Fields(trimmed); len(words) > 0 && strings.HasPrefix(words[0], "/") && !strings.Contains(words[0][1:], "/") {
+		return ""
+	}
+	return trimmed
+}
+
+// sessionStartSource maps a SessionStart payload's source to the provider-neutral source: startup and resume map to their own, and any other source, a fork's included, to the empty source.
+func sessionStartSource(source string) shuttleengine.SessionStartSource {
+	switch source {
+	case "startup":
+		return shuttleengine.SessionStartStartup
+	case "resume":
+		return shuttleengine.SessionStartResume
+	}
+	return ""
+}
diff --git a/internal/shuttleengine/codexengine/events_test.go b/internal/shuttleengine/codexengine/events_test.go
new file mode 100644
index 00000000..5b4116b7
--- /dev/null
+++ b/internal/shuttleengine/codexengine/events_test.go
@@ -0,0 +1,88 @@
+// events_test.go parses events files built from the spike's recorded hook payloads into events and session signals.
+
+package codexengine
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// Hook payloads as the spike recorded them (docs/research/codex-spike-2026-10-24/report.md, Hook payloads), with the transcript path made absolute.
+const (
+	sessionStartPayload      = `{"session_id":"01a16d56","transcript_path":"/s/rollout.jsonl","cwd":"/w","hook_event_name":"SessionStart","model":"gpt-6-luna","permission_mode":"bypassPermissions","source":"startup"}`
+	userPromptSubmitPayload  = `{"session_id":"01a16d56","turn_id":"t1","transcript_path":"/s/rollout.jsonl","cwd":"/w","hook_event_name":"UserPromptSubmit","model":"gpt-6-luna","permission_mode":"bypassPermissions","prompt":"Reply with the single word ok."}`
+	stopPayload              = `{"session_id":"01a16d56","turn_id":"t1","transcript_path":"/s/rollout.jsonl","cwd":"/w","hook_event_name":"Stop","model":"gpt-6-luna","permission_mode":"bypassPermissions","stop_hook_active":false,"last_assistant_message":"ok"}`
+	permissionRequestPayload = `{"session_id":"01a16d5d","turn_id":"t2","transcript_path":"/s/rollout.jsonl","cwd":"/w","hook_event_name":"PermissionRequest","model":"gpt-6-luna","permission_mode":"default","tool_name":"Bash","tool_input":{"command":"touch /x"}}`
+	preToolUsePayload        = `{"session_id":"01a16d5e","turn_id":"t3","transcript_path":"/s/rollout.jsonl","cwd":"/w","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"echo hi"}}`
+)
+
+// stampLine returns the stamp line a recording hook writes before the payload of hook at at.
+func stampLine(hook, at string) string {
+	return `{"` + stampHookKey + `":"` + hook + `","` + stampAtKey + `":"` + at + `"}`
+}
+
+// TestParseEvents pins that each Stop payload becomes a turn end carrying its message and that stamp lines, other hooks and malformed lines yield nothing.
+func TestParseEvents(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	data := stampLine(hookEventStop, "2026-10-24T11:55:31Z") + "\n" + sessionStartPayload + "\n" + "not json\n" + preToolUsePayload + "\n" + stopPayload + "\n"
+	got, err := New().ParseEvents([]byte(data))
+	if err != nil {
+		t.Fatalf("ParseEvents() error: %v", err)
+	}
+	want := []shuttleengine.Event{{Kind: shuttleengine.EventStop, Message: "ok", Raw: []byte(stopPayload)}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ParseEvents() = %+v; want %+v", got, want)
+	}
+}
+
+// TestParseSessionSignals pins the four hooks' signals with each payload's stamp time and session id.
+// It also pins a slash command read as no instruction and a fork's source read as none.
+// It pins consumed stopping before a trailing stamp with no payload yet.
+func TestParseSessionSignals(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	at := func(text string) time.Time {
+		parsed, err := time.Parse(time.RFC3339, text)
+		if err != nil {
+			t.Fatalf("parse %s: %v", text, err)
+		}
+		return parsed
+	}
+	slashPrompt := `{"session_id":"s","hook_event_name":"UserPromptSubmit","prompt":"/status"}`
+	forkStart := `{"session_id":"s","hook_event_name":"SessionStart","source":"fork"}`
+	lines := []string{
+		stampLine(hookEventSessionStart, "2026-10-24T11:55:30Z"), sessionStartPayload,
+		stampLine(hookEventUserPromptSubmit, "2026-10-24T11:55:30Z"), userPromptSubmitPayload,
+		stampLine(hookEventStop, "2026-10-24T11:55:31Z"), stopPayload,
+		stampLine(hookEventPermissionRequest, ""), permissionRequestPayload,
+		preToolUsePayload, slashPrompt, forkStart,
+	}
+	complete := ""
+	for _, line := range lines {
+		complete += line + "\n"
+	}
+	trailing := stampLine(hookEventStop, "2026-10-24T11:56:00Z") + "\n"
+
+	got, consumed := New().ParseSessionSignals([]byte(complete + trailing))
+	if consumed != len(complete) {
+		t.Errorf("consumed = %d; want %d, before the trailing stamp", consumed, len(complete))
+	}
+	want := []shuttleengine.SessionSignal{
+		{Kind: shuttleengine.SessionSignalSessionStart, Source: shuttleengine.SessionStartStartup, At: at("2026-10-24T11:55:30Z"), SessionID: "01a16d56", Raw: []byte(sessionStartPayload)},
+		{Kind: shuttleengine.SessionSignalTurnStart, Instruction: "Reply with the single word ok.", At: at("2026-10-24T11:55:30Z"), SessionID: "01a16d56", Raw: []byte(userPromptSubmitPayload)},
+		{Kind: shuttleengine.SessionSignalTurnEnd, Event: true, At: at("2026-10-24T11:55:31Z"), SessionID: "01a16d56", Raw: []byte(stopPayload)},
+		{Kind: shuttleengine.SessionSignalAsk, SessionID: "01a16d5d", Raw: []byte(permissionRequestPayload)},
+		{Kind: shuttleengine.SessionSignalTurnStart, SessionID: "s", Raw: []byte(slashPrompt)},
+		{Kind: shuttleengine.SessionSignalSessionStart, SessionID: "s", Raw: []byte(forkStart)},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ParseSessionSignals() =\n%+v\nwant\n%+v", got, want)
+	}
+}
diff --git a/internal/shuttleengine/codexengine/fixture_test.go b/internal/shuttleengine/codexengine/fixture_test.go
new file mode 100644
index 00000000..c6dc3da4
--- /dev/null
+++ b/internal/shuttleengine/codexengine/fixture_test.go
@@ -0,0 +1,125 @@
+// fixture_test.go builds the on-disk fixtures the engine's tests run against: a fake repository with linked worktrees and plain clones, a records checkout beside each worktree, an operator Codex home, and the codex.yaml local layer that points the engine at them.
+// No git process runs: the `.git` entries are written as git writes them.
+
+package codexengine
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// repoFixture is a fake repository's main checkout and the two Codex homes, all under one resolved temp dir.
+type repoFixture struct {
+	base         string
+	mainRoot     string
+	lymHome      string
+	operatorHome string
+}
+
+// newRepoFixture writes a main checkout with a `.git` directory, and an operator home holding auth.json and sessions; the lym home is left unmade.
+func newRepoFixture(t *testing.T) repoFixture {
+	t.Helper()
+	base, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatalf("resolve temp dir: %v", err)
+	}
+	repo := repoFixture{
+		base:         base,
+		mainRoot:     filepath.Join(base, "main"),
+		lymHome:      filepath.Join(base, "lym-home"),
+		operatorHome: filepath.Join(base, "operator-home"),
+	}
+	gitDir := filepath.Join(repo.mainRoot, ".git")
+	mkdirAll(t, filepath.Join(gitDir, "objects"), filepath.Join(gitDir, "refs"), filepath.Join(repo.operatorHome, sessionsDirName))
+	writeFile(t, filepath.Join(gitDir, "HEAD"), "ref: refs/heads/main\n")
+	writeFile(t, filepath.Join(repo.operatorHome, authFileName), "{}")
+	return repo
+}
+
+// addWorktree writes a linked worktree named name with a records checkout beside it.
+// It also writes a codex.yaml local layer pointing at the fixture's homes, and returns the worktree's root and the records checkout.
+func (r repoFixture) addWorktree(t *testing.T, name string) (anchor, records string) {
+	t.Helper()
+	anchor = filepath.Join(r.base, name)
+	records = filepath.Join(r.base, name+"-records")
+	gitDir := filepath.Join(r.mainRoot, ".git", "worktrees", name)
+	mkdirAll(t, gitDir, anchor, records)
+	writeFile(t, filepath.Join(gitDir, "HEAD"), "ref: refs/heads/"+name+"\n")
+	writeFile(t, filepath.Join(gitDir, "commondir"), "../..\n")
+	writeFile(t, filepath.Join(anchor, ".git"), "gitdir: "+gitDir+"\n")
+	r.writeCodexLayer(t, anchor, "")
+	return anchor, records
+}
+
+// addClone writes a plain clone named name, whose `.git` is a directory of its own and which has no main checkout,
+// and a codex.yaml local layer pointing at the fixture's homes, and returns the clone's root.
+func (r repoFixture) addClone(t *testing.T, name string) string {
+	t.Helper()
+	anchor := filepath.Join(r.base, name)
+	gitDir := filepath.Join(anchor, ".git")
+	mkdirAll(t, filepath.Join(gitDir, "objects"), filepath.Join(gitDir, "refs"))
+	writeFile(t, filepath.Join(gitDir, "HEAD"), "ref: refs/heads/main\n")
+	r.writeCodexLayer(t, anchor, "")
+	return anchor
+}
+
+// writeCodexLayer writes anchor's codex.yaml local layer: the fixture's homes, then extra.
+func (r repoFixture) writeCodexLayer(t *testing.T, anchor, extra string) {
+	t.Helper()
+	path := configengine.LocalFile(anchor, "codex")
+	mkdirAll(t, filepath.Dir(path))
+	writeFile(t, path, fmt.Sprintf("home: %s\noperator_home: %s\n%s", r.lymHome, r.operatorHome, extra))
+}
+
+// warnLog collects the warnings of one engine.
+type warnLog struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+// warn records msg and its arguments as one line.
+func (w *warnLog) warn(msg string, args ...any) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.lines = append(w.lines, strings.TrimSpace(fmt.Sprintln(append([]any{msg}, args...)...)))
+}
+
+// String returns every warning, one per line.
+func (w *warnLog) String() string {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return strings.Join(w.lines, "\n")
+}
+
+// newEngine returns an engine anchored at anchor whose warnings the returned log collects.
+func newEngine(anchor string) (*Codex, *warnLog) {
+	log := &warnLog{}
+	engine := NewFromConfig(shuttleengine.Config{SubmitRedrawSettleMS: defaultSubmitRedrawSettleMS}, configengine.Dirs{Anchor: anchor})
+	engine.warn = log.warn
+	return engine, log
+}
+
+// mkdirAll creates every directory of dirs.
+func mkdirAll(t *testing.T, dirs ...string) {
+	t.Helper()
+	for _, dir := range dirs {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatalf("mkdir %s: %v", dir, err)
+		}
+	}
+}
+
+// writeFile writes content to path.
+func writeFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatalf("write %s: %v", path, err)
+	}
+}
diff --git a/internal/shuttleengine/codexengine/home.go b/internal/shuttleengine/codexengine/home.go
new file mode 100644
index 00000000..4990a037
--- /dev/null
+++ b/internal/shuttleengine/codexengine/home.go
@@ -0,0 +1,234 @@
+// home.go prepares the shared lym Codex home a launch runs under and reads the checkout the launch starts in.
+// The home holds links to the operator home's login and sessions, lym's record of the roots it trusts, and the config.toml rendered whole from that record.
+// The checkout gives the roots Codex keys folder trust on and the committed `.codex` folders a launch warns about or refuses.
+
+package codexengine
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/dotgit"
+	"github.com/Knatte18/loomyard/internal/fslink"
+	"github.com/Knatte18/loomyard/internal/fsx"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// Names of the entries in a Codex home and a repository's Codex folder.
+const (
+	authFileName        = "auth.json"
+	sessionsDirName     = "sessions"
+	configFileName      = "config.toml"
+	trustRecordFileName = "lym-trust.json"
+	homeLockFileName    = "lym-home.lock"
+	codexFolderName     = ".codex"
+	rulesDirName        = "rules"
+)
+
+// trustRecord is lym's record of the roots its Codex home trusts, from which config.toml is rendered.
+type trustRecord struct {
+	// Roots are the absolute, symlink-resolved folders the home trusts, sorted.
+	Roots []string `json:"roots"`
+}
+
+// checkout is the git checkout a launch starts in.
+type checkout struct {
+	// root is the worktree root, symlinks resolved as Codex resolves them.
+	root string
+	// mainRoot is the repository's main checkout root for a linked worktree, symlinks resolved; empty for a plain clone.
+	mainRoot string
+}
+
+// trustRoots returns the roots Codex keys folder trust on for a session in c: the worktree root, then the main checkout root of a linked worktree.
+func (c checkout) trustRoots() []string {
+	if c.mainRoot == "" {
+		return []string{c.root}
+	}
+	return []string{c.root, c.mainRoot}
+}
+
+// readCheckout reads the checkout the directory anchor sits in from its `.git` entries, without running git.
+// A linked worktree's main checkout root is the directory holding its common git dir.
+func readCheckout(anchor string) (checkout, error) {
+	root, geometry, err := dotgit.FindRoot(anchor)
+	if err != nil {
+		return checkout{}, fmt.Errorf("codexengine: Codex keys folder trust on a git repository root, and %s is in none: %w", anchor, err)
+	}
+	resolvedRoot, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return checkout{}, fmt.Errorf("codexengine: resolve the worktree root %s: %w", root, err)
+	}
+	found := checkout{root: resolvedRoot}
+	if geometry.GitDir != geometry.CommonDir && filepath.Base(geometry.CommonDir) == ".git" {
+		mainRoot, err := filepath.EvalSymlinks(filepath.Dir(geometry.CommonDir))
+		if err != nil {
+			return checkout{}, fmt.Errorf("codexengine: resolve the main checkout root of %s: %w", root, err)
+		}
+		if mainRoot != resolvedRoot {
+			found.mainRoot = mainRoot
+		}
+	}
+	return found, nil
+}
+
+// checkCodexFolders warns about the committed Codex settings a launch in found and anchor runs, and refuses a launch under committed Codex rules.
+// A `.codex/config.toml` in the worktree is named in a Warn.
+// For a linked worktree whose root holds a `.codex` folder, the main checkout's `.codex/config.toml` is named too, since Codex then takes its hooks from that file.
+// A `.codex/rules` directory in the worktree root or the anchor refuses the launch, since an allow rule there lifts the sandbox for its command, and the refusal is also logged.
+func (c *Codex) checkCodexFolders(found checkout, anchor string) error {
+	folders := []string{filepath.Join(found.root, codexFolderName)}
+	if resolvedAnchor, err := filepath.EvalSymlinks(anchor); err == nil && resolvedAnchor != found.root {
+		folders = append(folders, filepath.Join(resolvedAnchor, codexFolderName))
+	}
+	for _, folder := range folders {
+		if rules := filepath.Join(folder, rulesDirName); isDir(rules) {
+			refusal := fmt.Errorf("codexengine: %s holds committed Codex rules, and an allow rule there lifts the sandbox for its command; way forward: remove the directory from the repository, or clear the round's assist model key so later rounds run no Codex seat", rules)
+			c.warn("codexengine: refused a Codex launch under committed Codex rules", "path", rules)
+			return refusal
+		}
+		if config := filepath.Join(folder, configFileName); isFile(config) {
+			c.warn("codexengine: the worktree commits a Codex config, whose hooks and settings the session runs without review", "path", config)
+		}
+	}
+	if found.mainRoot != "" && isDir(filepath.Join(found.root, codexFolderName)) {
+		if config := filepath.Join(found.mainRoot, codexFolderName, configFileName); isFile(config) {
+			c.warn("codexengine: the main checkout holds a Codex config, whose hooks Codex runs in place of the linked worktree's", "path", config)
+		}
+	}
+	return nil
+}
+
+// prepareHome readies the lym Codex home for a launch that trusts roots.
+// It first links the home's auth.json and sessions to the operator home's, so a platform that cannot link a file refuses before anything is written.
+// Then, under the home's file lock, it adds roots to the trust record, drops recorded roots whose folder no longer exists, and renders config.toml from the result before the record is written.
+func (c *Codex) prepareHome(homes homeDirs, roots []string) error {
+	if err := c.ensureLink(filepath.Join(homes.lym, authFileName), filepath.Join(homes.operator, authFileName), fslink.CreateFileLink); err != nil {
+		return err
+	}
+	if err := c.ensureLink(filepath.Join(homes.lym, sessionsDirName), filepath.Join(homes.operator, sessionsDirName), fslink.CreateDirLink); err != nil {
+		return err
+	}
+	recordPath := filepath.Join(homes.lym, trustRecordFileName)
+	err := state.UpdateJSON(recordPath, filepath.Join(homes.lym, homeLockFileName), func(current trustRecord, _ bool) (trustRecord, error) {
+		next := trustRecord{Roots: mergeRoots(current.Roots, roots)}
+		if err := fsx.AtomicWriteBytes(filepath.Join(homes.lym, configFileName), []byte(renderConfigTOML(next.Roots))); err != nil {
+			return trustRecord{}, fmt.Errorf("write %s: %w", configFileName, err)
+		}
+		return next, nil
+	})
+	if err != nil {
+		return fmt.Errorf("codexengine: prepare the lym Codex home %s: %w", homes.lym, err)
+	}
+	return nil
+}
+
+// ensureLink makes link a link to target with create when nothing sits at link.
+// A link that already points at target is kept.
+// A regular file, or a link elsewhere, is kept and named in a Warn with the way forward, since it may hold a login made in the lym home.
+// A create that fails because a concurrent launch made the same link meanwhile counts as made.
+func (c *Codex) ensureLink(link, target string, create func(link, target string) error) error {
+	info, err := os.Lstat(link)
+	switch {
+	case err == nil:
+		if info.Mode()&os.ModeSymlink != 0 {
+			if raw, rawErr := fslink.RawTarget(link); rawErr == nil && raw == target {
+				return nil
+			}
+		}
+		c.warn("codexengine: the lym Codex home's entry is not a link to the operator home's; way forward: remove it, and the next Codex launch links it again", "path", link, "want", target)
+		return nil
+	case !errors.Is(err, os.ErrNotExist):
+		return fmt.Errorf("codexengine: read %s: %w", link, err)
+	}
+	if err := create(link, target); err != nil {
+		if raw, rawErr := fslink.RawTarget(link); rawErr == nil && raw == target {
+			return nil
+		}
+		return fmt.Errorf("codexengine: link %s to %s: %w", link, target, err)
+	}
+	return nil
+}
+
+// mergeRoots returns the union of recorded and added, sorted, without the recorded roots whose folder no longer exists.
+func mergeRoots(recorded, added []string) []string {
+	var merged []string
+	for _, root := range recorded {
+		if isDir(root) && !slices.Contains(merged, root) {
+			merged = append(merged, root)
+		}
+	}
+	for _, root := range added {
+		if !slices.Contains(merged, root) {
+			merged = append(merged, root)
+		}
+	}
+	slices.Sort(merged)
+	return merged
+}
+
+// configHeader opens the rendered config.toml, telling a reader whose file it is.
+const configHeader = "# Rendered by lym from " + trustRecordFileName + " at every Codex launch; an edit here is lost at the next launch.\n" +
+	"# Put your own Codex settings in the operator home's config.toml.\n"
+
+// renderConfigTOML renders the lym home's config.toml: the `[tui]` settings Codex otherwise writes on its first start, then one trusted project table per root.
+func renderConfigTOML(roots []string) string {
+	var b strings.Builder
+	b.WriteString(configHeader)
+	b.WriteString("\n[tui]\nscreen_reader_detection_done = true\n\n[tui.model_availability_nux]\n")
+	for _, root := range roots {
+		b.WriteString("\n" + projectTableHeader(root) + "\ntrust_level = \"trusted\"\n")
+	}
+	return b.String()
+}
+
+// projectTableHeader returns the config.toml table header of root's project settings.
+func projectTableHeader(root string) string {
+	return "[projects." + tomlString(root) + "]"
+}
+
+// CheckAfterStartup reads the lym home's config.toml back once a launch is past its startup gates and logs at Warn each trust root it no longer holds, since Codex writes the file itself and ignores lym's lock.
+// It checks the roots of the checkout this engine's anchor sits in, and reads at Warn whatever stops it from checking.
+func (c *Codex) CheckAfterStartup() {
+	codex, err := loadConfigOrRefuse(c.dirs)
+	if err != nil {
+		c.warn("codexengine: could not check the lym Codex home's trust roots after startup", "error", err)
+		return
+	}
+	homes, err := resolveHomes(codex)
+	if err != nil {
+		c.warn("codexengine: could not check the lym Codex home's trust roots after startup", "error", err)
+		return
+	}
+	found, err := readCheckout(c.dirs.Anchor)
+	if err != nil {
+		c.warn("codexengine: could not check the lym Codex home's trust roots after startup", "error", err)
+		return
+	}
+	configPath := filepath.Join(homes.lym, configFileName)
+	content, err := os.ReadFile(configPath)
+	if err != nil {
+		c.warn("codexengine: could not read the lym Codex home's config after startup", "path", configPath, "error", err)
+		return
+	}
+	for _, root := range found.trustRoots() {
+		if !strings.Contains(string(content), projectTableHeader(root)) {
+			c.warn("codexengine: the lym Codex home's config lost a trusted root after startup, so a later launch there shows Codex's trust prompt, which the startup classifier accepts", "path", configPath, "root", root)
+		}
+	}
+}
+
+// isDir reports whether path is a directory, following links.
+func isDir(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && info.IsDir()
+}
+
+// isFile reports whether path is a regular file, following links.
+func isFile(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && info.Mode().IsRegular()
+}
