index 00000000..6772c31e
--- /dev/null
+++ b/docs/research/loom/darn-cost-2026-11-08/README.md
@@ -0,0 +1,33 @@
+# Darn cost measure
+
+The scripts and tables behind [report.md](report.md): the cost of darn runs by phase, and a darn family against tapestry runs,
+read from the runs that landed since 2026-10-25.
+The tables record one run on one machine and are not claiming to stay true.
+
+## Rerunning
+
+Run each script from any working directory; the repo root is found from the script's location.
+Environment:
+
+- `WEFT` names the records repo clone (default `<repo root>/../loomyard-weft`).
+- `CODE` names the code repo clone (default `<repo root>/../loomyard`).
+- `SINCE` (`collect.sh`) names the first UTC date (default 2026-10-25).
+- `MAXLINES`, `EXCLUDE`, `EXCLUDE_DARN` and `EXCLUDE_TAPESTRY` (`tables.sh`, `family.sh`, `sonnet-writer.sh`)
+  are named in each script's header.
+
+The scripts need `bash`, `git`, `jq` and `awk`.
+Everything is read-only apart from the tables.
+
+## Order and inputs
+
+1. `go run ./tools/tokencount -since 2026-10-25 -out <file>` writes the transcript report,
+   and `parse-tokencount.sh <file>` splits it into `parts.tsv` and `producers.tsv`.
+2. `lym report timing --since 2026-10-25 --format json`, run from the hub's prime worktree and saved to a file,
+   feeds `run-table.sh <file>`, which writes `run-table.tsv`.
+3. `collect.sh` writes `runs.tsv` and `sessions.tsv` from the usage records at the archive tags.
+4. `cost-table.sh` joins them into `cost-table.tsv`, one row per run.
+5. `tables.sh`, `family.sh` and `sonnet-writer.sh` print the report's tables from `cost-table.tsv`, `family-slugs.txt`,
+   `family-pre.tsv` and `sessions.tsv`.
+
+`family-slugs.txt` lists the parts of the `fabric-test-speed` raddle proposal.
+`family-pre.tsv` holds the Motif and raddle runs of that slug, read by `tokencount -no-cutoff fabric-test-speed`.
diff --git a/docs/research/loom/darn-cost-2026-11-08/collect.sh b/docs/research/loom/darn-cost-2026-11-08/collect.sh
new file mode 100755
index 00000000..421c86ea
--- /dev/null
+++ b/docs/research/loom/darn-cost-2026-11-08/collect.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# Usage: collect.sh [out-dir]
+# Reads the usage records of every run archived in the records repo since SINCE and writes two tables to <out-dir>:
+#   runs.tsv:     tag, slug, landed (UTC date of the tag), recipe, profile, stored_record, lines_added, lines_deleted,
+#                 first_start, last_end (the earliest session start and latest session end, UTC)
+#   sessions.tsv: tag, slug, row, role, model, engine, cost_usd, input, cache_write, cache_read, output, started, ended
+# A tag without _lym/usage/run.json is left out; a tag without landed.json has empty line columns.
+# Environment: WEFT names the records repo clone (default <repo root>/../loomyard-weft), SINCE the first UTC date
+# (default 2026-10-25).
+# Needs bash, git and jq; reads only, apart from the two tables.
+set -euo pipefail
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+root=$(git -C "$here" rev-parse --show-toplevel)
+out=${1:-$here}
+weft=${WEFT:-$root/../loomyard-weft}
+since=${SINCE:-2026-10-25}
+mkdir -p "$out"
+
+printf 'tag\tslug\tlanded\trecipe\tprofile\tstored_record\tlines_added\tlines_deleted\tfirst_start\tlast_end\n' > "$out/runs.tsv"
+printf 'tag\tslug\trow\trole\tmodel\tengine\tcost_usd\tinput\tcache_write\tcache_read\toutput\tstarted\tended\n' > "$out/sessions.tsv"
+
+git -C "$weft" tag -l 'archive/*' --sort=creatordate --format='%(creatordate:short) %(refname:short)' |
+  awk -v since="$since" '$1 >= since { print $2 }' |
+  while read -r tag; do
+    slug=${tag#archive/}
+    slug=${slug%/*}
+    files=$(git -C "$weft" ls-tree -r --name-only "$tag" -- _lym/usage 2> /dev/null || true)
+    echo "$files" | grep -q '^_lym/usage/run.json$' || continue
+    landed=$(git -C "$weft" log -1 --format=%cI "$tag" | cut -c1-10)
+    run=$(git -C "$weft" show "$tag:_lym/usage/run.json")
+    lines='{}'
+    if echo "$files" | grep -q '^_lym/usage/landed.json$'; then
+      lines=$(git -C "$weft" show "$tag:_lym/usage/landed.json")
+    fi
+    sessions=$(mktemp)
+    echo "$files" | grep '/session-' | while read -r f; do
+      git -C "$weft" show "$tag:$f"
+    done | jq -c --arg tag "$tag" --arg slug "$slug" '[$tag, $slug, .row, .role, .model, .engine, .cost_usd, .input_tokens, .cache_write_tokens, .cache_read_tokens, .output_tokens, .started, .ended]' > "$sessions"
+    jq -r '@tsv' "$sessions" >> "$out/sessions.tsv"
+    first=$(jq -r '.[11]' "$sessions" | sort | head -1)
+    last=$(jq -r '.[12]' "$sessions" | sort | tail -1)
+    rm -f "$sessions"
+    jq -r --arg tag "$tag" --arg slug "$slug" --arg landed "$landed" --arg first "$first" --arg last "$last" --argjson lines "$lines" \
+      '[$tag, $slug, $landed, .recipe, .profile, (.stored_record | tostring), ($lines.lines_added // ""), ($lines.lines_deleted // ""), $first, $last] | @tsv' <<< "$run" >> "$out/runs.tsv"
+  done
diff --git a/docs/research/loom/darn-cost-2026-11-08/cost-table.sh b/docs/research/loom/darn-cost-2026-11-08/cost-table.sh
new file mode 100755
index 00000000..ec1496b9
--- /dev/null
+++ b/docs/research/loom/darn-cost-2026-11-08/cost-table.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+# Usage: cost-table.sh [out-dir]
+# Joins parts.tsv, producers.tsv and run-table.tsv into one row per run, in <out-dir>/cost-table.tsv.
+# Columns:
+#   slug, recipe, landed, profile, stored_record, lines (changed lines of the landing commit, empty if none),
+#   wall_min (the timing report's awake span: span less machine sleep),
+#   discussion, plan, webster (the segments' cost in USD),
+#   writer, writer_forks (the Darn segment's writer and the lookup subagents it forked),
+#   reviewers (Code-Review reviewer and its forks), bouncer (Code-Review judge and seed), fixers (Code-Review fixer and its forks),
+#   gate_fixer (Other, gate-fixer), landing (the Landing segment), other (the rest of the total), total,
+#   rounds (Code-Burler-Review entries), writer_min (Darn-Write active minutes).
+# The Orch segment holds no cost and is left out of the total.
+# Needs bash and awk; reads only, apart from the table.
+set -euo pipefail
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+out=${1:-$here}
+
+awk -F'\t' -v OFS='\t' '
+FILENAME ~ /run-table/ && FNR > 1 {
+  slug = $1; recipe[slug] = $3; landed[slug] = $4; profile[slug] = $5; stored[slug] = $6
+  wall[slug] = $11 / 60; lines[slug] = $14; seen[slug] = 1
+  next
+}
+FILENAME ~ /parts/ && FNR > 1 {
+  slug = $1; seg = $3; part = $4; usd = $5
+  if (part == "-") {
+    if (seg != "Orch") total[slug] += usd
+    if (seg == "Discussion") discussion[slug] = usd
+    if (seg == "Plan") plan[slug] = usd
+    if (seg == "Webster") webster[slug] = usd
+    if (seg == "Landing") landing[slug] = usd
+    next
+  }
+  if (seg == "Darn" && part == "writer") writer[slug] = usd
+  if (seg == "Darn" && part == "writer forks") wforks[slug] = usd
+  if (seg == "Code-Review" && (part == "reviewer" || part == "reviewer forks")) reviewers[slug] += usd
+  if (seg == "Code-Review" && (part == "judge" || part == "seed")) bouncer[slug] += usd
+  if (seg == "Code-Review" && (part == "fixer" || part == "fixer forks")) fixers[slug] += usd
+  if (seg == "Other" && part == "gate-fixer") gatefixer[slug] = usd
+  next
+}
+FILENAME ~ /producers/ && FNR > 1 {
+  if ($2 == "Code-Burler-Review") rounds[$1] = $3
+  if ($2 == "Darn-Write") writermin[$1] = $6 / 60
+  next
+}
+END {
+  print "slug", "recipe", "landed", "profile", "stored_record", "lines", "wall_min", "discussion", "plan", "webster", \
+    "writer", "writer_forks", "reviewers", "bouncer", "fixers", "gate_fixer", "landing", "other", "total", "rounds", "writer_min"
+  for (slug in seen) {
+    named = writer[slug] + wforks[slug] + reviewers[slug] + bouncer[slug] + fixers[slug] + gatefixer[slug] + landing[slug] + discussion[slug] + plan[slug] + webster[slug]
+    printf "%s\t%s\t%s\t%s\t%s\t%s\t%.1f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%d\t%.1f\n", \
+      slug, recipe[slug], landed[slug], profile[slug], stored[slug], lines[slug], wall[slug], discussion[slug], plan[slug], webster[slug], \
+      writer[slug], wforks[slug], reviewers[slug], bouncer[slug], fixers[slug], gatefixer[slug], landing[slug], total[slug] - named, total[slug], \
+      rounds[slug], writermin[slug]
+  }
+}
+' "$here/run-table.tsv" "$here/parts.tsv" "$here/producers.tsv" | sort -t$'\t' -k3,3 -k1,1 > "$out/cost-table.body"
+head -1 "$out/cost-table.body" > /dev/null
+{ grep '^slug' "$out/cost-table.body" || true; grep -v '^slug' "$out/cost-table.body"; } > "$out/cost-table.tsv"
+rm -f "$out/cost-table.body"
