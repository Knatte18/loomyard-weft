+		},
+		{name: "CarriedSeverityRaised", ctx: round(nil), prior: []PriorEntry{entry("E1", PriorOpen)}, findings: []Finding{carrying(finding("F1", SeverityBlocking, "a.go:10"), "E1")}, wantErr: "above its earlier"},
