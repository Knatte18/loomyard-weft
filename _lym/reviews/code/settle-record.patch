+			fmt.Sprintf("redundancy_budget_min: %d\ntiers:\n", budgetMin) +
+			"  tier0: {command: x, timeout_min: 1, counter: go-json, env: {LYM_TEST_TIER: \"0\"}}\n" +
+			"  tier2: {command: x, timeout_min: 1, counter: go-json, env: {LYM_TEST_TIER: \"2\"}}\n" + tier1
