--- /dev/null
+++ b/contracts/recipes/arras-recipe.yaml
@@ -0,0 +1,273 @@
+# arras-recipe.yaml is the tapestry recipe with its Discussion rows run as a block.
+# After Preflight the Motif block row runs the motif recipe inline, which produces the sketch, the decision record,
+# and the run goes on at Drift-Baseline with tapestry's rows from there to Friction-Reflect, copied verbatim.
+# internal/loomrecipe's TestBlockRecipes holds those rows equal to tapestry-recipe.yaml's.
+#
+# The top-level keys are tapestry's, bar profile_recipe: the run-profile block a task takes is tapestry's.
+# The routing, escalation and review-segment rules of the copied rows are the ones tapestry-recipe.yaml's header states.
+# The Discussion-Review segment's rows come from the block, so the segment keeps its budget as tapestry's does.
+
+version: 1
+entry: Preflight
+# The arbiter's prompt names this row once the plan is approved: a decision that amends the plan routes here.
+amendment_target: Plan-Burler-Review
+contract: loom
+verify_source: plan
+# The run-profile block a task takes is tapestry's.
+profile_recipe: tapestry
+terminals:
+  - Friction-Reflect
+
+producers:
+  - name: Preflight
+    engine: Preflight
+    on_done: Motif
+
+  # Motif runs the motif recipe inline; always means the block runs on every pass.
+  - name: Motif
+    block: motif
+    block_gate: always
+    on_done: Drift-Baseline
+
+  - name: Drift-Baseline
+    engine: DriftBaseline
+    entry_gate: drift.enabled
+    on_done: Parts-Write
+    config:
+      subject: decision-record
+
+  - name: Parts-Write
+    engine: PartsWrite
+    entry_gate: tapestry.plan_split
+    on_done: Parts-Plan-Write
+    config:
+      gates:
+        - name: parts
+          attempts: 3
+
+  - name: Parts-Plan-Write
+    engine: PartsPlanWrite
+    entry_gate: tapestry.plan_split
+    on_done: Plan-Write
+    config:
+      gates:
+        - name: plan
+          attempts: 3
+      part_gates:
+        - name: plan-part
+          attempts: 3
+
+  - name: Plan-Write
+    engine: PlanWrite
+    entry_gate: tapestry.plan_split != true
+    on_done: Plan-Bouncer
+    config:
+      gates:
+        - name: plan
+          attempts: 3
+          fixer: tapestry.plan_gate_fixer
+
+  - name: Plan-Bouncer
+    engine: Bouncer
+    segment: Plan-Review
+    on_stuck: Plan-Burler-Review
+    on_done: Drift-Await
+    config:
+      run_subdir: plan
+      subject: document
+      role_prefix: plan
+      reviewer_fan_setting: tapestry.plan_reviewer_fan
+      auto_accept_setting: tapestry.plan_auto_accept
+      artifact_paths:
+        - _lym/plan
+      rubric_stencil: loom-rubric-plan-review
+      commit_seam: plan
+      approve_seam: plan
+      skip_seam: rework-exempt
+      carry_over: Plan-Review
+
+  - name: Plan-Burler-Review
+    engine: BurlerReview
+    segment: Plan-Review
+    on_stuck: Plan-Burler-Fix
+    on_done: Plan-Burler-Fix
+    config:
+      run_subdir: plan
+      role_prefix: plan
+      reviewer_fan_setting: tapestry.plan_reviewer_fan
+      fixer_fan_setting: tapestry.plan_fixer_fan
+      profile:
+        target:
+          paths:
+            - _lym/plan
+        fasit:
+          paths:
+            - _lym/discussion/decision-record.md
+          instructions: >
+            The decision record named above is the answer key: the plan's job is to implement the
+            decisions and constraints it settles. In a rework generation the live generation's
+            findings.md joins it: every finding is covered by some card, and every card's scope is
+            licensed by the decision record or a finding. The live generation's round is, among
+            _lym/loom/rework/round-<N>/ directories, the highest N whose record.json carries a
+            class and whose first_card equals the first_card in _lym/plan/00-overview.md's
+            frontmatter (absent means 1). With no such round (generation 0, or a fresh Plan-Write
+            plan after an operator goto Plan-Write), the decision record alone is the answer key.
+            The round's prior-generation/ archive is context, never the subject of a finding. The
+            format authority is
+            contracts/specs/loom-plan-spec.md, and the mechanical checks over that format are
+            already enforced by this round's own gate over this round's own output, so re-deriving
+            them here is duplicated work. This round may never write the approved: key in the
+            plan's overview file: a fixer that set the flag would be approving the very artifact
+            the review round is judging, and this row already has write access to the overview
+            because it runs fix-scope: overlay with the plan directory in its target paths. When
+            .lym/webster/plan-conflict.md exists, Webster's begin-batch refused the approved plan
+            against the current tree: each blocking finding it lists is a finding of this round,
+            fixed by editing only cards Webster's auto-rebaseline accepts: a pending card, or a
+            card of a failed or in-flight batch. When _lym/loom/amendment.yaml exists, each
+            decision-record entry it names by title is a finding for each card that entry names
+            while the entry's change is uncarried for that card, or, when the entry names no
+            card, a finding until some card carries it. An entry's change is carried for a named
+            card when that card carries it, or, for a named card whose batch is done, when a card
+            inserted with lym loom insert-card after the last begun batch carries it. A decision
+            names each card by slug as well as number, because insert-card renumbers every later
+            card, so match cards by slug. Such a finding is fixed by editing only cards Webster's
+            auto-rebaseline accepts, a pending card or a card of a failed or in-flight batch, or
+            by inserting a card with lym loom insert-card after the last begun batch.
+        rubric_stencil: loom-rubric-plan-review
+        fix-scope: overlay
+        tool-use: true
+
+  - name: Plan-Burler-Fix
+    engine: BurlerFix
+    segment: Plan-Review
+    on_stuck: Plan-Bouncer
+    on_done: Plan-Bouncer
+    config:
+      run_subdir: plan
+      role_prefix: plan
+      fixer_fan_setting: tapestry.plan_fixer_fan
+      review_row: Plan-Burler-Review
+      gates:
+        - name: plan
+          attempts: 3
+      profile:
+        target:
+          paths:
+            - _lym/plan
+        fix-scope: overlay
+
+  - name: Drift-Await
+    engine: DriftAwait
+    entry_gate: drift.enabled
+    on_done: Webster
+
+  - name: Webster
+    engine: Implementer
+    on_done: Parent-Align
+    on_reroute: Plan-Burler-Review
+    config:
+      implementer_setting: tapestry.implementer
+
+  - name: Parent-Align
+    engine: ParentAlign
+    on_done: Drift-Verify
+
+  - name: Drift-Verify
+    engine: DriftVerify
+    entry_gate: drift.enabled
+    on_done: Code-Bouncer
+    config:
+      subject: decision-record
+      gate_key: drift-verify
+      gates:
+        - name: verify
+          attempts: 3
+
+  - name: Code-Bouncer
+    engine: Bouncer
+    segment: Code-Review
+    on_stuck: Code-Burler-Review
+    on_done: Describe
+    config:
+      run_subdir: code
+      subject: code
+      role_prefix: code
+      reviewer_fan_setting: loom.code_reviewer_fan
+      auto_accept_setting: loom.code_auto_accept
+      artifact_paths:
+        - _lym/discussion/decision-record.md
+        - _lym/plan
+      rubric_stencil: loom-rubric-code-review
+      carry_over: Code-Review
+
+  - name: Code-Burler-Review
+    engine: BurlerReview
+    segment: Code-Review
+    on_stuck: Code-Burler-Fix
+    on_done: Code-Burler-Fix
+    config:
+      run_subdir: code
+      role_prefix: code
+      reviewer_fan_setting: loom.code_reviewer_fan
+      fixer_fan_setting: loom.code_fixer_fan
+      profile:
+        target:
+          instructions: >
+            The subject under review is the committed diff. The rubric supplied in this prompt is
+            the single definition of the review range: read its "Determining the review range"
+            section and derive the range exactly as written there. This instruction deliberately
+            does not restate the derivation.
+        fasit:
+          paths:
+            - _lym/discussion/decision-record.md
+            - _lym/plan
+          instructions: >
+            The decision record and the plan directory named above are the answer key: the diff's
+            job is to make the change the decision record settles and to implement the cards the
+            plan carries, and the Card model those cards implement is described in
+            contracts/specs/loom-plan-spec.md. The mechanical checks over the plan's own format
+            are already enforced by Plan-Write's and Plan-Burler-Fix's own gates over each round's own
+            output, so re-deriving them in this round is duplicated work.
+        rubric_stencil: loom-rubric-code-review
+        fix-scope: source
+        tool-use: true
+        language-skills: true
+
+  - name: Code-Burler-Fix
+    engine: BurlerFix
+    segment: Code-Review
+    on_stuck: Code-Bouncer
+    on_done: Code-Bouncer
+    config:
+      run_subdir: code
+      role_prefix: code
+      fixer_fan_setting: loom.code_fixer_fan
+      review_row: Code-Burler-Review
+      gates:
+        - name: clean
+          attempts: 3
+        - name: verify
+          attempts: 3
+      profile:
+        fix-scope: source
+        language-skills: true
+
+  - name: Describe
+    engine: Describe
+    on_done: PR-Review
+    config:
+      gates:
+        - name: description
+          attempts: 3
+
+  - name: PR-Review
+    engine: PRReview
+    on_done: Finalize
+
+  - name: Finalize
+    engine: Finalize
+    on_done: Friction-Reflect
+
+  - name: Friction-Reflect
+    engine: FrictionReflect
+    on_done: ""
diff --git a/contracts/recipes/motif-recipe.yaml b/contracts/recipes/motif-recipe.yaml
