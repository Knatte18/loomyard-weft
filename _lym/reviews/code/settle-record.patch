+// batchingnudge_test.go pins the Codex batching nudge:
+// the breaches it fires from a rollout's exec cells, what holds it back, and the count it keeps per thread.
+
+package codexengine
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"testing"
