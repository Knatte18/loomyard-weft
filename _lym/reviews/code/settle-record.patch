+				if f.count("notify") != tt.wantNotify || f.count("end_entry") != 1+btoi(tt.seam == "end_entry") {
+					t.Errorf("calls = %v; want %d notify calls and the entry ended once the seam works", f.calls, tt.wantNotify)
+				}
+			})
+		}
+	})
+
+	t.Run("AHalfDoneFilingIsFinishedWithoutTheChecks", func(t *testing.T) {
+		t.Parallel()
+		f := newRaddleFileFixture(t, raddleFileProposal(raddleparser.ShapeTasks), loomshed.RaddleModeAuto, false)
+		f.alreadyFiled = true
+		// The stage a filing that crashed after its board write leaves: every staged file, the proposal's hash last.
+		f.write(filepath.Join(f.deps.StageDir, "proposal.yaml"), string(marshalRaddleProposal(t, f.proposal)))
+		f.write(filepath.Join(f.deps.StageDir, "cold-proposal.yaml"), "cold")
+		f.write(filepath.Join(f.deps.StageDir, "decision-record.md"), raddleFileRecord)
+		f.write(filepath.Join(f.deps.StageDir, "hash"), raddleparser.Hash(marshalRaddleProposal(t, f.proposal)))
+		f.recheck.Landed = []string{"gone"}
+		// The filed entries already hold the slugs, so a check or a re-check run over them would send the proposal back.
+		f.findings = []raddleparser.Finding{{Check: raddleparser.CheckSlugTaken, Detail: "filed parts now hold the slugs"}}
+		f.recheck.Failures = moved
+
+		outcome, _, err := f.call()
+		requireDone(t, outcome, err)
+
+		if f.count("check") != 0 || f.count("recheck") != 1 || f.count("commit") != 1 || f.count("file") != 1 {
+			t.Errorf("calls = %v; want no check, one re-check read for the landed entries, and the commit and the filing once so the store is written", f.calls)
+		}
+		if len(f.notices) != 1 || !strings.Contains(f.notices[0], "gone") {
+			t.Errorf("notices = %q; want one naming the landed entry gone", f.notices)
+		}
+		if f.askedSketch != f.proposal.Sketch || !slices.Equal(f.askedSlugs, []string{"part-a", "part-b"}) {
+			t.Errorf("AlreadyFiled(%q, %v); want the proposal's Sketch and its part slugs", f.askedSketch, f.askedSlugs)
+		}
+		if got := f.state(); got.Returns != 0 {
+			t.Errorf("returns = %d; want 0, since the half-done filing is no return", got.Returns)
+		}
+	})
+
+	t.Run("AHalfDoneFilingOfAnEditedProposalIsCheckedAgain", func(t *testing.T) {
+		t.Parallel()
+		f := newRaddleFileFixture(t, raddleFileProposal(raddleparser.ShapeTasks), loomshed.RaddleModeAuto, false)
+		f.alreadyFiled = true
+		f.write(filepath.Join(f.deps.StageDir, "hash"), "hash of the proposal that was filed")
+		f.findings = []raddleparser.Finding{{Check: raddleparser.CheckSlugTaken, Detail: "filed parts now hold the slugs"}}
+
+		outcome, pointer, err := f.call()
+
+		if err != nil || outcome != shedengine.Stuck || pointer.Halt || !strings.Contains(pointer.Reason, raddleparser.CheckSlugTaken) {
+			t.Fatalf("Call() = %q, %+v, %v; want Stuck without Halt naming the failed check", outcome, pointer, err)
+		}
+		if f.count("file") != 0 || f.askedSlugs != nil {
+			t.Errorf("calls = %v, AlreadyFiled slugs = %v; want no filing and no question to the board, since the stage holds another proposal", f.calls, f.askedSlugs)
+		}
+	})
+
+	t.Run("ACrashBeforeTheFilingRewritesTheOutputsOfAnEarlierProposal", func(t *testing.T) {
+		t.Parallel()
+		f := newRaddleFileFixture(t, raddleFileProposal(raddleparser.ShapeTasks), loomshed.RaddleModeInteractive, true)
+		f.failing["commit"] = errors.New("git commit failed")
+		if _, _, err := f.call(); err == nil {
+			t.Fatal("Call() = nil error; want the commit fault")
+		}
+
+		edited := f.proposal
+		edited.Cost.Line = "revised after the crash"
+		f.writeProposal(edited)
+		newData := marshalRaddleProposal(t, edited)
+		f.updateState(func(stored *loomshed.RaddleState) {
+			stored.Approval = &loomshed.RaddleApprovalRecord{Hash: raddleparser.Hash(newData), Session: 2}
+		})
+		delete(f.failing, "commit")
+
+		outcome, _, err := f.call()
+		requireDone(t, outcome, err)
+		if got := f.read(filepath.Join(f.deps.StageDir, "proposal.yaml")); got != string(newData) {
+			t.Errorf("staged proposal = %q; want the revised proposal", got)
+		}
+		if got, want := f.read(f.deps.PartRecordPath("part-a")+".hash"), raddleparser.Hash(newData); got != want {
+			t.Errorf("part record hash = %q; want %q", got, want)
+		}
+		if got := string(f.filings[0].Proposal); got != string(newData) {
+			t.Errorf("filed proposal = %q; want the revised proposal", got)
+		}
+	})
+
+	t.Run("AReturnedProposalIsNotFiledUntilApprovedAgain", func(t *testing.T) {
+		t.Parallel()
+		f := newRaddleFileFixture(t, raddleFileProposal(raddleparser.ShapeTasks), loomshed.RaddleModeInteractive, true)
+		f.recheck.Failures = moved
+		if outcome, _, err := f.call(); err != nil || outcome != shedengine.Stuck {
+			t.Fatalf("first Call() = %q, %v; want Stuck", outcome, err)
+		}
+
+		f.recheck.Failures = nil
+		outcome, pointer, err := f.call()
+		if err != nil || outcome != shedengine.Stuck || !strings.Contains(pointer.Reason, "no recorded approval") || len(f.filings) != 0 {
+			t.Fatalf("second Call() = %q, %+v, %v with %d filings; want Stuck naming the missing approval and nothing filed", outcome, pointer, err, len(f.filings))
+		}
+
+		f.updateState(func(stored *loomshed.RaddleState) {
+			stored.Approval = &loomshed.RaddleApprovalRecord{Hash: raddleparser.Hash(marshalRaddleProposal(t, f.proposal)), Session: 2}
+		})
+		outcome, _, err = f.call()
+		requireDone(t, outcome, err)
+	})
+
+	t.Run("LandedEntriesAreNamedInTheNoticeAndFailNothing", func(t *testing.T) {
+		t.Parallel()
+		f := newRaddleFileFixture(t, raddleFileProposal(raddleparser.ShapeTasks), loomshed.RaddleModeAuto, false)
+		f.recheck.Landed = []string{"gone"}
+
+		outcome, _, err := f.call()
+		requireDone(t, outcome, err)
+		if len(f.notices) != 1 || !strings.Contains(f.notices[0], "gone") {
+			t.Errorf("notices = %q; want one naming the landed entry gone", f.notices)
+		}
+	})
+}
+
+// btoi returns 1 for true and 0 for false.
+func btoi(value bool) int {
+	if value {
+		return 1
+	}
+	return 0
+}
diff --git a/internal/loomshed/raddlestate.go b/internal/loomshed/raddlestate.go
new file mode 100644
index 00000000..62437305
--- /dev/null
+++ b/internal/loomshed/raddlestate.go
@@ -0,0 +1,87 @@
+// raddlestate.go holds the raddle run's state record and the one-time storing of the cold proposal.
+
+package loomshed
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/Knatte18/loomyard/internal/fsx"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// RaddleMode is how a raddle run gets its approval: RaddleModeAuto files without an operator, RaddleModeInteractive waits for the operator's approval.
+type RaddleMode string
+
+// The two modes of a raddle run.
+const (
+	RaddleModeAuto        RaddleMode = "auto"
+	RaddleModeInteractive RaddleMode = "interactive"
+)
+
+// RaddleApprovalRecord is the approval of one proposal: the hash of the proposal file approved and the Raddle-Write session it was approved in.
+// It is the content of the run's approval file and of RaddleState's approval.
+type RaddleApprovalRecord struct {
+	Hash    string `json:"hash"`
+	Session int    `json:"session"`
+}
+
+// RaddleState is the raddle run's state record, `state.json` in the run's raddle directory.
+// It is read and written through internal/state, so a key it does not declare is accepted and survives a rewrite.
+// Mode is empty until Raddle-Write's first spawn records it.
+// Session numbers the current Raddle-Write session, raised at every call of the row.
+// ProposedSession is the session of the last passing propose, and NoticeSession the session whose waiting notice went out.
+// Approval is nil while no proposal is approved.
+// Returns counts Raddle-File's returns, and ReturnReason holds the reason of a return no new session has taken up yet.
+// EntryPosition is the history position of the row entry the last fresh-entry reset took up.
+// NoticeSent marks Raddle-File's notice of what it filed.
+type RaddleState struct {
+	Mode            RaddleMode            `json:"mode"`
+	ColdStored      bool                  `json:"cold_stored"`
+	Session         int                   `json:"session"`
+	ProposedSession int                   `json:"proposed_session"`
+	NoticeSession   int                   `json:"notice_session"`
+	Approval        *RaddleApprovalRecord `json:"approval,omitempty"`
+	Returns         int                   `json:"returns"`
+	ReturnReason    string                `json:"return_reason,omitempty"`
+	EntryPosition   int                   `json:"entry_position"`
+	NoticeSent      bool                  `json:"notice_sent"`
+}
+
+// ReadRaddleState reads the run's state at path under the lock at lockPath.
+// An absent file reads as the zero state.
+func ReadRaddleState(path, lockPath string) (RaddleState, error) {
+	current, _, err := state.ReadJSON[RaddleState](path, lockPath)
+	return current, err
+}
+
+// UpdateRaddleState applies mutate to the run's state at path under one exclusive lock, writes the result and returns it.
+// It starts from the zero state when the file is absent.
+func UpdateRaddleState(path, lockPath string, mutate func(*RaddleState)) (RaddleState, error) {
+	var updated RaddleState
+	err := state.UpdateJSON(path, lockPath, func(current RaddleState, _ bool) (RaddleState, error) {
+		mutate(&current)
+		updated = current
+		return current, nil
+	})
+	return updated, err
+}
+
+// StoreColdProposal copies the proposal at proposalPath to coldPath and sets cold_stored in the state, in one state update.
+// It does nothing once cold_stored is set, so the cold proposal is stored once per run and never overwritten.
+func StoreColdProposal(proposalPath, coldPath, statePath, lockPath string) error {
+	return state.UpdateJSON(statePath, lockPath, func(current RaddleState, _ bool) (RaddleState, error) {
+		if current.ColdStored {
+			return current, nil
+		}
+		proposal, err := os.ReadFile(proposalPath)
+		if err != nil {
+			return current, fmt.Errorf("loomshed: read the proposal to store as the cold proposal: %w", err)
+		}
+		if err := fsx.AtomicWriteBytes(coldPath, proposal); err != nil {
+			return current, fmt.Errorf("loomshed: store the cold proposal: %w", err)
+		}
+		current.ColdStored = true
+		return current, nil
+	})
+}
diff --git a/internal/loomshed/raddlestate_test.go b/internal/loomshed/raddlestate_test.go
new file mode 100644
index 00000000..4626db83
--- /dev/null
+++ b/internal/loomshed/raddlestate_test.go
@@ -0,0 +1,112 @@
+// raddlestate_test.go exercises the raddle run's state record and the one-time storing of the cold proposal.
+
+package loomshed_test
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/loomshed"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestRaddleState(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("RoundTripsEveryField", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		path, lockPath := filepath.Join(dir, "state.json"), filepath.Join(dir, "state.json.lock")
+
+		absent, err := loomshed.ReadRaddleState(path, lockPath)
+		if err != nil || !reflect.DeepEqual(absent, loomshed.RaddleState{}) {
+			t.Fatalf("ReadRaddleState() of an absent file = %+v, %v; want the zero state and nil", absent, err)
+		}
+
+		want := loomshed.RaddleState{
+			Mode: loomshed.RaddleModeInteractive, ColdStored: true, Session: 3, ProposedSession: 2, NoticeSession: 2,
+			Approval: &loomshed.RaddleApprovalRecord{Hash: "abc", Session: 2}, Returns: 1, ReturnReason: "board moved",
+			EntryPosition: 7, NoticeSent: true,
+		}
+		updated, err := loomshed.UpdateRaddleState(path, lockPath, func(stored *loomshed.RaddleState) { *stored = want })
+		if err != nil || !reflect.DeepEqual(updated, want) {
+			t.Fatalf("UpdateRaddleState() = %+v, %v; want %+v and nil", updated, err, want)
+		}
+		got, err := loomshed.ReadRaddleState(path, lockPath)
+		if err != nil || !reflect.DeepEqual(got, want) {
+			t.Errorf("ReadRaddleState() = %+v, %v; want %+v and nil", got, err, want)
+		}
+	})
+
+	t.Run("KeepsAnUnknownKey", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		path, lockPath := filepath.Join(dir, "state.json"), filepath.Join(dir, "state.json.lock")
+		if err := os.WriteFile(path, []byte(`{"mode":"auto","future_key":7}`), 0o644); err != nil {
+			t.Fatalf("write the state: %v", err)
+		}
+
+		got, err := loomshed.ReadRaddleState(path, lockPath)
+		if err != nil || got.Mode != loomshed.RaddleModeAuto {
+			t.Fatalf("ReadRaddleState() = %+v, %v; want mode auto and nil", got, err)
+		}
+		if _, err := loomshed.UpdateRaddleState(path, lockPath, func(stored *loomshed.RaddleState) { stored.Session++ }); err != nil {
+			t.Fatalf("UpdateRaddleState() = %v; want nil", err)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil || !strings.Contains(string(data), "future_key") {
+			t.Errorf("state after the update = %s, %v; want it to keep future_key", data, err)
+		}
+	})
+
+	t.Run("StoreColdProposalStoresOnce", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		proposalPath, coldPath := filepath.Join(dir, "proposal.yaml"), filepath.Join(dir, "cold-proposal.yaml")
+		path, lockPath := filepath.Join(dir, "state.json"), filepath.Join(dir, "state.json.lock")
+
+		if err := os.WriteFile(proposalPath, []byte("first"), 0o644); err != nil {
+			t.Fatalf("write the proposal: %v", err)
+		}
+		if err := loomshed.StoreColdProposal(proposalPath, coldPath, path, lockPath); err != nil {
+			t.Fatalf("StoreColdProposal() first call = %v; want nil", err)
+		}
+		if err := os.WriteFile(proposalPath, []byte("second"), 0o644); err != nil {
+			t.Fatalf("rewrite the proposal: %v", err)
+		}
+		if err := loomshed.StoreColdProposal(proposalPath, coldPath, path, lockPath); err != nil {
+			t.Fatalf("StoreColdProposal() second call = %v; want nil", err)
+		}
+
+		cold, err := os.ReadFile(coldPath)
+		if err != nil || string(cold) != "first" {
+			t.Errorf("cold proposal = %q, %v; want %q left as the first call stored it", cold, err, "first")
+		}
+		got, err := loomshed.ReadRaddleState(path, lockPath)
+		if err != nil || !got.ColdStored {
+			t.Errorf("ReadRaddleState() = %+v, %v; want cold_stored set", got, err)
+		}
+	})
+
+	t.Run("StoreColdProposalWithNoProposalIsAnErrorAndStoresNothing", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		path, lockPath := filepath.Join(dir, "state.json"), filepath.Join(dir, "state.json.lock")
+		coldPath := filepath.Join(dir, "cold-proposal.yaml")
+
+		if err := loomshed.StoreColdProposal(filepath.Join(dir, "absent.yaml"), coldPath, path, lockPath); err == nil {
+			t.Fatal("StoreColdProposal() with no proposal = nil; want an error")
+		}
+		got, err := loomshed.ReadRaddleState(path, lockPath)
+		if err != nil || got.ColdStored {
+			t.Errorf("ReadRaddleState() = %+v, %v; want cold_stored unset", got, err)
+		}
+		if _, err := os.Stat(coldPath); !os.IsNotExist(err) {
+			t.Errorf("cold proposal stat = %v; want not-exist", err)
+		}
+	})
+}
diff --git a/internal/loomshed/raddlewrite.go b/internal/loomshed/raddlewrite.go
new file mode 100644
index 00000000..691d0981
--- /dev/null
+++ b/internal/loomshed/raddlewrite.go
@@ -0,0 +1,139 @@
+// raddlewrite.go implements the Raddle-Write producer: a decorator that records the run's mode, numbers each session of the row, gives a return or a goto a fresh start, and commits the raddle directory once the session is done.
+
+package loomshed
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// RaddleWriteDeps are the told paths and seams of the Raddle-Write producer.
+type RaddleWriteDeps struct {
+	// StatePath and StateLockPath are the run's state record and its lock.
+	StatePath     string
+	StateLockPath string
+	// ProposalPath is the proposal file and ReturnedPath where a return in auto mode sets it aside.
+	ProposalPath string
+	ReturnedPath string
+	// ColdPath is where the run's first passing proposal is stored once.
+	ColdPath string
+	// ApprovalPath is the approval record the approve verb writes.
+	ApprovalPath string
+	// AutoApprove answers the loom key raddle_auto_approve through the run's setting lookup, so a profile's raddle block may set it.
+	AutoApprove func() (bool, error)
+	// FreshEntry reports whether the row's current attempt began with a Raddle-File return or an operator goto into the row, read from the run's status history, with the history position of that entry.
+	// Position is zero when fresh is false.
+	FreshEntry func() (fresh bool, position int, err error)
+	// StoreCold copies the proposal to ColdPath and sets cold_stored unless already stored.
+	// It is the raddle gate's onPass in auto mode and a no-op in interactive mode, where the propose verb stores the cold proposal.
+	StoreCold func() error
+	// Commit commits the raddle directory.
+	Commit func() error
+}
+
+// raddleWrite is the Raddle-Write producer.
+type raddleWrite struct {
+	name  string
+	inner shedengine.ShedProducer
+	deps  RaddleWriteDeps
+}
+
+var _ shedengine.ShedProducer = (*raddleWrite)(nil)
+
+// NewRaddleWrite returns the producer of the Raddle-Write row, identified as name, around inner, the table-driven session producer.
+func NewRaddleWrite(name string, inner shedengine.ShedProducer, deps RaddleWriteDeps) shedengine.ShedProducer {
+	return &raddleWrite{name: name, inner: inner, deps: deps}
+}
+
+// Call implements shedengine.ShedProducer.
+// Each state update below is one step, so a resume after a crash repeats none of them:
+// the first call records the run's mode from AutoApprove, which every later call and Raddle-File read from the state instead of the key, and every call raises the session count.
+// A fresh entry not yet taken up at its history position sets the last attempt's output aside, so the seat starts a new session: auto mode moves the proposal to ReturnedPath, and interactive mode removes the approval record and clears the state's approval.
+// The inner producer then runs, and on Done the return reason is cleared and the raddle directory committed.
+// An error or a Stuck verdict of the inner producer is returned as is, with no commit.
+func (p *raddleWrite) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if err := entryErr(ctx, p.name); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+
+	recorded, err := ReadRaddleState(p.deps.StatePath, p.deps.StateLockPath)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("read the run's state", err)
+	}
+	mode := recorded.Mode
+	if mode == "" {
+		auto, err := p.deps.AutoApprove()
+		if err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("read the raddle_auto_approve setting", err)
+		}
+		mode = RaddleModeInteractive
+		if auto {
+			mode = RaddleModeAuto
+		}
+	}
+	current, err := UpdateRaddleState(p.deps.StatePath, p.deps.StateLockPath, func(stored *RaddleState) {
+		if stored.Mode == "" {
+			stored.Mode = mode
+		}
+		stored.Session++
+	})
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("record the session", err)
+	}
+
+	fresh, position, err := p.deps.FreshEntry()
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("read the row's entry from the run's history", err)
+	}
+	if fresh && position != current.EntryPosition {
+		if err := p.clearLastAttempt(current.Mode); err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("clear the last attempt's output", err)
+		}
+		if _, err := UpdateRaddleState(p.deps.StatePath, p.deps.StateLockPath, func(stored *RaddleState) {
+			stored.EntryPosition = position
+			if current.Mode == RaddleModeInteractive {
+				stored.Approval = nil
+			}
+		}); err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("record the taken entry", err)
+		}
+	}
+
+	outcome, pointer, err := p.inner.Call(ctx)
+	if err != nil || outcome != shedengine.Done {
+		return outcome, pointer, err
+	}
+
+	if _, err := UpdateRaddleState(p.deps.StatePath, p.deps.StateLockPath, func(stored *RaddleState) { stored.ReturnReason = "" }); err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("clear the return reason", err)
+	}
+	if err := p.deps.Commit(); err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("commit the raddle directory", err)
+	}
+	return outcome, pointer, nil
+}
+
+// clearLastAttempt removes the output of the last attempt in mode, so the seat's output file does not exist when its new session starts.
+// A file already gone is no error, since a crash may have cleared it before the state recorded the entry.
+func (p *raddleWrite) clearLastAttempt(mode RaddleMode) error {
+	var err error
+	if mode == RaddleModeAuto {
+		err = os.Rename(p.deps.ProposalPath, p.deps.ReturnedPath)
+	} else {
+		err = os.Remove(p.deps.ApprovalPath)
+	}
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil
+	}
+	return err
+}
+
+// fail returns the error of a failed step, naming the producer and the re-step that retries it.
+func (p *raddleWrite) fail(step string, err error) error {
+	return fmt.Errorf("loomshed: %s: %s: %w; way forward: the fault is transient, re-step the %s row", p.name, step, err, p.name)
+}
diff --git a/internal/loomshed/raddlewrite_test.go b/internal/loomshed/raddlewrite_test.go
