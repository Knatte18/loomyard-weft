-		if !retry.failing {
-			d.logLine(now, "teardown "+slug+" failing: "+oneLine(reason.Error()))
-		}
-		interval := d.probe
-		if retry.interval > 0 {
-			interval = min(retry.interval*2, endedTeardownCeiling)
-		}
-		d.endedRetries[slug] = endedRetry{next: now.Add(interval), interval: interval, failing: true}
-	}
-}
