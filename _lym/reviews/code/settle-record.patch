+	parent.AddCommand(c.runCmd(), c.openCmd(), c.agentCmd(), c.manifestCmd(), c.stateCmd(), c.awaitCmd(), c.awaitForksCmd(), hookBatchingCmd(), hookEditCmd(), hookPythonAllowedCmd())
 
 	return parent
 }
