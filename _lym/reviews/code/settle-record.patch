+		t.Fatalf("flag b as a beam: %v", err)
+	}
+
+	beam, err := lymcwd.ResolveWorktree(fabricengine.WorktreePath(h.Location, "b"))
+	if err != nil {
+		t.Fatalf("resolve the beam worktree: %v", err)
+	}
