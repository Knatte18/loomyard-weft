+func TestHubLandDeps_MarkReadyCommitsAnUncommittedFlaggedRecord(t *testing.T) {
+	t.Parallel()
+
+	h, _ := landingHub(t)
+	beam, err := lymcwd.ResolveWorktree(fabricengine.WorktreePath(h.Location, "b"))
