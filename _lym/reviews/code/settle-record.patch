+	reasonNoMapToMutate     = "no coverage map holds it; way forward: build the maps with `lym gate test --map` from the prime"
+	reasonSharedMapStale    = "its shared map no longer matches the worktree's files; way forward: rebuild the maps with `lym gate test --map` from the prime"
+	reasonWorktreeMapStale  = "its worktree map no longer matches the worktree's files; way forward: commit the files and run the verb again"
+	reasonRefreshWroteNoMap = "the refresh wrote no map of it, as the errors name; way forward: run the verb again"
+)
+
+// mutateRequest is one `lym gate mutate` invocation after flag parsing.
+type mutateRequest struct {
+	// base is the --base revision, empty for the merge base with the parent branch.
+	base string
+	// goBinary is the go command the builds run.
+	goBinary string
+	// environ is the environment the call's children start from: the process's own in production.
+	environ []string
+	// secondUnit is the length of one `redundancy_test_timeout_sec` second.
+	// minuteUnit is the length of one minute of the budget and build bound keys.
+	secondUnit, minuteUnit time.Duration
+	// grace bounds the wait for a killed build's or test's exit and output.
+	grace time.Duration
+	// cappedParallel returns how many of parallel test runs, each capped at limit bytes of memory, go side by side.
+	cappedParallel func(parallel int, limit int64) int
+	// stderr receives the memory guard's line for each test binary it kills; nil prints none.
+	stderr io.Writer
+}
+
+// checkRequest returns the request a mutation check reads its builds and bounds from.
+func (r mutateRequest) checkRequest() redundantRequest {
+	return redundantRequest{
+		goBinary: r.goBinary, environ: r.environ, secondUnit: r.secondUnit, minuteUnit: r.minuteUnit, grace: r.grace,
+		cappedParallel: r.cappedParallel, stderr: r.stderr,
+	}
+}
+
+// mutateCmd builds `lym gate mutate`.
+// goBinary is the go command its builds run.
+// minuteUnit is the length of one minute of `reach_budget_min`, `mutation_budget_min` and `redundancy_build_timeout_min`.
+// grace is the wait for a killed build's or test's exit and output.
+func mutateCmd(goBinary string, minuteUnit, grace time.Duration) *cobra.Command {
+	var base string
+	cmd := &cobra.Command{
+		Use:         "mutate",
+		Short:       "mutate the lines the worktree's diff changes and list the mutants no test that covers them kills",
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceOperator},
+		Long: `mutate mutates the lines the worktree's diff changes and lists the mutants no test kills.
+The diff is from --base, else the merge base with the parent branch; a worktree with neither, the prime's case, is refused.
+It refreshes the worktree's own coverage maps of the packages holding a changed function under reach_budget_min; the prime refreshes nothing.
+A package is judged only with a fresh map: one the refresh wrote, or a map whose file hashes match the worktree, the hub's shared one in the prime.
+Any other changed package is listed as not judged, with its reason and way forward.
+It places at most one mutant on each changed line of a block a test covers, up to mutation_max_mutants over the changed functions in turn.
+It runs each mutant against the map's tests that cover its block until one fails, inside one gate slot bounded by mutation_budget_min.
+A run past its time bound or the memory cap is unjudged, never a kill; a mutant every covering test passes is a survivor.
+It prints the survivors with the tests of other packages that reach their function, the uncovered changed blocks, the packages not judged and the counts of mutants run, killed, survived and unjudged.
+It exits 0 once it ran, whatever it found.
+
+Examples:
+
+  lym gate mutate
+  lym gate mutate --base 3f2a9c1`,
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			clihelp.SetExit(cmd.Context(), runMutate(cmd.Context(), cmd.OutOrStdout(), mutateRequest{
+				base: base, goBinary: goBinary, environ: os.Environ(), secondUnit: time.Second, minuteUnit: minuteUnit, grace: grace,
+				cappedParallel: memoryCappedParallel, stderr: cmd.ErrOrStderr(),
+			}))
+			return nil
+		},
+	}
+	cmd.Flags().StringVar(&base, "base", "", "commit whose diff to the working tree is mutated; default the merge base with the parent branch")
+	return cmd
+}
+
+// diffBase returns the commit the verb diffs from, or a refusal when there is none.
+func (r mutateRequest) diffBase(location *lymcwd.Location, fabric *fabricengine.Fabric) (string, string) {
+	if r.base != "" {
+		if !fabric.CommitExists(r.base) {
+			return "", fmt.Sprintf("gate mutate: --base %q names no commit; way forward: pass the SHA of a commit the repository holds", r.base)
+		}
+		return r.base, ""
+	}
+	base, found, err := parentMergeBase(location)
+	switch {
+	case err != nil:
+		return "", fmt.Sprintf("gate mutate: read the merge base with the parent branch: %v; way forward: re-run the same command", err)
+	case !found:
+		return "", "gate mutate: the worktree has no parent branch to diff from; way forward: pass --base with the commit to diff from"
+	}
+	return base, ""
+}
+
+// runMutate writes the mutation check of the worktree's diff.
+// It returns the verb's exit code.
+// The code is 0 once it ran, whatever it found, and 1 for a refusal or a failure that ends the call.
+// After a terminating signal the code is 128 plus the signal number.
+func runMutate(ctx context.Context, out io.Writer, request mutateRequest) int {
+	cwd, err := lymcwd.CwdFrom(ctx)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: cannot read the working directory: %v; way forward: re-run the same command", err))
+	}
+	location, inHub, err := resolveHub(cwd)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v; way forward: re-run the same command", err))
+	}
+	if !inHub {
+		return output.Err(out, fmt.Sprintf("gate mutate: %s is in no hub, and the coverage maps live in a hub; way forward: run lym gate mutate from a worktree of the hub", cwd))
+	}
+	dirs := fabricengine.ConfigDirs(location)
+	cfg, err := gateslot.LoadConfig(dirs)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: cannot read the hub's gate config: %v; way forward: take the step it names, then re-run the same command", err))
+	}
+	cfg = cfg.WithDefaultDir(location.AnchorRel)
+	if cfg.Scoper != "go" {
+		return output.Ok(out, map[string]any{"note": fmt.Sprintf(noteScoper, cfg.Scoper)})
+	}
+	root := location.WorktreePath()
+	module, err := redundancyModule(cfg, root)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v; way forward: declare tier0 or tier1 with its dir at the Go module's root with lym config gate from the prime, then re-run the same command", err))
+	}
+	fabric, err := fabricengine.Open(location)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v; way forward: re-run the same command", err))
+	}
+	prime, err := hubgeom.IsPrime(location)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v; way forward: re-run the same command", err))
+	}
+	base, refusal := request.diffBase(location, fabric)
+	if refusal != "" {
+		return output.Err(out, refusal)
+	}
+	hubEnv, err := envconfig.LoadConfig(dirs)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: cannot read the env config: %v; way forward: take the step it names, then re-run the same command", err))
+	}
+
+	runCtx, caught, stop := catchTerminatingSignals(ctx)
+	defer stop()
+	stopGuard, guardKilled := guardOwnTests(runCtx, cfg.MemoryQuit(), request.stderr)
+	defer stopGuard()
+	cancelled := func() int {
+		output.Err(out, "gate mutate: the call was cancelled; way forward: re-run the same command")
+		return exitAfterSignal(caught, 1)
+	}
+
+	changed, err := impactset.ChangedPaths(runCtx, root, base)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v; way forward: re-run the same command", err))
+	}
+	head := workingTree{root: root}
+	funcs, err := changedFuncsAt(head, fabric, base, module, changed)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: find the changed functions: %v; way forward: fix the file it names, then re-run the same command", err))
+	}
+	lines, err := changedLinesAt(head, fabric, base, module, changed)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: find the changed lines: %v; way forward: re-run the same command", err))
+	}
+	answer := map[string]any{"base": base, "prime": prime, "changed_functions": len(funcs)}
+	outcome := newMutateOutcome()
+	if len(funcs) == 0 {
+		answer["note"] = "the diff changes no function, so nothing was mutated"
+		return output.Ok(out, fillMutateAnswer(answer, outcome, []mutateNotJudged{}, nil))
+	}
+
+	step := reachStep{
+		ctx: runCtx, stderr: request.stderr, cfg: cfg, location: location, root: root, environ: request.environ, goBinary: request.goBinary,
+		minuteUnit: request.minuteUnit, secondUnit: request.secondUnit, grace: request.grace, guardKilled: guardKilled,
+	}
+	var refresh ReachReport
+	step.refreshMaps(&refresh, module, funcs, prime)
+	if runCtx.Err() != nil {
+		return cancelled()
+	}
+	mapsDir, err := coverageMapsDir(location)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v; way forward: re-run the same command", err))
+	}
+	fresh, notJudged, err := freshMaps(module, mapsDir, prime, changedPackages(module, funcs), refresh)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: %v", err))
+	}
+	if len(fresh) == 0 {
+		return output.Ok(out, fillMutateAnswer(answer, outcome, notJudged, refresh.Errors))
+	}
+	reader, err := testreach.Open(reachModuleOf(module), testcover.Dir(fabricengine.BoltDir(location.HubPath)), step.worktreeMapsDir(prime))
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate mutate: read the coverage maps: %v; way forward: re-run the same command", err))
+	}
+
+	holder := &mutationCheck{
+		ctx: runCtx, request: request.checkRequest(), location: location, pool: hubgeom.GateSlots(location), tiers: mappedTierConfigs(cfg),
+		moduleDir:    module.dir,
+		buildTimeout: time.Duration(cfg.RedundancyBuildTimeoutMin) * request.minuteUnit,
+		testTimeout:  time.Duration(cfg.RedundancyTestTimeoutSec) * request.secondUnit,
+		testMemory:   cfg.RedundancyTestMemory(),
+		guardKilled:  guardKilled,
+		env:          gateEnv(request.environ, hubEnv),
+		site:         mutateSite,
+	}
+	defer holder.close()
+	check := &diffMutation{
+		holder: holder, module: module, reader: reader, fresh: fresh, changedLines: lines,
+		maxMutants: cfg.MutationMaxMutants, budget: time.Duration(cfg.MutationBudgetMin) * request.minuteUnit,
+		outcome: outcome,
+	}
+	outcome, err = check.run()
+	if err != nil {
+		if runCtx.Err() != nil {
+			return cancelled()
+		}
+		return output.Err(out, fmt.Sprintf("gate mutate: the mutation check failed: %v; way forward: fix the build or test failure it names, then re-run the same command", err))
+	}
+	return output.Ok(out, fillMutateAnswer(answer, outcome, notJudged, refresh.Errors))
+}
+
+// fillMutateAnswer fills answer with what the check found and returns it.
+// notJudged are the changed packages left out before the check, and each package the check could not plan joins them.
+// refreshErrors are the error lines of the maps' refresh.
+func fillMutateAnswer(answer map[string]any, outcome mutateOutcome, notJudged []mutateNotJudged, refreshErrors []string) map[string]any {
+	answer["errors"] = append([]string{}, refreshErrors...)
+	answer["mutants"] = outcome.counts
+	answer["runs"] = outcome.runs
+	answer["survivors"] = outcome.survivors
+	answer["unjudged_mutants"] = outcome.unjudged
+	answer["uncovered_blocks"] = outcome.uncovered
+	answer["not_judged"] = append(notJudged, outcome.notJudged...)
+	return answer
+}
+
+// freshMaps returns the map of each of packages whose map is fresh against the worktree's files, by module-relative path.
+// It also returns why each other package is not judged.
+// A task worktree reads its own maps, and a package the refresh left unrefreshed is not judged for the refresh's reason.
+// The prime reads the hub's shared maps, which the refresh never touches.
+// The error is a map that cannot be read.
+func freshMaps(module goModule, mapsDir string, prime bool, packages []string, refresh ReachReport) (map[string]testcover.Map, []mutateNotJudged, error) {
+	fresh := map[string]testcover.Map{}
+	notJudged := []mutateNotJudged{}
+	for _, pkg := range packages {
+		if reason := unrefreshedReason(refresh.Unrefreshed, pkg); reason != "" && !prime {
+			notJudged = append(notJudged, mutateNotJudged{Package: pkg, Reason: reason})
+			continue
+		}
+		m, found, err := testreach.ReadPackageMap(mapsDir, pkg)
+		if err != nil {
+			return nil, nil, err
+		}
+		reason := reasonRefreshWroteNoMap
+		if prime {
+			reason = reasonNoMapToMutate
+		}
+		if found {
+			isFresh, err := testreach.Fresh(reachModuleOf(module), pkg, m)
+			if err != nil {
+				return nil, nil, err
+			}
+			if isFresh {
+				fresh[pkg] = m
+				continue
+			}
+			reason = reasonWorktreeMapStale
+			if prime {
+				reason = reasonSharedMapStale
+			}
+		}
+		notJudged = append(notJudged, mutateNotJudged{Package: pkg, Reason: reason})
+	}
+	return fresh, notJudged, nil
+}
+
+// unrefreshedReason returns why the refresh left the package pkg unrefreshed, or "" when it did not.
+func unrefreshedReason(unrefreshed []string, pkg string) string {
+	for _, line := range unrefreshed {
+		if reason, named := strings.CutPrefix(line, pkg+": "); named {
+			return reason
+		}
+	}
+	return ""
+}
+
+// changedLinesAt returns the changed lines of each changed production Go file of the module that head holds.
+// changed are the worktree-relative slash paths that differ between the commit base and head.
+// The lines are those of the head file that a line diff against the file at base marks.
+// They are keyed by module-relative package and file name.
+func changedLinesAt(head redundancyTree, fabric *fabricengine.Fabric, base string, module goModule, changed []string) (map[string]map[string][]int, error) {
+	lines := map[string]map[string][]int{}
+	for _, rel := range changed {
+		dir := path.Dir(rel)
+		if !strings.HasSuffix(rel, ".go") || strings.HasSuffix(rel, "_test.go") || !isModulePackage(module.rel, dir) {
+			continue
+		}
+		headData, found, err := head.file(rel)
+		if err != nil {
+			return nil, fmt.Errorf("read %s: %w", rel, err)
+		}
+		if !found {
+			continue
+		}
+		baseData, _, err := fabric.CodeFileAt(base, rel)
+		if err != nil {
+			return nil, fmt.Errorf("read %s at %s: %w", rel, base, err)
+		}
+		marked := testreach.ChangedLines(baseData, headData)
+		if len(marked) == 0 {
+			continue
+		}
+		pkg := modulePackageOf(module.rel, dir)
+		if lines[pkg] == nil {
+			lines[pkg] = map[string][]int{}
+		}
+		lines[pkg][path.Base(rel)] = marked
+	}
+	return lines, nil
+}
diff --git a/internal/gatecli/mutate_integration_test.go b/internal/gatecli/mutate_integration_test.go
new file mode 100644
index 00000000..b6f2fe3e
--- /dev/null
+++ b/internal/gatecli/mutate_integration_test.go
@@ -0,0 +1,505 @@
+// mutate_integration_test.go drives `lym gate mutate` over hubforge hubs whose prime holds a small Go module.
+// The module's coverage maps are built by the real `lym gate test --map`.
+// Its mutants are built and run by the real go command.
+// It is Tier 1: it builds real hubs, spawns git and builds and runs real binaries.
+
+package gatecli
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/plankit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// mutateModule is the import path of the fixture module.
+// It is the import path a coverage map reads tiers from, so the module builds alone beside its own stand-in tiergate.
+const mutateModule = "github.com/Knatte18/loomyard"
+
+// mutateSupportFiles are the fixture module's files that no landing changes.
+// calc holds the functions each landing changes, and its tests check only some of them.
+// TestScaleRuns runs Scale and checks nothing, and TestOtherCalls of package other reaches it too.
+// Nothing runs Spare.
+// Tally has a dropped decrement that makes its loop endless.
+// Hoard has a negated loop condition that keeps memory for ever.
+// Each yields a mutant that ends unjudged.
+var mutateSupportFiles = map[string]string{
+	"internal/testkit/tiergate/tiergate.go": "package tiergate\n\nimport \"testing\"\n\n// Require stands in for the tier gate: every test runs.\nfunc Require(t testing.TB, tier int) {}\n",
+	"calc/calc_test.go": `package calc
+
+import (
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestClampChecked(t *testing.T) {
+	tiergate.Require(t, 0)
+	if Clamp(-1) != 0 || Clamp(5) != 5 {
+		t.Fatal("Clamp is wrong")
+	}
+}
+
+func TestClampCheckedAgain(t *testing.T) {
+	tiergate.Require(t, 0)
+	if Clamp(-1) != 0 || Clamp(5) != 5 {
+		t.Fatal("Clamp is wrong")
+	}
+}
+
+func TestScaleRuns(t *testing.T) {
+	tiergate.Require(t, 0)
+	Scale(2)
+	Scale(200)
+}
+
+func TestTallyChecked(t *testing.T) {
+	tiergate.Require(t, 0)
+	if Tally(3) != 3 {
+		t.Fatal("Tally(3) != 3")
+	}
+}
+
+func TestHoardChecked(t *testing.T) {
+	tiergate.Require(t, 0)
+	if Hoard(0) != 0 {
+		t.Fatal("Hoard(0) != 0")
+	}
+}
+`,
+	"other/other.go": "package other\n\nimport \"github.com/Knatte18/loomyard/calc\"\n\nfunc Run() int { return calc.Scale(1) }\n",
+	"other/other_test.go": `package other
+
+import (
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestOtherCalls(t *testing.T) {
+	tiergate.Require(t, 0)
+	Run()
+}
+`,
+}
+
+// Indexes of the functions of calc in mutateCalcFunctions, in the order calc.go declares them.
+const (
+	calcClamp = iota
+	calcScale
+	calcTally
+	calcHoard
+	calcSpare
+)
+
+// mutateCalcFunctions holds the seed text and the landed text of each function of calc.
+// The seed text stands where a function has not landed yet, and every landed text changes lines.
+var mutateCalcFunctions = [...]struct{ seed, landed string }{
+	calcClamp: {
+		"func Clamp(n int) int {\n\treturn n\n}\n",
+		"func Clamp(n int) int {\n\tif n < 0 {\n\t\treturn 0\n\t}\n\treturn n\n}\n",
+	},
+	calcScale: {
+		"func Scale(n int) int {\n\treturn n\n}\n",
+		"func Scale(n int) int {\n\tlimit := 100\n\tif n > limit {\n\t\treturn limit\n\t}\n\treturn n\n}\n",
+	},
+	calcTally: {
+		"func Tally(n int) int {\n\treturn n\n}\n",
+		"func Tally(n int) int {\n\tsteps := 0\n\tfor n > 0 {\n\t\tn -= 1\n\t\tsteps += 1\n\t}\n\treturn steps\n}\n",
+	},
+	calcHoard: {
+		"func Hoard(n int) int {\n\treturn n\n}\n",
+		"const hoardStop = 384\n\nfunc Hoard(n int) int {\n\tvar kept [][]byte\n\tfor i := 1; i <= n; i++ {\n" +
+			"\t\tif len(kept) == hoardStop {\n\t\t\tpanic(\"Hoard kept hoardStop megabytes: no memory cap ended the run\")\n\t\t}\n" +
+			"\t\tblock := make([]byte, 1<<20)\n\t\tfor at := range block {\n\t\t\tblock[at] = 1\n\t\t}\n\t\tkept = append(kept, block)\n\t}\n" +
+			"\treturn len(kept)\n}\n",
+	},
+	calcSpare: {
+		"func Spare(n int) int {\n\treturn n\n}\n",
+		"func Spare(n int) int {\n\treturn n + 5\n}\n",
+	},
+}
+
+// mutateCalcAt returns calc.go with the functions whose indexes landed names at their landed text.
+func mutateCalcAt(landed ...int) string {
+	var b strings.Builder
+	b.WriteString("package calc\n")
+	for i, fn := range mutateCalcFunctions {
+		b.WriteString("\n")
+		if slices.Contains(landed, i) {
+			b.WriteString(fn.landed)
+		} else {
+			b.WriteString(fn.seed)
+		}
+	}
+	return b.String()
+}
+
+// landMutateCalc writes calc.go with the functions landed names landed, commits it in root and returns the commit.
+func landMutateCalc(t *testing.T, root string, landed ...int) string {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(root, "calc", "calc.go"), []byte(mutateCalcAt(landed...)), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	gitkit.Git(t, root, "add", "calc", "other", "internal")
+	gitkit.Git(t, root, "commit", "-q", "-m", "land calc")
+	return gitkit.RevParse(t, root, "HEAD")
+}
+
+// editMutateCalc replaces from with to in calc.go of root, leaving the change uncommitted.
+func editMutateCalc(t *testing.T, root, from, to string) {
+	t.Helper()
+	file := filepath.Join(root, "calc", "calc.go")
+	data, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), from) {
+		t.Fatalf("calc.go holds no %q to replace", from)
+	}
+	if err := os.WriteFile(file, []byte(strings.Replace(string(data), from, to, 1)), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// mutateGate returns the hub's gate.yaml with the top-level lines extra adds.
+func mutateGate(extra string) string {
+	return "slots: 2\nscoper: go\nredundancy_test_timeout_sec: 20\nredundancy_test_memory_mb: 128\n" + extra +
+		"tiers:\n  tier0: {command: x, timeout_min: 1, counter: go-json, env: {LYM_TEST_TIER: \"0\"}}\n"
+}
+
+// lineOf returns the 1-based number of the first line of text that holds needle.
+func lineOf(t *testing.T, text, needle string) int {
+	t.Helper()
+	for i, line := range strings.Split(text, "\n") {
+		if strings.Contains(line, needle) {
+			return i + 1
+		}
+	}
+	t.Fatalf("the text holds no line with %q", needle)
+	return 0
+}
+
+// mutateVerbAnswer is the part of a `lym gate mutate` envelope the rows compare.
+type mutateVerbAnswer struct {
+	OK              bool                   `json:"ok"`
+	Error           string                 `json:"error"`
+	Note            string                 `json:"note"`
+	Base            string                 `json:"base"`
+	Mutants         mutateCounts           `json:"mutants"`
+	Runs            int                    `json:"runs"`
+	Survivors       []mutateSurvivor       `json:"survivors"`
+	UnjudgedMutants []mutateUnjudgedMutant `json:"unjudged_mutants"`
+	UncoveredBlocks []mutateUncoveredBlock `json:"uncovered_blocks"`
+	NotJudged       []mutateNotJudged      `json:"not_judged"`
+}
+
+// runMutateVerb runs the command root over the directory cwd with args and returns its exit code and envelope.
+func runMutateVerb(t *testing.T, root *cobra.Command, cwd string, args ...string) (int, mutateVerbAnswer) {
+	t.Helper()
+	var out bytes.Buffer
+	code := clihelp.ExecuteIn(root, cwd, &out, args)
+	var answer mutateVerbAnswer
+	if err := json.Unmarshal(out.Bytes(), &answer); err != nil {
+		t.Fatalf("lym gate %v printed %q; want one JSON envelope: %v", args, out.String(), err)
+	}
+	return code, answer
+}
+
+// requireMutateAnswer fails the test unless the verb exited 0 with an ok envelope.
+func requireMutateAnswer(t *testing.T, code int, answer mutateVerbAnswer) {
+	t.Helper()
+	if code != 0 || !answer.OK {
+		t.Fatalf("lym gate mutate = exit %d, ok %v, error %q; want exit 0", code, answer.OK, answer.Error)
+	}
+}
+
+// survivorLines returns the lines of the survivors, in the order the envelope lists them.
+func survivorLines(answer mutateVerbAnswer) []int {
+	var lines []int
+	for _, survivor := range answer.Survivors {
+		lines = append(lines, survivor.Line)
+	}
+	return lines
+}
+
+// unjudgedAt returns the reason of the unjudged mutant on the line of calc.go, or "" when none is unjudged there.
+func unjudgedAt(answer mutateVerbAnswer, line int) string {
+	for _, unjudged := range answer.UnjudgedMutants {
+		if unjudged.File == "calc/calc.go" && unjudged.Line == line {
+			return unjudged.Reason
+		}
+	}
+	return ""
+}
+
+// TestGateMutate mutates the diffs of a hub's module and reads the verdicts back, with real builds and runs.
+func TestGateMutate(t *testing.T) {
+	tiergate.Require(t, 1)
+	// The test runs once, in parallel with the other tests, but its rows run one after another:
+	// each builds real binaries in one hub, rewrites the hub's gate.yaml, or times a mutant against a real bound.
+	t.Parallel()
+
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: ".", Pairs: []string{hubforge.TemplatePairSlug}})
+	prime, pair := h.PrimeWorktree(), h.PairCodeWorktree(hubforge.TemplatePairSlug)
+	setGate := func(extra string) {
+		t.Helper()
+		if err := os.WriteFile(configengine.ConfigFile(h.BoardDir(), "gate"), []byte(mutateGate(extra)), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	seedTestMapModule(t, h, mutateModule, mutateGate(""), map[string]map[string]int{"calc": nil})
+	plankit.WriteTree(t, prime, mutateSupportFiles)
+	// Three landings after the seed: Tally, Hoard and Spare, then Scale, then Clamp.
+	seed := landMutateCalc(t, prime)
+	afterTallyHoardSpare := landMutateCalc(t, prime, calcTally, calcHoard, calcSpare)
+	afterScale := landMutateCalc(t, prime, calcScale, calcTally, calcHoard, calcSpare)
+	landMutateCalc(t, prime, calcClamp, calcScale, calcTally, calcHoard, calcSpare)
+	var built bytes.Buffer
+	if code := clihelp.ExecuteIn(Command(), prime, &built, []string{"test", "--wait", "--map", "calc", "other"}); code != 0 {
+		t.Fatalf("test --wait --map calc other = %d, %s; want exit 0", code, built.Bytes())
+	}
+
+	final := mutateCalcAt(calcClamp, calcScale, calcTally, calcHoard, calcSpare)
+	scaleLimit, scaleIf := lineOf(t, final, "limit := 100"), lineOf(t, final, "if n > limit {")
+	tallyDrop, hoardLoop, spareReturn := lineOf(t, final, "n -= 1"), lineOf(t, final, "for i := 1; i <= n; i++ {"), lineOf(t, final, "return n + 5")
+
+	refusals := []struct {
+		name      string
+		cwd       string
+		args      []string
+		wantError string
+		// wantWayForward is the text the error's way forward must name.
+		wantWayForward string
+	}{
+		{name: "OutsideEveryHub", cwd: t.TempDir(), args: []string{"mutate"}, wantError: "is in no hub", wantWayForward: "run lym gate mutate from a worktree of the hub"},
+		{name: "APrimeWithNoBase", cwd: prime, args: []string{"mutate"}, wantError: "no parent branch", wantWayForward: "pass --base"},
+		{name: "ABaseNamingNoCommit", cwd: prime, args: []string{"mutate", "--base", "no-such-commit"}, wantError: "names no commit", wantWayForward: "pass the SHA of a commit"},
+	}
+	for _, tt := range refusals {
+		t.Run("Refuses"+tt.name, func(t *testing.T) {
+			code, answer := runMutateVerb(t, Command(), tt.cwd, tt.args...)
+			_, wayForward, _ := strings.Cut(answer.Error, "way forward:")
+			if code != 1 || answer.OK || !strings.Contains(answer.Error, tt.wantError) || !strings.Contains(wayForward, tt.wantWayForward) {
+				t.Errorf("lym gate %v = exit %d, ok %v, error %q; want exit 1 with %q and a way forward naming %q",
+					tt.args, code, answer.OK, answer.Error, tt.wantError, tt.wantWayForward)
+			}
+		})
+	}
+
+	t.Run("AHubWhoseScoperIsNotGoPrintsItsNoteAndExitsZero", func(t *testing.T) {
+		other := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+		otherPrime := seedTestMapModule(t, other, mutateModule, strings.Replace(mutateGate(""), "scoper: go", "scoper: none", 1),
+			map[string]map[string]int{"calc": nil})
+		code, answer := runMutateVerb(t, Command(), otherPrime, "mutate")
+		requireMutateAnswer(t, code, answer)
+		if !strings.Contains(answer.Note, "the hub's scoper is none, not go") {
+			t.Errorf("lym gate mutate note = %q; want one naming the scoper", answer.Note)
+		}
+	})
+
+	t.Run("ChangedConditionIsKilledByTheFirstCoveringTestAndTheSecondDoesNotRun", func(t *testing.T) {
+		setGate("")
+		code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", afterScale)
+		requireMutateAnswer(t, code, answer)
+		// Clamp alone changed since afterScale: its condition and its constant, each killed by one run.
+		// Both tests of Clamp cover each mutant's block, so a second run would show in the count.
+		want := mutateCounts{Run: 2, Killed: 2}
+		if answer.Mutants != want || answer.Runs != 2 || len(answer.Survivors) != 0 || len(answer.UnjudgedMutants) != 0 || len(answer.NotJudged) != 0 {
+			t.Errorf("lym gate mutate --base afterScale = %+v, %d runs, survivors %v, unjudged %v, not judged %v; want %+v from 2 runs and nothing else",
+				answer.Mutants, answer.Runs, answer.Survivors, answer.UnjudgedMutants, answer.NotJudged, want)
+		}
+	})
+
+	t.Run("ABaseBeforeAnEarlierLandingJudgesItsChangeToo", func(t *testing.T) {
+		setGate("")
+		code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", afterTallyHoardSpare)
+		requireMutateAnswer(t, code, answer)
+		// Scale joins Clamp: its two mutants survive, since TestScaleRuns runs Scale and checks nothing.
+		want := mutateCounts{Run: 4, Killed: 2, Survived: 2}
+		if answer.Mutants != want || !slices.Equal(survivorLines(answer), []int{scaleLimit, scaleIf}) {
+			t.Fatalf("lym gate mutate --base afterTallyHoardSpare = %+v, survivors on lines %v; want %+v and survivors on lines %v",
+				answer.Mutants, survivorLines(answer), want, []int{scaleLimit, scaleIf})
+		}
+		for i, operator := range []string{testcover.OperatorChangeConstant, testcover.OperatorNegateCondition} {
+			survivor := answer.Survivors[i]
+			if survivor.File != "calc/calc.go" || survivor.Function != "Scale" || survivor.Operator != operator ||
+				!slices.Equal(survivor.PossibleKillers, []string{"other.TestOtherCalls"}) {
+				t.Errorf("survivor %d = %+v; want %s in calc/calc.go's Scale with the other package's TestOtherCalls as possible killer", i, survivor, operator)
+			}
+		}
+	})
+
+	var planned int
+	t.Run("AWholeDiffKillsSurvivesAndLeavesUnjudgedTheMutantsOfTheMapsTests", func(t *testing.T) {
+		setGate("")
+		code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", seed)
+		requireMutateAnswer(t, code, answer)
+		// Clamp's two mutants and Tally's condition, constant and dropped increment die.
+		// Scale's two survive.
+		// Tally's dropped decrement ends endless at the time bound and Hoard's negated loop at the memory cap.
+		want := mutateCounts{Run: 9, Killed: 5, Survived: 2, Unjudged: 2}
+		if answer.Mutants != want || !slices.Equal(survivorLines(answer), []int{scaleLimit, scaleIf}) {
+			t.Errorf("lym gate mutate --base seed = %+v, survivors on lines %v; want %+v and survivors on lines %v",
+				answer.Mutants, survivorLines(answer), want, []int{scaleLimit, scaleIf})
+		}
+		planned = answer.Mutants.Run
+		if reason := unjudgedAt(answer, tallyDrop); !strings.Contains(reason, "time bound") {
+			t.Errorf("the dropped decrement on line %d is unjudged for %q; want its time bound", tallyDrop, reason)
+		}
+		if reason := unjudgedAt(answer, hoardLoop); !strings.Contains(reason, "memory cap") {
+			t.Errorf("the negated loop on line %d is unjudged for %q; want the memory cap", hoardLoop, reason)
+		}
+		// Nothing runs Spare, so its changed block is uncovered and holds no mutant.
+		if !slices.Contains(answer.UncoveredBlocks, mutateUncoveredBlock{Package: "calc", File: "calc.go", Function: "Spare"}) {
+			t.Errorf("lym gate mutate uncovered blocks = %v; want Spare's", answer.UncoveredBlocks)
+		}
+		if reason := unjudgedAt(answer, spareReturn); reason != "" || slices.Contains(survivorLines(answer), spareReturn) {
+			t.Errorf("lym gate mutate places a mutant on line %d of the uncovered Spare", spareReturn)
+		}
+	})
+
+	t.Run("ADiffThatChangesNoFunctionPrintsItsNoteAndMutatesNothing", func(t *testing.T) {
+		setGate("")
+		code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", gitkit.RevParse(t, prime, "HEAD"))
+		requireMutateAnswer(t, code, answer)
+		if !strings.Contains(answer.Note, "the diff changes no function") || answer.Mutants != (mutateCounts{}) || answer.Runs != 0 {
+			t.Errorf("lym gate mutate --base HEAD = note %q, %+v, %d runs; want the changes-no-function note and no mutant", answer.Note, answer.Mutants, answer.Runs)
+		}
+	})
+
+	t.Run("APrimeWhoseSharedMapNoLongerMatchesItsFilesIsNotJudgedWithItsReason", func(t *testing.T) {
+		setGate("")
+		editMutateCalc(t, prime, "return n + 5", "return n + 6")
+		t.Cleanup(func() { gitkit.Git(t, prime, "checkout", "--", "calc/calc.go") })
+		code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", seed)
+		requireMutateAnswer(t, code, answer)
+		if len(answer.NotJudged) != 1 || answer.NotJudged[0].Package != "calc" || answer.NotJudged[0].Reason != reasonSharedMapStale ||
+			answer.Mutants != (mutateCounts{}) {
+			t.Errorf("lym gate mutate = %+v, not judged %+v; want calc not judged for %q and no mutant", answer.Mutants, answer.NotJudged, reasonSharedMapStale)
+		}
+	})
+
+	capRows := []struct {
+		name  string
+		max   string
+		base  string
+		want  mutateCounts
+		lines []int
+	}{
+		{name: "ACapOfOneRunsOneMutant", max: "1", base: seed, want: mutateCounts{Run: 1, Killed: 1}},
+		{name: "ACapOfTwoOverTwoChangedFunctionsPlansOneMutantInEach", max: "2", base: afterTallyHoardSpare, want: mutateCounts{Run: 2, Killed: 1, Survived: 1}, lines: []int{scaleLimit}},
+	}
+	for _, tt := range capRows {
+		t.Run(tt.name, func(t *testing.T) {
+			setGate("mutation_max_mutants: " + tt.max + "\n")
+			code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", tt.base)
+			requireMutateAnswer(t, code, answer)
+			// Every planned mutant that the cap leaves out is counted not run.
+			wantAll := mutateCounts{Run: tt.want.Run, Killed: tt.want.Killed, Survived: tt.want.Survived}
+			notRun := answer.Mutants.NotRun
+			answer.Mutants.NotRun = 0
+			if answer.Mutants != wantAll || !slices.Equal(survivorLines(answer), tt.lines) || notRun == 0 {
+				t.Errorf("lym gate mutate under a cap of %s = %+v, %d not run, survivors on lines %v; want %+v, some not run and survivors on lines %v",
+					tt.max, answer.Mutants, notRun, survivorLines(answer), wantAll, tt.lines)
+			}
+			if tt.max == "1" && notRun != planned-1 {
+				t.Errorf("lym gate mutate under a cap of 1 leaves %d mutants not run; want the other %d of the whole diff", notRun, planned-1)
+			}
+		})
+	}
+	setGate("")
+
+	// The pair starts at the prime's last landing and lands one change of its own.
+	gitkit.Git(t, pair, "merge", "--ff-only", "-q", "main")
+	editMutateCalc(t, pair, "\t\treturn 0\n", "\t\treturn 0 // clamped\n")
+	gitkit.Git(t, pair, "commit", "-q", "-a", "-m", "annotate clamp")
+
+	t.Run("APackageWithAnUncommittedFileIsNotJudgedWithItsReason", func(t *testing.T) {
+		editMutateCalc(t, pair, "\t\treturn 0 // clamped\n", "\t\treturn 0 // clamped, edited\n")
+		t.Cleanup(func() { gitkit.Git(t, pair, "checkout", "--", "calc/calc.go") })
+		code, answer := runMutateVerb(t, Command(), pair, "mutate")
+		requireMutateAnswer(t, code, answer)
+		if len(answer.NotJudged) != 1 || answer.NotJudged[0].Package != "calc" ||
+			!strings.Contains(answer.NotJudged[0].Reason, "uncommitted file") || !strings.Contains(answer.NotJudged[0].Reason, "commit it") ||
+			answer.Mutants != (mutateCounts{}) {
+			t.Errorf("lym gate mutate = %+v, not judged %+v; want calc not judged for its uncommitted file and no mutant", answer.Mutants, answer.NotJudged)
+		}
+	})
+
+	t.Run("APackageWithAStaleWorktreeMapAndCommittedFilesIsRefreshedThenJudged", func(t *testing.T) {
+		code, answer := runMutateVerb(t, Command(), pair, "mutate")
+		requireMutateAnswer(t, code, answer)
+		want := mutateCounts{Run: 1, Killed: 1}
+		if answer.Mutants != want || len(answer.NotJudged) != 0 || len(answer.Survivors) != 0 {
+			t.Errorf("lym gate mutate = %+v, not judged %+v, survivors %v; want calc refreshed and its one mutant killed: %+v",
+				answer.Mutants, answer.NotJudged, answer.Survivors, want)
+		}
+	})
+
+	t.Run("MutantsPlannedPastMutationBudgetAreUnjudgedAndCounted", func(t *testing.T) {
+		// The budget and the coverage build's bound share one minute unit.
+		// A millisecond makes the budget one millisecond and the bound 100 seconds.
+		// So the build finishes and the mutants are planned before the spent budget leaves them unjudged.
+		setGate("mutation_budget_min: 1\nredundancy_build_timeout_min: 100000\n")
+		t.Cleanup(func() { setGate("") })
+		code, answer := runMutateVerb(t, mutateCmd(defaultGoBinary, time.Millisecond, defaultPipeWaitDelay), pair)
+		requireMutateAnswer(t, code, answer)
+		if answer.Mutants != (mutateCounts{Unjudged: 1}) || len(answer.UnjudgedMutants) != 1 ||
+			!strings.Contains(answer.UnjudgedMutants[0].Reason, "mutation_budget_min") {
+			t.Errorf("lym gate mutate = %+v, unjudged %+v; want the one planned mutant unjudged for mutation_budget_min", answer.Mutants, answer.UnjudgedMutants)
+		}
+	})
+
+	t.Run("APackageWithAStaleWorktreeMapIsNotJudgedPastReachBudget", func(t *testing.T) {
+		editMutateCalc(t, pair, "\t\treturn 0 // clamped\n", "\t\treturn 0 // clamped again\n")
+		gitkit.Git(t, pair, "commit", "-q", "-a", "-m", "annotate clamp again")
+		// A nanosecond minute spends the budget at the hold, before the refresh starts any package.
+		code, answer := runMutateVerb(t, mutateCmd(defaultGoBinary, time.Nanosecond, defaultPipeWaitDelay), pair)
+		requireMutateAnswer(t, code, answer)
+		if len(answer.NotJudged) != 1 || answer.NotJudged[0].Package != "calc" || !strings.Contains(answer.NotJudged[0].Reason, "reach_budget_min") ||
+			answer.Mutants != (mutateCounts{}) {
+			t.Errorf("lym gate mutate = %+v, not judged %+v; want calc not judged past reach_budget_min and no mutant", answer.Mutants, answer.NotJudged)
+		}
+	})
+
+	t.Run("APrimePackageWithNoMapIsNotJudgedAndAMutantTheCompilerRefusesIsCountedUnbuildable", func(t *testing.T) {
+		base := gitkit.RevParse(t, prime, "HEAD")
+		// Half's integer constant sits in a float context, where its mutant does not compile.
+		plankit.WriteTree(t, prime, map[string]string{
+			"unmapped/unmapped.go": "package unmapped\n\nfunc Value() int { return 1 }\n",
+			"ratio/ratio.go":       "package ratio\n\nfunc Half() float64 {\n\treturn 3\n}\n",
+			"ratio/ratio_test.go": "package ratio\n\nimport (\n\t\"testing\"\n\n\t\"github.com/Knatte18/loomyard/internal/testkit/tiergate\"\n)\n\n" +
+				"func TestHalfChecked(t *testing.T) {\n\ttiergate.Require(t, 0)\n\tif Half() != 3 {\n\t\tt.Fatal(\"Half() != 3\")\n\t}\n}\n",
+		})
+		gitkit.Git(t, prime, "add", "unmapped", "ratio")
+		gitkit.Git(t, prime, "commit", "-q", "-m", "land unmapped and ratio")
+		var built bytes.Buffer
+		if code := clihelp.ExecuteIn(Command(), prime, &built, []string{"test", "--wait", "--map", "ratio"}); code != 0 {
+			t.Fatalf("test --wait --map ratio = %d, %s; want exit 0", code, built.Bytes())
+		}
+
+		code, answer := runMutateVerb(t, Command(), prime, "mutate", "--base", base)
+		requireMutateAnswer(t, code, answer)
+		if !slices.Contains(answer.NotJudged, mutateNotJudged{Package: "unmapped", Reason: reasonNoMapToMutate}) {
+			t.Errorf("lym gate mutate not judged = %+v; want unmapped for %q", answer.NotJudged, reasonNoMapToMutate)
+		}
+		if answer.Mutants.Unbuildable != 1 {
+			t.Errorf("lym gate mutate mutants = %+v; want the one mutant of Half counted unbuildable", answer.Mutants)
+		}
+	})
+}
diff --git a/internal/gatecli/mutatecheck.go b/internal/gatecli/mutatecheck.go
new file mode 100644
index 00000000..00e42123
--- /dev/null
+++ b/internal/gatecli/mutatecheck.go
@@ -0,0 +1,473 @@
+// mutatecheck.go runs the mutation check of `lym gate mutate` over the changed packages of a diff.
+// It plans the mutants of each package's changed lines against the blocks its map's tests cover.
+// It spreads the mutant cap over the changed functions in turn.
+// It runs each mutant against the map's tests that cover its block until one fails.
+
+package gatecli
+
+import (
+	"cmp"
+	"errors"
+	"fmt"
+	"maps"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testreach"
+)
+
+// Reasons a mutant is left unjudged.
+const (
+	reasonMutantBudget       = "past mutation_budget_min; way forward: run the verb again, or raise mutation_budget_min with lym config gate from the prime"
+	reasonMutantTimedOut     = "a covering test ran past its time bound with the mutant on"
+	reasonMutantMemoryCapped = "a covering test ended at the memory cap with the mutant on"
+	reasonMutantGuardKilled  = "the memory guard killed a covering test's run with the mutant on"
+	reasonMutantBuild        = "the package's mutant binary did not build: %v"
+)
+
+// mutateMutant names one mutant by its worktree-relative file, line, operator and function.
+type mutateMutant struct {
+	File     string `json:"file"`
+	Line     int    `json:"line"`
+	Operator string `json:"operator"`
+	Function string `json:"function"`
+}
+
+// mutateSurvivor is a mutant every covering test passed.
+type mutateSurvivor struct {
+	mutateMutant
+	// PossibleKillers are the tests of other packages that the maps show reach the mutant's function, a fixed number at most.
+	// They are not run.
+	PossibleKillers []string `json:"possible_killers"`
+	// MorePossibleKillers counts those left out.
+	MorePossibleKillers int `json:"more_possible_killers,omitempty"`
+}
+
+// mutateUnjudgedMutant is a mutant no verdict was reached for, with why.
+type mutateUnjudgedMutant struct {
+	mutateMutant
+	Reason string `json:"reason"`
+}
+
+// mutateUncoveredBlock is a changed block no test of its package's map covers.
+type mutateUncoveredBlock struct {
+	Package  string `json:"package"`
+	File     string `json:"file"`
+	Function string `json:"function"`
+}
+
+// mutateNotJudged is a changed package the check judged nothing of, with why.
+type mutateNotJudged struct {
+	Package string `json:"package"`
+	Reason  string `json:"reason"`
+}
+
+// mutateCounts is how many mutants the check planned, ran and decided.
+type mutateCounts struct {
+	// Run counts the mutants a covering test started on.
+	Run int `json:"run"`
+	// Killed and Survived count the mutants decided, and Unjudged those left without a verdict, run or not.
+	Killed   int `json:"killed"`
+	Survived int `json:"survived"`
+	Unjudged int `json:"unjudged"`
+	// Unbuildable counts the mutants dropped for a compile error.
+	Unbuildable int `json:"unbuildable"`
+	// NotRun counts the mutants over mutation_max_mutants.
+	NotRun int `json:"not_run"`
+}
+
+// mutateOutcome is what a diffMutation found.
+type mutateOutcome struct {
+	survivors []mutateSurvivor
+	unjudged  []mutateUnjudgedMutant
+	uncovered []mutateUncoveredBlock
+	// notJudged are the packages the check could not plan.
+	notJudged []mutateNotJudged
+	counts    mutateCounts
+	// runs counts the test processes the check started.
+	runs int
+}
+
+// newMutateOutcome returns an outcome whose lists are empty rather than nil, so each prints as a JSON list.
+func newMutateOutcome() mutateOutcome {
+	return mutateOutcome{
+		survivors: []mutateSurvivor{}, unjudged: []mutateUnjudgedMutant{}, uncovered: []mutateUncoveredBlock{}, notJudged: []mutateNotJudged{},
+	}
+}
+
+// mutantFate is what the covering tests decided about one mutant.
+type mutantFate int
+
+const (
+	fateSurvived mutantFate = iota
+	fateKilled
+	fateUnjudged
+)
+
+// mutantVerdict is the outcome of running one mutant against the tests that cover its block.
+type mutantVerdict struct {
+	fate mutantFate
+	// reason says why an unjudged mutant is.
+	reason string
+	// killer is the index among the mutant's covering tests of the test that killed it.
+	killer int
+}
+
+// coveringTest is a test of a package's map that can kill a mutant, with the blocks it covers.
+type coveringTest struct {
+	test   testcover.MapTest
+	blocks testcover.BlockSet
+}
+
+// mutatedPackage is one changed package with a fresh map, its planned mutants and the tests that can kill them.
+type mutatedPackage struct {
+	pkg   string
+	check *mutationCheck
+	// tests are the map's tests with a passing measurement whose check does not read source files, the fastest first.
+	tests     []coveringTest
+	plan      *testcover.MutantPlan
+	uncovered []testcover.BlockKey
+	// selected holds the IDs of the mutants the cap took.
+	selected map[int]bool
+}
+
+// covering returns the tests whose blocks hold one of the mutant's, the fastest first.
+func (p *mutatedPackage) covering(mutant testcover.Mutant) []coveringTest {
+	var covering []coveringTest
+	for _, candidate := range p.tests {
+		if mutant.InBlocks(candidate.blocks) {
+			covering = append(covering, candidate)
+		}
+	}
+	return covering
+}
+
+// diffMutation is one `lym gate mutate` call's mutation check over the changed packages that have a fresh map.
+type diffMutation struct {
+	// holder is the check that holds the call's slot; each package's check is a copy of it.
+	holder *mutationCheck
+	module goModule
+	// reader names the tests of other packages that reach a survivor's function.
+	reader *testreach.Reader
+	// fresh holds the fresh map of each package to judge, by module-relative path.
+	fresh map[string]testcover.Map
+	// changedLines holds the changed line numbers of each changed file, by module-relative package and file name.
+	changedLines map[string]map[string][]int
+	// maxMutants caps the mutants the call runs, and budget bounds the time from the slot's hold.
+	maxMutants int
+	budget     time.Duration
+	// deadline is when the budget is spent, set once the slot is held.
+	deadline time.Time
+	// runs counts the test processes the check started.
+	runs    atomic.Int64
+	outcome mutateOutcome
+}
+
+// run judges every package of the fresh maps inside one gate slot and returns what it found.
+// It waits for the slot, plans every package whatever the budget, takes the mutants the cap allows, and runs them.
+// The error reports a slot, build or run failure, or the context's error once the call is cancelled.
+func (d *diffMutation) run() (mutateOutcome, error) {
+	if err := d.holder.holdSlot(); err != nil {
+		return mutateOutcome{}, err
+	}
+	d.deadline = time.Now().Add(d.budget)
+	var planned []*mutatedPackage
+	for i, pkg := range slices.Sorted(maps.Keys(d.fresh)) {
+		judged, err := d.planPackage(i, pkg)
+		if ctxErr := d.holder.ctx.Err(); ctxErr != nil {
+			return mutateOutcome{}, ctxErr
+		}
+		if err != nil {
+			reason := fmt.Sprintf("%v; way forward: fix the failure it names, then run the verb again", err)
+			d.outcome.notJudged = append(d.outcome.notJudged, mutateNotJudged{Package: pkg, Reason: reason})
+			continue
+		}
+		planned = append(planned, judged)
+		for _, key := range judged.uncovered {
+			d.outcome.uncovered = append(d.outcome.uncovered, mutateUncoveredBlock{Package: pkg, File: key.File, Function: key.Func})
+		}
+	}
+	d.selectWithinCap(planned)
+	for _, judged := range planned {
+		if err := d.runPackage(judged); err != nil {
+			return mutateOutcome{}, err
+		}
+	}
+	d.outcome.runs = int(d.runs.Load())
+	return d.outcome, nil
+}
+
+// planPackage builds the coverage binary of the package pkg and plans the mutants of its changed lines.
+// The mutants land in the blocks the package's map covers with the tests that can kill one.
+// index tells the package's place in the call, which names its directory under the check's.
+func (d *diffMutation) planPackage(index int, pkg string) (*mutatedPackage, error) {
+	m := d.fresh[pkg]
+	sourceChecks, err := sourceCheckingTests(d.holder.location.WorktreePath(), d.module, pkg)
+	if err != nil {
+		return nil, fmt.Errorf("the source scan failed: %w", err)
+	}
+	check := *d.holder
+	check.lease = nil
+	check.pkgDir = filepath.Join(d.module.dir, filepath.FromSlash(pkg))
+	check.importPath = d.module.importPath(pkg)
+	check.tmp = filepath.Join(d.holder.tmp, strconv.Itoa(index))
+	if err := os.MkdirAll(check.tmp, 0o755); err != nil {
+		return nil, err
+	}
+	judged := &mutatedPackage{pkg: pkg, check: &check}
+	covered := testcover.BlockSet{}
+	for _, test := range m.Tests {
+		if !test.Measured() || sourceChecks[test.Name] {
+			continue
+		}
+		blocks := mapBlocksOf(m, test)
+		judged.tests = append(judged.tests, coveringTest{test: test, blocks: blocks})
+		maps.Copy(covered, blocks)
+	}
+	slices.SortFunc(judged.tests, func(a, b coveringTest) int {
+		return cmp.Or(cmp.Compare(a.test.Seconds, b.test.Seconds), strings.Compare(a.test.Name, b.test.Name))
+	})
+	profile, err := check.profileBlocks()
+	if err != nil {
+		return nil, err
+	}
+	if judged.plan, judged.uncovered, err = testcover.PlanLineMutants(check.pkgDir, check.importPath, profile, d.changedLines[pkg], covered); err != nil {
+		return nil, fmt.Errorf("plan the mutants: %w", err)
+	}
+	return judged, nil
+}
+
+// selectWithinCap takes up to maxMutants of the planned mutants, one changed function at a time in turn.
+// The functions go in the order of their package, file and name, and a function's mutants in the order of its plan.
+// The mutants left over count as not run.
+func (d *diffMutation) selectWithinCap(planned []*mutatedPackage) {
+	type group struct {
+		judged   *mutatedPackage
+		file     string
+		function string
+		ids      []int
+	}
+	var groups []group
+	total := 0
+	for _, judged := range planned {
+		judged.selected = map[int]bool{}
+		byFunction := map[[2]string][]int{}
+		for _, mutant := range judged.plan.Mutants {
+			key := [2]string{mutant.File, mutant.FuncOf()}
+			byFunction[key] = append(byFunction[key], mutant.ID)
+			total++
+		}
+		for key, ids := range byFunction {
+			groups = append(groups, group{judged: judged, file: key[0], function: key[1], ids: ids})
+		}
+	}
+	slices.SortFunc(groups, func(a, b group) int {
+		return cmp.Or(strings.Compare(a.judged.pkg, b.judged.pkg), strings.Compare(a.file, b.file), strings.Compare(a.function, b.function))
+	})
+	taken := 0
+	for round := 0; taken < d.maxMutants; round++ {
+		progressed := false
+		for _, g := range groups {
+			if round < len(g.ids) && taken < d.maxMutants {
+				g.judged.selected[g.ids[round]] = true
+				taken++
+				progressed = true
+			}
+		}
+		if !progressed {
+			break
+		}
+	}
+	d.outcome.counts.NotRun = total - taken
+}
+
+// runPackage builds one binary holding the package's selected mutants and judges each against its covering tests.
+// Past the budget it starts no build and leaves every mutant unjudged for it.
+// A build that fails leaves the package's mutants unjudged for that.
+// The error reports a failed `lym` build or test start, or the context's error once the call is cancelled.
+func (d *diffMutation) runPackage(judged *mutatedPackage) error {
+	check := judged.check
+	judged.plan.Mutants = slices.DeleteFunc(judged.plan.Mutants, func(m testcover.Mutant) bool { return !judged.selected[m.ID] })
+	if len(judged.plan.Mutants) == 0 {
+		return nil
+	}
+	if !time.Now().Before(d.deadline) {
+		for _, mutant := range judged.plan.Mutants {
+			d.recordUnjudged(judged, mutant, reasonMutantBudget)
+		}
+		return nil
+	}
+	bin, dropped, err := check.buildMutants(judged.plan)
+	if err != nil {
+		if ctxErr := check.ctx.Err(); ctxErr != nil {
+			return ctxErr
+		}
+		for _, mutant := range judged.plan.Mutants {
+			d.recordUnjudged(judged, mutant, fmt.Sprintf(reasonMutantBuild, err))
+		}
+		return nil
+	}
+	d.outcome.counts.Unbuildable += len(dropped)
+	check.mutants = map[int]testcover.Mutant{}
+	var built []testcover.Mutant
+	for _, mutant := range judged.plan.Mutants {
+		if !dropped[mutant.ID] {
+			check.mutants[mutant.ID] = mutant
+			built = append(built, mutant)
+		}
+	}
+	coverings := make([][]coveringTest, len(built))
+	entries := map[string]testcover.MapTest{}
+	var names []string
+	for i, mutant := range built {
+		coverings[i] = judged.covering(mutant)
+		for _, covering := range coverings[i] {
+			entries[covering.test.Name] = covering.test
+			names = append(names, covering.test.Name)
+		}
+	}
+	if err := check.buildLymFor(names, entries); err != nil {
+		return err
+	}
+	verdicts, err := d.judgeMutants(check, bin, built, coverings)
+	if err != nil {
+		return err
+	}
+	for i, mutant := range built {
+		d.record(judged, mutant, verdicts[i])
+	}
+	return nil
+}
+
+// judgeMutants runs each of built against its covering tests, up to the check's sideBySide mutants at once.
+// A kill made beside other runs is run again alone.
+// A killer that then passes sends the mutant on to its next covering test.
+func (d *diffMutation) judgeMutants(check *mutationCheck, bin string, built []testcover.Mutant, coverings [][]coveringTest) ([]mutantVerdict, error) {
+	verdicts := make([]mutantVerdict, len(built))
+	errs := make([]error, len(built))
+	indexes := make(chan int)
+	var workers sync.WaitGroup
+	for range min(check.sideBySide, len(built)) {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for i := range indexes {
+				verdicts[i], errs[i] = d.scan(check, bin, built[i], coverings[i], 0)
+			}
+		}()
+	}
+	for i := range built {
+		indexes <- i
+	}
+	close(indexes)
+	workers.Wait()
+	if err := errors.Join(errs...); err != nil {
+		return nil, err
+	}
+	if check.sideBySide < 2 {
+		return verdicts, nil
+	}
+	for i, verdict := range verdicts {
+		if verdict.fate != fateKilled {
+			continue
+		}
+		again, err := d.scan(check, bin, built[i], coverings[i], verdict.killer)
+		if err != nil {
+			return nil, err
+		}
+		verdicts[i] = again
+	}
+	return verdicts, nil
+}
+
+// scan runs the covering tests of the mutant from index from on, each alone in its own process with the mutant on.
+// It stops at the first test that fails for a reason of its own: that test kills the mutant.
+// A run past its time bound, at the memory cap or killed by the memory guard kills nothing, and neither does a pass.
+// Past the budget it starts no further run.
+// The error reports a test binary that did not start.
+func (d *diffMutation) scan(check *mutationCheck, bin string, mutant testcover.Mutant, covering []coveringTest, from int) (mutantVerdict, error) {
+	stopped := ""
+	for i := from; i < len(covering); i++ {
+		if !time.Now().Before(d.deadline) {
+			stopped = reasonMutantBudget
+			break
+		}
+		job := mutantJob{test: covering[i].test, mutant: mutant.ID, timeout: check.mutantTimeout(covering[i].test.Seconds)}
+		result, err := check.runJob(bin, job)
+		d.runs.Add(1)
+		if err != nil {
+			return mutantVerdict{}, err
+		}
+		switch {
+		case result.Action != testcover.ActionFail:
+		case result.GuardKilled:
+			stopped = reasonMutantGuardKilled
+		case result.MemoryCapped:
+			stopped = reasonMutantMemoryCapped
+		case result.TimedOut:
+			stopped = reasonMutantTimedOut
+		default:
+			return mutantVerdict{fate: fateKilled, killer: i}, nil
+		}
+	}
+	if stopped != "" {
+		return mutantVerdict{fate: fateUnjudged, reason: stopped}, nil
+	}
+	return mutantVerdict{fate: fateSurvived}, nil
+}
+
+// record adds the verdict of a mutant that was run, or left unrun for the budget, to the outcome.
+func (d *diffMutation) record(judged *mutatedPackage, mutant testcover.Mutant, verdict mutantVerdict) {
+	counts := &d.outcome.counts
+	switch verdict.fate {
+	case fateKilled:
+		counts.Run++
+		counts.Killed++
+	case fateSurvived:
+		counts.Run++
+		counts.Survived++
+		d.outcome.survivors = append(d.outcome.survivors, d.survivor(judged, mutant))
+	default:
+		if verdict.reason != reasonMutantBudget {
+			counts.Run++
+		}
+		d.recordUnjudged(judged, mutant, verdict.reason)
+	}
+}
+
+// recordUnjudged adds a mutant left without a verdict to the outcome.
+func (d *diffMutation) recordUnjudged(judged *mutatedPackage, mutant testcover.Mutant, reason string) {
+	d.outcome.counts.Unjudged++
+	d.outcome.unjudged = append(d.outcome.unjudged, mutateUnjudgedMutant{mutateMutant: d.site(judged, mutant), Reason: reason})
+}
+
+// site names the mutant by its worktree-relative file, line, operator and function.
+func (d *diffMutation) site(judged *mutatedPackage, mutant testcover.Mutant) mutateMutant {
+	return mutateMutant{
+		File: path.Join(packageDirOf(d.module.rel, judged.pkg), mutant.File), Line: mutant.Line, Operator: mutant.Operator, Function: mutant.FuncOf(),
+	}
+}
+
+// survivor returns the survivor entry of a mutant, with the tests of other packages that reach its function.
+func (d *diffMutation) survivor(judged *mutatedPackage, mutant testcover.Mutant) mutateSurvivor {
+	entry := mutateSurvivor{mutateMutant: d.site(judged, mutant), PossibleKillers: []string{}}
+	reaches := d.reader.TestsReaching(testcover.FuncKey{Package: judged.check.importPath, File: mutant.File, Func: mutant.FuncOf()})
+	for _, reach := range reaches {
+		switch {
+		case reach.Own:
+		case len(entry.PossibleKillers) == maxReachTestsPerFunction:
+			entry.MorePossibleKillers++
+		default:
+			entry.PossibleKillers = append(entry.PossibleKillers, d.module.relativePackage(reach.Package)+"."+reach.Test)
+		}
+	}
+	return entry
+}
diff --git a/internal/gatecli/reach.go b/internal/gatecli/reach.go
new file mode 100644
index 00000000..d190e044
--- /dev/null
+++ b/internal/gatecli/reach.go
@@ -0,0 +1,465 @@
+// reach.go runs the reach report step a `--gate` key's reports list names, after the call's lints.
+// It finds the functions the worktree's diff changes and refreshes the worktree's own coverage maps of their packages.
+// It records the tests that reach each function, or the caveats of a function none reaches.
+// It writes its report and prints its note; nothing it meets changes the call's result.
+
+package gatecli
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"maps"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/impactset"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testreach"
+)
+
+// Notes and reasons of the reach report beside those the redundancy report shares.
+const (
+	noteNoMaps             = "no coverage map exists, so the step judged nothing; way forward: build the maps with `lym gate test --map` from the prime"
+	reasonPrimeKeepsNoMaps = "the call runs in the prime, which keeps no worktree maps; way forward: rebuild the shared maps with `lym gate test --map`"
+	reasonMapRunRefused    = "the map run could not start, as its error line says"
+	reasonNoRefreshSlot    = "the step took no gate slot, as its error line says"
+	reasonRefreshEnded     = "the refresh ended before it reached it, as its error line says"
+	reasonHeadUnreadable   = "HEAD could not be read, as its error line says; way forward: run the gate again"
+	reasonMapCheckFailed   = "its map or files could not be checked, as its error line says; way forward: run the gate again"
+)
+
+// reachStep is one call's reach report step, with what it reads from the call.
+type reachStep struct {
+	ctx      context.Context
+	stderr   io.Writer
+	cfg      gateslot.Config
+	location *lymcwd.Location
+	// root is the worktree root, and gateKey the key whose call runs the step.
+	root, gateKey string
+	// environ is the environment the refresh's map run starts its children from: the process's own in production.
+	environ []string
+	// goBinary is the go command the refresh's builds run.
+	goBinary string
+	// minuteUnit is the length of one minute of reach_budget_min and redundancy_build_timeout_min.
+	// secondUnit is the length of one second of redundancy_test_timeout_sec.
+	minuteUnit, secondUnit time.Duration
+	// grace bounds the wait for a killed build's or test's exit and output.
+	grace time.Duration
+	// guardKilled reports whether the memory guard killed the process with a pid; nil means it killed none.
+	guardKilled func(pid int) bool
+}
+
+// reachStep returns the reach report step of the call e runs.
+func (e *execution) reachStep() reachStep {
+	return reachStep{
+		ctx: e.ctx, stderr: e.request.stderr, cfg: e.cfg, location: e.location, root: e.request.root, gateKey: e.request.gate,
+		environ: os.Environ(), goBinary: e.request.goBinary,
+		minuteUnit: e.request.timeoutUnit, secondUnit: e.request.secondUnit, grace: e.request.pipeWaitDelay,
+	}
+}
+
+// run writes the step's report into the worktree's gate directory and prints its note to stderr.
+// red tells a call one of whose runs failed, and inHub a call inside a hub; either way the report then judges nothing.
+// A report the step cannot write is logged at Warn, and the call's result stands.
+func (s reachStep) run(red, inHub bool) {
+	path := reachReportPath(s.location)
+	var report ReachReport
+	switch {
+	case red:
+		report = ReachReport{RedGate: true, Note: noteRedGate}
+	case !inHub:
+		report = ReachReport{Note: noteNoHub}
+	case s.cfg.Scoper != "go":
+		report = ReachReport{Note: fmt.Sprintf(noteScoper, s.cfg.Scoper)}
+	default:
+		report = s.answer()
+	}
+	report.GateKey = s.gateKey
+	report.Written = time.Now()
+	if err := state.WriteJSON(path, lock.TrackedFileLockPath(path, ".lock"), report); err != nil {
+		logger.Warn("gate test: could not write the reach report; the gate's result stands", "path", path, "cause", err)
+		return
+	}
+	for _, line := range report.NoteLines(path) {
+		printLine(s.stderr, line)
+	}
+}
+
+// answer returns the report for the worktree's diff.
+// The diff is from the merge base with the parent branch.
+// The prime has none, so it is the working tree's changes from HEAD.
+// A task worktree with no parent branch gets a report that judges nothing.
+func (s reachStep) answer() ReachReport {
+	var report ReachReport
+	module, err := redundancyModule(s.cfg, s.root)
+	if err != nil {
+		report.Errors = append(report.Errors, err.Error())
+		return report
+	}
+	report.ModuleDir = module.rel
+	fabric, err := fabricengine.Open(s.location)
+	if err != nil {
+		report.Errors = append(report.Errors, err.Error())
+		return report
+	}
+	prime, err := hubgeom.IsPrime(s.location)
+	if err != nil {
+		report.Errors = append(report.Errors, err.Error())
+		return report
+	}
+	report.Prime = prime
+	base, err := s.diffBase(fabric, prime)
+	switch {
+	case err != nil:
+		report.Errors = append(report.Errors, err.Error())
+		return report
+	case base == "":
+		report.Note = noteNoParent
+		return report
+	}
+	report.Base = base
+	changed, err := impactset.ChangedPaths(s.ctx, s.root, base)
+	if err != nil {
+		report.Errors = append(report.Errors, err.Error())
+		return report
+	}
+	funcs, err := changedFuncsAt(workingTree{root: s.root}, fabric, base, module, changed)
+	if err != nil {
+		report.Errors = append(report.Errors, fmt.Sprintf("find the changed functions: %v", err))
+		return report
+	}
+	if len(funcs) == 0 {
+		return report
+	}
+	s.refreshMaps(&report, module, funcs, prime)
+	reader, err := testreach.Open(reachModuleOf(module), testcover.Dir(fabricengine.BoltDir(s.location.HubPath)), s.worktreeMapsDir(prime))
+	if err != nil {
+		report.Errors = append(report.Errors, fmt.Sprintf("read the coverage maps: %v", err))
+		return report
+	}
+	if len(reader.Maps()) == 0 {
+		report.Note = noteNoMaps
+		return report
+	}
+	s.describe(&report, module, reader, funcs)
+	return report
+}
+
+// diffBase returns the commit the step diffs from: HEAD in the prime, otherwise the merge base with the parent branch.
+// It returns "" for a task worktree with no parent branch.
+func (s reachStep) diffBase(fabric *fabricengine.Fabric, prime bool) (string, error) {
+	if prime {
+		return fabric.HeadSHA()
+	}
+	base, found, err := parentMergeBase(s.location)
+	if err != nil {
+		return "", fmt.Errorf("read the merge base with the parent branch: %w", err)
+	}
+	if !found {
+		return "", nil
+	}
+	return base, nil
+}
+
+// worktreeMapsDir returns the worktree's own maps directory, or "" in the prime, which keeps none.
+func (s reachStep) worktreeMapsDir(prime bool) string {
+	if prime {
+		return ""
+	}
+	return testcover.Dir(s.location.AnchorPath())
+}
+
+// reachModuleOf returns module as the testreach package names it.
+func reachModuleOf(module goModule) testreach.Module {
+	return testreach.Module{Dir: module.dir, Rel: module.rel, Path: module.path}
+}
+
+// relativePackage returns the module-relative slash path of the package at the import path importPath.
+// A package outside the module keeps its import path.
+func (m goModule) relativePackage(importPath string) string {
+	if importPath == m.path {
+		return "."
+	}
+	if rel, inside := strings.CutPrefix(importPath, m.path+"/"); inside {
+		return rel
+	}
+	return importPath
+}
+
+// changedFuncsAt returns the functions of the module's production Go files that head changes against the commit base.
+// changed are the worktree-relative slash paths that differ between base and head.
+// It takes each package directory holding a changed production Go file.
+// It reads every production Go file of the directory at base, through fabric, and in head, and compares the two sets.
+func changedFuncsAt(head redundancyTree, fabric *fabricengine.Fabric, base string, module goModule, changed []string) ([]testreach.ChangedFunc, error) {
+	dirs := map[string]bool{}
+	for _, rel := range changed {
+		if !strings.HasSuffix(rel, ".go") || strings.HasSuffix(rel, "_test.go") {
+			continue
+		}
+		if dir := path.Dir(rel); isModulePackage(module.rel, dir) {
+			dirs[dir] = true
+		}
+	}
+	baseFiles, headFiles := testreach.FileSet{}, testreach.FileSet{}
+	for _, dir := range slices.Sorted(maps.Keys(dirs)) {
+		for _, side := range []struct {
+			tree  redundancyTree
+			files testreach.FileSet
+		}{{commitTree{fabric: fabric, rev: base}, baseFiles}, {head, headFiles}} {
+			names, err := side.tree.goFiles(dir)
+			if err != nil {
+				return nil, fmt.Errorf("list the Go files of %s: %w", dir, err)
+			}
+			for _, name := range names {
+				if strings.HasSuffix(name, "_test.go") {
+					continue
+				}
+				data, found, err := side.tree.file(path.Join(dir, name))
+				if err != nil {
+					return nil, fmt.Errorf("read %s: %w", path.Join(dir, name), err)
+				}
+				if found {
+					side.files[path.Join(dir, name)] = data
+				}
+			}
+		}
+	}
+	return testreach.ChangedFuncs(reachModuleOf(module), baseFiles, headFiles)
+}
+
+// changedPackages returns the module-relative slash path of each package holding one of funcs, sorted.
+func changedPackages(module goModule, funcs []testreach.ChangedFunc) []string {
+	packages := map[string]bool{}
+	for _, fn := range funcs {
+		packages[module.relativePackage(fn.Key.Package)] = true
+	}
+	return slices.Sorted(maps.Keys(packages))
+}
+
+// refreshMaps refreshes the worktree's own map of each package of funcs that needs one.
+// It lists the packages it does not refresh as unrefreshed.
+// A package needs one when it has no map or its map is not fresh against the worktree's files.
+// It is refreshed only when no file it or a linked package owns is uncommitted, and only inside reach_budget_min.
+// The prime refreshes nothing: it keeps no worktree maps, and its shared maps are the map run's to build.
+func (s reachStep) refreshMaps(report *ReachReport, module goModule, funcs []testreach.ChangedFunc, prime bool) {
+	packages := changedPackages(module, funcs)
+	unrefreshed := func(pkg, reason string) {
+		report.Unrefreshed = append(report.Unrefreshed, fmt.Sprintf("%s: not refreshed, %s", pkg, reason))
+	}
+	if prime {
+		for _, pkg := range packages {
+			unrefreshed(pkg, reasonPrimeKeepsNoMaps)
+		}
+		return
+	}
+	run := &testMapRun{ctx: s.ctx, request: s.mapRequest(), location: s.location, mapsDir: testcover.Dir(s.location.AnchorPath())}
+	defer run.close()
+	if refusal := run.prepare(); refusal != "" {
+		report.Errors = append(report.Errors, refusal)
+		for _, pkg := range packages {
+			unrefreshed(pkg, reasonMapRunRefused)
+		}
+		return
+	}
+	run.guardKilled = s.guardKilled
+	head, err := run.fabric.HeadSHA()
+	if err != nil {
+		report.Errors = append(report.Errors, fmt.Sprintf("read HEAD: %v", err))
+		for _, pkg := range packages {
+			unrefreshed(pkg, reasonHeadUnreadable)
+		}
+		return
+	}
+	var jobs []string
+	for _, pkg := range packages {
+		linked, stale, err := s.staleLinked(run, module, pkg)
+		if err != nil {
+			report.Errors = append(report.Errors, fmt.Sprintf("read the map of %s: %v", pkg, err))
+			unrefreshed(pkg, reasonMapCheckFailed)
+			continue
+		}
+		if !stale {
+			continue
+		}
+		reason, err := s.dirtyReason(run, module, head, pkg, linked)
+		if err != nil {
+			report.Errors = append(report.Errors, fmt.Sprintf("check the files of %s: %v", pkg, err))
+			unrefreshed(pkg, reasonMapCheckFailed)
+			continue
+		}
+		if reason != "" {
+			unrefreshed(pkg, reason)
+			continue
+		}
+		jobs = append(jobs, pkg)
+	}
+	if len(jobs) == 0 {
+		return
+	}
+	if err := run.holdSlot(); err != nil {
+		report.Errors = append(report.Errors, err.Error())
+		for _, pkg := range jobs {
+			unrefreshed(pkg, reasonNoRefreshSlot)
+		}
+		return
+	}
+	run.deadline = time.Now().Add(time.Duration(s.cfg.ReachBudgetMin) * s.minuteUnit)
+	if err := run.mapPackages(jobs); err != nil {
+		report.Errors = append(report.Errors, fmt.Sprintf("refresh the maps: %v", err))
+	}
+	for _, pkg := range jobs {
+		if !slices.Contains(run.built, pkg) {
+			unrefreshed(pkg, refreshLeftReason(run, pkg))
+		}
+	}
+}
+
+// refreshLeftReason returns why the map run's walk wrote no new map of the package pkg.
+func refreshLeftReason(run *testMapRun, pkg string) string {
+	if i := slices.IndexFunc(run.unmeasured, func(skip testMapSkip) bool { return skip.Package == pkg }); i >= 0 {
+		return run.unmeasured[i].Reason
+	}
+	if i := slices.IndexFunc(run.failed, func(failure testMapFailure) bool { return failure.Package == pkg }); i >= 0 {
+		return "its coverage build failed: " + run.failed[i].Failure
+	}
+	return reasonRefreshEnded
+}
+
+// mapRequest returns the map run request of the step's refresh.
+func (s reachStep) mapRequest() testMapRequest {
+	return testMapRequest{
+		goBinary: s.goBinary, environ: s.environ, secondUnit: s.secondUnit, minuteUnit: s.minuteUnit, grace: s.grace,
+		cappedParallel: memoryCappedParallel, stderr: s.stderr,
+	}
+}
+
+// staleLinked reports whether the worktree's own map of the package pkg is absent or no longer fresh.
+// It returns the import paths of the in-module packages linked by the package's test binary:
+// those its map records, or for a package with no map those the go command lists.
+func (s reachStep) staleLinked(run *testMapRun, module goModule, pkg string) (linked []string, stale bool, err error) {
+	m, found, err := testreach.ReadPackageMap(run.mapsDir, pkg)
+	if err != nil {
+		return nil, false, err
+	}
+	if found {
+		fresh, err := testreach.Fresh(reachModuleOf(module), pkg, m)
+		if err != nil || fresh {
+			return nil, false, err
+		}
+		return slices.Sorted(maps.Keys(m.Linked)), true, nil
+	}
+	toolchain := testcover.Toolchain{Go: s.goBinary, Env: run.env, Dir: run.moduleDir, Ctx: s.ctx, BuildTimeout: run.buildTimeout, Grace: s.grace}
+	linked, err = toolchain.LinkedPackages(module.importPath(pkg))
+	if err != nil {
+		return nil, false, err
+	}
+	return linked, true, nil
+}
+
+// dirtyReason returns why the package pkg is not refreshed for an uncommitted file, or "" when none blocks it.
+// The file may belong to the package itself or to one of the packages linked by its test binary, at the commit head.
+func (s reachStep) dirtyReason(run *testMapRun, module goModule, head, pkg string, linked []string) (string, error) {
+	trees := map[string]packageTree{}
+	for _, importPath := range append([]string{module.importPath(pkg)}, linked...) {
+		dir, inModule := run.moduleDirOf(importPath)
+		if !inModule {
+			continue
+		}
+		tree, err := run.readPackageTree(head, dir)
+		if err != nil {
+			return "", err
+		}
+		trees[importPath] = tree
+	}
+	file, err := run.dirtyOwnedFile(trees)
+	if err != nil || file == "" {
+		return "", err
+	}
+	owner := "its own"
+	for _, importPath := range slices.Sorted(maps.Keys(trees)) {
+		if trees[importPath].owns(file) && importPath != module.importPath(pkg) {
+			owner = "linked package " + module.relativePackage(importPath) + "'s"
+		}
+	}
+	return fmt.Sprintf("the uncommitted file %s is %s file; way forward: commit it and run the gate again", file, owner), nil
+}
+
+// describe records, for each of funcs, the tests of reader that reach it, or why it may still be run unseen.
+// It also records the maps and the Go file hashes of the packages the report names.
+func (s reachStep) describe(report *ReachReport, module goModule, reader *testreach.Reader, funcs []testreach.ChangedFunc) {
+	named := map[string]bool{}
+	for _, fn := range funcs {
+		pkg := module.relativePackage(fn.Key.Package)
+		named[pkg] = true
+		line := ReachFunction{Package: pkg, File: path.Join(packageDirOf(module.rel, pkg), fn.Key.File), Func: fn.Key.Func, Hash: fn.Hash, New: fn.New}
+		reaches := reader.TestsReaching(fn.Key)
+		for i, reach := range reaches {
+			if i == maxReachTestsPerFunction {
+				line.MoreTests = len(reaches) - i
+				break
+			}
+			testPkg := module.relativePackage(reach.Package)
+			named[testPkg] = true
+			line.Tests = append(line.Tests, ReachTest{Package: testPkg, Test: reach.Test})
+		}
+		if len(reaches) == 0 {
+			line.Caveats = s.caveats(report, module, reader, pkg, fn)
+		}
+		report.Functions = append(report.Functions, line)
+	}
+	for _, source := range reader.Maps() {
+		if named[source.Package] {
+			report.Maps = append(report.Maps, ReachMap{Package: source.Package, Commit: source.Commit, BuiltAt: source.BuiltAt, Worktree: source.Worktree})
+		}
+	}
+	for _, pkg := range slices.Sorted(maps.Keys(named)) {
+		hashes, err := goFileHashes(workingTree{root: s.root}, packageDirOf(module.rel, pkg))
+		if err != nil {
+			report.Errors = append(report.Errors, fmt.Sprintf("hash the Go files of %s: %v", pkg, err))
+			continue
+		}
+		if report.FileHashes == nil {
+			report.FileHashes = map[string]map[string]string{}
+		}
+		report.FileHashes[pkg] = hashes
+	}
+}
+
+// caveats returns the reasons a test may run fn, which no mapped test reaches, without the maps showing it.
+// One is a test of its package above tier1, or an entry its map marks as running code in another process.
+// The other, for a function new since the base, is a package linking its package whose map is older than its files.
+func (s reachStep) caveats(report *ReachReport, module goModule, reader *testreach.Reader, pkg string, fn testreach.ChangedFunc) []string {
+	var caveats []string
+	tests, err := testcover.ScanTestFuncs(filepath.Join(module.dir, filepath.FromSlash(pkg)))
+	if err != nil {
+		report.Errors = append(report.Errors, fmt.Sprintf("scan the tests of %s: %v", pkg, err))
+	}
+	aboveMapped := slices.ContainsFunc(tests, func(test testcover.TestFunc) bool { return !slices.Contains(mappedTiers, test.Tier) })
+	if aboveMapped || reader.SpawnMarked(pkg) {
+		caveats = append(caveats, fmt.Sprintf("a test of %s that no map holds, or that may run code in another process, may run it unseen", pkg))
+	}
+	if !fn.New {
+		return caveats
+	}
+	stale, err := reader.StaleLinkers(fn.Key.Package)
+	if err != nil {
+		report.Errors = append(report.Errors, fmt.Sprintf("find the packages linking %s: %v", pkg, err))
+		return caveats
+	}
+	if len(stale) > 0 {
+		caveats = append(caveats, fmt.Sprintf("the tests of %s may reach it: their maps recorded the files of %s before they changed", strings.Join(stale, ", "), pkg))
+	}
+	return caveats
+}
