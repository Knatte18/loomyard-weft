@@ -0,0 +1,214 @@
+// toggle_test.go covers the hidden bar and toggle verbs behind reed's slack and away toggles.
+
+package slackcli
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
