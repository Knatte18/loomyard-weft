+// asks reads the asks the run recorded, oldest first.
+func (a *autonomousJudge) asks() []burlerengine.ParentAsk {
+	a.t.Helper()
+	record, _, err := burlerengine.ReadParentAsks(a.files)
+	if err != nil {
+		a.t.Fatalf("ReadParentAsks() error = %v; want nil", err)
+	}
+	return record.Asks
+}
