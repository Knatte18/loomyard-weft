+
+package yamlengine
+
+import (
+	"cmp"
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// MoveOutcome says what a key move did with an old key.
+type MoveOutcome string
+
+const (
+	// MoveDone put the old key's value at its new path.
+	MoveDone MoveOutcome = "moved"
+	// MoveDroppedNull removed an old key holding null, since its absent new path reads the same default.
+	MoveDroppedNull MoveOutcome = "dropped-null"
+	// MoveDroppedNewSet removed an old key whose new path the document already held, keeping the new path's value.
+	MoveDroppedNewSet MoveOutcome = "dropped-new-set"
+)
+
+// Move is one change a key move made: the old and new dotted paths, relative to the prefix moved under, and the outcome.
+type Move struct {
+	Old     string
+	New     string
+	Outcome MoveOutcome
+}
+
+// MoveKeys moves keys of the YAML document existing to their new places, so a renamed key keeps its value.
+// moves maps each old dotted key to its new dotted path, both under the mapping that prefix leads to.
+// prefix holds one key per level, so a key holding a dot is addressed as it is; an empty prefix is the root.
+// A moved key keeps its value and comments, and missing mappings on the new path are created in block style.
+// An alias that a move leaves ahead of its anchor, or without it, is written as a copy of the anchored value.
+// An old key holding null is dropped, and so is one whose new path is already held.
+// An old key that is also the area its new path lies under is left alone while it holds a mapping.
+// Such keys move before the others, so another key can move into the area they free.
+// The changes are returned sorted by old key.
+// A document holding no old key, or no mapping at prefix, is returned byte for byte with no change.
+// A document that does not parse, or a non-mapping value on a new path, is an error.
+func MoveKeys(existing []byte, prefix []string, moves map[string]string) ([]byte, []Move, error) {
+	doc, root, err := parseMappingRoot(existing, "existing")
+	if err != nil {
+		return nil, nil, err
+	}
+	if root == nil {
+		return existing, nil, nil
+	}
+	under := root
+	for _, segment := range prefix {
+		at := mappingIndex(under, segment)
+		if at < 0 || under.Content[at+1].Kind != yaml.MappingNode {
+			return existing, nil, nil
+		}
+		under = under.Content[at+1]
+	}
+
+	namesOwnArea := func(old string) bool { return strings.HasPrefix(moves[old], old+".") }
+	order := slices.Sorted(maps.Keys(moves))
+	slices.SortStableFunc(order, func(a, b string) int {
+		switch {
+		case namesOwnArea(a) == namesOwnArea(b):
+			return 0
+		case namesOwnArea(a):
+			return -1
+		}
+		return 1
+	})
+
+	var done []Move
+	for _, old := range order {
+		parentPath, name := splitLastSegment(old)
+		parent := under
+		if parentPath != "" {
+			parent = findValueNode(under, parentPath)
+		}
+		if parent == nil || parent.Kind != yaml.MappingNode {
+			continue
+		}
+		at := mappingIndex(parent, name)
+		if at < 0 {
+			continue
+		}
+		key, value := parent.Content[at], parent.Content[at+1]
+		if value.Kind == yaml.MappingNode && namesOwnArea(old) {
+			continue
+		}
+
+		change := Move{Old: old, New: moves[old], Outcome: MoveDone}
+		switch {
+		case nodeShape(value) == "null":
+			change.Outcome = MoveDroppedNull
+		case findValueNode(under, change.New) != nil:
+			change.Outcome = MoveDroppedNewSet
+		}
+		removeKey(under, strings.Split(old, "."))
+		done = append(done, change)
+		if change.Outcome != MoveDone {
+			continue
+		}
+
+		target, newName, err := parentMappingOf(under, change.New)
+		if err != nil {
+			return nil, nil, fmt.Errorf("move %s to %s: %w", old, change.New, err)
+		}
+		// A flow mapping holding block entries and their comments marshals as invalid YAML, so it takes block style.
+		target.Style &^= yaml.FlowStyle
+		renamed := *key
+		renamed.Value = newName
+		target.Content = append(target.Content, &renamed, value)
+	}
+
+	if len(done) == 0 {
+		return existing, nil, nil
+	}
+	slices.SortFunc(done, func(a, b Move) int { return cmp.Compare(a.Old, b.Old) })
+	if len(root.Content) == 0 {
+		return []byte{}, done, nil
+	}
+	inlineStrandedAliases(doc, map[string]*yaml.Node{})
+	moved, err := yaml.Marshal(doc)
+	if err != nil {
+		return nil, nil, fmt.Errorf("marshal YAML: %w", err)
+	}
+	return moved, done, nil
+}
+
+// inlineStrandedAliases replaces, in document order under node, every alias whose anchored node is not yet written.
+// anchors maps each anchor name written so far to the node it names.
+// A replaced alias keeps its own comments and holds a copy of the anchored value.
+func inlineStrandedAliases(node *yaml.Node, anchors map[string]*yaml.Node) {
+	if node.Kind == yaml.AliasNode {
+		if anchors[node.Value] != node.Alias {
+			copied := copyWithoutAnchors(node.Alias)
+			copied.HeadComment, copied.LineComment, copied.FootComment = node.HeadComment, node.LineComment, node.FootComment
+			*node = *copied
+		}
+		return
+	}
+	if node.Anchor != "" {
+		anchors[node.Anchor] = node
+	}
+	for _, child := range node.Content {
+		inlineStrandedAliases(child, anchors)
+	}
+}
+
+// copyWithoutAnchors returns a deep copy of node that declares no anchor and holds no alias.
+func copyWithoutAnchors(node *yaml.Node) *yaml.Node {
+	if node.Kind == yaml.AliasNode {
+		return copyWithoutAnchors(node.Alias)
+	}
+	copied := *node
+	copied.Anchor = ""
+	copied.Content = nil
+	for _, child := range node.Content {
+		copied.Content = append(copied.Content, copyWithoutAnchors(child))
+	}
+	return &copied
+}
diff --git a/internal/yamlengine/move_test.go b/internal/yamlengine/move_test.go
new file mode 100644
index 000000000..e506dcd06
--- /dev/null
+++ b/internal/yamlengine/move_test.go
@@ -0,0 +1,131 @@
+// move_test.go table-drives MoveKeys: where an old key's value and comments land, and which old keys are dropped.
+
+package yamlengine_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/yamlengine"
+)
+
+func TestMoveKeys(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	discussion := map[string]string{"discussion": "discussion.model"}
+	flat := map[string]string{"old": "area.new"}
+	tests := []struct {
+		name     string
+		existing string
+		prefix   []string
+		moves    map[string]string
+		want     string
+		changes  []yamlengine.Move
+		wantErr  bool
+	}{
+		{
+			name:     "an alias moved ahead of its anchor holds a copy of the value",
+			existing: "code_max_bounces: &n 2\ncode_hard_max_bounces: *n\n",
+			moves:    map[string]string{"code_max_bounces": "code.max_bounces", "code_hard_max_bounces": "code.hard_max_bounces"},
+			want:     "code:\n    hard_max_bounces: 2\n    max_bounces: &n 2\n",
+			changes: []yamlengine.Move{
+				{Old: "code_hard_max_bounces", New: "code.hard_max_bounces", Outcome: yamlengine.MoveDone},
+				{Old: "code_max_bounces", New: "code.max_bounces", Outcome: yamlengine.MoveDone},
+			},
+		},
+		{
+			name:     "a flat key moves under a new area beside a key the area holds",
+			existing: "code_max_bounces: 2\ncode:\n    auto_accept: true\n",
+			moves:    map[string]string{"code_max_bounces": "code.max_bounces"},
+			want:     "code:\n    auto_accept: true\n    max_bounces: 2\n",
+			changes:  []yamlengine.Move{{Old: "code_max_bounces", New: "code.max_bounces", Outcome: yamlengine.MoveDone}},
+		},
+		{
+			name:     "a scalar under the area's own name moves into the area",
+			existing: "discussion: sonnet[medium]\n",
+			moves:    discussion,
+			want:     "discussion:\n    model: sonnet[medium]\n",
+			changes:  []yamlengine.Move{{Old: "discussion", New: "discussion.model", Outcome: yamlengine.MoveDone}},
+		},
+		{
+			name:     "a mapping under the area's own name is the new area and stays",
+			existing: "discussion:\n  model: x\n",
+			moves:    discussion,
+			want:     "discussion:\n  model: x\n",
+		},
+		{
+			name:     "the area's own key moves before a key sorting ahead of it moves into the area",
+			existing: "part_writer: w\nparts: m\n",
+			moves:    map[string]string{"part_writer": "parts.writer", "parts": "parts.model"},
+			want:     "parts:\n    model: m\n    writer: w\n",
+			changes: []yamlengine.Move{
+				{Old: "part_writer", New: "parts.writer", Outcome: yamlengine.MoveDone},
+				{Old: "parts", New: "parts.model", Outcome: yamlengine.MoveDone},
+			},
+		},
+		{
+			name:     "a null old key is dropped",
+			existing: "old:\nkeep: 1\n",
+			moves:    flat,
+			want:     "keep: 1\n",
+			changes:  []yamlengine.Move{{Old: "old", New: "area.new", Outcome: yamlengine.MoveDroppedNull}},
+		},
+		{
+			name:     "the new path's value wins over the old key's",
+			existing: "old: 1\narea:\n    new: 2\n",
+			moves:    flat,
+			want:     "area:\n    new: 2\n",
+			changes:  []yamlengine.Move{{Old: "old", New: "area.new", Outcome: yamlengine.MoveDroppedNewSet}},
+		},
+		{
+			name:     "a moved key keeps its comments and its neighbours keep theirs",
+			existing: "first: 1 # one\n# about old\nold: 2 # two\n# about last\nlast: 3\n",
+			moves:    flat,
+			want:     "first: 1 # one\n# about last\nlast: 3\narea:\n    # about old\n    new: 2 # two\n",
+			changes:  []yamlengine.Move{{Old: "old", New: "area.new", Outcome: yamlengine.MoveDone}},
+		},
+		{
+			name:     "a prefix moves only the keys below it",
+			existing: "old: 1\nrecipes:\n    loom:\n        old: 2\n",
+			prefix:   []string{"recipes", "loom"},
+			moves:    flat,
+			want:     "old: 1\nrecipes:\n    loom:\n        area:\n            new: 2\n",
+			changes:  []yamlengine.Move{{Old: "old", New: "area.new", Outcome: yamlengine.MoveDone}},
+		},
+		{
+			name:     "an absent prefix changes nothing",
+			existing: "old: 1\n",
+			prefix:   []string{"recipes", "loom"},
+			moves:    flat,
+			want:     "old: 1\n",
+		},
+		{name: "an unparseable document is refused", existing: "old: [unclosed\n", moves: flat, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, changes, err := yamlengine.MoveKeys([]byte(tt.existing), tt.prefix, tt.moves)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("MoveKeys(%q) = %q; want an error", tt.existing, got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("MoveKeys(%q) = %v; want nil", tt.existing, err)
+			}
+			if string(got) != tt.want {
+				t.Errorf("MoveKeys(%q) = %q; want %q", tt.existing, got, tt.want)
+			}
+			if !slices.Equal(changes, tt.changes) {
+				t.Errorf("MoveKeys(%q) changes = %v; want %v", tt.existing, changes, tt.changes)
+			}
+
+			again, changes, err := yamlengine.MoveKeys(got, tt.prefix, tt.moves)
+			if err != nil || string(again) != string(got) || len(changes) != 0 {
+				t.Errorf("second MoveKeys = %q, %v, %v; want %q unchanged", again, changes, err, got)
+			}
+		})
+	}
+}
