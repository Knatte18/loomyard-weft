diff --git a/tools/machinecost/cli_test.go b/tools/machinecost/cli_test.go
new file mode 100644
index 000000000..fcc7cfaef
--- /dev/null
+++ b/tools/machinecost/cli_test.go
@@ -0,0 +1,83 @@
+// cli_test.go covers the command line: each subcommand's exit code, and that compare reads the report probe writes.
+
+package main
+
+import (
+	"bytes"
+	"io"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/google/go-cmp/cmp"
+)
+
+func TestWriteReport_ReadsBackUnchanged(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	path := filepath.Join(t.TempDir(), "report.json")
+	want := Report{
+		GeneratedAt: "2026-11-26T12:00:00Z",
+		Machine:     Machine{Hostname: "laptop", Cores: 16, TrapsPresent: true},
+		Before:      Snapshot{Load1: ptr(2.93)},
+		Config:      ProbeConfig{Dirs: []NamedDir{{Name: "zz", Path: "/tmp/zz-probe"}}, Starts: 200},
+		Skipped:     []string{"start/lym_help: no lym on PATH and no -lym flag"},
+		Measurements: []Measurement{
+			{Name: "newbinary/zz/first_run_ms", Unit: unitMilliseconds, Value: 3012.5},
+		},
+	}
+	if err := writeReport(path, want); err != nil {
+		t.Fatalf("writeReport() error: %v", err)
+	}
+	got, err := readReport(path)
+	if err != nil {
+		t.Fatalf("readReport() error: %v", err)
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("readReport(writeReport()) mismatch (-want +got):\n%s", diff)
+	}
+}
+
+func TestRun_ExitCodes(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	dir := t.TempDir()
+	reportPath := filepath.Join(dir, "report.json")
+	if err := writeReport(reportPath, Report{Measurements: []Measurement{{Name: "start/true/median_us", Unit: unitMicroseconds, Value: 1300}}}); err != nil {
+		t.Fatalf("writeReport() error: %v", err)
+	}
+	missingPath := filepath.Join(dir, "missing.json")
+	// wantStderr, where set, tells which of the refusals sharing an exit code fired.
+	tests := []struct {
+		name       string
+		args       []string
+		want       int
+		wantStderr string
+	}{
+		{"NoSubcommand", nil, exitUsage, ""},
+		{"UnknownSubcommand", []string{"measure"}, exitUsage, ""},
+		{"CompareTwoReports", []string{"compare", reportPath, reportPath}, exitOK, ""},
+		{"CompareOneReport", []string{"compare", reportPath}, exitUsage, ""},
+		{"CompareMissingReport", []string{"compare", reportPath, missingPath}, exitError, ""},
+		{"ProbeZeroCount", []string{"probe", "-starts", "0"}, exitUsage, ""},
+		{"ProbeUnknownFlag", []string{"probe", "-rounds", "3"}, exitUsage, ""},
+		{"ProbeStrayArgument", []string{"probe", "extra"}, exitUsage, ""},
+		{"ProbeDirNameGivenTwice", []string{"probe", "-dir", "a=/x", "-dir", "a=/y"}, exitUsage,
+			`folder name "a" given twice`},
+		{"ProbeDirIsAccepted", []string{"probe", "-dir", "a=/x", "-starts", "0"}, exitUsage,
+			"every count must be at least 1"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			var stderr bytes.Buffer
+			if got := run(tt.args, io.Discard, &stderr); got != tt.want {
+				t.Errorf("run(%q) = %d; want %d", tt.args, got, tt.want)
+			}
+			if !strings.Contains(stderr.String(), tt.wantStderr) {
+				t.Errorf("run(%q) stderr = %q; want it to hold %q", tt.args, stderr.String(), tt.wantStderr)
+			}
+		})
+	}
+}
diff --git a/tools/machinecost/fileops.go b/tools/machinecost/fileops.go
new file mode 100644
index 000000000..8f7a0a2e4
--- /dev/null
+++ b/tools/machinecost/fileops.go
@@ -0,0 +1,89 @@
+// fileops.go times small file operations in a folder: the operations a test's fixtures make many of.
+
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// Sizes of the files the operations write.
+const (
+	smallFileBytes = 64
+	blockBytes     = 4096
+)
+
+// measureFileOps repeats each file operation count times in a folder it makes inside dir.
+// It adds the median time of each under fileops/<name>/.
+func measureFileOps(ctx context.Context, dir NamedDir, count int, measurements *collector) error {
+	workDir, err := os.MkdirTemp(dir.Path, probeFolderPrefix)
+	if err != nil {
+		return fmt.Errorf("create folder in %s: %w", dir.Path, err)
+	}
+	defer os.RemoveAll(workDir)
+
+	smallContent := make([]byte, smallFileBytes)
+	block := make([]byte, blockBytes)
+	statTarget := filepath.Join(workDir, "stat-target")
+	if err := os.WriteFile(statTarget, smallContent, 0o644); err != nil {
+		return fmt.Errorf("write stat target: %w", err)
+	}
+	blockFile, err := os.Create(filepath.Join(workDir, "block"))
+	if err != nil {
+		return fmt.Errorf("create block file: %w", err)
+	}
+	defer blockFile.Close()
+
+	operations := []struct {
+		name string
+		run  func() error
+	}{
+		{"create_write_close_delete_us", func() error {
+			path := filepath.Join(workDir, "small")
+			if err := os.WriteFile(path, smallContent, 0o644); err != nil {
+				return err
+			}
+			return os.Remove(path)
+		}},
+		{"stat_us", func() error {
+			_, err := os.Stat(statTarget)
+			return err
+		}},
+		{"mkdir_rmdir_us", func() error {
+			path := filepath.Join(workDir, "folder")
+			if err := os.Mkdir(path, 0o755); err != nil {
+				return err
+			}
+			return os.Remove(path)
+		}},
+		{"write_4k_us", func() error {
+			_, err := blockFile.WriteAt(block, 0)
+			return err
+		}},
+		{"write_4k_fsync_us", func() error {
+			if _, err := blockFile.WriteAt(block, 0); err != nil {
+				return err
+			}
+			return blockFile.Sync()
+		}},
+	}
+	prefix := groupFileOps + "/" + dir.Name + "/"
+	for _, operation := range operations {
+		samples := make([]time.Duration, 0, count)
+		for range count {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			started := time.Now()
+			if err := operation.run(); err != nil {
+				return fmt.Errorf("file operation %s in %s: %w", operation.name, workDir, err)
+			}
+			samples = append(samples, time.Since(started))
+		}
+		measurements.add(prefix+operation.name, unitMicroseconds, microseconds(median(samples)))
+	}
+	return nil
+}
diff --git a/tools/machinecost/gitload.go b/tools/machinecost/gitload.go
new file mode 100644
index 000000000..2fff81c66
--- /dev/null
+++ b/tools/machinecost/gitload.go
@@ -0,0 +1,163 @@
+// gitload.go times a git workload shaped like a fabric test fixture:
+// init a bare repository, clone it, add and commit a file, and push, once per round.
+
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+)
+
+// gitBinary is the git the probe starts.
+const gitBinary = "git"
+
+// The workload's steps, in the order each round runs them.
+const (
+	stepInit   = "init"
+	stepClone  = "clone"
+	stepAdd    = "add"
+	stepCommit = "commit"
+	stepPush   = "push"
+)
+
+var gitSteps = []string{stepInit, stepClone, stepAdd, stepCommit, stepPush}
+
+// probeGitConfig replaces the machine's global git config for the workload,
+// so every machine runs the same commands with no hooks, signing or maintenance of its own.
+const probeGitConfig = "[user]\n\tname = machinecost\n\temail = machinecost@localhost\n" +
+	"[commit]\n\tgpgsign = false\n[gc]\n\tauto = 0\n[maintenance]\n\tauto = false\n[advice]\n\tdetachedHead = false\n"
+
+// probeFileName is the file each round adds and commits.
+const probeFileName = "probe.txt"
+
+// traceStartEvent marks one git process's start in a GIT_TRACE2_EVENT file.
+const traceStartEvent = `"event":"start"`
+
+// stepCost is one step's wall time and the user and system time of the git it ran and every child that git waited on.
+type stepCost struct {
+	wall, user, system time.Duration
+}
+
+// measureGitWorkload runs rounds rounds of the workload in tempDir.
+// It adds each step's median wall, user and system time under git/<step>/.
+// A further round under git's event trace counts the git processes each step starts;
+// it is kept out of the timed rounds, since the trace writes a file from every process.
+func measureGitWorkload(ctx context.Context, tempDir string, rounds int, measurements *collector) error {
+	configPath := filepath.Join(tempDir, "gitconfig")
+	if err := os.WriteFile(configPath, []byte(probeGitConfig), 0o644); err != nil {
+		return fmt.Errorf("write git config: %w", err)
+	}
+	baseEnv := append(environWithoutGitVariables(), "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL="+configPath)
+	untraced := func(string) []string { return baseEnv }
+
+	costs := make(map[string][]stepCost, len(gitSteps))
+	for round := range rounds {
+		roundCosts, err := runGitRound(ctx, filepath.Join(tempDir, fmt.Sprintf("round-%d", round)), untraced)
+		if err != nil {
+			return err
+		}
+		for step, cost := range roundCosts {
+			costs[step] = append(costs[step], cost)
+		}
+	}
+
+	traceDir := filepath.Join(tempDir, "trace")
+	if err := os.Mkdir(traceDir, 0o755); err != nil {
+		return fmt.Errorf("create trace folder: %w", err)
+	}
+	traced := func(step string) []string {
+		return slices.Concat(baseEnv, []string{"GIT_TRACE2_EVENT=" + filepath.Join(traceDir, step)})
+	}
+	if _, err := runGitRound(ctx, filepath.Join(tempDir, "round-traced"), traced); err != nil {
+		return err
+	}
+
+	for _, step := range gitSteps {
+		trace, err := os.ReadFile(filepath.Join(traceDir, step))
+		if err != nil {
+			return fmt.Errorf("read git trace of %s: %w", step, err)
+		}
+		walls := make([]time.Duration, 0, rounds)
+		users := make([]time.Duration, 0, rounds)
+		systems := make([]time.Duration, 0, rounds)
+		for _, cost := range costs[step] {
+			walls = append(walls, cost.wall)
+			users = append(users, cost.user)
+			systems = append(systems, cost.system)
+		}
+		prefix := groupGit + "/" + step + "/"
+		measurements.add(prefix+"wall_ms", unitMilliseconds, milliseconds(median(walls)))
+		measurements.add(prefix+"user_ms", unitMilliseconds, milliseconds(median(users)))
+		measurements.add(prefix+"sys_ms", unitMilliseconds, milliseconds(median(systems)))
+		measurements.add(prefix+"processes", unitCount, float64(strings.Count(string(trace), traceStartEvent)))
+	}
+	return nil
+}
+
+// runGitRound runs one round of the workload in roundDir and returns each step's cost.
+// Each step's git runs under envFor(step).
+// It deletes roundDir.
+func runGitRound(ctx context.Context, roundDir string, envFor func(step string) []string) (map[string]stepCost, error) {
+	if err := os.Mkdir(roundDir, 0o755); err != nil {
+		return nil, fmt.Errorf("create round folder: %w", err)
+	}
+	defer os.RemoveAll(roundDir)
+	bare := filepath.Join(roundDir, "origin.git")
+	work := filepath.Join(roundDir, "work")
+
+	costs := make(map[string]stepCost, len(gitSteps))
+	runStep := func(step, dir string, args ...string) error {
+		cost, err := runGit(ctx, dir, envFor(step), args)
+		if err != nil {
+			return fmt.Errorf("git workload step %s: %w", step, err)
+		}
+		costs[step] = cost
+		return nil
+	}
+	if err := runStep(stepInit, roundDir, "init", "--bare", "-q", bare); err != nil {
+		return nil, err
+	}
+	if err := runStep(stepClone, roundDir, "clone", "-q", bare, work); err != nil {
+		return nil, err
+	}
+	if err := os.WriteFile(filepath.Join(work, probeFileName), []byte("probe\n"), 0o644); err != nil {
+		return nil, fmt.Errorf("write probe file: %w", err)
+	}
+	if err := runStep(stepAdd, work, "add", probeFileName); err != nil {
+		return nil, err
+	}
+	if err := runStep(stepCommit, work, "commit", "-q", "-m", "probe"); err != nil {
+		return nil, err
+	}
+	if err := runStep(stepPush, work, "push", "-q", "origin", "HEAD"); err != nil {
+		return nil, err
+	}
+	return costs, nil
+}
+
+// environWithoutGitVariables returns the caller's environment without its GIT_* variables.
+// Those can add config, trace a timed git or point it at another repository.
+func environWithoutGitVariables() []string {
+	return slices.DeleteFunc(os.Environ(), func(entry string) bool { return strings.HasPrefix(entry, "GIT_") })
+}
+
+func runGit(ctx context.Context, dir string, env, args []string) (stepCost, error) {
+	cmd := exec.CommandContext(ctx, gitBinary, args...)
+	cmd.Dir = dir
+	cmd.Env = env
+	started := time.Now()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		return stepCost{}, fmt.Errorf("git %s: %w: %s", strings.Join(args, " "), err, out)
+	}
+	return stepCost{
+		wall:   time.Since(started),
+		user:   cmd.ProcessState.UserTime(),
+		system: cmd.ProcessState.SystemTime(),
+	}, nil
+}
diff --git a/tools/machinecost/machine.go b/tools/machinecost/machine.go
new file mode 100644
index 000000000..375d5ca46
--- /dev/null
+++ b/tools/machinecost/machine.go
@@ -0,0 +1,235 @@
+// machine.go reads the machine descriptor and the load snapshots a report carries.
+// Its sources are /proc, /sys and the tools' versions.
+// A figure the machine does not expose, such as CPU pressure on an older kernel, is left absent.
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+// Files the descriptor and the snapshots read.
+const (
+	loadavgPath       = "/proc/loadavg"
+	cpuPressurePath   = "/proc/pressure/cpu"
+	cpuinfoPath       = "/proc/cpuinfo"
+	kernelReleasePath = "/proc/sys/kernel/osrelease"
+	governorPath      = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
+	throttleCountGlob = "/sys/devices/system/cpu/cpu*/thermal_throttle/core_throttle_count"
+	// trapsPath is where Cortex XDR installs; its presence marks a machine whose endpoint agent holds new binaries.
+	trapsPath = "/opt/traps"
+)
+
+// goBinary is the Go toolchain the probe links its new binaries with.
+const goBinary = "go"
+
+// goConfigName is the folder, inside the probe's temp folder, that the probe's go commands take as the user config.
+const goConfigName = "config"
+
+// Machine describes the machine a report was measured on.
+type Machine struct {
+	Hostname     string `json:"hostname"`
+	CPUModel     string `json:"cpu_model"`
+	Cores        int    `json:"cores"`
+	Kernel       string `json:"kernel"`
+	Governor     string `json:"governor"`
+	GoVersion    string `json:"go_version"`
+	GitVersion   string `json:"git_version"`
+	TrapsPresent bool   `json:"traps_present"`
+}
+
+// Snapshot is the machine's load and CPU state at one instant; a nil field is one the machine does not expose.
+type Snapshot struct {
+	Load1                *float64 `json:"load1"`
+	Load5                *float64 `json:"load5"`
+	Load15               *float64 `json:"load15"`
+	CPUPressureSomeAvg10 *float64 `json:"cpu_pressure_some_avg10"`
+	CPUPressureSomeAvg60 *float64 `json:"cpu_pressure_some_avg60"`
+	MeanMHz              *float64 `json:"mean_mhz"`
+	// ThrottleCount sums every core's thermal throttle count since boot,
+	// so the difference between two snapshots counts the throttles in between.
+	ThrottleCount *float64 `json:"throttle_count"`
+}
+
+// readMachine describes this machine, with the version of the local Go toolchain, asked from inside tempDir.
+// tempDir holds no Go module, so no module's toolchain requirement applies.
+// The go command's user config is made inside tempDir too, with its telemetry off.
+// The probe runs both go and git, so it fails only when the version of either cannot be read.
+func readMachine(tempDir string) (Machine, error) {
+	hostname, err := os.Hostname()
+	if err != nil {
+		return Machine{}, fmt.Errorf("read host name: %w", err)
+	}
+	configEntry, err := goConfigWithoutTelemetry(tempDir)
+	if err != nil {
+		return Machine{}, err
+	}
+	goVersionQuery := exec.Command(goBinary, "env", "GOVERSION")
+	goVersionQuery.Dir = tempDir
+	goVersionQuery.Env = append(os.Environ(), "GOWORK=off", "GOTOOLCHAIN=local", configEntry)
+	goVersion, err := commandOutput(goVersionQuery)
+	if err != nil {
+		return Machine{}, err
+	}
+	gitVersion, err := commandOutput(exec.Command(gitBinary, "--version"))
+	if err != nil {
+		return Machine{}, err
+	}
+	model, _ := parseCPUInfo(readOptionalFile(cpuinfoPath))
+	_, trapsErr := os.Stat(trapsPath)
+	return Machine{
+		Hostname:     hostname,
+		CPUModel:     model,
+		Cores:        runtime.NumCPU(),
+		Kernel:       readOptionalFile(kernelReleasePath),
+		Governor:     readOptionalFile(governorPath),
+		GoVersion:    goVersion,
+		GitVersion:   gitVersion,
+		TrapsPresent: trapsErr == nil,
+	}, nil
+}
+
+// goConfigWithoutTelemetry makes a user config folder with Go telemetry off inside tempDir.
+// It returns the environment entry that points a go command at that folder.
+// With telemetry on, a go command writes counters into the user config folder.
+// It can also start a detached process there that outlives it.
+func goConfigWithoutTelemetry(tempDir string) (string, error) {
+	configDir := filepath.Join(tempDir, goConfigName)
+	telemetryDir := filepath.Join(configDir, "go", "telemetry")
+	if err := os.MkdirAll(telemetryDir, 0o755); err != nil {
+		return "", fmt.Errorf("create go telemetry folder: %w", err)
+	}
+	if err := os.WriteFile(filepath.Join(telemetryDir, "mode"), []byte("off"), 0o644); err != nil {
+		return "", fmt.Errorf("turn off go telemetry: %w", err)
+	}
+	return "XDG_CONFIG_HOME=" + configDir, nil
+}
+
+// readSnapshot takes the machine's load and CPU state now.
+func readSnapshot() Snapshot {
+	var snapshot Snapshot
+	snapshot.Load1, snapshot.Load5, snapshot.Load15 = parseLoadavg(readOptionalFile(loadavgPath))
+	snapshot.CPUPressureSomeAvg10, snapshot.CPUPressureSomeAvg60 = parseCPUPressure(readOptionalFile(cpuPressurePath))
+	_, snapshot.MeanMHz = parseCPUInfo(readOptionalFile(cpuinfoPath))
+	snapshot.ThrottleCount = readThrottleCount()
+	return snapshot
+}
+
+// readOptionalFile returns a file's trimmed content, or "" when the machine does not have it.
+func readOptionalFile(path string) string {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(data))
+}
+
+func commandOutput(cmd *exec.Cmd) (string, error) {
+	out, err := cmd.Output()
+	if err != nil {
+		return "", fmt.Errorf("run %s: %w", strings.Join(cmd.Args, " "), err)
+	}
+	return strings.TrimSpace(string(out)), nil
+}
+
+// parseLoadavg reads the 1, 5 and 15 minute load averages from /proc/loadavg's text.
+func parseLoadavg(text string) (load1, load5, load15 *float64) {
+	fields := strings.Fields(text)
+	if len(fields) < 3 {
+		return nil, nil, nil
+	}
+	return parseOptionalFloat(fields[0]), parseOptionalFloat(fields[1]), parseOptionalFloat(fields[2])
+}
+
+// parseCPUPressure reads the `some` line's avg10 and avg60 from /proc/pressure/cpu's text.
+func parseCPUPressure(text string) (avg10, avg60 *float64) {
+	for line := range strings.Lines(text) {
+		fields := strings.Fields(line)
+		if len(fields) == 0 || fields[0] != "some" {
+			continue
+		}
+		for _, field := range fields[1:] {
+			key, value, _ := strings.Cut(field, "=")
+			switch key {
+			case "avg10":
+				avg10 = parseOptionalFloat(value)
+			case "avg60":
+				avg60 = parseOptionalFloat(value)
+			}
+		}
+	}
+	return avg10, avg60
+}
+
+// parseCPUInfo reads the first CPU's model name and the mean of every core's current frequency from /proc/cpuinfo's text.
+func parseCPUInfo(text string) (model string, meanMHz *float64) {
+	var totalMHz float64
+	var cores int
+	for line := range strings.Lines(text) {
+		key, value, found := strings.Cut(line, ":")
+		if !found {
+			continue
+		}
+		value = strings.TrimSpace(value)
+		switch strings.TrimSpace(key) {
+		case "model name":
+			if model == "" {
+				model = value
+			}
+		case "cpu MHz":
+			if mhz := parseOptionalFloat(value); mhz != nil {
+				totalMHz += *mhz
+				cores++
+			}
+		}
+	}
+	if cores == 0 {
+		return model, nil
+	}
+	mean := totalMHz / float64(cores)
+	return model, &mean
+}
+
+// readThrottleCount sums every core's thermal throttle count, or returns nil when the machine exposes none.
+func readThrottleCount() *float64 {
+	paths, err := filepath.Glob(throttleCountGlob)
+	if err != nil {
+		return nil
+	}
+	texts := make([]string, 0, len(paths))
+	for _, path := range paths {
+		texts = append(texts, readOptionalFile(path))
+	}
+	return sumThrottleCounts(texts)
+}
+
+// sumThrottleCounts sums the per-core counts in texts.
+// It returns nil when there are none or one does not parse, since a partial sum would compare with nothing.
+func sumThrottleCounts(texts []string) *float64 {
+	if len(texts) == 0 {
+		return nil
+	}
+	var total float64
+	for _, text := range texts {
+		count := parseOptionalFloat(text)
+		if count == nil {
+			return nil
+		}
+		total += *count
+	}
+	return &total
+}
+
+func parseOptionalFloat(text string) *float64 {
+	value, err := strconv.ParseFloat(text, 64)
+	if err != nil {
+		return nil
+	}
+	return &value
+}
diff --git a/tools/machinecost/main.go b/tools/machinecost/main.go
new file mode 100644
index 000000000..aa40106a2
--- /dev/null
+++ b/tools/machinecost/main.go
@@ -0,0 +1,225 @@
+// Command machinecost measures the costs a test run is made of on this machine and writes one comparable report.
+// With it, two machines, or two folders on one machine, can be compared on one footing.
+//
+//	go build -o <bin>/machinecost ./tools/machinecost
+//	machinecost probe -dir lym=/tmp/lym-probe -dir zz=/tmp/zz-probe -out laptop.json
+//	machinecost compare laptop.json desktop.json
+//
+// Build it with `go build -o` and run the binary: it measures new-binary holds, which a `go run` would add to.
+//
+// probe measures, in order:
+//   - process starts from Go: /bin/true, `git --version` and `lym --help`,
+//     each as the median wall per start and the children's user and system time per start;
+//   - in each -dir folder, the first and second run of a freshly linked program whose build ID is random,
+//     so an endpoint agent has never seen its hash;
+//   - in each -dir folder, file operations: create, write, close and delete a small file,
+//     stat, mkdir and rmdir, and a 4 KiB write with and without fsync;
+//   - a git workload shaped like a fabric test fixture, repeated each round:
+//     init a bare repository, clone it, add and commit a file, and push.
+//     Each step records its median wall, user and system time, and the git processes it starts.
+//
+// The report holds a machine descriptor and a load snapshot taken before and after the measurements.
+// A figure measured under unknown load compares with nothing.
+// -dir takes name=path, with a name that holds no /.
+// The name keys that folder's measurements, so two machines compare when their folders share names.
+// -lym defaults to the lym on PATH; with neither, the lym starts are skipped and the report says so.
+// The git workload runs under a config file of the probe's own.
+// It ignores the machine's global and system git config, so each machine runs the same git commands.
+//
+// probe writes the JSON report to -out and prints the same figures as text.
+// The default report file is machinecost-<host>-<UTC time>.json in the current directory.
+// compare reads two reports and prints each measurement of both with the ratio of the second to the first.
+//
+// probe creates folders only inside each -dir folder and in its own temp folder under the lym temp root.
+// It deletes every one of them before it exits, also when an interrupt, SIGTERM or hangup ends the run early.
+// A process ended any other way, such as by SIGKILL, leaves the folders inside the -dir folders behind.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lymtemp"
+)
+
+// Exit codes of the command.
+const (
+	exitOK    = 0
+	exitError = 1
+	exitUsage = 2
+)
+
+// Default counts for the probe's repeated measurements.
+const (
+	defaultStarts    = 200
+	defaultFileOps   = 200
+	defaultBinaries  = 3
+	defaultGitRounds = 20
+)
+
+// lymBinaryName is the command looked up on PATH when -lym is not given.
+const lymBinaryName = "lym"
+
+// The default report file name, from the host name and the start time in reportTimeLayout.
+const (
+	reportNameFormat = "machinecost-%s-%s.json"
+	reportTimeLayout = "20060102T150405Z"
+)
+
+const usageText = `usage:
+  machinecost probe [-dir name=path]... [-lym path] [-starts n] [-fileops n] [-binaries n] [-git-rounds n] [-out file]
+  machinecost compare <base.json> <other.json>
+`
+
+func main() {
+	code := run(os.Args[1:], os.Stdout, os.Stderr)
+	if err := lymtemp.Remove(); err != nil {
+		fmt.Fprintf(os.Stderr, "machinecost: %v\n", err)
+		code = exitError
+	}
+	os.Exit(code)
+}
+
+// run dispatches a subcommand and returns the process exit code.
+func run(args []string, stdout, stderr io.Writer) int {
+	if len(args) == 0 {
+		fmt.Fprint(stderr, usageText)
+		return exitUsage
+	}
+	switch args[0] {
+	case "probe":
+		return runProbeCommand(args[1:], stdout, stderr)
+	case "compare":
+		return runCompareCommand(args[1:], stdout, stderr)
+	default:
+		fmt.Fprintf(stderr, "machinecost: unknown subcommand %q\n%s", args[0], usageText)
+		return exitUsage
+	}
+}
+
+// runProbeCommand parses probe's flags, runs the probe, writes the JSON report and prints it as text.
+func runProbeCommand(args []string, stdout, stderr io.Writer) int {
+	flags := flag.NewFlagSet("probe", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	var dirs dirList
+	flags.Var(&dirs, "dir", "folder to measure, as name=path; repeatable")
+	lymBinary := flags.String("lym", "", "lym binary to time; defaults to the lym on PATH")
+	starts := flags.Int("starts", defaultStarts, "process starts per command")
+	fileOps := flags.Int("fileops", defaultFileOps, "repetitions of each file operation per folder")
+	binaries := flags.Int("binaries", defaultBinaries, "freshly linked programs per folder")
+	gitRounds := flags.Int("git-rounds", defaultGitRounds, "rounds of the git workload")
+	out := flags.String("out", "", "report file; defaults to "+fmt.Sprintf(reportNameFormat, "<host>", "<UTC time>"))
+	if err := flags.Parse(args); err != nil {
+		return exitUsage
+	}
+	if flags.NArg() != 0 {
+		fmt.Fprintf(stderr, "machinecost probe: unexpected argument %q\n", flags.Arg(0))
+		return exitUsage
+	}
+	for _, count := range []int{*starts, *fileOps, *binaries, *gitRounds} {
+		if count < 1 {
+			fmt.Fprintln(stderr, "machinecost probe: every count must be at least 1")
+			return exitUsage
+		}
+	}
+	if *lymBinary == "" {
+		if found, err := exec.LookPath(lymBinaryName); err == nil {
+			*lymBinary = found
+		}
+	}
+
+	startedAt := time.Now()
+	config := ProbeConfig{
+		Dirs:      dirs,
+		LymBinary: *lymBinary,
+		Starts:    *starts,
+		FileOps:   *fileOps,
+		Binaries:  *binaries,
+		GitRounds: *gitRounds,
+	}
+	// Catching the signals lets an interrupted probe return and delete its folders.
+	signals := []os.Signal{os.Interrupt, syscall.SIGTERM}
+	// Catching a hangup that nohup ignores would end a run meant to outlive its terminal.
+	if !signal.Ignored(syscall.SIGHUP) {
+		signals = append(signals, syscall.SIGHUP)
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), signals...)
+	defer stop()
+	report, err := runProbe(ctx, config, startedAt, stderr)
+	if err != nil {
+		fmt.Fprintf(stderr, "machinecost probe: %v\n", err)
+		return exitError
+	}
+	reportPath := *out
+	if reportPath == "" {
+		reportPath = fmt.Sprintf(reportNameFormat, report.Machine.Hostname, startedAt.UTC().Format(reportTimeLayout))
+	}
+	if err := writeReport(reportPath, report); err != nil {
+		fmt.Fprintf(stderr, "machinecost probe: %v\n", err)
+		return exitError
+	}
+	renderReport(stdout, report)
+	fmt.Fprintf(stdout, "\nReport: %s\n", reportPath)
+	return exitOK
+}
+
+// runCompareCommand reads two reports and prints their comparison.
+func runCompareCommand(args []string, stdout, stderr io.Writer) int {
+	if len(args) != 2 {
+		fmt.Fprint(stderr, usageText)
+		return exitUsage
+	}
+	base, err := readReport(args[0])
+	if err != nil {
+		fmt.Fprintf(stderr, "machinecost compare: %v\n", err)
+		return exitError
+	}
+	other, err := readReport(args[1])
+	if err != nil {
+		fmt.Fprintf(stderr, "machinecost compare: %v\n", err)
+		return exitError
+	}
+	renderComparison(stdout, base, other)
+	return exitOK
+}
+
+// dirList collects the repeatable -dir flag.
+// A folder's name keys its measurements, so a name given twice is refused.
+type dirList []NamedDir
+
+func (d *dirList) String() string {
+	names := make([]string, 0, len(*d))
+	for _, dir := range *d {
+		names = append(names, dir.Name+"="+dir.Path)
+	}
+	return strings.Join(names, ",")
+}
+
+func (d *dirList) Set(value string) error {
+	name, path, named := strings.Cut(value, "=")
+	// A / in the name is a bare path holding =, and would also split the measurement keys.
+	if !named || name == "" || path == "" || strings.Contains(name, "/") {
+		return errors.New("want name=path, with a name holding no /")
+	}
+	for _, dir := range *d {
+		if dir.Name == name {
+			return fmt.Errorf("folder name %q given twice", name)
+		}
+	}
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return fmt.Errorf("resolve %s: %w", path, err)
+	}
+	*d = append(*d, NamedDir{Name: name, Path: absolute})
+	return nil
+}
diff --git a/tools/machinecost/newbinary.go b/tools/machinecost/newbinary.go
new file mode 100644
index 000000000..3ca9c7243
--- /dev/null
+++ b/tools/machinecost/newbinary.go
@@ -0,0 +1,113 @@
+// newbinary.go times the first and second run of a freshly linked program in a folder,
+// so an endpoint agent's hold on an unseen binary, and a folder exception's effect on it, show as figures.
+
+package main
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+)
+
+// The program the probe links: it does nothing, so its run time is the start cost and any hold alone.
+const (
+	probeProgramSource = "package main\n\nfunc main() {}\n"
+	probeProgramModule = "module machinecostprobe\n\ngo 1.22\n"
+)
+
+// buildCacheName is the folder, inside the probe's temp folder, that holds the probe build's cache.
+const buildCacheName = "gocache"
+
+// buildIDBytes is the length of the random build ID each linked program gets, so each has a hash never seen before.
+const buildIDBytes = 20
+
+// measureNewBinaries links count programs, each with a random build ID, into a folder it makes inside dir.
+// It runs each twice and adds the median first and second run under newbinary/<name>/.
+// The source is written into tempDir, so only the binaries land in dir.
+func measureNewBinaries(ctx context.Context, tempDir string, dir NamedDir, count int, measurements *collector) error {
+	sourceDir := filepath.Join(tempDir, "probe-program")
+	if err := os.MkdirAll(sourceDir, 0o755); err != nil {
+		return fmt.Errorf("create probe program folder: %w", err)
+	}
+	if err := os.WriteFile(filepath.Join(sourceDir, "main.go"), []byte(probeProgramSource), 0o644); err != nil {
+		return fmt.Errorf("write probe program: %w", err)
+	}
+	if err := os.WriteFile(filepath.Join(sourceDir, "go.mod"), []byte(probeProgramModule), 0o644); err != nil {
+		return fmt.Errorf("write probe program module: %w", err)
+	}
+	binaryDir, err := os.MkdirTemp(dir.Path, probeFolderPrefix)
+	if err != nil {
+		return fmt.Errorf("create folder in %s: %w", dir.Path, err)
+	}
+	defer os.RemoveAll(binaryDir)
+
+	firstRuns := make([]time.Duration, 0, count)
+	secondRuns := make([]time.Duration, 0, count)
+	for range count {
+		binary, err := linkProbeProgram(ctx, tempDir, sourceDir, binaryDir)
+		if err != nil {
+			return err
+		}
+		first, err := timeRun(ctx, binary)
+		if err != nil {
+			return err
+		}
+		second, err := timeRun(ctx, binary)
+		if err != nil {
+			return err
+		}
+		firstRuns = append(firstRuns, first)
+		secondRuns = append(secondRuns, second)
+	}
+	prefix := groupNewBinary + "/" + dir.Name + "/"
+	measurements.add(prefix+"first_run_ms", unitMilliseconds, milliseconds(median(firstRuns)))
+	measurements.add(prefix+"second_run_ms", unitMilliseconds, milliseconds(median(secondRuns)))
+	return nil
+}
+
+// linkProbeProgram builds the program in sourceDir into binaryDir under a random build ID and returns the binary's path.
+// So that every machine links it the same way, the build turns off the workspace, the go env file, GOFLAGS and cgo.
+// It uses the local toolchain with its default experiments and amd64 level.
+// The go command's work folder, build cache and user config are inside tempDir, and its telemetry is off.
+// A ctx cancelled during the build lets the build finish and then returns the context's error.
+func linkProbeProgram(ctx context.Context, tempDir, sourceDir, binaryDir string) (string, error) {
+	buildID := make([]byte, buildIDBytes)
+	if _, err := rand.Read(buildID); err != nil {
+		return "", fmt.Errorf("draw build ID: %w", err)
+	}
+	buildIDHex := hex.EncodeToString(buildID)
+	binary := filepath.Join(binaryDir, "probe-"+buildIDHex)
+	configEntry, err := goConfigWithoutTelemetry(tempDir)
+	if err != nil {
+		return "", err
+	}
+	// The build does not take ctx.
+	// A signalled go command exits without waiting for its compiler and linker.
+	// Those would still write into tempDir.
+	build := exec.Command(goBinary, "build", "-o", binary, "-ldflags=-B=0x"+buildIDHex, ".")
+	build.Dir = sourceDir
+	// An empty value falls back to the go env file, so GOENV=off is what makes the empty ones mean the default.
+	build.Env = append(os.Environ(), "GOWORK=off", "GOENV=off", "GOFLAGS=", "CGO_ENABLED=0",
+		"GOTOOLCHAIN=local", "GOEXPERIMENT=", "GOAMD64=", "GOTMPDIR="+tempDir,
+		"GOCACHE="+filepath.Join(tempDir, buildCacheName), "GOCACHEPROG=", configEntry)
+	if out, err := build.CombinedOutput(); err != nil {
+		return "", fmt.Errorf("build probe program: %w: %s", err, out)
+	}
+	if err := ctx.Err(); err != nil {
+		return "", fmt.Errorf("build probe program: %w", err)
+	}
+	return binary, nil
+}
+
+func timeRun(ctx context.Context, binary string) (time.Duration, error) {
+	started := time.Now()
+	if err := exec.CommandContext(ctx, binary).Run(); err != nil {
+		return 0, fmt.Errorf("run %s: %w", binary, err)
+	}
+	return time.Since(started), nil
+}
