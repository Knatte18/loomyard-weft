+					t.Errorf("Prepare() error = %v; want nil", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+				t.Fatalf("Prepare() error = %v; want a refusal containing %q", err, tt.wantErr)
