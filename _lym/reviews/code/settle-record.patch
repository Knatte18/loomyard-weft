+background_shell_wait_min: 10  # minutes an outstanding background shell of either signal may run before the wait logs it once and shows it in the wait marker; it also expires a waiting turn end whose every outstanding task is a non-awaited shell, an ungated one with an output file missing into a held turn end and a gated one with every output file present into a done, while a fork or an awaited shell never expires; 0 or negative is a config error, not "unlimited"
 send_ready_timeout_s: 60  # seconds a verified send (the start prompt, a skill-load message and every injected prompt) waits for an idle session before it fails as busy, ending at the run's deadline for a gate send; binds only an engine that reads session idleness, any other keeps a ready-pane check with no wait; 0 or negative is a config error
 submit_confirm_timeout_s: 30  # seconds from the moment a verified send begins typing within which it must be seen to land before it fails as not landed, ending at the run's deadline for a gate send; binds only an engine that reads its input box, any other has no window; 0 or negative is a config error
