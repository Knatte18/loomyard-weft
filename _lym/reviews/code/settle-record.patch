diff --git a/internal/partsparser/check.go b/internal/partsparser/check.go
new file mode 100644
index 00000000..02469cda
--- /dev/null
+++ b/internal/partsparser/check.go
@@ -0,0 +1,199 @@
+// check.go declares Finding, Check, which judges a parsed parts file against the decision record's ids, and Validate, which runs Parse and Check over the files on disk.
+
+package partsparser
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/discussionparser"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+)
+
+// Finding is one violation the parts check found.
+// Part names the part, or the shared spot's path, the finding is about; Detail ends in its way forward.
+type Finding struct {
+	Check  string
+	Part   string
+	Detail string
+}
+
+const (
+	checkPartsMissing        = "parts-missing"
+	checkPartsMalformed      = "parts-malformed"
+	checkPartsNone           = "parts-none"
+	checkPartsOverMax        = "parts-over-max"
+	checkPartNameInvalid     = "part-name-invalid"
+	checkPartNameRepeated    = "part-name-repeated"
+	checkPartNameArchive     = "part-name-archive"
+	checkPartDependencyOrder = "part-dependency-order"
+	checkSpotNeederUnknown   = "spot-needer-unknown"
+	checkSpotExportOrder     = "spot-export-order"
+	checkExportClaimedTwice  = "export-claimed-twice"
+	checkSpotInArea          = "spot-in-area"
+	checkDecisionUnnamed     = "decision-unnamed"
+	checkDecisionUnknown     = "decision-unknown"
+)
+
+// decisionHolder is a part or shared spot, by its name or path, with the decision ids it names.
+type decisionHolder struct {
+	label     string
+	decisions []string
+}
+
+// Check judges parts against the record's decision ids and the most parts max allows, and returns one Finding per violation.
+func Check(parts *Parts, decisionIDs []string, max int) []Finding {
+	var findings []Finding
+	add := func(check, part, detail string) {
+		findings = append(findings, Finding{Check: check, Part: part, Detail: detail})
+	}
+
+	if len(parts.Parts) == 0 {
+		add(checkPartsNone, "", "the file holds no part; way forward: write at least one part, a single part covering the whole task when it does not split")
+	}
+	if len(parts.Parts) > max {
+		add(checkPartsOverMax, "", fmt.Sprintf("the file holds %d parts and at most %d are allowed; way forward: merge parts until at most %d remain", len(parts.Parts), max, max))
+	}
+
+	index := map[string]int{}
+	for i, part := range parts.Parts {
+		if err := seatengine.ValidateSeatName(part.Name); err != nil {
+			add(checkPartNameInvalid, part.Name, fmt.Sprintf("part name %q is not usable: %v; way forward: rename the part to a lower-case name that starts with a letter", part.Name, err))
+		}
+		if earlier, repeated := index[part.Name]; repeated {
+			add(checkPartNameRepeated, part.Name, fmt.Sprintf("part name %q is already held by part %d; way forward: rename one of the two parts", part.Name, earlier+1))
+		} else {
+			index[part.Name] = i
+		}
+		if strings.HasPrefix(part.Name, ArchivePrefix) {
+			add(checkPartNameArchive, part.Name, fmt.Sprintf("part name %q begins with %q, so its directory would be skipped as an earlier archive; way forward: rename the part", part.Name, ArchivePrefix))
+		}
+	}
+
+	for i, part := range parts.Parts {
+		for _, dependency := range part.DependsOn {
+			if at, known := index[dependency]; !known || at >= i {
+				add(checkPartDependencyOrder, part.Name, fmt.Sprintf("part %q depends on %q, which is no earlier part; way forward: move the depended-on part above it in the file or drop the dependency", part.Name, dependency))
+			}
+		}
+	}
+
+	exportOwner := map[string]int{}
+	for i, part := range parts.Parts {
+		for _, export := range part.Exports {
+			if _, claimed := exportOwner[export]; !claimed {
+				exportOwner[export] = i
+			}
+		}
+	}
+
+	for _, spot := range parts.Spots {
+		firstNeeder := -1
+		for _, name := range spot.NeededBy {
+			at, known := index[name]
+			if !known {
+				add(checkSpotNeederUnknown, spot.Path, fmt.Sprintf("shared spot %q is needed by %q, which is no part; way forward: name a part of the file", spot.Path, name))
+				continue
+			}
+			if firstNeeder < 0 || at < firstNeeder {
+				firstNeeder = at
+			}
+		}
+		if firstNeeder < 0 {
+			continue
+		}
+		for _, use := range spot.Uses {
+			if owner, exported := exportOwner[use]; exported && owner > firstNeeder {
+				add(checkSpotExportOrder, spot.Path, fmt.Sprintf("shared spot %q uses %q, exported by part %q, which comes after %q, the first part that needs the spot; way forward: reorder the parts or move the dependency into a part", spot.Path, use, parts.Parts[owner].Name, parts.Parts[firstNeeder].Name))
+			}
+		}
+	}
+
+	claimant := map[string]string{}
+	reported := map[string]bool{}
+	claim := func(ref, owner string) {
+		first, claimed := claimant[ref]
+		if !claimed {
+			claimant[ref] = owner
+			return
+		}
+		if first != owner && !reported[ref] {
+			reported[ref] = true
+			add(checkExportClaimedTwice, owner, fmt.Sprintf("%q is exported by both %s and %s; way forward: keep the export on one of them", ref, first, owner))
+		}
+	}
+	for _, part := range parts.Parts {
+		for _, export := range part.Exports {
+			claim(export, fmt.Sprintf("part %q", part.Name))
+		}
+	}
+	for _, spot := range parts.Spots {
+		for _, export := range spot.Exports {
+			claim(export, fmt.Sprintf("shared spot %q", spot.Path))
+		}
+	}
+
+	for _, spot := range parts.Spots {
+		for _, part := range parts.Parts {
+			if slices.Contains(part.Area, spot.Path) {
+				add(checkSpotInArea, part.Name, fmt.Sprintf("part %q lists the shared spot %q as a file entry of its area; way forward: drop it from the area, since the chair writes the spot", part.Name, spot.Path))
+			}
+		}
+	}
+
+	named := map[string]bool{}
+	var holders []decisionHolder
+	for _, part := range parts.Parts {
+		holders = append(holders, decisionHolder{part.Name, part.Decisions})
+	}
+	for _, spot := range parts.Spots {
+		holders = append(holders, decisionHolder{spot.Path, spot.Decisions})
+	}
+	for _, id := range decisionIDs {
+		for _, holder := range holders {
+			if slices.Contains(holder.decisions, id) {
+				named[id] = true
+			}
+		}
+		if !named[id] {
+			add(checkDecisionUnnamed, "", fmt.Sprintf("decision %s of the record is named by no part or shared spot; way forward: name it in the part or shared spot that carries it", id))
+		}
+	}
+	for _, holder := range holders {
+		for _, id := range holder.decisions {
+			if !slices.Contains(decisionIDs, id) {
+				add(checkDecisionUnknown, holder.label, fmt.Sprintf("%q names decision %s, which the record does not hold; way forward: drop or correct the id", holder.label, id))
+			}
+		}
+	}
+	return findings
+}
+
+// Validate is the one parts check the parts gate and `lym loom validate-parts` run: it reads the parts file under anchorPath, parses it, reads the decision record at recordPath and checks the parts against its decision ids and the most parts max allows.
+// An absent parts file is a parts-missing finding and a file Parse refuses is a parts-malformed finding.
+// Any read error, an absent record included, is returned: the record is Discussion-Write's committed output, which the Parts-Write agent cannot write.
+func Validate(anchorPath, recordPath string, max int) ([]Finding, error) {
+	record, err := os.ReadFile(recordPath)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil, fmt.Errorf("the decision record %s is absent, and the Parts-Write agent cannot write it; run lym loom validate-discussion and tell the parent: %w", recordPath, err)
+		}
+		return nil, fmt.Errorf("read the decision record %s: %w", recordPath, err)
+	}
+	data, err := os.ReadFile(File(anchorPath))
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return []Finding{{Check: checkPartsMissing, Detail: fmt.Sprintf("%s does not exist; way forward: write the parts file there in the format of contracts/specs/loom-parts-spec.md", DirRel()+"/"+fileName)}}, nil
+		}
+		return nil, fmt.Errorf("read the parts file %s: %w", File(anchorPath), err)
+	}
+	parts, err := Parse(data)
+	if err != nil {
+		return []Finding{{Check: checkPartsMalformed, Detail: err.Error()}}, nil
+	}
+	return Check(parts, discussionparser.DecisionIDs(record), max), nil
+}
diff --git a/internal/partsparser/check_test.go b/internal/partsparser/check_test.go
new file mode 100644
index 00000000..29e76527
--- /dev/null
+++ b/internal/partsparser/check_test.go
@@ -0,0 +1,148 @@
+//go:build tier0
+
+// check_test.go tests Check, one row per check, and Validate over a temporary anchor.
+
+package partsparser
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+)
+
+var validDecisionIDs = []string{"D1", "D2", "D3"}
+
+func checkNames(findings []Finding) []string {
+	names := make([]string, len(findings))
+	for i, finding := range findings {
+		names[i] = finding.Check
+	}
+	return names
+}
+
+func TestCheck(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		mutate  func(*Parts)
+		ids     []string
+		max     int
+		want    []string
+		wantIn  string
+		wantFor string
+	}{
+		{name: "a valid file passes, a spot inside an area's package and a spot using the first needer's export included", ids: validDecisionIDs, max: 6},
+		{name: "parts-none", mutate: func(p *Parts) { p.Parts, p.Spots = nil, nil }, ids: validDecisionIDs, max: 6, want: []string{"parts-none", "decision-unnamed", "decision-unnamed", "decision-unnamed"}, wantIn: "single part covering the whole task"},
+		{name: "parts-over-max", ids: validDecisionIDs, max: 1, want: []string{"parts-over-max"}, wantIn: "merge parts"},
+		{name: "part-name-invalid", mutate: func(p *Parts) { p.Parts = append(p.Parts, Part{Name: "1bad", Decisions: []string{"D1"}}) }, ids: validDecisionIDs, max: 6, want: []string{"part-name-invalid"}, wantIn: "starts with a letter", wantFor: "1bad"},
+		{name: "part-name-repeated", mutate: func(p *Parts) { p.Parts = append(p.Parts, Part{Name: "core", Decisions: []string{"D1"}}) }, ids: validDecisionIDs, max: 6, want: []string{"part-name-repeated"}, wantIn: "rename one of the two", wantFor: "core"},
+		{name: "part-name-archive", mutate: func(p *Parts) { p.Parts = append(p.Parts, Part{Name: "archive-old", Decisions: []string{"D1"}}) }, ids: validDecisionIDs, max: 6, want: []string{"part-name-archive"}, wantIn: "rename the part", wantFor: "archive-old"},
+		{name: "part-dependency-order, a later part", mutate: func(p *Parts) { p.Parts[0].DependsOn = []string{"wiring"} }, ids: validDecisionIDs, max: 6, want: []string{"part-dependency-order"}, wantIn: "move the depended-on part above it", wantFor: "core"},
+		{name: "part-dependency-order, an unknown part", mutate: func(p *Parts) { p.Parts[1].DependsOn = []string{"ghost"} }, ids: validDecisionIDs, max: 6, want: []string{"part-dependency-order"}, wantFor: "wiring"},
+		{name: "spot-needer-unknown", mutate: func(p *Parts) { p.Spots[1].NeededBy = []string{"ghost"} }, ids: validDecisionIDs, max: 6, want: []string{"spot-needer-unknown"}, wantIn: "name a part of the file", wantFor: "cmd/main.go"},
+		{
+			name: "spot-export-order",
+			mutate: func(p *Parts) {
+				p.Parts[1].Exports = []string{"plan:internal/w#W"}
+				p.Spots[0].Uses = append(p.Spots[0].Uses, "plan:internal/w#W")
+			},
+			ids: validDecisionIDs, max: 6, want: []string{"spot-export-order"}, wantIn: "reorder the parts or move the dependency", wantFor: "internal/reg/reg.go",
+		},
+		{name: "export-claimed-twice, by two parts", mutate: func(p *Parts) { p.Parts[1].Exports = []string{"internal/x/newfile.go"} }, ids: validDecisionIDs, max: 6, want: []string{"export-claimed-twice"}, wantIn: "keep the export on one of them"},
+		{name: "export-claimed-twice, by a part and a spot", mutate: func(p *Parts) { p.Spots[0].Exports = append(p.Spots[0].Exports, "plan:internal/x#NewThing") }, ids: validDecisionIDs, max: 6, want: []string{"export-claimed-twice"}},
+		{name: "spot-in-area", mutate: func(p *Parts) { p.Parts[1].Area = append(p.Parts[1].Area, "cmd/main.go") }, ids: validDecisionIDs, max: 6, want: []string{"spot-in-area"}, wantIn: "drop it from the area", wantFor: "wiring"},
+		{name: "decision-unnamed", ids: append([]string{"D4"}, validDecisionIDs...), max: 6, want: []string{"decision-unnamed"}, wantIn: "D4"},
+		{name: "decision-unknown", mutate: func(p *Parts) { p.Parts[0].Decisions = []string{"D1", "D9"} }, ids: validDecisionIDs, max: 6, want: []string{"decision-unknown"}, wantIn: "drop or correct the id", wantFor: "core"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			parts := mustParse(t, validParts)
+			if tt.mutate != nil {
+				tt.mutate(parts)
+			}
+			got := Check(parts, tt.ids, tt.max)
+			if names := checkNames(got); !slices.Equal(names, tt.want) {
+				t.Fatalf("Check() findings = %v; want %v", names, tt.want)
+			}
+			for _, finding := range got {
+				if !strings.Contains(finding.Detail, "way forward:") {
+					t.Errorf("finding %+v: Detail does not end in a way forward", finding)
+				}
+			}
+			if len(got) == 0 {
+				return
+			}
+			if !strings.Contains(got[0].Detail, tt.wantIn) {
+				t.Errorf("Check() first Detail = %q; want it to contain %q", got[0].Detail, tt.wantIn)
+			}
+			if tt.wantFor != "" && got[0].Part != tt.wantFor {
+				t.Errorf("Check() first Part = %q; want %q", got[0].Part, tt.wantFor)
+			}
+		})
+	}
+}
+
+func TestValidate(t *testing.T) {
+	t.Parallel()
+
+	const record = "## Decisions\n\n### D1 — a\n\nx.\n\n### D2 — b\n\ny.\n\n### D3 — c\n\nz.\n"
+
+	// seed writes the record and, when parts is non-empty, the parts file under a fresh anchor.
+	seed := func(t *testing.T, recordText, partsText string) (anchor, recordPath string) {
+		t.Helper()
+		anchor = t.TempDir()
+		recordPath = filepath.Join(anchor, "record.md")
+		if recordText != "" {
+			if err := os.WriteFile(recordPath, []byte(recordText), 0o644); err != nil {
+				t.Fatalf("WriteFile(record) = %v; want nil", err)
+			}
+		}
+		if partsText != "" {
+			if err := os.MkdirAll(Dir(anchor), 0o755); err != nil {
+				t.Fatalf("MkdirAll(%q) = %v; want nil", Dir(anchor), err)
+			}
+			if err := os.WriteFile(File(anchor), []byte(partsText), 0o644); err != nil {
+				t.Fatalf("WriteFile(parts) = %v; want nil", err)
+			}
+		}
+		return anchor, recordPath
+	}
+
+	tests := []struct {
+		name       string
+		recordText string
+		partsText  string
+		want       []string
+	}{
+		{name: "a valid file and record", recordText: record, partsText: validParts},
+		{name: "an absent parts file", recordText: record, want: []string{"parts-missing"}},
+		{name: "a malformed parts file", recordText: record, partsText: "not a parts file\n", want: []string{"parts-malformed"}},
+		{name: "a check finding passes through", recordText: record + "\n### D4 — d\n\nw.\n", partsText: validParts, want: []string{"decision-unnamed"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			anchor, recordPath := seed(t, tt.recordText, tt.partsText)
+			got, err := Validate(anchor, recordPath, 6)
+			if err != nil {
+				t.Fatalf("Validate() = _, %v; want nil error", err)
+			}
+			if names := checkNames(got); !slices.Equal(names, tt.want) {
+				t.Errorf("Validate() findings = %v; want %v", names, tt.want)
+			}
+		})
+	}
+
+	t.Run("an absent record is an error naming validate-discussion", func(t *testing.T) {
+		t.Parallel()
+		anchor, recordPath := seed(t, "", validParts)
+		findings, err := Validate(anchor, recordPath, 6)
+		if err == nil || !strings.Contains(err.Error(), "lym loom validate-discussion") {
+			t.Errorf("Validate() = %v, %v; want an error naming lym loom validate-discussion", findings, err)
+		}
+	})
+}
