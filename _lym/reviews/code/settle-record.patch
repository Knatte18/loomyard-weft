-printf '%s\n' "$prompt" > "$fan/handler.prompt.md"
-if grep -l '{{' "$fan"/*.prompt.md "$W"/.bench/instr/*.md; then echo "leftover placeholder" >&2; exit 1; fi
-ls "$fan"
