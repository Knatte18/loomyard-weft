+			fx.commits = append(fx.commits, msg)
+			if fx.commitErr != nil {
+				return fx.commitErr(msg)
+			}
+			return nil
+		},
+		RecordsHead: func() (string, error) { return "records-head", nil },
+		Clock:       &fakeClock{now: time.Unix(0, 0)},
+	}
