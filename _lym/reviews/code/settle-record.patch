+diff --git a/internal/testkit/tmuxkit/main_light.go b/internal/testkit/tmuxkit/main_light.go
+new file mode 100644
+index 00000000..8251d247
+--- /dev/null
++++ b/internal/testkit/tmuxkit/main_light.go
+@@ -0,0 +1,51 @@
++//go:build !tier2 && !tier3
++
++package tmuxkit
++
++import (
++	"os"
++	"path/filepath"
++	"strconv"
++	"strings"
++	"testing"
++)
++
++// Main is the trial's light TestMain path for the tiers with no tmux: a private temp directory, no import of lymtemp, proc, lock or agentname.
++func Main(m *testing.M) int {
++	dir, err := lightDir()
++	if err != nil {
++		return 1
++	}
++	_ = os.Setenv("TMPDIR", dir)
++	_ = os.Setenv("TMUX_TMPDIR", dir)
++	_ = os.Setenv("GIT_CEILING_DIRECTORIES", dir)
++	_ = os.Unsetenv("LYM_REED_TMUX_CONF")
++	code := m.Run()
++	_ = os.RemoveAll(dir)
++	return code
++}
++
++// ServerEnviron mirrors the full kit's scrub with the agent variable names spelled out.
++func ServerEnviron(environ []string) []string {
++	clean := make([]string, 0, len(environ))
++	for _, entry := range environ {
++		key, _, _ := strings.Cut(entry, "=")
++		switch {
++		case key == "CLAUDECODE", strings.HasPrefix(key, "CLAUDE_CODE_"):
++		case key == "LYM_TRACE_ID", key == "LYM_STRAND_NAME", key == "LYM_PARENT":
++		default:
++			clean = append(clean, entry)
++		}
++	}
++	return clean
++}
++
++// lightDir creates the private temp directory in the layout lymtemp uses, <system temp>/lym-<uid>/r<random>, so tests that read the run directory's place find it where they expect.
++// The directory is created without lymtemp, whose lock import the light path cuts, so it has no owner lock and no dead-owner sweep.
++func lightDir() (string, error) {
++	base := filepath.Join(os.TempDir(), "lym-"+strconv.Itoa(os.Getuid()))
++	if err := os.MkdirAll(base, 0o700); err != nil {
++		return "", err
++	}
++	return os.MkdirTemp(base, "r")
++}
