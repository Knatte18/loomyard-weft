@@ -0,0 +1,288 @@
+// compare_test.go covers the comparison of the engines' manifests, the prompt-side items and the unmet requirements.
+// It also covers the manifest-only seams, the preparation of each engine and the seat catalog's builder.
+// It runs over fake engines and fixture tables.
+
+package shuttleparity
+
+import (
+	"errors"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/agentconfig"
+	"github.com/Knatte18/loomyard/internal/editdirective"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+	"github.com/Knatte18/loomyard/internal/testkit/shuttlefake"
+	"github.com/Knatte18/loomyard/internal/testkit/stencilkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// manifestEngine is a fake engine whose Prepare runs a given function over the run directory and the spec.
+// It meets the fork requirement when forks is set, and no other.
+type manifestEngine struct {
+	*shuttlefake.Engine
+	forks bool
+}
+
+// Supports reports whether the engine meets req.
+func (e *manifestEngine) Supports(req shuttleengine.Requirement) bool {
+	return e.forks && req == shuttleengine.RequirementForks
+}
+
+// newManifestEngine returns a fake engine whose Prepare returns prepare's error after running it.
+func newManifestEngine(forks bool, prepare func(runDir string, spec shuttleengine.Spec) error) *manifestEngine {
+	fake := &shuttlefake.Engine{
+		PrepareFn: func(runDir string, spec shuttleengine.Spec, _ shuttleengine.Config) (shuttleengine.Launch, error) {
+			return shuttleengine.Launch{}, prepare(runDir, spec)
+		},
+	}
+	return &manifestEngine{Engine: fake, forks: forks}
+}
+
+// writesManifest returns a Prepare function that writes m into the run directory.
+func writesManifest(m shuttleengine.Manifest) func(string, shuttleengine.Spec) error {
+	return func(runDir string, _ shuttleengine.Spec) error { return shuttleengine.WriteManifest(runDir, m) }
+}
+
+// engineSetOf returns a set of the two compared engines.
+func engineSetOf(reference, compared shuttleengine.Engine) shuttleengine.EngineSet {
+	return shuttleengine.NewEngineSet(ReferenceEngine, map[string]shuttleengine.Engine{ReferenceEngine: reference, ComparedEngine: compared})
+}
+
+// manifestOf returns a manifest holding items.
+func manifestOf(items ...shuttleengine.ManifestItem) shuttleengine.Manifest {
+	return shuttleengine.Manifest{Items: items}
+}
+
+// item returns a delivered item of channel and key, keyed to engine when engine is not empty.
+func item(channel shuttleengine.ManifestChannel, key, engine string) shuttleengine.ManifestItem {
+	return shuttleengine.ManifestItem{Channel: channel, Key: key, Engine: engine, Delivery: shuttleengine.DeliveryDelivered}
+}
+
+// TestCompare covers Compare, PromptItems, Unmet, UnrunHooks, PrepareEach and seatsOf.
+func TestCompare(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("Compare", func(t *testing.T) {
+		t.Parallel()
+		passage := item(shuttleengine.ChannelStandingPassage, "agents-prompt", "")
+		fileEntry := item(shuttleengine.ChannelInstructionSource, "heddle-file/agents-file", "")
+		claudeOnly := item(shuttleengine.ChannelInstructionSource, "heddle-file/claude-file", ReferenceEngine)
+		forkDeny := item(shuttleengine.ChannelGuard, shuttleengine.WebsterForkDenyKey, "")
+		unrun := shuttleengine.ManifestItem{Channel: shuttleengine.ChannelPluginContext, Key: "p@m/emit", Delivery: shuttleengine.DeliveryOmitted, Reason: "unrun"}
+		held := item(shuttleengine.ChannelPluginContext, "p@m/emit", "")
+		extra := item(shuttleengine.ChannelNotice, "extra", "")
+		tests := []struct {
+			name      string
+			claude    shuttleengine.Manifest
+			codex     shuttleengine.Manifest
+			codexFork bool
+			want      []shuttleengine.ManifestItem
+		}{
+			{name: "SharedHeddleItemsAbsentFromCodexAreMissing", claude: manifestOf(passage, fileEntry), codex: manifestOf(), want: []shuttleengine.ManifestItem{passage, fileEntry}},
+			{name: "ItemKeyedToClaudeIsNotMissing", claude: manifestOf(claudeOnly), codex: manifestOf()},
+			{name: "OmittedPluginContextCountsPresent", claude: manifestOf(held), codex: manifestOf(unrun)},
+			{name: "ExtraCodexItemIsNoFinding", claude: manifestOf(passage), codex: manifestOf(passage, extra)},
+			{name: "ForkDenyIsNotAskedOfAnEngineWithoutForks", claude: manifestOf(forkDeny), codex: manifestOf()},
+			{name: "ForkDenyIsAskedOfAnEngineWithForks", claude: manifestOf(forkDeny, passage), codex: manifestOf(passage), codexFork: true, want: []shuttleengine.ManifestItem{forkDeny}},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				engines := engineSetOf(newManifestEngine(true, nil), newManifestEngine(tt.codexFork, nil))
+				got := Compare(engines, map[string]shuttleengine.Manifest{ReferenceEngine: tt.claude, ComparedEngine: tt.codex})
+				if len(got) != len(tt.want) || (len(got) > 0 && !reflect.DeepEqual(got, tt.want)) {
+					t.Errorf("Compare() = %+v; want %+v", got, tt.want)
+				}
+			})
+		}
+	})
+
+	t.Run("PromptItems", func(t *testing.T) {
+		t.Parallel()
+		stencils := stencilkit.Seed(t)
+		directive, err := editdirective.Directive(stencils, ReferenceEngine)
+		if err != nil {
+			t.Fatalf("editdirective.Directive() error: %v", err)
+		}
+		tests := []struct {
+			name   string
+			prompt string
+			want   []shuttleengine.ManifestItem
+		}{
+			{name: "PromptHoldingTheEnginesCopy", prompt: "Do it.\n" + directive, want: []shuttleengine.ManifestItem{item(shuttleengine.ChannelEditDirective, "edit-directive", "")}},
+			{name: "PromptWithoutIt", prompt: "Do it."},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				if got := PromptItems(stencils, ReferenceEngine, tt.prompt); !reflect.DeepEqual(got, tt.want) {
+					t.Errorf("PromptItems() = %+v; want %+v", got, tt.want)
+				}
+			})
+		}
+	})
+
+	t.Run("Unmet", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name   string
+			engine *manifestEngine
+			spec   shuttleengine.Spec
+			want   []shuttleengine.Requirement
+		}{
+			{name: "ForkSubagentsOnAnEngineMeetingNone", engine: newManifestEngine(false, nil), spec: shuttleengine.Spec{ForkSubagents: true}, want: []shuttleengine.Requirement{shuttleengine.RequirementForks}},
+			{name: "PlainSpec", engine: newManifestEngine(false, nil), spec: shuttleengine.Spec{}},
+			{name: "ListedRequirementThenForks", engine: newManifestEngine(false, nil), spec: shuttleengine.Spec{ForkSubagents: true, Requires: []shuttleengine.Requirement{shuttleengine.RequirementBackgroundWake}}, want: []shuttleengine.Requirement{shuttleengine.RequirementBackgroundWake, shuttleengine.RequirementForks}},
+			{name: "ForkSubagentsOnAnEngineWithForks", engine: newManifestEngine(true, nil), spec: shuttleengine.Spec{ForkSubagents: true}},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				if got := Unmet(tt.engine, tt.spec); !reflect.DeepEqual(got, tt.want) {
+					t.Errorf("Unmet() = %v; want %v", got, tt.want)
+				}
+			})
+		}
+	})
+
+	t.Run("UnrunHooks", func(t *testing.T) {
+		t.Parallel()
+		if _, err := UnrunHooks(shuttleengine.HookRun{}); err != shuttleengine.ErrHookUnrun {
+			t.Errorf("UnrunHooks() error = %v; want shuttleengine.ErrHookUnrun itself, unwrapped", err)
+		}
+		if err := ConfiguredSandbox("codex", "home", "dir"); err != nil {
+			t.Errorf("ConfiguredSandbox() error = %v; want a sandbox that starts", err)
+		}
+	})
+
+	t.Run("PrepareEach", func(t *testing.T) {
+		t.Parallel()
+		stencils := stencilkit.Seed(t)
+		cfg := shuttleengine.Config{Agents: shuttlefake.Agents(t)}
+		roleSkills, err := cfg.Agents.Skills(agentconfig.RoleDarn, nil)
+		if err != nil {
+			t.Fatalf("Skills() error: %v", err)
+		}
+		held := manifestOf(item(shuttleengine.ChannelNotice, "n", ""))
+		specOf := func(mutate func(*shuttleengine.Spec)) map[string]shuttleengine.Spec {
+			spec := shuttleengine.Spec{Prompt: "p", Role: "darn"}
+			mutate(&spec)
+			return map[string]shuttleengine.Spec{ReferenceEngine: spec, ComparedEngine: spec}
+		}
+		var received []shuttleengine.Spec
+		recording := func(m shuttleengine.Manifest) func(string, shuttleengine.Spec) error {
+			return func(runDir string, spec shuttleengine.Spec) error {
+				received = append(received, spec)
+				return writesManifest(m)(runDir, spec)
+			}
+		}
+		failing := errors.New("prepare failed")
+		tests := []struct {
+			name     string
+			compared func() *manifestEngine
+			specs    map[string]shuttleengine.Spec
+			wantErr  []string
+			// wantSkills is the skills each engine's Prepare is to receive for a spec with a role.
+			wantSkills []string
+		}{
+			{name: "ReadsEachManifest", compared: func() *manifestEngine { return newManifestEngine(false, recording(held)) }, specs: specOf(func(*shuttleengine.Spec) {})},
+			{name: "FailingPrepareNamesItsEngine", compared: func() *manifestEngine {
+				return newManifestEngine(false, func(string, shuttleengine.Spec) error { return failing })
+			}, specs: specOf(func(*shuttleengine.Spec) {}), wantErr: []string{ComparedEngine, "prepare failed"}},
+			{name: "NoManifestNamesTheEngineAndTheWriter", compared: func() *manifestEngine {
+				return newManifestEngine(false, func(string, shuttleengine.Spec) error { return nil })
+			}, specs: specOf(func(*shuttleengine.Spec) {}), wantErr: []string{ComparedEngine, "shuttleengine.WriteManifest"}},
+			{
+				name: "RoleSkillsThenTheSpecsOwn", compared: func() *manifestEngine { return newManifestEngine(false, recording(held)) },
+				specs: specOf(func(spec *shuttleengine.Spec) {
+					spec.ConfigRole, spec.Skills = agentconfig.RoleDarn, []string{"own:skill"}
+				}),
+				wantSkills: append(append([]string{}, roleSkills...), "own:skill"),
+			},
+			{
+				name: "RoleWithNoSkillListIsNamed", compared: func() *manifestEngine { return newManifestEngine(false, recording(held)) },
+				specs:   specOf(func(spec *shuttleengine.Spec) { spec.ConfigRole = "no-such-role" }),
+				wantErr: []string{"no-such-role"},
+			},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				received = nil
+				engines := engineSetOf(newManifestEngine(false, recording(held)), tt.compared())
+				manifests, err := PrepareEach(engines, tt.specs, stencils, t.TempDir(), cfg)
+				if len(tt.wantErr) > 0 {
+					if err == nil {
+						t.Fatal("PrepareEach() error = nil; want a refusal")
+					}
+					for _, want := range tt.wantErr {
+						if !strings.Contains(err.Error(), want) {
+							t.Errorf("PrepareEach() error %q does not contain %q", err, want)
+						}
+					}
+					return
+				}
+				if err != nil {
+					t.Fatalf("PrepareEach() error: %v", err)
+				}
+				for _, engine := range []string{ReferenceEngine, ComparedEngine} {
+					if got := manifests[engine].Items; len(got) != 1 || got[0].Key != "n" {
+						t.Errorf("manifest of %s = %+v; want the one item its Prepare wrote", engine, got)
+					}
+				}
+				for _, spec := range received {
+					if tt.wantSkills != nil && !reflect.DeepEqual(spec.Skills, tt.wantSkills) {
+						t.Errorf("Prepare received skills %v; want %v", spec.Skills, tt.wantSkills)
+					}
+				}
+			})
+		}
+	})
+
+	t.Run("seatsOf", func(t *testing.T) {
+		t.Parallel()
+		stencils := stencilkit.Seed(t)
+		writeFixtureFile(t, stencilstore.Path(stencils, "parity-test-bare"), "Lead {{.seat_name}}.\n")
+		env := SeatEnv{
+			StencilsDir: stencils, Dir: t.TempDir(),
+			Location:  &lymcwd.Location{HubPath: t.TempDir(), WorktreeName: "wt", AnchorRel: "."},
+			Shortname: "ly", Slug: "task", ParentName: "ly:orch",
+		}
+		table := seatengine.Table{
+			RolePrefix: "parity",
+			Seats: []seatengine.Seat{{
+				Stencil:     "parity-test-bare",
+				ModelChoice: shuttleengine.ModelChoice{Engine: "x", Model: "opus", Effort: "high", Version: "5"},
+				Outputs:     []string{filepath.Join(env.Dir, "out.md")},
+			}},
+		}
+		cause := errors.New("no stand-in")
+		tables := []seatTable{
+			{Builder: "internal/x#First", Build: func(SeatEnv) ([]seatengine.Table, error) { return []seatengine.Table{table}, nil }},
+			{Builder: "internal/x#Second", Build: func(SeatEnv) ([]seatengine.Table, error) { return nil, cause }},
+		}
+
+		seats, failures := seatsOf(env, tables)
+		if len(seats) != 1 || seats[0].Name != "parity" || seats[0].Builder != "internal/x#First" {
+			t.Fatalf("seatsOf() seats = %+v; want the first entry's one seat", seats)
+		}
+		if len(failures) != 1 || !errors.Is(failures[0], cause) || !strings.Contains(failures[0].Error(), "internal/x#Second") || !strings.Contains(failures[0].Error(), "way forward") {
+			t.Errorf("seatsOf() failures = %v; want one naming the second builder, wrapping its error, with a way forward", failures)
+		}
+		for _, engine := range []string{ReferenceEngine, ComparedEngine} {
+			spec, err := seats[0].Specs(engine)
+			if err != nil {
+				t.Fatalf("Specs(%s) error: %v", engine, err)
+			}
+			if want := (shuttleengine.ModelChoice{Engine: engine}); spec.ModelChoice != want {
+				t.Errorf("Specs(%s) model choice = %+v; want the engine alone, %+v", engine, spec.ModelChoice, want)
+			}
+		}
+	})
+}
diff --git a/internal/shuttleparity/doc.go b/internal/shuttleparity/doc.go
new file mode 100644
index 00000000..038a89c0
--- /dev/null
+++ b/internal/shuttleparity/doc.go
@@ -0,0 +1,24 @@
+// Package shuttleparity compares what each engine gives a launched session, seat by seat.
+// It prepares one spec per engine with that engine's Prepare.
+// It reads back the launch manifest each writes, and reports every compared item the Codex manifest lacks of Claude's.
+//
+// UnrunHooks and ConfiguredSandbox are the plugin hook runner and the sandbox probe a manifest-only launch runs under:
+// neither runs a hook or Codex, so the manifest lists the configured sandbox mode and each plugin context as unrun.
+// PromptItems adds the prompt-side items an engine cannot see of its own launch.
+// PrepareEach prepares each engine of a set, and Compare names the compared items the Codex manifest lacks.
+// The Webster fork deny belongs to fork support.
+// Compare asks for it only when the Codex engine meets the fork requirement.
+// Unmet names the requirements of a spec an engine cannot meet.
+// A spec an engine cannot start is prepared and compared like any other, since Prepare refuses no requirement.
+//
+// The seat catalog lists every production seat table builder with the functions that hold its table and seat literals.
+// It builds each table on the worktree's configuration.
+// A run's own inputs are stand-ins, written under a directory the caller removes.
+// A builder that fails costs only its own seats, and the failure names the stand-in inputs to fix.
+// The catalog covers the tables built from code.
+// A recipe row whose seats an operator writes in config holds none in code.
+//
+// Report prepares one seat of the catalog on each engine of a set and returns both manifests, what the Codex one lacks,
+// and the requirements each engine does not meet.
+// It backs `lym shuttle manifest`.
+package shuttleparity
diff --git a/internal/shuttleparity/prepare.go b/internal/shuttleparity/prepare.go
new file mode 100644
index 00000000..8b8d78c8
--- /dev/null
+++ b/internal/shuttleparity/prepare.go
@@ -0,0 +1,129 @@
+// prepare.go runs each engine's Prepare on one spec per engine and compares the manifests the engines write.
+// It also holds the two seams a manifest-only launch runs under, the prompt-side items and the unmet requirements.
+
+package shuttleparity
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/editdirective"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// The names of the two engines the comparison runs between.
+// An engine's name is a registry key, so it may appear outside the engine's own directory.
+const (
+	// ReferenceEngine is the engine whose manifest the comparison asks the other engine to hold.
+	ReferenceEngine = "claude"
+	// ComparedEngine is the engine whose manifest the comparison checks.
+	ComparedEngine = "codex"
+)
+
+// editDirectiveKey is the key of the prompt-side edit directive item.
+const editDirectiveKey = "edit-directive"
+
+// UnrunHooks is a plugin hook runner that runs nothing.
+// It returns shuttleengine.ErrHookUnrun itself.
+// Each plugin session-start context is then listed by plugin and hook as omitted with that reason,
+// and no engine logs a hook to fix.
+func UnrunHooks(run shuttleengine.HookRun) ([]byte, error) {
+	return nil, shuttleengine.ErrHookUnrun
+}
+
+// ConfiguredSandbox is a sandbox probe that runs nothing and reports a sandbox that starts.
+// A launch then lists the sandbox mode codex.yaml configures: auto and workspace-write settle to workspace-write.
+func ConfiguredSandbox(bin, home, dir string) error {
+	return nil
+}
+
+// PromptItems returns the manifest items an engine cannot see of its own launch, since it is told no stencils directory.
+// It holds the edit-directive item when prompt carries engine's copy of the directive read from stencilsDir.
+// It holds none otherwise.
+func PromptItems(stencilsDir, engine, prompt string) []shuttleengine.ManifestItem {
+	directive, err := editdirective.Directive(stencilsDir, engine)
+	if err != nil || directive == "" || !strings.Contains(prompt, directive) {
+		return nil
+	}
+	return []shuttleengine.ManifestItem{{Channel: shuttleengine.ChannelEditDirective, Key: editDirectiveKey, Delivery: shuttleengine.DeliveryDelivered}}
+}
+
+// Unmet returns the requirements of spec that engine does not meet, in the order a start refuses them.
+// A spec that authorizes fork subagents requires fork support.
+// An engine that answers no requirement meets none.
+func Unmet(engine shuttleengine.Engine, spec shuttleengine.Spec) []shuttleengine.Requirement {
+	required := slices.Clone(spec.Requires)
+	if spec.ForkSubagents && !slices.Contains(required, shuttleengine.RequirementForks) {
+		required = append(required, shuttleengine.RequirementForks)
+	}
+	supporter, _ := engine.(shuttleengine.RequirementSupporter)
+	var unmet []shuttleengine.Requirement
+	for _, requirement := range required {
+		if supporter == nil || !supporter.Supports(requirement) {
+			unmet = append(unmet, requirement)
+		}
+	}
+	return unmet
+}
+
+// PrepareEach runs each engine of engines' Prepare with its own spec from specs, keyed by engine name.
+// Each engine prepares into <dir>/<engine>.
+// It first expands each spec's skills with cfg.Agents when the spec names a role, as a launch does.
+// It reads each record back and adds the prompt-side items of stencilsDir, and returns the manifests by engine name.
+// A Prepare error, an expansion error and an engine that writes no manifest are errors naming the engine.
+// Prepare refuses no requirement, so a spec an engine cannot start is prepared like any other.
+func PrepareEach(engines shuttleengine.EngineSet, specs map[string]shuttleengine.Spec, stencilsDir, dir string, cfg shuttleengine.Config) (map[string]shuttleengine.Manifest, error) {
+	manifests := make(map[string]shuttleengine.Manifest, len(specs))
+	for _, name := range engines.Names() {
+		engine, err := engines.Lookup(name)
+		if err != nil {
+			return nil, err
+		}
+		spec, ok := specs[name]
+		if !ok {
+			return nil, fmt.Errorf("shuttleparity: engine %s: no spec was given for it; way forward: give PrepareEach one spec per engine of the set", name)
+		}
+		if spec.ConfigRole != "" {
+			skills, err := cfg.Agents.Skills(spec.ConfigRole, spec.Skills)
+			if err != nil {
+				return nil, fmt.Errorf("shuttleparity: engine %s: expand the skills of role %q: %w", name, spec.ConfigRole, err)
+			}
+			spec.Skills = skills
+		}
+		runDir := filepath.Join(dir, name)
+		if err := os.MkdirAll(runDir, 0o755); err != nil {
+			return nil, fmt.Errorf("shuttleparity: engine %s: make its run directory: %w", name, err)
+		}
+		if _, err := engine.Prepare(runDir, spec, cfg); err != nil {
+			return nil, fmt.Errorf("shuttleparity: engine %s: prepare: %w", name, err)
+		}
+		manifest, found, err := shuttleengine.ReadManifest(filepath.Join(runDir, shuttleengine.ManifestFileName))
+		if err != nil {
+			return nil, fmt.Errorf("shuttleparity: engine %s: read its manifest: %w", name, err)
+		}
+		if !found {
+			return nil, fmt.Errorf("shuttleparity: engine %s: its Prepare wrote no manifest; way forward: have that engine's Prepare write its manifest through shuttleengine.WriteManifest", name)
+		}
+		manifest.Items = append(manifest.Items, PromptItems(stencilsDir, name, spec.Prompt)...)
+		manifests[name] = manifest
+	}
+	return manifests, nil
+}
+
+// Compare returns the compared items of the reference engine's manifest that the compared engine's manifest lacks.
+// It matches by channel and key alone, so an omitted or unrun context counts as present.
+// The fork deny belongs to fork support,
+// so the result drops it when the compared engine does not meet the fork requirement.
+func Compare(engines shuttleengine.EngineSet, manifests map[string]shuttleengine.Manifest) []shuttleengine.ManifestItem {
+	missing := shuttleengine.MissingItems(manifests[ReferenceEngine], manifests[ComparedEngine])
+	compared, _ := engines.Lookup(ComparedEngine)
+	if supporter, ok := compared.(shuttleengine.RequirementSupporter); ok && supporter.Supports(shuttleengine.RequirementForks) {
+		return missing
+	}
+	return slices.DeleteFunc(missing, func(item shuttleengine.ManifestItem) bool {
+		return item.Channel == shuttleengine.ChannelGuard && item.Key == shuttleengine.WebsterForkDenyKey
+	})
+}
diff --git a/internal/shuttleparity/producers_test.go b/internal/shuttleparity/producers_test.go
new file mode 100644
index 00000000..8e5b78dc
--- /dev/null
+++ b/internal/shuttleparity/producers_test.go
@@ -0,0 +1,803 @@
+// producers_test.go pins the Codex manifest of every launch-spec producer outside the seat tables.
+// Each producer's Codex manifest must hold what Claude's holds.
+// It also scans production code for a launch-spec literal, seat table or seat that the parity tests do not list.
+
+package shuttleparity
+
+import (
+	"fmt"
+	"go/ast"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/agentconfig"
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/dobbyengine"
+	"github.com/Knatte18/loomyard/internal/frictionengine"
+	"github.com/Knatte18/loomyard/internal/gatefixer"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/landingshed"
+	"github.com/Knatte18/loomyard/internal/loomcli"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/mergeresolve"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/samplerengine"
+	"github.com/Knatte18/loomyard/internal/shedadapters"
+	"github.com/Knatte18/loomyard/internal/shedarbiter"
+	"github.com/Knatte18/loomyard/internal/sheddriver"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengines"
+	"github.com/Knatte18/loomyard/internal/testkit/scankit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/treadleengine"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+	"github.com/Knatte18/loomyard/internal/websterengine"
+)
+
+// The strand roles that production launch literals spell as unexported constants of their own packages.
+const (
+	judgeStrandRole     = "judge"
+	targetingStrandRole = "targeting"
+	planFixerStrandRole = "plan-fixer"
+)
+
+// The stencil names and the plan directory spelling the stand-in prompts render from.
+const (
+	standInRubricStencil  = "loom-rubric-code-review"
+	standInGateFixerBody  = "gatefix-body-card"
+	standInPlanDisplayDir = "_lym/plan"
+)
+
+// The glyphs of the functions that hold a launch-spec, seat table or seat literal.
+// No producer entry or seat table builds these on its own.
+const (
+	seatSpecGlyph      = "internal/seatengine#seatSpec"
+	multiLLMEntryGlyph = "internal/shedrecipe#multiLLMEntry"
+	multiLLMSeatGlyph  = "internal/shedrecipe#multiLLMSeat"
+)
+
+// The import path suffixes of the packages that declare the literals the scan looks for.
+const (
+	shuttleengineImportSuffix = "/internal/shuttleengine"
+	seatengineImportSuffix    = "/internal/seatengine"
+)
+
+// The way forward each kind of unlisted literal ends its message with.
+const (
+	specWayForward  = "way forward: add the function to producers in internal/shuttleparity, or, for a probe, set no Prompt"
+	tableWayForward = "way forward: give a new table builder its own seatTables entry with Builder, Holders and Build, so its seats reach the parity test, and add a helper that holds an existing builder's literal to that builder's Holders, with a Build that reaches the seat it adds"
+	seatWayForward  = tableWayForward
+)
+
+// skippedPlaces are the directories whose literals the scan leaves out.
+// The orch spec names the Claude engine, `lym shuttle run` is hand-written and `lym shuttle open` carries no role.
+var skippedPlaces = []string{"internal/orchcli/", "internal/orchengine/", "internal/shuttlecli/", "internal/testkit/"}
+
+// producer is one production function that holds a launch-spec literal outside the seat tables.
+type producer struct {
+	// Function is the glyph of the function that holds the literal.
+	Function string
+	// Specs returns the spec the producer launches with on engine, its prompt rendered for that engine.
+	Specs func(engine string) (shuttleengine.Spec, error)
+}
+
+// producerBuild builds the spec of one producer on engine from the fixture's stand-ins.
+type producerBuild func(fx parityFixture, engine string) (shuttleengine.Spec, error)
+
+// producers returns one entry per function outside the seat tables that holds a launch-spec literal.
+// Each entry renders the producer's prompt through the producer's own render function on the fixture's seeded stencils.
+// It builds the spec with the literal's role, config role, skills, ForkSubagents and Requires.
+func producers(t *testing.T, fx parityFixture) []producer {
+	t.Helper()
+	builds := []struct {
+		function string
+		build    producerBuild
+	}{
+		{"internal/sheddriver#tacklerSpec", buildTackler},
+		{"internal/treadleengine#runJudgeCall", buildTreadleJudge},
+		{"internal/treadleengine#runTargeting", buildTreadleTargeting},
+		{"internal/websterengine#FixPlanSpawnOrAttach", buildPlanFixer},
+		{"internal/websterengine#recoverSpawn", buildRecovery},
+		{"internal/websterengine#Run", buildMerriam},
+		{"internal/samplerengine#SessionSpec", buildSampler},
+		{"internal/landingshed#PRReview.sessionSpec", buildPRReview},
+		{"internal/loomcli#driverSpec", buildDriver},
+		{"internal/dobbyengine#TidySpec", buildBoardTidy},
+		{"internal/mergeresolve#buildConflictSpec", buildConflict},
+		{"internal/shedarbiter#Spec", buildArbiter},
+		{"internal/weaverengine#attemptSpec", buildWeaverAttempt},
+		{"internal/shedadapters#Bouncer.runSeedSpawn", buildBouncerSeed},
+		{"internal/shedadapters#Bouncer.judgeCall", buildBouncerJudge},
+		{"internal/gatefixer#SpawnOrAttach", buildGateFixer},
+		{"internal/frictionengine#buildReflectionSpec", buildReflection},
+	}
+	all := make([]producer, len(builds))
+	for i, entry := range builds {
+		all[i] = producer{
+			Function: entry.function,
+			Specs: func(engine string) (shuttleengine.Spec, error) {
+				spec, err := entry.build(fx, engine)
+				if err != nil {
+					return shuttleengine.Spec{}, fmt.Errorf("shuttleparity: the spec of producer %s on %s: %w", entry.function, engine, err)
+				}
+				return spec, nil
+			},
+		}
+	}
+	return all
+}
+
+// promptSpec returns spec with the prompt rendered for engine and a model choice naming the engine alone.
+func promptSpec(engine, prompt string, spec shuttleengine.Spec) shuttleengine.Spec {
+	spec.Prompt = prompt
+	spec.PromptEngine = engine
+	spec.ModelChoice = shuttleengine.ModelChoice{Engine: engine}
+	return spec
+}
+
+// standInCard is the one card of the stand-in batch the webster and weaver prompts render.
+var standInCard = planparser.Card{Number: 1, Slug: "stand-in", Summary: "the stand-in card", SourcePath: "_lym/plan/01-stand-in.md"}
+
+// standInGateConfig lists the `card` and `batch` gate keys the weaver prompt's gate calls render from.
+func standInGateConfig() gateslot.Config {
+	return gateslot.Config{
+		Tiers: map[string]gateslot.Tier{"tier0": {About: "unit"}, "tier1": {About: "integration"}},
+		Gates: map[string]gateslot.GateKey{
+			"card":  {Tiers: []int{0}, Scope: "card"},
+			"batch": {Tiers: []int{0, 1}, Scope: "card"},
+		},
+	}
+}
+
+func buildTackler(fx parityFixture, engine string) (shuttleengine.Spec, error) {
+	env := fx.env
+	prompt, err := sheddriver.RenderTacklerPrompt(env.StencilsDir, engine, sheddriver.TacklerPromptInput{
+		RunID:         "run",
+		Slug:          env.Slug,
+		Recipe:        "the stand-in recipe",
+		GotoRows:      "stand-in-row",
+		Worktree:      env.Location.WorktreePath(),
+		EnvelopePath:  standInPath(env, "envelope.json"),
+		ReportPath:    standInPath(env, "report.md"),
