+// It holds only a run's own process; an operator's verb passes.
+func installPauseGate(cmd *cobra.Command) {
+	tendercli.InstallNetworkGate(cmd.Context(), pauseSlugOverride(cmd), detachedChild(cmd), runCommand(cmd))
