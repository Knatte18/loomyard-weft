+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		history      []shedengine.HistoryEntry
+		wantFresh    bool
+		wantPosition int
+	}{
+		{"NoHistory", nil, false, 0},
+		{"EntryFromRecordWrite", []shedengine.HistoryEntry{{Producer: loomshed.NameRecordWrite, Outcome: shedengine.Done}}, false, 0},
