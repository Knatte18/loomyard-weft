diff --git a/internal/impactset/dependents.go b/internal/impactset/dependents.go
new file mode 100644
index 000000000..d3d19a1d4
--- /dev/null
+++ b/internal/impactset/dependents.go
@@ -0,0 +1,45 @@
+// dependents.go widens a named set of packages to every package of its module whose build or tests reach one of them.
+
+package impactset
+
+import (
+	"context"
+	"fmt"
+	"path"
+	"slices"
+)
+
+// DependentPackages returns packages and every package of the module at moduleDir whose build or tests reach one of them.
+// packages and the result are module-relative `go` package arguments, such as `./internal/x`, or `.` for the module root.
+// The result keeps packages first, in their order and cleaned spelling, then the added packages sorted by directory.
+// A package the module does not hold yet stays in the result and adds nothing.
+// A package that a plan card has still to create is one such.
+// The graph is built under the tier tags `tier0` through `tier3`, test imports included,
+// and the `cmd/lym` main package reaches every package whose tests import `internal/testkit/lymbin`.
+// A failed `go list` run is an error naming moduleDir; ctx bounds the run, so a stalled `go list` is killed when it ends.
+func DependentPackages(ctx context.Context, moduleDir string, packages []string) ([]string, error) {
+	pkgs, err := listPackages(ctx, moduleDir)
+	if err != nil {
+		return nil, fmt.Errorf("impactset: list the packages of %s: %w", moduleDir, err)
+	}
+	return dependentsFor(newModuleGraph(pkgs), packages), nil
+}
+
+// dependentsFor is the pure core of DependentPackages over graph.
+func dependentsFor(graph moduleGraph, packages []string) []string {
+	seeds := map[string]bool{}
+	dirs := make([]string, len(packages))
+	for i, arg := range packages {
+		dirs[i] = path.Clean(arg)
+		if p, ok := graph.byDir[dirs[i]]; ok {
+			seeds[p.ImportPath] = true
+		}
+	}
+	result := packageArgs(dirs)
+	for _, arg := range packageArgs(graph.packageDirs(graph.impactedSet(seeds))) {
+		if !slices.Contains(result, arg) {
+			result = append(result, arg)
+		}
+	}
+	return result
+}
diff --git a/internal/impactset/dependents_integration_test.go b/internal/impactset/dependents_integration_test.go
new file mode 100644
index 000000000..f1c35a7d7
--- /dev/null
+++ b/internal/impactset/dependents_integration_test.go
@@ -0,0 +1,44 @@
+// dependents_integration_test.go drives DependentPackages over real modules, whose package listing spawns `go list`.
+
+package impactset
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestDependentPackages(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	t.Run("a package gains its importer and a package whose tagged test imports it, and no unrelated package", func(t *testing.T) {
+		t.Parallel()
+		moduleDir := t.TempDir()
+		writeRepoFile(t, moduleDir, "go.mod", "module example.com/m\n\ngo 1.26\n")
+		writeRepoFile(t, moduleDir, "lib/lib.go", "package lib\n\nfunc One() int { return 1 }\n")
+		writeRepoFile(t, moduleDir, "user/user.go", "package user\n\nimport \"example.com/m/lib\"\n\nfunc Two() int { return lib.One() + 1 }\n")
+		writeRepoFile(t, moduleDir, "probe/probe.go", "package probe\n")
+		writeRepoFile(t, moduleDir, "probe/probe_test.go", "//go:build tier1\n\npackage probe\n\nimport (\n\t\"testing\"\n\n\t\"example.com/m/lib\"\n)\n\nfunc TestOne(t *testing.T) { _ = lib.One() }\n")
+		writeRepoFile(t, moduleDir, "other/other.go", "package other\n")
+
+		got, err := DependentPackages(context.Background(), moduleDir, []string{"./lib"})
+		if err != nil {
+			t.Fatalf("DependentPackages() error = %v; want nil", err)
+		}
+		if want := []string{"./lib", "./probe", "./user"}; !slices.Equal(got, want) {
+			t.Errorf("DependentPackages() = %q; want %q", got, want)
+		}
+	})
+
+	t.Run("a directory with no go.mod is an error naming it", func(t *testing.T) {
+		t.Parallel()
+		bare := t.TempDir()
+		if _, err := DependentPackages(context.Background(), bare, []string{"./lib"}); err == nil || !strings.Contains(err.Error(), bare) {
+			t.Errorf("DependentPackages(%s) error = %v; want an error naming the directory", bare, err)
+		}
+	})
+}
diff --git a/internal/impactset/dependents_test.go b/internal/impactset/dependents_test.go
new file mode 100644
index 000000000..4204b9ac6
--- /dev/null
+++ b/internal/impactset/dependents_test.go
@@ -0,0 +1,50 @@
+// dependents_test.go drives the pure core of DependentPackages over the shared hand-built package graph.
+
+package impactset
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestDependentsFor(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		packages []string
+		want     []string
+	}{
+		{
+			name:     "a package gains every package that reaches it, a test import included, sorted after it",
+			packages: []string{"./internal/a"},
+			want:     []string{"./internal/a", "./cmd/lym", "./internal/b", "./internal/c", "./internal/tmuxonly"},
+		},
+		{
+			name:     "a package nothing reaches stays alone",
+			packages: []string{"./internal/d"},
+			want:     []string{"./internal/d"},
+		},
+		{
+			name:     "a package the module does not hold yet stays first and adds nothing",
+			packages: []string{"./internal/new", "./internal/b"},
+			want:     []string{"./internal/new", "./internal/b", "./cmd/lym", "./internal/c"},
+		},
+		{
+			name:     "the cmd/lym main package gains the packages whose tests build the binary",
+			packages: []string{"./cmd/lym"},
+			want:     []string{"./cmd/lym", "./internal/e"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := dependentsFor(testGraph(), tt.packages); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("dependentsFor(%q) = %q; want %q", tt.packages, got, tt.want)
+			}
+		})
+	}
+}
