at selects it\\\"}}'; true\"}]},{\"matcher\":\"AskUserQuestion\",\"hooks\":[{\"type\":\"command\",\"command\":\"printf '{\\\"lym_stamp\\\":\\\"PreToolUse\\\",\\\"lym_at\\\":\\\"%s\\\"}\\\\n' \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\" \\u003e\\u003e '/c/run/events.jsonl'; cat \\u003e\\u003e '/c/run/events.jsonl' \\u0026\\u0026 printf '\\\\n' \\u003e\\u003e '/c/run/events.jsonl'\"}]}],\"UserPromptSubmit\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '{\\\"lym_stamp\\\":\\\"UserPromptSubmit\\\",\\\"lym_at\\\":\\\"%s\\\"}\\\\n' \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\" \\u003e\\u003e '/c/run/events.jsonl'; cat \\u003e\\u003e '/c/run/events.jsonl' \\u0026\\u0026 printf '\\\\n' \\u003e\\u003e '/c/run/events.jsonl'; true\"}]}],\"StopFailure\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '{\\\"lym_stamp\\\":\\\"StopFailure\\\",\\\"lym_at\\\":\\\"%s\\\"}\\\\n' \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\" \\u003e\\u003e '/c/run/events.jsonl'; cat \\u003e\\u003e '/c/run/events.jsonl' \\u0026\\u0026 printf '\\\\n' \\u003e\\u003e '/c/run/events.jsonl'; true\"}]}],\"Notification\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '{\\\"lym_stamp\\\":\\\"Notification\\\",\\\"lym_at\\\":\\\"%s\\\"}\\\\n' \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\" \\u003e\\u003e '/c/run/events.jsonl'; cat \\u003e\\u003e '/c/run/events.jsonl' \\u0026\\u0026 printf '\\\\n' \\u003e\\u003e '/c/run/events.jsonl'; true\"}]}],\"SessionEnd\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '{\\\"lym_stamp\\\":\\\"SessionEnd\\\",\\\"lym_at\\\":\\\"%s\\\"}\\\\n' \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\" \\u003e\\u003e '/c/run/events.jsonl'; cat \\u003e\\u003e '/c/run/events.jsonl' \\u0026\\u0026 printf '\\\\n' \\u003e\\u003e '/c/run/events.jsonl'; true\"}]}],\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '{\\\"lym_stamp\\\":\\\"SessionStart\\\",\\\"lym_at\\\":\\\"%s\\\"}\\\\n' \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\" \\u003e\\u003e '/c/run/events.jsonl'; cat \\u003e\\u00