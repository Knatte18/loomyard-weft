+// TestScopeClosedAt asserts which contents of the reviews directory close the scope of a run sent back to Darn-Write.
+func TestScopeClosedAt(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	tests := []struct {
