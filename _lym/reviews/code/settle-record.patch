diff --git a/internal/hardenshed/archive.go b/internal/hardenshed/archive.go
new file mode 100644
index 00000000..89621bef
--- /dev/null
+++ b/internal/hardenshed/archive.go
@@ -0,0 +1,138 @@
+// archive.go copies a campaign round's files into the tracked harden directory and commits them.
+
+package hardenshed
+
+import (
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/shedadapters"
+)
+
+// ledgerFileSuffix ends the name of a Bouncer ledger file, `round-<n>-bouncer-ledger.md`.
+const ledgerFileSuffix = "-bouncer-ledger.md"
+
+// ArchiveDeps is what the round archive needs told.
+type ArchiveDeps struct {
+	// RunDir is the run directory the round's files are read from.
+	RunDir string
+	// AnchorRoot is the absolute anchor root the `_lym` archive directory sits under.
+	AnchorRoot string
+	// Commit commits the anchor-relative, slash-separated paths with message.
+	// A path whose content did not change commits nothing.
+	Commit func(relPaths []string, message string) error
+}
+
+// ArchiveRound copies round's files from the run directory into `_lym/harden/round-<round>/` and commits that directory.
+// The files are every `round-<round>-*` file, every `harden-*-<round>.json` file and the latest Bouncer ledger.
+// It replaces the directory's earlier content, so archiving one round twice leaves the same directory.
+func ArchiveRound(deps ArchiveDeps, round int) error {
+	relDir := path.Join(lymdirs.LymDirName, lymdirs.HardenDirName, fmt.Sprintf("round-%d", round))
+	dir := filepath.Join(deps.AnchorRoot, filepath.FromSlash(relDir))
+	if err := os.RemoveAll(dir); err != nil {
+		return fmt.Errorf("archive round %d: clear %s: %w", round, dir, err)
+	}
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("archive round %d: create %s: %w", round, dir, err)
+	}
+
+	sources, err := roundFiles(deps.RunDir, round)
+	if err != nil {
+		return fmt.Errorf("archive round %d: %w", round, err)
+	}
+	ledger, found, err := latestLedger(deps.RunDir)
+	if err != nil {
+		return fmt.Errorf("archive round %d: %w", round, err)
+	}
+	if found {
+		sources = append(sources, ledger)
+	}
+	for _, source := range sources {
+		if err := copyFile(source, filepath.Join(dir, filepath.Base(source))); err != nil {
+			return fmt.Errorf("archive round %d: %w", round, err)
+		}
+	}
+	if err := deps.Commit([]string{relDir}, fmt.Sprintf("harden: archive round %d", round)); err != nil {
+		return fmt.Errorf("archive round %d: commit %s: %w", round, relDir, err)
+	}
+	return nil
+}
+
+// ArchiveFinalLedger copies the run directory's latest Bouncer ledger into `_lym/harden/` and commits it.
+// It fails when the run directory holds no ledger.
+func ArchiveFinalLedger(deps ArchiveDeps) error {
+	ledger, found, err := latestLedger(deps.RunDir)
+	if err != nil {
+		return fmt.Errorf("archive the final ledger: %w", err)
+	}
+	if !found {
+		return fmt.Errorf("archive the final ledger: %s holds no bouncer ledger", deps.RunDir)
+	}
+	relPath := path.Join(lymdirs.LymDirName, lymdirs.HardenDirName, filepath.Base(ledger))
+	if err := copyFile(ledger, filepath.Join(deps.AnchorRoot, filepath.FromSlash(relPath))); err != nil {
+		return fmt.Errorf("archive the final ledger: %w", err)
+	}
+	if err := deps.Commit([]string{relPath}, "harden: archive the final bouncer ledger"); err != nil {
+		return fmt.Errorf("archive the final ledger: commit %s: %w", relPath, err)
+	}
+	return nil
+}
+
+// roundFiles returns the paths of the run directory's files that belong to round:
+// the shed's `round-<round>-*` files and the campaign's `harden-*-<round>.json` files.
+func roundFiles(runDir string, round int) ([]string, error) {
+	entries, err := os.ReadDir(runDir)
+	if err != nil {
+		return nil, fmt.Errorf("list %s: %w", runDir, err)
+	}
+	shedPrefix := fmt.Sprintf("round-%d-", round)
+	hardenSuffix := fmt.Sprintf("-%d.json", round)
+	var files []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() {
+			continue
+		}
+		if strings.HasPrefix(name, shedPrefix) || (strings.HasPrefix(name, hardenFilePrefix) && strings.HasSuffix(name, hardenSuffix)) {
+			files = append(files, filepath.Join(runDir, name))
+		}
+	}
+	return files, nil
+}
+
+// latestLedger returns the path of the run directory's Bouncer ledger of the highest round, and whether one exists.
+func latestLedger(runDir string) (string, bool, error) {
+	entries, err := os.ReadDir(runDir)
+	if err != nil {
+		return "", false, fmt.Errorf("list %s: %w", runDir, err)
+	}
+	var latest string
+	var latestRound int
+	for _, entry := range entries {
+		round, ok := shedadapters.OutputRound(entry.Name())
+		if !ok || entry.IsDir() || !strings.HasSuffix(entry.Name(), ledgerFileSuffix) || round <= latestRound {
+			continue
+		}
+		latest, latestRound = filepath.Join(runDir, entry.Name()), round
+	}
+	return latest, latest != "", nil
+}
+
+// copyFile writes the content of source to target, replacing target.
+func copyFile(source, target string) error {
+	content, err := os.ReadFile(source)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", source, err)
+	}
+	if err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {
+		return fmt.Errorf("create the directory of %s: %w", target, err)
+	}
+	if err := os.WriteFile(target, content, 0o644); err != nil {
+		return fmt.Errorf("write %s: %w", target, err)
+	}
+	return nil
+}
diff --git a/internal/hardenshed/campaign.go b/internal/hardenshed/campaign.go
new file mode 100644
index 00000000..25e67d2b
--- /dev/null
+++ b/internal/hardenshed/campaign.go
@@ -0,0 +1,169 @@
+// campaign.go holds Preflight's check of a hardener campaign: the refusals a run meets before any agent spends tokens.
+
+package hardenshed
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+)
+
+// The gate keys the campaign's live gate runs: its merge-bar run, and its concurrent copies.
+const (
+	LiveGateKey       = "harden-live"
+	LiveCopiesGateKey = "harden-live-copies"
+)
+
+// LiveKey is what the campaign check reads of one live gate key.
+type LiveKey struct {
+	// Set says whether the hub's own gate.yaml sets the key.
+	Set bool
+	// Tiers are the key's own tiers.
+	Tiers []int
+	// Tested are the tiers a run of the key tests.
+	// They are Tiers with each tier's covers, as `lym gate test` narrows `{test_targets}`.
+	Tested []int
+}
+
+// CampaignCheck is the input of CheckCampaign.
+type CampaignCheck struct {
+	// Config is the loaded hardener config.
+	Config Config
+	// WorktreeRoot is the absolute root of the worktree the campaign's packages are relative to.
+	WorktreeRoot string
+	// Live is the `harden-live` key.
+	Live LiveKey
+	// Copies is the `harden-live-copies` key, read only when copies run.
+	Copies LiveKey
+	// HoldsTierTest reports whether the package directory dir holds a test that a run of tiers executes.
+	HoldsTierTest func(dir string, tiers []int) bool
+	// Route returns the way forward that changes the config key, by the layer the key's value comes from.
+	Route func(key string) (string, error)
+}
+
+// CheckCampaign returns the first refusal of a campaign Preflight must not start, or nil.
+// Each refusal names its way forward and ends with `lym loom resume`.
+// The refusals come in this order:
+// no package, or one whose directory the worktree lacks;
+// a live key the hub's gate.yaml does not set;
+// a live key naming the billed tier, or the copies key naming more than one tier when copies run;
+// a package holding no test of a tier a live key runs;
+// an empty reviewer or fixer list;
+// a reviewer list of one entry, or one whose cyclic expansion repeats a model in neighbouring rounds;
+// and a soft cap of review rounds above the hard cap.
+// Copies run when the live tests drive no LLM session and the concurrency is above 1.
+func CheckCampaign(in CampaignCheck) error {
+	cfg := in.Config
+	copiesRun := !cfg.LLMDriving && cfg.Concurrency > 1
+	keys := []struct {
+		name string
+		key  LiveKey
+	}{{LiveGateKey, in.Live}}
+	if copiesRun {
+		keys = append(keys, struct {
+			name string
+			key  LiveKey
+		}{LiveCopiesGateKey, in.Copies})
+	}
+
+	if len(cfg.Packages) == 0 {
+		return in.refuseKey("packages", "the hardener config names no package")
+	}
+	for _, pkg := range cfg.Packages {
+		if info, err := os.Stat(filepath.Join(in.WorktreeRoot, pkg)); err != nil || !info.IsDir() {
+			return in.refuseKey("packages", fmt.Sprintf("the hardener config names package %q, which the worktree has no directory for", pkg))
+		}
+	}
+	for _, live := range keys {
+		if !live.key.Set {
+			return refuse(fmt.Sprintf("the hub's gate.yaml sets no gates.%s key", live.name), gateWrite(live.name))
+		}
+	}
+	for _, live := range keys {
+		if slices.Contains(live.key.Tiers, gateslot.BilledTier) {
+			return refuse(fmt.Sprintf("gates.%s names tier%d, which drives a billed LLM session", live.name, gateslot.BilledTier), gateWrite(live.name))
+		}
+	}
+	if copiesRun && len(in.Copies.Tiers) > 1 {
+		return refuse(fmt.Sprintf("gates.%s names the tiers %v, and --copies runs one tier", LiveCopiesGateKey, in.Copies.Tiers), gateWrite(LiveCopiesGateKey))
+	}
+	for _, live := range keys {
+		for _, pkg := range cfg.Packages {
+			if in.HoldsTierTest(filepath.Join(in.WorktreeRoot, pkg), live.key.Tested) {
+				continue
+			}
+			route, err := in.Route("packages")
+			if err != nil {
+				return err
+			}
+			return refuse(fmt.Sprintf("package %q holds no test of the tiers %v that gates.%s runs", pkg, live.key.Tested, live.name),
+				fmt.Sprintf("list only packages that hold such a test: %s; or point the key at a tier the package tests: %s", route, gateWrite(live.name)))
+		}
+	}
+	for _, list := range []struct {
+		key     string
+		entries []string
+	}{{"reviewer", cfg.Reviewer}, {"fixer", cfg.Fixer}} {
+		if len(list.entries) == 0 {
+			return in.refuseKey(list.key, fmt.Sprintf("the %s list is empty, so no round has a model to run with; list at least one model", list.key))
+		}
+	}
+	if reason := reviewerRepeat(cfg.Reviewer); reason != "" {
+		return in.refuseKey("reviewer", reason)
+	}
+	if cfg.MaxBounces > cfg.HardMaxBounces {
+		return in.refuseKey("max_bounces", fmt.Sprintf("max_bounces %d is above hard_max_bounces %d", cfg.MaxBounces, cfg.HardMaxBounces))
+	}
+	return nil
+}
+
+// refuseKey returns the refusal of detail whose way forward changes the config key, by the route the told Route names.
+func (in CampaignCheck) refuseKey(key, detail string) error {
+	route, err := in.Route(key)
+	if err != nil {
+		return err
+	}
+	return refuse(detail, route)
+}
+
+// refuse returns a campaign refusal made of what is wrong and its way forward, closed with the resume.
+func refuse(detail, wayForward string) error {
+	return fmt.Errorf("hardener campaign: %s; way forward: %s, then run \"lym loom resume\"", detail, wayForward)
+}
+
+// gateWrite returns the write that sets a live gate key in the hub's gate.yaml.
+func gateWrite(key string) string {
+	return fmt.Sprintf("run `lym config gate --set 'gates.%s={tiers: [<live tier>], scope: diff}'` from the prime", key)
+}
+
+// reviewerRepeat returns what is wrong with a reviewer list, or "" when no round repeats the model of its neighbour.
+// A list of one entry repeats it every round, and the cyclic expansion's last entry meets its first.
+func reviewerRepeat(reviewer []string) string {
+	if len(reviewer) == 1 {
+		return "the reviewer list holds one entry, so every round reviews with the same model; list at least two models, none twice in a row"
+	}
+	for i, entry := range reviewer {
+		next := reviewer[(i+1)%len(reviewer)]
+		if modelOf(entry) == modelOf(next) {
+			return fmt.Sprintf("the reviewer list repeats the model %q in neighbouring rounds, %q then %q, its last and first entries included", modelOf(entry), entry, next)
+		}
+	}
+	return ""
+}
+
+// modelOf returns the model a model-spec names, its bracket parameters left out.
+// A spec that does not parse is its own model.
+func modelOf(spec string) string {
+	parsed, err := modelspec.Parse(spec)
+	if err != nil {
+		return spec
+	}
+	if parsed.Alias != "" {
+		return parsed.Alias
+	}
+	return parsed.Engine + ":" + parsed.Model
+}
diff --git a/internal/hardenshed/campaign_rows.go b/internal/hardenshed/campaign_rows.go
new file mode 100644
index 00000000..fafb8707
--- /dev/null
+++ b/internal/hardenshed/campaign_rows.go
@@ -0,0 +1,282 @@
+// campaign_rows.go holds Campaign, the bundle of one run's config and seams that the Harden rows are built from.
+// It also renders the facts the Harden-Bouncer judge reads about a round and answers whether a round's live gate is red.
+
+package hardenshed
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/shedadapters"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// fixerReportFileFormat names a round's fixer report in the run directory.
+const fixerReportFileFormat = "round-%d-fixer-report.md"
+
+// Campaign is one run's loaded hardener config and the seams its Harden rows act through.
+// Every row of the run holds the same Campaign, and each method takes the run directory its row works in.
+// A caller builds it with every field set, bar the seams a method it never reaches uses.
+type Campaign struct {
+	// Config is the run's loaded hardener config.
+	Config Config
+	// WorktreeRoot is the absolute root of the run's worktree, which the live gate reads the campaign's packages under.
+	WorktreeRoot string
+	// AnchorPath is the absolute anchor path of the run's worktree, which the round archive lands under.
+	AnchorPath string
+	// RunDir is the run directory the Harden rows share, which a halt writes its strays into.
+	RunDir string
+	// RunLive makes one `lym gate test` call of the live gate key, with the copies and packages, in its own slots.
+	RunLive func(key string, copies int, packages []string) (LiveRun, error)
+	// Reap reaps the sandbox at point for row and returns the strays it found.
+	Reap func(row string, point ReapPoint) ([]StrayEntry, error)
+	// Head returns the commit the worktree is at.
+	Head func() (string, error)
+	// Commits lists the commits made past from.
+	Commits func(from string) ([]string, error)
+	// Commit commits the anchor-relative paths of a round archive.
+	Commit func(relPaths []string, message string) error
+}
+
+// LiveGate returns the live gate of the fix row that works in runDir.
+// Its round is the round the review row last wrote there.
+func (c *Campaign) LiveGate(runDir string) shuttleengine.Gate {
+	return NewLiveGate(LiveDeps{
+		RunDir:       runDir,
+		WorktreeRoot: c.WorktreeRoot,
+		Round:        func() (int, error) { return shedadapters.ReviewRound(runDir) },
+		Packages:     c.Config.Packages,
+		LLMDriving:   c.Config.LLMDriving,
+		Concurrency:  c.Config.Concurrency,
+		Run:          c.RunLive,
+	})
+}
+
+// WrapRow decorates the Harden round row inner, named row and of the given kind, with the campaign's reaps and files.
+func (c *Campaign) WrapRow(inner shedengine.ShedProducer, row string, kind RowKind, runDir string) shedengine.ShedProducer {
+	return WrapRow(inner, RowDeps{
+		Row:     row,
+		Kind:    kind,
+		RunDir:  runDir,
+		Reap:    c.Reap,
+		Models:  c.models,
+		Head:    c.Head,
+		Commits: c.Commits,
+		Archive: c.archiveDeps(runDir),
+	})
+}
+
+// models returns the reviewer and fixer model-specs round runs, each list taken in turn and cycled.
+func (c *Campaign) models(round int) (review, fix string) {
+	return cycled(c.Config.Reviewer, round), cycled(c.Config.Fixer, round)
+}
+
+// cycled returns the entry of list that round takes, "" for an empty list.
+func cycled(list []string, round int) string {
+	if len(list) == 0 {
+		return ""
+	}
+	return Rotate(list, round)[round-1]
+}
+
+// archiveDeps returns the round archive's seams over runDir.
+func (c *Campaign) archiveDeps(runDir string) ArchiveDeps {
+	return ArchiveDeps{RunDir: runDir, AnchorRoot: c.AnchorPath, Commit: c.Commit}
+}
+
+// LiveRed reports whether the live gate of round is red.
+// A round with no live report is red once its fix row ran, which the round's commits file shows:
+// a fix row whose earlier gate ran out returns before its live gate writes a report.
+func (c *Campaign) LiveRed(runDir string, round int) (bool, error) {
+	report, found, err := ReadLiveReport(runDir, round)
+	if err != nil {
+		return false, fmt.Errorf("read the live report of round %d: %w", round, err)
+	}
+	if found {
+		return report.Mark == MarkRed, nil
+	}
+	_, fixRan, err := readRoundRecord[RoundCommits](runDir, "commits", round)
+	if err != nil {
+		return false, err
+	}
+	return fixRan, nil
+}
+
+// Halt reaps the sandbox at ReapHalt and adds the strays to the stray report of the run directory's last round.
+func (c *Campaign) Halt(row string) error {
+	strays, reapErr := c.Reap(row, ReapHalt)
+	var failures []error
+	if reapErr != nil {
+		failures = append(failures, fmt.Errorf("reap at %s for %s: %w", ReapHalt, row, reapErr))
+	}
+	round, err := shedadapters.ReviewRound(c.RunDir)
+	if err == nil {
+		err = appendStrays(c.RunDir, round, strays)
+	}
+	if err != nil {
+		failures = append(failures, err)
+	}
+	return errors.Join(failures...)
+}
+
+// ArchiveFinal copies the run directory's latest Bouncer ledger into the harden directory and commits it.
+func (c *Campaign) ArchiveFinal(runDir string) error {
+	return ArchiveFinalLedger(c.archiveDeps(runDir))
+}
+
+// RoundFacts renders the Hardener section of round's facts, one bullet per fact.
+// A file the round lacks is named as absent.
+// A live report that is absent is also named red when LiveRed reads it red.
+func (c *Campaign) RoundFacts(runDir string, round int) (string, error) {
+	var facts strings.Builder
+
+	models, found, err := readRoundRecord[RoundModels](runDir, "models", round)
+	if err != nil {
+		return "", err
+	}
+	if found {
+		fmt.Fprintf(&facts, "- Models: reviewer `%s`, fixer `%s`.\n", models.Review, models.Fix)
+	} else {
+		facts.WriteString("- Models: absent.\n")
+	}
+
+	live, liveFound, err := ReadLiveReport(runDir, round)
+	if err != nil {
+		return "", fmt.Errorf("read the live report of round %d: %w", round, err)
+	}
+	red, err := c.LiveRed(runDir, round)
+	if err != nil {
+		return "", err
+	}
+	writeLiveFacts(&facts, live, liveFound, red)
+
+	if err := writeStrayFacts(&facts, runDir, round); err != nil {
+		return "", err
+	}
+	commits, found, err := readRoundRecord[RoundCommits](runDir, "commits", round)
+	if err != nil {
+		return "", err
+	}
+	switch {
+	case !found:
+		facts.WriteString("- Fix commits: absent.\n")
+	case len(commits.Commits) == 0:
+		facts.WriteString("- Fix commits: none.\n")
+	default:
+		fmt.Fprintf(&facts, "- Fix commits: %s.\n", strings.Join(commits.Commits, ", "))
+	}
+
+	if err := writeDeferredFacts(&facts, runDir, round, live); err != nil {
+		return "", err
+	}
+	return facts.String(), nil
+}
+
+// writeLiveFacts writes the bullets of the round's live report, or names it absent.
+func writeLiveFacts(facts *strings.Builder, live LiveReport, found, red bool) {
+	switch {
+	case found:
+		fmt.Fprintf(facts, "- Live report: %s. The `%s` run %s and started %d test binaries.\n", live.Mark, LiveGateKey, passedWord(live.Live.Passed), live.Live.Started)
+	case red:
+		facts.WriteString("- Live report: absent, read as red because the round's fix row ran and wrote none.\n")
+	default:
+		facts.WriteString("- Live report: absent.\n")
+	}
+	if !found {
+		return
+	}
+	switch {
+	case live.Copies == nil:
+		facts.WriteString("- Copies run: none.\n")
+	case live.Copies.Refused != "":
+		fmt.Fprintf(facts, "- Copies run: refused: %s\n", live.Copies.Refused)
+	default:
+		fmt.Fprintf(facts, "- Copies run: %s and started %d test binaries.\n", passedWord(live.Copies.Passed), live.Copies.Started)
+	}
+	if len(live.OutsideStrayCover) > 0 {
+		fmt.Fprintf(facts, "- Packages outside the stray-state cover: %s.\n", strings.Join(live.OutsideStrayCover, ", "))
+	}
+}
+
+// passedWord names a call's result as the facts file words it.
+func passedWord(passed bool) string {
+	if passed {
+		return "passed"
+	}
+	return "failed"
+}
+
+// writeStrayFacts writes the bullets of the round's stray report, or names it absent.
+func writeStrayFacts(facts *strings.Builder, runDir string, round int) error {
+	report, found, err := readRoundRecord[StrayReport](runDir, "strays", round)
+	if err != nil {
+		return err
+	}
+	switch {
+	case !found:
+		facts.WriteString("- Strays: the stray report is absent.\n")
+	case len(report.Entries) == 0:
+		facts.WriteString("- Strays: none.\n")
+	default:
+		for _, entry := range report.Entries {
+			fmt.Fprintf(facts, "- Stray %s found by row %s at %s%s.\n", describeStray(entry), entry.Row, entry.Point, interruptedNote(entry))
+		}
+	}
+	return nil
+}
+
+// describeStray names the server or process a stray entry records.
+func describeStray(entry StrayEntry) string {
+	if entry.Kind == StrayServer {
+		return fmt.Sprintf("server of hub %s", entry.Hub)
+	}
+	return fmt.Sprintf("process %d (%s)", entry.PID, strings.Join(entry.Argv, " "))
+}
+
+// interruptedNote marks a stray an interrupted row left.
+func interruptedNote(entry StrayEntry) string {
+	if entry.Interrupted {
+		return ", left by an interrupted row"
+	}
+	return ""
+}
+
+// writeDeferredFacts writes the findings the round's fixer report defers and those its red live report lists.
+// A fixer report that cannot be parsed is named as such and fails nothing.
+func writeDeferredFacts(facts *strings.Builder, runDir string, round int, live LiveReport) error {
+	content, err := os.ReadFile(filepath.Join(runDir, fmt.Sprintf(fixerReportFileFormat, round)))
+	switch {
+	case errors.Is(err, os.ErrNotExist):
+		facts.WriteString("- Fixer report: absent.\n")
+	case err != nil:
+		return fmt.Errorf("read the fixer report of round %d: %w", round, err)
+	default:
+		report, parseErr := burlerengine.ParseFixerReport(content)
+		if parseErr != nil {
+			fmt.Fprintf(facts, "- Fixer report: unreadable: %s\n", strings.Join(strings.Fields(parseErr.Error()), " "))
+			break
+		}
+		deferred := 0
+		for _, disposition := range report.Dispositions {
+			if disposition.Disposition == burlerengine.DispositionDeferred {
+				fmt.Fprintf(facts, "- Deferred by the fixer: `%s`: %s\n", disposition.ID, disposition.Reason)
+				deferred++
+			}
+		}
+		if deferred == 0 {
+			facts.WriteString("- Deferred by the fixer: none.\n")
+		}
+	}
+	for _, line := range live.Deferred {
+		fmt.Fprintf(facts, "- Deferred by the red live report: %s\n", line)
+	}
+	if len(live.Deferred) == 0 {
+		facts.WriteString("- Deferred by the red live report: none.\n")
+	}
+	return nil
+}
diff --git a/internal/hardenshed/campaign_rows_test.go b/internal/hardenshed/campaign_rows_test.go
new file mode 100644
index 00000000..b5e68b41
--- /dev/null
+++ b/internal/hardenshed/campaign_rows_test.go
@@ -0,0 +1,202 @@
+// campaign_rows_test.go covers the facts a Campaign renders for a round, its live-red answer and its halt.
+
+package hardenshed
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// writeLiveReport writes the live report of its round into runDir.
+func writeLiveReport(t *testing.T, runDir string, report LiveReport) {
+	t.Helper()
+	path := liveReportPath(runDir, report.Round)
+	if err := state.WriteJSON(path, lock.TrackedFileLockPath(path, ".lock"), report); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCampaignRoundFacts(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const fixerReport = "---\ndispositions:\n  - id: f1\n    disposition: deferred\n    reason: needs a refactor outside the module\n  - id: f2\n    disposition: fixed\nspawned: true\n---\nbody\n"
+	tests := []struct {
+		name  string
+		setup func(t *testing.T, runDir string)
+		want  []string
+	}{
+		{
+			name:  "AFullRound",
+			setup: fullRound,
+			want: []string{
+				"- Models: reviewer `opus`, fixer `fable`.",
+				"- Live report: green. The `harden-live` run passed and started 2 test binaries.",
+				"- Copies run: failed and started 2 test binaries.",
+				"- Packages outside the stray-state cover: pkg/b.",
+				"- Stray process 41 (sleep 1000) found by row Harden-Review at start, left by an interrupted row.",
+				"- Stray server of hub /sandbox/hub found by row Harden-Review at end.",
+				"- Fix commits: c1, c2.",
+				"- Deferred by the fixer: `f1`: needs a refactor outside the module",
+				"- Deferred by the red live report: none.",
+			},
+		},
+		{
+			name: "ARedLiveReportListsItsDeferredFailuresBesideTheFixersDeferral",
+			setup: func(t *testing.T, runDir string) {
+				writeLiveReport(t, runDir, LiveReport{Round: 1, Mark: MarkRed, Live: LiveRunReport{Started: 1}, Deferred: []string{"--- FAIL: TestSlow"}})
+				if err := os.WriteFile(filepath.Join(runDir, "round-1-fixer-report.md"), []byte(fixerReport), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			},
+			want: []string{
+				"- Live report: red. The `harden-live` run failed and started 1 test binaries.",
+				"- Deferred by the fixer: `f1`: needs a refactor outside the module",
+				"- Deferred by the red live report: --- FAIL: TestSlow",
+			},
+		},
+		{
+			name: "AnAbsentLiveReportBesideTheCommitsFileIsRed",
+			setup: func(t *testing.T, runDir string) {
+				if err := writeRoundRecord(runDir, "commits", 1, RoundCommits{Round: 1, Head: "h"}); err != nil {
+					t.Fatal(err)
+				}
+			},
+			want: []string{"- Live report: absent, read as red because the round's fix row ran and wrote none.", "- Fix commits: none."},
+		},
+		{
+			name: "ARefusedCopiesRunRendersItsRefusal",
+			setup: func(t *testing.T, runDir string) {
+				writeLiveReport(t, runDir, LiveReport{Round: 1, Mark: MarkGreen, Live: LiveRunReport{Passed: true, Started: 1}, Copies: &LiveRunReport{Refused: "the key names two tiers"}})
+			},
+			want: []string{"- Copies run: refused: the key names two tiers"},
+		},
+		{
+			name: "AnUnparseableFixerReportIsNamedAndFailsNothing",
+			setup: func(t *testing.T, runDir string) {
+				if err := os.WriteFile(filepath.Join(runDir, "round-1-fixer-report.md"), []byte("no frontmatter\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			},
+			want: []string{"- Fixer report: unreadable: "},
+		},
+		{
+			name:  "ARoundWithNoFiles",
+			setup: func(*testing.T, string) {},
+			want: []string{
+				"- Models: absent.",
+				"- Live report: absent.",
+				"- Strays: the stray report is absent.",
+				"- Fix commits: absent.",
+				"- Fixer report: absent.",
+				"- Deferred by the red live report: none.",
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			runDir := t.TempDir()
+			tt.setup(t, runDir)
+
+			got, err := (&Campaign{}).RoundFacts(runDir, 1)
+			if err != nil {
+				t.Fatalf("RoundFacts() error = %v; want nil", err)
+			}
+			for _, want := range tt.want {
+				if !strings.Contains(got, want) {
+					t.Errorf("RoundFacts() = %q; want it to hold the line %q", got, want)
+				}
+			}
+		})
+	}
+}
+
+// fullRound writes every file one round of a campaign leaves in runDir.
+func fullRound(t *testing.T, runDir string) {
+	t.Helper()
+	if err := writeRoundRecord(runDir, "models", 1, RoundModels{Round: 1, Review: "opus", Fix: "fable"}); err != nil {
+		t.Fatal(err)
+	}
+	writeLiveReport(t, runDir, LiveReport{
+		Round: 1, Mark: MarkGreen,
+		Live:              LiveRunReport{Passed: true, Started: 2},
+		Copies:            &LiveRunReport{Started: 2},
+		OutsideStrayCover: []string{"pkg/b"},
+	})
+	strays := []StrayEntry{
+		{Row: "Harden-Review", Point: ReapStart, Kind: StrayProcess, PID: 41, Argv: []string{"sleep", "1000"}, Interrupted: true},
+		{Row: "Harden-Review", Point: ReapEnd, Kind: StrayServer, Hub: "/sandbox/hub"},
+	}
+	if err := appendStrays(runDir, 1, strays); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeRoundRecord(runDir, "commits", 1, RoundCommits{Round: 1, Head: "h", Commits: []string{"c1", "c2"}}); err != nil {
+		t.Fatal(err)
+	}
+	report := "---\ndispositions:\n  - id: f1\n    disposition: deferred\n    reason: needs a refactor outside the module\nspawned: true\n---\nbody\n"
+	if err := os.WriteFile(filepath.Join(runDir, "round-1-fixer-report.md"), []byte(report), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCampaignLiveRed(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name  string
+		setup func(t *testing.T, runDir string)
+		want  bool
+	}{
+		{"ARedReport", func(t *testing.T, runDir string) { writeLiveReport(t, runDir, LiveReport{Round: 1, Mark: MarkRed}) }, true},
+		{"AGreenReport", func(t *testing.T, runDir string) { writeLiveReport(t, runDir, LiveReport{Round: 1, Mark: MarkGreen}) }, false},
+		{"AnAbsentReportBesideTheCommitsFile", func(t *testing.T, runDir string) {
+			if err := writeRoundRecord(runDir, "commits", 1, RoundCommits{Round: 1}); err != nil {
+				t.Fatal(err)
+			}
+		}, true},
+		{"AnAbsentReportWithNoCommitsFile", func(*testing.T, string) {}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			runDir := t.TempDir()
+			tt.setup(t, runDir)
+			if got, err := (&Campaign{}).LiveRed(runDir, 1); err != nil || got != tt.want {
+				t.Errorf("LiveRed(round 1) = %v, %v; want %v, nil", got, err, tt.want)
+			}
+		})
+	}
+}
+
+func TestCampaignHalt(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	runDir := t.TempDir()
+	for _, name := range []string{"round-1-review.md", "round-2-review.md"} {
+		if err := os.WriteFile(filepath.Join(runDir, name), []byte("review"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	reapErr := errors.New("reap refused")
+	campaign := &Campaign{RunDir: runDir, Reap: func(row string, point ReapPoint) ([]StrayEntry, error) {
+		return []StrayEntry{{Row: row, Point: point, Kind: StrayServer, Hub: "hub"}}, reapErr
+	}}
+
+	if err := campaign.Halt("Harden-Bouncer"); !errors.Is(err, reapErr) {
+		t.Errorf("Halt() error = %v; want it to wrap %v", err, reapErr)
+	}
+	report, found, err := readRoundRecord[StrayReport](runDir, "strays", 2)
+	if err != nil || !found || len(report.Entries) != 1 || report.Entries[0].Point != ReapHalt || report.Entries[0].Row != "Harden-Bouncer" {
+		t.Errorf("round 2 stray report = %+v, %v, %v; want the halt's entry for Harden-Bouncer", report, found, err)
+	}
+}
