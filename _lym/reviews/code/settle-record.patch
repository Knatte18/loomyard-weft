-					}
-					if helper, ok := decls.constants[n.Name]; ok {
-						add(n, OperatorChangeConstant, helper, "", nil)
-					}
-					for _, line := range decls.embedded[n.Name] {
-						add(n, OperatorChangeEmbeddedLine, "lymMutantLine", strconv.Itoa(line), nil)
-					}
