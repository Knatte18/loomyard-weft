+// TestLandingJoiner_HoldsNoParsedBoard pins that the landing joins keep no board past its commit's read:
+// no type the joiner holds, apart from the sources, options and report it reads, holds a board entry.
+//
+//testtiming:keep pins that no type the landing joiner reaches holds a parsed board entry, which TestComputeTiming_WalksTheRecordsBranchOnce never asserts
+//lym:seam internal/reportengine#landingJoiner
+//lym:seam internal/reportengine#landingClaim
+//lym:seam internal/reportengine#boardHistory
+//lym:seam internal/reportengine#commitSpan
+//lym:seam internal/reportengine#labelSpan
+//lym:seam internal/gitrepo#LogCommit
+//lym:seam internal/boardengine#Task
+func TestLandingJoiner_HoldsNoParsedBoard(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	entry := reflect.TypeFor[boardengine.Task]()
+	read := map[reflect.Type]bool{reflect.TypeFor[Sources](): true, reflect.TypeFor[Options](): true, reflect.TypeFor[Report](): true}
+	if path, held := typePathTo(reflect.TypeFor[landingJoiner](), entry, read); held {
+		t.Errorf("landingJoiner holds %v through %s; want no board entry held", entry, path)
+	}
+}
+
+// typePathTo returns the field path by which a value of type from holds a value of type target.
+// It returns false when from holds none.
+// It follows pointers, slices, arrays, maps and struct fields, and stops at interfaces.
+func typePathTo(from, target reflect.Type, seen map[reflect.Type]bool) (string, bool) {
+	if from == target {
+		return from.String(), true
+	}
+	if seen[from] {
+		return "", false
+	}
+	seen[from] = true
+	switch from.Kind() {
+	case reflect.Pointer, reflect.Slice, reflect.Array:
+		return typePathTo(from.Elem(), target, seen)
+	case reflect.Map:
+		if path, held := typePathTo(from.Key(), target, seen); held {
+			return path, true
+		}
+		return typePathTo(from.Elem(), target, seen)
+	case reflect.Struct:
+		for i := range from.NumField() {
+			field := from.Field(i)
+			if path, held := typePathTo(field.Type, target, seen); held {
+				return from.Name() + "." + field.Name + " → " + path, true
+			}
+		}
+	}
+	return "", false
+}
