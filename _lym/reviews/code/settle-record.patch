+// roles_test.go covers the fixer role set and the numbered-form match.
+
+package gatefixer
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestIsFixerRole pins which roles count as a fixer role, and the order Roles lists them in.
+func TestIsFixerRole(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	if got, want := Roles(), []string{"gate-fixer", "verify-fixer"}; !slices.Equal(got, want) {
+		t.Errorf("Roles() = %v; want %v", got, want)
+	}
+
+	tests := []struct {
+		name string
+		role string
+		want bool
+	}{
+		{"GateFixer", RoleGateFixer, true},
+		{"VerifyFixer", RoleVerifyFixer, true},
+		{"GateFixerNumbered", "gate-fixer-2", true},
+		{"VerifyFixerNumbered", "verify-fixer-3", true},
+		{"GateFixerOne", "gate-fixer-1", false},
+		{"GateFixerLeadingZero", "gate-fixer-02", false},
+		{"OtherRole", "implementer", false},
+		{"Empty", "", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := IsFixerRole(tt.role); got != tt.want {
+				t.Errorf("IsFixerRole(%q) = %v; want %v", tt.role, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/gatefixer/rowgate.go b/internal/gatefixer/rowgate.go
new file mode 100644
index 00000000..301aeb8c
--- /dev/null
+++ b/internal/gatefixer/rowgate.go
@@ -0,0 +1,255 @@
+// rowgate.go implements the wrap that hands a row gate's failure to a cold fixer at the writer's idle boundary and re-runs the gate over the fixer's finished tree.
+
+package gatefixer
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// awaitSlice is how long one call to the fixer's wait blocks before the wrap asks again.
+const awaitSlice = time.Minute
+
+// RowFixer is what a row's gate wrap needs to hand a failure to a cold fixer.
+type RowFixer struct {
+	// Fixer spawns, waits on and stops the fixer strands.
+	Fixer Fixer
+	// VisitDir returns the directory of the row visit, under which the wrap keeps its records.
+	VisitDir func() (string, error)
+	// Spec builds the fixer's launch from the report the fixer reads and the reply file it writes.
+	Spec func(reportPath, replyPath string) (Spec, error)
+	// Timeout bounds each fixer's run.
+	Timeout time.Duration
+	// Forked tells whether the row's run evaluates the entries' Forked closures, which the row decides when it is built.
+	Forked bool
+	// SkipForked, when non-nil, reports whether a failing Forked evaluation's findings are for the writer alone, so no fixer is spawned; nil skips nothing.
+	SkipForked func(findings string) bool
+}
+
+// fixerOutcome is what one wait on a fixer ended with.
+type fixerOutcome struct {
+	status     string
+	deadReason string
+	reply      string
+}
+
+// note is the text a failing gate's findings carry for this outcome: the fixer's reply, or why it ended without one.
+func (o fixerOutcome) note() string {
+	if o.status == StatusDone {
+		return o.reply
+	}
+	return fmt.Sprintf("The cold fixer ended without a reply (%s); any change it left uncommitted is in the worktree.", o.deadReason)
+}
+
+// rowWrap is the state of one wrapped gate: the entry that spawns fixers, its re-prompt budget and the strands this wrap spawned.
+type rowWrap struct {
+	rf       RowFixer
+	entry    string
+	attempts int
+
+	mu      sync.Mutex
+	spawned map[string]bool
+}
+
+// WrapRowGate returns a copy of spec whose entry named entry hands a failure to a cold fixer, and whose other entries wait for a running fixer before they judge.
+// Every entry keeps its name, attempts, pass-on-cap flag and re-prompt line.
+//
+// The named entry's gate, and its forked gate when set, run the inner closure once;
+// a failure spawns one fixer with the findings as its report, waits for it, runs the closure again and returns that verdict, with the fixer's reply appended to a failure.
+// No fixer is spawned for a passing, pending, terminal or erroring result, for a forked failure SkipForked reports, or once the entry's set holds attempts plus one records.
+// A fixer that cannot be started leaves the inner failure standing with a line saying no fixer ran.
+// A live record in the set is waited on instead of spawning, so a restarted driver finds the fixer it left running.
+// The record turns terminal when the entry that spawns fixers returns a result judged over the fixer's finished tree, or when any other entry fails over it;
+// an entry that passes over a live record leaves it live, so a later entry still folds the fixer's reply into its findings.
+// The entry's final closure never spawns; it only waits for a live record, then judges once.
+// An entry naming no entry of spec is refused.
+func WrapRowGate(spec shuttleengine.GateSpec, entry string, rf RowFixer) (shuttleengine.GateSpec, error) {
+	at := slices.IndexFunc(spec, func(candidate shuttleengine.GateEntry) bool { return candidate.Name == entry })
+	if at < 0 {
+		return nil, fmt.Errorf("gatefixer: the gate has no entry %q to hand a fixer; way forward: name the entry that carries the fixer element", entry)
+	}
+	wrap := &rowWrap{rf: rf, entry: entry, attempts: spec[at].Attempts, spawned: map[string]bool{}}
+
+	wrapped := make(shuttleengine.GateSpec, len(spec))
+	for i, candidate := range spec {
+		if i == at {
+			wrapped[i] = wrap.fixerEntry(candidate)
+			continue
+		}
+		candidate.Gate = wrap.waitOnly(candidate.Gate, false)
+		candidate.Forked = wrap.waitOnly(candidate.Forked, false)
+		wrapped[i] = candidate
+	}
+	return wrapped, nil
+}
+
+// fixerEntry returns the entry that spawns fixers, built from the original so the inner closures stay the row's own.
+func (w *rowWrap) fixerEntry(original shuttleengine.GateEntry) shuttleengine.GateEntry {
+	finalInner := original.Gate
+	if w.rf.Forked && original.Forked != nil {
+		finalInner = original.Forked
+	}
+	wrapped := original
+	wrapped.Gate = w.spawning(original.Gate, false)
+	if original.Forked != nil {
+		wrapped.Forked = w.spawning(original.Forked, true)
+	}
+	wrapped.MayHold = true
+	wrapped.Final = w.waitOnly(finalInner, true)
+	wrapped.Expired = w.expired
+	return wrapped
+}
+
+func (w *rowWrap) openStore() (rowStore, error) {
+	visitDir, err := w.rf.VisitDir()
+	if err != nil {
+		return rowStore{}, fmt.Errorf("gatefixer: resolve the row visit directory: %w", err)
+	}
+	return newRowStore(visitDir, w.entry), nil
+}
+
+// waitOnly returns inner behind a wait on the set's live fixer, and nil for a nil inner.
+// With no live record it runs inner at once.
+// markOnPass says whether a passing or pending inner marks the live record terminal; a failing one always does.
+func (w *rowWrap) waitOnly(inner shuttleengine.Gate, markOnPass bool) shuttleengine.Gate {
+	if inner == nil {
+		return nil
+	}
+	return func() (shuttleengine.GateResult, error) {
+		store, live, err := w.liveRecord()
+		if err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		if live == nil {
+			return inner()
+		}
+		return w.waitThenRun(store, live, inner, markOnPass)
+	}
+}
+
+// spawning returns inner behind the fixer hand-off: it waits on a live record, and on a failure of its own spawns a fixer and judges again.
+func (w *rowWrap) spawning(inner shuttleengine.Gate, forked bool) shuttleengine.Gate {
+	return func() (shuttleengine.GateResult, error) {
+		store, live, err := w.liveRecord()
+		if err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		if live != nil {
+			return w.waitThenRun(store, live, inner, true)
+		}
+		failed, err := inner()
+		if err != nil || failed.Passed || failed.Pending || failed.Terminal {
+			return failed, err
+		}
+		held, err := store.count()
+		if err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		if held >= w.attempts+1 || (forked && w.rf.SkipForked != nil && w.rf.SkipForked(failed.Findings)) {
+			return failed, nil
+		}
+		return w.spawnAndJudgeAgain(store, held+1, inner, failed)
+	}
+}
+
+func (w *rowWrap) liveRecord() (rowStore, *Record, error) {
+	store, err := w.openStore()
+	if err != nil {
+		return rowStore{}, nil, err
+	}
+	live, err := store.Live()
+	if err != nil {
+		return rowStore{}, nil, err
+	}
+	return store, live, nil
+}
+
+// spawnAndJudgeAgain writes failed's findings as the report of the fixer that takes place n, spawns it and returns inner's verdict once the fixer has ended.
+func (w *rowWrap) spawnAndJudgeAgain(store rowStore, n int, inner shuttleengine.Gate, failed shuttleengine.GateResult) (shuttleengine.GateResult, error) {
+	reportPath, replyPath := store.reportPath(n), store.replyPath(n)
+	if err := os.MkdirAll(store.dir, 0o755); err != nil {
+		return shuttleengine.GateResult{}, fmt.Errorf("gatefixer: create the fixer directory %s: %w", store.dir, err)
+	}
+	if err := os.WriteFile(reportPath, []byte(failed.Findings), 0o644); err != nil {
+		return shuttleengine.GateResult{}, fmt.Errorf("gatefixer: write the fixer report %s: %w", reportPath, err)
+	}
+	spec, err := w.rf.Spec(reportPath, replyPath)
+	if err != nil {
+		return shuttleengine.GateResult{}, fmt.Errorf("gatefixer: build the fixer's launch: %w", err)
+	}
+	rec, spawned, err := w.rf.Fixer.SpawnOrAttach(store, spec)
+	if err != nil {
+		failed.Findings += fmt.Sprintf("\n\nThe cold fixer could not be started (%v); no fixer ran.", err)
+		return failed, nil
+	}
+	if spawned {
+		w.mu.Lock()
+		w.spawned[rec.StrandGUID] = true
+		w.mu.Unlock()
+	}
+	return w.waitThenRun(store, rec, inner, true)
+}
+
+// waitThenRun waits for rec's fixer and runs inner once.
+// The record is marked terminal only after inner has returned a result, so a driver restarted during the run, or after an inner error, still finds the fixer live;
+// a passing or pending result, which judges nothing over the finished tree, leaves it live when markOnPass is false.
+// A failing verdict carries the fixer's reply or dead note.
+func (w *rowWrap) waitThenRun(store rowStore, rec *Record, inner shuttleengine.Gate, markOnPass bool) (shuttleengine.GateResult, error) {
+	outcome, err := w.wait(store, rec)
+	if err != nil {
+		return shuttleengine.GateResult{}, err
+	}
+	result, err := inner()
+	if err != nil {
+		return shuttleengine.GateResult{}, err
+	}
+	if (result.Passed || result.Pending) && !markOnPass {
+		return result, nil
+	}
+	if err := store.markTerminal(rec.StrandGUID, outcome.status, outcome.deadReason); err != nil {
+		return shuttleengine.GateResult{}, err
+	}
+	if result.Passed || result.Pending || result.Terminal {
+		return result, nil
+	}
+	result.Findings += "\n\n## Cold fixer reply\n\n" + outcome.note()
+	return result, nil
+}
+
+// wait asks the fixer to wait until its answer is terminal.
+// A wait that fails stops the strand and marks the record dead, so a fixer whose engine or events can no longer be read never blocks the visit;
+// when that stop fails too, the record stays live and the joined error is returned.
+func (w *rowWrap) wait(store rowStore, rec *Record) (fixerOutcome, error) {
+	for {
+		result, err := w.rf.Fixer.Await(rec, w.rf.Timeout, awaitSlice)
+		if err != nil {
+			if stopErr := w.rf.Fixer.Stop(rec); stopErr != nil {
+				return fixerOutcome{}, errors.Join(err, stopErr)
+			}
+			if markErr := store.markTerminal(rec.StrandGUID, StatusDead, DeadReasonDied); markErr != nil {
+				return fixerOutcome{}, errors.Join(err, markErr)
+			}
+			return fixerOutcome{status: StatusDead, deadReason: DeadReasonDied}, nil
+		}
+		if result.Status != StatusRunning {
+			return fixerOutcome{status: result.Status, deadReason: result.DeadReason, reply: result.Reply}, nil
+		}
+	}
+}
+
+// expired reports whether the set holds a live record whose strand this wrap did not spawn, which only a driver restarted onto the visit sees.
+func (w *rowWrap) expired() (bool, error) {
+	_, live, err := w.liveRecord()
+	if err != nil || live == nil {
+		return false, err
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return !w.spawned[live.StrandGUID], nil
+}
diff --git a/internal/gatefixer/rowgate_test.go b/internal/gatefixer/rowgate_test.go
new file mode 100644
index 00000000..d3080475
--- /dev/null
+++ b/internal/gatefixer/rowgate_test.go
@@ -0,0 +1,625 @@
+// rowgate_test.go covers WrapRowGate over a scripted fixer and scripted inner gate closures in a temp visit directory.
+
+package gatefixer
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// fakeFixer is a Fixer scripted by its fields: it records its spawns and stops, answers running a set number of times before it ends, and can fail its spawn, its wait or its stop.
+type fakeFixer struct {
+	mu sync.Mutex
+	// runningFirst is how many waits answer running before the terminal answer.
+	runningFirst int
+	// reply is the reply of a fixer that ends done; a non-empty deadReason makes it end dead instead.
+	reply      string
+	deadReason string
+	spawnErr   error
+	awaitErr   error
+	stopErr    error
+
+	// onAwait, when set, runs at the start of every wait, outside the fixer's lock.
+	onAwait func()
+
+	specs  []Spec
+	stops  []string
+	awaits int
+	polls  int
+}
+
+func (f *fakeFixer) SpawnOrAttach(store Store, spec Spec) (*Record, bool, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.spawnErr != nil {
+		return nil, false, f.spawnErr
+	}
+	f.specs = append(f.specs, spec)
+	rec := &Record{StrandGUID: fmt.Sprintf("fix-%d", len(f.specs)), SpawnedAt: "1970-01-01T00:00:00Z", ReportPath: spec.ReportPath, ReplyPath: spec.ReplyPath}
+	return rec, true, store.Save(rec)
+}
+
+func (f *fakeFixer) Await(rec *Record, timeout, wait time.Duration) (*Result, error) {
+	if f.onAwait != nil {
+		f.onAwait()
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.awaits++
+	if f.awaitErr != nil {
+		return nil, f.awaitErr
+	}
+	f.polls++
+	if f.polls <= f.runningFirst {
+		return &Result{Status: StatusRunning}, nil
+	}
+	f.polls = 0
+	if f.deadReason != "" {
+		return &Result{Status: StatusDead, DeadReason: f.deadReason}, nil
+	}
+	return &Result{Status: StatusDone, Reply: f.reply}, nil
+}
+
+func (f *fakeFixer) Stop(rec *Record) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.stops = append(f.stops, rec.StrandGUID)
+	return f.stopErr
+}
+
+// scriptedGate answers each call with the next scripted result, the last one repeating, and counts its calls.
+type scriptedGate struct {
+	results []shuttleengine.GateResult
+	err     error
+	calls   int
+}
+
+func (g *scriptedGate) Gate() (shuttleengine.GateResult, error) {
+	result := g.results[min(g.calls, len(g.results)-1)]
+	g.calls++
+	return result, g.err
+}
+
+func passing() shuttleengine.GateResult { return shuttleengine.GateResult{Passed: true} }
+
+func failing(findings string) shuttleengine.GateResult {
+	return shuttleengine.GateResult{Findings: findings}
+}
+
+// rowHarness is a row fixer over a fakeFixer and a temp visit directory, for the entry named rowEntry.
+type rowHarness struct {
+	fixer    *fakeFixer
+	rf       RowFixer
+	visitDir string
+	// visitErr, when set, is what VisitDir returns.
+	visitErr error
+}
+
+const rowEntry = "verify"
+
+func newRowHarness(t *testing.T) *rowHarness {
+	t.Helper()
+	h := &rowHarness{fixer: &fakeFixer{reply: "fixed it"}, visitDir: t.TempDir()}
+	h.rf = RowFixer{
+		Fixer: h.fixer,
+		VisitDir: func() (string, error) {
+			return h.visitDir, h.visitErr
+		},
+		Spec: func(reportPath, replyPath string) (Spec, error) {
+			return Spec{ReportPath: reportPath, ReplyPath: replyPath, Role: RoleGateFixer}, nil
+		},
+		Timeout: time.Minute,
+	}
+	return h
+}
+
+func (h *rowHarness) store() rowStore { return newRowStore(h.visitDir, rowEntry) }
+
+// seed saves records into the entry's set.
+func (h *rowHarness) seed(t *testing.T, records ...Record) {
+	t.Helper()
+	for i := range records {
+		if err := h.store().Save(&records[i]); err != nil {
+			t.Fatalf("seed record %q: %v", records[i].StrandGUID, err)
+		}
+	}
+}
+
+// statuses returns the status of every record of the entry's set, in order.
+func (h *rowHarness) statuses(t *testing.T) []string {
+	t.Helper()
+	records, err := h.store().load()
+	if err != nil {
+		t.Fatalf("load records: %v", err)
+	}
+	var statuses []string
+	for _, rec := range records {
+		statuses = append(statuses, rec.Status)
+	}
+	return statuses
+}
+
+// wrap wraps a one-entry spec whose entry has the given gate, forked gate and attempts.
+func (h *rowHarness) wrap(t *testing.T, entry shuttleengine.GateEntry) shuttleengine.GateEntry {
+	t.Helper()
+	wrapped, err := WrapRowGate(shuttleengine.GateSpec{entry}, entry.Name, h.rf)
+	if err != nil {
+		t.Fatalf("WrapRowGate() error = %v; want none", err)
+	}
+	return wrapped[0]
+}
+
+func verifyEntry(gate *scriptedGate, attempts int) shuttleengine.GateEntry {
+	return shuttleengine.GateEntry{Name: rowEntry, Gate: gate.Gate, Attempts: attempts}
+}
+
+// TestWrapRowGate pins the fixer hand-off of the entry that carries the fixer, the wait of every other entry and the wrap's refusals.
+func TestWrapRowGate(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("InnerOutcomesThatSpawnNothing", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name         string
+			gate         scriptedGate
+			wantPassed   bool
+			wantFindings string
+			wantErr      error
+		}{
+			{"Passing", scriptedGate{results: []shuttleengine.GateResult{passing()}}, true, "", nil},
+			{"TerminalFailure", scriptedGate{results: []shuttleengine.GateResult{{Findings: "stop", Terminal: true}}}, false, "stop", nil},
+			{"Error", scriptedGate{results: []shuttleengine.GateResult{{}}, err: errors.New("infra")}, false, "", errors.New("infra")},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newRowHarness(t)
+				entry := h.wrap(t, verifyEntry(&tt.gate, 2))
+
+				got, err := entry.Gate()
+				if (err == nil) != (tt.wantErr == nil) || (err != nil && err.Error() != tt.wantErr.Error()) {
+					t.Fatalf("Gate() error = %v; want %v", err, tt.wantErr)
+				}
+				if got.Passed != tt.wantPassed || got.Findings != tt.wantFindings {
+					t.Errorf("Gate() = %+v; want passed %v and findings %q", got, tt.wantPassed, tt.wantFindings)
+				}
+				if len(h.fixer.specs) != 0 || tt.gate.calls != 1 {
+					t.Errorf("spawns = %d, inner calls = %d; want none and 1", len(h.fixer.specs), tt.gate.calls)
+				}
+			})
+		}
+	})
+
+	t.Run("FailureSpawnsOneFixerWaitsAndJudgesAgain", func(t *testing.T) {
+		t.Parallel()
+		h := newRowHarness(t)
+		h.fixer.runningFirst = 2
+		gate := &scriptedGate{results: []shuttleengine.GateResult{failing("lint broke"), passing()}}
+		entry := h.wrap(t, verifyEntry(gate, 2))
+
+		got, err := entry.Gate()
+		if err != nil || !got.Passed {
+			t.Fatalf("Gate() = %+v, %v; want a pass", got, err)
+		}
+		if len(h.fixer.specs) != 1 || gate.calls != 2 || h.fixer.awaits != 3 {
+			t.Errorf("spawns = %d, inner calls = %d, waits = %d; want 1, 2 and 3", len(h.fixer.specs), gate.calls, h.fixer.awaits)
+		}
+		report, err := os.ReadFile(h.fixer.specs[0].ReportPath)
+		if err != nil || string(report) != "lint broke" {
+			t.Errorf("report = %q, %v; want the inner findings", report, err)
+		}
+		if got := h.statuses(t); len(got) != 1 || got[0] != StatusDone {
+			t.Errorf("record statuses = %v; want one done record", got)
+		}
+	})
+
+	t.Run("ReRunFailureCarriesNewFindingsAndTheFixersAnswer", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name       string
+			deadReason string
+			wantNote   string
+		}{
+			{"Reply", "", "fixed it"},
+			{"DeadFixer", DeadReasonTimeout, "ended without a reply (timeout); any change it left uncommitted is in the worktree"},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newRowHarness(t)
+				h.fixer.deadReason = tt.deadReason
+				gate := &scriptedGate{results: []shuttleengine.GateResult{failing("first"), failing("second")}}
+				entry := h.wrap(t, verifyEntry(gate, 2))
+
+				got, err := entry.Gate()
+				if err != nil || got.Passed {
+					t.Fatalf("Gate() = %+v, %v; want a failure", got, err)
+				}
+				if !strings.HasPrefix(got.Findings, "second") || strings.Contains(got.Findings, "first") || !strings.Contains(got.Findings, "## Cold fixer reply") || !strings.Contains(got.Findings, tt.wantNote) {
+					t.Errorf("Gate().Findings = %q; want the new findings, then a reply section holding %q", got.Findings, tt.wantNote)
+				}
+				wantStatus := StatusDone
+				if tt.deadReason != "" {
+					wantStatus = StatusDead
+				}
+				if got := h.statuses(t); len(got) != 1 || got[0] != wantStatus {
+					t.Errorf("record statuses = %v; want one %s record", got, wantStatus)
+				}
+			})
+		}
+	})
+
+	t.Run("ForkedFailureSpawnsUnlessSkipForkedHoldsIt", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name       string
+			skip       bool
+			wantSpawns int
+		}{
+			{"SkipForkedFalse", false, 1},
+			{"SkipForkedTrue", true, 0},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newRowHarness(t)
+				h.rf.SkipForked = func(findings string) bool { return tt.skip && findings == "forked broke" }
+				plain := &scriptedGate{results: []shuttleengine.GateResult{passing()}}
+				forked := &scriptedGate{results: []shuttleengine.GateResult{failing("forked broke"), passing()}}
+				original := verifyEntry(plain, 2)
+				original.Forked = forked.Gate
+				entry := h.wrap(t, original)
+
+				got, err := entry.Forked()
+				if err != nil {
+					t.Fatalf("Forked() error = %v; want none", err)
+				}
+				if len(h.fixer.specs) != tt.wantSpawns || plain.calls != 0 {
+					t.Errorf("spawns = %d, plain calls = %d; want %d and 0", len(h.fixer.specs), plain.calls, tt.wantSpawns)
+				}
+				if wantPassed := tt.wantSpawns == 1; got.Passed != wantPassed {
+					t.Errorf("Forked().Passed = %v; want %v", got.Passed, wantPassed)
+				}
+			})
+		}
+	})
+
+	t.Run("SpawnErrorLeavesTheInnerFailureStandingWithNoRecord", func(t *testing.T) {
+		t.Parallel()
+		h := newRowHarness(t)
+		h.fixer.spawnErr = errors.New("no provider")
+		gate := &scriptedGate{results: []shuttleengine.GateResult{failing("lint broke")}}
+		entry := h.wrap(t, verifyEntry(gate, 2))
+
+		got, err := entry.Gate()
+		if err != nil || got.Passed {
+			t.Fatalf("Gate() = %+v, %v; want a failure and no error", got, err)
+		}
+		if !strings.HasPrefix(got.Findings, "lint broke") || !strings.Contains(got.Findings, "no provider") || !strings.Contains(got.Findings, "no fixer ran") {
+			t.Errorf("Gate().Findings = %q; want the inner findings and a line naming the spawn error and that no fixer ran", got.Findings)
+		}
+		if count, _ := h.store().count(); count != 0 || gate.calls != 1 {
+			t.Errorf("records = %d, inner calls = %d; want none and 1", count, gate.calls)
+		}
+	})
+
+	t.Run("ASetAtAttemptsPlusOneSpawnsNone", func(t *testing.T) {
+		t.Parallel()
+		h := newRowHarness(t)
+		h.seed(t, Record{StrandGUID: "a", Status: StatusDone}, Record{StrandGUID: "b", Status: StatusDead}, Record{StrandGUID: "c", Status: StatusDone})
+		gate := &scriptedGate{results: []shuttleengine.GateResult{failing("lint broke")}}
+		entry := h.wrap(t, verifyEntry(gate, 2))
+
+		got, err := entry.Gate()
+		if err != nil || got.Passed || got.Findings != "lint broke" || len(h.fixer.specs) != 0 {
+			t.Errorf("Gate() = %+v, %v with %d spawns; want the unchanged failure and no spawn", got, err, len(h.fixer.specs))
+		}
+	})
+
+	t.Run("ALiveRecordIsWaitedOnAndTheEntryJudgesOnce", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name         string
+			results      []shuttleengine.GateResult
+			wantPassed   bool
+			wantFindings string
+		}{
+			{"Passing", []shuttleengine.GateResult{passing()}, true, ""},
+			{"FailingFoldsTheReply", []shuttleengine.GateResult{failing("still broken")}, false, "still broken\n\n## Cold fixer reply\n\nfixed it"},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newRowHarness(t)
+				h.fixer.runningFirst = 1
+				h.seed(t, Record{StrandGUID: "left-live"})
+				gate := &scriptedGate{results: tt.results}
+				entry := h.wrap(t, verifyEntry(gate, 2))
+
+				got, err := entry.Gate()
+				if err != nil || got.Passed != tt.wantPassed || got.Findings != tt.wantFindings {
+					t.Errorf("Gate() = %+v, %v; want passed %v and findings %q", got, err, tt.wantPassed, tt.wantFindings)
+				}
+				if len(h.fixer.specs) != 0 || gate.calls != 1 || h.fixer.awaits != 2 {
+					t.Errorf("spawns = %d, inner calls = %d, waits = %d; want none, 1 and 2", len(h.fixer.specs), gate.calls, h.fixer.awaits)
+				}
+				if got := h.statuses(t); len(got) != 1 || got[0] != StatusDone {
+					t.Errorf("record statuses = %v; want the left-live record marked done", got)
+				}
