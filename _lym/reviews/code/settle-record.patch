+	}
+	if got := gitkit.RevParse(t, records, "HEAD"); got != headBefore || spawns != 2 {
+		t.Errorf("records HEAD = %s, spawns = %d with nothing to commit; want HEAD %s and 2 spawns", got, spawns, headBefore)
