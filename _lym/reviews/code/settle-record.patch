+		}
+	}
+	machine, err := machinename.Name()
+	if err != nil {
+		t.Fatalf("machine name: %v", err)
+	}
+	if _, err := boardengine.SetOwners(h.BoardDir(), boardengine.OwnerRequest{Machine: machine, Slugs: []string{slug, lone}, Beam: true}); err != nil {
