--- /dev/null
+++ b/internal/testcover/blockkey.go
@@ -0,0 +1,174 @@
+// blockkey.go keys coverage blocks by their content, so a block keeps its key when lines above it move.
+
+package testcover
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+)
+
+// PackageLevelFunc is the function a block key names for a block outside every function declaration.
+const PackageLevelFunc = "(package)"
+
+// BlockKey identifies a coverage block by its content rather than by its line and column.
+type BlockKey struct {
+	// File is the block's file name within its package directory.
+	File string `json:"file"`
+	// Func is the enclosing function, `Type.Method` for a method, or PackageLevelFunc.
+	Func string `json:"func"`
+	// Hash is the ContentHash of the block's source text.
+	Hash string `json:"hash"`
+	// Ordinal counts the blocks before this one, in source order, whose file, function and hash equal its own.
+	Ordinal int `json:"ordinal"`
+}
+
+// ContentHash returns the hex SHA-256 of data.
+// It is the hash a block key, and a coverage map's file and test entries, carry.
+func ContentHash(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+// KeyBlocks returns the content key of each block, in the order given.
+// Every block must lie in a Go file of the package directory dir, which it reads and parses.
+// Ordinals count among the blocks given, so a stable key needs every block of the package's profile, covered or not.
+// A file that does not parse, or a position outside its file, is an error.
+func KeyBlocks(dir string, blocks []ProfileBlock) ([]BlockKey, error) {
+	type located struct {
+		index int
+		start int
+	}
+	files := map[string]*sourceFile{}
+	keys := make([]BlockKey, len(blocks))
+	byFile := map[string][]located{}
+	for i, b := range blocks {
+		name := path.Base(b.File)
+		src, ok := files[name]
+		if !ok {
+			var err error
+			if src, err = parseSourceFile(filepath.Join(dir, name)); err != nil {
+				return nil, err
+			}
+			files[name] = src
+		}
+		start, err := src.offset(b.StartLine, b.StartCol)
+		if err != nil {
+			return nil, fmt.Errorf("block %s: %w", b.Position(), err)
+		}
+		end, err := src.offset(b.EndLine, b.EndCol)
+		if err != nil {
+			return nil, fmt.Errorf("block %s: %w", b.Position(), err)
+		}
+		if end < start {
+			return nil, fmt.Errorf("block %s ends before it starts", b.Position())
+		}
+		keys[i] = BlockKey{File: name, Func: src.enclosingFunc(start), Hash: ContentHash(src.text[start:end])}
+		byFile[name] = append(byFile[name], located{index: i, start: start})
+	}
+
+	for _, blocksOfFile := range byFile {
+		sort.SliceStable(blocksOfFile, func(a, b int) bool { return blocksOfFile[a].start < blocksOfFile[b].start })
+		seen := map[BlockKey]int{}
+		for _, l := range blocksOfFile {
+			base := keys[l.index]
+			keys[l.index].Ordinal = seen[base]
+			seen[base]++
+		}
+	}
+	return keys, nil
+}
+
+// sourceFile is one parsed Go file with the offsets of its function declarations.
+type sourceFile struct {
+	text  []byte
+	file  *token.File
+	funcs []funcSpan
+}
+
+// funcSpan is the byte range of one function declaration and the name a block key gives it.
+type funcSpan struct {
+	start, end int
+	name       string
+}
+
+func parseSourceFile(filename string) (*sourceFile, error) {
+	text, err := os.ReadFile(filename)
+	if err != nil {
+		return nil, err
+	}
+	fset := token.NewFileSet()
+	parsed, err := parser.ParseFile(fset, filename, text, parser.SkipObjectResolution)
+	if err != nil {
+		return nil, err
+	}
+	src := &sourceFile{text: text, file: fset.File(parsed.Pos())}
+	for _, decl := range parsed.Decls {
+		if fn, ok := decl.(*ast.FuncDecl); ok {
+			src.funcs = append(src.funcs, funcSpan{
+				start: src.file.Offset(fn.Pos()),
+				end:   src.file.Offset(fn.End()),
+				name:  funcKeyName(fn),
+			})
+		}
+	}
+	return src, nil
+}
+
+// offset returns the byte offset of a profile position: a line and a byte column, both counted from 1.
+func (src *sourceFile) offset(line, col int) (int, error) {
+	if line < 1 || line > src.file.LineCount() {
+		return 0, fmt.Errorf("line %d is outside the file's %d lines", line, src.file.LineCount())
+	}
+	offset := src.file.Offset(src.file.LineStart(line)) + col - 1
+	if col < 1 || offset > len(src.text) {
+		return 0, fmt.Errorf("column %d of line %d is outside the file", col, line)
+	}
+	return offset, nil
+}
+
+// enclosingFunc names the function declaration holding the byte at offset, or PackageLevelFunc.
+func (src *sourceFile) enclosingFunc(offset int) string {
+	for _, fn := range src.funcs {
+		if fn.start <= offset && offset < fn.end {
+			return fn.name
+		}
+	}
+	return PackageLevelFunc
+}
+
+// funcKeyName spells a function's name for a block key: `Type.Method` for a method, the bare name otherwise.
+func funcKeyName(fn *ast.FuncDecl) string {
+	if fn.Recv == nil || len(fn.Recv.List) == 0 {
+		return fn.Name.Name
+	}
+	return receiverTypeName(fn.Recv.List[0].Type) + "." + fn.Name.Name
+}
+
+// receiverTypeName strips the pointer, parentheses and type arguments from a receiver type.
+func receiverTypeName(expr ast.Expr) string {
+	for {
+		switch x := expr.(type) {
+		case *ast.StarExpr:
+			expr = x.X
+		case *ast.ParenExpr:
+			expr = x.X
+		case *ast.IndexExpr:
+			expr = x.X
+		case *ast.IndexListExpr:
+			expr = x.X
+		case *ast.Ident:
+			return x.Name
+		default:
+			return types.ExprString(expr)
+		}
+	}
+}
diff --git a/internal/testcover/blockkey_test.go b/internal/testcover/blockkey_test.go
new file mode 100644
index 000000000..cdf0f4868
--- /dev/null
+++ b/internal/testcover/blockkey_test.go
@@ -0,0 +1,119 @@
+package testcover_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// keyedSource holds two same-named methods on different receivers.
+// It also holds a function with two identical blocks and package-level code.
+// The bodies open at column 21 of their func line and close at column 2 of the line of their brace.
+const keyedSource = `package p
+
+func (a A) Do() int {
+	return 1
+}
+
+func (b *B) Do() int {
+	return 1
+}
+
+func twice(x bool) int {
+	if x {
+		return 1
+	}
+	if x {
+		return 1
+	}
+	return 0
+}
+
+var v = 1
+`
+
+func TestKeyBlocks(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	block := func(startLine, startCol, endLine, endCol int) testcover.ProfileBlock {
+		return testcover.ProfileBlock{File: "m/p/p.go", StartLine: startLine, StartCol: startCol, EndLine: endLine, EndCol: endCol, Statements: 1}
+	}
+	keysOf := func(t *testing.T, source string, blocks ...testcover.ProfileBlock) []testcover.BlockKey {
+		t.Helper()
+		dir := t.TempDir()
+		if err := os.WriteFile(filepath.Join(dir, "p.go"), []byte(source), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		keys, err := testcover.KeyBlocks(dir, blocks)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return keys
+	}
+
+	base := keysOf(t, keyedSource,
+		block(3, 21, 5, 2), block(7, 22, 9, 2), block(12, 7, 14, 3), block(15, 7, 17, 3), block(21, 9, 21, 10))
+	if base[0].Func != "A.Do" || base[1].Func != "B.Do" || base[0] == base[1] {
+		t.Errorf("same-named methods keyed %+v and %+v; want A.Do and B.Do with different keys", base[0], base[1])
+	}
+	if base[0].Hash != base[1].Hash {
+		t.Errorf("the two method bodies hash %s and %s; want one hash for one text", base[0].Hash, base[1].Hash)
+	}
+	if base[2].Func != "twice" || base[3].Func != "twice" || base[2].Hash != base[3].Hash || base[2].Ordinal != 0 || base[3].Ordinal != 1 {
+		t.Errorf("identical blocks in one function keyed %+v and %+v; want ordinals 0 and 1", base[2], base[3])
+	}
+	if base[4].Func != testcover.PackageLevelFunc {
+		t.Errorf("package-level block keyed under %q; want %q", base[4].Func, testcover.PackageLevelFunc)
+	}
+
+	shifted := keysOf(t, "// added above\n\n"+keyedSource,
+		block(5, 21, 7, 2), block(9, 22, 11, 2), block(14, 7, 16, 3), block(17, 7, 19, 3), block(23, 9, 23, 10))
+	for i := range base {
+		if shifted[i] != base[i] {
+			t.Errorf("block %d moved two lines down keyed %+v; want its unshifted key %+v", i, shifted[i], base[i])
+		}
+	}
+
+	edited := keysOf(t, "package p\n\nfunc (a A) Do() int {\n\treturn 2\n}\n", block(3, 21, 5, 2))
+	if edited[0] == base[0] {
+		t.Errorf("edited block keyed %+v, as before the edit; want a new key", edited[0])
+	}
+
+	// q.go repeats p.go's A.Do body, so the two keys differ only in File.
+	// Its generic receiver T[K] keys as T.Do.
+	twoFiles := t.TempDir()
+	const secondSource = "package p\n\nfunc (a A) Do() int {\n\treturn 1\n}\n\nfunc (t T[K]) Do() int {\n\treturn 1\n}\n"
+	for name, source := range map[string]string{"p.go": keyedSource, "q.go": secondSource} {
+		if err := os.WriteFile(filepath.Join(twoFiles, name), []byte(source), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	inSecondFile := func(startLine, startCol, endLine, endCol int) testcover.ProfileBlock {
+		b := block(startLine, startCol, endLine, endCol)
+		b.File = "m/p/q.go"
+		return b
+	}
+	crossFile, err := testcover.KeyBlocks(twoFiles, []testcover.ProfileBlock{block(3, 21, 5, 2), inSecondFile(3, 21, 5, 2), inSecondFile(7, 24, 9, 2)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if crossFile[0].File != "p.go" || crossFile[1].File != "q.go" || crossFile[0].Ordinal != 0 || crossFile[1].Ordinal != 0 ||
+		crossFile[0].Func != crossFile[1].Func || crossFile[0].Hash != crossFile[1].Hash {
+		t.Errorf("the same body in two files keyed %+v and %+v; want one function and hash, each file's own File, both ordinal 0", crossFile[0], crossFile[1])
+	}
+	if crossFile[2].Func != "T.Do" {
+		t.Errorf("generic receiver T[K] keyed %q; want T.Do", crossFile[2].Func)
+	}
+
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "p.go"), []byte(keyedSource), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := testcover.KeyBlocks(dir, []testcover.ProfileBlock{block(99, 1, 99, 2)}); err == nil {
+		t.Error("KeyBlocks of a line past the file's end = nil error; want an error")
+	}
+}
diff --git a/internal/testcover/coveragemap.go b/internal/testcover/coveragemap.go
new file mode 100644
index 000000000..83eab60b8
--- /dev/null
+++ b/internal/testcover/coveragemap.go
@@ -0,0 +1,65 @@
+// coveragemap.go declares the per-package coverage map record and reads and writes it through internal/state.
+
+package testcover
+
+import (
+	"path/filepath"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// mapFileName is the file name of a package's coverage map within its directory.
+const mapFileName = "map.json"
+
+// Map is one package's coverage map.
+// It records which blocks of the package's own files each judged test covers, and the tree it was built from.
+type Map struct {
+	// Commit is the commit the map was built from.
+	Commit string `json:"commit"`
+	// BuiltAt is when the map was built.
+	BuiltAt time.Time `json:"built_at"`
+	// Files maps each Go file the package directory tracks, by name, to its ContentHash.
+	Files map[string]string `json:"files"`
+	// Blocks is the block key table that MapTest.Blocks indexes.
+	Blocks []BlockKey `json:"blocks"`
+	// Tests holds one entry per judged top-level test.
+	Tests []MapTest `json:"tests"`
+	// BuildFailure is the error of a coverage build that failed, empty when the build succeeded.
+	BuildFailure string `json:"build_failure,omitempty"`
+}
+
+// MapTest is one judged top-level test of a coverage map.
+type MapTest struct {
+	Name string `json:"name"`
+	// Tier is the tier the test's tiergate.Require names.
+	Tier int `json:"tier"`
+	// FuncHash is the ContentHash of the test function's source text.
+	FuncHash string `json:"func_hash"`
+	// Seconds is the test's standalone duration.
+	Seconds float64 `json:"seconds"`
+	// Blocks are indexes into Map.Blocks of the blocks the test covers.
+	Blocks []int `json:"blocks"`
+}
+
+// MapPath returns the path of the coverage map of the package pkg under the maps directory dir.
+// pkg is a module-relative slash path.
+func MapPath(dir, pkg string) string {
+	return filepath.Join(dir, filepath.FromSlash(pkg), mapFileName)
+}
+
+// ReadMap reads the coverage map of the package pkg under the maps directory dir, and reports whether one exists.
+// A key the record does not declare is ignored, never refused.
+func ReadMap(dir, pkg string) (Map, bool, error) {
+	path := MapPath(dir, pkg)
+	return state.ReadJSON[Map](path, lock.TrackedFileLockPath(path, ".lock"))
+}
+
+// WriteMap replaces the coverage map of the package pkg under the maps directory dir with m, atomically,
+// so a reader sees either the old map or the new one.
+// It keeps each key of the replaced record that Map does not declare.
+func WriteMap(dir, pkg string, m Map) error {
+	path := MapPath(dir, pkg)
+	return state.WriteJSON(path, lock.TrackedFileLockPath(path, ".lock"), m)
+}
diff --git a/internal/testcover/coveragemap_test.go b/internal/testcover/coveragemap_test.go
new file mode 100644
index 000000000..8a3747a6c
--- /dev/null
+++ b/internal/testcover/coveragemap_test.go
@@ -0,0 +1,96 @@
+package testcover_test
+
+import (
+	"encoding/json"
+	"os"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestWriteMapReadMap(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	dir := t.TempDir()
+	const pkg = "internal/x"
+	written := testcover.Map{
+		Commit:  "0123abcd",
+		BuiltAt: time.Date(2026, 11, 9, 12, 0, 0, 0, time.UTC),
+		Files:   map[string]string{"x.go": "f1", "x_test.go": "f2"},
+		Blocks: []testcover.BlockKey{
+			{File: "x.go", Func: "A.Do", Hash: "h1"},
+			{File: "x.go", Func: "B.Do", Hash: "h1"},
+		},
+		Tests: []testcover.MapTest{
+			{Name: "TestA", Tier: 0, FuncHash: "t1", Seconds: 0.25, Blocks: []int{0}},
+			{Name: "TestB", Tier: 1, FuncHash: "t2", Seconds: 1.5, Blocks: []int{0, 1}},
+		},
+	}
+
+	if _, found, err := testcover.ReadMap(dir, pkg); err != nil || found {
+		t.Fatalf("ReadMap before any write = found %v, err %v; want not found and no error", found, err)
+	}
+	if err := testcover.WriteMap(dir, pkg, written); err != nil {
+		t.Fatal(err)
+	}
+	read, found, err := testcover.ReadMap(dir, pkg)
+	if err != nil || !found {
+		t.Fatalf("ReadMap = found %v, err %v; want the written map", found, err)
+	}
+	if !reflect.DeepEqual(read, written) {
+		t.Fatalf("ReadMap = %+v\nwant      %+v", read, written)
+	}
+
+	path := testcover.MapPath(dir, pkg)
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var record map[string]any
+	if err := json.Unmarshal(raw, &record); err != nil {
+		t.Fatal(err)
+	}
+	record["newer_key"] = "kept"
+	planted, err := json.Marshal(record)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, planted, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if read, _, err = testcover.ReadMap(dir, pkg); err != nil || !reflect.DeepEqual(read, written) {
+		t.Fatalf("ReadMap of a record with an unknown key = %+v, %v; want the map, unrefused", read, err)
+	}
+	if err := testcover.WriteMap(dir, pkg, written); err != nil {
+		t.Fatal(err)
+	}
+	if raw, err = os.ReadFile(path); err != nil {
+		t.Fatal(err)
+	}
+	record = nil
+	if err := json.Unmarshal(raw, &record); err != nil {
+		t.Fatal(err)
+	}
+	if record["newer_key"] != "kept" {
+		t.Errorf("rewritten record's newer_key = %v; want the unknown key kept", record["newer_key"])
+	}
+
+	replacement := testcover.Map{
+		Commit:       "4567ef89",
+		BuiltAt:      time.Date(2026, 11, 10, 8, 30, 0, 0, time.UTC),
+		Files:        map[string]string{"x.go": "f3"},
+		Blocks:       []testcover.BlockKey{{File: "x.go", Func: "C.Do", Hash: "h2", Ordinal: 1}},
+		Tests:        []testcover.MapTest{{Name: "TestC", Tier: 0, FuncHash: "t3", Seconds: 0.5, Blocks: []int{0}}},
+		BuildFailure: "coverage binary: build failed",
+	}
+	if err := testcover.WriteMap(dir, pkg, replacement); err != nil {
+		t.Fatal(err)
+	}
+	if read, _, err = testcover.ReadMap(dir, pkg); err != nil || !reflect.DeepEqual(read, replacement) {
+		t.Fatalf("ReadMap after a second write = %+v, %v; want the second map whole, with none of the first map's tests", read, err)
+	}
+}
diff --git a/internal/testcover/doc.go b/internal/testcover/doc.go
new file mode 100644
index 000000000..28a3dbdaa
--- /dev/null
+++ b/internal/testcover/doc.go
@@ -0,0 +1,26 @@
+// doc.go carries the package-level doc comment for internal/testcover.
+
+// Package testcover measures which blocks each top-level test of a Go package covers when it runs alone.
+// It judges from those block sets which tests are redundant.
+//
+// The runner builds a package's coverage test binary and runs each top-level test alone, serially, with its own profile.
+// Per-test coverage needs a process per test.
+// Coverage counters are process-wide, so tests that run in parallel in one process mix their counts.
+// The runner takes no gate slot; its caller holds one.
+//
+// Judge marks a test contained when another judged test of the same run covers each of its covered blocks.
+// It picks the removable set greedily among the contained tests, slowest first.
+// A test that is skipped, failed or covers nothing is not judged.
+// Nor is a test judged that the static spawn scan marks as possibly running module code in another process.
+// Its in-process coverage cannot see that code.
+// The keep scan reads each `//testtiming:keep <reason>` directive, which a caller reports and never judges by.
+//
+// A block's key is its content: its file, its enclosing function, a hash of its source text and its ordinal.
+// The ordinal counts blocks equal in the first three parts.
+// An unchanged block keeps its key when lines above it move; an edited block gets a new one.
+// Bound: two blocks with the same text in one function differ by ordinal alone.
+// So inserting a block that repeats the text of one in the same function shifts every later identical ordinal.
+//
+// The coverage map is one JSON record per package, read and written through internal/state.
+// It keeps the block key table and, for each judged test, the indexes of the blocks it covers.
+package testcover
diff --git a/internal/testcover/keep.go b/internal/testcover/keep.go
new file mode 100644
index 000000000..95f879c4a
--- /dev/null
+++ b/internal/testcover/keep.go
@@ -0,0 +1,71 @@
+// keep.go reads the `//testtiming:keep <reason>` directives of a package's test files.
+
+package testcover
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+const (
+	keepDirective = "//testtiming:keep"
+
+	// lymDirectivePrefix opens a `//lym:` directive line, which may stack between a keep and its func line.
+	lymDirectivePrefix = "//lym:"
+)
+
+var topLevelTestDecl = regexp.MustCompile(`^func (Test\w*)\(`)
+
+// ScanKeeps maps each test of the package directory marked with a `//testtiming:keep <reason>` line to its reason.
+// The directive sits above the test's `func Test…` line, with only `//lym:` directive lines allowed between them.
+// A directive with an empty reason, or one not placed above a top-level test declaration, is an error.
+// The error names the file and line.
+func ScanKeeps(dir string) (map[string]string, error) {
+	files, err := filepath.Glob(filepath.Join(dir, "*_test.go"))
+	if err != nil {
+		return nil, err
+	}
+	keeps := map[string]string{}
+	for _, file := range files {
+		content, err := os.ReadFile(file)
+		if err != nil {
+			return nil, err
+		}
+		lines := strings.Split(string(content), "\n")
+		for i, line := range lines {
+			reason, ok := keepReason(line)
+			if !ok {
+				continue
+			}
+			where := fmt.Sprintf("%s:%d", file, i+1)
+			next := i + 1
+			for next < len(lines) && strings.HasPrefix(lines[next], lymDirectivePrefix) {
+				next++
+			}
+			var test []string
+			if next < len(lines) {
+				test = topLevelTestDecl.FindStringSubmatch(lines[next])
+			}
+			if test == nil {
+				return nil, fmt.Errorf("%s: %s is not directly above a top-level test function", where, keepDirective)
+			}
+			if reason == "" {
+				return nil, fmt.Errorf("%s: %s on %s has no reason", where, keepDirective, test[1])
+			}
+			keeps[test[1]] = reason
+		}
+	}
+	return keeps, nil
+}
+
+// keepReason returns the trimmed reason of a keep directive line, and reports whether the line is one.
+func keepReason(line string) (string, bool) {
+	rest, ok := strings.CutPrefix(line, keepDirective)
+	if !ok || (rest != "" && rest[0] != ' ' && rest[0] != '\t') {
+		return "", false
+	}
+	return strings.TrimSpace(rest), true
+}
diff --git a/internal/testcover/keep_test.go b/internal/testcover/keep_test.go
new file mode 100644
index 000000000..e78fb8c9a
--- /dev/null
+++ b/internal/testcover/keep_test.go
@@ -0,0 +1,102 @@
+package testcover_test
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestScanKeeps(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	rows := []struct {
+		name    string
+		content string
+		want    map[string]string
+		wantErr string
+	}{
+		{
+			name:    "directive directly above a test",
+			content: "package p\n\n//testtiming:keep pins the error text\nfunc TestA(t *testing.T) {}\n",
+			want:    map[string]string{"TestA": "pins the error text"},
+		},
+		{
+			name:    "directive below a doc comment",
+			content: "package p\n\n// TestB checks b.\n//testtiming:keep pins the ordering\nfunc TestB(t *testing.T) {}\n",
+			want:    map[string]string{"TestB": "pins the ordering"},
+		},
+		{
+			name:    "directive above a guard marker",
+			content: "package p\n\n//testtiming:keep pins the ordering\n//lym:guard\nfunc TestB2(t *testing.T) {}\n",
+			want:    map[string]string{"TestB2": "pins the ordering"},
+		},
+		{
+			name:    "guard marker above a directive",
+			content: "package p\n\n//lym:guard\n//testtiming:keep pins the ordering\nfunc TestB3(t *testing.T) {}\n",
+			want:    map[string]string{"TestB3": "pins the ordering"},
+		},
+		{
+			name:    "no directive",
+			content: "package p\n\nfunc TestC(t *testing.T) {}\n",
+			want:    map[string]string{},
+		},
+		{
+			name:    "empty reason",
+			content: "package p\n\n//testtiming:keep\nfunc TestD(t *testing.T) {}\n",
+			wantErr: "x_test.go:3: //testtiming:keep on TestD has no reason",
+		},
+		{
+			name:    "whitespace-only reason",
+			content: "package p\n\n//testtiming:keep   \t\nfunc TestE(t *testing.T) {}\n",
+			wantErr: "x_test.go:3: //testtiming:keep on TestE has no reason",
+		},
+		{
+			name:    "directive separated from its test",
+			content: "package p\n\n//testtiming:keep reason\n\nfunc TestF(t *testing.T) {}\n",
+			wantErr: "x_test.go:3: //testtiming:keep is not directly above a top-level test function",
+		},
+		{
+			name:    "doubled directive",
+			content: "package p\n\n//testtiming:keep first\n//testtiming:keep second\nfunc TestG(t *testing.T) {}\n",
+			wantErr: "x_test.go:3: //testtiming:keep is not directly above a top-level test function",
+		},
+		{
+			name:    "directive above a non-test function",
+			content: "package p\n\n//testtiming:keep reason\nfunc helper() {}\n",
+			wantErr: "x_test.go:3: //testtiming:keep is not directly above a top-level test function",
+		},
+		{
+			name:    "directive at end of file",
+			content: "package p\n\nfunc TestH(t *testing.T) {}\n//testtiming:keep reason",
+			wantErr: "x_test.go:4: //testtiming:keep is not directly above a top-level test function",
+		},
+	}
+	for _, row := range rows {
+		t.Run(row.name, func(t *testing.T) {
+			t.Parallel()
+			dir := t.TempDir()
+			if err := os.WriteFile(filepath.Join(dir, "x_test.go"), []byte(row.content), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			got, err := testcover.ScanKeeps(dir)
+			if row.wantErr != "" {
+				if err == nil || !strings.HasSuffix(strings.ReplaceAll(err.Error(), dir+string(filepath.Separator), ""), row.wantErr) {
+					t.Fatalf("ScanKeeps error = %v, want one ending %q", err, row.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, row.want) {
+				t.Fatalf("ScanKeeps = %v, want %v", got, row.want)
+			}
+		})
+	}
+}
diff --git a/internal/testcover/profile.go b/internal/testcover/profile.go
new file mode 100644
index 000000000..7c0085db8
--- /dev/null
+++ b/internal/testcover/profile.go
@@ -0,0 +1,97 @@
+// profile.go parses a Go coverage profile into its blocks and derives the block sets a verdict compares.
+
+package testcover
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"path"
+	"strconv"
+	"strings"
+)
+
+// ProfileBlock is one block line of a Go coverage profile.
+type ProfileBlock struct {
+	// File is the block's file as the profile names it: the package import path joined with the file name.
+	File string
+	// StartLine and StartCol open the block, and EndLine and EndCol close it; columns count bytes from 1.
+	StartLine, StartCol, EndLine, EndCol int
+	Statements                           int
+	Count                                int
+}
+
+// Position returns the block's file with its start and end, the form a profile line names the block by.
+func (b ProfileBlock) Position() string {
+	return fmt.Sprintf("%s:%d.%d,%d.%d", b.File, b.StartLine, b.StartCol, b.EndLine, b.EndCol)
+}
+
+// BlockSet is a set of block identities compared by equality, such as positions or rendered keys.
+type BlockSet map[string]struct{}
+
+// ParseProfile returns every block of a coverage profile, covered or not, in the profile's order.
+// A line that is not a mode line and does not parse as a block is an error naming the line.
+func ParseProfile(r io.Reader) ([]ProfileBlock, error) {
+	var blocks []ProfileBlock
+	sc := bufio.NewScanner(r)
+	sc.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+	for sc.Scan() {
+		line := sc.Text()
+		if line == "" || strings.HasPrefix(line, "mode:") {
+			continue
+		}
+		block, err := parseProfileLine(line)
+		if err != nil {
+			return nil, fmt.Errorf("malformed profile line %q: %w", line, err)
+		}
+		blocks = append(blocks, block)
+	}
+	return blocks, sc.Err()
+}
+
+// parseProfileLine parses one `file:startLine.startCol,endLine.endCol statements count` line.
+func parseProfileLine(line string) (ProfileBlock, error) {
+	fields := strings.Fields(line)
+	if len(fields) != 3 {
+		return ProfileBlock{}, fmt.Errorf("want a position, a statement count and a count, got %d fields", len(fields))
+	}
+	cut := strings.LastIndexByte(fields[0], ':')
+	if cut < 0 {
+		return ProfileBlock{}, fmt.Errorf("position %q names no file", fields[0])
+	}
+	block := ProfileBlock{File: fields[0][:cut]}
+	if _, err := fmt.Sscanf(fields[0][cut+1:], "%d.%d,%d.%d", &block.StartLine, &block.StartCol, &block.EndLine, &block.EndCol); err != nil {
+		return ProfileBlock{}, fmt.Errorf("position %q: %w", fields[0], err)
+	}
+	var err error
+	if block.Statements, err = strconv.Atoi(fields[1]); err != nil {
+		return ProfileBlock{}, err
+	}
+	if block.Count, err = strconv.Atoi(fields[2]); err != nil {
+		return ProfileBlock{}, err
+	}
+	return block, nil
+}
+
+// PackageBlocks returns the blocks that lie in the files of the package at importPath itself.
+// It leaves out blocks in a package nested below it.
+func PackageBlocks(blocks []ProfileBlock, importPath string) []ProfileBlock {
+	var own []ProfileBlock
+	for _, b := range blocks {
+		if path.Dir(b.File) == importPath {
+			own = append(own, b)
+		}
+	}
+	return own
+}
+
+// CoveredPositions returns the positions of the blocks with a non-zero count.
+func CoveredPositions(blocks []ProfileBlock) BlockSet {
+	covered := BlockSet{}
+	for _, b := range blocks {
+		if b.Count != 0 {
+			covered[b.Position()] = struct{}{}
+		}
+	}
+	return covered
+}
diff --git a/internal/testcover/profile_test.go b/internal/testcover/profile_test.go
new file mode 100644
index 000000000..5d97d9f66
--- /dev/null
+++ b/internal/testcover/profile_test.go
@@ -0,0 +1,45 @@
+package testcover_test
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestParseProfile(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	profile := "mode: set\n" +
+		"m/a/x.go:1.1,2.2 1 1\n" +
+		"m/a/x.go:3.1,4.2 2 0\n" +
+		"m/a/b/y.go:5.1,6.2 1 3\n"
+	blocks, err := testcover.ParseProfile(strings.NewReader(profile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []testcover.ProfileBlock{
+		{File: "m/a/x.go", StartLine: 1, StartCol: 1, EndLine: 2, EndCol: 2, Statements: 1, Count: 1},
+		{File: "m/a/x.go", StartLine: 3, StartCol: 1, EndLine: 4, EndCol: 2, Statements: 2, Count: 0},
+		{File: "m/a/b/y.go", StartLine: 5, StartCol: 1, EndLine: 6, EndCol: 2, Statements: 1, Count: 3},
+	}
+	if !reflect.DeepEqual(blocks, want) {
+		t.Fatalf("ParseProfile = %+v\nwant           %+v", blocks, want)
+	}
+
+	if got, want := testcover.CoveredPositions(blocks), blockSet("m/a/x.go:1.1,2.2", "m/a/b/y.go:5.1,6.2"); !reflect.DeepEqual(got, want) {
+		t.Errorf("CoveredPositions = %v; want %v", got, want)
+	}
+	if got := testcover.PackageBlocks(blocks, "m/a"); !reflect.DeepEqual(got, want[:2]) {
+		t.Errorf("PackageBlocks(m/a) = %+v; want the two blocks of m/a/x.go, not the nested package's", got)
+	}
+
+	for _, malformed := range []string{"no-count-here", "m/a/x.go:1.1,2.2 1 x", "m/a/x.go:1.1 1 1", "x.go 1 1"} {
+		if _, err := testcover.ParseProfile(strings.NewReader("mode: set\n" + malformed + "\n")); err == nil {
+			t.Errorf("ParseProfile(%q) = nil error; want a malformed line error", malformed)
+		}
+	}
+}
diff --git a/internal/testcover/runner.go b/internal/testcover/runner.go
new file mode 100644
index 000000000..32a8620d1
--- /dev/null
+++ b/internal/testcover/runner.go
@@ -0,0 +1,156 @@
+// runner.go builds a package's coverage test binary and lists its top-level tests.
+// It runs each test alone with its own profile.
+
+package testcover
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// Outcomes a test run reads from the coverage binary's verbose output.
+const (
+	ActionPass = "pass"
+	ActionFail = "fail"
+	ActionSkip = "skip"
+)
+
+// Toolchain runs the go command and the coverage binaries it builds.
+type Toolchain struct {
+	// Go names the go command.
+	Go string
+	// Env is the whole environment every command runs under.
+	Env []string
+}
+
+// RunResult is one top-level test run alone under a coverage binary.
+type RunResult struct {
+	Name string
+	// Elapsed is the seconds the binary reported for the test.
+	Elapsed float64
+	// Action is ActionPass, ActionFail or ActionSkip.
+	Action string
+	// Profile holds every block of the run's profile, covered or not; it is nil for a failed run.
+	Profile []ProfileBlock
+}
+
+// BuildBinary builds the coverage test binary of the package at importPath into out.
+// The binary counts blocks in set mode over the packages coverpkg names, comma-separated, under the build tags tags.
+// The error carries the go command's stderr.
+func (tc Toolchain) BuildBinary(importPath, coverpkg, tags, out string) error {
+	args := appendTags([]string{"test", "-c", "-o", out, "-cover", "-covermode=set", "-coverpkg=" + coverpkg}, tags)
+	if _, err := tc.goOutput(append(args, importPath), "CGO_ENABLED=1"); err != nil {
+		return fmt.Errorf("coverage binary: %w", err)
+	}
+	return nil
+}
+
+var testNameLine = regexp.MustCompile(`^(Test|Example|Fuzz)\w*$`)
+
+// ListTests returns the top-level test names of the package at importPath under the build tags tags.
+func (tc Toolchain) ListTests(importPath, tags string) ([]string, error) {
+	out, err := tc.goOutput(append(appendTags([]string{"test", "-list", ".*"}, tags), importPath))
+	if err != nil {
+		return nil, fmt.Errorf("list tests: %w", err)
+	}
+	var names []string
+	for _, line := range strings.Split(out, "\n") {
+		if name := strings.TrimSpace(line); testNameLine.MatchString(name) {
+			names = append(names, name)
+		}
+	}
+	return names, nil
+}
+
+var testResultLine = regexp.MustCompile(`(?m)^--- (PASS|FAIL|SKIP): (\S+) \(([0-9.]+)s\)$`)
+
+// RunAlone runs the top-level test name alone under the coverage binary bin in dir, writing its profile to profile.
+// It reads the test's outcome and elapsed time from the binary's verbose output,
+// and the profile's blocks for a test that passed, or skipped after writing one.
+// A failing test is returned as such, never as an error.
+// The error reports a binary that did not start, or a passing test whose profile is missing or malformed.
+func (tc Toolchain) RunAlone(bin, dir, profile, name string) (RunResult, error) {
+	if err := os.Remove(profile); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return RunResult{}, fmt.Errorf("remove the previous profile: %w", err)
+	}
+	cmd := exec.Command(bin, runAloneArgs(name, profile)...)
+	cmd.Dir = dir
+	cmd.Env = tc.Env
+	var out bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &out, &out
+	logger.Info("testcover: spawning a coverage binary for one test", "binary", bin, "test", name)
+	err := cmd.Run()
+	logger.Info("testcover: coverage binary ended", "test", name, "error", err)
+	var exitErr *exec.ExitError
+	if err != nil && !errors.As(err, &exitErr) {
+		return RunResult{}, fmt.Errorf("run %s: %w", name, err)
+	}
+
+	run := RunResult{Name: name, Action: ActionFail}
+	for _, m := range testResultLine.FindAllStringSubmatch(out.String(), -1) {
+		if m[2] == name {
+			run.Action = strings.ToLower(m[1])
+			run.Elapsed, _ = strconv.ParseFloat(m[3], 64)
+		}
+	}
+	if run.Action == ActionFail {
+		return run, nil
+	}
+	f, err := os.Open(profile)
+	if err != nil {
+		if run.Action == ActionSkip {
+			return run, nil
+		}
+		return RunResult{}, fmt.Errorf("test %s wrote no coverage profile: %w", name, err)
+	}
+	defer f.Close()
+	if run.Profile, err = ParseProfile(f); err != nil {
+		return RunResult{}, fmt.Errorf("test %s: %w", name, err)
+	}
+	return run, nil
+}
+
+// runAloneArgs returns the coverage binary's arguments for running one top-level test alone.
+// Every flag is one `-flag=value` argument, the form `go test` passes:
+// a test that runs a cobra command without `SetArgs` reads the process's arguments,
+// and a separate flag value would show up there as a positional argument.
+func runAloneArgs(name, profile string) []string {
+	return []string{
+		"-test.run=^" + regexp.QuoteMeta(name) + "$",
+		"-test.coverprofile=" + profile,
+		"-test.v=true",
+	}
+}
+
+// appendTags appends the `-tags` flag for tags to args, or nothing when tags is empty.
+func appendTags(args []string, tags string) []string {
+	if tags == "" {
+		return args
+	}
+	return append(args, "-tags", tags)
+}
+
+// goOutput runs the go command with args under the toolchain's environment plus extraEnv, and returns its stdout.
+// The error carries stderr.
+func (tc Toolchain) goOutput(args []string, extraEnv ...string) (string, error) {
+	cmd := exec.Command(tc.Go, args...)
+	cmd.Env = append(slices.Clone(tc.Env), extraEnv...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	logger.Info("testcover: spawning go", "binary", tc.Go, "args", args)
+	err := cmd.Run()
+	logger.Info("testcover: go ended", "args", args, "error", err)
+	if err != nil {
+		return "", fmt.Errorf("%s %s: %w: %s", tc.Go, strings.Join(args, " "), err, strings.TrimSpace(stderr.String()))
+	}
+	return stdout.String(), nil
+}
diff --git a/internal/testcover/runner_test.go b/internal/testcover/runner_test.go
new file mode 100644
index 000000000..688683840
--- /dev/null
+++ b/internal/testcover/runner_test.go
@@ -0,0 +1,119 @@
+// runner_test.go drives the runner against the test binary re-exec'd as a stand-in `go` and a stand-in coverage binary,
+// so no test builds a real test binary or runs `go test`.
+
+package testcover_test
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// standIn returns a toolchain whose go command is the test binary acting as a stand-in.
+// It also returns the file the stand-in records its arguments into.
+func standIn(t *testing.T) (testcover.Toolchain, string) {
+	t.Helper()
+	testBinary, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	record := filepath.Join(t.TempDir(), "args")
+	return testcover.Toolchain{Go: testBinary, Env: append(os.Environ(), standInRecordEnv+"="+record)}, record
+}
+
+func recordedArgs(t *testing.T, record string) []string {
+	t.Helper()
+	recorded, err := os.ReadFile(record)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return strings.Split(string(recorded), "\n")
+}
+
+func TestBuildBinaryAndListTests(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	tc, record := standIn(t)
+	out := filepath.Join(t.TempDir(), "pkg.test")
+	if err := tc.BuildBinary("m/p", "m/p,m/q", "tier0,tier1", out); err != nil {
+		t.Fatal(err)
+	}
+	wantBuild := []string{"test", "-c", "-o", out, "-cover", "-covermode=set", "-coverpkg=m/p,m/q", "-tags", "tier0,tier1", "m/p"}
+	if got := recordedArgs(t, record); !reflect.DeepEqual(got, wantBuild) {
+		t.Errorf("BuildBinary ran go %q; want %q", got, wantBuild)
+	}
+	if _, err := os.Stat(out); err != nil {
+		t.Errorf("BuildBinary left no binary at %s: %v", out, err)
+	}
+
+	names, err := tc.ListTests("m/p", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"TestAlpha", "ExampleBeta"}; !reflect.DeepEqual(names, want) {
+		t.Errorf("ListTests = %q; want %q, without the package's ok line", names, want)
+	}
+	if got, want := recordedArgs(t, record), []string{"test", "-list", ".*", "m/p"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("ListTests ran go %q; want %q, with no -tags for empty tags", got, want)
+	}
+}
+
+func TestRunAlone(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		test    string
+		want    testcover.RunResult
+		wantErr string
+	}{
+		{
+			name: "Pass",
+			test: standInPass,
+			want: testcover.RunResult{Name: standInPass, Elapsed: 0.25, Action: testcover.ActionPass, Profile: []testcover.ProfileBlock{
+				{File: "m/p/x.go", StartLine: 3, StartCol: 21, EndLine: 5, EndCol: 2, Statements: 1, Count: 1},
+			}},
+		},
+		{name: "Fail", test: standInFail, want: testcover.RunResult{Name: standInFail, Elapsed: 0.1, Action: testcover.ActionFail}},
+		{name: "SkipWithoutProfile", test: standInSkip, want: testcover.RunResult{Name: standInSkip, Action: testcover.ActionSkip}},
+		{
+			name: "SkipWithProfile",
+			test: standInSkipProfile,
+			want: testcover.RunResult{Name: standInSkipProfile, Action: testcover.ActionSkip, Profile: []testcover.ProfileBlock{
+				{File: "m/p/x.go", StartLine: 3, StartCol: 21, EndLine: 5, EndCol: 2, Statements: 1, Count: 1},
+			}},
+		},
+		{name: "PassWithoutProfile", test: standInNoProfile, wantErr: "wrote no coverage profile"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			tc, record := standIn(t)
+			profile := filepath.Join(t.TempDir(), "cover.out")
+			got, err := tc.RunAlone(tc.Go, t.TempDir(), profile, tt.test)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("RunAlone(%s) error = %v; want one holding %q", tt.test, err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("RunAlone(%s) = %+v; want %+v", tt.test, got, tt.want)
+			}
+			wantArgs := []string{"-test.run=^" + tt.test + "$", "-test.coverprofile=" + profile, "-test.v=true"}
+			if args := recordedArgs(t, record); !reflect.DeepEqual(args, wantArgs) {
+				t.Errorf("RunAlone ran the binary with %q; want %q, each flag one -flag=value argument", args, wantArgs)
+			}
+		})
+	}
+}
diff --git a/internal/testcover/spawnscan.go b/internal/testcover/spawnscan.go
new file mode 100644
index 000000000..f1fcbe189
--- /dev/null
+++ b/internal/testcover/spawnscan.go
@@ -0,0 +1,431 @@
+// spawnscan.go statically marks the tests whose in-process coverage cannot be judged.
+// Such a test may run this module's code in another process or call something the scan cannot resolve.
+
+package testcover
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/impactset"
+)
+
+// tmuxTierNumber is the tier whose tests start tmux servers, and so run lym in reed panes.
+const tmuxTierNumber = 2
+
+// SpawnVerdict is the static classification of one test.
+// A test whose verdict has either field set is never judged:
+// its in-process coverage does not see the module code another process ran.
+type SpawnVerdict struct {
+	// OutOfProcess is set when the test may run this module's code in another process.
+	// That covers a followed call, and a test in a tmux-tier file.
+	OutOfProcess bool
+	// Unresolved is set when the test calls something the scan cannot resolve to source.
+	Unresolved bool
+}
+
+func (v *SpawnVerdict) merge(o SpawnVerdict) {
+	v.OutOfProcess = v.OutOfProcess || o.OutOfProcess
+	v.Unresolved = v.Unresolved || o.Unresolved
+}
+
+// funcInfo is one declared function or method with the imports and build tier of its file.
+type funcInfo struct {
+	decl *ast.FuncDecl
+	// imports maps each file-level import name to its import path.
+	imports map[string]string
+	// isTest is set for a function declared in a _test.go file.
+	isTest bool
+	// tmuxTier is set when the file's tier, as impactset.FileTier reads it, is the tmux tier.
+	tmuxTier bool
+	// tagged is set when the file's tier is above tier0.
+	tagged bool
+}
+
+// pkgSource indexes the declarations of one directory's Go sources.
+type pkgSource struct {
+	// funcs holds the package-level functions by name.
+	funcs map[string][]*funcInfo
+	// methods holds the methods by name, whatever the receiver.
+	methods      map[string][]*funcInfo
+	varNames     map[string]bool
+	typeNames    map[string]bool
+	ifaceMethods map[string]bool
+	// funcFields holds the struct fields of function type.
+	funcFields map[string]bool
+}
+
+var builtinNames = map[string]bool{
+	"append": true, "cap": true, "clear": true, "close": true, "complex": true, "copy": true,
+	"delete": true, "imag": true, "len": true, "make": true, "max": true, "min": true,
+	"new": true, "panic": true, "print": true, "println": true, "real": true, "recover": true,
+	"bool": true, "byte": true, "complex64": true, "complex128": true, "error": true,
+	"float32": true, "float64": true, "int": true, "int8": true, "int16": true, "int32": true,
+	"int64": true, "rune": true, "string": true, "uint": true, "uint8": true, "uint16": true,
+	"uint32": true, "uint64": true, "uintptr": true, "any": true, "comparable": true,
+}
+
+// loadPkgSource parses every .go file in dir regardless of build constraints,
+// so a helper declared in a platform-specific file is still found.
+// Test files are skipped unless withTests is set.
+func loadPkgSource(dir string, withTests bool) (*pkgSource, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	src := &pkgSource{
+		funcs: map[string][]*funcInfo{}, methods: map[string][]*funcInfo{},
+		varNames: map[string]bool{}, typeNames: map[string]bool{},
+		ifaceMethods: map[string]bool{}, funcFields: map[string]bool{},
+	}
+	fset := token.NewFileSet()
+	for _, e := range entries {
+		name := e.Name()
+		isTest := strings.HasSuffix(name, "_test.go")
+		if e.IsDir() || !strings.HasSuffix(name, ".go") || (isTest && !withTests) {
+			continue
+		}
+		file, err := parser.ParseFile(fset, filepath.Join(dir, name), nil, parser.SkipObjectResolution|parser.ParseComments)
+		if err != nil {
+			return nil, err
+		}
+		tier := impactset.FileTier(file)
+		tagged, tmuxTier := tier > 0, tier == tmuxTierNumber
+		imports := map[string]string{}
+		for _, imp := range file.Imports {
+			p := strings.Trim(imp.Path.Value, `"`)
+			local := path.Base(p)
+			if imp.Name != nil {
+				local = imp.Name.Name
+			}
+			if local != "_" && local != "." {
+				imports[local] = p
+			}
+		}
+		for _, decl := range file.Decls {
+			switch d := decl.(type) {
+			case *ast.FuncDecl:
+				fi := &funcInfo{decl: d, imports: imports, isTest: isTest, tmuxTier: tmuxTier, tagged: tagged}
+				if d.Recv != nil {
+					src.methods[d.Name.Name] = append(src.methods[d.Name.Name], fi)
+				} else {
+					src.funcs[d.Name.Name] = append(src.funcs[d.Name.Name], fi)
+				}
+			case *ast.GenDecl:
+				src.indexGenDecl(d)
+			}
+		}
+	}
+	return src, nil
+}
+
+func (src *pkgSource) indexGenDecl(d *ast.GenDecl) {
+	for _, spec := range d.Specs {
+		switch s := spec.(type) {
+		case *ast.ValueSpec:
+			if d.Tok == token.VAR {
+				for _, n := range s.Names {
+					src.varNames[n.Name] = true
+				}
+			}
+		case *ast.TypeSpec:
+			src.typeNames[s.Name.Name] = true
+			switch t := s.Type.(type) {
+			case *ast.StructType:
+				for _, f := range t.Fields.List {
+					if _, ok := f.Type.(*ast.FuncType); ok {
+						for _, n := range f.Names {
+							src.funcFields[n.Name] = true
+						}
+					}
+				}
+			case *ast.InterfaceType:
+				for _, m := range t.Methods.List {
+					for _, n := range m.Names {
+						src.ifaceMethods[n.Name] = true
+					}
+				}
+			}
+		}
+	}
+}
+
+// spawnScanner classifies functions against the module's spawn primitives.
+type spawnScanner struct {
+	// module is the module import path.
+	module string
+	// kitRoot is the directory holding the testkits.
+	kitRoot string
+	kits    map[string]map[string]bool
+}
+
+// ScanSpawns returns the verdict of every Test, Example and Fuzz function declared in pkgDir's _test.go files.
+// module is the module's import path, and kitRoot the directory holding its testkits, whose functions the scan follows.
+// The out-of-process references are the lymbin kit, os.Executable, os.Args[0] and exec.Command("go", ...).
+// A test is out of process when it references one, directly or through a followed same-package or testkit call.
+// A test in a tier0 file always gets an empty verdict, because a tier0 test spawns nothing;
+// a test in a tmux-tier file is always out of process, because reed panes run lym.
+// Bound: the scan does not see a hook, alias or helper that a test installs so that git runs module code.
+func ScanSpawns(module, kitRoot, pkgDir string) (map[string]SpawnVerdict, error) {
+	src, err := loadPkgSource(pkgDir, true)
+	if err != nil {
+		return nil, err
+	}
+	s := &spawnScanner{module: module, kitRoot: kitRoot, kits: map[string]map[string]bool{}}
+	memo := map[*funcInfo]*SpawnVerdict{}
+	out := map[string]SpawnVerdict{}
+	for name, fns := range src.funcs {
+		for _, fn := range fns {
+			if fn.isTest && isTestEntry(name) {
+				found := s.analyze(src, fn, memo)
+				switch {
+				case !fn.tagged:
+					found = SpawnVerdict{}
+				case fn.tmuxTier:
+					found.OutOfProcess = true
+				}
+				v := out[name]
+				v.merge(found)
+				out[name] = v
+			}
+		}
+	}
+	return out, nil
+}
+
+func isTestEntry(name string) bool {
+	return strings.HasPrefix(name, "Test") || strings.HasPrefix(name, "Example") || strings.HasPrefix(name, "Fuzz")
+}
+
+// analyze follows fn's body, merging the verdicts of the same-package functions it calls.
+// A call cycle contributes its partial verdict once, then stops.
+func (s *spawnScanner) analyze(src *pkgSource, fn *funcInfo, memo map[*funcInfo]*SpawnVerdict) SpawnVerdict {
+	if v, ok := memo[fn]; ok {
+		return *v
+	}
+	v := &SpawnVerdict{}
+	memo[fn] = v
+	if fn.decl.Body == nil {
+		return *v
+	}
+	locals, localTypes := collectLocals(fn.decl)
+	ast.Inspect(fn.decl.Body, func(n ast.Node) bool {
+		switch x := n.(type) {
+		case *ast.SelectorExpr:
+			if id, ok := x.X.(*ast.Ident); ok {
+				if p, isImport := fn.imports[id.Name]; isImport && !locals[id.Name] && s.spawnRef(p, x.Sel.Name) {
+					v.OutOfProcess = true
+				}
+			}
+		case *ast.IndexExpr:
+			if readsOSArgsProgram(fn, x, locals) {
+				v.OutOfProcess = true
+			}
+		case *ast.CallExpr:
+			if runsGoCommand(fn, x, locals) {
+				v.OutOfProcess = true
+			}
+			v.merge(s.analyzeCall(src, fn, x, locals, localTypes, memo))
+		}
+		return true
+	})
+	return *v
+}
+
+func (s *spawnScanner) analyzeCall(src *pkgSource, fn *funcInfo, call *ast.CallExpr, locals, localTypes map[string]bool, memo map[*funcInfo]*SpawnVerdict) SpawnVerdict {
+	var out SpawnVerdict
+	switch f := unwrapCallee(call.Fun).(type) {
+	case *ast.Ident:
+		switch {
+		case builtinNames[f.Name] || localTypes[f.Name]:
+		case locals[f.Name], src.varNames[f.Name]:
+			out.Unresolved = true
+		case len(src.funcs[f.Name]) > 0:
+			for _, callee := range src.funcs[f.Name] {
+				out.merge(s.analyze(src, callee, memo))
+			}
+		case src.typeNames[f.Name]:
+		default:
+			out.Unresolved = true
+		}
+	case *ast.SelectorExpr:
+		if id, ok := f.X.(*ast.Ident); ok {
+			if _, isImport := fn.imports[id.Name]; isImport && !locals[id.Name] {
+				return out
+			}
+		}
+		for _, callee := range src.methods[f.Sel.Name] {
+			out.merge(s.analyze(src, callee, memo))
+		}
+		if src.ifaceMethods[f.Sel.Name] || src.funcFields[f.Sel.Name] {
+			out.Unresolved = true
+		}
+	case *ast.CallExpr:
+		out.Unresolved = true
+	}
+	return out
+}
+
+// unwrapCallee strips parentheses and generic instantiation from a callee.
+func unwrapCallee(e ast.Expr) ast.Expr {
+	for {
+		switch x := e.(type) {
+		case *ast.ParenExpr:
+			e = x.X
+		case *ast.IndexExpr:
+			e = x.X
+		case *ast.IndexListExpr:
+			e = x.X
+		default:
+			return e
+		}
+	}
+}
+
+// collectLocals returns the names a function declares for itself and the types it declares locally.
+// The names are its receiver, parameters, results, := and var declarations, and range variables.
+// A call to a local name is a call of a function value.
+func collectLocals(decl *ast.FuncDecl) (locals, types map[string]bool) {
+	locals, types = map[string]bool{}, map[string]bool{}
+	addFields := func(fl *ast.FieldList) {
+		if fl == nil {
+			return
+		}
+		for _, f := range fl.List {
+			for _, n := range f.Names {
+				locals[n.Name] = true
+			}
+		}
+	}
+	addFields(decl.Recv)
+	addFields(decl.Type.Params)
+	addFields(decl.Type.Results)
+	if decl.Body == nil {
+		return locals, types
+	}
+	ast.Inspect(decl.Body, func(n ast.Node) bool {
+		switch x := n.(type) {
+		case *ast.FuncType:
+			addFields(x.Params)
+			addFields(x.Results)
+		case *ast.AssignStmt:
+			if x.Tok == token.DEFINE {
+				for _, l := range x.Lhs {
+					if id, ok := l.(*ast.Ident); ok {
+						locals[id.Name] = true
+					}
+				}
+			}
+		case *ast.RangeStmt:
+			if x.Tok == token.DEFINE {
+				for _, e := range []ast.Expr{x.Key, x.Value} {
+					if id, ok := e.(*ast.Ident); ok {
+						locals[id.Name] = true
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			for _, id := range x.Names {
+				locals[id.Name] = true
+			}
+		case *ast.TypeSpec:
+			types[x.Name.Name] = true
+		}
+		return true
+	})
+	return locals, types
+}
+
+// spawnRef reports whether importPath.name may run this module's code in another process:
+// the lymbin kit, os.Executable, or a testkit function that may do so, or has a call the scan cannot resolve to source.
+func (s *spawnScanner) spawnRef(importPath, name string) bool {
+	if importPath == "os" {
+		return name == "Executable"
+	}
+	rel, ok := strings.CutPrefix(importPath, s.module+"/")
+	if !ok {
+		return false
+	}
+	if rel == "internal/testkit/lymbin" {
+		return true
+	}
+	if kit, ok := strings.CutPrefix(rel, "internal/testkit/"); ok && !strings.Contains(kit, "/") {
+		return s.kitSpawns(importPath, kit)[name]
+	}
+	return false
+}
+
+// readsOSArgsProgram reports whether x is os.Args[0], the running binary's own path.
+// A read of any other index or a slice of os.Args does not count.
+func readsOSArgsProgram(fn *funcInfo, x *ast.IndexExpr, locals map[string]bool) bool {
+	sel, ok := x.X.(*ast.SelectorExpr)
+	if !ok || sel.Sel.Name != "Args" {
+		return false
+	}
+	id, ok := sel.X.(*ast.Ident)
+	if !ok || fn.imports[id.Name] != "os" || locals[id.Name] {
+		return false
+	}
+	index, ok := x.Index.(*ast.BasicLit)
+	return ok && index.Kind == token.INT && index.Value == "0"
+}
+
+// runsGoCommand reports whether call is exec.Command or exec.CommandContext with the program "go".
+// Such a call builds and runs module code.
+func runsGoCommand(fn *funcInfo, call *ast.CallExpr, locals map[string]bool) bool {
+	sel, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return false
+	}
+	id, ok := sel.X.(*ast.Ident)
+	if !ok || fn.imports[id.Name] != "os/exec" || locals[id.Name] {
+		return false
+	}
+	programIndex := 0
+	switch sel.Sel.Name {
+	case "Command":
+	case "CommandContext":
+		programIndex = 1
+	default:
+		return false
+	}
+	if len(call.Args) <= programIndex {
+		return false
+	}
+	program, ok := call.Args[programIndex].(*ast.BasicLit)
+	if !ok || program.Kind != token.STRING {
+		return false
+	}
+	value, err := strconv.Unquote(program.Value)
+	return err == nil && value == "go"
+}
+
+// kitSpawns returns, keyed by function name, whether each function of the testkit at importPath is marked:
+// it may run this module's code in another process, or it calls something the scan cannot resolve to source.
+func (s *spawnScanner) kitSpawns(importPath, kit string) map[string]bool {
+	if funcs, ok := s.kits[importPath]; ok {
+		return funcs
+	}
+	funcs := map[string]bool{}
+	// A kit calling itself, or a cycle through kits, sees this partial map.
+	s.kits[importPath] = funcs
+	src, err := loadPkgSource(filepath.Join(s.kitRoot, kit), false)
+	if err != nil {
+		return funcs
+	}
+	memo := map[*funcInfo]*SpawnVerdict{}
+	for name, fns := range src.funcs {
+		for _, fn := range fns {
+			if v := s.analyze(src, fn, memo); v.OutOfProcess || v.Unresolved {
+				funcs[name] = true
+			}
+		}
+	}
+	return funcs
+}
