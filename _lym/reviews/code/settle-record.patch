+func (r *promptTurnStartReed) SendText(guid, text string, submit bool) error {
+	if err := r.skillReed.SendText(guid, text, submit); err != nil {
+		return err
+	}
+	if r.turnStarts && text == r.prompt {
+		return r.appendEvents("START\n")
+	}
+	return nil
+}
