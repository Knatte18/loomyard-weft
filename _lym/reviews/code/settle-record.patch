+// desktoplauncher_test.go covers the launcher files Add writes, Remove takes away and Shortnames lists.
+// Each test works in a temporary desktop.
+
+package desktoplauncher_test
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/desktoplauncher"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// desktopFiles returns the names of the files in dir, in name order.
+func desktopFiles(t *testing.T, dir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	names := []string{}
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	return names
+}
+
+func TestAddRemove_KeepTheAllHubsLauncherWhileAnyHubHasOne(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		form      desktoplauncher.Form
+		extension string
+	}{
+		{desktoplauncher.FormFreedesktop, ".desktop"},
+		{desktoplauncher.FormWindowsWSL, ".cmd"},
+		{desktoplauncher.FormWindows, ".cmd"},
+	}
+	for _, tt := range tests {
+		t.Run(string(tt.form), func(t *testing.T) {
+			t.Parallel()
+			desktop := desktoplauncher.Desktop{Dir: t.TempDir(), Form: tt.form}
+			unrelated := filepath.Join(desktop.Dir, "lym-hub-notes.txt")
+			if err := os.WriteFile(unrelated, nil, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			for _, shortname := range []string{"alpha", "beta"} {
+				if err := desktop.Add("/opt/lym", shortname); err != nil {
+					t.Fatalf("Add(%q) = %v", shortname, err)
+				}
+			}
+
+			wantBoth := []string{"lym-hub-alpha" + tt.extension, "lym-hub-beta" + tt.extension, "lym-hub-notes.txt", "lym-hubs" + tt.extension}
+			if got := desktopFiles(t, desktop.Dir); !slices.Equal(got, wantBoth) {
+				t.Errorf("desktop after two adds = %v; want %v", got, wantBoth)
+			}
+			if got, err := desktop.Shortnames(); err != nil || !slices.Equal(got, []string{"alpha", "beta"}) {
+				t.Errorf("Shortnames() = %v, %v; want [alpha beta]", got, err)
+			}
+
+			if err := desktop.Remove("alpha"); err != nil {
+				t.Fatalf("Remove(alpha) = %v", err)
+			}
+			wantBeta := []string{"lym-hub-beta" + tt.extension, "lym-hub-notes.txt", "lym-hubs" + tt.extension}
+			if got := desktopFiles(t, desktop.Dir); !slices.Equal(got, wantBeta) {
+				t.Errorf("desktop after removing alpha = %v; want %v", got, wantBeta)
+			}
+
+			for _, shortname := range []string{"beta", "beta"} {
+				if err := desktop.Remove(shortname); err != nil {
+					t.Fatalf("Remove(%q) = %v", shortname, err)
+				}
+			}
+			if got := desktopFiles(t, desktop.Dir); !slices.Equal(got, []string{"lym-hub-notes.txt"}) {
+				t.Errorf("desktop after removing the last hub = %v; want only the unrelated file", got)
+			}
+		})
+	}
+}
+
+func TestAdd_WritesLaunchersRunningMachineStart(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		desktop desktoplauncher.Desktop
+		lymPath string
+		// file is the hub launcher's file name, and want its content.
+		file string
+		want string
+		// allFile is the all-hubs launcher's file name, and wantAll its content.
+		allFile string
+		wantAll string
+		wantErr bool
+	}{
+		{
+			name:    "Freedesktop",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormFreedesktop},
+			lymPath: "/opt/lym dev/lym",
+			file:    "lym-hub-ly.desktop",
+			want: "[Desktop Entry]\nType=Application\nName=lym: start the hub ly\nComment=Runs lym machine start ly on this machine\n" +
+				`Exec=bash -lc "'/opt/lym dev/lym' machine start ly; echo; read -r -p 'Press Enter to close this window' _"` +
+				"\nTerminal=true\nIcon=utilities-terminal\n",
+			allFile: "lym-hubs.desktop",
+			wantAll: "[Desktop Entry]\nType=Application\nName=lym: start every hub\nComment=Runs lym machine start on this machine\n" +
+				`Exec=bash -lc "'/opt/lym dev/lym' machine start; echo; read -r -p 'Press Enter to close this window' _"` +
+				"\nTerminal=true\nIcon=utilities-terminal\n",
+		},
+		{
+			name:    "FreedesktopEscapesExecSpecials",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormFreedesktop},
+			lymPath: `/opt/100%$x\lym`,
+			file:    "lym-hub-ly.desktop",
+			want: "[Desktop Entry]\nType=Application\nName=lym: start the hub ly\nComment=Runs lym machine start ly on this machine\n" +
+				`Exec=bash -lc "'/opt/100%%\\$x\\\\lym' machine start ly; echo; read -r -p 'Press Enter to close this window' _"` +
+				"\nTerminal=true\nIcon=utilities-terminal\n",
+		},
+		{
+			name:    "WindowsWSL",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindowsWSL, Distro: "Ubuntu-24.04"},
+			lymPath: "/home/u/go/bin/lym",
+			file:    "lym-hub-ly.cmd",
+			want:    "@echo off\r\nrem lym: start the hub ly\r\nwsl.exe -d \"Ubuntu-24.04\" -- bash -lc \"'/home/u/go/bin/lym' machine start ly\"\r\npause\r\n",
+			allFile: "lym-hubs.cmd",
+			wantAll: "@echo off\r\nrem lym: start every hub\r\nwsl.exe -d \"Ubuntu-24.04\" -- bash -lc \"'/home/u/go/bin/lym' machine start\"\r\npause\r\n",
+		},
+		{
+			name:    "WindowsWSLDefaultDistroDoublesPercent",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindowsWSL},
+			lymPath: "/opt/50%/lym",
+			file:    "lym-hub-ly.cmd",
+			want:    "@echo off\r\nrem lym: start the hub ly\r\nwsl.exe -- bash -lc \"'/opt/50%%/lym' machine start ly\"\r\npause\r\n",
+		},
+		{
+			name:    "WindowsWSLRefusesADoubleQuote",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindowsWSL},
+			lymPath: `/opt/"x"/lym`,
+			wantErr: true,
+		},
+		{
+			name:    "WindowsWSLRefusesADollarSign",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindowsWSL},
+			lymPath: "/opt/$x/lym",
+			wantErr: true,
+		},
+		{
+			name:    "WindowsWSLRefusesABackquote",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindowsWSL},
+			lymPath: "/opt/`x`/lym",
+			wantErr: true,
+		},
+		{
+			name:    "WindowsWSLRefusesABackslash",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindowsWSL},
+			lymPath: `/opt/\x/lym`,
+			wantErr: true,
+		},
+		{
+			name:    "NativeWindows",
+			desktop: desktoplauncher.Desktop{Form: desktoplauncher.FormWindows},
+			lymPath: `C:\Program Files\lym\lym.exe`,
+			file:    "lym-hub-ly.cmd",
+			want:    "@echo off\r\nrem lym: start the hub ly\r\n\"C:\\Program Files\\lym\\lym.exe\" machine start ly\r\npause\r\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			desktop := tt.desktop
+			desktop.Dir = t.TempDir()
+
+			err := desktop.Add(tt.lymPath, "ly")
+
+			if tt.wantErr {
+				if err == nil {
+					t.Errorf("Add(%q) = nil; want an error", tt.lymPath)
+				}
+				if got := desktopFiles(t, desktop.Dir); len(got) > 0 {
+					t.Errorf("desktop after a refused add = %v; want it empty", got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Add(%q) = %v", tt.lymPath, err)
+			}
+			for file, want := range map[string]string{tt.file: tt.want, tt.allFile: tt.wantAll} {
+				if file == "" {
+					continue
+				}
+				got, err := os.ReadFile(filepath.Join(desktop.Dir, file))
+				if err != nil || string(got) != want {
+					t.Errorf("launcher %s = %q, %v; want %q", file, got, err, want)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/desktoplauncher/doc.go b/internal/desktoplauncher/doc.go
new file mode 100644
index 00000000..fbbe85e5
--- /dev/null
+++ b/internal/desktoplauncher/doc.go
@@ -0,0 +1,25 @@
+// Package desktoplauncher writes the desktop launchers that run `lym machine start`:
+// one per hub, which starts that hub, and one for every hub, which starts every live hub of this machine.
+// It alone names where the launchers live and what they hold;
+// they sit on the machine's desktop, outside every hub, and no tracked record names them.
+//
+// Locate finds this machine's desktop directory and the form its launchers take:
+//
+//   - On Linux, a freedesktop `.desktop` file in the desktop directory `user-dirs.dirs` names, else `$HOME/Desktop`.
+//     It runs the verb in a terminal through a login bash, and the terminal waits for Enter before it closes.
+//   - Under WSL, a `.cmd` file on the Windows desktop, which runs the verb in this distribution through `wsl.exe`.
+//   - On native Windows, a `.cmd` file on the Windows desktop that runs the verb directly.
+//
+// XDG_DESKTOP_DIR, when set, names the desktop directory on every platform,
+// so a test process points it at a directory of its own.
+// A desktop directory that does not exist, or a platform with no launcher form, is ErrNoDesktop:
+// a machine with no desktop gets no launcher.
+//
+// A hub's launcher is named by the hub's shortname, `lym-hub-<shortname>` with the form's extension,
+// and the all-hubs launcher is `lym-hubs`.
+// Add writes a hub's launcher and the all-hubs launcher.
+// Remove removes a hub's launcher, and the all-hubs launcher once no hub's launcher stands.
+// Shortnames lists the hubs whose launcher stands, so a caller removes those of hubs that are gone.
+// Add and Remove hold one lock per desktop, kept in the per-user state directory.
+// So concurrent processes never leave a hub launcher standing without the all-hubs one.
+package desktoplauncher
diff --git a/internal/desktoplauncher/locate.go b/internal/desktoplauncher/locate.go
new file mode 100644
index 00000000..b4a7e611
--- /dev/null
+++ b/internal/desktoplauncher/locate.go
@@ -0,0 +1,121 @@
+// locate.go finds this machine's desktop directory and the launcher form it takes.
+
+package desktoplauncher
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+// ErrNoDesktop reports that this machine has no desktop directory to hold launchers.
+var ErrNoDesktop = errors.New("desktoplauncher: no desktop directory on this machine")
+
+const (
+	// desktopEnv names the desktop directory on every platform when it is set.
+	desktopEnv = "XDG_DESKTOP_DIR"
+	// userDirsFileName is the freedesktop file in the user config directory that names the desktop directory.
+	userDirsFileName = "user-dirs.dirs"
+	// wslDistroEnv names the WSL distribution this process runs in; WSL sets it.
+	wslDistroEnv = "WSL_DISTRO_NAME"
+	// wslInteropPath exists on every WSL machine whose Windows interop is enabled.
+	wslInteropPath = "/proc/sys/fs/binfmt_misc/WSLInterop"
+)
+
+// probe carries the machine facts locate reads, so the choice is testable without the machine.
+type probe struct {
+	goos       string
+	getenv     func(string) string
+	fileExists func(string) bool
+	isDir      func(string) bool
+	// freedesktopDir returns the Linux desktop directory.
+	freedesktopDir func() (string, error)
+	// windowsDir returns the Windows desktop directory, as a path this process opens.
+	windowsDir func() (string, error)
+}
+
+// Locate returns this machine's desktop, or an error wrapping ErrNoDesktop that names why there is none.
+func Locate() (Desktop, error) {
+	return locate(probe{
+		goos:       runtime.GOOS,
+		getenv:     os.Getenv,
+		fileExists: func(path string) bool { _, err := os.Stat(path); return err == nil },
+		isDir: func(path string) bool {
+			info, err := os.Stat(path)
+			return err == nil && info.IsDir()
+		},
+		freedesktopDir: func() (string, error) { return freedesktopDesktopDir(os.UserConfigDir, os.UserHomeDir) },
+		windowsDir:     windowsDesktopDir,
+	})
+}
+
+func locate(p probe) (Desktop, error) {
+	desktop := Desktop{Form: FormFreedesktop}
+	resolveDir := p.freedesktopDir
+	switch {
+	case p.goos == "windows":
+		desktop.Form, resolveDir = FormWindows, p.windowsDir
+	case p.goos != "linux":
+		return Desktop{}, fmt.Errorf("%w: no launcher form for %s", ErrNoDesktop, p.goos)
+	case p.getenv(wslDistroEnv) != "" || p.fileExists(wslInteropPath):
+		desktop.Form, desktop.Distro, resolveDir = FormWindowsWSL, p.getenv(wslDistroEnv), p.windowsDir
+	}
+	dir := p.getenv(desktopEnv)
+	if dir == "" {
+		resolved, err := resolveDir()
+		if err != nil {
+			return Desktop{}, fmt.Errorf("%w: %v", ErrNoDesktop, err)
+		}
+		dir = resolved
+	}
+	if !p.isDir(dir) {
+		return Desktop{}, fmt.Errorf("%w: %s is not a directory", ErrNoDesktop, dir)
+	}
+	desktop.Dir = dir
+	return desktop, nil
+}
+
+// freedesktopDesktopDir returns the desktop directory that user-dirs.dirs in the directory userConfigDir returns names.
+// Without one it returns `$HOME/Desktop`, with the home directory userHomeDir returns.
+func freedesktopDesktopDir(userConfigDir, userHomeDir func() (string, error)) (string, error) {
+	home, err := userHomeDir()
+	if err != nil {
+		return "", err
+	}
+	if config, err := userConfigDir(); err == nil {
+		data, err := os.ReadFile(filepath.Join(config, userDirsFileName))
+		switch {
+		case err == nil:
+			if dir, found := parseUserDirs(data, home); found {
+				return dir, nil
+			}
+		case !errors.Is(err, fs.ErrNotExist):
+			return "", err
+		}
+	}
+	return filepath.Join(home, "Desktop"), nil
+}
+
+// parseUserDirs reads the desktop directory from the text of a user-dirs.dirs file, with "$HOME" read as home.
+// It reports false when the file names none or names one that is neither absolute nor under "$HOME".
+func parseUserDirs(data []byte, home string) (string, bool) {
+	for line := range strings.Lines(string(data)) {
+		value, found := strings.CutPrefix(strings.TrimSpace(line), desktopEnv+"=")
+		if !found {
+			continue
+		}
+		value = strings.Trim(value, `"`)
+		if rest, underHome := strings.CutPrefix(value, "$HOME"); underHome {
+			value = home + rest
+		}
+		if !filepath.IsAbs(value) {
+			return "", false
+		}
+		return filepath.Clean(value), true
+	}
+	return "", false
+}
