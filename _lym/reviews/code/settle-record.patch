@@ -0,0 +1,291 @@
+//go:build tier0 && !windows
+
+// buttonrow_test.go covers buttonrow.go's render of the status-bar button row into session options.
+// It is built where `sh` resolves only, and drives the render through the fake tmux with a stub button context.
+
+package reedengine
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shell"
+	"github.com/Knatte18/loomyard/internal/testkit/logcapture"
+)
+
+// rowFragment is the literal tmux format of one drawn button, written out independently of buttonRangeFormat.
+func rowFragment(index int, label string) string {
+	return fmt.Sprintf("#[range=user|lymbtn%d bg=colour236 fg=white] %s #[norange list=on default] ", index, label)
+}
+
+// buttonRowSpecSlot is the index of the spec JSON within a button row invocation.
+const buttonRowSpecSlot = 16
+
+// TestPinButtonRowLocked pins the four options one render sets, for each shape of button context.
+// It reads Warns through logcapture, whose output is process-global, so it does not call t.Parallel.
+func TestPinButtonRowLocked(t *testing.T) {
+	posix := shell.Posix()
+	shPath, err := exec.LookPath("sh")
+	if err != nil {
+		t.Fatalf("LookPath(sh) = %v, want sh on PATH", err)
+	}
+
+	tests := []struct {
+		name          string
+		shell         string
+		nilClosure    bool
+		closureErr    error
+		place         ButtonPlace
+		buttons       string
+		machine       string
+		beam          ButtonBeam
+		beamErr       error
+		wantBeamCalls int
+		wantPlain     string
+		wantAgent     string
+		wantEntries   []buttonSpecEntry
+		wantDir       string
+		wantWarns     []string
+	}{
+		{
+			name:       "NilClosureRendersFollowAlone",
+			nilClosure: true,
+			place:      ButtonPlacePrime,
+			buttons:    "buttons:\n  beam: [{label: A, run: a}]\n",
+		},
+		{
+			name:       "ClosureErrorRendersNothingAndWarns",
+			closureErr: errors.New("geometry unavailable"),
+			place:      ButtonPlacePrime,
+			buttons:    "buttons:\n  beam: [{label: A, run: a}]\n",
+			wantWarns:  []string{"geometry unavailable"},
+		},
+		{
+			name:      "UnresolvableShellRendersNothingAndWarns",
+			shell:     "no-such-shell-lym",
+			place:     ButtonPlacePrime,
+			buttons:   "buttons:\n  beam: [{label: A, run: a}]\n",
+			wantWarns: []string{"shell"},
+		},
+		{
+			name:          "BeamErrorForATaskRendersNothingAndWarns",
+			place:         ButtonPlaceTask,
+			buttons:       "buttons:\n  task: [{label: A, run: a}]\n",
+			beamErr:       errors.New("beam lookup failed"),
+			wantBeamCalls: 1,
+			wantWarns:     []string{"beam lookup failed"},
+		},
+		{
+			name:    "PrimeTakesReedFirstThenMachineAndNeverAsksForTheBeam",
+			place:   ButtonPlacePrime,
+			buttons: "buttons:\n  prime: []\n  beam: [{label: A, run: a}]\n",
+			machine: "buttons:\n  beam: [{label: M, run: m}]\n",
+			wantPlain: rowFragment(0, "A") +
+				rowFragment(1, "M"),
+			wantAgent: rowFragment(0, "A") +
+				rowFragment(1, "M"),
+			wantEntries: []buttonSpecEntry{
+				{Index: 0, Label: "A", Run: "a"},
+				{Index: 1, Label: "M", Run: "m"},
+			},
+			wantDir: "ANCHOR",
+		},
+		{
+			name:  "AgentsEntriesJoinOnlyTheAgentRowAndFlagStrand",
+			place: ButtonPlaceBeam,
+			buttons: "buttons:\n  beam:\n" +
+				"    - {label: S, run: 'echo {strand}', window: agents}\n" +
+				"    - {label: P, run: 'echo p', window: agents}\n" +
+				"    - {label: Q, run: q}\n",
+			wantPlain: rowFragment(2, "Q"),
+			wantAgent: rowFragment(0, "S") + rowFragment(1, "P") + rowFragment(2, "Q"),
+			wantEntries: []buttonSpecEntry{
+				{Index: 0, Label: "S", Run: "echo {strand}", Strand: true},
+				{Index: 1, Label: "P", Run: "echo p"},
+				{Index: 2, Label: "Q", Run: "q"},
+			},
+			wantDir: "ANCHOR",
+		},
+		{
+			name:        "InvalidEntryIsSkippedAndTheValidOneIsNumberedFromZero",
+			place:       ButtonPlaceBeam,
+			buttons:     "buttons:\n  beam: [{label: '', run: x}, {label: V, run: v}]\n",
+			wantPlain:   rowFragment(0, "V"),
+			wantAgent:   rowFragment(0, "V"),
+			wantEntries: []buttonSpecEntry{{Index: 0, Label: "V", Run: "v"}},
+			wantDir:     "ANCHOR",
+			wantWarns:   []string{"skipped an invalid button entry"},
+		},
+		{
+			name:          "TaskRunsInTheBeamAnchorAndQuotesItIntoBeamPlaceholders",
+			place:         ButtonPlaceTask,
+			buttons:       "buttons:\n  task: [{label: B, run: 'ls {beam}'}]\n",
+			beam:          ButtonBeam{Anchor: "/b eam", Name: "bn", PrimeAnchor: "/prime"},
+			wantBeamCalls: 1,
+			wantPlain:     rowFragment(0, "B"),
+			wantAgent:     rowFragment(0, "B"),
+			wantEntries:   []buttonSpecEntry{{Index: 0, Label: "B", Run: "ls " + posix.Quote("/b eam")}},
+			wantDir:       "/b eam",
+		},
+		{
+			name:          "TaskWithoutABeamAnchorLeavesOutBeamEntriesAndRunsInThePrime",
+			place:         ButtonPlaceTask,
+			buttons:       "buttons:\n  task: [{label: B, run: 'ls {beam}'}, {label: C, run: pwd}]\n",
+			beam:          ButtonBeam{Name: "bn", PrimeAnchor: "/prime"},
+			wantBeamCalls: 1,
+			wantPlain:     rowFragment(0, "C"),
+			wantAgent:     rowFragment(0, "C"),
+			wantEntries:   []buttonSpecEntry{{Index: 0, Label: "C", Run: "pwd"}},
+			wantDir:       "/prime",
+			wantWarns:     []string{"lym adopt", "bn"},
+		},
+		{
+			name:          "BeamPlaceholderInAPrimeEntryAsksForTheBeamOnce",
+			place:         ButtonPlacePrime,
+			buttons:       "buttons:\n  beam: [{label: B, run: 'ls {beam}'}, {label: C, confirm: 'on {beam}?', run: c}]\n",
+			beam:          ButtonBeam{Anchor: "/beam", Name: "bn", PrimeAnchor: "/prime"},
+			wantBeamCalls: 1,
+			wantPlain:     rowFragment(0, "B") + rowFragment(1, "C"),
+			wantAgent:     rowFragment(0, "B") + rowFragment(1, "C"),
+			wantEntries: []buttonSpecEntry{
+				{Index: 0, Label: "B", Run: "ls " + posix.Quote("/beam")},
+				{Index: 1, Label: "C", Run: "c", Confirm: "on /beam?"},
+			},
+			wantDir: "ANCHOR",
+		},
+		{
+			name:        "ConfirmDoublesHashFromAPlaceholderValue",
+			place:       ButtonPlaceBeam,
+			buttons:     "buttons:\n  beam: [{label: D, run: d, confirm: 'drop {slug}?'}]\n",
+			wantPlain:   rowFragment(0, "D"),
+			wantAgent:   rowFragment(0, "D"),
+			wantEntries: []buttonSpecEntry{{Index: 0, Label: "D", Run: "d", Confirm: "drop a##b?"}},
+			wantDir:     "ANCHOR",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			e := newTestEngine(t)
+			e.cfg.Shell = "sh"
+			if tt.shell != "" {
+				e.cfg.Shell = tt.shell
+			}
+			e.cfg.Buttons = buttonsNode(t, tt.buttons)
+			fake := installFakeTmux(t, e)
+			logs := logcapture.CaptureVerbose(t)
+
+			beamCalls := 0
+			if !tt.nilClosure {
+				var machine = buttonsNode(t, "buttons:\n")
+				if tt.machine != "" {
+					machine = buttonsNode(t, tt.machine)
+				}
+				e.geom.Buttons = func() (ButtonContext, error) {
+					if tt.closureErr != nil {
+						return ButtonContext{}, tt.closureErr
+					}
+					return ButtonContext{
+						Place:          tt.place,
+						Slug:           "a#b",
+						Worktree:       "/wt",
+						Session:        "sess",
+						MachineButtons: machine,
+						Beam: func() (ButtonBeam, error) {
+							beamCalls++
+							return tt.beam, tt.beamErr
+						},
+					}, nil
+				}
+			}
+
+			target := exactSessionWindowTarget(e.SessionName())
+			e.pinButtonRowLocked(target)
+
+			wantSpec := buttonSpec{}
+			wantSpecJSON, wantDirWord := "", ""
+			if len(tt.wantEntries) > 0 {
+				dir := tt.wantDir
+				if dir == "ANCHOR" {
+					dir = e.geom.AnchorPath
+				}
+				wantSpec = buttonSpec{Shell: shPath, Flag: posix.CommandFlag(), Dir: dir, Entries: tt.wantEntries}
+				wantSpecJSON = "decoded below"
+				wantDirWord = posix.Quote(dir)
+			}
+			want := wantButtonRowArgv(target, tt.wantPlain, tt.wantAgent, wantSpecJSON, wantDirWord)
+
+			calls := fake.ArgvFor("set-option")
+			if len(calls) != 1 {
+				t.Fatalf("pinButtonRowLocked issued %d set-option invocations, want one: %v", len(calls), calls)
+			}
+			got := slices.Clone(calls[0])
+			gotSpecJSON := got[buttonRowSpecSlot]
+			if len(tt.wantEntries) > 0 {
+				var gotSpec buttonSpec
+				if err := json.Unmarshal([]byte(gotSpecJSON), &gotSpec); err != nil {
+					t.Fatalf("spec option %q is not JSON: %v", gotSpecJSON, err)
+				}
+				if !slices.Equal(gotSpec.Entries, wantSpec.Entries) || gotSpec.Shell != wantSpec.Shell || gotSpec.Flag != wantSpec.Flag || gotSpec.Dir != wantSpec.Dir {
+					t.Errorf("spec = %+v, want %+v", gotSpec, wantSpec)
+				}
+				got[buttonRowSpecSlot] = "decoded below"
+			}
+			if !slices.Equal(got, want) {
+				t.Errorf("set-option invocation = %q, want %q", got, want)
+			}
+			if tt.wantBeamCalls != beamCalls {
+				t.Errorf("Beam called %d times, want %d", beamCalls, tt.wantBeamCalls)
+			}
+			for _, warn := range tt.wantWarns {
+				if !strings.Contains(logs.String(), warn) {
+					t.Errorf("log = %q, want a Warn containing %q", logs.String(), warn)
+				}
+			}
+			if len(tt.wantWarns) == 0 && logs.String() != "" {
+				t.Errorf("log = %q, want nothing logged", logs.String())
+			}
+		})
+	}
+
+	t.Run("ASecondRenderTakesTheChangedConfig", func(t *testing.T) {
+		e := newTestEngine(t)
+		e.cfg.Shell = "sh"
+		e.cfg.Buttons = buttonsNode(t, "buttons:\n  beam: [{label: A, run: a}]\n")
+		e.geom.Buttons = func() (ButtonContext, error) { return ButtonContext{Place: ButtonPlaceBeam}, nil }
+		fake := installFakeTmux(t, e)
+		target := exactSessionWindowTarget(e.SessionName())
+
+		e.pinButtonRowLocked(target)
+		e.cfg.Buttons = buttonsNode(t, "buttons:\n  beam: [{label: Z, run: z}]\n")
+		e.pinButtonRowLocked(target)
+
+		calls := fake.ArgvFor("set-option")
+		if len(calls) != 2 {
+			t.Fatalf("set-option invocations = %d, want 2: %v", len(calls), calls)
+		}
+		if calls[0][4] != rowFragment(0, "A") || calls[1][4] != rowFragment(0, "Z") {
+			t.Errorf("plain rows = %q then %q, want the old then the new button", calls[0][4], calls[1][4])
+		}
+	})
+
+	t.Run("AFailingInvocationWarnsAndDoesNotPanic", func(t *testing.T) {
+		e := newTestEngine(t)
+		e.cfg.Shell = "sh"
+		e.cfg.Buttons = buttonsNode(t, "buttons:\n  beam: [{label: A, run: a}]\n")
+		e.geom.Buttons = func() (ButtonContext, error) { return ButtonContext{Place: ButtonPlaceBeam}, nil }
+		fake := installFakeTmux(t, e)
+		fake.answer("set-option", "", errors.New("boom"))
+		logs := logcapture.CaptureVerbose(t)
+
+		e.pinButtonRowLocked(exactSessionWindowTarget(e.SessionName()))
+
+		if !strings.Contains(logs.String(), "failed to pin the button row") {
+			t.Errorf("log = %q, want a Warn for the failed invocation", logs.String())
+		}
+	})
+}
diff --git a/internal/reedengine/buttons.go b/internal/reedengine/buttons.go
new file mode 100644
index 00000000..9b1f8d63
--- /dev/null
+++ b/internal/reedengine/buttons.go
@@ -0,0 +1,146 @@
+// buttons.go decodes, validates and fills the status-bar button entries of reed.yaml's and desktop.yaml's buttons blocks.
+// The render and the click verb call these pure functions; none reads a file or runs a command.
+
+package reedengine
+
+import (
+	"strings"
+	"unicode"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/shell"
+	"gopkg.in/yaml.v3"
+)
+
+// ButtonPlace names the kind of session a button row is rendered for.
+type ButtonPlace string
+
+const (
+	// ButtonPlaceTask is a task pair's session.
+	ButtonPlaceTask ButtonPlace = "task"
+	// ButtonPlaceBeam is a beam pair's session.
+	ButtonPlaceBeam ButtonPlace = "beam"
+	// ButtonPlacePrime is the prime worktree's session.
+	ButtonPlacePrime ButtonPlace = "prime"
+)
+
+// buttonWindowAgents is the window value that limits a button to a strand pane's window and lets its run and confirm text name {strand}.
+const buttonWindowAgents = "agents"
+
+// buttonEntry is one decoded status-bar button.
+type buttonEntry struct {
+	// Label is the text drawn on the button.
+	Label string `yaml:"label"`
+	// Run is the command line the click runs, with its placeholders unfilled.
+	Run string `yaml:"run"`
+	// Confirm is the prompt asked before Run; empty asks nothing.
+	Confirm string `yaml:"confirm"`
+	// Window is empty for a button on every window, or buttonWindowAgents for a button on a strand pane's window alone.
+	Window string `yaml:"window"`
+	// Index is the entry's position within its group.
+	Index int `yaml:"-"`
+}
+
+// placeButtons returns the valid entries of the group place selects in groups, the buttons node of one config file, in config order.
+// The prime takes its own group when that is a non-empty list and the beam group otherwise.
+// A zero node or an absent group gives no entries and logs nothing;
+// a group that is not a list, an entry that does not decode and an entry buttonEntryProblem refuses are skipped with one Warn naming source, so a bad button costs only itself.
+func placeButtons(groups yaml.Node, place ButtonPlace, source string) []buttonEntry {
+	groupName := string(place)
+	if place == ButtonPlacePrime {
+		groupName = string(ButtonPlaceBeam)
+		if prime := groupNode(groups, string(ButtonPlacePrime)); prime != nil {
+			if prime.Kind != yaml.SequenceNode {
+				logger.Warn("reed: skipped a button group that is not a list", "source", source, "group", string(ButtonPlacePrime))
+			} else if len(prime.Content) > 0 {
+				groupName = string(ButtonPlacePrime)
+			}
+		}
+	}
+
+	group := groupNode(groups, groupName)
+	if group == nil {
+		return nil
+	}
+	if group.Kind != yaml.SequenceNode {
+		logger.Warn("reed: skipped a button group that is not a list", "source", source, "group", groupName)
+		return nil
+	}
+
+	var entries []buttonEntry
+	for index, node := range group.Content {
+		var entry buttonEntry
+		if err := node.Decode(&entry); err != nil {
+			logger.Warn("reed: skipped a button entry that does not decode", "source", source, "group", groupName, "index", index, "err", err)
+			continue
+		}
+		entry.Index = index
+		if problem := buttonEntryProblem(entry); problem != "" {
+			logger.Warn("reed: skipped an invalid button entry", "source", source, "group", groupName, "index", index, "problem", problem)
+			continue
+		}
+		entries = append(entries, entry)
+	}
+	return entries
+}
+
+// groupNode returns the value of key in the mapping node groups, or nil when groups is not a mapping or holds no such key.
+func groupNode(groups yaml.Node, key string) *yaml.Node {
+	if groups.Kind == yaml.DocumentNode && len(groups.Content) == 1 {
+		groups = *groups.Content[0]
+	}
+	if groups.Kind != yaml.MappingNode {
+		return nil
+	}
+	for i := 0; i+1 < len(groups.Content); i += 2 {
+		if groups.Content[i].Value == key {
+			return groups.Content[i+1]
+		}
+	}
+	return nil
+}
+
+// buttonEntryProblem returns the empty string for a valid entry, else one sentence naming its first problem.
+// The label and the confirm text are drawn inside a tmux format, so neither may hold a status sequence start, a strftime field or a control character.
+func buttonEntryProblem(entry buttonEntry) string {
+	if entry.Label == "" {
+		return "the label is empty"
+	}
+	if entry.Run == "" {
+		return "the run text is empty"
+	}
+	for _, field := range []struct{ name, text string }{{"label", entry.Label}, {"confirm", entry.Confirm}} {
+		if strings.ContainsAny(field.text, "#%") || strings.IndexFunc(field.text, unicode.IsControl) >= 0 {
+			return "the " + field.name + " holds a '#', a '%' or a control character"
+		}
+	}
+	if entry.Window != "" && entry.Window != buttonWindowAgents {
+		return "the window is neither empty nor " + buttonWindowAgents
+	}
+	if entry.Window != buttonWindowAgents && (strings.Contains(entry.Run, "{strand}") || strings.Contains(entry.Confirm, "{strand}")) {
+		return "{strand} needs window: " + buttonWindowAgents
+	}
+	return ""
+}
+
+// fillRunPlaceholders replaces each {name} whose name is a key of values with the value quoted as one word of sh's dialect.
+// Brace text naming no key of values stays literal.
+func fillRunPlaceholders(sh shell.Shell, run string, values map[string]string) string {
+	return placeholderReplacer(values, sh.Quote).Replace(run)
+}
+
+// fillConfirmPlaceholders replaces each {name} whose name is a key of values with the value, its '#' and '%' doubled so it cannot inject a status sequence or a strftime field into the confirm prompt.
+// Brace text naming no key of values stays literal.
+func fillConfirmPlaceholders(confirm string, values map[string]string) string {
+	doubled := strings.NewReplacer("#", "##", "%", "%%")
+	return placeholderReplacer(values, doubled.Replace).Replace(confirm)
+}
+
+// placeholderReplacer builds one single-pass replacer from {name} to transform(value), so a substituted value is never scanned for placeholders again.
+func placeholderReplacer(values map[string]string, transform func(string) string) *strings.Replacer {
+	oldNew := make([]string, 0, 2*len(values))
+	for name, value := range values {
+		oldNew = append(oldNew, "{"+name+"}", transform(value))
+	}
+	return strings.NewReplacer(oldNew...)
+}
diff --git a/internal/reedengine/buttons_test.go b/internal/reedengine/buttons_test.go
new file mode 100644
index 00000000..478a275e
--- /dev/null
+++ b/internal/reedengine/buttons_test.go
@@ -0,0 +1,132 @@
+//go:build tier0
+
+// buttons_test.go pins the decoding and validation of button entries and the placeholder filling of their run and confirm text.
+
+package reedengine
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shell"
+	"github.com/Knatte18/loomyard/internal/testkit/logcapture"
+	"gopkg.in/yaml.v3"
+)
+
+// buttonsNode decodes doc, a YAML document holding a buttons key, into the buttons node.
+func buttonsNode(t *testing.T, doc string) yaml.Node {
+	t.Helper()
+	var holder struct {
+		Buttons yaml.Node `yaml:"buttons"`
+	}
+	if err := yaml.Unmarshal([]byte(doc), &holder); err != nil {
+		t.Fatalf("unmarshal %q: %v", doc, err)
+	}
+	return holder.Buttons
+}
+
+// TestPlaceButtons pins which entries each place takes from a buttons node and which invalid shapes are skipped with a Warn.
+// It captures the process-global logger output, so it does not run in parallel.
+func TestPlaceButtons(t *testing.T) {
+	const source = "reed.yaml (test)"
+	templateButtons := buttonsNode(t, ConfigTemplate())
+
+	tests := []struct {
+		name       string
+		buttons    yaml.Node
+		place      ButtonPlace
+		wantLabels []string
+		// wantWarn holds substrings of the captured log; empty means nothing is logged.
+		wantWarn []string
+	}{
+		{name: "TemplateTaskGroupComesBackWhole", buttons: templateButtons, place: ButtonPlaceTask, wantLabels: []string{"HALT", "CANCEL", "code", "term", "agent"}},
+		{name: "EmptyPrimeTakesBeam", buttons: buttonsNode(t, "buttons: {beam: [{label: b, run: r}], prime: []}"), place: ButtonPlacePrime, wantLabels: []string{"b"}},
+		{name: "NonEmptyPrimeTakesOnlyPrime", buttons: buttonsNode(t, "buttons: {beam: [{label: b, run: r}], prime: [{label: p, run: r}]}"), place: ButtonPlacePrime, wantLabels: []string{"p"}},
+		{name: "PrimeAsMappingFallsBackToBeam", buttons: buttonsNode(t, "buttons: {beam: [{label: b, run: r}], prime: {label: p}}"), place: ButtonPlacePrime, wantLabels: []string{"b"}, wantWarn: []string{source, "prime"}},
+		{name: "ZeroNodeGivesNone", buttons: yaml.Node{}, place: ButtonPlaceTask},
+		{name: "AbsentGroupGivesNone", buttons: buttonsNode(t, "buttons: {beam: [{label: b, run: r}]}"), place: ButtonPlaceTask},
