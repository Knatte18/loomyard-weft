+	t.Run("AWaitErrorStopsTheStrandAndMarksItDead", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name         string
+			stopErr      error
+			wantErr      bool
+			wantStatuses []string
+			wantCalls    int
