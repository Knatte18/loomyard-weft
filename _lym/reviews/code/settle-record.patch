@@ -0,0 +1,309 @@
+// reachreport.go declares the report the reach report step writes into the worktree's gate directory.
+// It renders the note the step prints from that report.
+
+package gatecli
+
+import (
+	"fmt"
+	"maps"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"golang.org/x/mod/modfile"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/verifytree"
+)
+
+// ReachReportFileName is the reach report's file name in the worktree's gate directory.
+const ReachReportFileName = "reach.json"
+
+// maxReachTestsPerFunction caps the tests a changed function's line keeps; the rest are counted in MoreTests.
+const maxReachTestsPerFunction = 5
+
+// reachNoteLineCap caps the lines of the note the step prints; a longer note ends with a line naming the report.
+const reachNoteLineCap = 40
+
+// ReachReport is what one reach report step of `lym gate test` found for the worktree's diff.
+type ReachReport struct {
+	// Written is when the step wrote the report.
+	Written time.Time `json:"written"`
+	// GateKey is the gate.yaml key whose call wrote the report.
+	GateKey string `json:"gate_key"`
+	// Note says why the step judged nothing, such as a red gate or no coverage map; empty when it judged.
+	Note string `json:"note,omitempty"`
+	// RedGate is set when a tier of the call was red, so the step judged nothing.
+	RedGate bool `json:"red_gate,omitempty"`
+	// Prime is set for a report written in the hub's prime, whose base is HEAD and which never matches a review's HEAD.
+	Prime bool `json:"prime,omitempty"`
+	// Base is the commit the step diffed from: the merge base with the parent branch, or HEAD in the prime.
+	Base string `json:"base,omitempty"`
+	// ModuleDir is the worktree-relative slash path of the Go module whose packages the report names.
+	ModuleDir string `json:"module_dir,omitempty"`
+	// Errors are the failures the step met, one line each; none changes the gate's result.
+	Errors []string `json:"errors,omitempty"`
+	// Maps are the coverage maps the answer read, those of the packages it names.
+	Maps []ReachMap `json:"maps,omitempty"`
+	// Unrefreshed holds one line per package left unrefreshed, with its reason and its way forward.
+	Unrefreshed []string `json:"unrefreshed,omitempty"`
+	// Functions holds the changed functions, sorted by package, file and name.
+	Functions []ReachFunction `json:"functions,omitempty"`
+	// FileHashes maps each package the answer names, by module-relative path, to the ContentHash of each Go file, by name.
+	// The Go files are those of the package of a changed function and of each package whose tests the report names.
+	FileHashes map[string]map[string]string `json:"file_hashes,omitempty"`
+}
+
+// ReachMap is one coverage map a reach report read.
+type ReachMap struct {
+	// Package is the module-relative slash path of the map's package.
+	Package string `json:"package"`
+	// Commit and BuiltAt are the commit the map was built from and when.
+	Commit  string    `json:"commit"`
+	BuiltAt time.Time `json:"built_at"`
+	// Worktree is set for a map read from the worktree's own maps, and clear for one of the hub's shared maps.
+	Worktree bool `json:"worktree,omitempty"`
+}
+
+// ReachFunction is one changed function with the tests that reach it.
+type ReachFunction struct {
+	// Package is the module-relative slash path of the function's package, and File the worktree-relative path of its file.
+	Package string `json:"package"`
+	File    string `json:"file"`
+	// Func is the function's name, `Type.Method` for a method.
+	Func string `json:"func"`
+	// Hash is the ContentHash of the function's declaration text in the worktree.
+	Hash string `json:"hash"`
+	// New is set when the merge base holds no function it matches.
+	New bool `json:"new,omitempty"`
+	// Tests are the tests that reach the function, its own package's first, fewest reached functions first, at most five.
+	Tests []ReachTest `json:"tests,omitempty"`
+	// MoreTests counts the reaching tests past the five kept.
+	MoreTests int `json:"more_tests,omitempty"`
+	// Caveats say why a function no test reaches may still be run by a test the maps cannot see.
+	Caveats []string `json:"caveats,omitempty"`
+}
+
+// ReachTest is one test that reaches a function.
+type ReachTest struct {
+	// Package is the module-relative slash path of the test's package, and Test the test's name.
+	Package string `json:"package"`
+	Test    string `json:"test"`
+}
+
+// reachReportPath returns the path of the reach report in the gate directory of the worktree at location.
+func reachReportPath(location *lymcwd.Location) string {
+	return filepath.Join(gateslot.WaitDir(location.AnchorPath()), ReachReportFileName)
+}
+
+// ReadReachReport reads the reach report of the worktree at location, and reports whether one exists.
+// A key the record does not declare is ignored, never refused.
+func ReadReachReport(location *lymcwd.Location) (ReachReport, bool, error) {
+	reportPath := reachReportPath(location)
+	return state.ReadJSON[ReachReport](reportPath, lock.TrackedFileLockPath(reportPath, ".lock"))
+}
+
+// ReachReportMatches reports whether report still holds for the tree of the commit rev of the worktree at location.
+// A report that judged nothing, one marked red_gate or prime, and a worktree with no parent branch never match.
+// Otherwise it holds when the functions rev changes since the current merge base are those the report records.
+// Their hashes must match too.
+// The Go files of each package the report names must also hash at rev as the report records.
+func ReachReportMatches(location *lymcwd.Location, report ReachReport, rev string) (bool, error) {
+	if report.Note != "" || report.RedGate || report.Prime {
+		return false, nil
+	}
+	base, found, err := parentMergeBase(location)
+	if err != nil || !found {
+		return false, err
+	}
+	fabric, err := fabricengine.Open(location)
+	if err != nil {
+		return false, err
+	}
+	changed, err := fabric.ChangedPathsBothSides(base, rev)
+	if err != nil {
+		return false, err
+	}
+	tree := commitTree{fabric: fabric, rev: rev}
+	goMod, found, err := tree.file(path.Join(report.ModuleDir, "go.mod"))
+	if err != nil || !found {
+		return false, err
+	}
+	module := goModule{rel: report.ModuleDir, path: modfile.ModulePath(goMod)}
+	if module.path == "" {
+		return false, nil
+	}
+	funcs, err := changedFuncsAt(tree, fabric, base, module, changed)
+	if err != nil {
+		return false, err
+	}
+	current := make([]string, len(funcs))
+	for i, fn := range funcs {
+		pkg := module.relativePackage(fn.Key.Package)
+		current[i] = reachFunctionIdentity(pkg, path.Join(packageDirOf(module.rel, pkg), fn.Key.File), fn.Key.Func, fn.Hash, fn.New)
+	}
+	recorded := make([]string, len(report.Functions))
+	for i, fn := range report.Functions {
+		recorded[i] = reachFunctionIdentity(fn.Package, fn.File, fn.Func, fn.Hash, fn.New)
+	}
+	slices.Sort(current)
+	slices.Sort(recorded)
+	if !slices.Equal(current, recorded) {
+		return false, nil
+	}
+	for pkg, hashes := range report.FileHashes {
+		atRev, err := goFileHashes(tree, packageDirOf(report.ModuleDir, pkg))
+		if err != nil {
+			return false, err
+		}
+		if !maps.Equal(atRev, hashes) {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+// ReachPendingOf returns the source of the pending reach report of the worktree at location, asked for a gate key.
+// The report answers its note and its unreached functions, each by file and name with its hash.
+// It does so when the call of the asked key wrote it and it still matches the worktree's HEAD.
+// A report of another key answers false.
+// So does one that judged nothing, one with no unreached function and one that no longer matches HEAD.
+// A report that cannot be read or matched answers false with a Warn naming the cause and no error.
+// The note is advisory and never stops a gate.
+func ReachPendingOf(location *lymcwd.Location) func(gateKey string) (verifytree.ReachPending, bool, error) {
+	return func(gateKey string) (verifytree.ReachPending, bool, error) {
+		skip := func(step string, cause error) (verifytree.ReachPending, bool, error) {
+			logger.Warn("gatecli: the reach turn is skipped", "step", step, "path", reachReportPath(location), "cause", cause)
+			return verifytree.ReachPending{}, false, nil
+		}
+		report, found, err := ReadReachReport(location)
+		if err != nil {
+			return skip("read the reach report", err)
+		}
+		if !found || report.GateKey != gateKey || report.Note != "" || report.RedGate || report.Prime {
+			return verifytree.ReachPending{}, false, nil
+		}
+		fabric, err := fabricengine.Open(location)
+		if err != nil {
+			return skip("open fabric", err)
+		}
+		head, err := fabric.HeadSHA()
+		if err != nil {
+			return skip("read HEAD", err)
+		}
+		matches, err := ReachReportMatches(location, report, head)
+		if err != nil {
+			return skip("match the reach report against HEAD", err)
+		}
+		if !matches {
+			return verifytree.ReachPending{}, false, nil
+		}
+		unreached := map[string]string{}
+		for _, fn := range report.Functions {
+			if fn.unreached() {
+				unreached[fn.File+"#"+fn.Func] = fn.Hash
+			}
+		}
+		if len(unreached) == 0 {
+			return verifytree.ReachPending{}, false, nil
+		}
+		note := strings.Join(report.NoteLines(reachReportPath(location)), "\n")
+		return verifytree.ReachPending{Note: note, Functions: unreached}, true, nil
+	}
+}
+
+// reachFunctionIdentity returns the text that tells one changed function and its hash from every other.
+func reachFunctionIdentity(pkg, file, name, hash string, isNew bool) string {
+	return fmt.Sprintf("%s|%s|%s|%s|%t", pkg, file, name, hash, isNew)
+}
+
+// NoteLines renders the note the reach step prints, at most reachNoteLineCap lines, from a report written at path.
+// A report that judged nothing renders its note alone.
+// Otherwise the note lists each changed function with its tests and the commit and age of each map read.
+// It lists the changed functions no test reaches with their caveats, the unrefreshed packages and the errors.
+// A note over the cap is cut and ends with a line naming path.
+func (r ReachReport) NoteLines(path string) []string {
+	if r.Note != "" {
+		return []string{fmt.Sprintf("gate test: reach report: %s; written to %s", r.Note, path)}
+	}
+	var lines []string
+	var unreached []ReachFunction
+	for _, fn := range r.Functions {
+		if fn.unreached() {
+			unreached = append(unreached, fn)
+			continue
+		}
+		lines = append(lines, "reach: "+fn.label()+": "+fn.testList())
+	}
+	for _, m := range r.Maps {
+		lines = append(lines, fmt.Sprintf("reach: map of %s from commit %s, %s old%s",
+			m.Package, m.Commit, r.Written.Sub(m.BuiltAt).Round(time.Minute), worktreeMark(m.Worktree)))
+	}
+	for _, fn := range unreached {
+		lines = append(lines, "reach: no mapped test reaches "+fn.label())
+		for _, caveat := range fn.Caveats {
+			lines = append(lines, "reach:   "+caveat)
+		}
+	}
+	for _, line := range r.Unrefreshed {
+		lines = append(lines, "reach: "+line)
+	}
+	for _, line := range r.Errors {
+		lines = append(lines, "reach: error: "+line)
+	}
+	if len(lines) == 0 {
+		lines = []string{"reach: the diff changes no function of the module"}
+	}
+	if len(lines) > reachNoteLineCap {
+		lines = append(lines[:reachNoteLineCap-1], "reach: note cut; the rest is in "+path)
+	}
+	for i := range lines {
+		lines[i] = "gate test: " + lines[i]
+	}
+	return lines
+}
+
+// worktreeMark names a map read from the worktree's own maps.
+func worktreeMark(worktree bool) string {
+	if worktree {
+		return " (the worktree's own)"
+	}
+	return ""
+}
+
+// unreached reports whether no mapped test reaches the function.
+func (f ReachFunction) unreached() bool {
+	return len(f.Tests) == 0 && f.MoreTests == 0
+}
+
+// label names the function by its package and name, and the new ones as such.
+func (f ReachFunction) label() string {
+	label := f.Package + "." + f.Func
+	if f.New {
+		label += " (new)"
+	}
+	return label
+}
+
+// testList renders the function's tests, own package first as the report orders them, and the count of the rest.
+func (f ReachFunction) testList() string {
+	names := make([]string, len(f.Tests))
+	for i, test := range f.Tests {
+		names[i] = test.Test
+		if test.Package != f.Package {
+			names[i] = test.Package + "." + test.Test
+		}
+	}
+	list := strings.Join(names, ", ")
+	if f.MoreTests > 0 {
+		list += fmt.Sprintf(", and %d more", f.MoreTests)
+	}
+	return list
+}
diff --git a/internal/gatecli/reachreport_test.go b/internal/gatecli/reachreport_test.go
new file mode 100644
index 00000000..e63d469a
--- /dev/null
+++ b/internal/gatecli/reachreport_test.go
@@ -0,0 +1,103 @@
+// reachreport_test.go covers the note the reach report step prints from its report.
+
+package gatecli
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestReachReport_NoteLines(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const path = "/gate/reach.json"
+	written := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	var manyFunctions []ReachFunction
+	var manyLines []string
+	for i := range reachNoteLineCap + 5 {
+		name := fmt.Sprintf("F%02d", i)
+		manyFunctions = append(manyFunctions, ReachFunction{Package: "p", Func: name, Tests: []ReachTest{{Package: "p", Test: "TestP"}}})
+		if i < reachNoteLineCap-1 {
+			manyLines = append(manyLines, "gate test: reach: p."+name+": TestP")
+		}
+	}
+	manyLines = append(manyLines, "gate test: reach: note cut; the rest is in "+path)
+
+	tests := []struct {
+		name   string
+		report ReachReport
+		want   []string
+	}{
+		{
+			name: "TestsOfTheOwnPackageThenOthersWithTheCountOfTheRestAndEachMapsCommitAndAge",
+			report: ReachReport{
+				Written: written,
+				Functions: []ReachFunction{{
+					Package: "a", Func: "Run",
+					Tests:     []ReachTest{{Package: "a", Test: "TestOne"}, {Package: "a", Test: "TestTwo"}, {Package: "b", Test: "TestUses"}},
+					MoreTests: 2,
+				}},
+				Maps: []ReachMap{
+					{Package: "a", Commit: "c0ffee", BuiltAt: written.Add(-2 * time.Hour)},
+					{Package: "b", Commit: "beef", BuiltAt: written.Add(-30 * time.Minute), Worktree: true},
+				},
+			},
+			want: []string{
+				"gate test: reach: a.Run: TestOne, TestTwo, b.TestUses, and 2 more",
+				"gate test: reach: map of a from commit c0ffee, 2h0m0s old",
+				"gate test: reach: map of b from commit beef, 30m0s old (the worktree's own)",
+			},
+		},
+		{
+			name: "AnUnreachedFunctionWithItsCaveatsAndAnUnrefreshedPackage",
+			report: ReachReport{
+				Written: written,
+				Functions: []ReachFunction{
+					{Package: "a", Func: "Lone", New: true, Caveats: []string{"a tier2 test may run it unseen", "the tests of b may reach it"}},
+				},
+				Unrefreshed: []string{"a: not refreshed, past reach_budget_min"},
+				Errors:      []string{"scan the tests of a: gone"},
+			},
+			want: []string{
+				"gate test: reach: no mapped test reaches a.Lone (new)",
+				"gate test: reach:   a tier2 test may run it unseen",
+				"gate test: reach:   the tests of b may reach it",
+				"gate test: reach: a: not refreshed, past reach_budget_min",
+				"gate test: reach: error: scan the tests of a: gone",
+			},
+		},
+		{
+			name:   "AReportThatJudgedNothingRendersItsNoteAlone",
+			report: ReachReport{Note: noteNoParent, Functions: []ReachFunction{{Package: "a", Func: "Run"}}, Unrefreshed: []string{"a: not refreshed"}},
+			want:   []string{"gate test: reach report: " + noteNoParent + "; written to " + path},
+		},
+		{
+			name:   "ADiffChangingNoFunction",
+			report: ReachReport{},
+			want:   []string{"gate test: reach: the diff changes no function of the module"},
+		},
+		{
+			name:   "ANoteOverTheCapEndsNamingTheReport",
+			report: ReachReport{Functions: manyFunctions},
+			want:   manyLines,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got := tt.report.NoteLines(path)
+			if diff := cmp.Diff(tt.want, got); diff != "" {
+				t.Errorf("NoteLines(%q) mismatch (-want +got):\n%s", path, diff)
+			}
+			if len(got) > reachNoteLineCap {
+				t.Errorf("NoteLines(%q) holds %d lines; want at most %d", path, len(got), reachNoteLineCap)
+			}
+		})
+	}
+}
diff --git a/internal/gatecli/reachverb.go b/internal/gatecli/reachverb.go
new file mode 100644
index 00000000..f31cb2ba
--- /dev/null
+++ b/internal/gatecli/reachverb.go
@@ -0,0 +1,291 @@
+// reachverb.go implements `lym gate reach`, the read verb over the per-test coverage maps.
+// Its function form prints the reach note of one function.
+// Its test form lists the landings of a branch whose changed functions a test reaches.
+
+package gatecli
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"maps"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/output"
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testreach"
+)
+
+// reachWalkCommitCap is the most first-parent commits `lym gate reach --test` walks from its --since commit.
+const reachWalkCommitCap = 200
+
+// reachShortSHALength is the number of leading SHA characters the verb prints for a commit.
+const reachShortSHALength = 7
+
+// The two forms of the verb, as its refusals name them.
+const (
+	reachFunctionForm = "lym gate reach <file>#<Func>"
+	reachTestForm     = "lym gate reach --test <package>.<Test> --since <rev>"
+)
+
+// reachRequest is one `lym gate reach` invocation after flag parsing.
+type reachRequest struct {
+	// function is the `<file>#<Func>` argument of the function form, empty for the test form.
+	function string
+	// test, since and branch are the values of --test, --since and --branch.
+	test, since, branch string
+	// limit is the most commits the test form walks from since.
+	limit int
+}
+
+// reachCmd builds `lym gate reach`.
+func reachCmd() *cobra.Command {
+	var test, since, branch string
+	cmd := &cobra.Command{
+		Use:         "reach [<function>]",
+		Short:       "list the tests that reach one function, or the landings on a branch that a test reaches, read from the coverage maps",
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceOperator},
+		Long: `reach reads the coverage maps and changes nothing: it builds nothing, takes no gate slot and writes no file, the index included.
+reach <file>#<Func> prints the reach note of one function: the worktree-relative file and the function's name, Type.Method for a method.
+The note lists the tests that reach it, its own package's first and at most five, the caveats of a function no test reaches, and the commit and age of each map read.
+The maps are the hub's shared maps and, outside the prime, the worktree's own.
+A function the maps do not hold prints a line saying so, with the commit of its package's map or that no map holds the package.
+reach --test <package>.<Test> --since <rev> lists the landings a test reaches: <package> is the module-relative package path, split from the test at the last dot.
+It walks the first-parent commits after <rev> of the parent branch, of --branch when given, or of the current branch in a worktree with no parent branch.
+It lists each commit that changes a function the test reaches, naming those functions, and says how many commits it checked and which map holds the test.
+A test no map holds walks nothing: the output says so and names the commits of the maps read.
+A range over the commit cap is refused, and so is a <rev> that is not on the branch's first-parent history.
+The maps may be days old, which the output says; a function renamed or removed since its landing matches nothing.
+
+Examples:
+
+  lym gate reach internal/foo/foo.go#Bar
+  lym gate reach --test internal/foo.TestBar --since 3f2a9c1`,
+		Args: cobra.MaximumNArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			request := reachRequest{test: test, since: since, branch: branch, limit: reachWalkCommitCap}
+			if len(args) == 1 {
+				request.function = args[0]
+			}
+			clihelp.SetExit(cmd.Context(), runReach(cmd.Context(), cmd.OutOrStdout(), request))
+			return nil
+		},
+	}
+	cmd.Flags().StringVar(&test, "test", "", "the test whose landings to list, as <package>.<Test> with the module-relative package path")
+	cmd.Flags().StringVar(&since, "since", "", "with --test, the commit after which to walk, such as the last commit known green")
+	cmd.Flags().StringVar(&branch, "branch", "", "with --test, the branch to walk instead of the parent branch")
+	return cmd
+}
+
+// formRefusal returns the refusal for a request whose flags and argument fit no form, or "" when they fit one.
+func (r reachRequest) formRefusal() string {
+	hasFunction, hasTest := r.function != "", r.test != ""
+	bothForms := fmt.Sprintf("run `%s` or `%s`", reachFunctionForm, reachTestForm)
+	switch {
+	case hasFunction == hasTest:
+		return "gate reach: name exactly one form; way forward: " + bothForms
+	case !hasTest && (r.since != "" || r.branch != ""):
+		return "gate reach: --since and --branch go with --test; way forward: " + bothForms
+	case hasTest && r.since == "":
+		return fmt.Sprintf("gate reach: --test needs --since; way forward: pass --since with the last commit you know was green, as in `%s`", reachTestForm)
+	case hasTest:
+		if _, _, ok := splitReachTest(r.test); !ok {
+			return fmt.Sprintf("gate reach: --test %q is not <package>.<Test>; way forward: name the module-relative package path, a dot and the test, as in `%s`", r.test, reachTestForm)
+		}
+	default:
+		if file, name, ok := strings.Cut(r.function, "#"); !ok || file == "" || name == "" {
+			return fmt.Sprintf("gate reach: %q is not <file>#<Func>; way forward: name the worktree-relative file, a hash sign and the function, as in `%s`", r.function, reachFunctionForm)
+		}
+	}
+	return ""
+}
+
+// splitReachTest splits a `<package>.<Test>` value at its last dot, and reports whether both parts are there.
+func splitReachTest(test string) (pkg, name string, ok bool) {
+	i := strings.LastIndex(test, ".")
+	if i <= 0 || i == len(test)-1 {
+		return "", "", false
+	}
+	return test[:i], test[i+1:], true
+}
+
+// runReach answers the request from the coverage maps of the hub that contains the seam cwd.
+// It returns the verb's exit code: 0 for an answer, a note naming why it read nothing included, and 1 for a refusal.
+func runReach(ctx context.Context, out io.Writer, request reachRequest) int {
+	if refusal := request.formRefusal(); refusal != "" {
+		return output.Err(out, refusal)
+	}
+	cwd, err := lymcwd.CwdFrom(ctx)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: cannot read the working directory: %v; way forward: re-run the same command", err))
+	}
+	location, inHub, err := resolveHub(cwd)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: %v; way forward: re-run the same command", err))
+	}
+	if !inHub {
+		return output.Err(out, fmt.Sprintf("gate reach: %s is in no hub, and the coverage maps live in a hub; way forward: run lym gate reach from a worktree of the hub", cwd))
+	}
+	cfg, err := gateslot.LoadConfig(fabricengine.ConfigDirs(location))
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: cannot read the hub's gate config: %v; way forward: take the step it names, then re-run the same command", err))
+	}
+	cfg = cfg.WithDefaultDir(location.AnchorRel)
+	if cfg.Scoper != "go" {
+		return output.Ok(out, map[string]any{"lines": []string{"gate reach: " + fmt.Sprintf(noteScoper, cfg.Scoper)}})
+	}
+	module, err := redundancyModule(cfg, location.WorktreePath())
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: %v; way forward: declare tier0 or tier1 with its dir at the Go module's root with lym config gate from the prime, then re-run the same command", err))
+	}
+	fabric, err := fabricengine.Open(location)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: %v; way forward: re-run the same command", err))
+	}
+	prime, err := hubgeom.IsPrime(location)
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: %v; way forward: re-run the same command", err))
+	}
+	step := reachStep{location: location, root: location.WorktreePath()}
+	reader, err := testreach.Open(reachModuleOf(module), testcover.Dir(fabricengine.BoltDir(location.HubPath)), step.worktreeMapsDir(prime))
+	if err != nil {
+		return output.Err(out, fmt.Sprintf("gate reach: %v; way forward: re-run the same command", err))
+	}
+	if request.test != "" {
+		return runReachTest(out, request, location, fabric, module, reader)
+	}
+	return runReachFunction(out, request.function, step, module, reader)
+}
+
+// runReachFunction prints the reach note of the function `<file>#<Func>`.
+// The note is built as the reach step builds a changed function's line.
+func runReachFunction(out io.Writer, function string, step reachStep, module goModule, reader *testreach.Reader) int {
+	file, name, _ := strings.Cut(function, "#")
+	file = path.Clean(filepath.ToSlash(file))
+	dir := path.Dir(file)
+	if !isModulePackage(module.rel, dir) {
+		line := fmt.Sprintf("gate reach: %s is in no package of the module at %s, so no coverage map holds it", file, module.rel)
+		return output.Ok(out, map[string]any{"function": function, "lines": []string{line}})
+	}
+	pkg := modulePackageOf(module.rel, dir)
+	key := testcover.FuncKey{Package: module.importPath(pkg), File: path.Base(file), Func: name}
+	report := ReachReport{Written: time.Now()}
+	step.describe(&report, module, reader, []testreach.ChangedFunc{{Key: key}})
+	lines := report.NoteLines("")
+	if !slices.ContainsFunc(reader.Maps(), func(source testreach.MapSource) bool { return source.Package == pkg }) {
+		lines = append(lines, fmt.Sprintf("gate reach: no coverage map holds the package %s; way forward: build the maps with `lym gate test --map` from the prime", pkg))
+	}
+	return output.Ok(out, map[string]any{"function": function, "lines": lines})
+}
+
+// runReachTest lists the first-parent commits after request.since whose changed functions the named test reaches.
+func runReachTest(out io.Writer, request reachRequest, location *lymcwd.Location, fabric *fabricengine.Fabric, module goModule, reader *testreach.Reader) int {
+	pkg, name, _ := splitReachTest(request.test)
+	pkg = path.Clean(filepath.ToSlash(pkg))
+	if _, _, held := reader.FuncsReachedBy(pkg, name, nil); !held {
+		return output.Ok(out, map[string]any{"test": request.test, "lines": []string{noMapHoldsTestLine(request.test, reader)}})
+	}
+	branch, refusal := reachWalkBranch(location, fabric, request.branch)
+	if refusal != "" {
+		return output.Err(out, refusal)
+	}
+	commits, met, err := fabric.FirstParentCommits(branch, request.since, request.limit)
+	switch {
+	case errors.Is(err, fabricengine.ErrBranchUnresolved):
+		return output.Err(out, fmt.Sprintf("gate reach: %q names no branch; way forward: pass a branch of the repository, or drop --branch to walk the parent branch", branch))
+	case errors.Is(err, fabricengine.ErrCommitUnresolved):
+		return output.Err(out, fmt.Sprintf("gate reach: --since %q names no commit; way forward: pass a commit SHA or a ref that names a commit", request.since))
+	case err != nil:
+		return output.Err(out, fmt.Sprintf("gate reach: %v; way forward: re-run the same command", err))
+	case !met && len(commits) > request.limit:
+		return output.Err(out, fmt.Sprintf("gate reach: the range after %s holds more than %d commits; way forward: pass a later --since, the last commit you know was green", request.since, request.limit))
+	case !met:
+		return output.Err(out, fmt.Sprintf("gate reach: %s is not on the first-parent history of %s; way forward: pass a commit that is, such as one that landed on it", request.since, branch))
+	}
+
+	_, source, _ := reader.FuncsReachedBy(pkg, name, nil)
+	lines := []string{fmt.Sprintf("gate reach: commits checked: %d, since %s on %s; the map of %s is from commit %s",
+		len(commits), request.since, branch, pkg, source.Commit)}
+	landings := []map[string]any{}
+	for _, commit := range commits {
+		changed, err := fabric.ChangedPathsBothSides(commit.Parent, commit.SHA)
+		if err != nil {
+			return output.Err(out, fmt.Sprintf("gate reach: read the changes of commit %s: %v; way forward: re-run the same command", commit.SHA, err))
+		}
+		funcs, err := changedFuncsAt(commitTree{fabric: fabric, rev: commit.SHA}, fabric, commit.Parent, module, changed)
+		if err != nil {
+			return output.Err(out, fmt.Sprintf("gate reach: find the functions commit %s changes: %v; way forward: re-run the same command", commit.SHA, err))
+		}
+		keys := make([]testcover.FuncKey, len(funcs))
+		for i, fn := range funcs {
+			keys[i] = fn.Key
+		}
+		reached, _, _ := reader.FuncsReachedBy(pkg, name, keys)
+		if len(reached) == 0 {
+			continue
+		}
+		names := make([]string, len(reached))
+		for i, key := range reached {
+			names[i] = module.relativePackage(key.Package) + "." + key.Func
+		}
+		lines = append(lines, fmt.Sprintf("gate reach: %s changes %s", commit.SHA[:min(len(commit.SHA), reachShortSHALength)], strings.Join(names, ", ")))
+		landings = append(landings, map[string]any{"commit": commit.SHA, "functions": names})
+	}
+	if len(landings) == 0 {
+		lines = append(lines, fmt.Sprintf("gate reach: no checked commit changes a function %s reaches", request.test))
+	}
+	return output.Ok(out, map[string]any{
+		"test": request.test, "branch": branch, "commits_checked": len(commits), "map_commit": source.Commit,
+		"landings": landings, "lines": lines,
+	})
+}
+
+// noMapHoldsTestLine says no coverage map holds the test, and names the commits of the maps the reader read.
+func noMapHoldsTestLine(test string, reader *testreach.Reader) string {
+	commits := map[string]bool{}
+	for _, source := range reader.Maps() {
+		commits[source.Commit] = true
+	}
+	read := "none"
+	if len(commits) > 0 {
+		read = strings.Join(slices.Sorted(maps.Keys(commits)), ", ")
+	}
+	return fmt.Sprintf("gate reach: no coverage map holds %s, so no landing can be blamed on it; the maps read are from commits %s", test, read)
+}
+
+// reachWalkBranch returns the branch the test form walks.
+// It is branch when given, else the parent branch of the worktree's pair.
+// A worktree with no parent branch walks its current branch.
+// It returns a refusal when none of them names a branch.
+func reachWalkBranch(location *lymcwd.Location, fabric *fabricengine.Fabric, branch string) (string, string) {
+	if branch != "" {
+		return branch, ""
+	}
+	origin, found, err := fabricengine.ReadOrigin(location)
+	if err != nil {
+		return "", fmt.Sprintf("gate reach: read the parent branch: %v; way forward: re-run the same command", err)
+	}
+	if found && origin.ParentBranch != "" {
+		return origin.ParentBranch, ""
+	}
+	current, err := fabric.CurrentBranch()
+	if err != nil {
+		return "", fmt.Sprintf("gate reach: the worktree has no parent branch and is on no branch: %v; way forward: pass --branch with the branch to walk", err)
+	}
+	return current, ""
+}
diff --git a/internal/gatecli/reachverb_integration_test.go b/internal/gatecli/reachverb_integration_test.go
new file mode 100644
index 00000000..18a68362
--- /dev/null
+++ b/internal/gatecli/reachverb_integration_test.go
@@ -0,0 +1,327 @@
+// reachverb_integration_test.go drives `lym gate reach` over a hubforge hub whose prime holds a small Go module.
+// The coverage maps are written by hand, so no test builds or runs a coverage binary.
+// It is Tier 1: it builds a real hub and spawns git.
+
+package gatecli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/testreach"
+)
+
+// reachVerbAnswer is the part of a `lym gate reach` envelope the rows compare.
+type reachVerbAnswer struct {
+	Ok    bool     `json:"ok"`
+	Error string   `json:"error"`
+	Lines []string `json:"lines"`
+}
+
+// reachVerbGate is the hub's gate.yaml: a go scoper and a tier0 declared at the module root.
+const reachVerbGate = "slots: 2\nscoper: go\ntiers:\n" +
+	"  tier0: {command: 'true', timeout_min: 1, counter: go-json, parallel: 2, env: {LYM_TEST_TIER: \"0\"}}\n" +
+	"gates:\n  darn-write: {tiers: [0], scope: all}\n"
+
+// reachVerbModule is the import path of the fixture module.
+const reachVerbModule = "example.com/reached"
+
+func runReachVerb(t *testing.T, cwd string, args ...string) (int, reachVerbAnswer) {
+	t.Helper()
+	var out bytes.Buffer
+	code := clihelp.ExecuteIn(Command(), cwd, &out, append([]string{"reach"}, args...))
+	var answer reachVerbAnswer
+	if err := json.Unmarshal(out.Bytes(), &answer); err != nil {
+		t.Fatalf("lym gate reach %v printed %q; want one JSON envelope: %v", args, out.String(), err)
+	}
+	return code, answer
+}
+
+// seedReachVerbMaps writes the shared maps of the fixture module:
+// alpha's TestAlphaOne covers alpha.One.
+// beta's TestBetaCalls covers beta.One and reaches alpha.One through its linked functions.
+func seedReachVerbMaps(t *testing.T, sharedDir string) {
+	t.Helper()
+	built := time.Now().Add(-time.Hour)
+	alphaOne := testcover.FuncKey{Package: reachVerbModule + "/alpha", File: "alpha.go", Func: "One"}
+	maps := map[string]testcover.Map{
+		"alpha": {
+			Commit: "alphamap", BuiltAt: built,
+			Blocks: []testcover.BlockKey{{File: "alpha.go", Func: "One", Hash: "h"}},
+			Tests:  []testcover.MapTest{{Name: "TestAlphaOne", FuncHash: "x", Seconds: 0.01, Blocks: []int{0}}},
+		},
+		"beta": {
+			Commit: "betamap", BuiltAt: built,
+			Blocks: []testcover.BlockKey{{File: "beta.go", Func: "One", Hash: "h"}},
+			Funcs:  []testcover.FuncKey{alphaOne},
+			Tests:  []testcover.MapTest{{Name: "TestBetaCalls", FuncHash: "x", Seconds: 0.01, Blocks: []int{0}, Funcs: []int{0}}},
+		},
+	}
+	for pkg, m := range maps {
+		if err := testcover.WriteMap(sharedDir, pkg, m); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// landReachVerbChange replaces from with to in the file of pkg, commits the change in root and returns the commit.
+func landReachVerbChange(t *testing.T, root, pkg, from, to string) string {
+	t.Helper()
+	file := filepath.Join(root, pkg, pkg+".go")
+	data, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, []byte(strings.Replace(string(data), from, to, 1)), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	gitkit.Git(t, root, "commit", "-q", "-a", "-m", "change "+pkg)
+	return gitkit.RevParse(t, root, "HEAD")
+}
+
+// readFilesUnder returns the content of every file under dir, by path.
+func readFilesUnder(t *testing.T, dir string) map[string]string {
+	t.Helper()
+	files := map[string]string{}
+	err := filepath.WalkDir(dir, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil || entry.IsDir() {
+			return err
+		}
+		data, err := os.ReadFile(path)
+		files[path] = string(data)
+		return err
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return files
+}
+
+func TestGateReach(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: ".", Pairs: []string{hubforge.TemplatePairSlug}})
+	prime, pair := h.PrimeWorktree(), h.PairCodeWorktree(hubforge.TemplatePairSlug)
+	seedTestMapModule(t, h, reachVerbModule, reachVerbGate, map[string]map[string]int{
+		"alpha": {"TestAlphaOne": 0}, "beta": {"TestBetaCalls": 0}, "gamma": nil,
+	})
+	seed := gitkit.RevParse(t, prime, "HEAD")
+	sharedDir := testcover.Dir(fabricengine.BoltDir(h.Location.HubPath))
+	seedReachVerbMaps(t, sharedDir)
+	// The index is written with its lock file removed again, so a reader that locked it would recreate the file.
+	if err := testreach.WriteIndex(testreach.Module{Dir: prime, Rel: ".", Path: reachVerbModule}, sharedDir); err != nil {
+		t.Fatal(err)
+	}
+	indexPath := filepath.Join(sharedDir, "index.json")
+	if err := os.Remove(lock.TrackedFileLockPath(indexPath, ".lock")); err != nil {
+		t.Fatal(err)
+	}
+
+	// Three landings on the parent branch: the second changes alpha.One, which the test reaches.
+	landingGammaOne := landReachVerbChange(t, prime, "gamma", "return 1 }", "return 9 }")
+	landingAlphaOne := landReachVerbChange(t, prime, "alpha", "return 1 }", "return 9 }")
+	landingGammaTwo := landReachVerbChange(t, prime, "gamma", "return 2 }", "return 8 }")
+	// A side branch off the seed holds one landing that changes alpha.One too.
+	gitkit.Git(t, prime, "checkout", "-q", "-b", "side", seed)
+	sideLanding := landReachVerbChange(t, prime, "alpha", "return 1 }", "return 7 }")
+	gitkit.Git(t, prime, "checkout", "-q", "main")
+	gitkit.Git(t, pair, "merge", "--ff-only", "-q", "main")
+	short := func(sha string) string { return sha[:reachShortSHALength] }
+
+	const alphaTest = "alpha.TestAlphaOne"
+	tests := []struct {
+		name      string
+		cwd       string
+		args      []string
+		wantExit  int
+		wantError []string
+		wantLines []string
+		notLines  []string
+	}{
+		{
+			name: "BothAFunctionAndTest", cwd: prime, wantExit: 1,
+			args:      []string{"alpha/alpha.go#One", "--test", alphaTest, "--since", seed},
+			wantError: []string{reachFunctionForm, reachTestForm},
+		},
+		{
+			name: "NeitherAFunctionNorTest", cwd: prime, wantExit: 1,
+			wantError: []string{reachFunctionForm, reachTestForm},
+		},
+		{
+			name: "SinceWithoutTest", cwd: prime, wantExit: 1,
+			args:      []string{"alpha/alpha.go#One", "--since", seed},
+			wantError: []string{reachFunctionForm, reachTestForm},
+		},
+		{
+			name: "BranchWithoutTest", cwd: prime, wantExit: 1,
+			args:      []string{"alpha/alpha.go#One", "--branch", "side"},
+			wantError: []string{reachFunctionForm, reachTestForm},
+		},
+		{
+			name: "TestWithoutSince", cwd: prime, wantExit: 1,
+			args:      []string{"--test", alphaTest},
+			wantError: []string{"--since", "last commit you know was green"},
+		},
+		{
+			name: "TestWithNoDot", cwd: prime, wantExit: 1,
+			args:      []string{"--test", "TestAlphaOne", "--since", seed},
+			wantError: []string{"<package>.<Test>"},
+		},
+		{
+			name: "FunctionWithNoHash", cwd: prime, wantExit: 1,
+			args:      []string{"alpha/alpha.go"},
+			wantError: []string{"<file>#<Func>"},
+		},
+		{
+			name: "BranchNamingNoBranch", cwd: prime, wantExit: 1,
+			args:      []string{"--test", alphaTest, "--since", seed, "--branch", "no-such-branch"},
+			wantError: []string{`"no-such-branch" names no branch`, "drop --branch"},
+		},
+		{
+			name: "SinceResolvingToNoCommit", cwd: prime, wantExit: 1,
+			args:      []string{"--test", alphaTest, "--since", "no-such-commit"},
+			wantError: []string{"names no commit", "pass a commit SHA or a ref that names a commit"},
+		},
+		{
+			name: "SinceNotOnTheBranchesFirstParentHistory", cwd: prime, wantExit: 1,
+			args:      []string{"--test", alphaTest, "--since", sideLanding},
+			wantError: []string{"not on the first-parent history of main"},
+		},
+		{
+			name: "OutsideAHub", cwd: t.TempDir(), wantExit: 1,
+			args:      []string{"alpha/alpha.go#One"},
+			wantError: []string{"in no hub", "worktree of the hub"},
+		},
+		{
+			name: "AFunctionReachedByTestsOfTwoPackagesListsTheOwnPackageFirstWithTheMapCommit", cwd: prime,
+			args: []string{"alpha/alpha.go#One"},
+			wantLines: []string{
+				"reach: alpha.One: TestAlphaOne, beta.TestBetaCalls",
+				"map of alpha from commit alphamap",
+				"map of beta from commit betamap",
+			},
+		},
+		{
+			name: "AFunctionNoMappedTestReachesNamesItsPackagesMap", cwd: prime,
+			args:      []string{"alpha/alpha.go#Two"},
+			wantLines: []string{"no mapped test reaches alpha.Two", "map of alpha from commit alphamap"},
+			notLines:  []string{"no coverage map holds"},
+		},
+		{
+			name: "AFunctionOfAPackageWithNoMapSaysNoMapHoldsIt", cwd: prime,
+			args:      []string{"gamma/gamma.go#One"},
+			wantLines: []string{"no mapped test reaches gamma.One", "no coverage map holds the package gamma"},
+		},
+		{
+			name: "ATestListsTheOneLandingWhoseChangedFunctionItReaches", cwd: prime,
+			args: []string{"--test", alphaTest, "--since", seed},
+			wantLines: []string{
+				"commits checked: 3", "on main", "the map of alpha is from commit alphamap", short(landingAlphaOne) + " changes alpha.One",
+			},
+			notLines: []string{short(landingGammaOne), short(landingGammaTwo), short(sideLanding)},
+		},
+		{
+			name: "ASinceGivenAsAShortSHAWalksTheSameRange", cwd: prime,
+			args:      []string{"--test", alphaTest, "--since", short(seed)},
+			wantLines: []string{"commits checked: 3", short(landingAlphaOne) + " changes alpha.One"},
+			notLines:  []string{short(landingGammaOne), short(landingGammaTwo)},
+		},
+		{
+			name: "APairWalksItsParentBranch", cwd: pair,
+			args:      []string{"--test", alphaTest, "--since", seed},
+			wantLines: []string{"commits checked: 3", "on main", short(landingAlphaOne) + " changes alpha.One"},
+		},
+		{
+			name: "TheNamedBranchIsWalkedInsteadOfTheParentBranch", cwd: prime,
+			args:      []string{"--test", alphaTest, "--since", seed, "--branch", "side"},
+			wantLines: []string{"commits checked: 1", "on side", short(sideLanding) + " changes alpha.One"},
+			notLines:  []string{short(landingAlphaOne)},
+		},
+		{
+			name: "ATestNoMapHoldsWalksNothingAndNamesTheMapsRead", cwd: prime,
+			args:      []string{"--test", "alpha.TestNope", "--since", seed},
+			wantLines: []string{"no coverage map holds alpha.TestNope", "alphamap", "betamap"},
+			notLines:  []string{"commits checked", "changes"},
+		},
+	}
+	before := readFilesUnder(t, sharedDir)
+	t.Run("Verb", func(t *testing.T) {
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				code, answer := runReachVerb(t, tt.cwd, tt.args...)
+				if code != tt.wantExit || answer.Ok != (tt.wantExit == 0) {
+					t.Fatalf("lym gate reach %v = exit %d, ok %v, error %q; want exit %d", tt.args, code, answer.Ok, answer.Error, tt.wantExit)
+				}
+				for _, want := range tt.wantError {
+					if !strings.Contains(answer.Error, want) || !strings.Contains(answer.Error, "way forward:") {
+						t.Errorf("lym gate reach %v error = %q; want one naming %q and its way forward", tt.args, answer.Error, want)
+					}
+				}
+				lines := strings.Join(answer.Lines, "\n")
+				for _, want := range tt.wantLines {
+					if !strings.Contains(lines, want) {
+						t.Errorf("lym gate reach %v lines = %q; want one holding %q", tt.args, lines, want)
+					}
+				}
+				for _, unwanted := range tt.notLines {
+					if strings.Contains(lines, unwanted) {
+						t.Errorf("lym gate reach %v lines = %q; want none holding %q", tt.args, lines, unwanted)
+					}
+				}
+			})
+		}
+	})
+	if diff := cmp.Diff(before, readFilesUnder(t, sharedDir)); diff != "" {
+		t.Errorf("the maps directory changed (-before +after):\n%s", diff)
+	}
+
+	t.Run("ARangeOverTheRequestsLimitIsRefusedNamingALaterSince", func(t *testing.T) {
+		t.Parallel()
+		call := func(limit int) (int, reachVerbAnswer) {
+			var out bytes.Buffer
+			code := runReach(lymcwd.WithCwd(context.Background(), prime), &out, reachRequest{test: alphaTest, since: seed, limit: limit})
+			var answer reachVerbAnswer
+			if err := json.Unmarshal(out.Bytes(), &answer); err != nil {
+				t.Fatalf("runReach printed %q; want one JSON envelope: %v", out.String(), err)
+			}
+			return code, answer
+		}
+		code, answer := call(2)
+		if code != 1 || !strings.Contains(answer.Error, "more than 2 commits") || !strings.Contains(answer.Error, "later --since") {
+			t.Errorf("runReach(limit 2) = exit %d, error %q; want a refusal naming the cap of 2 and a later --since", code, answer.Error)
+		}
+		if code, answer := call(3); code != 0 || !strings.Contains(strings.Join(answer.Lines, "\n"), "commits checked: 3") {
+			t.Errorf("runReach(limit 3) = exit %d, lines %q; want the three landings checked", code, answer.Lines)
+		}
+	})
+
+	t.Run("AHubWhoseScoperIsNotGoPrintsItsNote", func(t *testing.T) {
+		t.Parallel()
+		other := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+		otherPrime := seedTestMapModule(t, other, reachVerbModule, strings.Replace(reachVerbGate, "scoper: go", "scoper: none", 1),
+			map[string]map[string]int{"alpha": {"TestAlphaOne": 0}})
+		code, answer := runReachVerb(t, otherPrime, "alpha/alpha.go#One")
+		if code != 0 || !strings.Contains(strings.Join(answer.Lines, "\n"), "the hub's scoper is none, not go") {
+			t.Errorf("lym gate reach = exit %d, lines %q; want exit 0 and a note naming the scoper", code, answer.Lines)
+		}
+	})
+}
