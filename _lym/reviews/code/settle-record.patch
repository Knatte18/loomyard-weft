-	for range min(c.sideBySide, len(jobs)) {
-		workers.Add(1)
-		go func() {
-			defer workers.Done()
-			for i := range indexes {
-				results[i], errs[i] = c.runJob(bin, jobs[i])
-			}
-		}()
-	}
-	for i := range jobs {
-		indexes <- i
-	}
-	close(indexes)
-	workers.Wait()
-	c.stats.Runs += len(jobs)
-	if err := c.ctx.Err(); err != nil {
-		return nil, err
-	}
