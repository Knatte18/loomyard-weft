+		{name: "CarriedMovedToATouchedFile", ctx: round(changed("c.go")), prior: []PriorEntry{entry("E1", PriorOpen)}, findings: []Finding{carrying(finding("F1", SeverityMedium, "c.go:4"), "E1")}},
