+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("BatchingNudge() error: %v", err)
+			}
+			wantAfter := before
+			if tt.want == nil {
+				if got != nil {
+					t.Errorf("BatchingNudge() = %s; want no output", got)
+				}
+			} else {
