+		{name: "NewParentFindingWithNoAsk", ctx: round(nil), prior: []PriorEntry{entry("E1", PriorResolved)}, findings: []Finding{fromParent(finding("F1", SeverityBlocking, "a.go:3"), "P1")}, wantErr: "origin: parent"},
