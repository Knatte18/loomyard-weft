+	asks := a.asks()
+	if _, err := burlerengine.AnswerParentAsk(a.files, asks[len(asks)-1].Number, a.clock, nil); err != nil {
+		a.t.Fatalf("AnswerParentAsk() error = %v; want nil", err)
+	}
