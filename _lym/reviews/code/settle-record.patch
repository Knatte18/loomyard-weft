-	entry.tests = coverageUnion(declared, selection, guards[dir])
-	entry.whole = false
-	entry.label = coverageNone
-	if len(entry.tests) > 0 {
-		entry.label = fmt.Sprintf("selected %d of %d", len(entry.tests), len(declared))
-	}
