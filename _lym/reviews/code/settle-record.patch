diff --git a/internal/slackengine/bridgemap.go b/internal/slackengine/bridgemap.go
new file mode 100644
index 00000000..22b8e498
--- /dev/null
+++ b/internal/slackengine/bridgemap.go
@@ -0,0 +1,99 @@
+// bridgemap.go holds the hub's bridge map: the bridge channel of each pair of orchs and the cursors read in it.
+
+package slackengine
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// BridgeMap is the hub's record of its bridge channels, keyed by the channel's Slack id.
+type BridgeMap struct {
+	// Channels holds one entry per bridge channel.
+	Channels map[string]BridgeEntry `json:"channels"`
+}
+
+// BridgeEntry is the bridge channel of one pair of orchs and how far the relay has read it.
+type BridgeEntry struct {
+	// Name is the channel's name.
+	Name string `json:"name"`
+	// LocalOrch is the creel name of this hub's orch of the pair.
+	LocalOrch string `json:"local_orch"`
+	// Peer is the full `<machine>::<name>` address of the other machine's orch of the pair.
+	Peer string `json:"peer"`
+	// Operator is the Slack user id of the operator invited to the channel, empty for none.
+	Operator string `json:"operator"`
+	// PeerInvited reports whether the peer's bot was invited to the channel.
+	PeerInvited bool `json:"peer_invited"`
+	// Cursor is the delivery cursor: the timestamp of the newest message of the channel the relay has handled.
+	Cursor string `json:"cursor"`
+	// OperatorCursor is the timestamp of the newest message of the operator the relay has handled.
+	OperatorCursor string `json:"operator_cursor"`
+	// Threads maps a thread's timestamp to the timestamp of the newest reply handled.
+	Threads map[string]string `json:"threads"`
+	// ThreadFloor is the timestamp before which a thread with no cursor has nothing left to read.
+	ThreadFloor string `json:"thread_floor"`
+	// Renamed reports whether the channel carries the dated name a retiring channel takes before its archive.
+	Renamed bool `json:"renamed,omitempty"`
+	// Archived reports whether the channel is archived.
+	Archived bool `json:"archived"`
+}
+
+// ReadBridgeMap reads the bridge map at path, and reads a missing file as an empty map.
+// A file that does not decode is an error that names it and wraps state.ErrDecode.
+func ReadBridgeMap(path string) (BridgeMap, error) {
+	bridgeMap, _, err := state.ReadJSON[BridgeMap](path, recordLockPath(path))
+	if err != nil {
+		return BridgeMap{}, fmt.Errorf("slack: read the bridge map %s: %w", path, err)
+	}
+	return bridgeMap, nil
+}
+
+// UpdateBridgeMap is the one writer of the bridge map at path.
+// It reads the map, calls mutate on it and writes the result, all under the map's lock,
+// so a key an older binary does not know survives and two updates never lose one another's.
+// mutate makes no Slack call, since the lock is held while it runs.
+func UpdateBridgeMap(path string, mutate func(*BridgeMap) error) error {
+	err := state.UpdateJSON(path, recordLockPath(path), func(current BridgeMap, _ bool) (BridgeMap, error) {
+		if current.Channels == nil {
+			current.Channels = map[string]BridgeEntry{}
+		}
+		if err := mutate(&current); err != nil {
+			return BridgeMap{}, err
+		}
+		return current, nil
+	})
+	if err != nil {
+		return fmt.Errorf("slack: update the bridge map %s: %w", path, err)
+	}
+	return nil
+}
+
+// OpenChannelIDs returns the ids, sorted, of the open channels whose entry keep accepts; a nil keep accepts every entry.
+func (m BridgeMap) OpenChannelIDs(keep func(BridgeEntry) bool) []string {
+	ids := make([]string, 0, len(m.Channels))
+	for id, entry := range m.Channels {
+		if !entry.Archived && (keep == nil || keep(entry)) {
+			ids = append(ids, id)
+		}
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+// ChannelOf returns the id of the open bridge channel of the local orch and the peer address, skipping archived ones.
+// Several open channels of one pair answer the one with the lowest id.
+func (m BridgeMap) ChannelOf(localOrch, peer string) (string, bool) {
+	found := ""
+	for id, entry := range m.Channels {
+		if entry.Archived || entry.LocalOrch != localOrch || entry.Peer != peer {
+			continue
+		}
+		if found == "" || id < found {
+			found = id
+		}
+	}
+	return found, found != ""
+}
diff --git a/internal/slackengine/bridgemessage.go b/internal/slackengine/bridgemessage.go
new file mode 100644
index 00000000..01cf4712
--- /dev/null
+++ b/internal/slackengine/bridgemessage.go
@@ -0,0 +1,127 @@
+// bridgemessage.go formats and parses the envelope of a bridge message and names the bridge channel of a pair of orchs.
+
+package slackengine
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/machinename"
+)
+
+const (
+	// bridgeEnvelopePrefix opens the first line of every bridge message.
+	bridgeEnvelopePrefix = creelengine.MachineEnvelopeLead
+	// bridgeFromKey, bridgeToKey, bridgeIDKey and bridgeReplyToKey open the fields of the envelope line, in that order.
+	bridgeFromKey    = "from="
+	bridgeToKey      = "to="
+	bridgeIDKey      = "id="
+	bridgeReplyToKey = "reply-to="
+	// bridgeChannelPrefix opens the name of every bridge channel.
+	bridgeChannelPrefix = "bridge-"
+	// bridgeEndSeparator joins the two ends of a bridge channel's name.
+	bridgeEndSeparator = "--"
+)
+
+// BridgeEnvelope is the first line of a bridge message: who wrote it, to whom, and under which ids.
+type BridgeEnvelope struct {
+	// From is the orch that wrote the message and To the orch it is for.
+	From, To agentname.MachineAddress
+	// ID is the id the sending machine gave the message.
+	ID int64
+	// ReplyTo is the id the receiving machine gave the message this one answers, 0 for mail.
+	ReplyTo int64
+}
+
+// FormatBridgeMessage returns the text of a bridge message: the envelope line, a newline and body as given.
+// The line reads `[lym-bridge] from=<machine>::<name> to=<machine>::<name> id=<id>`.
+// When ReplyTo is set, ` reply-to=<id>` follows the id.
+// The caller escapes body for Slack.
+func FormatBridgeMessage(envelope BridgeEnvelope, body string) string {
+	line := strings.Join([]string{
+		bridgeEnvelopePrefix,
+		bridgeFromKey + formatBridgeAddress(envelope.From),
+		bridgeToKey + formatBridgeAddress(envelope.To),
+		bridgeIDKey + strconv.FormatInt(envelope.ID, 10),
+	}, " ")
+	if envelope.ReplyTo != 0 {
+		line += " " + bridgeReplyToKey + strconv.FormatInt(envelope.ReplyTo, 10)
+	}
+	return line + "\n" + body
+}
+
+// formatBridgeAddress returns address in the `<machine>::<name>` form.
+func formatBridgeAddress(address agentname.MachineAddress) string {
+	return agentname.FormatMachineAddress(address.Machine, address.Name.String())
+}
+
+// ParseBridgeMessage reads text, a message as Slack delivers it.
+// It answers the envelope, the body after the first line and true.
+// It answers false for a first line that is not exactly the envelope FormatBridgeMessage writes:
+// the prefix, then `from=`, `to=` and `id=` in that order, and an optional `reply-to=` last.
+// Each id is a positive integer, and each address parses as a cross-machine address under the machine name rule.
+// It judges no machine as this one's.
+func ParseBridgeMessage(text string) (BridgeEnvelope, string, bool) {
+	line, body, _ := strings.Cut(text, "\n")
+	fields := strings.Split(line, " ")
+	if len(fields) < 4 || len(fields) > 5 || fields[0] != bridgeEnvelopePrefix {
+		return BridgeEnvelope{}, "", false
+	}
+	from, fromOK := parseBridgeAddress(fields[1], bridgeFromKey)
+	to, toOK := parseBridgeAddress(fields[2], bridgeToKey)
+	id, idOK := parseBridgeID(fields[3], bridgeIDKey)
+	if !fromOK || !toOK || !idOK {
+		return BridgeEnvelope{}, "", false
+	}
+	envelope := BridgeEnvelope{From: from, To: to, ID: id}
+	if len(fields) == 5 {
+		replyTo, replyToOK := parseBridgeID(fields[4], bridgeReplyToKey)
+		if !replyToOK {
+			return BridgeEnvelope{}, "", false
+		}
+		envelope.ReplyTo = replyTo
+	}
+	return envelope, body, true
+}
+
+// parseBridgeAddress reads a `<key><machine>::<name>` field.
+func parseBridgeAddress(field, key string) (agentname.MachineAddress, bool) {
+	value, found := strings.CutPrefix(field, key)
+	if !found {
+		return agentname.MachineAddress{}, false
+	}
+	address, err := agentname.ParseMachineAddress(value, nil, machinename.CheckName)
+	return address, err == nil
+}
+
+// parseBridgeID reads a `<key><id>` field whose id is a positive integer written without sign or leading zero.
+func parseBridgeID(field, key string) (int64, bool) {
+	value, found := strings.CutPrefix(field, key)
+	if !found {
+		return 0, false
+	}
+	id, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || id <= 0 || strconv.FormatInt(id, 10) != value {
+		return 0, false
+	}
+	return id, true
+}
+
+// BridgeChannelName returns the name of the bridge channel of the pair of orchs one and other, lower-cased.
+// The name reads `bridge-<end>--<end>`, each end being the machine, `-` and the creel name with `:` turned to `-`.
+// The two ends are sorted, so both machines compute one name for a pair.
+// A name over Slack's length limit is cut and ends in a hash of the whole name.
+func BridgeChannelName(one, other agentname.MachineAddress) string {
+	ends := []string{bridgeChannelEnd(one), bridgeChannelEnd(other)}
+	if ends[1] < ends[0] {
+		ends[0], ends[1] = ends[1], ends[0]
+	}
+	return fitName(bridgeChannelPrefix + ends[0] + bridgeEndSeparator + ends[1])
+}
+
+// bridgeChannelEnd returns one end of a bridge channel's name.
+func bridgeChannelEnd(address agentname.MachineAddress) string {
+	return slackNamePart(address.Machine) + channelNameSeparator + slackNamePart(address.Name.String())
+}
