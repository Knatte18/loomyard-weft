+// gitexec_unix_test.go holds the gitexec tests whose ext:: remote is a shell script.
+
+package gitexec_test
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
