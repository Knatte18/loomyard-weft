-// literalHelper returns the helper that changes a literal of kind, or "" for a kind no mutant changes.
-func literalHelper(kind token.Token) string {
-	switch kind {
-	case token.INT, token.CHAR:
-		return stepHelper
-	case token.STRING:
-		return "lymMutantString"
-	}
-	return ""
-}
