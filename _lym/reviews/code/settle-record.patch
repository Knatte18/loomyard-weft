+	writeFixture(t, pkgDir, "tier2_test.go", fixtureTier2Tests)
+	writeFixture(t, pkgDir, "tier0_test.go", fixtureTier0Tests)
+	writeFixture(t, pkgDir, "requiretier2_test.go", fixtureRequireTier2Tests)
+	writeFixture(t, filepath.Join(kitRoot, "gitonlykit"), "gitonlykit.go", fixtureGitOnlyKit)
+	writeFixture(t, filepath.Join(kitRoot, "gokit"), "gokit.go", fixtureGoKit)
+	writeFixture(t, filepath.Join(kitRoot, "quietkit"), "quietkit.go", fixtureQuietKit)
+
+	got, err := testcover.ScanSpawns(fixtureModule, kitRoot, pkgDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	outOfProcess := testcover.SpawnVerdict{OutOfProcess: true}
+	unresolved := testcover.SpawnVerdict{Unresolved: true}
+	want := map[string]testcover.SpawnVerdict{
+		"TestUntaggedLymbin":     {},
+		"TestUntaggedUnresolved": {},
+		"TestLymbin":             outOfProcess,
+		"TestExecutable":         outOfProcess,
+		"TestArgsProgram":        outOfProcess,
+		"TestArgsRest":           {},
+		"TestGoCommand":          outOfProcess,
+		"TestGoCommandContext":   outOfProcess,
+		"TestGitCommand":         {},
+		"TestHelperChain":        outOfProcess,
+		"TestHermetic":           {},
+		"TestGitkitSpawn":        {},
+		"TestHubforge":           {},
+		"TestFuncValue":          unresolved,
+		"TestFuncField":          unresolved,
+		"TestProdCall":           {},
+		"TestSamePackageProd":    outOfProcess,
+		"TestKitGitOnly":         {},
+		"TestKitRunsGo":          outOfProcess,
+		"TestKitQuiet":           {},
+		"TestPlain":              {},
+		"TestTier2LinuxTier":     outOfProcess,
+		"TestTier2Tier":          outOfProcess,
+		"TestTier0Tier":          {},
+		"TestRequireTier2":       outOfProcess,
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ScanSpawns =\n%+v\nwant\n%+v", got, want)
+	}
+}
diff --git a/internal/testcover/testmain_test.go b/internal/testcover/testmain_test.go
new file mode 100644
index 000000000..d48164f0d
--- /dev/null
+++ b/internal/testcover/testmain_test.go
@@ -0,0 +1,87 @@
+// testmain_test.go runs the package's tests under tmux isolation.
+// It also runs a re-exec'd test binary as a stand-in `go` or a stand-in coverage binary when a runner test asks for one.
+
+package testcover_test
+
+import (
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxkit"
+)
+
+// standInRecordEnv names the file a re-exec'd test binary, acting as a stand-in, records its arguments into.
+const standInRecordEnv = "TESTCOVER_STAND_IN_RECORD"
+
+// The tests the stand-in coverage binary knows, named for the outcome each reports.
+// standInProfileLine is the profile line it writes for a pass.
+const (
+	standInPass        = "TestStandInPass"
+	standInFail        = "TestStandInFail"
+	standInSkip        = "TestStandInSkip"
+	standInSkipProfile = "TestStandInSkipWithProfile"
+	standInNoProfile   = "TestStandInNoProfile"
+	standInProfileLine = "m/p/x.go:3.21,5.2 1 1"
+)
+
+// TestMain runs a stand-in when standInRecordEnv is set, and the tests under tmuxkit.Main otherwise.
+func TestMain(m *testing.M) {
+	if record := os.Getenv(standInRecordEnv); record != "" {
+		os.Exit(runStandIn(record, os.Args[1:]))
+	}
+	os.Exit(tmuxkit.Main(m))
+}
+
+// runStandIn writes args, one per line, to record and acts on them, returning the process exit code.
+// As `go test -list`, it prints two test names; as `go test -c`, it creates the empty file `-o` names.
+// As a coverage binary, it reports the outcome of the one test its `-test.run` names.
+// It writes a profile for a passing test, and for a skipped one that standInSkipProfile names.
+func runStandIn(record string, args []string) int {
+	if err := os.WriteFile(record, []byte(strings.Join(args, "\n")), 0o644); err != nil {
+		return 1
+	}
+	switch {
+	case slices.Contains(args, "-list"):
+		fmt.Println("TestAlpha\nExampleBeta\nok  \tm/p\t0.01s")
+		return 0
+	case slices.Contains(args, "-c"):
+		if i := slices.Index(args, "-o"); i >= 0 && i+1 < len(args) {
+			if err := os.WriteFile(args[i+1], nil, 0o755); err != nil {
+				return 1
+			}
+		}
+		return 0
+	}
+	var name, profile string
+	for _, arg := range args {
+		if pattern, ok := strings.CutPrefix(arg, "-test.run="); ok {
+			name = strings.TrimSuffix(strings.TrimPrefix(pattern, "^"), "$")
+		}
+		if path, ok := strings.CutPrefix(arg, "-test.coverprofile="); ok {
+			profile = path
+		}
+	}
+	switch name {
+	case standInPass:
+		if err := os.WriteFile(profile, []byte("mode: set\n"+standInProfileLine+"\n"), 0o644); err != nil {
+			return 1
+		}
+		fmt.Printf("--- PASS: %s (0.25s)\n", name)
+	case standInSkipProfile:
+		if err := os.WriteFile(profile, []byte("mode: set\n"+standInProfileLine+"\n"), 0o644); err != nil {
+			return 1
+		}
+		fmt.Printf("--- SKIP: %s (0.00s)\n", name)
+	case standInNoProfile:
+		fmt.Printf("--- PASS: %s (0.25s)\n", name)
+	case standInSkip:
+		fmt.Printf("--- SKIP: %s (0.00s)\n", name)
+	default:
+		fmt.Printf("--- FAIL: %s (0.10s)\n", name)
+		return 1
+	}
+	return 0
+}
diff --git a/internal/testcover/verdict.go b/internal/testcover/verdict.go
new file mode 100644
index 000000000..738cf7ddb
--- /dev/null
+++ b/internal/testcover/verdict.go
@@ -0,0 +1,173 @@
+// verdict.go judges the per-test block sets of one run.
+// It decides which tests are contained in the others and which may go together.
+
+package testcover
+
+import "sort"
+
+// Reasons a test is not judged.
+const (
+	ReasonSkipped      = "skipped"
+	ReasonOutOfProcess = "out of process"
+	ReasonUnresolved   = "unclassifiable call"
+	ReasonNoBlocks     = "no blocks"
+	ReasonFailed       = "failed"
+)
+
+// Run is one top-level test as Judge sees it.
+type Run struct {
+	Name string
+	// Elapsed is the test's standalone seconds; the greedy pass removes slower tests first.
+	Elapsed float64
+	// Action is ActionPass, ActionFail or ActionSkip.
+	Action string
+	// Blocks are the blocks the test covered.
+	Blocks BlockSet
+	// Spawn is the static spawn scan's verdict on the test.
+	Spawn SpawnVerdict
+}
+
+// Verdict is the judgement of one run.
+type Verdict struct {
+	Name string
+	// Reason is non-empty for a test that is not judged, and names why.
+	Reason string
+	// Contained is set when other judged tests cover every block the test covers.
+	Contained bool
+	// Removable is set when the greedy pass drops the test, so it may be deleted together with every other removable test.
+	Removable bool
+	// Covering names, for a contained test, the tests that together cover its blocks, largest overlap first.
+	// For a removable test they come from the tests the pass keeps.
+	Covering []string
+}
+
+// Judge returns the verdict of every run, in the order given.
+// A test is judged when it passed and covered a block.
+// It must also be one the spawn scan neither saw run module code in another process nor failed to resolve a call.
+// Only a judged test's blocks count as covered.
+// The removable set is a greedy pass over the contained tests, slowest first, then by name.
+// It re-checks each contained test against the tests still kept.
+func Judge(runs []Run) []Verdict {
+	counts := map[string]int{}
+	for _, r := range runs {
+		if notJudgedReason(r) == "" {
+			for b := range r.Blocks {
+				counts[b]++
+			}
+		}
+	}
+	covered := func(r Run) bool {
+		for b := range r.Blocks {
+			if counts[b] < 2 {
+				return false
+			}
+		}
+		return true
+	}
+
+	out := make([]Verdict, len(runs))
+	var contained []int
+	for i, r := range runs {
+		out[i].Name = r.Name
+		out[i].Reason = notJudgedReason(r)
+		if out[i].Reason == "" && covered(r) {
+			out[i].Contained = true
+			contained = append(contained, i)
+		}
+	}
+
+	sort.SliceStable(contained, func(a, b int) bool {
+		ra, rb := runs[contained[a]], runs[contained[b]]
+		if ra.Elapsed != rb.Elapsed {
+			return ra.Elapsed > rb.Elapsed
+		}
+		return ra.Name < rb.Name
+	})
+	for _, i := range contained {
+		if !covered(runs[i]) {
+			continue
+		}
+		out[i].Removable = true
+		for b := range runs[i].Blocks {
+			counts[b]--
+		}
+	}
+
+	for _, i := range contained {
+		inPool := func(j int) bool { return out[j].Reason == "" && !out[j].Removable }
+		if !out[i].Removable {
+			inPool = func(j int) bool { return out[j].Reason == "" }
+		}
+		out[i].Covering = coveringTests(i, runs, inPool)
+	}
+	return out
+}
+
+// notJudgedReason returns why a run is not judged, or "" for a run that is.
+func notJudgedReason(r Run) string {
+	switch {
+	case r.Action == ActionSkip:
+		return ReasonSkipped
+	case r.Action != ActionPass:
+		return ReasonFailed
+	case r.Spawn.OutOfProcess:
+		return ReasonOutOfProcess
+	case r.Spawn.Unresolved:
+		return ReasonUnresolved
+	case len(r.Blocks) == 0:
+		return ReasonNoBlocks
+	}
+	return ""
+}
+
+// coveringTests names the tests of the pool that together cover runs[self]'s blocks.
+// It takes the largest overlap first and skips a test that adds no block still uncovered.
+func coveringTests(self int, runs []Run, inPool func(int) bool) []string {
+	type overlap struct {
+		idx int
+		n   int
+	}
+	var overlaps []overlap
+	for j, r := range runs {
+		if j == self || !inPool(j) {
+			continue
+		}
+		n := 0
+		for b := range runs[self].Blocks {
+			if _, ok := r.Blocks[b]; ok {
+				n++
+			}
+		}
+		if n > 0 {
+			overlaps = append(overlaps, overlap{j, n})
+		}
+	}
+	sort.Slice(overlaps, func(a, b int) bool {
+		if overlaps[a].n != overlaps[b].n {
+			return overlaps[a].n > overlaps[b].n
+		}
+		return runs[overlaps[a].idx].Name < runs[overlaps[b].idx].Name
+	})
+
+	remaining := map[string]struct{}{}
+	for b := range runs[self].Blocks {
+		remaining[b] = struct{}{}
+	}
+	var names []string
+	for _, o := range overlaps {
+		if len(remaining) == 0 {
+			break
+		}
+		hit := false
+		for b := range remaining {
+			if _, ok := runs[o.idx].Blocks[b]; ok {
+				delete(remaining, b)
+				hit = true
+			}
+		}
+		if hit {
+			names = append(names, runs[o.idx].Name)
+		}
+	}
+	return names
+}
diff --git a/internal/testcover/verdict_test.go b/internal/testcover/verdict_test.go
new file mode 100644
index 000000000..8f9a303c2
--- /dev/null
+++ b/internal/testcover/verdict_test.go
@@ -0,0 +1,94 @@
+package testcover_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func blockSet(names ...string) testcover.BlockSet {
+	set := testcover.BlockSet{}
+	for _, n := range names {
+		set[n] = struct{}{}
+	}
+	return set
+}
+
+func passRun(name string, elapsed float64, blocks ...string) testcover.Run {
+	return testcover.Run{Name: name, Elapsed: elapsed, Action: testcover.ActionPass, Blocks: blockSet(blocks...)}
+}
+
+func TestJudge(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	skipped := passRun("Skipped", 0, "b1")
+	skipped.Action = testcover.ActionSkip
+	failed := passRun("Failed", 1, "b1")
+	failed.Action = testcover.ActionFail
+	spawning := passRun("OutOfProcess", 1, "b1")
+	spawning.Spawn = testcover.SpawnVerdict{OutOfProcess: true}
+	unresolved := passRun("Unresolved", 1, "b1")
+	unresolved.Spawn = testcover.SpawnVerdict{Unresolved: true}
+
+	tests := []struct {
+		name string
+		runs []testcover.Run
+		want []testcover.Verdict
+	}{
+		{
+			name: "subset of another test is removable, the superset is not contained",
+			runs: []testcover.Run{passRun("A", 1, "b1", "b2"), passRun("B", 1, "b1", "b2", "b3")},
+			want: []testcover.Verdict{
+				{Name: "A", Contained: true, Removable: true, Covering: []string{"B"}},
+				{Name: "B"},
+			},
+		},
+		{
+			name: "mutual pair: the slowest is removed and the other kept",
+			runs: []testcover.Run{passRun("C", 2, "b1"), passRun("D", 1, "b1"), passRun("E", 1, "b9")},
+			want: []testcover.Verdict{
+				{Name: "C", Contained: true, Removable: true, Covering: []string{"D"}},
+				{Name: "D", Contained: true, Covering: []string{"C"}},
+				{Name: "E"},
+			},
+		},
+		{
+			name: "the removable set keeps the superset, whose covering tests come by overlap and skip one that adds nothing",
+			runs: []testcover.Run{
+				passRun("P", 1, "b1", "b2", "b3"), passRun("Q", 1, "b4"),
+				passRun("R", 1, "b1"), passRun("T", 1, "b1", "b2", "b3", "b4"),
+			},
+			want: []testcover.Verdict{
+				{Name: "P", Contained: true, Removable: true, Covering: []string{"T"}},
+				{Name: "Q", Contained: true, Removable: true, Covering: []string{"T"}},
+				{Name: "R", Contained: true, Removable: true, Covering: []string{"T"}},
+				{Name: "T", Contained: true, Covering: []string{"P", "Q"}},
+			},
+		},
+		{
+			name: "no blocks, skipped, failed, out-of-process and unresolved tests are never judged and cover nothing",
+			runs: []testcover.Run{
+				passRun("Empty", 1), skipped, failed, spawning, unresolved, passRun("Base", 1, "b1", "b2"),
+			},
+			want: []testcover.Verdict{
+				{Name: "Empty", Reason: testcover.ReasonNoBlocks},
+				{Name: "Skipped", Reason: testcover.ReasonSkipped},
+				{Name: "Failed", Reason: testcover.ReasonFailed},
+				{Name: "OutOfProcess", Reason: testcover.ReasonOutOfProcess},
+				{Name: "Unresolved", Reason: testcover.ReasonUnresolved},
+				{Name: "Base"},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := testcover.Judge(tt.runs); !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("Judge = %+v\nwant    %+v", got, tt.want)
+			}
+		})
+	}
+}
