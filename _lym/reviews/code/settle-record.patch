@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Usage: extract-rounds.sh <runs-dir>
+# Prints one TSV row per review round of every run under <runs-dir>, from the round's usage record,
+# its review front matter and its bouncer ledger:
+# run perch round fan review_model review_effort review_wall_s review_fresh review_cache forks fork_fresh
+#   fix_wall_s fix_fresh review_verdict bouncer_verdict findings gating new_ledger_keys
+# A fresh-token count is uncached input plus output; cache reads are listed apart.
+set -euo pipefail
+runs=$1
+printf 'run\tperch\tround\tfan\treview_model\treview_effort\treview_wall_s\treview_fresh\treview_cache\tforks\tfork_fresh\tfix_wall_s\tfix_fresh\treview_verdict\tbouncer_verdict\tfindings\tgating\tnew_ledger_keys\n'
+for u in "$runs"/*/_lyx/reviews/*/round-*-usage.yaml; do
+  run=${u#"$runs"/}; run=${run%%/*}
+  dir=$(dirname "$u"); perch=$(basename "$dir")
+  round=$(basename "$u" | sed 's/round-\([0-9]*\)-usage.yaml/\1/')
+  usage=$(awk '
+    /^fan:/ { fan = $2; gsub(/"/, "", fan) }
+    /^[a-z_]+:/ { sec = $1; sub(":", "", sec) }
+    sec == "review" && /^    model:/ { rm = $2 }
+    sec == "review" && /^    effort:/ { re = $2 }
+    sec == "review" && /^    wall_seconds:/ { rw = $2 }
+    sec == "review" && /^    fresh_tokens:/ { rf = $2 }
+    sec == "review" && /^    cache_read_tokens:/ { rc = $2 }
+    sec == "review" && /^    forks:/ { fk = $2 }
+    sec == "review" && /^    fork_fresh_tokens:/ { ff = $2 }
+    sec == "fix" && /^    wall_seconds:/ { fw = $2 }
+    sec == "fix" && /^    fresh_tokens:/ { fx = $2 }
+    END { printf "%s\t%s\t%s\t%d\t%d\t%s\t%d\t%d\t%d", fan, rm, re, rw, rf, rc, fk, ff, fw; printf "\t%d", fx }
+  ' "$u")
+  rv=$dir/round-$round-review.md
+  verdict=$(awk '/^verdict:/ {print $2; exit}' "$rv" 2>/dev/null || true)
+  bv=$(awk '/^verdict:/ {print $2; exit}' "$dir/round-$round-bouncer-verdict.md" 2>/dev/null || true)
+  n=$(grep -c '^  - id:' "$rv" 2>/dev/null || true)
+  g=$(awk '/^    severity:/ && ($2=="BLOCKING"||$2=="HIGH"||$2=="MEDIUM") {c++} END{print c+0}' "$rv" 2>/dev/null || echo 0)
+  nk=$(awk -v r="$round" '/^  - key:/ {k=1} /rounds:/ { s=$0; sub(/.*\[/, "", s); sub(/,.*|\].*/, "", s); if (s == r) c++ } END {print c+0}' "$dir/round-$round-bouncer-ledger.md" 2>/dev/null || echo 0)
+  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$run" "$perch" "$round" "$usage" "$verdict" "$bv" "${n:-0}" "$g" "$nk"
+done
diff --git a/docs/research/burler/review-setup-audit-2026-10-28/extract-twill.sh b/docs/research/burler/review-setup-audit-2026-10-28/extract-twill.sh
new file mode 100755
index 00000000..193a4205
--- /dev/null
+++ b/docs/research/burler/review-setup-audit-2026-10-28/extract-twill.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# Usage: extract-twill.sh <runs-dir>
+# Prints one TSV row per lens item the twill writers judged, from the writer's own disposition list:
+# run writer lens lenses_on_item severity outcome
+# writer is twill-discussion (the "lens review" turn of discussion/support-log.md)
+# or twill-plan (the bullets of plan/lens-review.md).
+# A bullet counts when its first word is a lens name.
+# outcome is fixed, rejected (also disputed) or other, from the first "— <word>" or ": <word>" in the bullet.
+# lenses_on_item counts the lenses a bullet names (a merged item names several), so 1 means a lens found it alone.
+set -euo pipefail
+runs=$1
+printf 'run\twriter\tlens\tlenses_on_item\tseverity\toutcome\n'
+parse='
+  function lensname(w) { return w ~ /^(board-fit|bound-breaker|existing-paths|goal-scope|interactions|leanness|walkthrough|coverage|row-validity|forced-edits|guard-reach|way-forward|affected-set)$/ }
+  !/^- / { next }
+  {
+    line = substr($0, 3); split(line, first, /[ ,]/); if (!lensname(first[1])) next
+    colon = index(line, ":"); if (colon == 0) next
+    head = substr(line, 1, colon - 1); rest = substr(line, colon + 1)
+    sub(/ \(.*$/, "", head)
+    sev = "-"; if (line ~ /BLOCKING/) sev = "BLOCKING"; else if (line ~ /MEDIUM/) sev = "MEDIUM"; else if (line ~ /LOW/) sev = "LOW"
+    out = "other"
+    if (match(line, /(— |: )(envelope )?(fixed|rejected|disputed)/)) { w = substr(line, RSTART, RLENGTH); out = (w ~ /fixed/) ? "fixed" : "rejected" }
+    n = split(head, parts, " \\+ ")
+    for (i = 1; i <= n; i++) {
+      split(parts[i], nm, /[ ,]/); if (!lensname(nm[1])) continue
+      printf "%s\t%s\t%s\t%d\t%s\t%s\n", run, writer, nm[1], n, sev, out
+    }
+  }'
+for d in "$runs"/*/; do
+  run=$(basename "$d")
+  sl=$d/_lyx/discussion/support-log.md
+  if [ -e "$sl" ] && grep -q 'lens review' "$sl"; then
+    awk -v run="$run" -v writer=twill-discussion '/^### / { on = ($0 ~ /lens review/); next } on' "$sl" | awk -v run="$run" -v writer=twill-discussion "$parse"
+  fi
+  lr=$d/_lyx/plan/lens-review.md
+  if [ -e "$lr" ]; then
+    awk -v run="$run" -v writer=twill-plan "$parse" "$lr"
+  fi
+done
