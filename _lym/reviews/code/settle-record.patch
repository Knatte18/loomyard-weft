+		t.Fatalf("runTestMap exit = %d; want 0; output %s", code, out)
+	}
+	var got testMapOutcome
+	if err := json.Unmarshal(out, &got); err != nil {
+		t.Fatalf("unmarshal %q: %v", out, err)
+	}
+	return got
