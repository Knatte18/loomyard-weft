+// raddlefile_test.go exercises the Raddle-File producer over recording fakes for every seam and a run's files in a temp directory.
+
+package loomshed_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
