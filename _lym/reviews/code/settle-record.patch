+			return err
+		}
+		if !found {
+			entry = shedengine.Takeover{Machine: owner, Subject: subject, At: time.Now().UTC().Format(time.RFC3339)}
+		}
+		return pairteardown.HandOver(prime, slug, entry, pairteardown.RunPush{InsidePair: true, Parent: parent})
+	}
