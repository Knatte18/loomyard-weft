+	}
+	repo := gitrepo.New(prime.WorktreePath())
+	seen := map[string]bool{}
+	for _, remote := range []string{"", originRemoteName} {
+		branches, err := repo.BranchNames(remote)
+		if err != nil {
+			return nil, err
+		}
