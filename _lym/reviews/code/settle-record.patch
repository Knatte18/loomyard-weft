+	t.Chdir(workdir)
+	got, err := readInstalledPlugins(configDir)
+	if err != nil {
+		t.Fatalf("readInstalledPlugins() error: %v", err)
+	}
+	if want := []installedPlugin{{id: "p@m"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("readInstalledPlugins() = %+v; want %+v", got, want)
+	}
+}
