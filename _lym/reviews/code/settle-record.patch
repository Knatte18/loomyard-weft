-			})
-		}
-	}
-	for i := range sites {
-		sites[i].noise = slices.ContainsFunc(noise, func(span [2]int) bool { return span[0] <= sites[i].start && sites[i].end <= span[1] })
-	}
-	slices.SortStableFunc(sites, func(a, b site) int {
