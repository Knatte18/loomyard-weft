diff --git a/internal/reedengine/checkmark.go b/internal/reedengine/checkmark.go
new file mode 100644
index 00000000..a009667b
--- /dev/null
+++ b/internal/reedengine/checkmark.go
@@ -0,0 +1,45 @@
+// checkmark.go sets the session check mark that line 2 of the status bar shows: a check's text, state and the start of its step in flight, as session user options.
+
+package reedengine
+
+import (
+	"fmt"
+	"strconv"
+	"time"
+)
+
+// SetCheckMark sets this session's check mark to text in state, its step in flight started at start, or clears the mark when text is empty.
+// A zero start clears the start alone, so the bar shows no seconds.
+// The mark is display only: nothing is persisted and it dies with the session.
+// A failure, a session that is not up among them, is returned for the caller to log.
+func (e *Engine) SetCheckMark(state, text string, start time.Time) error {
+	return e.withOpLock(func() error {
+		if err := e.requireSessionLocked(); err != nil {
+			return err
+		}
+		target := exactSessionWindowTarget(e.SessionName())
+
+		if text == "" {
+			for _, option := range []string{checkMarkOption, checkMarkStateOption, checkMarkStartOption} {
+				if err := e.tmux.run("set-option", "-u", "-t", target, option); err != nil {
+					return fmt.Errorf("clear check mark: %w", err)
+				}
+			}
+			return nil
+		}
+		argvs := [][]string{
+			{"set-option", "-t", target, checkMarkOption, text},
+			{"set-option", "-t", target, checkMarkStateOption, state},
+			{"set-option", "-u", "-t", target, checkMarkStartOption},
+		}
+		if !start.IsZero() {
+			argvs[2] = []string{"set-option", "-t", target, checkMarkStartOption, strconv.FormatInt(start.Unix(), 10)}
+		}
+		for _, argv := range argvs {
+			if err := e.tmux.run(argv...); err != nil {
+				return fmt.Errorf("set check mark: %w", err)
+			}
+		}
+		return nil
+	})
+}
diff --git a/internal/reedengine/checkmark_test.go b/internal/reedengine/checkmark_test.go
new file mode 100644
index 00000000..c533f67d
--- /dev/null
+++ b/internal/reedengine/checkmark_test.go
@@ -0,0 +1,75 @@
+//go:build tier0
+
+// checkmark_test.go pins the tmux argument lists SetCheckMark issues on the engine's session.
+
+package reedengine
+
+import (
+	"reflect"
+	"testing"
+	"time"
+)
+
+// TestSetCheckMark pins the exact set-option calls of a mark with a start, a mark without one, and a clear.
+func TestSetCheckMark(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name  string
+		state string
+		text  string
+		start time.Time
+		want  func(target string) [][]string
+	}{
+		{
+			name:  "a mark with a start sets the text, the state and the start in epoch seconds",
+			state: "running",
+			text:  "adopt check: tier1",
+			start: time.Unix(1787000000, 0),
+			want: func(target string) [][]string {
+				return [][]string{
+					{"set-option", "-t", target, "@lym_check", "adopt check: tier1"},
+					{"set-option", "-t", target, "@lym_check_state", "running"},
+					{"set-option", "-t", target, "@lym_check_start", "1787000000"},
+				}
+			},
+		},
+		{
+			name:  "a mark without a start unsets the start",
+			state: "green",
+			text:  "adopt check green: tier0 40s",
+			want: func(target string) [][]string {
+				return [][]string{
+					{"set-option", "-t", target, "@lym_check", "adopt check green: tier0 40s"},
+					{"set-option", "-t", target, "@lym_check_state", "green"},
+					{"set-option", "-u", "-t", target, "@lym_check_start"},
+				}
+			},
+		},
+		{
+			name: "an empty text unsets all three options",
+			want: func(target string) [][]string {
+				return [][]string{
+					{"set-option", "-u", "-t", target, "@lym_check"},
+					{"set-option", "-u", "-t", target, "@lym_check_state"},
+					{"set-option", "-u", "-t", target, "@lym_check_start"},
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			e := newTestEngine(t)
+			fake := installFakeTmux(t, e)
+
+			if err := e.SetCheckMark(tt.state, tt.text, tt.start); err != nil {
+				t.Fatalf("SetCheckMark: %v", err)
+			}
+			want := tt.want(exactSessionWindowTarget(e.SessionName()))
+			if got := fake.ArgvFor("set-option"); !reflect.DeepEqual(got, want) {
+				t.Errorf("set-option calls = %v; want %v", got, want)
+			}
+		})
+	}
+}
