+// accountkeeper_test.go tests the Claude engine's pick of a new worktree's account.
+
+package claudeengine
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestClaude_PickAccount pins when a pick writes, what it writes and what it leaves alone.
+func TestClaude_PickAccount(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	clock := time.Unix(2_000_000, 0)
+	earlier, later := clock.Add(-time.Hour), clock.Add(time.Hour)
+	// withPins is a machine-layer claude.yaml of the accounts a and b under the given weights and pins.
+	withPins := func(weightA, weightB int, pins string) func(root string) string {
+		return func(root string) string {
+			return fmt.Sprintf("accounts:\n  - {name: a, config_dir: %s, weight: %d}\n  - {name: b, config_dir: %s, weight: %d}\n%s",
+				filepath.Join(root, "a"), weightA, filepath.Join(root, "b"), weightB, pins)
+		}
+	}
+	both := withPins(1, 1, "")
+	task := shuttleengine.Worktree{Name: "t", Kind: shuttleengine.WorktreeTask}
+	listedAB := func(counts map[string]float64) accountFile {
+		return accountFile{Listed: []string{"a", "b"}, Weights: map[string]int{"a": 1, "b": 1}, Counts: counts}
+	}
+
+	type pickRow struct {
+		name     string
+		machine  func(root string) string
+		worktree shuttleengine.Worktree
+		// namesErr is what the hub's worktree names call fails with.
+		namesErr  error
+		file      accountFile
+		now       time.Time
+		keepEntry bool
+		// namesUnderLock makes the names call fail the test unless the account file's lock is held while it runs.
+		namesUnderLock bool
+		// noLogin leaves the accounts without credentials files.
+		noLogin bool
+		wantErr bool
+		// check judges the account file after the pick; a nil check demands that no file was written.
+		check func(t *testing.T, file accountFile)
+	}
+	tests := []pickRow{
+		{name: "OneAccountOfPositiveWeightWritesNothing", machine: withPins(1, 0, ""), worktree: task},
+		{name: "ThePrimeWritesNothing", machine: both, worktree: shuttleengine.Worktree{Name: "prime", Kind: shuttleengine.WorktreePrime}},
+		{name: "AHubPinWritesNothing", machine: withPins(1, 1, "account_pins:\n  hub: a\n"), worktree: task},
+		{name: "ABeamUnderABeamsPinWritesNothing", machine: withPins(1, 1, "account_pins:\n  beams: a\n"), worktree: shuttleengine.Worktree{Name: "t", Kind: shuttleengine.WorktreeBeam}},
+		{
+			name: "ATaskWorktreeGetsAnEntryAndItsAccountsCountRisesByOne", machine: both, worktree: task, now: clock,
+			check: func(t *testing.T, file accountFile) {
+				account := file.Worktrees["t"]
+				if (account != "a" && account != "b") || file.Counts[account] != 1 || file.Counts["a"]+file.Counts["b"] != 1 || !file.Picked["t"].Equal(clock) {
+					t.Errorf("account file = %+v; want an entry for t on a or b, its count 1, and Picked t at %v", file, clock)
+				}
+			},
+		},
+		{
+			name: "ATaskUnderABeamsPinIsPicked", machine: withPins(1, 1, "account_pins:\n  beams: a\n"), worktree: task, now: clock,
+			check: func(t *testing.T, file accountFile) {
+				if file.Worktrees["t"] == "" {
+					t.Errorf("account file = %+v; want an entry for the task, which a beams pin does not cover", file)
+				}
+			},
+		},
+		{
+			name: "AnEntryOfAWorktreeTheHubLacksIsDroppedAndOneItHoldsIsKept", machine: both, worktree: task, now: clock,
+			file: accountFile{Worktrees: map[string]string{"gone": "a", "other": "b"}, Picked: map[string]time.Time{"gone": earlier, "other": earlier}},
+			check: func(t *testing.T, file accountFile) {
+				want := map[string]string{"other": "b"}
+				delete(file.Worktrees, "t")
+				if !reflect.DeepEqual(file.Worktrees, want) {
+					t.Errorf("entries besides t's = %v; want %v", file.Worktrees, want)
+				}
+			},
+		},
+		{
+			name: "APickOverAnExistingEntryReplacesIt", machine: both, worktree: task, now: clock,
+			file: accountFile{
+				Worktrees: map[string]string{"t": "a"}, Picked: map[string]time.Time{"t": earlier},
+				Listed: []string{"a", "b"}, Weights: map[string]int{"a": 1, "b": 1}, Counts: map[string]float64{"a": 5, "b": 0},
+			},
+			check: func(t *testing.T, file accountFile) {
+				if file.Worktrees["t"] != "b" || file.Counts["b"] != 1 || !file.Picked["t"].Equal(clock) {
+					t.Errorf("account file = %+v; want t moved onto b, whose count rose to 1, picked at %v", file, clock)
+				}
+			},
+		},
+		{
+			name: "APickNotedBeforeAnEarlierPicksWriteKeepsItsEntryAndAddsNoCount", machine: both, worktree: task, now: clock,
+			file: accountFile{
+				Worktrees: map[string]string{"t": "a"}, Picked: map[string]time.Time{"t": later},
+				Listed: []string{"a", "b"}, Weights: map[string]int{"a": 1, "b": 1}, Counts: map[string]float64{"a": 7},
+			},
+			check: func(t *testing.T, file accountFile) {
+				if file.Worktrees["t"] != "a" || !reflect.DeepEqual(file.Counts, map[string]float64{"a": 7}) || !file.Picked["t"].Equal(later) {
+					t.Errorf("account file = %+v; want the earlier pick's entry, count and time unchanged", file)
+				}
+			},
+		},
+		{name: "AFailedNamesCallWritesNothing", machine: both, worktree: task, namesErr: errors.New("git worktree list failed"), wantErr: true},
+		{
+			name: "TheHubsWorktreeNamesAreReadUnderTheAccountFilesLock", machine: both, worktree: task, now: clock, namesUnderLock: true,
+			check: func(t *testing.T, file accountFile) {
+				if file.Worktrees["t"] == "" {
+					t.Errorf("account file = %+v; want an entry for t", file)
+				}
+			},
+		},
+		{
+			name: "WithKeepEntryAnEntryStaysAndAddsNoCount", machine: both, worktree: task, now: clock, keepEntry: true,
+			file: accountFile{Worktrees: map[string]string{"t": "a"}, Picked: map[string]time.Time{"t": earlier}, Counts: map[string]float64{"a": 7}},
+			check: func(t *testing.T, file accountFile) {
+				if file.Worktrees["t"] != "a" || !reflect.DeepEqual(file.Counts, map[string]float64{"a": 7}) {
+					t.Errorf("account file = %+v; want t kept on a with the counts unchanged", file)
+				}
+			},
+		},
+		{
+			name: "WithKeepEntryAWorktreeWithoutAnEntryIsPicked", machine: both, worktree: task, now: clock, keepEntry: true,
+			file: listedAB(map[string]float64{"a": 2, "b": 0}),
+			check: func(t *testing.T, file accountFile) {
+				if file.Worktrees["t"] != "b" || file.Counts["b"] != 1 {
+					t.Errorf("account file = %+v; want t picked onto b", file)
+				}
+			},
+		},
+	}
+	if runtime.GOOS != "darwin" {
+		tests = append(tests, pickRow{
+			name: "NoLoggedInCandidateRemovesTheEntry", machine: both, worktree: task, now: clock, noLogin: true,
+			file: accountFile{Worktrees: map[string]string{"t": "a"}, Picked: map[string]time.Time{"t": earlier}},
+			check: func(t *testing.T, file accountFile) {
+				if _, held := file.Worktrees["t"]; held || len(file.Counts) != 0 {
+					t.Errorf("account file = %+v; want no entry for t and no count", file)
+				}
+			},
+		})
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			root, board, anchor, accountDir := t.TempDir(), t.TempDir(), t.TempDir(), t.TempDir()
+			for _, name := range []string{"a", "b"} {
+				if err := os.MkdirAll(filepath.Join(root, name), 0o755); err != nil {
+					t.Fatalf("create the config directory of %s: %v", name, err)
+				}
+				if !tt.noLogin {
+					if err := os.WriteFile(filepath.Join(root, name, credentialsFileName), nil, 0o600); err != nil {
+						t.Fatalf("write the credentials file of %s: %v", name, err)
+					}
+				}
+			}
+			writeClaudeLayer(t, configengine.ConfigFile(board, "claude"), ConfigTemplate())
+			writeClaudeLayer(t, configengine.MachineFile(board, "claude"), tt.machine(root))
+
+			worktree := tt.worktree
+			worktree.AccountDir = accountDir
+			worktree.Names = func() ([]string, error) {
+				if tt.namesUnderLock {
+					probe, acquired, err := lock.TryAcquireWriteLock(lockPathOf(accountFilePath(accountDir)))
+					switch {
+					case err != nil:
+						t.Errorf("probe the account file's lock: %v", err)
+					case acquired:
+						_ = probe.Release()
+						t.Error("the account file's lock was free while the hub's worktree names were read; want it held")
+					}
+				}
+				return []string{"prime", "t", "other"}, tt.namesErr
+			}
+			engine := NewForWorktree(shuttleengine.Config{}, configengine.Dirs{Board: board, Anchor: anchor}, worktree)
+			engine.now = func() time.Time { return tt.now }
+			if !reflect.DeepEqual(tt.file, accountFile{}) {
+				if err := updateAccountFile(accountDir, func(accountFile) (accountFile, error) { return tt.file, nil }); err != nil {
+					t.Fatalf("seed the account file: %v", err)
+				}
+			}
+
+			err := engine.PickAccount(tt.keepEntry)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("PickAccount(%v) = %v; want error %v", tt.keepEntry, err, tt.wantErr)
+			}
+			file, readErr := readAccountFile(accountDir)
+			if readErr != nil {
+				t.Fatalf("read the account file: %v", readErr)
+			}
+			if tt.check == nil {
+				if !reflect.DeepEqual(file, tt.file) {
+					t.Errorf("account file = %+v; want it as it was, %+v", file, tt.file)
+				}
+				return
+			}
+			tt.check(t, file)
+		})
+	}
+}
diff --git a/internal/shuttleengine/claudeengine/accountpick.go b/internal/shuttleengine/claudeengine/accountpick.go
new file mode 100644
index 00000000..4c09fd8a
--- /dev/null
+++ b/internal/shuttleengine/claudeengine/accountpick.go
@@ -0,0 +1,221 @@
+// accountpick.go holds the rules that pick an account for a worktree and resolve the account a worktree runs under.
+// They are pure functions over the account list, the account file and the usage records.
+
+package claudeengine
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// credentialsFileName is the file a logged-in Claude account's config directory holds.
+const credentialsFileName = ".credentials.json"
+
+// hasHeadroom reports whether account may take a new worktree at now.
+// It has none while usage says a usage limit blocks it.
+// Otherwise it has headroom when every window the account lists has no reading, a reset that has passed,
+// or a percentage below the account's threshold for it.
+// A window the account does not list is ignored.
+func hasHeadroom(account AccountConfig, usage usageRecord, now time.Time) bool {
+	return len(blockingResets(account, usage, now)) == 0
+}
+
+// blockingResets returns the times at which each reason the account lacks headroom ends.
+// A reason is a limit block or a listed window at or above its threshold.
+// A limit block ends at BlockedUntil, and a window ends at its reset.
+// The result is empty exactly when the account has headroom.
+func blockingResets(account AccountConfig, usage usageRecord, now time.Time) []time.Time {
+	var resets []time.Time
+	if usage.BlockedUntil.After(now) {
+		resets = append(resets, usage.BlockedUntil)
+	}
+	for window, threshold := range account.Windows {
+		reading, ok := usage.Windows[window]
+		if !ok {
+			continue
+		}
+		reset := time.Unix(reading.ResetsAt, 0)
+		if reset.After(now) && reading.UsedPercentage >= float64(threshold) {
+			resets = append(resets, reset)
+		}
+	}
+	return resets
+}
+
+// loggedIn reports whether account holds a login on the platform goos names.
+// On darwin the login is in the keychain, which a stat cannot see, so every account counts.
+// Elsewhere the account's config directory holds a credentials file, which the check stats and never reads.
+func loggedIn(goos string, account AccountConfig) bool {
+	if goos == "darwin" {
+		return true
+	}
+	_, err := os.Stat(filepath.Join(account.ConfigDir, credentialsFileName))
+	return err == nil
+}
+
+// pickRequest is what one pick decides over.
+type pickRequest struct {
+	// accounts is the configured account list, in list order.
+	accounts []AccountConfig
+	// usage maps an account name to its usage record; a name it lacks has no reading.
+	usage map[string]usageRecord
+	// loggedIn reports whether an account holds a login.
+	loggedIn func(AccountConfig) bool
+	// exclude names an account the pick never takes, empty for none.
+	exclude string
+	// fallback lets a pick with no account of headroom take the account whose block ends first.
+	fallback bool
+	// now is the time headroom is judged at.
+	now time.Time
+}
+
+// pickAccount picks the account a worktree runs under, over file's counters.
+// It returns the file with its counters updated for the pick, the taken account's name and true.
+// When no account can be taken it returns file unchanged, the empty name and false.
+// It leaves Worktrees and Picked to its caller.
+//
+// An account of positive weight that is new to the counters, or whose weight changed, starts at a reset count.
+// That count is the lowest count over weight among the accounts listed and unchanged, times its own weight.
+// With none unchanged it starts at 0.
+// The candidates are the logged-in accounts of positive weight but the excluded one.
+// Among the candidates with headroom it takes the lowest count over weight, a tie going to the earlier list entry.
+// With none having headroom and the fallback on, it takes the candidate whose latest blocking reset is earliest.
+// A tie there also goes to the earlier list entry.
+func pickAccount(file accountFile, req pickRequest) (accountFile, string, bool) {
+	counts := resetCounts(file, req.accounts)
+
+	var candidates []AccountConfig
+	for _, account := range req.accounts {
+		if account.Weight > 0 && account.Name != req.exclude && req.loggedIn(account) {
+			candidates = append(candidates, account)
+		}
+	}
+	if len(candidates) == 0 {
+		return file, "", false
+	}
+
+	var eligible []AccountConfig
+	for _, account := range candidates {
+		if hasHeadroom(account, req.usage[account.Name], req.now) {
+			eligible = append(eligible, account)
+		}
+	}
+	var taken AccountConfig
+	switch {
+	case len(eligible) > 0:
+		taken = lowestLoad(eligible, counts)
+	case req.fallback:
+		taken = earliestUnblocked(candidates, req.usage, req.now)
+	default:
+		return file, "", false
+	}
+
+	counts[taken.Name]++
+	picked := file
+	picked.Counts = counts
+	picked.Weights = make(map[string]int, len(req.accounts))
+	picked.Listed = make([]string, 0, len(req.accounts))
+	for _, account := range req.accounts {
+		picked.Weights[account.Name] = account.Weight
+		picked.Listed = append(picked.Listed, account.Name)
+	}
+	return picked, taken.Name, true
+}
+
+// resetCounts returns the counters of every positive-weight account of accounts.
+// An account listed in file under its current weight keeps its count.
+// A new or reweighted one starts at the lowest count over weight among the kept accounts, times its weight.
+func resetCounts(file accountFile, accounts []AccountConfig) map[string]float64 {
+	counts := make(map[string]float64, len(accounts))
+	kept := func(account AccountConfig) bool {
+		weight, weighed := file.Weights[account.Name]
+		return slices.Contains(file.Listed, account.Name) && weighed && weight == account.Weight
+	}
+	lowest, anyKept := 0.0, false
+	for _, account := range accounts {
+		if account.Weight <= 0 || !kept(account) {
+			continue
+		}
+		counts[account.Name] = file.Counts[account.Name]
+		if load := counts[account.Name] / float64(account.Weight); !anyKept || load < lowest {
+			lowest, anyKept = load, true
+		}
+	}
+	for _, account := range accounts {
+		if account.Weight > 0 && !kept(account) {
+			counts[account.Name] = lowest * float64(account.Weight)
+		}
+	}
+	return counts
+}
+
+// lowestLoad returns the account of candidates with the lowest count over weight, a tie going to the earlier entry.
+// candidates is not empty and holds only positive weights.
+func lowestLoad(candidates []AccountConfig, counts map[string]float64) AccountConfig {
+	best := candidates[0]
+	for _, account := range candidates[1:] {
+		if counts[account.Name]/float64(account.Weight) < counts[best.Name]/float64(best.Weight) {
+			best = account
+		}
+	}
+	return best
+}
+
+// earliestUnblocked returns the account of candidates whose latest blocking reset is earliest.
+// A tie goes to the earlier entry.
+// candidates is not empty and holds only accounts without headroom.
+func earliestUnblocked(candidates []AccountConfig, usage map[string]usageRecord, now time.Time) AccountConfig {
+	latest := func(account AccountConfig) time.Time {
+		var last time.Time
+		for _, reset := range blockingResets(account, usage[account.Name], now) {
+			if reset.After(last) {
+				last = reset
+			}
+		}
+		return last
+	}
+	best := candidates[0]
+	for _, account := range candidates[1:] {
+		if latest(account).Before(latest(best)) {
+			best = account
+		}
+	}
+	return best
+}
+
+// resolveAccount returns the account a launch in worktree runs under, and whether it runs under one.
+// A hub pin wins and is never skipped.
+// For a prime or beam worktree the beams pin comes next.
+// It yields when its account is blocked at now and the worktree has an entry.
+// Then comes the worktree's own entry in file.
+// An entry naming an account the list lacks, or a retired one, counts as none.
+// A zero worktree reaches only the hub pin.
+func resolveAccount(claude Config, worktree shuttleengine.Worktree, file accountFile, usage map[string]usageRecord, now time.Time) (AccountConfig, bool) {
+	listed := func(name string) (AccountConfig, bool) {
+		index := slices.IndexFunc(claude.Accounts, func(account AccountConfig) bool { return account.Name == name })
+		if index < 0 || claude.Accounts[index].retired() {
+			return AccountConfig{}, false
+		}
+		return claude.Accounts[index], true
+	}
+
+	if claude.AccountPins.Hub != "" {
+		return listed(claude.AccountPins.Hub)
+	}
+	if worktree.Name == "" {
+		return AccountConfig{}, false
+	}
+	entry, hasEntry := listed(file.Worktrees[worktree.Name])
+	beamsPinned := claude.AccountPins.Beams != "" && (worktree.Kind == shuttleengine.WorktreePrime || worktree.Kind == shuttleengine.WorktreeBeam)
+	if beamsPinned {
+		pinned, ok := listed(claude.AccountPins.Beams)
+		if ok && !(hasEntry && usage[pinned.Name].BlockedUntil.After(now)) {
+			return pinned, true
+		}
+	}
+	return entry, hasEntry
+}
