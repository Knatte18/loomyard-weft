+				return filepath.Join(root, "repo", "gone"), nil
+			},
+			wantErrIs: fs.ErrNotExist,
+		},
+		{
+			name: "a directory in no repository is ErrNotRepository",
+			build: func(t *testing.T, root string) (string, []Worktree) {
+				mkdirs(t, filepath.Join(root, "plain"))
