-
-import (
-	_ "embed"
-	"time"
-)
-
-//go:embed banner.txt
-var banner string
-
-// Allowed is decided by admin alone whenever owner is false.
-func Allowed(admin, owner bool) bool {
-	return admin || owner
-}
-
-// Both is decided by active alone whenever admin is true.
-func Both(admin, active bool) bool {
-	return admin && active
-}
-
-func Banner() string {
-	return banner
-}
-
-func Classify(n int) string {
-	if n < 0 {
-		return "negative"
-	}
-	return "non-negative"
-}
-
-func Double(n int) int {
-	return n * 2
-}
-
-func Timeout() time.Duration {
-	return time.Duration(5 * float64(time.Second))
-}
-
-func Tally(n int) int {
-	steps := 0
-	for n > 0 {
-		n -= 1
-		steps += 1
-	}
-	return steps
-}
-
-const hoardStop = 384
-
-func Hoard(n int) int {
-	var kept [][]byte
-	for i := 1; i <= n; i++ {
-		if len(kept) == hoardStop {
-			panic("Hoard kept hoardStop megabytes: no memory cap ended the run")
-		}
-		block := make([]byte, 1<<20)
-		for at := range block {
-			block[at] = 1
-		}
-		kept = append(kept, block)
-	}
-	return len(kept)
-}
