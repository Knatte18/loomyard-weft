+func orphanedMasterRefusal(caller, scratchDir, verb string) (refusal string, runEnded bool) {
+	name, err := agentname.Parse(caller)
+	if err != nil || !agentname.MatchesRole(name.Role, websterengine.MerriamStrandRole) {
