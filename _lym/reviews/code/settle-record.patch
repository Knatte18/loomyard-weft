+// executor_test.go tests the executor loop and its error classes.
+// It is in package fabricengine because the loop is unexported and no verb drives it.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"testing"
