+func TestShellGuardDenies_PythonRowAsksTheHubOnAMatch(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		command string
+		// lymExit is the stub's exit code; empty leaves no lym at the path the row is rendered over.
