+	}
+	recipe, err := shedrun.ReadChildRecipe(location, slug)
+	if err != nil {
+		return false, fmt.Errorf("battencli: read the child recipe of %s: %w", slug, err)
+	}
+	if recipe != shedrun.RecipeMotif {
+		return false, nil
+	}
