+  for (i = 1; i <= n; i++) { line = "| " K[i] " |"; for (j = 1; j <= ng; j++) line = line " " f1(t_n[G[j], K[i]] / members[G[j]]) "; " f1(t_sec[G[j], K[i]] / members[G[j]]) " |"; print line }
+
+  print "\n## Tool latency, every picked run: median milliseconds per call\n"
