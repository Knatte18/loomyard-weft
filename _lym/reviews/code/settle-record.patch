+				if info, err := os.Stat(path); err != nil || info.Mode().Perm() != 0o600 {
+					t.Errorf("Stat(%s) = %v, %v; want mode 0600", path, info, err)
+				}
+			}
+		}
+		if live, err := Live(paths); !live || err != nil {
