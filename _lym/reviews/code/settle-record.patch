new file mode 100644
index 00000000..ccffac35
--- /dev/null
+++ b/internal/loomcli/projectrecord_integration_test.go
@@ -0,0 +1,166 @@
+//go:build tier1
+
+// projectrecord_integration_test.go drives the beam-side decision seams and the project record commit over a hub forged by hubforge.
+// This package's own testmain_test.go arms the hermetic git test environment for the whole binary,
+// so this file adds no TestMain.
+
+package loomcli
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+)
+
+const (
+	testBeam  = "the-beam"
+	testShort = "tst"
+)
+
+// beamHub forges a hub holding the beam pair testBeam, a member entry whose pair was forked from the beam, a member entry with no pair and a pair forked from the beam that the board does not list, and returns the hub with a location for each worktree name.
+func beamHub(t *testing.T) (hub *hubforge.Hub, location func(name string) *lymcwd.Location) {
+	t.Helper()
+	hub = hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	hubforge.AddPair(t, hub, testBeam)
+	hubforge.AddPairWith(t, hub, "member-with-pair", fabricengine.AddOptions{Parent: testBeam})
+	hubforge.AddPairWith(t, hub, "forked-child", fabricengine.AddOptions{Parent: testBeam})
+
+	// A board write cannot make a beam, so the entries are written to the board file directly.
+	board := `{"version":1,"entries":[` +
+		`{"id":1,"slug":"` + testBeam + `","title":"Beam","kind":"project","labels":["bug"],"beam":true},` +
+		`{"id":2,"slug":"member-with-pair","title":"With pair","kind":"task","labels":["bug"],"project":"` + testBeam + `"},` +
+		`{"id":3,"slug":"member-no-pair","title":"No pair","kind":"task","labels":["bug"],"project":"` + testBeam + `"}]}`
+	if err := os.WriteFile(filepath.Join(hub.BoardDir(), "board.json"), []byte(board), 0o644); err != nil {
+		t.Fatalf("write board.json: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(hub.BoardDir(), fabricengine.ShortnameFileName), []byte(testShort+"\n"), 0o644); err != nil {
+		t.Fatalf("write the shortname record: %v", err)
+	}
+	location = func(name string) *lymcwd.Location {
+		t.Helper()
+		loc, err := lymcwd.ResolveWorktree(hub.PairCodeWorktree(name))
+		if err != nil {
+			t.Fatalf("ResolveWorktree(%s) error = %v; want nil", name, err)
+		}
+		return loc
+	}
+	return hub, location
+}
+
+func TestMemberPairs_ReturnsEveryLocalPairUnderTheBeam(t *testing.T) {
+	t.Parallel()
+	_, location := beamHub(t)
+
+	pairs, err := memberPairs(location(testBeam), testBeam)
+	if err != nil {
+		t.Fatalf("memberPairs(%s) error = %v; want nil", testBeam, err)
+	}
+	var got []string
+	for _, pair := range pairs {
+		got = append(got, pair.WorktreeName)
+	}
+	slices.Sort(got)
+	if want := []string{"forked-child", "member-with-pair"}; !slices.Equal(got, want) {
+		t.Errorf("memberPairs(%s) = %v; want %v, the member with a pair and the forked pair, and not the member with no pair", testBeam, got, want)
+	}
+}
+
+func TestDecisionReceivers_ReachABeamsMemberPairs(t *testing.T) {
+	t.Parallel()
+	_, location := beamHub(t)
+	beam := location(testBeam)
+	strandsOf := func(worktree *lymcwd.Location) ([]string, error) {
+		return []string{"strand-of-" + worktree.WorktreeName}, nil
+	}
+
+	tests := []struct {
+		name   string
+		record runRecord
+		want   []string
+	}{
+		{"AProjectRecordReachesTheBeamAndEveryMemberPair", runRecord{project: true}, []string{"strand-of-forked-child", "strand-of-member-with-pair", "strand-of-" + testBeam}},
+		{"ADiscussionRecordReachesOnlyTheTargetsOwnRuns", runRecord{}, []string{"strand-of-" + testBeam}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := decisionReceivers(beam, tt.record, strandsOf)
+			if err != nil {
+				t.Fatalf("decisionReceivers() error = %v; want nil", err)
+			}
+			slices.Sort(got)
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("decisionReceivers() = %v; want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestDecisionParent_ABeamsRecordIsItsOwnOrchs(t *testing.T) {
+	t.Parallel()
+	_, location := beamHub(t)
+	beam := location(testBeam)
+	beamOrch, err := agentname.Format(testShort, testBeam, agentname.RoleOrch)
+	if err != nil {
+		t.Fatalf("Format() error = %v; want nil", err)
+	}
+
+	t.Run("TheBeamsOwnLiveOrchIsTheParent", func(t *testing.T) {
+		t.Parallel()
+		got, err := decisionParent(beam, runRecord{project: true}, func(*lymcwd.Location) (bool, error) { return true, nil })
+		if err != nil || got.Name != beamOrch {
+			t.Errorf("decisionParent() = %q, %v; want the beam's own orch %q", got.Name, err, beamOrch)
+		}
+	})
+
+	t.Run("AHubWithNoShortnameIsRefusedNamingTheWayForward", func(t *testing.T) {
+		t.Parallel()
+		bareHub, bare := beamHub(t)
+		if err := os.Remove(filepath.Join(bareHub.BoardDir(), fabricengine.ShortnameFileName)); err != nil {
+			t.Fatalf("remove the shortname record: %v", err)
+		}
+		_, err := decisionParent(bare(testBeam), runRecord{project: true}, func(*lymcwd.Location) (bool, error) { return true, nil })
+		if err == nil || !strings.Contains(err.Error(), "lym fabric shortname") {
+			t.Errorf("decisionParent() error = %v; want a refusal naming `lym fabric shortname`", err)
+		}
+	})
+}
+
+// TestCommitRunRecord_ProjectRecordCommitsItsDirectory pins that a project record commit stages the project directory, whose record then reads back from HEAD, and not the discussion directory.
+func TestCommitRunRecord_ProjectRecordCommitsItsDirectory(t *testing.T) {
+	t.Parallel()
+	_, location := beamHub(t)
+	beam := location(testBeam)
+	record := runRecordOf(beam, "pawl")
+	if !record.project {
+		t.Fatalf("runRecordOf(%s, pawl).project = false; want a project record", testBeam)
+	}
+	for path, content := range map[string]string{record.path: "## Goal\n", loomengine.DiscussionDecisionRecord(beam): "# discussion\n"} {
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatalf("MkdirAll(%s) error = %v; want nil", filepath.Dir(path), err)
+		}
+		if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+			t.Fatalf("WriteFile(%s) error = %v; want nil", path, err)
+		}
+	}
+
+	if err := commitRunRecord(beam, record); err != nil {
+		t.Fatalf("commitRunRecord() error = %v; want nil", err)
+	}
+
+	got, found, err := fabricengine.CommittedAnchoredFile(beam, record.rel)
+	if err != nil || !found || string(got) != "## Goal\n" {
+		t.Errorf("CommittedAnchoredFile(%s) = %q, %v, %v; want the project record committed", record.rel, got, found, err)
+	}
+	if _, found, err := fabricengine.CommittedAnchoredFile(beam, loomengine.DiscussionDecisionRecordRel()); err != nil || found {
+		t.Errorf("CommittedAnchoredFile(discussion record) found = %v, %v; want the discussion record left uncommitted", found, err)
+	}
+}
diff --git a/internal/loomcli/projectrecord_test.go b/internal/loomcli/projectrecord_test.go
new file mode 100644
index 00000000..f142b4b6
--- /dev/null
+++ b/internal/loomcli/projectrecord_test.go
@@ -0,0 +1,178 @@
+//go:build tier0
+
+// projectrecord_test.go covers where a run's decision record lives by its recipe, and the project records a member's run reads from the beams above its pair.
+
+package loomcli
+
+import (
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/stencilkit"
+)
+
+func TestRunRecordOf(t *testing.T) {
+	t.Parallel()
+	location := &lymcwd.Location{HubPath: filepath.Join("hub"), WorktreeName: "a-beam", AnchorRel: "."}
+
+	tests := []struct {
+		recipe      string
+		wantPath    string
+		wantRel     string
+		wantProject bool
+		// wantUnderLym is the record path inside _lym that the restore and differs ways forward name.
+		wantUnderLym string
+	}{
+		{shedrun.RecipePawl, loomengine.ProjectDecisionRecord(location, "a-beam"), loomengine.ProjectDecisionRecordRel("a-beam"), true, "project/a-beam/decision-record.md"},
+		{shedrun.RecipeDarn, loomengine.DiscussionDecisionRecord(location), loomengine.DiscussionDecisionRecordRel(), false, "discussion/decision-record.md"},
+		{shedrun.RecipeTapestry, loomengine.DiscussionDecisionRecord(location), loomengine.DiscussionDecisionRecordRel(), false, "discussion/decision-record.md"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.recipe, func(t *testing.T) {
+			t.Parallel()
+			got := runRecordOf(location, tt.recipe)
+			if got.path != tt.wantPath || got.rel != tt.wantRel || got.project != tt.wantProject {
+				t.Errorf("runRecordOf(%s) = %q, %q, project %v; want %q, %q, project %v", tt.recipe, got.path, got.rel, got.project, tt.wantPath, tt.wantRel, tt.wantProject)
+			}
+			if filepath.Dir(got.path) != got.dir || filepath.Dir(got.supportLog) != got.dir {
+				t.Errorf("runRecordOf(%s) record %q and support log %q; want both in %q", tt.recipe, got.path, got.supportLog, got.dir)
+			}
+			underLym, err := filepath.Rel(lymdirs.LymDirName, got.rel)
+			if err != nil || filepath.ToSlash(underLym) != tt.wantUnderLym {
+				t.Errorf("runRecordOf(%s) record %q inside _lym = %q, %v; want %q", tt.recipe, got.rel, underLym, err, tt.wantUnderLym)
+			}
+		})
+	}
+}
+
+// TestProjectRecordPaths pins that a member reads the record of every beam above it, nearest first, from each beam's own worktree, and skips a beam whose record is absent.
+func TestProjectRecordPaths(t *testing.T) {
+	t.Parallel()
+	hub := t.TempDir()
+	writeBeamBoard(t, hub)
+	record := writeBeamRecords(t, hub, "outer", "inner")
+
+	tests := []struct {
+		name     string
+		worktree string
+		want     []string
+	}{
+		{name: "AMemberReadsEveryBeamAboveItNearestFirst", worktree: "member", want: []string{record("inner"), record("outer")}},
+		{name: "ANestedBeamReadsTheBeamAboveIt", worktree: "inner", want: []string{record("outer")}},
+		{name: "AnEntryUnderNoBeamReadsNone", worktree: "loose"},
+		{name: "AnEntryTheBoardLacksReadsNone", worktree: "nobody"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := projectRecordPaths(&lymcwd.Location{HubPath: hub, WorktreeName: tt.worktree, AnchorRel: "."})
+			if err != nil {
+				t.Fatalf("projectRecordPaths(%s) error = %v; want nil", tt.worktree, err)
+			}
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("projectRecordPaths(%s) = %q; want %q", tt.worktree, got, tt.want)
+			}
+		})
+	}
+
+	t.Run("ABeamWithNoRecordIsLeftOut", func(t *testing.T) {
+		t.Parallel()
+		other := t.TempDir()
+		writeBeamBoard(t, other)
+		got, err := projectRecordPaths(&lymcwd.Location{HubPath: other, WorktreeName: "member", AnchorRel: "."})
+		if err != nil || len(got) != 0 {
+			t.Errorf("projectRecordPaths(member) with no records = %q, %v; want none, nil", got, err)
+		}
+	})
+}
+
+// writeBeamBoard writes a board holding two nested beams, a member of the inner beam and a task under no beam into hub.
+// A board write cannot make a beam, so the entries are written to the board file directly.
+func writeBeamBoard(t *testing.T, hub string) {
+	t.Helper()
+	board := `{"version":1,"entries":[` +
+		`{"id":1,"slug":"outer","title":"Outer","kind":"project","labels":["bug"],"beam":true},` +
+		`{"id":2,"slug":"inner","title":"Inner","kind":"project","labels":["bug"],"beam":true,"project":"outer"},` +
+		`{"id":3,"slug":"member","title":"Member","kind":"task","labels":["bug"],"project":"inner"},` +
+		`{"id":4,"slug":"loose","title":"Loose","kind":"task","labels":["bug"]}]}`
+	if err := os.MkdirAll(fabricengine.BoardDir(hub), 0o755); err != nil {
+		t.Fatalf("mkdir board: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(fabricengine.BoardDir(hub), "board.json"), []byte(board), 0o644); err != nil {
+		t.Fatalf("write board.json: %v", err)
+	}
+}
+
+// writeBeamRecords writes a project record into the worktree of each beam slug under hub and returns the lookup of a beam's record path.
+func writeBeamRecords(t *testing.T, hub string, slugs ...string) func(slug string) string {
+	t.Helper()
+	record := func(slug string) string {
+		t.Helper()
+		beam, err := lymcwd.NamedWorktree(hub, slug)
+		if err != nil {
+			t.Fatalf("NamedWorktree(%s) error = %v", slug, err)
+		}
+		return loomengine.ProjectDecisionRecord(beam, slug)
+	}
+	for _, slug := range slugs {
+		path := record(slug)
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatalf("mkdir: %v", err)
+		}
+		if err := os.WriteFile(path, []byte("## Goal\n"), 0o644); err != nil {
+			t.Fatalf("write %s: %v", path, err)
+		}
+	}
+	return record
+}
+
+// TestWithProjectDirective pins that a member under a beam with a record gets a project directive naming that record, and a pair under no beam keeps the marker empty with every other table value untouched.
+func TestWithProjectDirective(t *testing.T) {
+	t.Parallel()
+	hub := t.TempDir()
+	writeBeamBoard(t, hub)
+	record := writeBeamRecords(t, hub, "inner")
+	stencilsDir := stencilkit.Seed(t)
+
+	tests := []struct {
+		name     string
+		worktree string
+		// wantRecord is the record path the directive must name, empty for a directive that must be empty.
+		wantRecord string
+	}{
+		{name: "AMemberUnderABeamWithARecordGetsADirectiveNamingIt", worktree: "member", wantRecord: record("inner")},
+		{name: "APairUnderNoBeamKeepsTheMarkerEmpty", worktree: "loose"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			table := seatengine.Table{Values: map[string]string{"slug": tt.worktree}, Optional: []string{loomengine.ProjectDirectiveMarker}}
+			got, err := withProjectDirective(table, &lymcwd.Location{HubPath: hub, WorktreeName: tt.worktree, AnchorRel: "."}, stencilsDir)
+			if err != nil {
+				t.Fatalf("withProjectDirective(%s) error = %v; want nil", tt.worktree, err)
+			}
+			directive := got.Values[loomengine.ProjectDirectiveMarker]
+			if tt.wantRecord == "" {
+				if directive != "" {
+					t.Errorf("withProjectDirective(%s) directive = %q; want empty", tt.worktree, directive)
+				}
+			} else if !strings.Contains(directive, tt.wantRecord) {
+				t.Errorf("withProjectDirective(%s) directive = %q; want one naming %q", tt.worktree, directive, tt.wantRecord)
+			}
+			want := map[string]string{"slug": tt.worktree, loomengine.ProjectDirectiveMarker: directive}
+			if !maps.Equal(got.Values, want) {
+				t.Errorf("withProjectDirective(%s) values = %v; want %v", tt.worktree, got.Values, want)
+			}
+		})
+	}
+}
diff --git a/internal/loomcli/review.go b/internal/loomcli/review.go
index 3a12ea0a..2f019141 100644
--- a/internal/loomcli/review.go
+++ b/internal/loomcli/review.go
@@ -56,7 +56,7 @@ func resolveReviewTarget(group, verb string, location *lymcwd.Location, slug str
 	}
 	recipe, err := d.seedRecipe(target)
