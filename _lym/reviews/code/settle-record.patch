-	logger.Info("gate test: spawning go env GOROOT", "dir", dir)
-	out, err := cmd.Output()
-	logger.Info("gate test: go env GOROOT exited", "dir", dir, "err", err)
-	if err != nil {
-		return "", fmt.Errorf("go env GOROOT: %w", err)
-	}
-	return strings.TrimSpace(string(out)), nil
-}
