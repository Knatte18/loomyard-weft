+      }
+    }
+  }
+
+  // Views.
+  function toggleGroup(title, group, names) {
+    if (names.length === 0) {
+      return null;
+    }
+    var buttons = names.map(function (name) {
+      return h('button', {
+        type: 'button',
+        text: name,
+        'aria-pressed': String(Boolean(group[name])),
+        on: { click: function () { group[name] = !group[name]; render(); } }
+      });
+    });
+    return h('div', { class: 'group' }, [h('span', { class: 'group-name', text: title })].concat(buttons));
+  }
+
+  function headerView() {
+    var view = state.view;
+    var mode = live ? 'live' : 'read-only';
+    var meta = 'Rendered ' + view.rendered + ' · prime owner ' + (view.prime_owner || 'none recorded') + ' · ' + mode;
+    var search = h('input', {
+      type: 'search',
+      placeholder: 'Search',
+      'aria-label': 'Search',
+      value: state.text,
+      'data-focuskey': 'search',
+      on: { input: function (event) { state.text = event.target.value; render(); } }
+    });
+    var bar = h('div', { class: 'bar' }, [
+      toggleGroup('kind', state.filters.kind, ['task', 'note']),
+      toggleGroup('type', state.filters.type, view.types),
+      toggleGroup('area', state.filters.area, view.areas),
+      search
+    ]);
+    var nodes = [h('h1', { text: 'Board' }), h('div', { class: 'muted', text: meta })];
+    if (state.error) {
+      nodes.push(h('div', { class: 'notice', text: state.error }));
+    }
+    nodes.push(bar);
+    if (live) {
+      nodes.push(h('div', { class: 'actions' }, [
+        h('button', {
+          type: 'button',
+          class: 'action',
+          text: state.creating ? 'Cancel new entry' : 'New entry',
+          on: { click: function () { state.creating = state.creating ? null : newCreateForm(); state.createMessage = ''; render(); } }
+        })
+      ]));
+    }
+    return h('header', {}, nodes);
+  }
+
+  function buildTree() {
+    var projects = state.view.projects;
+    var root = projects[0];
+    var nodes = {};
+    projects.forEach(function (project) {
+      nodes[project.handle] = { project: project, entries: [], children: [], total: 0 };
+    });
+    projects.slice(1).forEach(function (project) {
+      (nodes[project.parent] || nodes[root.handle]).children.push(nodes[project.handle]);
+    });
+    state.view.entries.filter(matches).forEach(function (entry) {
+      (nodes[entry.project] || nodes[root.handle]).entries.push(entry);
+    });
+    function count(node) {
+      node.total = node.entries.length + node.children.reduce(function (sum, child) { return sum + count(child); }, 0);
+      return node.total;
+    }
+    count(nodes[root.handle]);
+    return nodes[root.handle];
+  }
+
+  function sectionNames() {
+    var names = state.view.sections.slice();
+    state.view.entries.forEach(function (entry) {
+      if (names.indexOf(entry.section) < 0) {
+        names.push(entry.section);
+      }
+    });
+    return names;
+  }
+
+  function projectView(node, depth) {
+    if (node.total === 0) {
+      return null;
+    }
+    var project = node.project;
+    var block = h('section', { class: 'project' });
+    block.style.marginLeft = (depth * 1.25) + 'rem';
+    var headingNodes = [project.handle + ' ' + project.title];
+    if (project.design_file) {
+      headingNodes.push(' ');
+      headingNodes.push(h('a', { href: fileHref(project.design_file), text: 'design' }));
+    }
+    block.appendChild(h('h2', {}, headingNodes));
+    if (project.brief) {
+      block.appendChild(h('div', { class: 'project-brief muted', text: project.brief }));
+    }
+    sectionNames().forEach(function (name) {
+      var group = node.entries.filter(function (entry) { return entry.section === name; });
+      if (group.length === 0) {
+        return;
+      }
+      block.appendChild(h('h3', { text: name + ' (' + group.length + ')' }));
+      group.forEach(function (entry) { block.appendChild(entryView(entry)); });
+    });
+    return { block: block, node: node };
+  }
+
+  function projectsView(root) {
+    var container = h('div', {});
+    function add(node, depth) {
+      var built = projectView(node, depth);
+      if (!built) {
+        return;
+      }
+      container.appendChild(built.block);
+      node.children.forEach(function (child) { add(child, depth + 1); });
+    }
+    // The README lists every top-level project, then the root's own entries last.
+    root.children.forEach(function (child) { add(child, 0); });
+    var rootOwn = { project: root.project, entries: root.entries, children: [], total: root.entries.length };
+    add(rootOwn, 0);
+    return container;
+  }
+
+  function entryView(entry) {
+    var open = Boolean(state.expanded[entry.slug]);
+    var headParts = [
+      h('span', { class: 'handle', text: entry.handle }),
+      h('span', { class: 'title', text: entry.title })
+    ];
+    if (entry.status) {
+      headParts.push(h('span', { class: 'status', text: entry.status }));
+    }
+    entry.types.concat(entry.areas).forEach(function (label) {
+      headParts.push(h('span', { class: 'chip', text: label }));
+    });
+    var head = h('button', {
+      type: 'button',
+      class: 'entry-head',
+      'aria-expanded': String(open),
+      on: { click: function () { state.expanded[entry.slug] = !open; render(); } }
+    }, headParts);
+    var row = h('div', { class: 'entry' }, [head]);
+    if (open) {
+      row.appendChild(detailView(entry));
+    }
+    return row;
+  }
+
+  function factsText(entry) {
+    var parts = [entry.slug, entry.kind];
+    if (entry.owner) {
+      parts.push('owner ' + entry.owner);
+    }
+    if (entry.recipe) {
+      parts.push('recipe ' + entry.recipe);
+    }
+    if (entry.created) {
+      parts.push('created ' + ageText(entry.created) + ' ago');
+    }
+    if (entry.revised) {
+      parts.push('revised ' + ageText(entry.revised) + ' ago');
+    }
+    if (entry.waits_on.length > 0) {
+      parts.push('waits on ' + entry.waits_on.join(', '));
+    }
+    return parts.join(' · ');
+  }
+
+  function detailView(entry) {
+    var detail = h('div', { class: 'detail' });
+    if (entry.brief) {
+      detail.appendChild(h('div', { text: entry.brief }));
+    }
+    detail.appendChild(h('div', { class: 'facts', text: factsText(entry) }));
+    var links = [];
+    if (entry.design_file) {
+      links.push(h('a', { href: fileHref(entry.design_file), text: 'design' }));
+    }
+    if (entry.decision_file) {
+      links.push(h('a', { href: fileHref(entry.decision_file), text: 'decision record' }));
+    }
+    if (links.length > 0) {
+      var linkLine = h('div', { class: 'facts' });
+      links.forEach(function (link, index) {
+        if (index > 0) {
+          linkLine.appendChild(document.createTextNode(' · '));
+        }
+        linkLine.appendChild(link);
+      });
+      detail.appendChild(linkLine);
+    }
+    if (entry.body) {
+      var body = h('div', { class: 'body' });
+      body.innerHTML = markdownToHtml(entry.body);
+      detail.appendChild(body);
+    }
+    if (live) {
+      detail.appendChild(writeControls(entry));
+    }
+    return detail;
+  }
+
+  // Page writes.
+  function allowedActions(entry) {
+    if (entry.kind === 'note') {
+      return [['promote', 'Promote to task']];
+    }
+    if (entry.kind !== 'task') {
+      return [];
+    }
+    if (entry.status === '') {
+      return [['draft', 'Draft']];
+    }
+    if (entry.status === 'draft') {
+      return [['release', 'Release'], ['undraft', 'Undraft']];
+    }
+    return isRunStatus(entry.status) ? [] : [['release', 'Release']];
+  }
+
+  function fieldRow(form, formKey, name, label, multiline) {
+    var attributes = {
+      'data-focuskey': formKey + ':' + name,
+      value: form.values[name],
+      on: { input: function (event) { form.values[name] = event.target.value; } }
+    };
+    var control = multiline ? h('textarea', attributes) : h('input', Object.assign({ type: 'text' }, attributes));
+    return h('label', {}, [label, control]);
+  }
+
+  function projectSelect(form, formKey, withKeep) {
+    var options = [];
+    if (withKeep) {
+      options.push(h('option', { value: KEEP_PROJECT, text: '(unchanged)' }));
+    }
+    options.push(h('option', { value: '', text: '(no project)' }));
+    state.view.projects.slice(1).forEach(function (project) {
+      options.push(h('option', { value: project.slug, text: project.handle + ' ' + project.title }));
+    });
+    var select = h('select', {
+      'data-focuskey': formKey + ':project',
+      on: { change: function (event) { form.values.project = event.target.value; } }
+    }, options);
+    select.value = form.values.project;
+    return h('label', {}, ['project', select]);
+  }
+
+  function newEditForm(entry) {
+    var labels = entry.types.concat(entry.areas).join(', ');
+    return {
+      initial: { title: entry.title, labels: labels, brief: entry.brief, body: entry.body },
+      values: { title: entry.title, labels: labels, brief: entry.brief, body: entry.body, project: KEEP_PROJECT, depends_on: '' }
+    };
+  }
+
+  function newCreateForm() {
+    return { values: { slug: '', kind: 'task', title: '', labels: '', brief: '', body: '', project: '', depends_on: '' } };
+  }
+
+  function splitList(text) {
+    return text.split(',').map(function (part) { return part.trim(); }).filter(function (part) { return part !== ''; });
+  }
+
+  function editFields(form) {
+    var fields = {};
+    ['title', 'brief', 'body'].forEach(function (name) {
+      if (form.values[name] !== form.initial[name]) {
+        fields[name] = form.values[name];
+      }
+    });
+    if (form.values.labels !== form.initial.labels) {
+      fields.labels = splitList(form.values.labels);
+    }
+    if (form.values.project !== KEEP_PROJECT) {
+      fields.project = form.values.project;
+    }
+    if (splitList(form.values.depends_on).length > 0) {
+      fields.depends_on = splitList(form.values.depends_on);
+    }
+    return fields;
+  }
+
+  function editFormView(entry, form) {
+    var key = 'edit:' + entry.slug;
+    var nodes = [
+      fieldRow(form, key, 'title', 'title', false),
+      fieldRow(form, key, 'labels', 'labels (comma separated)', false),
+      fieldRow(form, key, 'brief', 'brief', false),
+      fieldRow(form, key, 'body', 'body', true),
+      projectSelect(form, key, true)
+    ];
+    if (entry.kind === 'task') {
+      nodes.push(fieldRow(form, key, 'depends_on', 'depends_on (slugs, comma separated; blank keeps them)', false));
+    }
+    nodes.push(h('div', { class: 'actions' }, [
+      h('button', {
+        type: 'button',
+        class: 'primary',
+        text: 'Save',
+        on: {
+          click: function () {
+            var fields = editFields(form);
+            if (Object.keys(fields).length === 0) {
+              state.messages[entry.slug] = 'Nothing changed, so nothing was sent.';
+              render();
+              return;
+            }
+            send('edit', entry.slug, entry.revision, fields);
+          }
+        }
+      }),
+      h('button', {
+        type: 'button',
+        class: 'action',
+        text: 'Discard edit',
+        on: { click: function () { delete state.forms[entry.slug]; delete state.stale[entry.slug]; render(); } }
+      })
+    ]));
+    return h('div', { class: 'form' }, nodes);
+  }
+
+  function freshEntryPanel(entry) {
+    return h('div', { class: 'panel' }, [
+      h('strong', { text: 'Fresh entry' }),
+      h('pre', { text: [entry.title, '', entry.brief, '', entry.body].join('\n') }),
+      h('div', { class: 'facts', text: factsText(entry) })
+    ]);
+  }
+
+  function writeControls(entry) {
+    var container = h('div', {});
+    if (state.messages[entry.slug]) {
+      container.appendChild(h('div', { class: 'error', text: state.messages[entry.slug] }));
+    }
+    var buttons = allowedActions(entry).map(function (action) {
+      return h('button', {
+        type: 'button',
+        class: 'action',
+        text: action[1],
+        on: { click: function () { send(action[0], entry.slug, entry.revision, {}); } }
+      });
+    });
+    var form = state.forms[entry.slug];
+    if (!form) {
+      buttons.push(h('button', {
+        type: 'button',
+        class: 'action',
+        text: 'Edit',
+        on: { click: function () { state.forms[entry.slug] = newEditForm(entry); render(); } }
+      }));
+    }
+    container.appendChild(h('div', { class: 'actions' }, buttons));
+    if (form) {
+      var editor = editFormView(entry, form);
+      if (state.stale[entry.slug]) {
+        container.appendChild(h('div', { class: 'compare' }, [editor, freshEntryPanel(entry)]));
+      } else {
+        container.appendChild(editor);
+      }
+    }
+    return container;
+  }
+
+  function createFormView() {
+    var form = state.creating;
+    var key = 'create';
+    var kind = h('select', {
+      'data-focuskey': key + ':kind',
+      on: { change: function (event) { form.values.kind = event.target.value; render(); } }
+    }, [h('option', { value: 'task', text: 'task' }), h('option', { value: 'note', text: 'note' })]);
+    kind.value = form.values.kind;
+    var nodes = [
+      fieldRow(form, key, 'slug', 'slug', false),
+      h('label', {}, ['kind', kind]),
+      fieldRow(form, key, 'title', 'title', false),
+      fieldRow(form, key, 'labels', 'labels (comma separated)', false),
+      fieldRow(form, key, 'brief', 'brief', false),
+      fieldRow(form, key, 'body', 'body', true),
+      projectSelect(form, key, false)
+    ];
+    if (form.values.kind === 'task') {
+      nodes.push(fieldRow(form, key, 'depends_on', 'depends_on (slugs, comma separated)', false));
+    }
+    if (state.createMessage) {
+      nodes.push(h('div', { class: 'error', text: state.createMessage }));
+    }
+    nodes.push(h('div', { class: 'actions' }, [
+      h('button', {
+        type: 'button',
+        class: 'primary',
+        text: 'Create',
+        on: {
+          click: function () {
+            var fields = {
+              kind: form.values.kind,
+              title: form.values.title,
+              labels: splitList(form.values.labels),
+              brief: form.values.brief,
+              body: form.values.body
+            };
+            if (form.values.project !== '') {
+              fields.project = form.values.project;
+            }
+            if (form.values.kind === 'task' && splitList(form.values.depends_on).length > 0) {
+              fields.depends_on = splitList(form.values.depends_on);
+            }
+            send('create', form.values.slug, '', fields);
+          }
+        }
+      })
+    ]));
+    return h('div', { class: 'panel' }, [h('strong', { text: 'New entry' }), h('div', { class: 'form' }, nodes)]);
+  }
+
+  function removedView(slug) {
+    var record = state.removed[slug];
+    var form = state.forms[slug];
+    var nodes = [h('div', { class: 'error', text: record })];
+    if (form) {
+      nodes.push(h('div', { class: 'muted', text: 'Your unsent edit of ' + slug + ':' }));
+      ['title', 'labels', 'brief', 'body'].forEach(function (name) {
+        nodes.push(h('label', {}, [name, h('textarea', { 'data-focuskey': 'removed:' + slug + ':' + name, value: form.values[name], on: { input: function (event) { form.values[name] = event.target.value; } } })]));
+      });
+    }
+    nodes.push(h('div', { class: 'actions' }, [
+      h('button', {
+        type: 'button',
+        class: 'action',
+        text: 'Dismiss',
+        on: { click: function () { delete state.removed[slug]; delete state.forms[slug]; render(); } }
+      })
+    ]));
+    return h('div', { class: 'panel' }, nodes);
+  }
+
+  function render() {
+    var app = document.getElementById('app');
+    var saved = captureFocus();
+    app.textContent = '';
+    if (!state.view) {
+      app.appendChild(h('h1', { text: 'Board' }));
+      app.appendChild(h('div', { class: state.error ? 'notice' : 'muted', text: state.error || 'Loading the board…' }));
+      return;
+    }
+    app.appendChild(headerView());
+    if (live && state.creating) {
+      app.appendChild(createFormView());
+    }
+    Object.keys(state.removed).forEach(function (slug) { app.appendChild(removedView(slug)); });
+    app.appendChild(projectsView(buildTree()));
+    restoreFocus(saved);
+  }
+
+  // Writes and the live connection.
+  function request(path, options) {
+    var settings = Object.assign({}, options);
+    settings.headers = Object.assign({ Authorization: 'Bearer ' + state.token }, settings.headers);
+    return fetch(path, settings).then(function (response) {
+      return response.json().then(function (body) { return { status: response.status, body: body }; });
+    });
+  }
+
+  function applyEntry(entry) {
+    var entries = state.view.entries;
+    for (var i = 0; i < entries.length; i++) {
+      if (entries[i].slug === entry.slug) {
+        entries[i] = entry;
+        return;
+      }
+    }
+    entries.push(entry);
+  }
+
+  function removeEntry(slug) {
+    state.view.entries = state.view.entries.filter(function (entry) { return entry.slug !== slug; });
+  }
+
+  function send(op, slug, revision, fields) {
+    var payload = { op: op, slug: slug, fields: fields };
+    if (revision !== '') {
+      payload.revision = revision;
+    }
+    request(ROUTE_WRITE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload)
+    }).then(function (result) {
+      var answer = result.body;
+      if (answer.ok) {
+        applyEntry(answer.entry);
+        delete state.messages[slug];
+        delete state.stale[slug];
+        delete state.forms[slug];
+        if (op === 'create') {
+          state.creating = null;
+          state.expanded[slug] = true;
+        }
+      } else if (Object.prototype.hasOwnProperty.call(answer, 'entry')) {
+        // A stale refusal: the fresh entry replaces the page's copy, so a resend carries its revision.
+        if (answer.entry) {
+          applyEntry(answer.entry);
+          state.messages[slug] = answer.error;
+          if (state.forms[slug]) {
+            state.stale[slug] = true;
+            state.expanded[slug] = true;
+          }
+        } else {
+          removeEntry(slug);
+          state.removed[slug] = answer.error;
+        }
+        if (op === 'create') {
+          state.createMessage = answer.error;
+        }
+      } else if (op === 'create') {
+        state.createMessage = answer.error || 'The write was refused.';
+      } else {
+        state.messages[slug] = answer.error || 'The write was refused.';
+      }
+      render();
+    }).catch(function (error) {
+      var message = 'The write did not reach the server: ' + error.message;
+      if (op === 'create') {
+        state.createMessage = message;
+      } else {
+        state.messages[slug] = message;
+      }
+      render();
+    });
+  }
+
+  function tokenFromFragment() {
+    var fragment = decodeURIComponent(location.hash.replace(/^#/, ''));
+    try {
+      if (fragment !== '') {
+        sessionStorage.setItem(TOKEN_KEY, fragment);
+        history.replaceState(null, '', location.pathname + location.search);
+      }
+      return sessionStorage.getItem(TOKEN_KEY) || '';
+    } catch (ignored) {
+      return fragment;
+    }
+  }
+
+  function startLive() {
+    state.token = tokenFromFragment();
+    var wait = BACKOFF_START_MS;
+    var failingSince = 0;
+    // after is null on the first request, which the server answers at once.
+    // A later request carries the revision last answered, which is empty for a board with no board.json.
+    function poll(after) {
+      var path = after === null ? ROUTE_BOARD : ROUTE_BOARD + '?after=' + encodeURIComponent(after);
+      request(path, {}).then(function (result) {
+        if (!result.body.ok) {
+          throw new Error(result.body.error || 'the server refused the request');
+        }
+        wait = BACKOFF_START_MS;
+        failingSince = 0;
+        var changed = state.error !== '' || !state.view || !result.body.unchanged;
+        state.error = '';
+        if (!result.body.unchanged) {
+          state.view = result.body.board;
+        }
+        if (changed) {
+          render();
+        }
+        poll(result.body.revision);
+      }).catch(function () {
+        if (failingSince === 0) {
+          failingSince = Date.now();
+        }
+        if (Date.now() - failingSince >= GIVE_UP_MS && state.error === '') {
+          state.error = 'The board server does not answer. Run `lym board open` to open the page again.';
+          render();
+        }
+        setTimeout(function () { poll(after); }, wait);
+        wait = Math.min(wait * 2, BACKOFF_CAP_MS);
+      });
+    }
+    render();
+    poll(null);
+  }
+
+  if (live) {
+    startLive();
+  } else if (typeof window.BOARD === 'undefined') {
+    state.error = 'board-data.js is missing or did not parse. Run `lym board rerender` and reload this page.';
+    render();
+  } else {
+    state.view = window.BOARD;
+    render();
+  }
+})();
+</script>
+</body>
+</html>
