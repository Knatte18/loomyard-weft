+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig() error: %v", err)
+			}
+			if got.SandboxMode != tt.want {
+				t.Errorf("LoadConfig().SandboxMode = %q; want %q", got.SandboxMode, tt.want)
+			}
+		})
+	}
