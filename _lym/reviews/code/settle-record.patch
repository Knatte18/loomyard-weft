+				shedrun.StatusFile(l, runID),
+				shedrun.SeedFile(l, runID),
+			}
+			for _, path := range runState {
+				writeFile(t, path)
+			}
+
+			if clean, _, err := fabricengine.Clean(l); err != nil || clean {
