 }
 
-// BoundaryBlock renders text as the JSON a PostToolUse or Stop hook prints to block with text as the reason, which the model reads, and as the system message, which the operator sees.
-func (c *Claude) BoundaryBlock(text string) ([]byte, error) {
-	data, err := json.Marshal(struct {
-		Decision      string `json:"decision"`
-		Reason        string `json:"reason"`
-		SystemMessage string `json:"systemMessage"`
-	}{"block", text, text})
+// stopBlockReason is the reason of creel's Stop block, which points the model at the mail in the block's additional context.
+const stopBlockReason = "[creel] Mail for you arrived as this turn ended; it is in this Stop hook's additional context. Act on it now."
+
+// BoundaryBlock renders text as the JSON a PostToolUse or Stop hook prints to block, handing text to the model once and showing it to the operator as the system message.
+// After a tool call text is the block's reason.
+// On a Stop text is the additional context and the reason is stopBlockReason, since Claude Code hands a Stop block's reason to the model twice, once after the hook's command text.
+func (c *Claude) BoundaryBlock(event shuttleengine.HookEvent, text string) ([]byte, error) {
+	type specificOutput struct {
+		HookEventName     string `json:"hookEventName"`
+		AdditionalContext string `json:"additionalContext"`
+	}
+	block := struct {
+		Decision           string          `json:"decision"`
+		Reason             string          `json:"reason"`
+		SystemMessage      string          `json:"systemMessage"`
+		HookSpecificOutput *specificOutput `json:"hookSpecificOutput,omitempty"`
+	}{Decision: "block", Reason: text, SystemMessage: text}
+	if event == shuttleengine.HookEventStop {
+		block.Reason = stopBlockReason
+		block.HookSpecificOutput = &specificOutput{HookEventName: hookEventStop, AdditionalContext: text}
+	}
+	data, err := json.Marshal(block)
 	if err != nil {
 		return nil, fmt.Errorf("marshal boundary block: %w", err)
 	}
diff --git a/internal/shuttleengine/claudeengine/doc.go b/internal/shuttleengine/claudeengine/doc.go
index 03e5ac9b..c5789397 100644
--- a/internal/shuttleengine/claudeengine/doc.go
+++ b/internal/shuttleengine/claudeengine/doc.go
@@ -131,6 +131,10 @@
 // An engine told a hub board directory also installs a second PostToolUse entry with no matcher, creel's mail hook; an engine told none, a standalone run, installs the stamp alone.
 // Its command is plain POSIX `sh`: it forms the strand's flag name from `$LYM_STRAND_NAME` by parameter expansion alone, turning every `:` into `.` as agentname.FileName does, and exits 0 at once unless that flag stands in CreelFlagDir of the board directory, so a tool call with no mail starts no process.
 // When the flag stands it changes to `$CLAUDE_PROJECT_DIR` and runs `lym creel hook-read claude`, whose standard output, BoundaryBlock's `{"decision":"block","reason":<text>,"systemMessage":<text>}`, hands the strand's mail to the session after the tool call as the reason and shows it to the operator as the system message.
+// On a Stop, BoundaryBlock moves the text into `hookSpecificOutput.additionalContext` and makes the reason a fixed line pointing at it, beside the same system message.
+// Claude Code hands a blocking Stop hook's reason to the model twice, as `Stop hook feedback:` and as `Stop hook blocking error from command: "<command>": <reason>`, and shows it to the operator as `Stop hook error:`;
+// with the mail in the additional context the model reads it once, as `Stop hook additional context:`, and the operator once, as `Stop says:`.
+// Bound: the block still names the hook's command to the model, beside the fixed reason, since every blocking Stop hook's does; the block is what keeps the turn going.
 // HookInput parses a hook's payload: `PostToolUse` and `Stop` map to the tool-boundary and stop events, a non-empty `agent_id` marks a subagent, and `stop_hook_active` is carried; RewakeOutput returns the text plus a newline and exit code 2, the `asyncRewake` wake.
 // Claude Code runs an event's matching hooks in parallel, so a separate creel Stop hook could not keep the recording from logging a turn end its block then cancels, and ParseEvents would read every blocked Stop as a turn end.
 // An engine told a board directory therefore replaces the plain Stop recording with one merged command, and adds the idle waiter as a second Stop entry; a standalone run keeps the plain recording.
