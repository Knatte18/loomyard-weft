diff --git a/internal/fabricengine/landing.go b/internal/fabricengine/landing.go
new file mode 100644
index 000000000..daec5cb2f
--- /dev/null
+++ b/internal/fabricengine/landing.go
@@ -0,0 +1,321 @@
+// landing.go holds fabric's git steps on a branch a run landed on:
+// the reads of the landing commits origin lacks, the records hold they cast,
+// and the push of the prime's code branch with its refusal record.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/dotgit"
+	"github.com/Knatte18/loomyard/internal/fabriclayout"
+	"github.com/Knatte18/loomyard/internal/gitexec"
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/weftname"
+)
+
+// heldRecordsRefPrefix names a local ref of a records repository, one per run whose landing was dropped.
+// The ref keeps the run's held-back records commit, and no push sends it.
+const heldRecordsRefPrefix = "refs/held-records/"
+
+// PushPrimeCodeTip pushes the code branch of the prime to tip, fast-forward only and never forced.
+// It sends no commit past tip, and it makes one transport attempt, since its caller retries on its own schedule.
+// A push that cannot reach origin returns an owed *PushFailedError, unrecorded when opts.OwedUnrecorded is set.
+// A rejection that stays is recorded as one failed push of the prime's code branch.
+// That record's way forward names the landing commits origin lacks.
+// It does nothing when opts.SkipGit or opts.SkipPush is set.
+func PushPrimeCodeTip(prime *lymcwd.Location, tip string, opts SyncOptions) error {
+	if opts.SkipGit || opts.SkipPush {
+		return nil
+	}
+	leaveGate := pauserecord.Admit(pushLockGateOp)
+	defer leaveGate()
+
+	commits, err := LandingCommits(prime)
+	if err != nil {
+		return err
+	}
+	opts.landings = slices.Sorted(maps.Values(commits))
+	opts.SingleAttempt = true
+	opts.ceiling = tip
+	return pushClassified(NewMutations(prime.HubPath), prime.HubPath, fabriclayout.RepoCode, prime.WorktreePath(), opts, nil)
+}
+
+// PrimeCodeRefusalStands reports whether a refused-push record stands for the code branch of the prime.
+func PrimeCodeRefusalStands(prime *lymcwd.Location) (bool, error) {
+	records, err := ListFailedPushes(prime.HubPath)
+	if err != nil {
+		return false, err
+	}
+	var refused []string
+	for _, record := range records {
+		if record.Repo == fabriclayout.RepoCode && !isOwedClass(record.Class) {
+			refused = append(refused, record.Branch)
+		}
+	}
+	if len(refused) == 0 {
+		return false, nil
+	}
+	branch, err := gitrepo.New(prime.WorktreePath()).CurrentBranch()
+	if err != nil {
+		return false, fmt.Errorf("fabricengine: read the code branch of %s: %w", prime.WorktreePath(), err)
+	}
+	return slices.Contains(refused, branch), nil
+}
+
+// ClearPrimeCodeRefusal removes the failed-push record of the prime's code branch, and does nothing when none exists.
+func ClearPrimeCodeRefusal(prime *lymcwd.Location) error {
+	branch, err := gitrepo.New(prime.WorktreePath()).CurrentBranch()
+	if err != nil {
+		return fmt.Errorf("fabricengine: read the code branch of %s: %w", prime.WorktreePath(), err)
+	}
+	return ClearPushFailure(prime.HubPath, fabriclayout.RepoCode, branch)
+}
+
+// branchCommit is one commit of a first-parent chain.
+type branchCommit struct {
+	sha     string
+	message string
+}
+
+// commitsPastUpstream returns the first-parent commits of branch past its tracking ref, newest first.
+// tracked is false for a branch with no tracking ref, which lists none.
+func commitsPastUpstream(dir, branch string) (commits []branchCommit, tracked bool, err error) {
+	upstream, ok, err := gitrepo.New(dir).Upstream(branch)
+	if err != nil || !ok {
+		return nil, false, err
+	}
+	out, err := gitexec.Run([]string{"log", "--first-parent", "-z", "--format=%H%n%B", upstream + "..refs/heads/" + branch, "--"}, dir)
+	if err != nil {
+		return nil, false, fmt.Errorf("fabricengine: list the commits of %s past its tracking ref in %s: %w", branch, dir, err)
+	}
+	for _, entry := range strings.Split(out, "\x00") {
+		sha, message, _ := strings.Cut(strings.TrimLeft(entry, "\n"), "\n")
+		if sha != "" {
+			commits = append(commits, branchCommit{sha: sha, message: message})
+		}
+	}
+	return commits, true, nil
+}
+
+// landingCommitsOn returns the landing commits of branch past its tracking ref, keyed by the run each names.
+// A run named twice keeps its newest commit.
+func landingCommitsOn(dir, branch string) (map[string]string, error) {
+	commits, _, err := commitsPastUpstream(dir, branch)
+	if err != nil {
+		return nil, err
+	}
+	landings := map[string]string{}
+	for _, commit := range commits {
+		run := trailerValue(commit.message, fabriclayout.LandingTrailerKey)
+		if _, seen := landings[run]; run != "" && !seen {
+			landings[run] = commit.sha
+		}
+	}
+	return landings, nil
+}
+
+// LandingCommits returns the landing commits of the branch checked out at l that origin's tracking ref lacks.
+// Each is keyed by the run its landing trailer names.
+// Only the branch's first-parent chain is read.
+// A detached HEAD and a branch with no tracking ref list none. It makes no network call.
+func LandingCommits(l *lymcwd.Location) (map[string]string, error) {
+	branch, detached, err := gitrepo.New(l.WorktreePath()).HeadRef()
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: read the branch of %s: %w", l.WorktreePath(), err)
+	}
+	if detached {
+		return map[string]string{}, nil
+	}
+	return landingCommitsOn(l.WorktreePath(), branch)
+}
+
+// UnsettledLandings returns the landing commits LandingCommits lists at l whose run's board entry is not done.
+// A worktree that does not exist lists none.
+func UnsettledLandings(l *lymcwd.Location) (map[string]string, error) {
+	if _, err := os.Stat(l.WorktreePath()); errors.Is(err, fs.ErrNotExist) {
+		return map[string]string{}, nil
+	}
+	landings, err := LandingCommits(l)
+	if err != nil {
+		return nil, err
+	}
+	return unsettledOf(l.HubPath, landings)
+}
+
+// unsettledOf drops from landings every run whose board entry is done.
+func unsettledOf(hubPath string, landings map[string]string) (map[string]string, error) {
+	for run := range landings {
+		done, err := landingRunDone(hubPath, run)
+		if err != nil {
+			return nil, err
+		}
+		if done {
+			delete(landings, run)
+		}
+	}
+	return landings, nil
+}
+
+// landingRunDone reports whether the hub's local board holds the entry slug as done.
+// It reads the board's file first, since that file holds a done mark not yet committed.
+// An entry the file does not list is read from the board's history.
+func landingRunDone(hubPath, slug string) (bool, error) {
+	boardDir := fabriclayout.BoltDir(hubPath)
+	if _, err := os.Stat(boardDir); errors.Is(err, fs.ErrNotExist) {
+		return false, nil
+	}
+	ledger, _, err := runLedger()
+	if err != nil {
+		return false, err
+	}
+	data, err := os.ReadFile(filepath.Join(boardDir, filepath.FromSlash(ledger.File())))
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return false, fmt.Errorf("fabricengine: read the board for the run %q: %w", slug, err)
+	}
+	if err == nil {
+		runs, err := ledger.Runs(data)
+		if err != nil {
+			return false, fmt.Errorf("fabricengine: read the board for the run %q: %w", slug, err)
+		}
+		for _, run := range runs {
+			if run.Slug == slug {
+				return run.Ended, nil
+			}
+		}
+	}
+	ended, err := readEndedSet(boardDir, "HEAD", []string{slug}, nil)
+	if err != nil {
+		return false, err
+	}
+	return ended[slug] == endedDone, nil
+}
+
+// AheadByOnly reports whether the branch at l is ahead of its tracking ref by commits among tips alone.
+// Only first-parent commits count.
+// A level branch reads true, and a branch with no tracking ref false.
+func AheadByOnly(l *lymcwd.Location, tips []string) (bool, error) {
+	branch, err := gitrepo.New(l.WorktreePath()).CurrentBranch()
+	if err != nil {
+		return false, fmt.Errorf("fabricengine: read the branch of %s: %w", l.WorktreePath(), err)
+	}
+	commits, tracked, err := commitsPastUpstream(l.WorktreePath(), branch)
+	if err != nil || !tracked {
+		return false, err
+	}
+	return !slices.ContainsFunc(commits, func(commit branchCommit) bool {
+		return !slices.Contains(tips, commit.sha)
+	}), nil
+}
+
+// KeepHeldRecords keeps commit, a records commit of the run slug, under a local ref of the records repository of pair.
+// While the ref stands no push of the run's records sends that commit.
+func KeepHeldRecords(pair *lymcwd.Location, slug, commit string) error {
+	if _, err := gitexec.Run([]string{"update-ref", heldRecordsRefPrefix + slug, commit}, RecordsWorktree(pair)); err != nil {
+		return fmt.Errorf("fabricengine: keep the held records commit %s of %q: %w", commit, slug, err)
+	}
+	return nil
+}
+
+// dropHeldRecordsRef deletes the held-records ref of slug from the records repository of l's hub.
+// A failure is logged, since a ref of a removed pair holds nothing back.
+func dropHeldRecordsRef(l *lymcwd.Location, slug string) {
+	root, err := RecordsRepoRoot(l)
+	if err == nil {
+		_, err = gitexec.Run([]string{"update-ref", "-d", heldRecordsRefPrefix + slug}, root)
+	}
+	if err != nil {
+		logger.Warn("fabricengine: held-records ref of a removed pair not deleted", "slug", slug, "error", err)
+	}
+}
+
+// OldestUnpushedRecords returns the oldest records commit of pair that no origin branch holds, "" when there is none.
+// It reads local refs only.
+func OldestUnpushedRecords(pair *lymcwd.Location) (string, error) {
+	return oldestUnpushed(RecordsWorktree(pair))
+}
+
+// oldestUnpushed returns the oldest first-parent commit of the records worktree at dir that no origin branch holds.
+// It returns "" when there is none.
+func oldestUnpushed(dir string) (string, error) {
+	out, err := gitexec.Run([]string{"rev-list", "--first-parent", "HEAD", "--not", "--remotes=" + originRemoteName}, dir)
+	if err != nil {
+		return "", fmt.Errorf("fabricengine: list the unpushed commits of %s: %w", dir, err)
+	}
+	commits := strings.Fields(out)
+	if len(commits) == 0 {
+		return "", nil
+	}
+	return commits[len(commits)-1], nil
+}
+
+// isCheckout reports whether dir holds a usable git checkout.
+// A directory a removal left behind, with no repository in it, is none.
+func isCheckout(dir string) bool {
+	geometry, err := dotgit.Read(dir)
+	return err == nil && dotgit.IsRepository(geometry)
+}
+
+// heldByRefOrLanding returns the records commit of the run slug that git itself holds back.
+// The commit the run's held-records ref names comes first.
+// Without that ref, a landing commit of a run not yet done, on its parent past origin, holds the records.
+// The held commit is then the oldest unpushed one.
+// It reads local refs only.
+// A slug with no records checkout holds nothing, and one with no code checkout holds nothing but by its ref.
+func heldByRefOrLanding(hubPath, slug string) (hold string, held bool, err error) {
+	records := weftname.SiblingPath(hubPath, slug)
+	if !isCheckout(records) {
+		return "", false, nil
+	}
+	hold, err = gitrepo.New(records).RefSHA(heldRecordsRefPrefix + slug)
+	switch {
+	case err == nil:
+		return hold, true, nil
+	case !errors.Is(err, gitrepo.ErrRefNotFound):
+		return "", false, fmt.Errorf("fabricengine: read the held-records ref of %q: %w", slug, err)
+	}
+
+	code := filepath.Join(hubPath, slug)
+	if !isCheckout(code) {
+		return "", false, nil
+	}
+	pair, err := lymcwd.NamedWorktree(hubPath, slug)
+	if err != nil {
+		return "", false, err
+	}
+	origin, found, err := ReadOriginFor(pair, slug)
+	if err != nil {
+		// A half-made pair has no readable parent, and its removal must still run.
+		logger.Warn("fabricengine: origin record not read, so no landing holds the pair's records", "slug", slug, "error", err)
+		return "", false, nil
+	}
+	if !found || origin.ParentBranch == "" {
+		return "", false, nil
+	}
+	landings, err := landingCommitsOn(code, origin.ParentBranch)
+	if err != nil {
+		return "", false, err
+	}
+	if _, landed := landings[slug]; !landed {
+		return "", false, nil
+	}
+	done, err := landingRunDone(hubPath, slug)
+	if err != nil || done {
+		return "", false, err
+	}
+	hold, err = oldestUnpushed(records)
+	if err != nil {
+		return "", false, err
+	}
+	return hold, hold != "", nil
+}
diff --git a/internal/fabricengine/landing_integration_test.go b/internal/fabricengine/landing_integration_test.go
new file mode 100644
index 000000000..fe1990630
--- /dev/null
+++ b/internal/fabricengine/landing_integration_test.go
@@ -0,0 +1,149 @@
+// landing_integration_test.go covers the git steps on a branch runs landed on, over hubforge hubs with bare origins.
+//
+// Package fabricengine_test; shares the single TestMain in testmain_test.go.
+
+package fabricengine_test
+
+import (
+	"errors"
+	"maps"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/fabriclayout"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/testkit/boardkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// landOn commits a landing of the run in the checkout at dir and returns the commit.
+func landOn(t *testing.T, dir, run string) string {
+	t.Helper()
+	return gitkit.CommitFile(t, dir, run+".txt", run+"\n", "land "+run+"\n\n"+fabriclayout.LandingTrailerKey+": "+run)
+}
+
+// hubWithPushedPrimeCode returns a hub whose prime code branch is on origin with an upstream, and that branch.
+func hubWithPushedPrimeCode(t *testing.T) (*hubforge.Hub, string) {
+	t.Helper()
+	boardkit.InstallReplay(t)
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	gitkit.Git(t, h.PrimeWorktree(), "push", "-q", "-u", "origin", "HEAD")
+	return h, gitkit.CurrentBranch(t, h.PrimeWorktree())
+}
+
+func TestPushPrimeCodeTip(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	h, branch := hubWithPushedPrimeCode(t)
+	originTip := func() string { return fabricengine.BareBranchSHAForTest(t, h.CodeBare, branch) }
+	opts := fabricengine.SyncOptions{OwedUnrecorded: true, BackoffSleep: func(time.Duration) {}}
+
+	tip := landOn(t, h.PrimeWorktree(), "run-a")
+	gitkit.CommitFile(t, h.PrimeWorktree(), "local.txt", "local\n", "a commit no landing recorded")
+	if err := fabricengine.PushPrimeCodeTip(h.Location, tip, opts); err != nil {
+		t.Fatalf("PushPrimeCodeTip() = %v; want nil", err)
+	}
+	if got := originTip(); got != tip {
+		t.Errorf("origin tip = %s; want the landing tip %s and nothing past it", got, tip)
+	}
+
+	next := landOn(t, h.PrimeWorktree(), "run-b")
+	originURL := gitkit.Git(t, h.PrimeWorktree(), "config", "--get", "remote.origin.url")
+	// git refuses this URL with `connection refused`, which reads as a transport failure.
+	gitkit.Git(t, h.PrimeWorktree(), "remote", "set-url", "origin", "http://127.0.0.1:1/x")
+	if err := fabricengine.PushPrimeCodeTip(h.Location, next, opts); !fabricengine.IsPushOwed(err) {
+		t.Fatalf("PushPrimeCodeTip() over an unreachable origin = %v; want an owed push", err)
+	}
+	requireNoFailedPush(t, h.Path)
+	gitkit.Git(t, h.PrimeWorktree(), "remote", "set-url", "origin", strings.TrimSpace(originURL))
+
+	other := cloneBareForTest(t, h.CodeBare, branch)
+	gitkit.CommitFile(t, other, "other.txt", "other\n", "another clone's commit")
+	gitkit.MustRun(t, other, "git", "push")
+	err := fabricengine.PushPrimeCodeTip(h.Location, next, opts)
+	var failed *fabricengine.PushFailedError
+	if !errors.As(err, &failed) || failed.Record.Class != fabriclayout.PushFailureNotFastForward || fabricengine.IsPushOwed(err) {
+		t.Fatalf("PushPrimeCodeTip() against a moved origin = %v; want a refused not-fast-forward push", err)
+	}
+	wayForward := fabricengine.FailedPushWayForward(failed.Record)
+	for _, want := range []string{next, "git merge origin/" + branch, "`git push` in " + h.PrimeWorktree()} {
+		if !strings.Contains(wayForward, want) {
+			t.Errorf("way forward = %q; want it to hold %q", wayForward, want)
+		}
+	}
+	requireOneFailedPush(t, h.Path, fabriclayout.RepoCode, fabriclayout.PushFailureNotFastForward)
+	if stands, err := fabricengine.PrimeCodeRefusalStands(h.Location); err != nil || !stands {
+		t.Errorf("PrimeCodeRefusalStands() = %v, %v; want true", stands, err)
+	}
+	if err := fabricengine.ClearPrimeCodeRefusal(h.Location); err != nil {
+		t.Fatalf("ClearPrimeCodeRefusal() = %v; want nil", err)
+	}
+	if stands, err := fabricengine.PrimeCodeRefusalStands(h.Location); err != nil || stands {
+		t.Errorf("PrimeCodeRefusalStands() after the clear = %v, %v; want false", stands, err)
+	}
+
+	// A protected branch refuses every push, so the record names the pull request and not a retry.
+	protected, protectedBranch := hubWithPushedPrimeCode(t)
+	installPreReceive(t, protected.CodeBare, protectedRefusingHook(protectedBranch))
+	err = fabricengine.PushPrimeCodeTip(protected.Location, landOn(t, protected.PrimeWorktree(), "run-c"), opts)
+	if !errors.As(err, &failed) {
+		t.Fatalf("PushPrimeCodeTip() onto a protected branch = %v; want a recorded failure", err)
+	}
+	wayForward = fabricengine.FailedPushWayForward(failed.Record)
+	for _, want := range []string{"beam.pull_request", "trail", "pull request by hand", "git reset --keep origin/" + protectedBranch} {
+		if !strings.Contains(wayForward, want) {
+			t.Errorf("way forward = %q; want it to hold %q", wayForward, want)
+		}
+	}
+}
+
+func TestParentAheadReads(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	h, branch := hubWithPushedPrimeCode(t)
+	prime := h.PrimeWorktree()
+	level := gitkit.RevParse(t, prime, "HEAD")
+
+	first := landOn(t, prime, "run-a")
+	if only, err := fabricengine.AheadByOnly(h.Location, []string{first}); err != nil || !only {
+		t.Errorf("AheadByOnly() over one owed tip = %v, %v; want true", only, err)
+	}
+	plain := gitkit.CommitFile(t, prime, "plain.txt", "plain\n", "a plain commit")
+	second := landOn(t, prime, "run-b")
+
+	landings, err := fabricengine.LandingCommits(h.Location)
+	if want := map[string]string{"run-a": first, "run-b": second}; err != nil || !maps.Equal(landings, want) {
+		t.Errorf("LandingCommits() = %v, %v; want %v", landings, err, want)
+	}
+	if only, err := fabricengine.AheadByOnly(h.Location, []string{first, second}); err != nil || only {
+		t.Errorf("AheadByOnly() with the unrecorded commit %s = %v, %v; want false", plain, only, err)
+	}
+
+	if err := fabricengine.ResetParentToOrigin(h.Location); err != nil {
+		t.Fatalf("ResetParentToOrigin() = %v; want nil", err)
+	}
+	if got := gitkit.RevParse(t, prime, "refs/heads/"+branch); got != level {
+		t.Errorf("local branch = %s; want origin's tip %s", got, level)
+	}
+
+	// A tracked change on a path the reset rewrites, and a branch with no upstream, each refuse with nothing moved.
+	ahead := gitkit.CommitFile(t, prime, "edit.txt", "landed\n", "a commit to drop")
+	if err := os.WriteFile(filepath.Join(prime, "edit.txt"), []byte("dirty\n"), 0o644); err != nil {
+		t.Fatalf("edit edit.txt: %v", err)
+	}
+	if err := fabricengine.ResetParentToOrigin(h.Location); err == nil || gitkit.RevParse(t, prime, "HEAD") != ahead {
+		t.Errorf("ResetParentToOrigin() over a dirty touched path = %v; want a refusal with HEAD at %s", err, ahead)
+	}
+	gitkit.Git(t, prime, "checkout", "--", "edit.txt")
+	gitkit.Git(t, prime, "branch", "--unset-upstream")
+	if err := fabricengine.ResetParentToOrigin(h.Location); err == nil || gitkit.RevParse(t, prime, "HEAD") != ahead {
+		t.Errorf("ResetParentToOrigin() with no upstream = %v; want a refusal with HEAD at %s", err, ahead)
+	}
+}
diff --git a/internal/fabricengine/leftovers.go b/internal/fabricengine/leftovers.go
new file mode 100644
index 000000000..19c087035
--- /dev/null
+++ b/internal/fabricengine/leftovers.go
@@ -0,0 +1,266 @@
+// leftovers.go removes the files a merge leaves behind in a directory it deleted.
+// The ignore rules of the commit the merge started from named those files,
+// and no rule names them once the merge took those rules away.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/fabriclayout"
+	"github.com/Knatte18/loomyard/internal/gitexec"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+)
+
+// ignoreFileName is git's per-directory ignore file.
+const ignoreFileName = ".gitignore"
+
+// RemoveIgnoredLeftovers removes the leftover files of the directories a merge emptied in l's worktree.
+// Such a directory held tracked files at the commit base and holds none now.
+// It removes only an untracked file that base's per-directory ignore files ignore;
+// no exclude file of the user or of the repository counts.
+// A symlink and anything inside a nested repository stay.
+// It returns the removed files as sorted slash-separated worktree-relative paths, also beside an error.
+func RemoveIgnoredLeftovers(l *lymcwd.Location, base string) ([]string, error) {
+	worktree := l.WorktreePath()
+	emptied, err := emptiedDirs(worktree, base)
+	if err != nil || len(emptied) == 0 {
+		return nil, err
+	}
+	candidates, err := leftoverFiles(worktree, emptied)
+	if err != nil || len(candidates) == 0 {
+		return nil, err
+	}
+	ignored, err := ignoredUnderRulesAt(l.HubPath, worktree, base, emptied, candidates)
+	if err != nil {
+		return nil, err
+	}
+	slices.Sort(ignored)
+
+	targets := make([]string, len(ignored))
+	for i, rel := range ignored {
+		targets[i] = filepath.Join(worktree, filepath.FromSlash(rel))
+	}
+	rec := NewMutations(l.HubPath)
+	for i, target := range targets {
+		err := removePath(rec, pathRequest{
+			what:      "remove a merge leftover",
+			container: worktree,
+			target:    target,
+			ownership: ownedIgnoredLeftover(worktree, targets),
+			dirtiness: dirtinessNA("an untracked file that git ignores under the rules of the commit the merge started from"),
+		})
+		if err != nil {
+			return ignored[:i], fmt.Errorf("fabricengine: %w", err)
+		}
+	}
+	return ignored, nil
+}
+
+// emptiedDirs returns the topmost directories of worktree that lost a file since base and hold no tracked file any more.
+func emptiedDirs(worktree, base string) ([]string, error) {
+	deleted, err := gitexec.Run([]string{"diff", "--no-renames", "--diff-filter=D", "--name-only", "-z", base, "HEAD", "--"}, worktree)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: list the files deleted since %s in %s: %w", base, worktree, err)
+	}
+	tracked, err := gitexec.Run([]string{"ls-files", "-z"}, worktree)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: list the tracked files of %s: %w", worktree, err)
+	}
+	holdsTracked := map[string]bool{}
+	for _, file := range nulFields(tracked) {
+		for dir := path.Dir(file); dir != "."; dir = path.Dir(dir) {
+			holdsTracked[dir] = true
+		}
+	}
+
+	var emptied []string
+	for _, file := range nulFields(deleted) {
+		dir := path.Dir(file)
+		if dir == "." {
+			continue
+		}
+		prefix := ""
+		for _, segment := range strings.Split(dir, "/") {
+			prefix = path.Join(prefix, segment)
+			if !holdsTracked[prefix] {
+				emptied = append(emptied, prefix)
+				break
+			}
+		}
+	}
+	slices.Sort(emptied)
+	return slices.Compact(emptied), nil
+}
+
+// leftoverFiles returns the regular files under each of dirs, as slash-separated worktree-relative paths.
+// A directory holding a `.git` entry is a repository of its own and is passed over with everything in it.
+func leftoverFiles(worktree string, dirs []string) ([]string, error) {
+	var files []string
+	for _, dir := range dirs {
+		root := filepath.Join(worktree, filepath.FromSlash(dir))
+		info, err := os.Lstat(root)
+		if errors.Is(err, fs.ErrNotExist) || err == nil && !info.IsDir() {
+			continue
+		}
+		if err != nil {
+			return nil, fmt.Errorf("fabricengine: read the leftover directory %s: %w", root, err)
+		}
+		err = filepath.WalkDir(root, func(p string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			if entry.IsDir() {
+				if pathPresent(filepath.Join(p, ".git")) {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			if !entry.Type().IsRegular() {
+				return nil
+			}
+			rel, err := filepath.Rel(worktree, p)
+			if err != nil {
+				return err
+			}
+			files = append(files, filepath.ToSlash(rel))
+			return nil
+		})
+		if err != nil {
+			return nil, fmt.Errorf("fabricengine: list the files under %s: %w", root, err)
+		}
+	}
+	return files, nil
+}
+
+// ignoredUnderRulesAt returns those of candidates that git ignores under the ignore files the commit base holds for dirs.
+// It asks git over a fresh scratch repository that holds those ignore files alone.
+// The repository lies under the hub's scratch directory and is removed again.
+// Each call has its own, so two calls at once never read each other's rules.
+func ignoredUnderRulesAt(hubPath, worktree, base string, dirs, candidates []string) ([]string, error) {
+	hubScratch := fabriclayout.HubScratchDir(hubPath)
+	parent := filepath.Join(hubScratch, lymdirs.IgnoreCheckDirName)
+	hubRoot, err := os.OpenRoot(hubPath)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: open hub root %s: %w", hubPath, err)
+	}
+	defer hubRoot.Close()
+	parentRel, err := hubRel(hubPath, parent)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: %w", err)
+	}
+	if err := hubRoot.MkdirAll(parentRel, 0o755); err != nil {
+		return nil, fmt.Errorf("fabricengine: create the ignore-check directory: %w", err)
+	}
+	scratch, err := os.MkdirTemp(parent, "check-*")
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: create an ignore-check scratch directory: %w", err)
+	}
+	defer func() {
+		err := removePath(NewMutations(hubPath), pathRequest{
+			what:      "remove an ignore-check scratch directory",
+			container: hubScratch,
+			target:    scratch,
+			ownership: ownedHubScratch(hubScratch),
+			dirtiness: dirtinessNA("a scratch repository this call created"),
+		})
+		if err != nil {
+			logger.Warn("fabricengine: an ignore-check scratch directory could not be removed", "path", scratch, "cause", err)
+		}
+	}()
+
+	scratchRoot, err := os.OpenRoot(scratch)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: open the ignore-check scratch directory: %w", err)
+	}
+	// Deferred after the removal above, so the root is closed before the directory is removed.
+	defer scratchRoot.Close()
+
+	const repoName = "repo"
+	repo := filepath.Join(scratch, repoName)
+	if err := scratchRoot.Mkdir(repoName, 0o755); err != nil {
+		return nil, fmt.Errorf("fabricengine: create the ignore-check repository: %w", err)
+	}
+	if _, err := gitexec.Run([]string{"init", "-q", "--template="}, repo); err != nil {
+		return nil, fmt.Errorf("fabricengine: initialize the ignore-check repository: %w", err)
+	}
+	const excludesName = "excludes"
+	excludes := filepath.Join(scratch, excludesName)
+	for _, empty := range []string{excludesName, path.Join(repoName, ".git", "info", "exclude")} {
+		if err := scratchRoot.MkdirAll(path.Dir(empty), 0o755); err != nil {
+			return nil, fmt.Errorf("fabricengine: create the directory of %s: %w", empty, err)
+		}
+		if err := scratchRoot.WriteFile(empty, nil, 0o644); err != nil {
+			return nil, fmt.Errorf("fabricengine: write the empty exclude file %s: %w", empty, err)
+		}
+	}
+	repoRoot, err := scratchRoot.OpenRoot(repoName)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: open the ignore-check repository: %w", err)
+	}
+	defer repoRoot.Close()
+	if err := writeIgnoreFilesAt(repoRoot, worktree, base, dirs); err != nil {
+		return nil, err
+	}
+
+	stdout, err := gitexec.RunStdin([]string{"-c", "core.excludesFile=" + excludes, "check-ignore", "--no-index", "-z", "--stdin"}, repo, strings.Join(candidates, "\x00")+"\x00")
+	if err != nil {
+		// check-ignore exits 1 when it ignores none of the paths.
+		var gitErr *gitexec.GitError
+		if errors.As(err, &gitErr) && gitErr.ExitCode == 1 {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("fabricengine: check the ignore rules of %s: %w", base, err)
+	}
+	return nulFields(stdout), nil
+}
+
+// writeIgnoreFilesAt writes into repo the ignore files the commit base holds for dirs.
+// Those are the files on the path chain of one of dirs, or under it.
+func writeIgnoreFilesAt(repo *os.Root, worktree, base string, dirs []string) error {
+	listed, err := gitexec.Run([]string{"ls-tree", "-r", "-z", "--full-tree", base}, worktree)
+	if err != nil {
+		return fmt.Errorf("fabricengine: list the tree of %s: %w", base, err)
+	}
+	for _, entry := range nulFields(listed) {
+		// An entry reads "<mode> <type> <object>\t<path>".
+		meta, file, found := strings.Cut(entry, "\t")
+		fields := strings.Fields(meta)
+		// A symlinked ignore file has mode 120000, and git reads no rule through it.
+		if !found || len(fields) != 3 || !strings.HasPrefix(fields[0], "100") || path.Base(file) != ignoreFileName {
+			continue
+		}
+		holder := path.Dir(file)
+		onChain := holder == "." || slices.ContainsFunc(dirs, func(dir string) bool {
+			return holder == dir || strings.HasPrefix(dir, holder+"/") || strings.HasPrefix(holder, dir+"/")
+		})
+		if !onChain {
+			continue
+		}
+		content, err := gitexec.Run([]string{"cat-file", "blob", fields[2]}, worktree)
+		if err != nil {
+			return fmt.Errorf("fabricengine: read %s at %s: %w", file, base, err)
+		}
+		if err := repo.MkdirAll(path.Dir(file), 0o755); err != nil {
+			return fmt.Errorf("fabricengine: create the directory of %s: %w", file, err)
+		}
+		if err := repo.WriteFile(file, []byte(content), 0o644); err != nil {
+			return fmt.Errorf("fabricengine: write %s: %w", file, err)
+		}
+	}
+	return nil
+}
+
+// nulFields splits git's NUL-terminated output into its non-empty fields.
+func nulFields(output string) []string {
+	return strings.FieldsFunc(output, func(r rune) bool { return r == 0 })
+}
