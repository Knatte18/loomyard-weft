+// Package partsparser is the SOLE parser of the parts file, `_lym/parts/parts.md`, and the SOLE declarer of the parts directory's paths.
+// The file splits a task into parts, each with a contract of the decisions it covers, what it takes in, what it delivers and the exports other parts may use, plus the shared spots no single part owns.
+// Parse reads the file into a Parts model, Check judges the model against the decision record's ids, and Validate runs both over the files on disk for the parts gate and `lym loom validate-parts`.
+// Dir, File, PartDir, PartOverview and JoinRecord name the paths under the parts directory, joined from lymdirs.LymDirName and DirName; ArchivePrefix starts the name of every archive directory under it.
+// A part directory holds a plan in the plan format, which only internal/planparser reads and writes.
+// The record's decision ids are read only through internal/discussionparser.
+// The format is pinned in contracts/specs/loom-parts-spec.md.
+package partsparser
diff --git a/internal/partsparser/parse.go b/internal/partsparser/parse.go
new file mode 100644
index 00000000..b1787acc
--- /dev/null
+++ b/internal/partsparser/parse.go
@@ -0,0 +1,419 @@
+// parse.go declares the parts model and Parse, which reads the parts file's markdown into it.
+
+package partsparser
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// Parts is the parsed parts file: the task's title, the note on how it splits, the parts in file order and the shared spots.
+type Parts struct {
+	Title     string
+	SplitNote string
+	Parts     []Part
+	Spots     []SharedSpot
+}
+
+// Part is one part of the split: the contract its writer works to.
+// Exports are the refs the part's cards create, re-sign or delete for other parts to use, and Area the packages and files the part's cards touch.
+type Part struct {
+	Name      string
+	Decisions []string
+	TakesIn   string
+	Delivers  string
+	Exports   []string
+	DependsOn []string
+	Area      []string
+}
+
+// SharedSpot is a file several parts need a change in, which the chair's cards write rather than any part's.
+// Exports are the refs the spot's change provides to the parts that need it, and Uses the refs of parts it relies on.
+type SharedSpot struct {
+	Path      string
+	Decisions []string
+	NeededBy  []string
+	Needs     string
+	Exports   []string
+	Uses      []string
+}
+
+// Part returns the part named name, and whether the file holds one.
+func (p *Parts) Part(name string) (Part, bool) {
+	for _, part := range p.Parts {
+		if part.Name == name {
+			return part, true
+		}
+	}
+	return Part{}, false
+}
+
+// External returns the exports another part's cards may use from the part named name: every export of each part it depends on, then every export of each shared spot whose `Needed by` names it, deduplicated, in that order.
+func (p *Parts) External(name string) []string {
+	var refs []string
+	add := func(exports []string) {
+		for _, ref := range exports {
+			if !slices.Contains(refs, ref) {
+				refs = append(refs, ref)
+			}
+		}
+	}
+	if part, ok := p.Part(name); ok {
+		for _, dependency := range part.DependsOn {
+			if upstream, ok := p.Part(dependency); ok {
+				add(upstream.Exports)
+			}
+		}
+	}
+	for _, spot := range p.Spots {
+		if slices.Contains(spot.NeededBy, name) {
+			add(spot.Exports)
+		}
+	}
+	return refs
+}
+
+// SpotPaths returns every shared spot's path.
+func (p *Parts) SpotPaths() []string {
+	paths := make([]string, len(p.Spots))
+	for i, spot := range p.Spots {
+		paths[i] = spot.Path
+	}
+	return paths
+}
+
+const (
+	h1Prefix        = "# Parts:"
+	splitNoteHeader = "## Split note"
+	partPrefix      = "## Part:"
+	spotPrefix      = "## Shared spot:"
+	specPointer     = "see contracts/specs/loom-parts-spec.md for the format"
+)
+
+// fieldKind is how a field's value is written: prose, a comma-separated list, or sub-bullets of one backticked ref each.
+type fieldKind int
+
+const (
+	prose fieldKind = iota
+	commaList
+	refList
+)
+
+// fieldRule is one legal field label of a section kind.
+type fieldRule struct {
+	label    string
+	kind     fieldKind
+	required bool
+}
+
+var partFields = []fieldRule{
+	{"Decisions", commaList, true},
+	{"Takes in", prose, true},
+	{"Delivers", prose, true},
+	{"Exports", refList, false},
+	{"Depends on", commaList, false},
+	{"Area", refList, true},
+}
+
+var spotFields = []fieldRule{
+	{"Decisions", commaList, false},
+	{"Needed by", commaList, true},
+	{"Needs", prose, true},
+	{"Exports", refList, false},
+	{"Uses", refList, false},
+}
+
+// rawLine is one body line of a section with its 1-based line number in the file.
+type rawLine struct {
+	number int
+	text   string
+	fenced bool
+}
+
+// section is one H2 section of the file: its heading, the heading's line number and the lines under it.
+type section struct {
+	heading string
+	number  int
+	body    []rawLine
+}
+
+// rawField is a field as written: its value text, or its refs for a refList.
+type rawField struct {
+	rule  fieldRule
+	line  int
+	value string
+	refs  []string
+}
+
+// lineError builds a Parse error naming the 1-based line and the way forward.
+func lineError(line int, problem, wayForward string) error {
+	return fmt.Errorf("parts file line %d: %s; way forward: %s; %s", line, problem, wayForward, specPointer)
+}
+
+// Parse reads the parts file's bytes into a Parts.
+// It returns an error naming the line and what is wrong, with the way forward, for a missing H1 or split note, an unknown section heading or field label, a required field missing or empty, a ref sub-bullet that is not one backticked ref, and a field repeated in one section.
+func Parse(data []byte) (*Parts, error) {
+	lines := strings.Split(strings.ReplaceAll(string(data), "\r\n", "\n"), "\n")
+
+	first := 0
+	for first < len(lines) && strings.TrimSpace(lines[first]) == "" {
+		first++
+	}
+	if first == len(lines) || !strings.HasPrefix(lines[first], h1Prefix) {
+		return nil, lineError(first+1, "the file does not open with `# Parts: <task title>`", "start the file with the H1 `# Parts: <task title>`")
+	}
+	title := strings.TrimSpace(strings.TrimPrefix(lines[first], h1Prefix))
+	if title == "" {
+		return nil, lineError(first+1, "the H1 has no task title", "write the task title after `# Parts:`")
+	}
+
+	sections, err := splitSections(lines, first+1)
+	if err != nil {
+		return nil, err
+	}
+	if len(sections) == 0 || sections[0].heading != splitNoteHeader {
+		return nil, lineError(firstSectionLine(sections, len(lines)), "the first section is not `## Split note`", "write `## Split note` right after the H1, saying how the task splits or why it does not")
+	}
+	note := strings.TrimSpace(joinText(sections[0].body))
+	if note == "" {
+		return nil, lineError(sections[0].number, "the split note is empty", "say how the task splits, or why it does not")
+	}
+
+	parts := &Parts{Title: title, SplitNote: note}
+	for _, sec := range sections[1:] {
+		switch {
+		case strings.HasPrefix(sec.heading, partPrefix):
+			if len(parts.Spots) > 0 {
+				return nil, lineError(sec.number, "a `## Part:` section follows a shared spot", "move every `## Part:` section above the first `## Shared spot:` section")
+			}
+			part, err := buildPart(sec)
+			if err != nil {
+				return nil, err
+			}
+			parts.Parts = append(parts.Parts, part)
+		case strings.HasPrefix(sec.heading, spotPrefix):
+			spot, err := buildSpot(sec)
+			if err != nil {
+				return nil, err
+			}
+			parts.Spots = append(parts.Spots, spot)
+		default:
+			return nil, lineError(sec.number, fmt.Sprintf("unknown or misplaced section heading %q", sec.heading), "use `## Part: <name>` or ## Shared spot: `<path>`, after the one `## Split note`")
+		}
+	}
+	return parts, nil
+}
+
+// firstSectionLine returns the line of the first section, or the file's end when it has none.
+func firstSectionLine(sections []section, fileLines int) int {
+	if len(sections) == 0 {
+		return fileLines
+	}
+	return sections[0].number
+}
+
+// splitSections cuts the lines from index start into H2 sections.
+// A heading line outside a fenced block that opens with `#` but is not an H2 is refused, as is text before the first H2.
+func splitSections(lines []string, start int) ([]section, error) {
+	var sections []section
+	fenced := false
+	for i := start; i < len(lines); i++ {
+		text := strings.TrimRight(lines[i], " \t")
+		if strings.HasPrefix(strings.TrimLeft(text, " \t"), "```") {
+			fenced = !fenced
+			if len(sections) > 0 {
+				sections[len(sections)-1].body = append(sections[len(sections)-1].body, rawLine{i + 1, text, true})
+			}
+			continue
+		}
+		if fenced {
+			if len(sections) > 0 {
+				sections[len(sections)-1].body = append(sections[len(sections)-1].body, rawLine{i + 1, text, true})
+			}
+			continue
+		}
+		switch {
+		case strings.HasPrefix(text, "## "):
+			sections = append(sections, section{heading: text, number: i + 1})
+		case strings.HasPrefix(text, "#"):
+			return nil, lineError(i+1, fmt.Sprintf("unknown heading %q", text), "use only the H1, `## Split note`, `## Part: <name>` and ## Shared spot: `<path>` headings")
+		case len(sections) == 0:
+			if text != "" {
+				return nil, lineError(i+1, "text before the first section", "move it under `## Split note`")
+			}
+		default:
+			sections[len(sections)-1].body = append(sections[len(sections)-1].body, rawLine{i + 1, text, false})
+		}
+	}
+	return sections, nil
+}
+
+// joinText joins a body's lines, blank and fenced lines included, with newlines.
+func joinText(body []rawLine) string {
+	texts := make([]string, len(body))
+	for i, line := range body {
+		texts[i] = line.text
+	}
+	return strings.Join(texts, "\n")
+}
+
+// parseFields reads a section's body as fields under the told rules, and checks the required ones are present and non-empty.
+func parseFields(sec section, rules []fieldRule) (map[string]*rawField, error) {
+	labels := make([]string, len(rules))
+	for i, rule := range rules {
+		labels[i] = rule.label
+	}
+	fields := map[string]*rawField{}
+	var current *rawField
+	var proseLines []string
+	flushProse := func() {
+		if current != nil && current.rule.kind == prose {
+			current.value = strings.TrimSpace(current.value + "\n" + strings.Join(proseLines, "\n"))
+		}
+		proseLines = nil
+	}
+	for _, line := range sec.body {
+		trimmed := strings.TrimSpace(line.text)
+		if line.fenced || trimmed == "" {
+			if current != nil && current.rule.kind == prose {
+				proseLines = append(proseLines, line.text)
+			}
+			continue
+		}
+		if strings.HasPrefix(line.text, "- ") {
+			flushProse()
+			label, value, ok := strings.Cut(strings.TrimPrefix(line.text, "- "), ":")
+			label = strings.TrimSpace(label)
+			if !ok {
+				return nil, lineError(line.number, fmt.Sprintf("%q is not a field `- <Label>: <value>`", line.text), fmt.Sprintf("write the line as `- <Label>: <value>` with a label of %s", strings.Join(labels, ", ")))
+			}
+			idx := slices.IndexFunc(rules, func(r fieldRule) bool { return r.label == label })
+			if idx < 0 {
+				return nil, lineError(line.number, fmt.Sprintf("unknown field label %q", label), fmt.Sprintf("use one of %s", strings.Join(labels, ", ")))
+			}
+			if earlier, repeated := fields[label]; repeated {
+				return nil, lineError(line.number, fmt.Sprintf("field %q is repeated; it is first written on line %d", label, earlier.line), "keep the field once and merge the values")
+			}
+			current = &rawField{rule: rules[idx], line: line.number, value: strings.TrimSpace(value)}
+			fields[label] = current
+			if current.rule.kind == refList && current.value != "" {
+				return nil, lineError(line.number, fmt.Sprintf("field %q holds sub-bullets, not an inline value", label), fmt.Sprintf("leave the rest of the line empty and write one indented sub-bullet of one backticked ref per entry under %q", label))
+			}
+			continue
+		}
+		if !strings.HasPrefix(line.text, " ") && !strings.HasPrefix(line.text, "\t") {
+			return nil, lineError(line.number, fmt.Sprintf("%q is not a field `- <Label>: <value>`", line.text), "start the line with `- <Label>: ` or indent it under the field it continues")
+		}
+		if current == nil {
+			return nil, lineError(line.number, "an indented line before any field", "put it under a `- <Label>: <value>` field")
+		}
+		switch current.rule.kind {
+		case prose:
+			proseLines = append(proseLines, trimmed)
+		case commaList:
+			current.value += " " + trimmed
+		case refList:
+			entry, isBullet := strings.CutPrefix(trimmed, "- ")
+			ref, isRef := strings.CutPrefix(strings.TrimSpace(entry), "`")
+			ref, closed := strings.CutSuffix(ref, "`")
+			if !isBullet || !isRef || !closed || ref == "" || strings.Contains(ref, "`") {
+				return nil, lineError(line.number, fmt.Sprintf("%q is not one backticked ref sub-bullet", trimmed), fmt.Sprintf("write each entry of %q as an indented bullet holding one ref in backticks, such as `- `internal/x`", current.rule.label))
+			}
+			current.refs = append(current.refs, ref)
+		}
+	}
+	flushProse()
+
+	for _, rule := range rules {
+		field, present := fields[rule.label]
+		switch {
+		case !present && rule.required:
+			return nil, lineError(sec.number, fmt.Sprintf("%s lacks the required field %q", sec.heading, rule.label), fmt.Sprintf("add `- %s: ...` to the section", rule.label))
+		case present && field.isEmpty():
+			return nil, lineError(field.line, fmt.Sprintf("field %q is empty", rule.label), "give it a value, or leave an optional field out instead of writing it empty or as none")
+		}
+	}
+	return fields, nil
+}
+
+// isEmpty reports whether the field holds no value and no ref.
+func (f *rawField) isEmpty() bool {
+	if f.rule.kind == refList {
+		return len(f.refs) == 0
+	}
+	return f.value == ""
+}
+
+// list splits a comma-list field's value into its entries; an absent field gives none.
+func (f *rawField) list() []string {
+	if f == nil {
+		return nil
+	}
+	var entries []string
+	for _, entry := range strings.Split(f.value, ",") {
+		if entry = strings.TrimSpace(entry); entry != "" {
+			entries = append(entries, entry)
+		}
+	}
+	return entries
+}
+
+// text returns a prose field's value; an absent field gives "".
+func (f *rawField) text() string {
+	if f == nil {
+		return ""
+	}
+	return f.value
+}
+
+// refsOf returns a refList field's refs; an absent field gives none.
+func (f *rawField) refsOf() []string {
+	if f == nil {
+		return nil
+	}
+	return f.refs
+}
+
+// buildPart builds a Part from its `## Part: <name>` section.
+func buildPart(sec section) (Part, error) {
+	name := strings.TrimSpace(strings.TrimPrefix(sec.heading, partPrefix))
+	if name == "" {
+		return Part{}, lineError(sec.number, "the part heading has no name", "write `## Part: <name>`")
+	}
+	fields, err := parseFields(sec, partFields)
+	if err != nil {
+		return Part{}, err
+	}
+	return Part{
+		Name:      name,
+		Decisions: fields["Decisions"].list(),
+		TakesIn:   fields["Takes in"].text(),
+		Delivers:  fields["Delivers"].text(),
+		Exports:   fields["Exports"].refsOf(),
+		DependsOn: fields["Depends on"].list(),
+		Area:      fields["Area"].refsOf(),
+	}, nil
+}
+
+// buildSpot builds a SharedSpot from its ## Shared spot: `<path>` section.
+func buildSpot(sec section) (SharedSpot, error) {
+	rest := strings.TrimSpace(strings.TrimPrefix(sec.heading, spotPrefix))
+	path, isPath := strings.CutPrefix(rest, "`")
+	path, closed := strings.CutSuffix(path, "`")
+	if !isPath || !closed || path == "" || strings.Contains(path, "`") {
+		return SharedSpot{}, lineError(sec.number, fmt.Sprintf("%q does not name the spot's path in backticks", sec.heading), "write ## Shared spot: `<path>`")
+	}
+	fields, err := parseFields(sec, spotFields)
+	if err != nil {
+		return SharedSpot{}, err
+	}
+	return SharedSpot{
+		Path:      path,
+		Decisions: fields["Decisions"].list(),
+		NeededBy:  fields["Needed by"].list(),
+		Needs:     fields["Needs"].text(),
+		Exports:   fields["Exports"].refsOf(),
+		Uses:      fields["Uses"].refsOf(),
+	}, nil
+}
diff --git a/internal/partsparser/parse_test.go b/internal/partsparser/parse_test.go
new file mode 100644
index 00000000..ae1ffbaf
--- /dev/null
+++ b/internal/partsparser/parse_test.go
@@ -0,0 +1,167 @@
+//go:build tier0
+
+// parse_test.go tests Parse over a full parts file and the errors it names, plus the model reads External and SpotPaths.
+
+package partsparser
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// validParts is a parts file of two parts and two shared spots that Parse reads and Check passes for the decisions D1 to D3.
+const validParts = `# Parts: Add widget
+
+## Split note
+
+The task splits in two.
+
+## Part: core
+
+- Decisions: D1
+- Takes in: the widget request
+- Delivers: the widget type
+- Exports:
+  - ` + "`plan:internal/x#NewThing`" + `
+  - ` + "`internal/x/newfile.go`" + `
+- Area:
+  - ` + "`internal/x`" + `
+
+## Part: wiring
+
+- Decisions: D2, D3
+- Takes in: the NewThing type
+  and the registry row
+- Delivers: the wiring
+- Depends on: core
+- Area:
+  - ` + "`internal/y`" + `
+  - ` + "`internal/reg`" + `
+
+## Shared spot: ` + "`internal/reg/reg.go`" + `
+
+- Decisions: D3
+- Needed by: core, wiring
+- Needs: a registry row
+- Exports:
+  - ` + "`plan:internal/reg#Registered`" + `
+- Uses:
+  - ` + "`plan:internal/x#NewThing`" + `
+
+## Shared spot: ` + "`cmd/main.go`" + `
+
+- Needed by: wiring
+- Needs: the wire
+`
+
+func mustParse(t *testing.T, text string) *Parts {
+	t.Helper()
+	parts, err := Parse([]byte(text))
+	if err != nil {
+		t.Fatalf("Parse() = _, %v; want nil error", err)
+	}
+	return parts
+}
+
+func TestParse(t *testing.T) {
+	t.Parallel()
+
+	t.Run("a full file is read into the model", func(t *testing.T) {
+		t.Parallel()
+		want := &Parts{
+			Title:     "Add widget",
+			SplitNote: "The task splits in two.",
+			Parts: []Part{
+				{
+					Name: "core", Decisions: []string{"D1"}, TakesIn: "the widget request", Delivers: "the widget type",
+					Exports: []string{"plan:internal/x#NewThing", "internal/x/newfile.go"}, Area: []string{"internal/x"},
+				},
+				{
+					Name: "wiring", Decisions: []string{"D2", "D3"}, TakesIn: "the NewThing type\nand the registry row", Delivers: "the wiring",
+					DependsOn: []string{"core"}, Area: []string{"internal/y", "internal/reg"},
+				},
+			},
+			Spots: []SharedSpot{
+				{
+					Path: "internal/reg/reg.go", Decisions: []string{"D3"}, NeededBy: []string{"core", "wiring"}, Needs: "a registry row",
+					Exports: []string{"plan:internal/reg#Registered"}, Uses: []string{"plan:internal/x#NewThing"},
+				},
+				{Path: "cmd/main.go", NeededBy: []string{"wiring"}, Needs: "the wire"},
+			},
+		}
+		got := mustParse(t, validParts)
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("Parse() = %+v; want %+v", got, want)
+		}
+
+		if part, ok := got.Part("wiring"); !ok || part.Name != "wiring" {
+			t.Errorf("Part(wiring) = %+v, %v; want the wiring part", part, ok)
+		}
+		if _, ok := got.Part("ghost"); ok {
+			t.Error("Part(ghost) ok = true; want false")
+		}
+		if got, want := got.SpotPaths(), []string{"internal/reg/reg.go", "cmd/main.go"}; !reflect.DeepEqual(got, want) {
+			t.Errorf("SpotPaths() = %v; want %v", got, want)
+		}
+		parts := mustParse(t, validParts)
+		wantExternal := map[string][]string{
+			"core":   {"plan:internal/reg#Registered"},
+			"wiring": {"plan:internal/x#NewThing", "internal/x/newfile.go", "plan:internal/reg#Registered"},
+			"ghost":  nil,
+		}
+		for name, want := range wantExternal {
+			if got := parts.External(name); !reflect.DeepEqual(got, want) {
+				t.Errorf("External(%q) = %v; want %v", name, got, want)
+			}
+		}
+	})
+
+	t.Run("a fenced line is read as text", func(t *testing.T) {
+		t.Parallel()
+		text := strings.Replace(validParts, "The task splits in two.", "Split like this:\n```\n## Part: not-a-part\n```", 1)
+		parts := mustParse(t, text)
+		if len(parts.Parts) != 2 || !strings.Contains(parts.SplitNote, "## Part: not-a-part") {
+			t.Errorf("Parse() parts = %d, split note = %q; want the fenced heading kept in the note", len(parts.Parts), parts.SplitNote)
+		}
+	})
+
+	errorRows := []struct {
+		name     string
+		mutate   func(string) string
+		wantLine string
+		wantIn   string
+	}{
+		{"missing H1", func(s string) string { return strings.Replace(s, "# Parts: Add widget", "Add widget", 1) }, "line 1:", "does not open with"},
+		{"missing split note", func(s string) string {
+			return strings.Replace(s, "## Split note\n\nThe task splits in two.\n\n", "", 1)
+		}, "line 3:", "is not `## Split note`"},
+		{"empty split note", func(s string) string { return strings.Replace(s, "The task splits in two.", "", 1) }, "line 3:", "split note is empty"},
+		{"unknown section heading", func(s string) string { return strings.Replace(s, "## Part: wiring", "## Chapter: wiring", 1) }, "line 18:", "unknown or misplaced section heading"},
+		{"unknown field label", func(s string) string {
+			return strings.Replace(s, "- Delivers: the widget type", "- Gives: the widget type", 1)
+		}, "line 11:", "unknown field label"},
+		{"required field missing", func(s string) string { return strings.Replace(s, "- Delivers: the widget type\n", "", 1) }, "line 7:", `lacks the required field "Delivers"`},
+		{"required field empty", func(s string) string { return strings.Replace(s, "- Delivers: the widget type", "- Delivers:", 1) }, "line 11:", `field "Delivers" is empty`},
+		{"ref sub-bullet not backticked", func(s string) string { return strings.Replace(s, "  - `internal/x`\n", "  - internal/x\n", 1) }, "line 16:", "not one backticked ref"},
+		{"field repeated", func(s string) string {
+			return strings.Replace(s, "- Decisions: D1\n", "- Decisions: D1\n- Decisions: D9\n", 1)
+		}, "line 10:", `field "Decisions" is repeated`},
+		{"part after a spot", func(s string) string { return s + "\n## Part: late\n" }, "line 44:", "follows a shared spot"},
+		{"spot without its required Needs", func(s string) string { return strings.Replace(s, "- Needs: the wire\n", "", 1) }, "line 39:", `lacks the required field "Needs"`},
+	}
+	for _, tt := range errorRows {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, err := Parse([]byte(tt.mutate(validParts)))
+			if err == nil {
+				t.Fatal("Parse() error = nil; want a refusal")
+			}
+			for _, want := range []string{tt.wantLine, tt.wantIn, "way forward:", "contracts/specs/loom-parts-spec.md"} {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("Parse() error = %q; want it to contain %q", err.Error(), want)
+				}
+			}
+		})
+	}
+}
