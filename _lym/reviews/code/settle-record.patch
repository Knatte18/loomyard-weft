+
+	caps, err := deps.CodeReviewCaps()
+	if err != nil {
+		t.Fatalf("CodeReviewCaps() = %v; want nil", err)
+	}
+	if caps.Soft != 7 || caps.Hard != 9 {
+		t.Errorf("CodeReviewCaps() = %+v; want soft 7 and hard 9, the code perch's caps", caps)
+	}
