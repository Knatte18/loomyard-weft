+		requireOneRecordsCommit(t, f, before)
+		if data, err := os.ReadFile(f.paths.Expected); err != nil || string(data) != expectsY {
+			t.Errorf("expected.yaml = %q, %v; want the sealed copy %q", data, err, expectsY)
