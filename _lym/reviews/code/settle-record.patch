+			return ownOutput + "\nlym shed: step " + id + " output: first\nlym shed: step " + id + " output: second\n"
+		}},
+		{"TrailingNewlineAddsNoEmptyLine", "first\n", func(id string) string {
+			return ownOutput + "\nlym shed: step " + id + " output: first\n"
