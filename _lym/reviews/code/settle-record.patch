+		h.write("beam-records", pushledger.Entry{
+			Worktree: gone,
+			Landings: []pushledger.Landing{{Run: "member", Tip: "abc", ParentBranch: "beam", At: h.start}},
+		}, true)
+
+		h.tickAt(10, 1)
