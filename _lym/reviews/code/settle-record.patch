--- /dev/null
+++ b/internal/shedrecipe/entries_recordwrite.go
@@ -0,0 +1,41 @@
+// entries_recordwrite.go implements recordWriteEntry, the Constructor for the "RecordWrite" registry row:
+// a Go row that writes a loom run's decision record and support log from its board entry, with no agent.
+
+package shedrecipe
+
+import (
+	"github.com/Knatte18/loomyard/internal/loomshed"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// recordWriteEntry is the Constructor for the "RecordWrite" registry row: it takes no Config key and returns loomshed.NewRecordWrite over Env.RecordWrite.
+// The record, support log and discussion directory paths must be absolute, and ReadBody and Commit must be non-nil; the refusal names the Env field.
+func recordWriteEntry(row RowIdentity, cfg Config, env Env) (shedengine.ShedProducer, error) {
+	const entry = "RecordWrite"
+	if err := configRejectUnknown(cfg); err != nil {
+		return nil, err
+	}
+	deps := env.RecordWrite
+	for _, path := range []struct{ field, value string }{
+		{"RecordWrite.RecordPath", deps.RecordPath},
+		{"RecordWrite.SupportLogPath", deps.SupportLogPath},
+		{"RecordWrite.DiscussionDir", deps.DiscussionDir},
+	} {
+		if err := requireAbsRoot(entry, path.field, path.value); err != nil {
+			return nil, err
+		}
+	}
+	for _, seam := range []struct {
+		field string
+		value any
+	}{
+		{"RecordWrite.ReadBody", deps.ReadBody},
+		{"RecordWrite.Commit", deps.Commit},
+	} {
+		if err := requireSeam(entry, seam.field, seam.value); err != nil {
+			return nil, err
+		}
+	}
+
+	return loomshed.NewRecordWrite(row.Name, deps), nil
+}
diff --git a/internal/shedrecipe/entries_recordwrite_test.go b/internal/shedrecipe/entries_recordwrite_test.go
new file mode 100644
index 00000000..0f9ae9e5
--- /dev/null
+++ b/internal/shedrecipe/entries_recordwrite_test.go
@@ -0,0 +1,43 @@
+//go:build tier0
+
+// entries_recordwrite_test.go covers recordWriteEntry: its construction-time validation of the three paths and two seams of Env.RecordWrite, and the build over a filled Env.
+
+package shedrecipe
+
+import "testing"
+
+func TestRecordWriteEntry(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name  string
+		field string
+		edit  func(*Env)
+	}{
+		{"RelativeRecordPath", "RecordWrite.RecordPath", func(e *Env) { e.RecordWrite.RecordPath = "decision-record.md" }},
+		{"RelativeSupportLogPath", "RecordWrite.SupportLogPath", func(e *Env) { e.RecordWrite.SupportLogPath = "support-log.md" }},
+		{"RelativeDiscussionDir", "RecordWrite.DiscussionDir", func(e *Env) { e.RecordWrite.DiscussionDir = "discussion" }},
+		{"NilReadBody", "RecordWrite.ReadBody", func(e *Env) { e.RecordWrite.ReadBody = nil }},
+		{"NilCommit", "RecordWrite.Commit", func(e *Env) { e.RecordWrite.Commit = nil }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			env := newTestEnv(t)
+			tt.edit(&env)
+			_, err := recordWriteEntry(RowIdentity{Name: "Row"}, Config{}, env)
+			if err == nil {
+				t.Fatalf("recordWriteEntry() error = nil; want a refusal naming %s", tt.field)
+			}
+			assertErrContains(t, err, tt.field)
+		})
+	}
+
+	t.Run("BuildsWithAFilledEnv", func(t *testing.T) {
+		t.Parallel()
+		producer, err := recordWriteEntry(RowIdentity{Name: "Row"}, Config{}, newTestEnv(t))
+		if err != nil || producer == nil {
+			t.Fatalf("recordWriteEntry() = %v, %v; want a producer and nil", producer, err)
+		}
+	})
+}
