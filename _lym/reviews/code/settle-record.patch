+++ b/internal/hardencli/cli.go
@@ -0,0 +1,276 @@
+// cli.go builds the cobra command tree of the harden module: the sandbox verbs over a hardener run's throwaway hubs.
+
+package hardencli
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/buildvcs"
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/fabriccli"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hardenshed"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/loomcli"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/output"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/yamlengine"
+)
+
+// The names the sandbox's `.dev-bin` lym is found by, relative to the worktree root.
+const (
+	devBinDirName = ".dev-bin"
+	devBinLymName = "lym"
+)
+
+// sandboxShortname is the repository short name a sandbox hub is cloned under.
+const sandboxShortname = "sbx"
+
+// notHardenerWayForward closes the refusal of a verb run outside a hardener run's worktree.
+const notHardenerWayForward = "way forward: run lym harden sandbox in a hardener run's worktree"
+
+// cliDeps holds the seams a test replaces.
+type cliDeps struct {
+	// Deploy rebuilds the `.dev-bin` lym from the worktree at worktreeRoot.
+	Deploy func(worktreeRoot string) error
+}
+
+// Command returns the cobra command tree for the harden module.
+func Command() *cobra.Command {
+	return newCommand(cliDeps{Deploy: deployDevBin})
+}
+
+// deployDevBin rebuilds the `.dev-bin` lym with `go run ./tools/deploy -dev` in the worktree, and waits for it.
+func deployDevBin(worktreeRoot string) error {
+	cmd := exec.Command("go", "run", "./tools/deploy", "-dev")
+	cmd.Dir = worktreeRoot
+	logger.Info("hardencli: deploying the .dev-bin lym", "dir", worktreeRoot)
+	if combined, err := cmd.CombinedOutput(); err != nil {
+		return fmt.Errorf("go run ./tools/deploy -dev: %w: %s", err, combined)
+	}
+	return nil
+}
+
+// newCommand builds the harden command tree over deps.
+func newCommand(deps cliDeps) *cobra.Command {
+	harden := &cobra.Command{
+		Use:   "harden",
+		Short: "work with the sandbox hubs of a hardener run",
+		Long: `harden holds the verbs over the throwaway sandbox hubs a hardener run's live
+tests run against. They run in the task worktree of a hardener run.`,
+		RunE: clihelp.GroupRunE,
+	}
+	sandbox := &cobra.Command{
+		Use:   "sandbox",
+		Short: "make, list or clear the sandbox hubs of the worktree",
+		Long: `sandbox makes, lists and clears the throwaway hubs under the worktree's sandbox
+root. Each verb refuses outside a hardener run's worktree; clear also runs where
+the root exists.`,
+		RunE: clihelp.GroupRunE,
+	}
+	sandbox.AddCommand(newVerb(deps), listVerb(), clearVerb())
+	harden.AddCommand(sandbox)
+	return harden
+}
+
+// sandboxTarget is the worktree a verb works in and the sandbox root under it.
+type sandboxTarget struct {
+	location *lymcwd.Location
+	root     string
+}
+
+// resolveTarget resolves the worktree the verb runs in and admits it.
+// A hardener run's worktree is admitted, and so is, for a clear, any worktree whose sandbox root exists.
+// It prints the refusal and aborts, and returns false, otherwise.
+func resolveTarget(cmd *cobra.Command, clear bool) (sandboxTarget, bool) {
+	ctx := cmd.Context()
+	out := cmd.OutOrStdout()
+	refuse := func(err error) (sandboxTarget, bool) {
+		output.Err(out, err.Error())
+		clihelp.Abort(ctx, 1)
+		return sandboxTarget{}, false
+	}
+	cwd, err := lymcwd.CwdFrom(ctx)
+	if err != nil {
+		return refuse(err)
+	}
+	location, err := lymcwd.Resolve(cwd)
+	if err != nil {
+		return refuse(err)
+	}
+	target := sandboxTarget{location: location, root: hardenshed.SandboxRoot(location.WorktreePath())}
+	seed, found, err := shedrun.ReadSeed(location, shedrun.SelfRunID)
+	if err != nil {
+		return refuse(err)
+	}
+	if found && seed.Recipe == shedrun.RecipeHardener {
+		return target, true
+	}
+	if clear {
+		if _, err := os.Stat(target.root); err == nil {
+			return target, true
+		} else if !errors.Is(err, fs.ErrNotExist) {
+			return refuse(err)
+		}
+	}
+	return refuse(fmt.Errorf("lym harden sandbox: the worktree %s holds no hardener run; %s", location.WorktreeName, notHardenerWayForward))
+}
+
+// newVerb builds `lym harden sandbox new`.
+func newVerb(deps cliDeps) *cobra.Command {
+	return &cobra.Command{
+		Use:         "new",
+		Short:       "build a throwaway sandbox hub under the worktree's sandbox root",
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceOperator},
+		Long: `new builds a throwaway hub from two local bare repositories under the
+worktree's sandbox root, with no GitHub remote, and records it in the root's hub
+list. Its prime records commit a loom.yaml with Tier 2 self-reporting off. The
+worktree's .dev-bin lym is rebuilt only when it is not built
+from the worktree's HEAD or is modified. It prints the hub's path and the
+absolute path of the .dev-bin lym.`,
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			target, ok := resolveTarget(cmd, false)
+			if !ok {
+				return nil
+			}
+			hub, err := hardenshed.NewSandbox(sandboxDeps(target, deps))
+			if err != nil {
+				output.Err(cmd.OutOrStdout(), err.Error())
+				clihelp.Abort(cmd.Context(), 1)
+				return nil
+			}
+			output.Ok(cmd.OutOrStdout(), map[string]any{"hub": hub.Hub, "lym": hub.Lym})
+			return nil
+		},
+	}
+}
+
+// listVerb builds `lym harden sandbox list`.
+func listVerb() *cobra.Command {
+	return &cobra.Command{
+		Use:         "list",
+		Short:       "list the sandbox hubs under the worktree's sandbox root",
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceOperator},
+		Long:        `list prints the hubs the worktree's sandbox root records, in the order they were made.`,
+		Args:        cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			target, ok := resolveTarget(cmd, false)
+			if !ok {
+				return nil
+			}
+			hubs, err := hardenshed.ListSandbox(target.root)
+			if err != nil {
+				output.Err(cmd.OutOrStdout(), err.Error())
+				clihelp.Abort(cmd.Context(), 1)
+				return nil
+			}
+			output.Ok(cmd.OutOrStdout(), map[string]any{"hubs": append([]string{}, hubs...)})
+			return nil
+		},
+	}
+}
+
+// clearVerb builds `lym harden sandbox clear`.
+func clearVerb() *cobra.Command {
+	return &cobra.Command{
+		Use:         "clear",
+		Short:       "end what the sandbox hubs left running and empty the sandbox root",
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceOperator},
+		Long: `clear ends the processes the sandbox hubs registered, stops the reed servers of
+the hubs the root's list records, ends the processes that name the root, and
+removes the root's contents. A hub made outside the root is outside it. It
+prints what it ended.`,
+		Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			target, ok := resolveTarget(cmd, true)
+			if !ok {
+				return nil
+			}
+			reapDeps, err := loomcli.HardenReapDeps(target.location, "lym harden sandbox clear", hardenshed.ReapClear)
+			if err == nil {
+				var ended []hardenshed.StrayEntry
+				if ended, err = hardenshed.Reap(reapDeps); err == nil {
+					output.Ok(cmd.OutOrStdout(), map[string]any{"root": target.root, "ended": append([]hardenshed.StrayEntry{}, ended...)})
+					return nil
+				}
+			}
+			output.Err(cmd.OutOrStdout(), fmt.Sprintf("%v; way forward: fix the cause, then run lym harden sandbox clear again", err))
+			clihelp.Abort(cmd.Context(), 1)
+			return nil
+		},
+	}
+}
+
+// sandboxDeps builds the seams NewSandbox needs for the worktree of target.
+// The hub is cloned over local bares, and its prime records commit the sandbox config override.
+func sandboxDeps(target sandboxTarget, deps cliDeps) hardenshed.SandboxDeps {
+	worktreeRoot := target.location.WorktreePath()
+	lymName := devBinLymName
+	if runtime.GOOS == "windows" {
+		lymName += ".exe"
+	}
+	devBinLym := filepath.Join(worktreeRoot, devBinDirName, lymName)
+	var primeCwd string
+	return hardenshed.SandboxDeps{
+		Root: target.root,
+		Seed: fabricengine.SeedLocalBares,
+		Clone: func(codeBare, recordsBare, container string) (string, error) {
+			hubPath, cloneCwd, err := fabriccli.CloneAndWireFromLocalBares(container, codeBare, recordsBare, sandboxShortname)
+			primeCwd = cloneCwd
+			return hubPath, err
+		},
+		CommitOverride: func(string) error { return commitSandboxConfig(primeCwd) },
+		DevBinLym:      devBinLym,
+		Head: func() (string, error) {
+			handle, err := fabricengine.Open(target.location)
+			if err != nil {
+				return "", err
+			}
+			return handle.HeadSHA()
+		},
+		Revision: func(path string) (buildvcs.Identity, error) {
+			identity, err := buildvcs.OfFile(path)
+			if errors.Is(err, fs.ErrNotExist) {
+				return buildvcs.Identity{}, nil
+			}
+			return identity, err
+		},
+		Deploy: func() error { return deps.Deploy(worktreeRoot) },
+	}
+}
+
+// commitSandboxConfig writes the sandbox's loom.yaml override into the prime at primeCwd and commits it on its records.
+// The override sets loom.yaml's friction key empty, which turns Tier 2 self-reporting off in the sandbox hub.
+func commitSandboxConfig(primeCwd string) error {
+	prime, err := lymcwd.Resolve(primeCwd)
+	if err != nil {
+		return fmt.Errorf("resolve the sandbox hub's prime: %w", err)
+	}
+	pairs := []yamlengine.KV{{Key: "friction", Value: ""}}
+	if _, err := configengine.Set(fabricengine.ConfigDirs(prime), loomengine.ConfigSpec(), configengine.LayerWorktree, pairs); err != nil {
+		return fmt.Errorf("write the sandbox hub's loom.yaml: %w", err)
+	}
+	_, _, err = fabricengine.CommitAnchoredPaths(fabricengine.NewMutations(""), prime, []string{configengine.ConfigFileRel("loom")}, "sandbox: turn Tier 2 self-reporting off", fabricengine.EnvSyncOptions())
+	return err
+}
diff --git a/internal/hardencli/cli_integration_test.go b/internal/hardencli/cli_integration_test.go
new file mode 100644
index 00000000..f2211a76
--- /dev/null
+++ b/internal/hardencli/cli_integration_test.go
@@ -0,0 +1,194 @@
+// cli_integration_test.go drives the sandbox verbs over a hub fixture: it builds a real sandbox hub through the verbs.
+
+package hardencli
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/hardenshed"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestSandboxVerbs(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	hub := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	deploys := 0
+	deps := cliDeps{Deploy: func(string) error { deploys++; return nil }}
+	pairOf := func(t *testing.T, slug, recipe string) *lymcwd.Location {
+		t.Helper()
+		hubforge.AddPair(t, hub, slug)
+		location, err := lymcwd.ResolveWorktree(hub.PairCodeWorktree(slug))
+		if err != nil {
+			t.Fatalf("ResolveWorktree(%s) = %v; want nil", hub.PairCodeWorktree(slug), err)
+		}
+		if recipe != "" {
+			if err := shedrun.WriteSeed(location, shedrun.SelfRunID, shedrun.Seed{Recipe: recipe, Driver: shedrun.DriverGo}); err != nil {
+				t.Fatalf("WriteSeed(%s) = %v; want nil", recipe, err)
+			}
+		}
+		return location
+	}
+	// run executes `lym harden sandbox <verb>` in the worktree and returns the exit code and the last JSON line.
+	run := func(t *testing.T, location *lymcwd.Location, verb string) (int, map[string]any) {
+		t.Helper()
+		var out bytes.Buffer
+		code := clihelp.ExecuteIn(newCommand(deps), location.AnchorPath(), &out, []string{"sandbox", verb})
+		lines := strings.Split(strings.TrimSpace(out.String()), "\n")
+		var answer map[string]any
+		if err := json.Unmarshal([]byte(lines[len(lines)-1]), &answer); err != nil {
+			t.Fatalf("`harden sandbox %s` printed %q; want a JSON answer: %v", verb, out.String(), err)
+		}
+		return code, answer
+	}
+	requireRefused := func(t *testing.T, location *lymcwd.Location, verb string) {
+		t.Helper()
+		code, answer := run(t, location, verb)
+		if message, _ := answer["error"].(string); code == 0 || !strings.Contains(message, notHardenerWayForward) {
+			t.Errorf("`harden sandbox %s` = exit %d, %v; want a refusal naming %q", verb, code, answer, notHardenerWayForward)
+		}
+	}
+
+	hardener := pairOf(t, "hardened", shedrun.RecipeHardener)
+	root := hardenshed.SandboxRoot(hardener.WorktreePath())
+	beside := filepath.Join(filepath.Dir(root), "beside-the-root")
+	if err := os.MkdirAll(beside, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	var hubPath string
+	if !t.Run("new builds a wired hub under the root and prints its path and the .dev-bin lym", func(t *testing.T) {
+		code, answer := run(t, hardener, "new")
+		if code != 0 {
+			t.Fatalf("`harden sandbox new` = exit %d, %v; want 0", code, answer)
+		}
+		hubPath, _ = answer["hub"].(string)
+		lym, _ := answer["lym"].(string)
+		if !strings.HasPrefix(hubPath, root+string(filepath.Separator)) {
+			t.Errorf("hub = %q; want a path under the sandbox root %q", hubPath, root)
+		}
+		if want := filepath.Join(hardener.WorktreePath(), ".dev-bin"); filepath.Dir(lym) != want {
+			t.Errorf("lym = %q; want a binary in %q", lym, want)
+		}
+		if deploys != 1 {
+			t.Errorf("deploys = %d; want 1, since no .dev-bin lym was built yet", deploys)
+		}
+		overrides, err := filepath.Glob(filepath.Join(hubPath, "*", "_lym", "config", "loom.yaml"))
+		// The hub's board directory holds a loom.yaml of its own, which is not the prime's.
+		overrides = slices.DeleteFunc(overrides, func(path string) bool {
+			return strings.Contains(path, string(filepath.Separator)+lymdirs.BoltDirName+string(filepath.Separator))
+		})
+		if err != nil || len(overrides) == 0 {
+			t.Fatalf("Glob(the hub's prime loom.yaml) = %v, %v; want the committed override", overrides, err)
+		}
+		holdsOverride := slices.ContainsFunc(overrides, func(path string) bool {
+			contents, err := os.ReadFile(path)
+			var document struct {
+				Friction *string `yaml:"friction"`
+			}
+			return err == nil && yaml.Unmarshal(contents, &document) == nil && document.Friction != nil && *document.Friction == ""
+		})
+		if !holdsOverride {
+			t.Errorf("none of %v holds the friction key empty; want the committed override", overrides)
+		}
+	}) {
+		return
+	}
+
+	if !t.Run("list shows the hub a second command made", func(t *testing.T) {
+		code, answer := run(t, hardener, "list")
+		hubs, _ := answer["hubs"].([]any)
+		if code != 0 || len(hubs) != 1 || hubs[0] != hubPath {
+			t.Errorf("`harden sandbox list` = exit %d, %v; want exit 0 listing %q", code, answer, hubPath)
+		}
+	}) {
+		return
+	}
+
+	if !t.Run("clear ends a process naming the root, removes the hubs and leaves a directory beside the root", func(t *testing.T) {
+		// The process scan reads /proc, so only Linux has an orphan to end.
+		var orphan *exec.Cmd
+		exited := make(chan struct{})
+		if runtime.GOOS == "linux" {
+			// The root is the script's $0, so the process names it on its command line.
+			// Its working directory need not, since /proc reports the target of a link along the path.
+			orphan = exec.Command("sh", "-c", "while :; do sleep 1; done", root)
+			if err := orphan.Start(); err != nil {
+				t.Fatalf("start the orphan under %q: %v", root, err)
+			}
+			t.Cleanup(func() { _ = orphan.Process.Kill() })
+			go func() {
+				_ = orphan.Wait()
+				close(exited)
+			}()
+		}
+		code, answer := run(t, hardener, "clear")
+		if code != 0 {
+			t.Fatalf("`harden sandbox clear` = exit %d, %v; want 0", code, answer)
+		}
+		if orphan != nil {
+			select {
+			case <-exited:
+			case <-time.After(10 * time.Second):
+				t.Errorf("the orphan process %d still runs after `harden sandbox clear`; want it ended", orphan.Process.Pid)
+			}
+			ended, _ := answer["ended"].([]any)
+			reported := slices.ContainsFunc(ended, func(entry any) bool {
+				fields, _ := entry.(map[string]any)
+				pid, _ := fields["pid"].(float64)
+				return int(pid) == orphan.Process.Pid
+			})
+			if !reported {
+				t.Errorf("`harden sandbox clear` ended %v; want it to report process %d", ended, orphan.Process.Pid)
+			}
+		}
+		if _, err := os.Stat(hubPath); !os.IsNotExist(err) {
+			t.Errorf("Stat(%q) = %v; want the hub removed", hubPath, err)
+		}
+		if hubs, err := hardenshed.ListSandbox(root); err != nil || len(hubs) != 0 {
+			t.Errorf("ListSandbox() = %v, %v; want no hub", hubs, err)
+		}
+		if _, err := os.Stat(beside); err != nil {
+			t.Errorf("Stat(%q) = %v; want the directory beside the root untouched", beside, err)
+		}
+	}) {
+		return
+	}
+
+	t.Run("every verb is refused in a darn worktree and in one with no seed", func(t *testing.T) {
+		for _, location := range []*lymcwd.Location{pairOf(t, "darned", shedrun.RecipeDarn), pairOf(t, "unseeded", "")} {
+			for _, verb := range []string{"new", "list", "clear"} {
+				requireRefused(t, location, verb)
+			}
+		}
+	})
+
+	t.Run("a worktree holding a root but no hardener seed may clear it and may not make or list", func(t *testing.T) {
+		location := pairOf(t, "rooted", "")
+		if err := os.MkdirAll(hardenshed.SandboxRoot(location.WorktreePath()), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if code, answer := run(t, location, "clear"); code != 0 {
+			t.Errorf("`harden sandbox clear` = exit %d, %v; want 0 over an existing root", code, answer)
+		}
+		requireRefused(t, location, "new")
+		requireRefused(t, location, "list")
+	})
+}
