@@ -0,0 +1,153 @@
+// fixture_test.go holds the fakes the package's tests share: a real shuttle runner over the shuttlefake reed and engine behind a recording starter and stopper, an in-memory record store and a scripted clock.
+
+package gatefixer
+
+import (
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/shuttlefake"
+)
+
+// fakeClock is a clock whose time starts fixed and advances only when Sleep is called or a test sets now.
+type fakeClock struct {
+	now time.Time
+}
+
+func (c *fakeClock) Now() time.Time        { return c.now }
+func (c *fakeClock) Sleep(d time.Duration) { c.now = c.now.Add(d) }
+
+// recordingStarter starts through inner and records every spec it was handed; a non-nil err makes Start fail before inner runs.
+type recordingStarter struct {
+	inner Starter
+	err   error
+	specs []shuttleengine.Spec
+}
+
+func (s *recordingStarter) Start(spec shuttleengine.Spec) (*shuttleengine.Run, error) {
+	s.specs = append(s.specs, spec)
+	if s.err != nil {
+		return nil, s.err
+	}
+	return s.inner.Start(spec)
+}
+
+// recordingStopper records every guid it was asked to stop and fails with err when set.
+type recordingStopper struct {
+	mu    sync.Mutex
+	guids []string
+	err   error
+}
+
+func (s *recordingStopper) StopStrand(guid string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.guids = append(s.guids, guid)
+	return s.err
+}
+
+// memoryStore is a Store over a slice; a non-nil liveErr or saveErr makes that call fail.
+type memoryStore struct {
+	records []*Record
+	liveErr error
+	saveErr error
+}
+
+func (s *memoryStore) Live() (*Record, error) {
+	if s.liveErr != nil {
+		return nil, s.liveErr
+	}
+	for i := len(s.records) - 1; i >= 0; i-- {
+		if s.records[i].Status == "" {
+			return s.records[i], nil
+		}
+	}
+	return nil, nil
+}
+
+func (s *memoryStore) Save(rec *Record) error {
+	if s.saveErr != nil {
+		return s.saveErr
+	}
+	for i, existing := range s.records {
+		if existing.StrandGUID == rec.StrandGUID {
+			s.records[i] = rec
+			return nil
+		}
+	}
+	s.records = append(s.records, rec)
+	return nil
+}
+
+// fixture is a fully wired Deps over fakes, with the store and the spec a spawn takes.
+type fixture struct {
+	deps      Deps
+	reed      *shuttlefake.Reed
+	engine    *shuttlefake.Engine
+	starter   *recordingStarter
+	stopper   *recordingStopper
+	clock     *fakeClock
+	store     *memoryStore
+	spec      Spec
+	replyPath string
+	// registered holds the guid of every Register call.
+	registered []string
+}
+
+// newFixture returns a fixture whose starter runs a real shuttle runner over the shuttlefake reed and engine, with the clock at the Unix epoch.
+func newFixture(t *testing.T) *fixture {
+	t.Helper()
+	anchor := t.TempDir()
+	reed := &shuttlefake.Reed{}
+	engine := &shuttlefake.Engine{}
+	shuttleCfg := shuttleengine.Config{RunDir: t.TempDir(), RunTimeoutMin: 60, StartupTimeoutS: 30}
+	runner := shuttleengine.NewRunner(reed, shuttlefake.EngineSet(engine), anchor, anchor, shuttleCfg)
+
+	fx := &fixture{
+		reed:      reed,
+		engine:    engine,
+		starter:   &recordingStarter{inner: runner},
+		stopper:   &recordingStopper{},
+		clock:     &fakeClock{now: time.Unix(0, 0)},
+		store:     &memoryStore{},
+		replyPath: filepath.Join(t.TempDir(), "reply.md"),
+	}
+	fx.deps = Deps{
+		Starter:    fx.starter,
+		Stopper:    fx.stopper,
+		Reed:       reed,
+		Engines:    shuttlefake.EngineSet(engine),
+		ShuttleCfg: shuttleCfg,
+		AnchorRoot: anchor,
+		Clock:      fx.clock,
+		Register: func(guid string) error {
+			fx.registered = append(fx.registered, guid)
+			return nil
+		},
+	}
+	fx.spec = Spec{
+		Prompt:      []byte("fix the failures"),
+		ReportPath:  "/lym/report.md",
+		ReplyPath:   fx.replyPath,
+		Role:        RoleGateFixer,
+		ModelChoice: shuttleengine.ModelChoice{Model: "fixer-model"},
+		Skills:      []string{"scribe:prose"},
+		Segment:     segmentcolor.Webster,
+		Timeout:     30 * time.Minute,
+	}
+	return fx
+}
+
+// spawn spawns the fixture's fixer and returns its record.
+func (fx *fixture) spawn(t *testing.T) *Record {
+	t.Helper()
+	rec, spawned, err := SpawnOrAttach(fx.deps, fx.store, fx.spec)
+	if err != nil || !spawned {
+		t.Fatalf("SpawnOrAttach() = _, %v, %v; want a spawn", spawned, err)
+	}
+	return rec
+}
diff --git a/internal/gatefixer/prompt.go b/internal/gatefixer/prompt.go
new file mode 100644
index 00000000..190274bc
--- /dev/null
+++ b/internal/gatefixer/prompt.go
@@ -0,0 +1,101 @@
+// prompt.go renders a fixer's prompt: the shared cold frame joined ahead of one caller body stencil and filled from told values.
+
+package gatefixer
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/editdirective"
+	"github.com/Knatte18/loomyard/internal/friction"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/parentdirective"
+	"github.com/Knatte18/loomyard/internal/pattern"
+	"github.com/Knatte18/loomyard/internal/stencil"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+)
+
+// FrameStencil is the name of the shared cold frame every fixer prompt opens with.
+const FrameStencil = "gatefix-frame-cold"
+
+// patternDirectiveMarker is the frame's optional marker the PATTERN directive fills.
+const patternDirectiveMarker = "pattern_directive"
+
+// PromptInputs is what RenderPrompt fills the frame and one body stencil from.
+type PromptInputs struct {
+	// StencilsDir is the told stencils directory every stencil is read from.
+	StencilsDir string
+	// BodyStencil names the caller body stencil joined behind the frame.
+	BodyStencil string
+	// BodyValues are the body's marker values; a key naming the report or reply path is overwritten by the frame's own.
+	BodyValues map[string]string
+	// ReportPath is the report the fixer reads, and ReplyPath the reply file it writes; both are required.
+	ReportPath string
+	ReplyPath  string
+	// RepoRoot and PatternChanges render the PATTERN directive.
+	RepoRoot       string
+	PatternChanges []string
+	// ParentName renders the parent directive; an empty one renders its no-parent variant.
+	ParentName string
+	// NotePath is the friction note path, empty when friction capture is off.
+	NotePath string
+}
+
+// RenderPrompt reads FrameStencil and in.BodyStencil from in.StencilsDir, joins them frame first and fills the result.
+// The report and reply paths and every body value are filled, with the frame's own paths winning over a body value of the same key, beside the PATTERN, parent, edit and friction directives.
+// It refuses an empty ReportPath or ReplyPath, and returns an error for a stencil that cannot be read or a directive that cannot be rendered.
+// A friction directive that cannot be rendered is logged and left out.
+func RenderPrompt(in PromptInputs) ([]byte, error) {
+	if strings.TrimSpace(in.ReportPath) == "" {
+		return nil, fmt.Errorf("gatefixer: render the %s prompt: ReportPath is empty", in.BodyStencil)
+	}
+	if strings.TrimSpace(in.ReplyPath) == "" {
+		return nil, fmt.Errorf("gatefixer: render the %s prompt: ReplyPath is empty", in.BodyStencil)
+	}
+
+	frame, err := stencilstore.Read(in.StencilsDir, FrameStencil)
+	if err != nil {
+		return nil, fmt.Errorf("gatefixer: read the fixer frame: %w", err)
+	}
+	body, err := stencilstore.Read(in.StencilsDir, in.BodyStencil)
+	if err != nil {
+		return nil, fmt.Errorf("gatefixer: read the fixer body: %w", err)
+	}
+	template := []byte(stencil.StripLeadingComment(string(frame)) + "\n\n" + stencil.StripLeadingComment(string(body)))
+
+	patternDirective, err := pattern.Directive(in.RepoRoot, in.StencilsDir, pattern.RoleImplementer, in.PatternChanges)
+	if err != nil {
+		return nil, fmt.Errorf("gatefixer: the %s prompt's PATTERN directive: %w", in.BodyStencil, err)
+	}
+	parentDirective, err := parentdirective.Directive(in.StencilsDir, in.ParentName, false)
+	if err != nil {
+		return nil, fmt.Errorf("gatefixer: the %s prompt's parent directive: %w", in.BodyStencil, err)
+	}
+	editDirective, err := editdirective.Directive(in.StencilsDir)
+	if err != nil {
+		return nil, fmt.Errorf("gatefixer: the %s prompt's edit directive: %w", in.BodyStencil, err)
+	}
+	frictionDirective, err := friction.Directive(in.NotePath, in.StencilsDir, friction.RoleImplementer)
+	if err != nil {
+		logger.Warn("gatefixer: friction directive failed, continuing without one", "stencil", in.BodyStencil, "error", err)
+		frictionDirective = ""
+	}
+
+	values := make(map[string]string, len(in.BodyValues)+6)
+	for key, value := range in.BodyValues {
+		values[key] = value
+	}
+	values["report_path"] = in.ReportPath
+	values["reply_path"] = in.ReplyPath
+	values[patternDirectiveMarker] = patternDirective
+	values[parentdirective.MarkerName] = parentDirective
+	values[editdirective.MarkerName] = editDirective
+	values[friction.MarkerName] = frictionDirective
+
+	friction.WarnIfMarkerAbsent(template, FrameStencil, frictionDirective)
+	prompt, err := stencil.FillOptional(template, values, []string{patternDirectiveMarker, friction.MarkerName, parentdirective.MarkerName})
+	if err != nil {
+		return nil, fmt.Errorf("gatefixer: fill the %s prompt: %w", in.BodyStencil, err)
+	}
+	return prompt, nil
+}
diff --git a/internal/gatefixer/prompt_test.go b/internal/gatefixer/prompt_test.go
new file mode 100644
index 00000000..6e1ac9fc
--- /dev/null
+++ b/internal/gatefixer/prompt_test.go
@@ -0,0 +1,130 @@
+// prompt_test.go covers RenderPrompt over the shipped frame and a one-marker test body: the values it fills, the directives it renders and the inputs it refuses.
+
+package gatefixer
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/parentdirective"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+	"github.com/Knatte18/loomyard/internal/testkit/stencilkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// testBodyStencil is the caller body the test writes into the seeded stencils directory: one marker.
+const testBodyStencil = "gatefix-body-test"
+
+// seededInputs returns the inputs of a render over a seeded stencils directory holding the test body.
+func seededInputs(t *testing.T) PromptInputs {
+	t.Helper()
+	dir := stencilkit.Seed(t)
+	if err := os.WriteFile(stencilstore.Path(dir, testBodyStencil), []byte("The body marker is {{.body_marker}}.\n"), 0o644); err != nil {
+		t.Fatalf("write the test body: %v", err)
+	}
+	return PromptInputs{
+		StencilsDir: dir,
+		BodyStencil: testBodyStencil,
+		BodyValues:  map[string]string{"body_marker": "BODYVALUE"},
+		ReportPath:  "/lym/report.md",
+		ReplyPath:   "/lym/reply.md",
+	}
+}
+
+// TestRenderPrompt pins the values the frame and body are filled with, the parent and friction directives' two variants, and each refusal.
+func TestRenderPrompt(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("FillsThePathsAndTheBodyValue", func(t *testing.T) {
+		t.Parallel()
+		text, err := RenderPrompt(seededInputs(t))
+		if err != nil {
+			t.Fatalf("RenderPrompt() error = %v; want nil", err)
+		}
+		for _, want := range []string{"/lym/report.md", "/lym/reply.md", "The body marker is BODYVALUE."} {
+			if !strings.Contains(string(text), want) {
+				t.Errorf("RenderPrompt() lacks %q", want)
+			}
+		}
+		if strings.Contains(string(text), "{{") {
+			t.Errorf("RenderPrompt() holds an unfilled marker")
+		}
+	})
+
+	t.Run("BodyValueNamedReportPathIsOverwritten", func(t *testing.T) {
+		t.Parallel()
+		in := seededInputs(t)
+		in.BodyValues["report_path"] = "/body/report.md"
+		text, err := RenderPrompt(in)
+		if err != nil {
+			t.Fatalf("RenderPrompt() error = %v; want nil", err)
+		}
+		if !strings.Contains(string(text), "/lym/report.md") || strings.Contains(string(text), "/body/report.md") {
+			t.Errorf("RenderPrompt() = %q; want the frame's report path and not the body's", text)
+		}
+	})
+
+	t.Run("ParentDirectiveTakesItsNamedAndNoParentVariants", func(t *testing.T) {
+		t.Parallel()
+		in := seededInputs(t)
+		none, err := parentdirective.Directive(in.StencilsDir, "", false)
+		if err != nil {
+			t.Fatalf("parentdirective.Directive(no parent) = %v", err)
+		}
+		named, err := parentdirective.Directive(in.StencilsDir, "ly:orch", false)
+		if err != nil {
+			t.Fatalf("parentdirective.Directive(named) = %v", err)
+		}
+
+		text, err := RenderPrompt(in)
+		if err != nil || !strings.Contains(string(text), none) {
+			t.Fatalf("RenderPrompt(no parent) = %v; want the no-parent directive %q", err, none)
+		}
+		in.ParentName = "ly:orch"
+		text, err = RenderPrompt(in)
+		if err != nil || !strings.Contains(string(text), named) || strings.Contains(string(text), none) {
+			t.Errorf("RenderPrompt(named parent) = %v; want the named directive %q and not the no-parent one", err, named)
+		}
+	})
+
+	t.Run("FrictionDirectiveRendersOnlyWithANotePath", func(t *testing.T) {
+		t.Parallel()
+		in := seededInputs(t)
+		without, err := RenderPrompt(in)
+		if err != nil {
+			t.Fatalf("RenderPrompt() error = %v; want nil", err)
+		}
+		in.NotePath = filepath.Join("/lym", "friction", "note.md")
+		with, err := RenderPrompt(in)
+		if err != nil {
+			t.Fatalf("RenderPrompt(NotePath) error = %v; want nil", err)
+		}
+		if !strings.Contains(string(with), in.NotePath) || strings.Contains(string(without), in.NotePath) {
+			t.Errorf("note path present with a NotePath = %v, without = %v; want present only with it", strings.Contains(string(with), in.NotePath), strings.Contains(string(without), in.NotePath))
+		}
+	})
+
+	refusals := []struct {
+		name     string
+		mutate   func(in *PromptInputs)
+		wantText string
+	}{
+		{"EmptyReplyPath", func(in *PromptInputs) { in.ReplyPath = "" }, "ReplyPath"},
+		{"EmptyReportPath", func(in *PromptInputs) { in.ReportPath = "" }, "ReportPath"},
+		{"MissingBodyStencil", func(in *PromptInputs) { in.BodyStencil = "gatefix-body-absent" }, "gatefix-body-absent"},
+	}
+	for _, tt := range refusals {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			in := seededInputs(t)
+			tt.mutate(&in)
+			text, err := RenderPrompt(in)
+			if err == nil || text != nil || !strings.Contains(err.Error(), tt.wantText) {
+				t.Errorf("RenderPrompt() = %q, %v; want a refusal naming %q", text, err, tt.wantText)
+			}
+		})
+	}
+}
diff --git a/internal/gatefixer/record.go b/internal/gatefixer/record.go
new file mode 100644
index 00000000..60feb4a7
--- /dev/null
+++ b/internal/gatefixer/record.go
@@ -0,0 +1,55 @@
+// record.go declares the record a caller keeps of one spawned fixer strand and the store seam it keeps it in.
+
+package gatefixer
+
+// The statuses a Record takes once its fixer ends; a live record has none.
+const (
+	// StatusRunning is what a wait reports when it elapsed before the fixer ended.
+	StatusRunning = "running"
+	// StatusDone is the status of a fixer that wrote its reply file.
+	StatusDone = "done"
+	// StatusDead is the status of a fixer that ended without a reply, for a DeadReason.
+	StatusDead = "dead"
+)
+
+// The reasons a fixer ends dead.
+const (
+	// DeadReasonAsking is a fixer whose newest turn ended with no reply written.
+	DeadReasonAsking = "asking"
+	// DeadReasonTimeout is a fixer still without a reply when its timeout passed.
+	DeadReasonTimeout = "timeout"
+	// DeadReasonDied is a fixer whose strand is gone.
+	DeadReasonDied = "died"
+)
+
+// Record is what a caller keeps of one spawned fixer strand.
+// A record is live while Status is empty.
+type Record struct {
+	// StrandGUID identifies the reed strand the fixer runs in.
+	StrandGUID string `json:"strandGuid"`
+	// SessionID and Engine identify the fixer's session and the engine it ran under.
+	SessionID string `json:"sessionId,omitempty"`
+	Engine    string `json:"engine,omitempty"`
+	// SpawnedAt is the spawn time in RFC 3339, from which the timeout runs.
+	SpawnedAt string `json:"spawnedAt"`
+	// ShuttleRunDir is the fixer's shuttle run directory, removed once the fixer is done.
+	ShuttleRunDir string `json:"shuttleRunDir,omitempty"`
+	// EventsPath and EventsOffset locate the fixer's turn events after its skill-load turns.
+	EventsPath   string `json:"eventsPath,omitempty"`
+	EventsOffset int64  `json:"eventsOffset,omitempty"`
+	// ReportPath and ReplyPath are the report the fixer reads and the reply file it writes.
+	ReportPath string `json:"reportPath,omitempty"`
+	ReplyPath  string `json:"replyPath,omitempty"`
+	// Status is empty while the fixer runs, then StatusDone or StatusDead.
+	Status string `json:"status,omitempty"`
+	// DeadReason is set only when Status is StatusDead.
+	DeadReason string `json:"deadReason,omitempty"`
+}
+
+// Store is the caller's store of fixer records.
+type Store interface {
+	// Live returns the newest record with no terminal status, and nil when there is none.
+	Live() (*Record, error)
+	// Save appends rec, or rewrites the record of rec.StrandGUID.
+	Save(rec *Record) error
+}
diff --git a/internal/gatefixer/registrar.go b/internal/gatefixer/registrar.go
new file mode 100644
index 00000000..335190e7
--- /dev/null
+++ b/internal/gatefixer/registrar.go
@@ -0,0 +1,35 @@
+// registrar.go builds the seam that registers a spawned fixer's pane process with runproc.
+
+package gatefixer
+
+import (
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// Registrar returns the Deps.Register seam for a fixer under role: it finds the strand in reed's strand table and registers its pane process under owner in runProcDir, so runproc's end verbs stop the fixer with the rest of its run.
+// It returns nil for an empty owner, which leaves the strand unregistered, as a caller outside a hub or on the prime has no pair to own it.
+// A strand absent from the table, or with no pane process, is an error.
+func Registrar(reed shuttleengine.ReedOps, runProcDir, owner, role string) func(guid string) error {
+	if owner == "" {
+		return nil
+	}
+	return func(guid string) error {
+		status, err := reed.Status()
+		if err != nil {
+			return fmt.Errorf("gatefixer: reed status: %w", err)
+		}
+		for _, strand := range status.Strands {
+			if strand.GUID != guid {
+				continue
+			}
+			if strand.PanePID == 0 {
+				return fmt.Errorf("gatefixer: strand %s has no live pane process to register", guid)
+			}
+			return runproc.Register(runProcDir, owner, runproc.ChildRecord(strand.PanePID, role, nil))
+		}
+		return fmt.Errorf("gatefixer: strand %s is not in reed's strand table", guid)
+	}
+}
diff --git a/internal/gatefixer/registrar_test.go b/internal/gatefixer/registrar_test.go
new file mode 100644
index 00000000..9988a5b9
--- /dev/null
+++ b/internal/gatefixer/registrar_test.go
@@ -0,0 +1,108 @@
+// registrar_test.go covers Registrar: the pane process a live strand registers under its owner and role, and the cases that register nothing.
+
+package gatefixer
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/reedengine"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/testkit/shuttlefake"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// registeredRecords decodes the record files under owner in dir, reading them directly since runproc's own read prunes a record whose process is gone.
+func registeredRecords(t *testing.T, dir, owner string) []runproc.Record {
+	t.Helper()
+	files, err := os.ReadDir(filepath.Join(dir, owner))
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		t.Fatalf("read %s: %v", filepath.Join(dir, owner), err)
+	}
+	var records []runproc.Record
+	for _, file := range files {
+		if filepath.Ext(file.Name()) != ".json" {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(dir, owner, file.Name()))
+		if err != nil {
+			t.Fatalf("read record %s: %v", file.Name(), err)
+		}
+		var rec runproc.Record
+		if err := json.Unmarshal(data, &rec); err != nil {
+			t.Fatalf("decode record %s: %v", file.Name(), err)
+		}
+		records = append(records, rec)
+	}
+	return records
+}
+
+// TestRegistrar pins the registration of a live strand's pane process, the nil seam for an empty owner, and the errors that register nothing.
+func TestRegistrar(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const owner = "pair-slug"
+
+	t.Run("LiveStrandRegistersItsPanePidUnderTheOwnerAndRole", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		pid := os.Getpid()
+		reed := &shuttlefake.Reed{Strands: []reedengine.StrandStatus{
+			{GUID: "other", Live: true, PanePID: pid + 1},
+			{GUID: "target", Live: true, PanePID: pid},
+		}}
+
+		register := Registrar(reed, dir, owner, RoleGateFixer)
+		if register == nil {
+			t.Fatal("Registrar() = nil; want a seam")
+		}
+		if err := register("target"); err != nil {
+			t.Fatalf("register() error = %v; want nil", err)
+		}
+		records := registeredRecords(t, dir, owner)
+		if len(records) != 1 || records[0].PID != pid || records[0].Role != RoleGateFixer {
+			t.Errorf("records = %+v; want one record of pid %d under role %q", records, pid, RoleGateFixer)
+		}
+	})
+
+	t.Run("EmptyOwnerReturnsANilSeam", func(t *testing.T) {
+		t.Parallel()
+		if register := Registrar(&shuttlefake.Reed{}, t.TempDir(), "", RoleGateFixer); register != nil {
+			t.Error("Registrar() with an empty owner returned a seam; want nil")
+		}
+	})
+
+	statusErr := errors.New("reed unreachable")
+	errorRows := []struct {
+		name    string
+		reed    *shuttlefake.Reed
+		wantErr error
+	}{
+		{"AbsentStrandIsAnError", &shuttlefake.Reed{Strands: []reedengine.StrandStatus{{GUID: "other", Live: true, PanePID: 1}}}, nil},
+		{"StrandWithNoPanePidIsAnError", &shuttlefake.Reed{Strands: []reedengine.StrandStatus{{GUID: "target", Live: true}}}, nil},
+		{"StatusErrorPropagates", &shuttlefake.Reed{StatusErr: statusErr}, statusErr},
+	}
+	for _, tt := range errorRows {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			dir := t.TempDir()
+			err := Registrar(tt.reed, dir, owner, RoleGateFixer)("target")
+			if err == nil {
+				t.Fatal("register() error = nil; want an error")
+			}
+			if tt.wantErr != nil && !errors.Is(err, tt.wantErr) {
+				t.Errorf("register() error = %v; want it to wrap %v", err, tt.wantErr)
+			}
+			if records := registeredRecords(t, dir, owner); len(records) != 0 {
+				t.Errorf("records = %+v; want none registered", records)
+			}
+		})
+	}
+}
diff --git a/internal/gatefixer/roles.go b/internal/gatefixer/roles.go
new file mode 100644
index 00000000..5541813e
--- /dev/null
+++ b/internal/gatefixer/roles.go
@@ -0,0 +1,27 @@
+// roles.go declares the reed strand roles a fixer runs under and the check that a role is one of them.
+
+package gatefixer
+
+import "github.com/Knatte18/loomyard/internal/agentname"
+
+const (
+	// RoleGateFixer is the strand role of a fixer a writer's or an agent's gate hands its failure to.
+	RoleGateFixer = "gate-fixer"
+	// RoleVerifyFixer is the strand role of the cold fixer webster's verify gate escalates a failure to.
+	RoleVerifyFixer = "verify-fixer"
+)
+
+// Roles returns every fixer role, RoleGateFixer first.
+func Roles() []string {
+	return []string{RoleGateFixer, RoleVerifyFixer}
+}
+
+// IsFixerRole reports whether role is a fixer role or a numbered form of one, such as "gate-fixer-2".
+func IsFixerRole(role string) bool {
+	for _, fixerRole := range Roles() {
+		if agentname.MatchesRole(role, fixerRole) {
+			return true
+		}
+	}
+	return false
+}
