diff --git a/internal/testkit/tiergate/tiergate.go b/internal/testkit/tiergate/tiergate.go
new file mode 100644
index 00000000..9180f4ea
--- /dev/null
+++ b/internal/testkit/tiergate/tiergate.go
@@ -0,0 +1,71 @@
+// Package tiergate selects at run time which tiers' tests a test binary runs, so one test binary per package serves every tier.
+//
+// The selection comes from the LYM_TEST_TIER environment variable, which the hub's gate config sets on each tier:
+// one tier number, such as `1`, or an inclusive range, such as `0-2`.
+// An unset or empty variable selects tier0 alone, the offline tier a plain `go test` runs.
+// Every Test, Benchmark and Fuzz function opens with Require, which skips it when the selection does not hold its tier.
+// A test reading the variable keys the Go test cache on its value, so each tier's run of a binary is cached apart.
+package tiergate
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// EnvVar names the environment variable that carries the tier selection.
+const EnvVar = "LYM_TEST_TIER"
+
+// Selection is the inclusive range of tier numbers whose tests a run executes.
+type Selection struct {
+	// Low is the lowest selected tier.
+	Low int
+	// High is the highest selected tier, equal to Low for a single tier.
+	High int
+}
+
+// Holds reports whether tier lies in the selection.
+func (s Selection) Holds(tier int) bool {
+	return tier >= s.Low && tier <= s.High
+}
+
+// String renders the selection the way LYM_TEST_TIER spells it.
+func (s Selection) String() string {
+	if s.Low == s.High {
+		return strconv.Itoa(s.Low)
+	}
+	return fmt.Sprintf("%d-%d", s.Low, s.High)
+}
+
+// Selected returns the selection LYM_TEST_TIER names, tier0 alone when it is unset or empty.
+// A value that is neither a tier number nor a range `<low>-<high>` with low at most high is an error naming the variable and its value.
+func Selected() (Selection, error) {
+	value := strings.TrimSpace(os.Getenv(EnvVar))
+	if value == "" {
+		return Selection{}, nil
+	}
+	lowText, highText, isRange := strings.Cut(value, "-")
+	if !isRange {
+		highText = lowText
+	}
+	low, lowErr := strconv.Atoi(lowText)
+	high, highErr := strconv.Atoi(highText)
+	if lowErr != nil || highErr != nil || low < 0 || high < low {
+		return Selection{}, fmt.Errorf("tiergate: %s=%q; want a tier number such as 1 or a range such as 0-2", EnvVar, value)
+	}
+	return Selection{Low: low, High: high}, nil
+}
+
+// Require skips t unless the selection holds tier, and fails it when LYM_TEST_TIER does not parse.
+func Require(t testing.TB, tier int) {
+	t.Helper()
+	selection, err := Selected()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !selection.Holds(tier) {
+		t.Skipf("tier%d test; %s selects %s", tier, EnvVar, selection)
+	}
+}
diff --git a/internal/testkit/tiergate/tiergate_test.go b/internal/testkit/tiergate/tiergate_test.go
new file mode 100644
index 00000000..a777fe47
--- /dev/null
+++ b/internal/testkit/tiergate/tiergate_test.go
@@ -0,0 +1,125 @@
+// tiergate_test.go pins how LYM_TEST_TIER parses into a selection and how Require skips a test outside it.
+// The tests set LYM_TEST_TIER, a process-global variable, so none of them runs in parallel.
+
+package tiergate_test
+
+import (
+	"fmt"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// recordingTB stands in for a *testing.T to observe whether Require skips or fails it.
+// Fatal and Skipf end the calling goroutine, as the real ones do.
+type recordingTB struct {
+	testing.TB
+	failed  bool
+	skipped bool
+	message string
+}
+
+func (r *recordingTB) Helper() {}
+
+func (r *recordingTB) Fatal(args ...any) {
+	r.failed = true
+	r.message = fmt.Sprint(args...)
+	runtime.Goexit()
+}
+
+func (r *recordingTB) Skipf(format string, args ...any) {
+	r.skipped = true
+	runtime.Goexit()
+}
+
+func TestSelected_ParsesTheVariable(t *testing.T) {
+	tiergate.Require(t, 0)
+	tests := []struct {
+		name    string
+		value   string
+		want    tiergate.Selection
+		wantErr bool
+	}{
+		{"Unset", "", tiergate.Selection{Low: 0, High: 0}, false},
+		{"OneTier", "2", tiergate.Selection{Low: 2, High: 2}, false},
+		{"Range", "0-2", tiergate.Selection{Low: 0, High: 2}, false},
+		{"Spaces", " 1 ", tiergate.Selection{Low: 1, High: 1}, false},
+		{"Word", "tier1", tiergate.Selection{}, true},
+		{"DescendingRange", "2-0", tiergate.Selection{}, true},
+		{"Negative", "-1", tiergate.Selection{}, true},
+		{"OpenRange", "1-", tiergate.Selection{}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(tiergate.EnvVar, tt.value)
+			got, err := tiergate.Selected()
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Selected() with %q error = %v; want error %v", tt.value, err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("Selected() with %q = %+v; want %+v", tt.value, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRequire_FailsOnAMalformedSelection(t *testing.T) {
+	tiergate.Require(t, 0)
+	tests := []struct {
+		name  string
+		value string
+	}{
+		{"Word", "tier1"},
+		{"DescendingRange", "2-0"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(tiergate.EnvVar, tt.value)
+			recorder := &recordingTB{}
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				tiergate.Require(recorder, 1)
+			}()
+			<-done
+			if !recorder.failed || recorder.skipped {
+				t.Errorf("Require with %s=%q failed = %v, skipped = %v; want failed and not skipped", tiergate.EnvVar, tt.value, recorder.failed, recorder.skipped)
+			}
+			if !strings.Contains(recorder.message, tiergate.EnvVar) {
+				t.Errorf("Require with %s=%q failure message = %q; want it to name %s", tiergate.EnvVar, tt.value, recorder.message, tiergate.EnvVar)
+			}
+		})
+	}
+}
+
+func TestRequire_RunsOnlySelectedTiers(t *testing.T) {
+	tiergate.Require(t, 0)
+	tests := []struct {
+		name    string
+		value   string
+		tier    int
+		wantRun bool
+	}{
+		{"SelectedTier", "1", 1, true},
+		{"OtherTier", "1", 2, false},
+		{"InsideRange", "0-2", 2, true},
+		{"AboveRange", "0-2", 3, false},
+		{"UnsetRunsTier0", "", 0, true},
+		{"UnsetSkipsTier1", "", 1, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(tiergate.EnvVar, tt.value)
+			ran := false
+			t.Run("Inner", func(t *testing.T) {
+				tiergate.Require(t, tt.tier)
+				ran = true
+			})
+			if ran != tt.wantRun {
+				t.Errorf("Require(t, %d) with %s=%q ran = %v; want %v", tt.tier, tiergate.EnvVar, tt.value, ran, tt.wantRun)
+			}
+		})
+	}
+}
