@@ -0,0 +1,15 @@
+packages: []  # worktree-relative directories of the packages the campaign drives against its throwaway sandbox hubs, one list entry per package; an empty list halts a hardener run at Preflight
+llm_driving: false  # whether the live tests drive a billed LLM session, which turns the concurrent copies of the live gate off
+max_bounces: 7  # the soft cap of review rounds of the campaign; 0 means no review round
+hard_max_bounces: 10  # the hard cap of review rounds, which the soft cap may not pass
+reviewer: [opus, fable, sonnet]  # model-specs of the review rounds, taken in turn and cycled when the rounds outnumber them
