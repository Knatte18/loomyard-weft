+	for _, dep := range dependsOn {
+		replacement := []string{dep}
+		if dep == runEntry {
+			replacement = sinks
+		}
+		for _, slug := range replacement {
+			if !slices.Contains(repointed, slug) {
+				repointed = append(repointed, slug)
+			}
+		}
+	}
+	return repointed
