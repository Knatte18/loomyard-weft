+	data, err := os.ReadFile(shedrun.StatusFile(location, slug))
+	if errors.Is(err, fs.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("battencli: read the status of %s: %w", slug, err)
+	}
+	if done, _, _ := judgeStatus(data, "", slug); !done {
