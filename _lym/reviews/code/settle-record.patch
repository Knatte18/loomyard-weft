+// TestLaunchSpecLiterals_AreListed pins that the parity tests list the function of each production literal of a kind:
+// a launch-spec that sets a prompt, a non-empty seat table, and a seat that sets a stencil.
+// Its rows run the scan over temp-dir sources, and the RealModule row runs it over the module.
+//
+//lym:guard
+func TestLaunchSpecLiterals_AreListed(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const header = "package x\n\nimport (\n\t\"github.com/Knatte18/loomyard/internal/shuttleengine\"\n\t\"github.com/Knatte18/loomyard/internal/seatengine\"\n)\n\n"
+	// bodyLine is the line a one-line body of a row sits on.
+	const bodyLine = 8
+	specBody := `func build() shuttleengine.Spec { return shuttleengine.Spec{Prompt: "p"} }`
+	finding := func(rel, glyph, wayForward string) string {
+		return fmt.Sprintf("%s:%d: %s: %s", rel, bodyLine, glyph, wayForward)
+	}
+	tests := []struct {
+		name   string
+		rel    string
+		body   string
+		listed []string
+		want   []string
+	}{
+		{name: "UnlistedSpecSettingPrompt", rel: "internal/x/x.go", body: specBody, want: []string{finding("internal/x/x.go", "internal/x#build", specWayForward)}},
+		{name: "ListedSpecIsClear", rel: "internal/x/x.go", body: specBody, listed: []string{"internal/x#build"}},
+		{name: "SpecSettingNoPromptIsSkipped", rel: "internal/x/x.go", body: `func build() shuttleengine.Spec { return shuttleengine.Spec{OutputFiles: nil} }`},
+		{name: "ShuttleCLIIsSkipped", rel: "internal/shuttlecli/x.go", body: specBody},
+		{name: "TestkitIsSkipped", rel: "internal/testkit/x/x.go", body: specBody},
+		{name: "OrchCLIIsSkipped", rel: "internal/orchcli/x.go", body: specBody},
+		{name: "OrchEngineIsSkipped", rel: "internal/orchengine/x.go", body: specBody},
+		{
+			name: "UnlistedNonEmptyTable", rel: "internal/x/x.go",
+			body: `func build() seatengine.Table { return seatengine.Table{RolePrefix: "p"} }`,
+			want: []string{finding("internal/x/x.go", "internal/x#build", tableWayForward)},
+		},
+		{name: "EmptyTableIsSkipped", rel: "internal/x/x.go", body: `func build() seatengine.Table { return seatengine.Table{} }`},
+		{
+			name: "UnlistedPointerSeatSettingStencil", rel: "internal/x/x.go",
+			body: `func build() *seatengine.Seat { return &seatengine.Seat{Stencil: "s"} }`,
+			want: []string{finding("internal/x/x.go", "internal/x#build", seatWayForward)},
+		},
+		{name: "SeatSettingNoStencilIsSkipped", rel: "internal/x/x.go", body: `func build() seatengine.Seat { return seatengine.Seat{} }`},
+		{
+			name: "MethodGlyphNamesItsReceiver", rel: "internal/x/x.go",
+			body: `func (b *Builder) build() shuttleengine.Spec { return shuttleengine.Spec{Prompt: "p"} }`,
+			want: []string{finding("internal/x/x.go", "internal/x#Builder.build", specWayForward)},
+		},
+		{
+			name: "FunctionLiteralTakesTheEnclosingGlyph", rel: "internal/x/x.go",
+			body: `func build() { _ = func() shuttleengine.Spec { return shuttleengine.Spec{Prompt: "p"} } }`,
+			want: []string{finding("internal/x/x.go", "internal/x#build", specWayForward)},
+		},
+		{
+			name: "ListingTheEnclosingGlyphClearsAFunctionLiteral", rel: "internal/x/x.go",
+			body:   `func build() { _ = func() shuttleengine.Spec { return shuttleengine.Spec{Prompt: "p"} } }`,
+			listed: []string{"internal/x#build"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			base := t.TempDir()
+			abs := filepath.Join(base, filepath.FromSlash(tt.rel))
+			if err := os.MkdirAll(filepath.Dir(abs), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(abs, []byte(header+tt.body+"\n"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			listed := map[string]bool{}
+			for _, glyph := range tt.listed {
+				listed[glyph] = true
+			}
+			got, _ := unlistedLiterals(t, base, listed)
+			if strings.Join(got, "\n") != strings.Join(tt.want, "\n") {
+				t.Errorf("unlistedLiterals() = %q; want %q", got, tt.want)
+			}
+		})
+	}
+
+	t.Run("RealModule", func(t *testing.T) {
+		t.Parallel()
+		got, scanned := unlistedLiterals(t, scankit.Root(t), realModuleListed(t))
+		scankit.RequireFloor(t, scanned, 1, "module-wide launch-spec literal scan")
+		for _, literal := range got {
+			t.Errorf("a launch-spec literal, seat table or seat is not listed for the parity tests: %s", literal)
+		}
+	})
+}
diff --git a/internal/shuttleparity/report.go b/internal/shuttleparity/report.go
new file mode 100644
index 00000000..82f4c311
--- /dev/null
+++ b/internal/shuttleparity/report.go
@@ -0,0 +1,97 @@
+// report.go builds the manifest report of one seat.
+// The report holds both engines' manifests, what the Codex one lacks and what each engine cannot start.
+// It backs `lym shuttle manifest`.
+
+package shuttleparity
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/lymtemp"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// ManifestReport is what the engines of a set give one seat's session.
+type ManifestReport struct {
+	// Seat is the seat's strand role.
+	Seat string
+	// Manifests holds each engine's manifest by engine name.
+	Manifests map[string]shuttleengine.Manifest
+	// Missing are the compared items of the reference engine's manifest that the compared engine's lacks.
+	Missing []shuttleengine.ManifestItem
+	// Unmet names, for each engine that cannot start the seat, the requirements it does not meet.
+	Unmet map[string][]shuttleengine.Requirement
+}
+
+// Report prepares the seat called name of the seat catalog on each engine of engines and compares the manifests.
+// It runs the catalog's builders on env's stand-ins, written to a temporary directory it removes before it returns.
+// A name no built seat holds is refused.
+func Report(env SeatEnv, name string, engines shuttleengine.EngineSet, cfg shuttleengine.Config) (ManifestReport, error) {
+	return report(env, seatTables, name, engines, cfg)
+}
+
+// report is Report over the seat tables of tables.
+func report(env SeatEnv, tables []seatTable, name string, engines shuttleengine.EngineSet, cfg shuttleengine.Config) (ManifestReport, error) {
+	dir, err := lymtemp.MkdirTemp("manifest-report-*")
+	if err != nil {
+		return ManifestReport{}, fmt.Errorf("shuttleparity: make the report's temporary directory: %w; way forward: transient, re-run the verb", err)
+	}
+	defer os.RemoveAll(dir)
+	env.Dir = dir
+
+	seats, failures := seatsOf(env, tables)
+	seat, err := LookupSeat(seats, failures, name)
+	if err != nil {
+		return ManifestReport{}, err
+	}
+
+	specs := make(map[string]shuttleengine.Spec, len(engines.Names()))
+	for _, engineName := range engines.Names() {
+		spec, err := seat.Specs(engineName)
+		if err != nil {
+			return ManifestReport{}, err
+		}
+		specs[engineName] = spec
+	}
+	manifests, err := PrepareEach(engines, specs, env.StencilsDir, dir, cfg)
+	if err != nil {
+		return ManifestReport{}, err
+	}
+
+	unmet := map[string][]shuttleengine.Requirement{}
+	for _, engineName := range engines.Names() {
+		engine, err := engines.Lookup(engineName)
+		if err != nil {
+			return ManifestReport{}, err
+		}
+		if required := Unmet(engine, specs[engineName]); len(required) > 0 {
+			unmet[engineName] = required
+		}
+	}
+	return ManifestReport{Seat: seat.Name, Manifests: manifests, Missing: Compare(engines, manifests), Unmet: unmet}, nil
+}
+
+// LookupSeat returns the seat of seats whose Name is name.
+// A name no seat holds is refused naming every seat and every builder error in errs,
+// so a seat missing because its builder failed points at that builder's stand-ins.
+func LookupSeat(seats []Seat, errs []error, name string) (Seat, error) {
+	for _, seat := range seats {
+		if seat.Name == name {
+			return seat, nil
+		}
+	}
+	names := make([]string, len(seats))
+	for i, seat := range seats {
+		names[i] = seat.Name
+	}
+	slices.Sort(names)
+	refusal := fmt.Errorf("shuttleparity: no seat is named %q; the seats are %s; way forward: name one of those seats", name, strings.Join(names, ", "))
+	if len(errs) == 0 {
+		return Seat{}, refusal
+	}
+	return Seat{}, errors.Join(append([]error{refusal}, errs...)...)
+}
diff --git a/internal/shuttleparity/report_test.go b/internal/shuttleparity/report_test.go
new file mode 100644
index 00000000..85c72076
--- /dev/null
+++ b/internal/shuttleparity/report_test.go
@@ -0,0 +1,191 @@
+// report_test.go covers the manifest report of one seat over fake engines and fixture seat tables.
+
+package shuttleparity
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/agentconfig"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/lymtemp"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+	"github.com/Knatte18/loomyard/internal/testkit/shuttlefake"
+	"github.com/Knatte18/loomyard/internal/testkit/stencilkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// forkableSeatTable returns a seat table whose one seat is called seatName and forks its subagents when forks is set.
+func forkableSeatTable(seatName string, forks bool) seatTable {
+	return seatTable{Builder: "internal/x#First", Build: func(env SeatEnv) ([]seatengine.Table, error) {
+		return []seatengine.Table{{
+			RolePrefix: seatName,
+			Seats: []seatengine.Seat{{
+				Stencil:       "parity-test-bare",
+				Outputs:       []string{filepath.Join(env.Dir, "out.md")},
+				ConfigRole:    agentconfig.RoleDarn,
+				ForkSubagents: forks,
+			}},
+		}}, nil
+	}}
+}
+
+// TestReport_RemovesTheTemporaryDirectoryOnARefusal checks that a refused report leaves no report directory behind.
+// It lists the process's temporary root, which a parallel test would add to, so it does not run in parallel.
+func TestReport_RemovesTheTemporaryDirectoryOnARefusal(t *testing.T) {
+	tiergate.Require(t, 0)
+
+	stencils := stencilkit.Seed(t)
+	writeFixtureFile(t, stencilstore.Path(stencils, "parity-test-bare"), "Lead {{.seat_name}}.\n")
+	cfg := shuttleengine.Config{Agents: shuttlefake.Agents(t)}
+	failing := func(string, shuttleengine.Spec) error { return errors.New("prepare refused") }
+	tempRoot, err := lymtemp.Dir()
+	if err != nil {
+		t.Fatalf("lymtemp.Dir() error: %v", err)
+	}
+	tests := []struct {
+		name string
+		seat string
+		prep func(string, shuttleengine.Spec) error
+	}{
+		{"UnknownSeat", "nope", writesManifest(manifestOf())},
+		{"FailedPrepare", "parity", failing},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			before, err := filepath.Glob(filepath.Join(tempRoot, "manifest-report-*"))
+			if err != nil {
+				t.Fatalf("Glob: %v", err)
+			}
+			env := SeatEnv{
+				StencilsDir: stencils,
+				Location:    &lymcwd.Location{HubPath: t.TempDir(), WorktreeName: "wt", AnchorRel: "."},
+				Shortname:   "ly", Slug: "task", ParentName: "ly:orch",
+			}
+			engines := engineSetOf(newManifestEngine(true, tt.prep), newManifestEngine(true, tt.prep))
+			if _, err := report(env, []seatTable{forkableSeatTable("parity", false)}, tt.seat, engines, cfg); err == nil {
+				t.Fatal("report() error = nil; want a refusal")
+			}
+			after, err := filepath.Glob(filepath.Join(tempRoot, "manifest-report-*"))
+			if err != nil {
+				t.Fatalf("Glob: %v", err)
+			}
+			if len(after) != len(before) {
+				t.Errorf("report directories after the refusal = %v; want the %d before it", after, len(before))
+			}
+		})
+	}
+}
+
+// TestReport covers report.
+// It checks the manifests read back, what Codex lacks and the requirements an engine does not meet.
+// It also checks the refusal of an unknown seat, a builder that failed, and that the temporary directory is left empty.
+func TestReport(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const seatName = "parity"
+	const failedSeatName = "parity-failed"
+	stencils := stencilkit.Seed(t)
+	writeFixtureFile(t, stencilstore.Path(stencils, "parity-test-bare"), "Lead {{.seat_name}}.\n")
+	cfg := shuttleengine.Config{Agents: shuttlefake.Agents(t)}
+	cause := errors.New("no stand-in")
+
+	tableFor := func(forks bool) seatTable { return forkableSeatTable(seatName, forks) }
+	failingTable := seatTable{Builder: "internal/x#Second", Build: func(SeatEnv) ([]seatengine.Table, error) { return nil, cause }}
+	shared := item(shuttleengine.ChannelStandingPassage, "agents-prompt", "")
+	only := item(shuttleengine.ChannelInstructionSource, "heddle-file/agents-file", "")
+	unrun := shuttleengine.ManifestItem{Channel: shuttleengine.ChannelPluginContext, Key: "p@m/emit", Delivery: shuttleengine.DeliveryOmitted, Reason: "unrun"}
+	held := item(shuttleengine.ChannelPluginContext, "p@m/emit", "")
+
+	tests := []struct {
+		name        string
+		tables      []seatTable
+		seat        string
+		claude      shuttleengine.Manifest
+		codex       shuttleengine.Manifest
+		codexForks  bool
+		wantMissing []shuttleengine.ManifestItem
+		wantUnmet   map[string][]shuttleengine.Requirement
+		// wantErr are the parts the refusal names.
+		wantErr []string
+	}{
+		{name: "MatchingManifestsLackNothing", tables: []seatTable{tableFor(false)}, seat: seatName, claude: manifestOf(shared), codex: manifestOf(shared), codexForks: true},
+		{
+			name: "CodexLackingAnItemGivesExactlyThatItem", tables: []seatTable{tableFor(false)}, seat: seatName,
+			claude: manifestOf(shared, only), codex: manifestOf(shared), wantMissing: []shuttleengine.ManifestItem{only},
+		},
+		{name: "OmittedPluginContextLacksNothing", tables: []seatTable{tableFor(false)}, seat: seatName, claude: manifestOf(held), codex: manifestOf(unrun)},
+		{
+			name: "CodexMeetingNoRequirementIsNamedForAForksSeat", tables: []seatTable{tableFor(true)}, seat: seatName,
+			claude: manifestOf(shared), codex: manifestOf(shared),
+			wantUnmet: map[string][]shuttleengine.Requirement{ComparedEngine: {shuttleengine.RequirementForks}},
+		},
+		{name: "UnknownSeatNamesTheSeats", tables: []seatTable{tableFor(false)}, seat: "nope", wantErr: []string{"nope", seatName, "way forward"}},
+		{
+			name: "FailedBuilderCostsOnlyItsOwnSeats", tables: []seatTable{tableFor(false), failingTable}, seat: seatName,
+			claude: manifestOf(shared), codex: manifestOf(shared),
+		},
+		{
+			name: "FailedBuildersSeatIsRefusedNamingTheBuilder", tables: []seatTable{tableFor(false), failingTable}, seat: failedSeatName,
+			wantErr: []string{failedSeatName, "internal/x#Second", cause.Error(), "way forward"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			var reportDir string
+			prepares := func(m shuttleengine.Manifest) func(string, shuttleengine.Spec) error {
+				return func(runDir string, spec shuttleengine.Spec) error {
+					reportDir = filepath.Dir(runDir)
+					return writesManifest(m)(runDir, spec)
+				}
+			}
+			engines := engineSetOf(newManifestEngine(true, prepares(tt.claude)), newManifestEngine(tt.codexForks, prepares(tt.codex)))
+			env := SeatEnv{
+				StencilsDir: stencils,
+				Location:    &lymcwd.Location{HubPath: t.TempDir(), WorktreeName: "wt", AnchorRel: "."},
+				Shortname:   "ly", Slug: "task", ParentName: "ly:orch",
+			}
+
+			got, err := report(env, tt.tables, tt.seat, engines, cfg)
+			if len(tt.wantErr) > 0 {
+				if err == nil {
+					t.Fatal("report() error = nil; want a refusal")
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("report() error %q does not contain %q", err, want)
+					}
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("report() error: %v", err)
+			}
+			if got.Seat != tt.seat {
+				t.Errorf("report() seat = %q; want %q", got.Seat, tt.seat)
+			}
+			for _, engine := range []string{ReferenceEngine, ComparedEngine} {
+				if _, ok := got.Manifests[engine]; !ok {
+					t.Errorf("report() manifests = %v; want one for %s", got.Manifests, engine)
+				}
+			}
+			if len(got.Missing) != len(tt.wantMissing) || (len(got.Missing) > 0 && !reflect.DeepEqual(got.Missing, tt.wantMissing)) {
+				t.Errorf("report() missing = %+v; want %+v", got.Missing, tt.wantMissing)
+			}
+			if len(got.Unmet) != len(tt.wantUnmet) || (len(got.Unmet) > 0 && !reflect.DeepEqual(got.Unmet, tt.wantUnmet)) {
+				t.Errorf("report() unmet = %v; want %v", got.Unmet, tt.wantUnmet)
+			}
+			if _, err := os.Stat(reportDir); !errors.Is(err, os.ErrNotExist) {
+				t.Errorf("report directory %s after the report: stat error = %v; want it removed", reportDir, err)
+			}
+		})
+	}
+}
diff --git a/internal/shuttleparity/seats.go b/internal/shuttleparity/seats.go
new file mode 100644
index 00000000..5187cedc
--- /dev/null
+++ b/internal/shuttleparity/seats.go
@@ -0,0 +1,431 @@
+// seats.go holds the seat catalog: every seat table builder of production code, run on stand-ins for a run's own inputs.
+// seatsOf turns the catalog into the seats the parity test and `lym shuttle manifest` prepare on each engine.
+
+package shuttleparity
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/darnengine"
+	"github.com/Knatte18/loomyard/internal/driftengine"
+	"github.com/Knatte18/loomyard/internal/landingshed"
+	"github.com/Knatte18/loomyard/internal/languageconfig"
+	"github.com/Knatte18/loomyard/internal/lenses"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/partsparser"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// standInModel is the model every stand-in input names where a builder needs one the registry does not resolve.
+const standInModel = "stand-in"
+
+// SeatEnv is what the seat table builders run on: the worktree's configuration and stand-ins for a run's own inputs.
+type SeatEnv struct {
+	// StencilsDir and SpecsDir are the told directories the stencils and deployed specs are read from.
+	StencilsDir string
+	SpecsDir    string
+	// Dir is a directory the caller removes, where Build writes the stand-in files a builder reads.
+	Dir string
+	// Registry is the model-spec registry the builders resolve their models against.
+	Registry modelspec.Registry
+	// Location is the worktree the seats are built for.
+	Location *lymcwd.Location
+	// Dirs are the config layers of that worktree.
+	Dirs configengine.Dirs
+	// Shortname, Slug and ParentName form the seats' agent names and their parent directive.
+	Shortname  string
+	Slug       string
+	ParentName string
+}
+
+// Seat is one seat of a production seat table.
+type Seat struct {
+	// Name is the seat's strand role.
+	Name string
+	// Builder is the glyph of the builder whose table holds the seat.
+	Builder string
+	// Specs returns the spec the seat starts with on engine.
+	// The spec's model choice names the engine alone: the manifest compares what the session is given, not the model.
+	Specs func(engine string) (shuttleengine.Spec, error)
+}
+
+// seatTable is one production seat table builder of the catalog.
+type seatTable struct {
+	// Builder is the builder's glyph, such as `internal/darnengine#DarnTable`.
+	Builder string
+	// Holders are the glyphs of every function whose body holds a seatengine.Table literal,
+	// or a seatengine.Seat literal that sets Stencil, that the builder returns.
+	Holders []string
+	// Build calls the builder on env's stand-ins and returns the tables it builds.
+	Build func(env SeatEnv) ([]seatengine.Table, error)
+}
+
+// buildWayForward ends the error of a builder that failed on its stand-ins.
+const buildWayForward = "way forward: fix the stand-in inputs that this builder's seatTables entry's Build writes in internal/shuttleparity, " +
+	"since the builder ran on those stand-ins and not on a run's inputs"
+
+// seatsOf builds every table of tables on env and returns one Seat per seat of each table that built.
+// It returns beside them one error per builder that failed, so a failing builder costs only its own seats.
+func seatsOf(env SeatEnv, tables []seatTable) ([]Seat, []error) {
+	var seats []Seat
+	var failures []error
+	for _, entry := range tables {
+		built, err := entry.Build(env)
+		if err != nil {
+			failures = append(failures, fmt.Errorf("shuttleparity: builder %s: %w; %s", entry.Builder, err, buildWayForward))
+			continue
+		}
+		for _, table := range built {
+			for _, seat := range table.Seats {
+				seats = append(seats, Seat{
+					Name:    seatengine.SeatRole(table.RolePrefix, seat.Name),
+					Builder: entry.Builder,
+					Specs:   specsOf(env, table, seat.Name),
+				})
+			}
+		}
+	}
+	return seats, failures
+}
+
+// specsOf returns the function that gives the spec of the seat called seatName of table on an engine.
+func specsOf(env SeatEnv, table seatengine.Table, seatName string) func(engine string) (shuttleengine.Spec, error) {
+	return func(engine string) (shuttleengine.Spec, error) {
+		onEngine := table
+		onEngine.Seats = slices.Clone(table.Seats)
+		for i := range onEngine.Seats {
+			onEngine.Seats[i].ModelChoice = shuttleengine.ModelChoice{Engine: engine}
+		}
+		specs, err := seatengine.Specs(seatengine.Geometry{
+			WorktreeRoot:  env.Location.WorktreePath(),
+			AnchorPath:    env.Location.AnchorPath(),
+			StencilsDir:   env.StencilsDir,
+			DefaultEngine: engine,
+			ParentName:    env.ParentName,
+			Shortname:     env.Shortname,
+			Slug:          env.Slug,
+		}, onEngine)
+		if err != nil {
+			return shuttleengine.Spec{}, fmt.Errorf("shuttleparity: the specs of table %s on %s: %w", onEngine.RolePrefix, engine, err)
+		}
+		return specs[seatName], nil
+	}
+}
+
+// seatTables is the catalog: one entry per seat table builder of production code.
+var seatTables = []seatTable{
+	{Builder: "internal/darnengine#DarnTable", Holders: []string{"internal/darnengine#DarnTable"}, Build: buildDarn},
+	{Builder: "internal/landingshed#DescribeTable", Holders: []string{"internal/landingshed#describeSessionTable"}, Build: buildDescribe},
+	{Builder: "internal/landingshed#FixerTable", Holders: []string{"internal/landingshed#FixerTable"}, Build: buildFixer},
+	{Builder: "internal/landingshed#FixReviewSeatTable", Holders: []string{"internal/landingshed#fixReviewTable"}, Build: buildFixReview},
+	{
+		Builder: "internal/burlerengine#Engine.SeatTables",
+		Holders: []string{"internal/burlerengine#Profile.reviewTable", "internal/burlerengine#Profile.fixTable", "internal/burlerengine#Engine.assistSeat"},
+		Build:   buildBurler,
+	},
+	{Builder: "internal/driftengine#ExpectTable", Holders: []string{"internal/driftengine#ExpectTable"}, Build: buildExpect},
+	{Builder: "internal/driftengine#JudgeTable", Holders: []string{"internal/driftengine#JudgeTable"}, Build: buildJudge},
+	{Builder: "internal/loomengine#PartsTable", Holders: []string{"internal/loomengine#PartsTable"}, Build: buildParts},
+	{Builder: "internal/loomengine#PlanTable", Holders: []string{"internal/loomengine#PlanTable"}, Build: buildPlan},
+	{Builder: "internal/loomengine#PartsPlanTable", Holders: []string{"internal/loomengine#PartsPlanTable"}, Build: buildPartsPlan},
+	{Builder: "internal/loomengine#DiscussionTable", Holders: []string{"internal/loomengine#DiscussionTable"}, Build: buildDiscussion},
+	{Builder: "internal/loomengine#RaddleTable", Holders: []string{"internal/loomengine#RaddleTable"}, Build: buildRaddle},
+}
+
+// standInPath returns the absolute stand-in path of the file called name under env.Dir.
+func standInPath(env SeatEnv, name string) string {
+	return filepath.Join(env.Dir, name)
+}
+
+// writeStandIn writes content to path, making its directories.
+func writeStandIn(path, content string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return fmt.Errorf("write the stand-in %s: %w", path, err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		return fmt.Errorf("write the stand-in %s: %w", path, err)
+	}
+	return nil
+}
+
+// standInLocation returns a worktree under env.Dir, whose layout paths the loom builders read their input files at.
+func standInLocation(env SeatEnv) (*lymcwd.Location, error) {
+	return lymcwd.NamedWorktree(env.Dir, "stand-in-worktree")
+}
+
+// languageSkillsOf returns the language skills of env's hub.
+func languageSkillsOf(env SeatEnv) ([]string, error) {
+	language, err := languageconfig.Load(env.Dirs)
+	if err != nil {
+		return nil, err
+	}
+	return language.Skills, nil
+}
+
+// loomConfigOf returns loom's configuration with the tapestry keys a plan-review row adds.
+func loomConfigOf(env SeatEnv) (loomengine.Config, error) {
+	cfg, err := loomengine.LoadConfig(env.Dirs, "loom")
+	if err != nil {
+		return loomengine.Config{}, err
+	}
+	tapestry, err := loomengine.LoadTapestryConfig(env.Dirs, "tapestry")
+	if err != nil {
+		return loomengine.Config{}, err
+	}
+	return cfg.WithTapestry(tapestry), nil
+}
