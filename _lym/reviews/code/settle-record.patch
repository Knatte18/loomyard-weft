new file mode 100644
index 00000000..ba1a3606
--- /dev/null
+++ b/internal/shuttleengine/reinterpret.go
@@ -0,0 +1,72 @@
+// reinterpret.go carries a hub's shuttle.yaml across the change in what edit_loop_edits counts.
+// The key once counted every edit of a file and now counts only the edits that return it to earlier content.
+
+package shuttleengine
+
+import (
+	"fmt"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/yamlengine"
+)
+
+// EditLoopRepeatsReinterpretation names the change in what edit_loop_edits counts.
+// The key once counted every edit of a file and now counts only the edits that return it to earlier content.
+const EditLoopRepeatsReinterpretation = "shuttle-edit-loop-repeats"
+
+// editLoopEditsKey is the shuttle.yaml key of Config.EditLoopEdits.
+const editLoopEditsKey = "edit_loop_edits"
+
+// DropEditLoopEdits is the reinterpretation of a hub's shuttle.yaml for EditLoopRepeatsReinterpretation.
+// A count of every edit has no equivalent count of repeats.
+// A hub that set 0 turned the watch off while every edit counted and the notices were noise.
+// A 0, or a null or empty value, which loads as 0, is therefore dropped and the template's count applies.
+// That drop is returned as one rewrote line naming the way to set another count.
+// Any other value is left in the file and returned as one flagged line naming it and the way forward.
+// Only the hub can say what count of repeats such a value means.
+// A file without the key comes back unchanged with no line.
+// The rewrite takes no worktree root or anchored directory, since the key names no path.
+// A document that does not parse, or whose top level is not a mapping, returns an error marked configengine.ErrInvalid.
+func DropEditLoopEdits(existing []byte, _, _ string) (rewritten []byte, rewrote, flagged []string, err error) {
+	var values struct {
+		EditLoopEdits yaml.Node `yaml:"edit_loop_edits"`
+	}
+	if err := yaml.Unmarshal(existing, &values); err != nil {
+		return nil, nil, nil, configengine.MarkInvalid(fmt.Errorf("drop edit_loop_edits: unmarshal yaml: %w", err))
+	}
+	if values.EditLoopEdits.IsZero() {
+		return existing, nil, nil, nil
+	}
+	var count int
+	if err := values.EditLoopEdits.Decode(&count); err != nil || count != 0 {
+		line := fmt.Sprintf("%s %s kept, since it counts only the edits that return a file to content it held earlier now, "+
+			"so the value means a different count; way forward: set the count of repeats with "+
+			"lym config shuttle --layer default --set %s=<count> from the prime worktree, or drop the key to take the template's count",
+			editLoopEditsKey, describeYAMLValue(values.EditLoopEdits), editLoopEditsKey)
+		return existing, nil, []string{line}, nil
+	}
+	rewritten, _, err = yamlengine.DropKeys(existing, []string{editLoopEditsKey})
+	if err != nil {
+		return nil, nil, nil, configengine.MarkInvalid(fmt.Errorf("drop edit_loop_edits: %w", err))
+	}
+	line := fmt.Sprintf("%s dropped, since it turned the watch off while every edit counted and the notices were noise, "+
+		"so the template's count of repeats applies; way forward: set another count with lym config shuttle --layer default --set %s=<count> "+
+		"from the prime worktree", editLoopEditsKey, editLoopEditsKey)
+	return rewritten, []string{line}, nil, nil
+}
+
+// describeYAMLValue names a node's value for a message: its text when it has one, otherwise its kind.
+func describeYAMLValue(node yaml.Node) string {
+	switch {
+	case node.Value != "":
+		return node.Value
+	case node.Kind == yaml.MappingNode:
+		return "(a mapping)"
+	case node.Kind == yaml.SequenceNode:
+		return "(a sequence)"
+	default:
+		return "(an empty value)"
+	}
+}
diff --git a/internal/shuttleengine/reinterpret_test.go b/internal/shuttleengine/reinterpret_test.go
new file mode 100644
index 00000000..bbcedffe
--- /dev/null
+++ b/internal/shuttleengine/reinterpret_test.go
@@ -0,0 +1,87 @@
+// reinterpret_test.go pins the reinterpretation that drops a hub's edit_loop_edits.
+
+package shuttleengine_test
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestDropEditLoopEdits pins what the rewrite does to a hub's shuttle.yaml.
+// It drops edit_loop_edits when its value turns the watch off, a 0 or a null.
+// It keeps every other key and names the way forward in the line it reports.
+// Any other count stays in the file and is flagged with the way forward.
+// A file without the key comes back unchanged, and one that does not parse or is no mapping is an invalid-config error.
+func TestDropEditLoopEdits(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	tests := []struct {
+		name     string
+		existing string
+		want     string
+		// wantRewrote and wantFlagged are texts the one line of that list holds; the other list wants no line.
+		// Both empty wants no line at all.
+		wantRewrote string
+		wantFlagged string
+		wantErr     bool
+	}{
+		{name: "AZeroCountIsDropped", existing: "edit_loop_edits: 0\n", want: "{}\n", wantRewrote: "edit_loop_edits dropped"},
+		{name: "ANullCountIsDropped", existing: "edit_loop_edits:\n", want: "{}\n", wantRewrote: "edit_loop_edits dropped"},
+		{
+			name:        "AZeroCountIsDroppedAndOtherKeysKept",
+			existing:    "deny_python: false\nedit_loop_edits: 0\nedit_loop_window_s: 120\n",
+			want:        "deny_python: false\nedit_loop_window_s: 120\n",
+			wantRewrote: "edit_loop_edits dropped",
+		},
+		{
+			name:        "ANonZeroCountIsKeptAndFlagged",
+			existing:    "deny_python: false\nedit_loop_edits: 6\nedit_loop_window_s: 120\n",
+			want:        "deny_python: false\nedit_loop_edits: 6\nedit_loop_window_s: 120\n",
+			wantFlagged: "edit_loop_edits 6 kept",
+		},
+		{name: "AFileWithoutTheKeyIsUnchanged", existing: "deny_python: false\n", want: "deny_python: false\n"},
+		{name: "AnEmptyFileIsUnchanged", existing: "", want: ""},
+		{name: "AnUnparsableFileIsInvalid", existing: "edit_loop_edits: [\n", wantErr: true},
+		{name: "ANonMappingDocumentIsInvalid", existing: "- a\n", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, rewrote, flagged, err := shuttleengine.DropEditLoopEdits([]byte(tt.existing), "/root", "/root")
+			if tt.wantErr {
+				if !errors.Is(err, configengine.ErrInvalid) {
+					t.Errorf("DropEditLoopEdits(%q) error = %v; want one marked configengine.ErrInvalid", tt.existing, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("DropEditLoopEdits(%q) error: %v", tt.existing, err)
+			}
+			if string(got) != tt.want {
+				t.Errorf("DropEditLoopEdits(%q) = %q; want %q", tt.existing, got, tt.want)
+			}
+			assertLines(t, tt.existing, "rewrote", rewrote, tt.wantRewrote)
+			assertLines(t, tt.existing, "flagged", flagged, tt.wantFlagged)
+		})
+	}
+}
+
+// assertLines checks that lines holds nothing when want is empty.
+// Otherwise it checks for one line that holds want and lym config shuttle.
+func assertLines(t *testing.T, existing, list string, lines []string, want string) {
+	t.Helper()
+	if want == "" {
+		if len(lines) != 0 {
+			t.Errorf("DropEditLoopEdits(%q) %s = %q; want none", existing, list, lines)
+		}
+		return
+	}
+	if len(lines) != 1 || !strings.Contains(lines[0], want) || !strings.Contains(lines[0], "lym config shuttle") {
+		t.Errorf("DropEditLoopEdits(%q) %s = %q; want one line naming %q and lym config shuttle", existing, list, lines, want)
+	}
+}
