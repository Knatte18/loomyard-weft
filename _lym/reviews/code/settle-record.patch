diff --git a/internal/dobbyengine/catchup.go b/internal/dobbyengine/catchup.go
new file mode 100644
index 00000000..7285be6d
--- /dev/null
+++ b/internal/dobbyengine/catchup.go
@@ -0,0 +1,146 @@
+// catchup.go is the catch-up from origin that runs after an absence, before any act rule answer.
+// It reads and acts through seams, so the package imports no fabric or teardown package.
+
+package dobbyengine
+
+import (
+	"errors"
+	"fmt"
+)
+
+// ErrOriginUnreachable is what a catch-up's seam wraps when origin does not answer.
+// The catch-up then acts on no run, and its caller keeps the catch-up owed.
+var ErrOriginUnreachable = errors.New("dobbyengine: origin is unreachable, so the catch-up acted on no run")
+
+// CatchUpDeps is every seam a catch-up reads and acts through.
+// The hub wiring fills them, and a nil seam is a wiring error CatchUp returns at once.
+type CatchUpDeps struct {
+	// PullBolt fetches Bolt and replays the local display commits.
+	// An unreachable origin is an error wrapping ErrOriginUnreachable.
+	PullBolt func() error
+	// Register registers this machine when the registry holds no entry of its id, or checks the entry it holds.
+	// A refusal is returned from CatchUp as given.
+	Register func() error
+	// Runs lists the slugs of the local pairs the catch-up covers.
+	Runs func() ([]string, error)
+	// FetchRun fetches the run's branches from origin.
+	// An unreachable origin is an error wrapping ErrOriginUnreachable.
+	FetchRun func(slug string) error
+	// ReadRun reads the run as the fetch left it.
+	ReadRun func(slug string) (CatchUpRun, error)
+	// PushOwed pushes the run's records and then its code branch.
+	// It hands the run over itself when origin holds another machine's takeover entry, and then answers nil.
+	PushOwed func(slug string) error
+	// HandOver ends the run's processes, archives its local tips and removes its local pair; owner is the machine owning it.
+	HandOver func(slug, owner string) error
+	// ApplyPauseIntents writes this machine's pause entries from the pause intents of the runs it owns.
+	ApplyPauseIntents func(slugs []string) error
+}
+
+// CatchUpRun is what the catch-up reads of one run after the fetch.
+type CatchUpRun struct {
+	// Owner is the machine that owns the run's entry.
+	Owner string
+	// OwnedElsewhere reports whether another machine owns the run, judged through the machine registry.
+	OwnedElsewhere bool
+	// Ahead reports whether this machine holds commits of the run, on either side, that origin lacks.
+	Ahead bool
+}
+
+// CatchUpReport lists the runs a catch-up touched.
+// A caller reads every listed run as touched.
+type CatchUpReport struct {
+	// Pushed are the runs owned here whose owed commits were pushed.
+	Pushed []string
+	// HandedOver are the runs another machine owns, which were handed over.
+	HandedOver []string
+	// OwnedHere are the runs this machine owns, the pushed ones included.
+	OwnedHere []string
+}
+
+// CatchUp brings this machine's view of its runs up to origin's after an absence.
+// It pulls Bolt and registers this machine, fetches and reads every run, then acts:
+// a run owned here with commits origin lacks is pushed, a run owned elsewhere is handed over,
+// and the runs owned here get their pause entries written from their pause intents.
+// An unreachable origin at the Bolt pull or a fetch, and a registration refusal, return before any run is acted on.
+// A failed push or hand-over is joined into the returned error and the other runs go on,
+// so the caller keeps the catch-up owed.
+func CatchUp(deps CatchUpDeps) (CatchUpReport, error) {
+	var report CatchUpReport
+	if err := deps.requireSeams(); err != nil {
+		return report, err
+	}
+	if err := deps.PullBolt(); err != nil {
+		return report, fmt.Errorf("dobbyengine: the catch-up could not pull Bolt: %w", err)
+	}
+	if err := deps.Register(); err != nil {
+		return report, err
+	}
+	slugs, err := deps.Runs()
+	if err != nil {
+		return report, fmt.Errorf("dobbyengine: the catch-up could not list the runs: %w", err)
+	}
+
+	runs := make([]CatchUpRun, len(slugs))
+	for i, slug := range slugs {
+		if err := deps.FetchRun(slug); err != nil {
+			return report, fmt.Errorf("dobbyengine: the catch-up could not fetch run %s: %w", slug, err)
+		}
+		run, err := deps.ReadRun(slug)
+		if err != nil {
+			return report, fmt.Errorf("dobbyengine: the catch-up could not read run %s: %w", slug, err)
+		}
+		runs[i] = run
+	}
+
+	var failures []error
+	for i, slug := range slugs {
+		run := runs[i]
+		switch {
+		case run.OwnedElsewhere:
+			if err := deps.HandOver(slug, run.Owner); err != nil {
+				failures = append(failures, fmt.Errorf("dobbyengine: the catch-up could not hand over run %s: %w", slug, err))
+				continue
+			}
+			report.HandedOver = append(report.HandedOver, slug)
+		case run.Ahead:
+			report.OwnedHere = append(report.OwnedHere, slug)
+			if err := deps.PushOwed(slug); err != nil {
+				failures = append(failures, fmt.Errorf("dobbyengine: the catch-up could not push run %s: %w", slug, err))
+				continue
+			}
+			report.Pushed = append(report.Pushed, slug)
+		default:
+			report.OwnedHere = append(report.OwnedHere, slug)
+		}
+	}
+	if len(report.OwnedHere) > 0 {
+		if err := deps.ApplyPauseIntents(report.OwnedHere); err != nil {
+			failures = append(failures, fmt.Errorf("dobbyengine: the catch-up could not apply the pause intents: %w", err))
+		}
+	}
+	return report, errors.Join(failures...)
+}
+
+// requireSeams returns a wiring error naming the first seam the deps leave nil.
+func (deps CatchUpDeps) requireSeams() error {
+	seams := []struct {
+		name string
+		set  bool
+	}{
+		{"PullBolt", deps.PullBolt != nil},
+		{"Register", deps.Register != nil},
+		{"Runs", deps.Runs != nil},
+		{"FetchRun", deps.FetchRun != nil},
+		{"ReadRun", deps.ReadRun != nil},
+		{"PushOwed", deps.PushOwed != nil},
+		{"HandOver", deps.HandOver != nil},
+		{"ApplyPauseIntents", deps.ApplyPauseIntents != nil},
+	}
+	for _, seam := range seams {
+		if !seam.set {
+			return fmt.Errorf("dobbyengine: the catch-up has no %s seam; this is a wiring error", seam.name)
+		}
+	}
+	return nil
+}
diff --git a/internal/dobbyengine/catchup_test.go b/internal/dobbyengine/catchup_test.go
new file mode 100644
index 00000000..5543b94a
--- /dev/null
+++ b/internal/dobbyengine/catchup_test.go
@@ -0,0 +1,190 @@
+// catchup_test.go pins the catch-up over fake seams: what it fetches, pushes, hands over and writes, and when it stops.
+
+package dobbyengine
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// catchUpFake is a set of seams over in-memory runs that records each act in calls.
+type catchUpFake struct {
+	boltErr     error
+	registerErr error
+	// slugs is what the Runs seam lists, in order.
+	slugs []string
+	runs  map[string]CatchUpRun
+	// fetchErrs, pushErrs and handOverErrs fail the call for the named slug.
+	fetchErrs    map[string]error
+	pushErrs     map[string]error
+	handOverErrs map[string]error
+	calls        []string
+}
+
+func (f *catchUpFake) deps() CatchUpDeps {
+	return CatchUpDeps{
+		PullBolt: func() error {
+			f.calls = append(f.calls, "pull")
+			return f.boltErr
+		},
+		Register: func() error {
+			f.calls = append(f.calls, "register")
+			return f.registerErr
+		},
+		Runs: func() ([]string, error) { return f.slugs, nil },
+		FetchRun: func(slug string) error {
+			f.calls = append(f.calls, "fetch "+slug)
+			return f.fetchErrs[slug]
+		},
+		ReadRun: func(slug string) (CatchUpRun, error) { return f.runs[slug], nil },
+		PushOwed: func(slug string) error {
+			f.calls = append(f.calls, "push "+slug)
+			return f.pushErrs[slug]
+		},
+		HandOver: func(slug, owner string) error {
+			f.calls = append(f.calls, fmt.Sprintf("handover %s %s", slug, owner))
+			return f.handOverErrs[slug]
+		},
+		ApplyPauseIntents: func(slugs []string) error {
+			f.calls = append(f.calls, "pauses "+strings.Join(slugs, ","))
+			return nil
+		},
+	}
+}
+
+func TestCatchUp(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	errPush := errors.New("push refused")
+	errHandOver := errors.New("teardown lock busy")
+	errRefused := errors.New("registration refused")
+	mixedRuns := map[string]CatchUpRun{
+		"here-ahead": {Owner: "m1", Ahead: true},
+		"here-level": {Owner: "m1"},
+		"away":       {Owner: "m2", OwnedElsewhere: true, Ahead: true},
+	}
+
+	tests := []struct {
+		name        string
+		fake        catchUpFake
+		wantCalls   []string
+		wantReport  CatchUpReport
+		wantErrIs   error
+		wantErrText string
+	}{
+		{
+			name:      "AnUnreachableBoltFetchActsOnNoRun",
+			fake:      catchUpFake{boltErr: ErrOriginUnreachable, slugs: []string{"here-ahead"}, runs: mixedRuns},
+			wantCalls: []string{"pull"},
+			wantErrIs: ErrOriginUnreachable,
+		},
+		{
+			name:      "ARefusedRegistrationStopsBeforeTheRuns",
+			fake:      catchUpFake{registerErr: errRefused, slugs: []string{"here-ahead"}, runs: mixedRuns},
+			wantCalls: []string{"pull", "register"},
+			wantErrIs: errRefused,
+		},
+		{
+			name:      "ARunAheadIsPushedAndALevelOneIsNot",
+			fake:      catchUpFake{slugs: []string{"here-ahead", "here-level"}, runs: mixedRuns},
+			wantCalls: []string{"pull", "register", "fetch here-ahead", "fetch here-level", "push here-ahead", "pauses here-ahead,here-level"},
+			wantReport: CatchUpReport{
+				Pushed:    []string{"here-ahead"},
+				OwnedHere: []string{"here-ahead", "here-level"},
+			},
+		},
+		{
+			name: "ARunOwnedElsewhereIsHandedOverNamingItsOwnerAndGetsNoPush",
+			fake: catchUpFake{slugs: []string{"away", "here-level"}, runs: mixedRuns},
+			wantCalls: []string{
+				"pull", "register", "fetch away", "fetch here-level", "handover away m2", "pauses here-level",
+			},
+			wantReport: CatchUpReport{HandedOver: []string{"away"}, OwnedHere: []string{"here-level"}},
+		},
+		{
+			name: "AnUnreachablePairFetchStopsBeforeAnyPush",
+			fake: catchUpFake{
+				slugs: []string{"here-ahead", "away"}, runs: mixedRuns,
+				fetchErrs: map[string]error{"away": ErrOriginUnreachable},
+			},
+			wantCalls: []string{"pull", "register", "fetch here-ahead", "fetch away"},
+			wantErrIs: ErrOriginUnreachable,
+		},
+		{
+			name: "AFailedHandOverGoesOnToTheNextRunAndIsReturned",
+			fake: catchUpFake{
+				slugs: []string{"away", "here-ahead"}, runs: mixedRuns,
+				handOverErrs: map[string]error{"away": errHandOver},
+			},
+			wantCalls: []string{
+				"pull", "register", "fetch away", "fetch here-ahead", "handover away m2", "push here-ahead", "pauses here-ahead",
+			},
+			wantReport:  CatchUpReport{Pushed: []string{"here-ahead"}, OwnedHere: []string{"here-ahead"}},
+			wantErrIs:   errHandOver,
+			wantErrText: "run away",
+		},
+		{
+			name: "AFailedPushGoesOnToTheNextRunAndIsReturned",
+			fake: catchUpFake{
+				slugs: []string{"here-ahead", "away"}, runs: mixedRuns,
+				pushErrs: map[string]error{"here-ahead": errPush},
+			},
+			wantCalls: []string{
+				"pull", "register", "fetch here-ahead", "fetch away", "push here-ahead", "handover away m2", "pauses here-ahead",
+			},
+			wantReport:  CatchUpReport{HandedOver: []string{"away"}, OwnedHere: []string{"here-ahead"}},
+			wantErrIs:   errPush,
+			wantErrText: "run here-ahead",
+		},
+		{
+			name:      "AScopeOfOneSlugFetchesOnlyThatSlug",
+			fake:      catchUpFake{slugs: []string{"here-level"}, runs: mixedRuns},
+			wantCalls: []string{"pull", "register", "fetch here-level", "pauses here-level"},
+			wantReport: CatchUpReport{
+				OwnedHere: []string{"here-level"},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			report, err := CatchUp(tt.fake.deps())
+			if tt.wantErrIs != nil && !errors.Is(err, tt.wantErrIs) {
+				t.Errorf("CatchUp() error = %v; want it to wrap %v", err, tt.wantErrIs)
+			}
+			if tt.wantErrIs == nil && err != nil {
+				t.Errorf("CatchUp() error = %v; want none", err)
+			}
+			if tt.wantErrText != "" && (err == nil || !strings.Contains(err.Error(), tt.wantErrText)) {
+				t.Errorf("CatchUp() error = %v; want it to contain %q", err, tt.wantErrText)
+			}
+			if !slices.Equal(tt.fake.calls, tt.wantCalls) {
+				t.Errorf("CatchUp() calls = %q; want %q", tt.fake.calls, tt.wantCalls)
+			}
+			if !slices.Equal(report.Pushed, tt.wantReport.Pushed) ||
+				!slices.Equal(report.HandedOver, tt.wantReport.HandedOver) ||
+				!slices.Equal(report.OwnedHere, tt.wantReport.OwnedHere) {
+				t.Errorf("CatchUp() report = %+v; want %+v", report, tt.wantReport)
+			}
+		})
+	}
+
+	t.Run("ANilSeamIsAWiringErrorActingOnNothing", func(t *testing.T) {
+		t.Parallel()
+		fake := catchUpFake{slugs: []string{"here-ahead"}, runs: mixedRuns}
+		deps := fake.deps()
+		deps.HandOver = nil
+		if _, err := CatchUp(deps); err == nil || !strings.Contains(err.Error(), "HandOver") {
+			t.Errorf("CatchUp() error = %v; want a wiring error naming HandOver", err)
+		}
+		if len(fake.calls) != 0 {
+			t.Errorf("CatchUp() calls = %q; want none", fake.calls)
+		}
+	})
+}
diff --git a/internal/dobbyengine/catchupwait.go b/internal/dobbyengine/catchupwait.go
new file mode 100644
index 00000000..eb52b79d
--- /dev/null
+++ b/internal/dobbyengine/catchupwait.go
@@ -0,0 +1,228 @@
+// catchupwait.go is the dobby's use of the catch-up from origin:
+// when it owes one, the wait it records while one stands unfinished, and the sync of its runs' bolt-hold entries.
+
+package dobbyengine
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/runfsm"
+)
+
+// The reasons a catch-up waits, as a CatchUpWait records them.
+const (
+	// CatchUpWaitOrigin means origin did not answer.
+	CatchUpWaitOrigin = "origin"
+	// CatchUpWaitRefused means this machine's registration was refused.
+	CatchUpWaitRefused = "refused"
+	// CatchUpWaitFailed means any other failure: a Bolt pull skipped, or a run's push or hand-over failed.
+	CatchUpWaitFailed = "failed"
+)
+
+// CatchUpWait is the catch-up from origin a dobby waits on, as its state record keeps it.
+// The record carries none while no catch-up is owed or the last one succeeded.
+type CatchUpWait struct {
+	// Reason is why the catch-up waits: CatchUpWaitOrigin, CatchUpWaitRefused or CatchUpWaitFailed.
+	Reason string `json:"reason"`
+	// Detail is the failure's text, folded onto one line.
+	Detail string `json:"detail,omitempty"`
+	// At is when the failure was read.
+	At time.Time `json:"at"`
+}
+
+// oweCatchUp marks the catch-up from origin owed.
+// A dobby whose Deps.CatchUp has no seams owes none.
+func (d *daemon) oweCatchUp() {
+	if d.deps.CatchUp.PullBolt != nil {
+		d.catchUpOwed = true
+	}
+}
+
+// catchUp runs the owed catch-up from origin when its next try is due, and reports whether it stands owed after the call.
+// The first read after an upgrade runs before the catch-up until one run of it succeeds,
+// and a failed read keeps the catch-up owed as a failed catch-up does.
+// Success clears the wait, resets the delay and owes every listed run a full pass.
+// It also drops the per-run memory of the runs the catch-up touched.
+// Failure keeps the catch-up owed and schedules the next try one delay later, doubling from a second to idleCeiling.
+// It records the wait in the state record, and a refusal or any other failure posts one notice per episode.
+func (d *daemon) catchUp(ctx context.Context, now time.Time) bool {
+	if !d.catchUpOwed {
+		return false
+	}
+	if now.Before(d.catchUpNext) {
+		return true
+	}
+	if !d.upgraded && d.deps.Upgrade.Entries != nil {
+		read, err := UpgradeRead(d.deps.Upgrade)
+		if err != nil {
+			d.catchUpFailed(ctx, now, err)
+			return true
+		}
+		d.upgraded = true
+		if read.Dropped > 0 {
+			d.logLine(now, fmt.Sprintf("first read after the upgrade: %d pause entries turned into the Bolt model", read.Dropped))
+		}
+	}
+	report, err := CatchUp(d.deps.CatchUp)
+	if err != nil {
+		d.catchUpFailed(ctx, now, err)
+		return true
+	}
+	d.catchUpSucceeded(now, report)
+	return false
+}
+
+// catchUpFailed records the failed catch-up as the wait of its class and schedules the next try.
+func (d *daemon) catchUpFailed(ctx context.Context, now time.Time, err error) {
+	reason := catchUpWaitReason(err)
+	detail := oneLine(err.Error())
+	d.catchUpDelay = nextCatchUpDelay(d.catchUpDelay)
+	d.catchUpNext = now.Add(d.catchUpDelay)
+	if updateErr := UpdateState(d.geom.StatePath, func(s *State) error {
+		s.CatchUp = &CatchUpWait{Reason: reason, Detail: detail, At: now}
+		return nil
+	}); updateErr != nil {
+		logger.Warn("dobbyengine: the catch-up wait could not be recorded", "worktree", d.geom.WorktreeName, "error", updateErr)
+	}
+	if d.catchUpReason != reason {
+		d.catchUpReason = reason
+		d.logLine(now, "catch-up "+reason+": "+detail)
+	}
+	if reason == CatchUpWaitOrigin || d.catchUpNoticed[reason] {
+		return
+	}
+	if d.catchUpNoticed == nil {
+		d.catchUpNoticed = map[string]bool{}
+	}
+	d.catchUpNoticed[reason] = true
+	if reason == CatchUpWaitRefused {
+		d.post(ctx, fmt.Sprintf("%s: this machine's registration is refused, so the dobby schedules nothing: %v; a refusal that names an environment variable also needs lym beam stop, then lym beam start, since the dobby keeps the environment it started with", d.geom.WorktreeName, err))
+		return
+	}
+	d.post(ctx, fmt.Sprintf("%s: the dobby's catch-up from origin failed, so it schedules nothing: %v; way forward: fix the cause the detail names, and the dobby retries on its own", d.geom.WorktreeName, err))
+}
+
+// catchUpSucceeded clears the wait after a catch-up that succeeded and owes every run a full pass.
+// The per-run memory of each run the catch-up touched is dropped, so the run's next pass is a full pass.
+func (d *daemon) catchUpSucceeded(now time.Time, report CatchUpReport) {
+	d.catchUpOwed, d.catchUpDelay, d.catchUpNext, d.catchUpNoticed = false, 0, time.Time{}, nil
+	if d.catchUpReason != "" {
+		d.catchUpReason = ""
+		d.logLine(now, "catch-up succeeds again")
+	}
+	if err := UpdateState(d.geom.StatePath, func(s *State) error {
+		s.CatchUp = nil
+		return nil
+	}); err != nil {
+		logger.Warn("dobbyengine: the catch-up wait could not be cleared", "worktree", d.geom.WorktreeName, "error", err)
+	}
+	d.owesAll = true
+	for _, slugs := range [][]string{report.Pushed, report.HandedOver, report.OwnedHere} {
+		for _, slug := range slugs {
+			delete(d.childSeen, slug)
+			delete(d.liftPending, slug)
+			delete(d.wasCovered, slug)
+		}
+	}
+}
+
+// catchUpWaitReason classifies a catch-up's error: an unreachable origin, a registration refusal, or any other failure.
+func catchUpWaitReason(err error) string {
+	var registration *boardengine.RegistrationError
+	switch {
+	case errors.Is(err, ErrOriginUnreachable):
+		return CatchUpWaitOrigin
+	case errors.As(err, &registration):
+		return CatchUpWaitRefused
+	default:
+		return CatchUpWaitFailed
+	}
+}
+
+// nextCatchUpDelay returns the delay after a failed try that followed previous: a second, then doubling to idleCeiling.
+func nextCatchUpDelay(previous time.Duration) time.Duration {
+	if previous == 0 {
+		return wakeFloor
+	}
+	return min(previous*2, idleCeiling)
+}
+
+// oweHandOverCatchUp owes the catch-up for each listed run whose verdict hands it over while its pair is still here.
+// A run another machine took while its pass was in flight here is handed over that way, and its processes end.
+// A run that owed the catch-up through this trigger owes none from it again while it still lists as handed over,
+// so a pair directory the hand-over left standing owes the catch-up once.
+// The memory forgets a run once it stops answering hand over or is no longer listed.
+func (d *daemon) oweHandOverCatchUp(runs []RunView) {
+	if d.handedOver == nil {
+		d.handedOver = map[string]bool{}
+	}
+	answering := make(map[string]bool, len(runs))
+	for _, run := range runs {
+		if run.Verdict.Answer != runfsm.AnswerHandOver {
+			continue
+		}
+		answering[run.Slug] = true
+		if run.PairPresent && !d.handedOver[run.Slug] {
+			d.handedOver[run.Slug] = true
+			d.oweCatchUp()
+		}
+	}
+	for slug := range d.handedOver {
+		if !answering[slug] {
+			delete(d.handedOver, slug)
+		}
+	}
+}
+
+// syncBoltHold hands Deps.SyncBoltHold the slugs this dobby's catch-up covers and the listed runs the hold holds.
+// The scope is every slug the catch-up's Runs gives.
+// So a run the tick did not list still has its entry dropped once the hold clears.
+// The held list is the listed runs whose verdict reason is held:
+// a run whose push is owed reads another reason and gets no entry, so its push passes the gate.
+// A failed sync is logged once per episode and the tick goes on.
+func (d *daemon) syncBoltHold(ctx context.Context) {
+	if d.deps.SyncBoltHold == nil {
+		return
+	}
+	scope, err := d.boltHoldScope()
+	if err == nil {
+		var held []string
+		for _, run := range d.listedRuns {
+			if run.Verdict.Reason == runfsm.ReasonHeld {
+				held = append(held, run.Slug)
+			}
+		}
+		err = d.deps.SyncBoltHold(ctx, scope, held)
+	}
+	now := d.deps.Now()
+	if err != nil {
+		d.syncFailures.Fail("dobbyengine: the bolt-hold sync failed; the tick goes on", "worktree", d.geom.WorktreeName, "error", err)
+		if !d.syncFailing {
+			d.syncFailing = true
+			d.logLine(now, "bolt hold sync failing: "+oneLine(err.Error()))
+		}
+		return
+	}
+	d.syncFailures.Recover("dobbyengine: the bolt-hold sync succeeds again", "worktree", d.geom.WorktreeName)
+	if d.syncFailing {
+		d.syncFailing = false
+		d.logLine(now, "bolt hold sync succeeds again")
+	}
+}
+
+// boltHoldScope returns the slugs the catch-up covers, or the listed runs when it names none.
+func (d *daemon) boltHoldScope() ([]string, error) {
+	if d.deps.CatchUp.Runs != nil {
+		return d.deps.CatchUp.Runs()
+	}
+	scope := make([]string, 0, len(d.listedRuns))
+	for _, run := range d.listedRuns {
+		scope = append(scope, run.Slug)
+	}
+	return scope, nil
+}
diff --git a/internal/dobbyengine/doc.go b/internal/dobbyengine/doc.go
index 78200a95..0773e9bd 100644
--- a/internal/dobbyengine/doc.go
+++ b/internal/dobbyengine/doc.go
@@ -12,15 +12,20 @@
 //     ReadState reads it, and UpdateState rewrites it under its lock.
 //     A record that does not decode reads as absent with one Warn, so a hand-damaged file never wedges the beam.
 //   - The PassExit codes are what a `lym batten run` pass exits with for a refusal dobby reads by code.
+//     PassExitOriginWait is the exit of a pass whose catch-up could not reach origin or was refused.
+//     It counts as no failing pass.
 //   - EnsureLive starts the dobby of each worktree it is named, the prime's name or beam slugs.
 //     It starts each only when Live reads its lock free, through SpawnDetached.
 //     It records this machine as the prime owner first when the prime is named and none is recorded.
 //     It reports per worktree and is idempotent.
-//     A named prime or beam that another machine owns is refused.
+//     A named prime or beam whose owner reads as another machine is refused.
