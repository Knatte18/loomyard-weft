new file mode 100644
index 000000000..dfdadef57
--- /dev/null
+++ b/internal/dobbyengine/gatehold.go
@@ -0,0 +1,277 @@
+// gatehold.go implements the gate-hold notice.
+// On a probe tick it reads the held gate slots and posts one line for each hold of a driven run that is past its bound.
+// The line names the holder's process tree and the marked processes outside it.
+
+package dobbyengine
+
+import (
+	"cmp"
+	"context"
+	"fmt"
+	"math"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/proc"
+)
+
+// gateHoldProcessMax is the most descendants, and the most marked processes outside the tree, one line names.
+const gateHoldProcessMax = 20
+
+// GateHolder is one held gate slot as dobby reads it.
+type GateHolder struct {
+	Slot int
+	// Worktree is the directory the holding run works in.
+	Worktree string
+	// Site is the label of what holds the slot.
+	Site string
+	// Tier is the tier key of a tier run, empty for any other holder.
+	Tier string
+	// Marker is the `NAME=value` entry the holder's processes carry in their environment, empty when it records none.
+	Marker string
+	// PID is the holding process.
+	PID int
+	// Started is when the slot was acquired.
+	Started time.Time
+	// TierTimeout is the tier's gate.tiers.<tier>.timeout_min, zero for a holder with no tier or a tier with none.
+	TierTimeout time.Duration
+}
+
+// GateHoldDeps is the seams of the gate-hold notice, told by the hub wiring.
+// A nil Holders or a nil Post checks nothing.
+type GateHoldDeps struct {
+	// Holders reads the live holders with their tier timeouts.
+	Holders func() ([]GateHolder, error)
+	// TaskWorktree returns the task worktree path of the run slug.
+	TaskWorktree func(slug string) (string, error)
+	// Tree samples the process pid and every descendant of it.
+	Tree func(pid int) ([]proc.ProcessSample, error)
+	// MarkedPIDs returns the processes whose environment holds entry.
+	MarkedPIDs func(entry string) ([]int, error)
+	// Post posts one line about the run slug to the nearest live orch.
+	Post func(ctx context.Context, slug, line string) error
+}
+
+// gateHolds notices each hold of a listed run that is past its bound, once per hold, on a probe tick.
+// The bound runs on awake time, and the keys of the holds noticed are kept in the run's watch memory.
+// A failed read or post is logged once per episode and tried again on the next probe tick.
+func (d *daemon) gateHolds(ctx context.Context, now time.Time) {
+	seams := d.deps.GateHolds
+	if seams.Holders == nil || seams.Post == nil || !d.probeDue {
+		return
+	}
+	cfg, err := d.deps.LoadConfig()
+	if err != nil {
+		d.gateHoldReads.Fail("config", "dobbyengine: the config does not load; no gate-hold check", "error", err)
+		return
+	}
+	d.gateHoldReads.Recover("config", "dobbyengine: the config loads again for the gate-hold check")
+	if cfg.GateHoldFactor == 0 {
+		return
+	}
+	holders, err := seams.Holders()
+	if err != nil {
+		d.gateHoldReads.Fail("holders", "dobbyengine: the gate slot holders are unreadable; no gate-hold check", "error", err)
+		return
+	}
+	d.gateHoldReads.Recover("holders", "dobbyengine: the gate slot holders read again")
+	record, _, err := ReadState(d.geom.StatePath)
+	if err != nil {
+		d.gateHoldReads.Fail("state", "dobbyengine: the state record is unreadable; no gate-hold check", "error", err)
+		return
+	}
+	d.gateHoldReads.Recover("state", "dobbyengine: the state record reads again for the gate-hold check")
+
+	// One process may hold several slots, which are one hold.
+	holds := map[string][]GateHolder{}
+	byPID := map[int][]GateHolder{}
+	for _, holder := range holders {
+		byPID[holder.PID] = append(byPID[holder.PID], holder)
+	}
+	for _, hold := range byPID {
+		holds[gateHoldKey(hold)] = hold
+	}
+
+	for _, run := range d.listedRuns {
+		worktree, err := seams.TaskWorktree(run.Slug)
+		if err != nil {
+			d.gateHoldReads.Fail(run.Slug+"|worktree", "dobbyengine: the run's task worktree does not resolve; no gate-hold check for it", "slug", run.Slug, "error", err)
+			continue
+		}
+		d.gateHoldReads.Recover(run.Slug+"|worktree", "dobbyengine: the run's task worktree resolves again", "slug", run.Slug)
+
+		noticed := record.Watches[run.Slug].GateHolds
+		kept := slices.DeleteFunc(slices.Clone(noticed), func(key string) bool { return holds[key] == nil })
+		for key, hold := range holds {
+			if !underWorktree(hold[0].Worktree, worktree) || slices.Contains(kept, key) {
+				continue
+			}
+			bound := gateHoldBound(cfg, hold)
+			if pauserecord.AwakeSince(gateHoldStart(hold), now, record.Sleeps) < bound {
+				continue
+			}
+			tree, marked := d.gateHoldProcesses(run.Slug, hold)
+			if err := seams.Post(ctx, run.Slug, gateHoldLine(run.Slug, hold, bound, tree, marked)); err != nil {
+				d.gateHoldPosts.Fail(run.Slug, "dobbyengine: a gate-hold notice did not go out", "slug", run.Slug, "error", err)
+				continue
+			}
+			d.gateHoldPosts.Recover(run.Slug, "dobbyengine: the gate-hold notices go out again", "slug", run.Slug)
+			kept = append(kept, key)
+		}
+		if slices.Equal(kept, noticed) {
+			continue
+		}
+		err = UpdateState(d.geom.StatePath, func(s *State) error {
+			if s.Watches == nil {
+				s.Watches = map[string]RunWatchState{}
+			}
+			watch := s.Watches[run.Slug]
+			watch.GateHolds = kept
+			s.Watches[run.Slug] = watch
+			return nil
+		})
+		if err != nil {
+			d.gateHoldPosts.Fail(run.Slug+"|record", "dobbyengine: the noticed gate holds could not be recorded", "slug", run.Slug, "error", err)
+			continue
+		}
+		d.gateHoldPosts.Recover(run.Slug+"|record", "dobbyengine: the noticed gate holds are recorded again", "slug", run.Slug)
+	}
+}
+
+// gateHoldProcesses samples the holder's tree and the marked processes outside it.
+// It returns nothing at all when either cannot be read, so the line names the tree as unreadable.
+func (d *daemon) gateHoldProcesses(slug string, hold []GateHolder) (tree, marked []proc.ProcessSample) {
+	seams := d.deps.GateHolds
+	unreadable := func(err error) {
+		d.gateHoldReads.Fail(slug+"|processes", "dobbyengine: the gate holder's processes are unreadable", "slug", slug, "pid", hold[0].PID, "error", err)
+	}
+	tree, err := seams.Tree(hold[0].PID)
+	if err != nil {
+		unreadable(err)
+		return nil, nil
+	}
+	if marker := gateHoldMarker(hold); marker != "" {
+		pids, err := seams.MarkedPIDs(marker)
+		if err != nil {
+			unreadable(err)
+			return nil, nil
+		}
+		for _, pid := range pids {
+			if slices.ContainsFunc(tree, func(sample proc.ProcessSample) bool { return sample.PID == pid }) {
+				continue
+			}
+			own, err := seams.Tree(pid)
+			if err != nil {
+				unreadable(err)
+				return nil, nil
+			}
+			// A process that ended since the marker scan has no entry.
+			if i := slices.IndexFunc(own, func(sample proc.ProcessSample) bool { return sample.PID == pid }); i >= 0 {
+				marked = append(marked, own[i])
+			}
+		}
+	}
+	d.gateHoldReads.Recover(slug+"|processes", "dobbyengine: the gate holder's processes read again", "slug", slug)
+	return tree, marked
+}
+
+// gateHoldStart returns the earliest acquire time among the slots of hold.
+func gateHoldStart(hold []GateHolder) time.Time {
+	start := hold[0].Started
+	for _, holder := range hold[1:] {
+		if holder.Started.Before(start) {
+			start = holder.Started
+		}
+	}
+	return start
+}
+
+// gateHoldKey tells one hold from another: another process, or a later start of the same one, is a new hold.
+func gateHoldKey(hold []GateHolder) string {
+	return strconv.Itoa(hold[0].PID) + "|" + strconv.FormatInt(gateHoldStart(hold).UnixNano(), 10)
+}
+
+// gateHoldBound returns how long hold may stand: the factor times its largest tier timeout,
+// or the configured minutes when no slot of it has one.
+func gateHoldBound(cfg Config, hold []GateHolder) time.Duration {
+	var timeout time.Duration
+	for _, holder := range hold {
+		timeout = max(timeout, holder.TierTimeout)
+	}
+	if timeout <= 0 {
+		return time.Duration(cfg.GateHoldMin) * time.Minute
+	}
+	bound := cfg.GateHoldFactor * float64(timeout)
+	// A product past the type's range converts to a negative bound, which every hold is past.
+	if bound >= float64(math.MaxInt64) {
+		return math.MaxInt64
+	}
+	return time.Duration(bound)
+}
+
+// gateHoldMarker returns the first environment marker a slot of hold records, empty when none does.
+func gateHoldMarker(hold []GateHolder) string {
+	for _, holder := range hold {
+		if holder.Marker != "" {
+			return holder.Marker
+		}
+	}
+	return ""
+}
+
+// gateHoldLine renders the gate-hold notice of the run slug.
+// The tree argument is the holder's process tree, empty when it could not be read.
+// The marked argument is the processes outside that tree that carry the holder's marker.
+// Each process list is ordered by CPU time, most first, and cut at gateHoldProcessMax.
+func gateHoldLine(slug string, hold []GateHolder, bound time.Duration, tree []proc.ProcessSample, marked []proc.ProcessSample) string {
+	slots := make([]int, len(hold))
+	for i, holder := range hold {
+		slots[i] = holder.Slot
+	}
+	slices.Sort(slots)
+	slotNames := make([]string, len(slots))
+	for i, slot := range slots {
+		slotNames[i] = strconv.Itoa(slot)
+	}
+
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s %s: a gate slot is held past its bound: slots %s; tier %s; site %s; started %s; bound %s; holder pid %d",
+		runNoticePrefix, slug, strings.Join(slotNames, ","), cmp.Or(hold[0].Tier, "none"), hold[0].Site,
+		gateHoldStart(hold).UTC().Format(time.RFC3339), bound, hold[0].PID)
+	if len(tree) == 0 {
+		b.WriteString("; process tree unreadable")
+		return b.String()
+	}
+
+	var descendants []proc.ProcessSample
+	for _, sample := range tree {
+		if sample.PID == hold[0].PID {
+			fmt.Fprintf(&b, " %s cpu %s", sample.Path, sample.CPU)
+			continue
+		}
+		descendants = append(descendants, sample)
+	}
+	writeProcesses := func(lead string, samples []proc.ProcessSample) {
+		ordered := slices.Clone(samples)
+		slices.SortStableFunc(ordered, func(a, b proc.ProcessSample) int { return cmp.Compare(b.CPU, a.CPU) })
+		for _, sample := range ordered[:min(len(ordered), gateHoldProcessMax)] {
+			fmt.Fprintf(&b, "; %s %d %s cpu %s", lead, sample.PID, sample.Path, sample.CPU)
+		}
+		if rest := len(ordered) - gateHoldProcessMax; rest > 0 {
+			fmt.Fprintf(&b, "; and %d more", rest)
+		}
+	}
+	writeProcesses("child pid", descendants)
+	writeProcesses("outside the tree, carrying "+gateHoldMarker(hold)+": pid", marked)
+	return b.String()
+}
+
+// underWorktree reports whether path is worktree or lies inside it, compared on whole path segments.
+func underWorktree(path, worktree string) bool {
+	path, worktree = filepath.Clean(path), filepath.Clean(worktree)
+	return path == worktree || strings.HasPrefix(path, worktree+string(filepath.Separator))
+}
diff --git a/internal/dobbyengine/gatehold_test.go b/internal/dobbyengine/gatehold_test.go
new file mode 100644
index 000000000..dc85410b1
--- /dev/null
+++ b/internal/dobbyengine/gatehold_test.go
@@ -0,0 +1,279 @@
+// gatehold_test.go pins the gate-hold notice over fake slot holders and process reads.
+// It covers the bound on awake time, the one notice per hold, the line and the retries after a failed read or post.
+
+package dobbyengine
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// gateHoldFake is what the gate-hold seams of one test report, and what they were given.
+type gateHoldFake struct {
+	holders     []GateHolder
+	holdersErr  error
+	holderCalls int
+	trees       map[int][]proc.ProcessSample
+	treeErr     error
+	marked      []int
+	markedErr   error
+	worktreeErr error
+	cfg         Config
+	cfgErr      error
+	postErr     error
+	posted      []string
+}
+
+// newGateHoldHarness returns a pass harness over one running run, task, whose task worktree is /hub/task,
+// and a fake holding one tier3 slot under it since the harness clock's start.
+func newGateHoldHarness(t *testing.T) (*passHarness, *gateHoldFake) {
+	t.Helper()
+	h := newPassHarness(t, runningRun("task"))
+	f := &gateHoldFake{
+		holders: []GateHolder{{
+			Slot: 1, Worktree: "/hub/task/sub", Site: "gate test tier3", Tier: "tier3", Marker: "LYM_GATE_TEST_PID=100",
+			PID: 100, Started: h.clock.now(), TierTimeout: 35 * time.Minute,
+		}},
+		trees: map[int][]proc.ProcessSample{
+			100: {
+				{PID: 100, Path: "/bin/lym", CPU: time.Second},
+				{PID: 101, Parent: 100, Path: "/bin/go", CPU: 2 * time.Second},
+				{PID: 102, Parent: 101, Path: "/tmp/x.test", CPU: 3 * time.Second},
+			},
+			200: {{PID: 200, Path: "/usr/bin/tmux", CPU: 4 * time.Second}},
+		},
+		marked: []int{101, 200},
+		cfg:    Config{GateHoldFactor: 1.5, GateHoldMin: 30},
+	}
+	h.d.deps.LoadConfig = func() (Config, error) { return f.cfg, f.cfgErr }
+	h.d.deps.GateHolds = GateHoldDeps{
+		Holders: func() ([]GateHolder, error) {
+			f.holderCalls++
+			return slices.Clone(f.holders), f.holdersErr
+		},
+		TaskWorktree: func(slug string) (string, error) { return "/hub/" + slug, f.worktreeErr },
+		Tree:         func(pid int) ([]proc.ProcessSample, error) { return f.trees[pid], f.treeErr },
+		MarkedPIDs:   func(string) ([]int, error) { return f.marked, f.markedErr },
+		Post: func(_ context.Context, _, line string) error {
+			if f.postErr != nil {
+				return f.postErr
+			}
+			f.posted = append(f.posted, line)
+			return nil
+		},
+	}
+	return h, f
+}
+
+// tickAt runs one probe tick at the wall time since past start.
+func (h *passHarness) tickAt(start time.Time, since time.Duration) {
+	h.t.Helper()
+	// tick itself advances the clock by one probe interval.
+	h.advance(start.Add(since).Sub(h.clock.now()) - 10*time.Second)
+	h.tick(true)
+}
+
+func TestGateHolds(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const line = "[dobby notice] task: a gate slot is held past its bound: slots 1; tier tier3; site gate test tier3; " +
+		"started 2026-10-25T12:00:00Z; bound 52m30s; holder pid 100 /bin/lym cpu 1s; " +
+		"child pid 102 /tmp/x.test cpu 3s; child pid 101 /bin/go cpu 2s; " +
+		"outside the tree, carrying LYM_GATE_TEST_PID=100: pid 200 /usr/bin/tmux cpu 4s"
+	past := 53 * time.Minute
+	requirePosts := func(t *testing.T, f *gateHoldFake, want int) {
+		t.Helper()
+		if len(f.posted) != want {
+			t.Fatalf("posted = %q; want %d notices", f.posted, want)
+		}
+	}
+	requireHolds := func(t *testing.T, f *gateHoldFake, want ...string) {
+		t.Helper()
+		requirePosts(t, f, 1)
+		for _, part := range want {
+			if !strings.Contains(f.posted[0], part) {
+				t.Errorf("notice = %q; want it to hold %q", f.posted[0], part)
+			}
+		}
+	}
+	unreadable := func(fail func(f *gateHoldFake)) func(*testing.T, *passHarness, *gateHoldFake, time.Time) {
+		return func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			fail(f)
+			h.tickAt(start, past)
+			h.tickAt(start, past+time.Minute)
+			requireHolds(t, f, "holder pid 100; process tree unreadable")
+		}
+	}
+
+	tests := []struct {
+		name string
+		run  func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time)
+	}{
+		{"PostsTheLineOnceTheAwakeBoundPasses", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			h.tickAt(start, 52*time.Minute)
+			requirePosts(t, f, 0)
+			h.tickAt(start, past)
+			if want := []string{line}; !slices.Equal(f.posted, want) {
+				t.Errorf("posted = %q; want %q", f.posted, want)
+			}
+		}},
+		{"AMachineSleepDelaysTheNotice", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			h.tick(true)
+			h.clock.suspend(2 * time.Minute)
+			h.tickAt(start, past)
+			requirePosts(t, f, 0)
+			h.tickAt(start, past+2*time.Minute)
+			requirePosts(t, f, 1)
+		}},
+		{"OneHoldIsNoticedOnceAcrossTicksAndARestart", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			h.tickAt(start, past)
+			h.tick(true)
+			h.restartDobby()
+			h.tick(true)
+			requirePosts(t, f, 1)
+		}},
+		{"TwoSlotsOfOneProcessAreOneHoldFromItsEarliestStart", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			second := f.holders[0]
+			second.Slot, second.TierTimeout = 2, 40*time.Minute
+			f.holders[0].Started = start.Add(10 * time.Minute)
+			f.holders = append(f.holders, second)
+			h.tickAt(start, 59*time.Minute)
+			requirePosts(t, f, 0)
+			h.tickAt(start, 61*time.Minute)
+			h.tick(true)
+			requireHolds(t, f, "slots 1,2;", "started 2026-10-25T12:00:00Z;", "bound 1h0m0s;")
+		}},
+		{"AnotherProcessOrALaterStartIsANewHold", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			h.tickAt(start, past)
+			f.holders[0].PID = 300
+			h.tick(true)
+			requirePosts(t, f, 2)
+			f.holders[0].Started = start.Add(time.Minute)
+			h.tickAt(start, past+time.Minute)
+			requirePosts(t, f, 3)
+			want := []string{"300|" + strconv.FormatInt(start.Add(time.Minute).UnixNano(), 10)}
+			if got := h.stateRecord().Watches["task"].GateHolds; !slices.Equal(got, want) {
+				t.Errorf("GateHolds = %q; want only the current hold %q", got, want)
+			}
+		}},
+		{"AHolderInTheTaskWorktreeItselfIsTheRuns", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.holders[0].Worktree = "/hub/task"
+			h.tickAt(start, past)
+			requirePosts(t, f, 1)
+		}},
+		{"AFactorPastTheDurationRangeNoticesNothing", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.cfg.GateHoldFactor = 1e10
+			h.tickAt(start, past)
+			requirePosts(t, f, 0)
+		}},
+		{"ASiblingWorktreeIsNotTheRuns", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.holders[0].Worktree = "/hub/task-b"
+			h.tickAt(start, past)
+			requirePosts(t, f, 0)
+		}},
+		{"AHolderWithNoTierTakesTheMinutesBound", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.holders[0].Tier, f.holders[0].TierTimeout = "", 0
+			h.tickAt(start, 29*time.Minute)
+			requirePosts(t, f, 0)
+			h.tickAt(start, 30*time.Minute)
+			requireHolds(t, f, "tier none;", "bound 30m0s;")
+		}},
+		{"FactorZeroSendsNothing", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.cfg.GateHoldFactor = 0
+			h.tickAt(start, past)
+			requirePosts(t, f, 0)
+		}},
+		{"UnreadableHoldersAreReadAgain", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.holdersErr = errors.New("no pool")
+			h.tickAt(start, past)
+			requirePosts(t, f, 0)
+			f.holdersErr = nil
+			h.tick(true)
+			requirePosts(t, f, 1)
+		}},
+		{"AFailingConfigIsLoadedAgain", func(t *testing.T, h *passHarness, f *gateHoldFake, _ time.Time) {
+			// A tick itself fails on a config that does not load, so the step is called on its own.
+			h.advance(past)
+			h.d.probeDue = true
+			h.d.listedRuns = []RunView{runningRun("task")}
+			f.cfgErr = errors.New("bad config")
+			h.d.gateHolds(context.Background(), h.clock.now())
+			requirePosts(t, f, 0)
+			f.cfgErr = nil
+			h.d.gateHolds(context.Background(), h.clock.now())
+			requirePosts(t, f, 1)
+		}},
+		{"ATickThatIsNoProbeReadsNothing", func(t *testing.T, h *passHarness, f *gateHoldFake, _ time.Time) {
+			h.advance(past)
+			h.tick(false)
+			requirePosts(t, f, 0)
+			if f.holderCalls != 0 {
+				t.Errorf("Holders calls = %d; want 0", f.holderCalls)
+			}
+		}},
+		{"AFailingTreeStillPosts", unreadable(func(f *gateHoldFake) { f.treeErr = errors.New("no proc") })},
+		{"AFailingMarkerScanStillPosts", unreadable(func(f *gateHoldFake) { f.markedErr = errors.New("no proc") })},
+		{"AnUnresolvedTaskWorktreeSkipsTheRun", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.worktreeErr = errors.New("no pair")
+			h.tickAt(start, past)
+			requirePosts(t, f, 0)
+		}},
+		{"AFailedPostIsTriedAgainAndThenRecorded", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			f.postErr = errors.New("no orch")
+			h.tickAt(start, past)
+			if got := h.stateRecord().Watches["task"].GateHolds; len(got) != 0 {
+				t.Errorf("GateHolds after a failed post = %q; want none", got)
+			}
+			f.postErr = nil
+			h.tick(true)
+			requirePosts(t, f, 1)
+			want := []string{"100|" + strconv.FormatInt(start.UnixNano(), 10)}
+			if got := h.stateRecord().Watches["task"].GateHolds; !slices.Equal(got, want) {
+				t.Errorf("GateHolds = %q; want %q", got, want)
+			}
+		}},
+		{"ALongProcessListIsCutAndCounted", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			for i := range 23 {
+				f.trees[100] = append(f.trees[100], proc.ProcessSample{PID: 400 + i, Parent: 100, Path: "/bin/sh"})
+			}
+			f.marked = nil
+			h.tickAt(start, past)
+			requireHolds(t, f, "child pid 102 /tmp/x.test cpu 3s; child pid 101 /bin/go cpu 2s;")
+			if got := strings.Count(f.posted[0], "; child pid "); got != 20 {
+				t.Errorf("descendants named = %d; want 20", got)
+			}
+			if !strings.HasSuffix(f.posted[0], "; and 5 more") {
+				t.Errorf("notice = %q; want it to end with the count of the rest", f.posted[0])
+			}
+		}},
+		{"AWatchLevelOfOffStillGetsTheNotice", func(t *testing.T, h *passHarness, f *gateHoldFake, start time.Time) {
+			h.d.deps.RunWatch = RunWatchDeps{
+				Level: func(string) (string, error) { return RunWatchOff, nil },
+				Post:  func(context.Context, string, string) (bool, error) { return true, nil },
+			}
+			h.tickAt(start, past)
+			requirePosts(t, f, 1)
+			// The run watch rewrites the memory that holds the noticed holds on every tick.
+			h.tick(true)
+			h.restartDobby()
+			h.tick(true)
+			requirePosts(t, f, 1)
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			h, f := newGateHoldHarness(t)
+			tt.run(t, h, f, h.clock.now())
+		})
+	}
+}
