+			t.Fatal(err)
+		}
+		got := call(t, 2)
+		wantOutcome(t, got, testMapOutcome{Skipped: []testMapSkip{dirtySkip, lockedSkip, movedSkip}, Unbuilt: 1})
+		wantBrokenFailed(t, got)
+		wantExitRecord(t, 1)
