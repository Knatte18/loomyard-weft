@@ -0,0 +1,74 @@
+// config_test.go covers slackengine.LoadConfig over bare board dirs, with no hub and no spawn.
+
+package slackengine_test
+
+import (
+	"errors"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/slackengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/yamlengine"
+)
+
+// TestLoadConfig covers the template default, a hub value, a value below the floor refused naming the key and the way forward,
+// and that the template holds no key but remind_after_min, so no `lym config slack` write can name a channel, an operator or a token.
+func TestLoadConfig(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		hub     string
+		want    slackengine.Config
+		wantErr string
+	}{
+		{name: "TemplateValue", hub: "", want: slackengine.Config{RemindAfterMin: 30}},
+		{name: "HubValue", hub: "remind_after_min: 45\n", want: slackengine.Config{RemindAfterMin: 45}},
+		{name: "ZeroRefused", hub: "remind_after_min: 0\n", wantErr: `slack config key "remind_after_min" holds 0`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			dirs := configengine.Dirs{Board: t.TempDir()}
+			if tt.hub != "" {
+				if err := os.MkdirAll(configengine.ConfigDir(dirs.Board), 0o755); err != nil {
+					t.Fatalf("MkdirAll(config dir) = %v; want nil", err)
+				}
+				if err := os.WriteFile(configengine.ConfigFile(dirs.Board, "slack"), []byte(tt.hub), 0o644); err != nil {
+					t.Fatalf("WriteFile hub file = %v; want nil", err)
+				}
+			}
+
+			got, err := slackengine.LoadConfig(dirs)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) || !strings.Contains(err.Error(), "lym config slack") || !errors.Is(err, configengine.ErrInvalid) {
+					t.Fatalf("LoadConfig() error = %v; want an ErrInvalid error containing %q and the way forward", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig() error = %v; want nil", err)
+			}
+			if got != tt.want {
+				t.Errorf("LoadConfig() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+
+	t.Run("TemplateKeysAreExactlyRemindAfterMin", func(t *testing.T) {
+		t.Parallel()
+		spec := slackengine.ConfigSpec()
+		keys, err := yamlengine.LeafPaths(spec.Template, spec.OpenMaps, spec.WholeEntries)
+		if err != nil {
+			t.Fatalf("LeafPaths(slack template) = %v; want nil", err)
+		}
+		if want := []string{"remind_after_min"}; !slices.Equal(keys, want) {
+			t.Errorf("slack template keys = %v; want %v", keys, want)
+		}
+	})
+}
diff --git a/internal/slackengine/credentials.go b/internal/slackengine/credentials.go
new file mode 100644
index 00000000..3916d789
--- /dev/null
+++ b/internal/slackengine/credentials.go
@@ -0,0 +1,90 @@
+// credentials.go holds the machine's bot token file and the hub's setup file, and the check that both exist.
+
+package slackengine
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// tokenRecord is the token file's content.
+type tokenRecord struct {
+	Token string `json:"token"`
+}
+
+// Setup is the hub's Slack setup: the channel the relay reads and posts in and the one operator whose messages it forwards.
+type Setup struct {
+	// ChannelID is the Slack id of the channel.
+	ChannelID string `json:"channel_id"`
+	// OperatorID is the Slack user id of the operator.
+	OperatorID string `json:"operator_id"`
+}
+
+// ReadToken returns the bot token stored at path.
+// A missing file and an empty token report found false.
+func ReadToken(path string) (string, bool, error) {
+	record, found, err := state.ReadJSON[tokenRecord](path, recordLockPath(path))
+	if err != nil {
+		return "", false, fmt.Errorf("slack: read the token file %s: %w", path, err)
+	}
+	if !found || record.Token == "" {
+		return "", false, nil
+	}
+	return record.Token, true, nil
+}
+
+// WriteToken stores token at path atomically, creating the directory private to the user.
+// The file is private to its user too, as the atomic write creates it.
+func WriteToken(path, token string) error {
+	if err := os.MkdirAll(filepath.Dir(path), privateDirMode); err != nil {
+		return fmt.Errorf("slack: create the directory of the token file %s: %w", path, err)
+	}
+	if err := state.WriteJSON(path, recordLockPath(path), tokenRecord{Token: token}); err != nil {
+		return fmt.Errorf("slack: write the token file %s: %w", path, err)
+	}
+	return nil
+}
+
+// ReadSetup returns the setup stored at path, and reports found false for a missing file.
+func ReadSetup(path string) (Setup, bool, error) {
+	setup, found, err := state.ReadJSON[Setup](path, recordLockPath(path))
+	if err != nil {
+		return Setup{}, false, fmt.Errorf("slack: read the setup file %s: %w", path, err)
+	}
+	return setup, found, nil
+}
+
+// WriteSetup stores setup at path atomically, creating the directory private to the user.
+func WriteSetup(path string, setup Setup) error {
+	if err := os.MkdirAll(filepath.Dir(path), privateDirMode); err != nil {
+		return fmt.Errorf("slack: create the directory of the setup file %s: %w", path, err)
+	}
+	if err := state.WriteJSON(path, recordLockPath(path), setup); err != nil {
+		return fmt.Errorf("slack: write the setup file %s: %w", path, err)
+	}
+	return nil
+}
+
+// RequireConfigured returns the bot token and the setup of the hub in geom.
+// It refuses a machine with no token and a hub with no setup file, each with the `lym slack` verb that writes it as the way forward.
+func RequireConfigured(geom Geometry) (string, Setup, error) {
+	token, found, err := ReadToken(geom.TokenPath)
+	if err != nil {
+		return "", Setup{}, err
+	}
+	if !found {
+		return "", Setup{}, errors.New("slack: no Slack token on this machine; way forward: run `lym slack login` from the operator's terminal")
+	}
+	setup, found, err := ReadSetup(geom.SetupPath)
+	if err != nil {
+		return "", Setup{}, err
+	}
+	if !found {
+		return "", Setup{}, errors.New("slack: the hub's Slack channel and operator are not set; way forward: run `lym slack setup --channel <id> --operator <user-id>` from the operator's terminal")
+	}
+	return token, setup, nil
+}
diff --git a/internal/slackengine/doc.go b/internal/slackengine/doc.go
new file mode 100644
index 00000000..f497912e
--- /dev/null
+++ b/internal/slackengine/doc.go
@@ -0,0 +1,34 @@
+// doc.go carries the package godoc for slackengine.
+
+// Package slackengine is the Slack transport of the hub relay.
+// It holds the only calls to Slack and the files the relay and `lym slack` read and write.
+//
+// The files sit in two places.
+// The machine's bot token is `slack.json` in the per-user lym directory `githubclient.CredentialDir` names, written by `WriteToken` and read by `ReadToken`; no config template, layer or env file holds it.
+// The hub's own files sit in its `.lym/slack/` directory: the setup file with the channel and the operator (`Setup`), the presence (`Presence`), the inbound cursor, the outbound record, the relay state (`RelayState`), the relay lock and the relay log.
+// Every record is written through `internal/state`, so a key an older binary does not know survives its rewrite, and its lock file sits in a `locks` directory beside it.
+// A directory the package creates is private to the user, and so is each file it writes.
+//
+// The package is told its `Geometry` and derives no path of its own; `hubgeom.SlackGeometry` builds it, and the package imports no `*cli` package.
+// The package also owns the hub-wide `slack` config module, whose one key, `remind_after_min`, is the minutes between the orch's reminders while presence is slack; the channel, the operator and the token are never config.
+// `RequireConfigured` refuses a hub with no token or no setup file, naming the `lym slack` verb that writes it.
+//
+// `API` is the Web API client, over `net/http` alone.
+// Each call posts a form to the method's URL with the bot token as a bearer header and a bounded timeout, and no error or log line carries the token.
+// A call Slack refused for its rate limit is a `*RateLimitError` carrying the wait Slack asked for, any other `ok: false` is an `*APIError` carrying Slack's code, and a transport failure or a `5xx` is a plain wrapped error.
+//
+// The relay is told its seams: a `Clock`, a creel `Mailbox` signing as `<shortname>:SLACK`, a `SlackClient` and a `Hub` of the hub's beams and pauses.
+// The inbound poll reads the configured operator's top-level messages after the cursor and hands each, once, to the orch it is for as `[slack]` mail;
+// `away`, `back` and `status` are presence commands answered in Slack and sent to no orch, and `SetPresence` mails the orchs a notice when the presence changes.
+// A message that cannot be handled holds the later ones until it succeeds or is five minutes old, when the relay answers in Slack and moves past it.
+//
+// The outbound read waits on the relay's own mailbox and posts mail from the hub's orchs and programs to the channel, at least once and never twice for one acknowledged read:
+// an outbox record keeps each message already posted, and the count of stale mail whose line is not yet posted, until creel confirms the acknowledgement.
+// A read stops posting before creel's acknowledgement window ends and releases the rest, mail over a day old is acknowledged unposted, and a message Slack refuses with an error code five times is dropped with a line that names it.
+//
+// `RunRelay` is the relay process: it holds the relay lock, makes its first creel read before any Slack call, and runs the inbound poll and the outbound read, each waiting from a five-second floor and doubling to sixty while it finds nothing.
+// The relay starts through a double fork, so no pane's tree holds it:
+// `EnsureRelay` and `EnsureRelayWhileAway` spawn an intermediate process that runs `SpawnRelayFromIntermediate` and exits at once, and the relay reparents itself away from it.
+// A start made while the operator is away is capped by how long each spawned relay lived, so a relay that dies young is not restarted without end.
+// `StopRelay` ends the relay through the run-process records, and `AwaitFirstRead` is how a start learns the relay's first creel read was accepted.
+package slackengine
diff --git a/internal/slackengine/export_test.go b/internal/slackengine/export_test.go
