+		{"RoleOverModel", agentconfig.RoleDarn, "opus", "high"},
+		{"ModelWithoutRoleEntry", agentconfig.RolePlan, "haiku", "low"},
+		{"Default", agentconfig.RolePlan, "opus", "medium"},
+		{"NoRole", "", "haiku", "low"},
+		{"NoModel", agentconfig.RoleDarn, "", "high"},
