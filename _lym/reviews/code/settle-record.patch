diff --git a/internal/fabricengine/codereads.go b/internal/fabricengine/codereads.go
new file mode 100644
index 00000000..22c92ad4
--- /dev/null
+++ b/internal/fabricengine/codereads.go
@@ -0,0 +1,36 @@
+// codereads.go reads the code checkout's tracked files as stored in a commit, unaffected by the working tree.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+)
+
+// CodeDirAt returns the names of the regular files directly in dir of the code checkout's commit rev, sorted.
+// dir is slash-separated and relative to the checkout's root; "" or "." names the root.
+// A directory absent at rev gives an empty list and no error.
+// rev is a hex commit name, such as the one HeadSHA returns.
+func (f *Fabric) CodeDirAt(rev, dir string) ([]string, error) {
+	names, err := f.code.FilesInDirAtRevision(rev, dir)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: list %s at %s: %w", dir, rev, err)
+	}
+	return names, nil
+}
+
+// CodeFileAt returns rel as stored in the code checkout's commit rev, unaffected by any later change to the file.
+// rel is slash-separated and relative to the checkout's root, and rev is a hex commit name.
+// found is false with a nil error when rel is absent at rev.
+func (f *Fabric) CodeFileAt(rev, rel string) (data []byte, found bool, err error) {
+	data, err = f.code.FileAtRevision(rev, rel)
+	if errors.Is(err, gitrepo.ErrPathNotAtRevision) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, fmt.Errorf("fabricengine: read %s at %s: %w", rel, rev, err)
+	}
+	return data, true, nil
+}
diff --git a/internal/fabricengine/codereads_integration_test.go b/internal/fabricengine/codereads_integration_test.go
new file mode 100644
index 00000000..8a3135d8
--- /dev/null
+++ b/internal/fabricengine/codereads_integration_test.go
@@ -0,0 +1,82 @@
+// codereads_integration_test.go covers Fabric.CodeDirAt and Fabric.CodeFileAt over a wired hub's code checkout.
+//
+// Package fabricengine_test; shares the single TestMain in testmain_test.go.
+
+package fabricengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestCodeReadsAtCommit reads a commit's directories and files.
+// The working tree holds an edit and an untracked file meanwhile.
+// Its subtests share the hub's one commit and run in sequence, so none is parallel.
+func TestCodeReadsAtCommit(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	root := h.PrimeWorktree()
+	gitkit.CommitFile(t, root, "pkg/sub/c.go", "package sub\n", "add c")
+	gitkit.CommitFile(t, root, "pkg/b.txt", "b\n", "add b")
+	head := gitkit.CommitFile(t, root, "pkg/a.go", "package pkg\n", "add a")
+	if err := os.WriteFile(filepath.Join(root, "pkg", "a.go"), []byte("package pkg // edited\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "pkg", "new.go"), []byte("package pkg\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	f, err := fabricengine.Open(h.Location)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("CodeDirAtListsTheCommitsFiles", func(t *testing.T) {
+		tests := []struct {
+			dir  string
+			want []string
+		}{
+			{"pkg", []string{"a.go", "b.txt"}},
+			{"pkg/sub", []string{"c.go"}},
+			{"absent", nil},
+		}
+		for _, tt := range tests {
+			got, err := f.CodeDirAt(head, tt.dir)
+			if err != nil {
+				t.Fatalf("CodeDirAt(%q) error = %v", tt.dir, err)
+			}
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("CodeDirAt(%q) = %q; want %q", tt.dir, got, tt.want)
+			}
+		}
+	})
+
+	t.Run("CodeFileAtReadsTheCommit", func(t *testing.T) {
+		tests := []struct {
+			rel       string
+			wantFound bool
+			want      string
+		}{
+			{"pkg/a.go", true, "package pkg\n"},
+			{"pkg/new.go", false, ""},
+			{"pkg/absent.go", false, ""},
+		}
+		for _, tt := range tests {
+			data, found, err := f.CodeFileAt(head, tt.rel)
+			if err != nil {
+				t.Fatalf("CodeFileAt(%q) error = %v", tt.rel, err)
+			}
+			if found != tt.wantFound || string(data) != tt.want {
+				t.Errorf("CodeFileAt(%q) = (%q, %v); want (%q, %v)", tt.rel, data, found, tt.want, tt.wantFound)
+			}
+		}
+	})
+}
