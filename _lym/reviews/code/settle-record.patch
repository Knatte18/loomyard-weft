-			wantRewrote: []string{"capture.dir"}, wantFlagged: []string{"compare.dir"},
-		},
-		{
-			name:        "AbsoluteIsKept",
-			dirs:        []string{anchorName},
-			yaml:        "capture:\n  dir: ABS\n",
-			wantCapture: "ABS", wantSame: true,
-		},
-		{
-			name:        "UnsetAndUndeclaredAreKept",
