diff --git a/internal/gatecli/redundancyreport.go b/internal/gatecli/redundancyreport.go
new file mode 100644
index 00000000..1ee2bc3c
--- /dev/null
+++ b/internal/gatecli/redundancyreport.go
@@ -0,0 +1,184 @@
+// redundancyreport.go declares the report the redundancy report step writes into the worktree's gate directory.
+// It reads and writes the report through internal/state and matches a report against a tree.
+
+package gatecli
+
+import (
+	"fmt"
+	"maps"
+	"path/filepath"
+	"slices"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// redundancyReportFileName is the redundancy report's file name in the worktree's gate directory.
+const redundancyReportFileName = "redundancy.json"
+
+// Verdicts the redundancy report gives a test.
+const (
+	// RedundancyContained marks a test the tests left after the greedy pass cover block for block.
+	RedundancyContained = "contained"
+	// RedundancyUnique marks a judged test that covers a block no test left after the greedy pass covers.
+	RedundancyUnique = "unique"
+	// RedundancyNotJudged marks a test the step did not judge, with the reason.
+	RedundancyNotJudged = "not judged"
+)
+
+// RedundancyReport is what one redundancy report step of `lym gate test` found for the worktree's diff.
+// The step writes it, and a reader matches it against a later tree before trusting its verdicts.
+type RedundancyReport struct {
+	// Written is when the step wrote the report.
+	Written time.Time `json:"written"`
+	// GateKey is the gate.yaml key whose call wrote the report.
+	GateKey string `json:"gate_key"`
+	// Note says why the step judged nothing, such as a red gate or no parent branch; empty when it judged.
+	Note string `json:"note,omitempty"`
+	// RedGate is set when a tier of the call was red, so the step judged nothing.
+	RedGate bool `json:"red_gate,omitempty"`
+	// Base is the merge base with the parent branch the step diffed from.
+	Base string `json:"base,omitempty"`
+	// ModuleDir is the worktree-relative slash path of the Go module whose packages the report names.
+	ModuleDir string `json:"module_dir,omitempty"`
+	// Errors are the failures the step met, one line each; none changes the gate's result.
+	Errors []string `json:"errors,omitempty"`
+	// TestHashes maps each package, by module-relative path, to the function hashes of its tests.
+	// It holds each test the step took, judged or not, by name.
+	TestHashes map[string]map[string]string `json:"test_hashes,omitempty"`
+	// FileHashes maps each judged package to the ContentHash of each of its Go files, by name.
+	FileHashes map[string]map[string]string `json:"file_hashes,omitempty"`
+	// Packages holds one line per package with a test the step went on to judge.
+	Packages []RedundancyPackage `json:"packages,omitempty"`
+	// Tests holds one line per test the step took, sorted by file and then name.
+	Tests []RedundancyTest `json:"tests,omitempty"`
+}
+
+// RedundancyPackage is one package's line of a redundancy report: whether its coverage map let its tests be judged.
+type RedundancyPackage struct {
+	// Package is the module-relative slash path of the package.
+	Package string `json:"package"`
+	// Judged is set when the package's map let its tests be judged; Reason says why not otherwise.
+	Judged bool   `json:"judged"`
+	Reason string `json:"reason,omitempty"`
+	// MapCommit and MapBuiltAt are the commit and build time of the map a judged package was judged against.
+	// MapAge is the map's age when the report was written.
+	MapCommit  string    `json:"map_commit,omitempty"`
+	MapBuiltAt time.Time `json:"map_built_at"`
+	MapAge     string    `json:"map_age,omitempty"`
+	// Drift names the Go files whose text at the merge base hashes otherwise than the map records.
+	// A file on one side alone counts.
+	// It shows how far the map lags the run's base, never the run's own edits.
+	Drift []string `json:"drift,omitempty"`
+}
+
+// RedundancyTest is one test's line of a redundancy report.
+type RedundancyTest struct {
+	// Package is the module-relative slash path of the test's package, and File the worktree-relative path of its file.
+	Package string `json:"package"`
+	Name    string `json:"name"`
+	File    string `json:"file"`
+	// Verdict is RedundancyContained, RedundancyUnique or RedundancyNotJudged.
+	Verdict string `json:"verdict"`
+	// Covering names, for a contained test, the tests that together cover its blocks, largest overlap first.
+	Covering []string `json:"covering,omitempty"`
+	// Reason says why a test is not judged.
+	Reason string `json:"reason,omitempty"`
+}
+
+// redundancyReportPath returns the path of the redundancy report in the gate directory of the worktree at location.
+func redundancyReportPath(location *lymcwd.Location) string {
+	return filepath.Join(gateslot.WaitDir(location.AnchorPath()), redundancyReportFileName)
+}
+
+// ReadRedundancyReport reads the redundancy report of the worktree at location, and reports whether one exists.
+// A key the record does not declare is ignored, never refused.
+func ReadRedundancyReport(location *lymcwd.Location) (RedundancyReport, bool, error) {
+	return readRedundancyReport(redundancyReportPath(location))
+}
+
+func readRedundancyReport(path string) (RedundancyReport, bool, error) {
+	return state.ReadJSON[RedundancyReport](path, lock.TrackedFileLockPath(path, ".lock"))
+}
+
+// writeRedundancyReport replaces the report at path with report, atomically.
+// It keeps each key of the replaced record that report does not declare.
+func writeRedundancyReport(path string, report RedundancyReport) error {
+	return state.WriteJSON(path, lock.TrackedFileLockPath(path, ".lock"), report)
+}
+
+// RedundancyReportMatches reports whether report still holds for the tree of the commit rev of the worktree at location.
+// It holds when the step's selection over rev returns the tests report records with the same function hashes.
+// The selection is taken against the current merge base with the parent branch.
+// It also holds only when the Go files of each package report judged hash at rev as report records.
+// A report that judged nothing, and a worktree with no parent branch, never match.
+func RedundancyReportMatches(location *lymcwd.Location, report RedundancyReport, rev string) (bool, error) {
+	if report.Note != "" || report.RedGate {
+		return false, nil
+	}
+	base, found, err := parentMergeBase(location)
+	if err != nil || !found {
+		return false, err
+	}
+	fabric, err := fabricengine.Open(location)
+	if err != nil {
+		return false, err
+	}
+	changed, err := fabric.ChangedPathsBothSides(base, rev)
+	if err != nil {
+		return false, err
+	}
+	tree := commitTree{fabric: fabric, rev: rev}
+	tests, err := changedTests(tree, fabric, base, report.ModuleDir, changed)
+	if err != nil {
+		return false, err
+	}
+	return report.matches(tree, tests)
+}
+
+// matches reports whether tests, the step's selection over tree, are the tests the report records with the same hashes,
+// and the Go files of each package the report judged hash in tree as the report records.
+func (r RedundancyReport) matches(tree redundancyTree, tests []redundancyCandidate) (bool, error) {
+	equal := func(a, b map[string]string) bool { return maps.Equal(a, b) }
+	if !maps.EqualFunc(testHashesOf(tests), r.TestHashes, equal) {
+		return false, nil
+	}
+	for pkg, recorded := range r.FileHashes {
+		current, err := goFileHashes(tree, packageDirOf(r.ModuleDir, pkg))
+		if err != nil {
+			return false, err
+		}
+		if !maps.Equal(current, recorded) {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+// retries reports whether a later call on the same tree runs the step again rather than keep the report.
+// It does for a report that judged nothing, holds an error line or holds a package with no usable map.
+// It does also for a report that holds a test the spent budget or a cancelled call left unrun.
+func (r RedundancyReport) retries() bool {
+	return r.Note != "" || r.RedGate || len(r.Errors) > 0 ||
+		slices.ContainsFunc(r.Packages, func(p RedundancyPackage) bool { return !p.Judged }) ||
+		slices.ContainsFunc(r.Tests, func(t RedundancyTest) bool {
+			return t.Reason == reasonBudgetSpent || t.Reason == reasonCancelled
+		})
+}
+
+// summaryLine returns the stderr line that names the report's counts, or its note, and its path.
+func (r RedundancyReport) summaryLine(path string) string {
+	if r.Note != "" {
+		return fmt.Sprintf("gate test: redundancy report: %s; written to %s", r.Note, path)
+	}
+	counts := map[string]int{}
+	for _, test := range r.Tests {
+		counts[test.Verdict]++
+	}
+	return fmt.Sprintf("gate test: redundancy report: %d contained, %d unique, %d not judged, %d errors; written to %s",
+		counts[RedundancyContained], counts[RedundancyUnique], counts[RedundancyNotJudged], len(r.Errors), path)
+}
diff --git a/internal/gatecli/redundancyreport_test.go b/internal/gatecli/redundancyreport_test.go
new file mode 100644
index 00000000..2b00ee5f
--- /dev/null
+++ b/internal/gatecli/redundancyreport_test.go
@@ -0,0 +1,59 @@
+// redundancyreport_test.go covers when a redundancy report asks for a retry and when it never matches a tree.
+
+package gatecli
+
+import (
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestRedundancyReportRetries(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	judged := []RedundancyPackage{{Package: "a", Judged: true}}
+	tests := []struct {
+		name   string
+		report RedundancyReport
+		want   bool
+	}{
+		{"AJudgedReportWithNoShortfall", RedundancyReport{Packages: judged, Tests: []RedundancyTest{{Name: "TestA", Verdict: RedundancyUnique}}}, false},
+		{"ATestNotJudgedForAnotherReason", RedundancyReport{Packages: judged, Tests: []RedundancyTest{{Name: "TestA", Verdict: RedundancyNotJudged, Reason: "kept: slow"}}}, false},
+		{"ANote", RedundancyReport{Note: noteNoParent}, true},
+		{"ARedGate", RedundancyReport{RedGate: true}, true},
+		{"AnErrorLineAlone", RedundancyReport{Errors: []string{"coverage build of a: failed"}}, true},
+		{"APackageWithoutAUsableMap", RedundancyReport{Packages: []RedundancyPackage{{Package: "a", Reason: "it has no coverage map"}}}, true},
+		{"ATestTheBudgetLeftUnrun", RedundancyReport{Packages: judged, Tests: []RedundancyTest{{Name: "TestA", Verdict: RedundancyNotJudged, Reason: reasonBudgetSpent}}}, true},
+		{"ATestACancelledCallLeftUnrun", RedundancyReport{Packages: judged, Tests: []RedundancyTest{{Name: "TestA", Verdict: RedundancyNotJudged, Reason: reasonCancelled}}}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := tt.report.retries(); got != tt.want {
+				t.Errorf("retries() of %+v = %v; want %v", tt.report, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRedundancyReportMatchesNothingWhenItJudgedNothing(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name   string
+		report RedundancyReport
+	}{
+		{"ANote", RedundancyReport{Note: noteNoParent}},
+		{"ARedGate", RedundancyReport{RedGate: true}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got, err := RedundancyReportMatches(nil, tt.report, "HEAD"); err != nil || got {
+				t.Errorf("RedundancyReportMatches(%+v) = %v, %v; want false, nil", tt.report, got, err)
+			}
+		})
+	}
+}
diff --git a/internal/gatecli/redundancytests.go b/internal/gatecli/redundancytests.go
new file mode 100644
index 00000000..53a156b7
--- /dev/null
+++ b/internal/gatecli/redundancytests.go
@@ -0,0 +1,276 @@
+// redundancytests.go picks the tests the redundancy report step judges, from the working tree or a commit's tree.
+// It takes each top-level test of a changed test file whose text the merge base lacks.
+// It also hashes the Go files of a package as a tree holds them.
+
+package gatecli
+
+import (
+	"cmp"
+	"errors"
+	"fmt"
+	"io/fs"
+	"maps"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/testcover"
+)
+
+// redundancyTree reads the files of one tree: the working tree, or the tree a commit stores.
+type redundancyTree interface {
+	// file returns the worktree-relative slash path rel as the tree holds it, and whether the tree holds it.
+	file(rel string) ([]byte, bool, error)
+	// goFiles returns the names of the Go files directly in the worktree-relative slash directory dir, sorted.
+	// A directory the tree lacks holds none.
+	goFiles(dir string) ([]string, error)
+}
+
+// workingTree is the working tree of the worktree at root, untracked files included.
+type workingTree struct {
+	root string
+}
+
+func (w workingTree) file(rel string) ([]byte, bool, error) {
+	data, err := os.ReadFile(filepath.Join(w.root, filepath.FromSlash(rel)))
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	return data, true, nil
+}
+
+func (w workingTree) goFiles(dir string) ([]string, error) {
+	entries, err := os.ReadDir(filepath.Join(w.root, filepath.FromSlash(dir)))
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if !entry.IsDir() && strings.HasSuffix(entry.Name(), ".go") {
+			names = append(names, entry.Name())
+		}
+	}
+	return names, nil
+}
+
+// commitTree is the tree the commit rev stores in the worktree's code checkout.
+type commitTree struct {
+	fabric *fabricengine.Fabric
+	rev    string
+}
+
+func (c commitTree) file(rel string) ([]byte, bool, error) {
+	return c.fabric.CodeFileAt(c.rev, rel)
+}
+
+func (c commitTree) goFiles(dir string) ([]string, error) {
+	names, err := c.fabric.CodeDirAt(c.rev, dir)
+	if err != nil {
+		return nil, err
+	}
+	return slices.DeleteFunc(names, func(name string) bool { return !strings.HasSuffix(name, ".go") }), nil
+}
+
+// redundancyCandidate is one test the step's selection takes: a current top-level test of a changed test file.
+type redundancyCandidate struct {
+	// pkg is the module-relative slash path of the test's package, "." for the module root.
+	pkg string
+	// file is the worktree-relative slash path of the test's file.
+	file string
+	fn   testcover.TestFunc
+}
+
+// changedTests returns the tests the step takes from tree, sorted by file and then name.
+// changed are the worktree-relative slash paths that differ between the merge base base and tree.
+// moduleRel is the worktree-relative slash path of the Go module; a path outside a package of it is passed over.
+// For each package holding a changed `_test.go` file, it reads the package's test files at base through fabric.
+// It takes each top-level test of a changed file that tree holds unless a test of that name at base has the same text.
+// So a test file moved within its package adds none of its unchanged tests, and a deleted test file adds none.
+func changedTests(tree redundancyTree, fabric *fabricengine.Fabric, base, moduleRel string, changed []string) ([]redundancyCandidate, error) {
+	filesByDir := map[string][]string{}
+	for _, rel := range changed {
+		if !strings.HasSuffix(rel, "_test.go") {
+			continue
+		}
+		if dir := path.Dir(rel); isModulePackage(moduleRel, dir) {
+			filesByDir[dir] = append(filesByDir[dir], rel)
+		}
+	}
+	var taken []redundancyCandidate
+	for _, dir := range slices.Sorted(maps.Keys(filesByDir)) {
+		pkg := modulePackageOf(moduleRel, dir)
+		var current []redundancyCandidate
+		files := slices.Sorted(slices.Values(filesByDir[dir]))
+		for _, file := range slices.Compact(files) {
+			data, found, err := tree.file(file)
+			if err != nil {
+				return nil, fmt.Errorf("read %s: %w", file, err)
+			}
+			if !found {
+				continue
+			}
+			funcs, err := testcover.ParseTestFuncs(file, data)
+			if err != nil {
+				return nil, err
+			}
+			for _, fn := range funcs {
+				current = append(current, redundancyCandidate{pkg: pkg, file: file, fn: fn})
+			}
+		}
+		if len(current) == 0 {
+			continue
+		}
+		atBase, err := testHashesAt(fabric, base, dir)
+		if err != nil {
+			return nil, err
+		}
+		for _, candidate := range current {
+			if hash, found := atBase[candidate.fn.Name]; !found || hash != candidate.fn.Hash {
+				taken = append(taken, candidate)
+			}
+		}
+	}
+	slices.SortFunc(taken, func(a, b redundancyCandidate) int {
+		return cmp.Or(strings.Compare(a.file, b.file), strings.Compare(a.fn.Name, b.fn.Name))
+	})
+	return taken, nil
+}
+
+// testHashesAt returns the function hash of each top-level test, by name.
+// It reads the `_test.go` files directly in dir at the commit rev.
+// dir is worktree-relative and slash-separated; a directory absent at rev holds none.
+func testHashesAt(fabric *fabricengine.Fabric, rev, dir string) (map[string]string, error) {
+	names, err := fabric.CodeDirAt(rev, dir)
+	if err != nil {
+		return nil, err
+	}
+	hashes := map[string]string{}
+	for _, name := range names {
+		if !strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		rel := path.Join(dir, name)
+		data, found, err := fabric.CodeFileAt(rev, rel)
+		if err != nil {
+			return nil, err
+		}
+		if !found {
+			continue
+		}
+		funcs, err := testcover.ParseTestFuncs(rel, data)
+		if err != nil {
+			return nil, fmt.Errorf("at %s: %w", rev, err)
+		}
+		for _, fn := range funcs {
+			hashes[fn.Name] = fn.Hash
+		}
+	}
+	return hashes, nil
+}
+
+// isModulePackage reports whether the worktree-relative slash directory dir is a package of the module at moduleRel.
+// It is one a package walk enters: no testdata, and no directory whose name opens with a dot or an underscore.
+func isModulePackage(moduleRel, dir string) bool {
+	if moduleRel != "." && dir != moduleRel && !strings.HasPrefix(dir, moduleRel+"/") {
+		return false
+	}
+	pkg := modulePackageOf(moduleRel, dir)
+	if pkg == "." {
+		return true
+	}
+	return !slices.ContainsFunc(strings.Split(pkg, "/"), func(segment string) bool {
+		return segment == "testdata" || strings.HasPrefix(segment, ".") || strings.HasPrefix(segment, "_")
+	})
+}
+
+// modulePackageOf returns the module-relative slash path of the package whose worktree-relative directory is dir.
+// dir lies in the module at moduleRel.
+func modulePackageOf(moduleRel, dir string) string {
+	switch {
+	case moduleRel == ".":
+		return dir
+	case dir == moduleRel:
+		return "."
+	}
+	return strings.TrimPrefix(dir, moduleRel+"/")
+}
+
+// packageDirOf returns the worktree-relative slash directory of the package pkg of the module at moduleRel.
+func packageDirOf(moduleRel, pkg string) string {
+	return path.Join(moduleRel, pkg)
+}
+
+// goFileHashes returns the ContentHash of each Go file, by name.
+// It reads the files directly in the worktree-relative slash directory dir of tree.
+func goFileHashes(tree redundancyTree, dir string) (map[string]string, error) {
+	names, err := tree.goFiles(dir)
+	if err != nil {
+		return nil, err
+	}
+	hashes := map[string]string{}
+	for _, name := range names {
+		data, found, err := tree.file(path.Join(dir, name))
+		if err != nil {
+			return nil, err
+		}
+		if found {
+			hashes[name] = testcover.ContentHash(data)
+		}
+	}
+	return hashes, nil
+}
+
+// testHashesOf returns the function hash of each of tests by package and then name, the form a report records them in.
+func testHashesOf(tests []redundancyCandidate) map[string]map[string]string {
+	hashes := map[string]map[string]string{}
+	for _, test := range tests {
+		if hashes[test.pkg] == nil {
+			hashes[test.pkg] = map[string]string{}
+		}
+		hashes[test.pkg][test.fn.Name] = test.fn.Hash
+	}
+	return hashes
+}
+
+// goModule is the Go module the step judges, the one whose packages the coverage maps hold.
+type goModule struct {
+	// dir is the module root, rel its worktree-relative slash path and path its import path.
+	dir, rel, path string
+}
+
+// importPath returns the import path of the module-relative package pkg.
+func (m goModule) importPath(pkg string) string {
+	if pkg == "." {
+		return m.path
+	}
+	return m.path + "/" + pkg
+}
+
+// redundancyModule returns the module of the worktree at root that the coverage maps hold:
+// the dir of the lowest of tier0 and tier1 that cfg declares, whose go.mod names the import path.
+func redundancyModule(cfg gateslot.Config, root string) (goModule, error) {
+	for _, number := range mappedTiers {
+		tier, err := cfg.Tier(number)
+		if err != nil {
+			continue
+		}
+		dir := resolveRunDir(root, tier.Dir)
+		rel, err := filepath.Rel(root, dir)
+		modulePath := modulePathOf(dir)
+		if modulePath == "" || err != nil || !filepath.IsLocal(rel) {
+			return goModule{}, fmt.Errorf("%s holds no go.mod naming a module inside the worktree", dir)
+		}
+		return goModule{dir: dir, rel: filepath.ToSlash(rel), path: modulePath}, nil
+	}
+	return goModule{}, errors.New("the hub declares neither tier0 nor tier1, so no coverage map holds a test")
+}
