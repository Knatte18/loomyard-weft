+				writeFile(t, filepath.Join(empty, "gitdir"), " \n")
+				return filepath.Join(root, "repo"), []Worktree{
+					{Path: filepath.Join(root, "repo"), Head: commitA, Branch: "refs/heads/main"},
+				}
+			},
+		},
+		{
