+	t.Run("EditOfARunTaskIsRefusedWithTheRunLocksMessage", func(t *testing.T) {
+		t.Parallel()
+		server, board, _ := newTestServer(t, time.Minute)
+		twin, _ := newTestBoard(t)
+		_, wantErr := twin.UpsertTaskReporting(map[string]any{"slug": "run-task", "title": "Other"})
+		if wantErr == nil {
+			t.Fatalf("the direct edit of a run task was accepted")
+		}
+		recorder := write(t, server, map[string]any{"op": "edit", "slug": "run-task", "revision": viewEntry(t, board, "run-task").Revision, "fields": map[string]any{"title": "Other"}})
+		if got := decode(t, recorder); recorder.Code != http.StatusUnprocessableEntity || got.Error != wantErr.Error() {
+			t.Errorf("answer = %d %q; want 422 with %q", recorder.Code, got.Error, wantErr.Error())
+		}
+	})
+
+	t.Run("StaleWritesAnswerTheFreshEntry", func(t *testing.T) {
+		t.Parallel()
+		server, board, boardPath := newTestServer(t, time.Minute)
+		old := viewEntry(t, board, "draft-task").Revision
+		if _, err := board.SetStatusReleasingProject("draft-task", nil); err != nil {
+			t.Fatalf("release draft-task: %v", err)
+		}
+		before := boardJSON(t, boardPath)
+
+		existing := decode(t, write(t, server, map[string]any{"op": "create", "slug": "ready-task", "fields": map[string]any{"kind": "task", "title": "Again", "labels": []any{"bug"}}}))
+		if want := viewEntry(t, board, "ready-task"); existing.Entry == nil || !reflect.DeepEqual(*existing.Entry, want) {
+			t.Errorf("create of an existing slug answered %+v; want 409 with %+v", existing, want)
+		}
+		for _, op := range []string{"edit", "release"} {
+			payload := map[string]any{"op": op, "slug": "draft-task", "revision": old}
+			if op == "edit" {
+				payload["fields"] = map[string]any{"title": "Late"}
+			}
+			recorder := write(t, server, payload)
+			got := decode(t, recorder)
+			if want := viewEntry(t, board, "draft-task"); recorder.Code != http.StatusConflict || got.Entry == nil || !reflect.DeepEqual(*got.Entry, want) {
+				t.Errorf("%s with an old revision = %d %+v; want 409 with %+v", op, recorder.Code, got, want)
+			}
+		}
+		if !bytes.Equal(boardJSON(t, boardPath), before) {
+			t.Errorf("board.json changed through a stale write")
+		}
+
+		removedRevision := viewEntry(t, board, "ready-task").Revision
+		if err := board.RemoveTask("ready-task"); err != nil {
+			t.Fatalf("remove ready-task: %v", err)
+		}
+		recorder := write(t, server, map[string]any{"op": "release", "slug": "ready-task", "revision": removedRevision})
+		if got := decode(t, recorder); recorder.Code != http.StatusConflict || got.Entry != nil || !strings.Contains(got.Error, "was removed") {
+			t.Errorf("release of a removed entry = %d %+v; want 409 with no entry", recorder.Code, got)
+		}
+		if !strings.Contains(recorder.Body.String(), `"entry":null`) {
+			t.Errorf("body = %s; want an explicit null entry", recorder.Body.String())
+		}
+	})
+
+	t.Run("LongPollAnswersUnchangedOnTheBound", func(t *testing.T) {
+		t.Parallel()
+		server, _, _ := newTestServer(t, 20*time.Millisecond)
+		current := decode(t, call(server, http.MethodGet, routeBoard, nil, authorized)).Revision
+		got := decode(t, call(server, http.MethodGet, routeBoard+"?after="+current, nil, authorized))
+		if !got.OK || !got.Unchanged || got.Revision != current || got.Board != nil {
+			t.Errorf("answer = %+v; want unchanged at %q", got, current)
+		}
+	})
+
+	t.Run("LongPollOnABoardWithNoBoardJSONWaitsInsteadOfAnsweringAtOnce", func(t *testing.T) {
+		t.Parallel()
+		boardPath := t.TempDir()
+		board := boardengine.New(boardengine.Config{Path: boardPath, Readme: "Home.md", DesignPrefix: "design-", SkipGit: true, Clock: func() time.Time { return testClock }})
+		server := NewServer(ServerConfig{Board: board, BoardPath: boardPath, Token: testToken, Port: testPort, LongPollBound: 20 * time.Millisecond, Now: func() time.Time { return testClock }})
+		first := decode(t, call(server, http.MethodGet, routeBoard, nil, authorized))
+		if !first.OK || first.Unchanged || first.Revision != "" || first.Board == nil {
+			t.Fatalf("first read = %+v; want the board at once, at the empty revision", first)
+		}
+		got := decode(t, call(server, http.MethodGet, routeBoard+"?after=", nil, authorized))
+		if !got.OK || !got.Unchanged || got.Revision != "" || got.Board != nil {
+			t.Errorf("poll with an empty after = %+v; want unchanged at the empty revision after the bound", got)
+		}
+	})
+
+	t.Run("LongPollReturnsTheNewProjectionOnAChange", func(t *testing.T) {
+		t.Parallel()
+		server, _, _ := newTestServer(t, time.Minute)
+		current := decode(t, call(server, http.MethodGet, routeBoard, nil, authorized)).Revision
+		recorders := make(chan *httptest.ResponseRecorder, 1)
+		go func() {
+			recorders <- call(server, http.MethodGet, routeBoard+"?after="+current, nil, authorized)
+		}()
+		server.BoardChanged("changed-revision")
+		got := decode(t, <-recorders)
+		if !got.OK || got.Unchanged || got.Revision != "changed-revision" || got.Board == nil {
+			t.Errorf("answer = %+v; want the new projection at changed-revision", got)
+		}
+	})
+
+	t.Run("DrainAnswersAWaiterUnchangedAtOnce", func(t *testing.T) {
+		t.Parallel()
+		server, _, _ := newTestServer(t, time.Minute)
+		current := decode(t, call(server, http.MethodGet, routeBoard, nil, authorized)).Revision
+		recorders := make(chan *httptest.ResponseRecorder, 1)
+		go func() {
+			recorders <- call(server, http.MethodGet, routeBoard+"?after="+current, nil, authorized)
+		}()
+		server.beginDrain()
+		if got := decode(t, <-recorders); !got.OK || !got.Unchanged {
+			t.Errorf("answer = %+v; want unchanged", got)
+		}
+		if got := decode(t, call(server, http.MethodGet, routeBoard+"?after="+current, nil, authorized)); !got.Unchanged {
+			t.Errorf("a long poll after the drain = %+v; want unchanged at once", got)
+		}
+	})
+
+	t.Run("FileRouteServesOnlyTheFilesTheProjectionNames", func(t *testing.T) {
+		t.Parallel()
+		server, _, boardPath := newTestServer(t, time.Minute)
+		listed := call(server, http.MethodGet, routeFile+"design-draft-task.md?t="+testToken, nil, nil)
+		want, err := os.ReadFile(filepath.Join(boardPath, "design-draft-task.md"))
+		if err != nil {
+			t.Fatalf("read the design file: %v", err)
+		}
+		if listed.Code != http.StatusOK || listed.Body.String() != string(want) || listed.Header().Get("Content-Type") != "text/plain; charset=utf-8" {
+			t.Errorf("listed file = %d %q %q; want 200, its text and text/plain", listed.Code, listed.Body.String(), listed.Header().Get("Content-Type"))
+		}
+		for _, name := range []string{"board.json", "a/b.md", "design-nope.md"} {
+			recorder := call(server, http.MethodGet, routeFile+name+"?t="+testToken, nil, nil)
+			if recorder.Code != http.StatusNotFound {
+				t.Errorf("GET %s = %d; want 404", name, recorder.Code)
+			}
+			requireHardenedHeaders(t, name, recorder)
+		}
+	})
+}
diff --git a/internal/boardserve/state.go b/internal/boardserve/state.go
new file mode 100644
index 00000000..f52b5eff
--- /dev/null
+++ b/internal/boardserve/state.go
@@ -0,0 +1,143 @@
+// state.go holds the board server's files under the hub's scratch directory and the reads that describe a running server:
+// the state record, the liveness test, the launcher page and the probe.
+
+package boardserve
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// File names under the server's state directory.
+const (
+	stateFileName    = "state.json"
+	stateLockName    = "state.lock"
+	serverLockName   = "server.lock"
+	launcherFileName = "launcher.html"
+	serverLogName    = "server.log"
+)
+
+// StatePaths holds where the board server keeps its files.
+type StatePaths struct {
+	// Dir is the state directory.
+	Dir string
+	// State is the record of the running server's pid, port and token.
+	State string
+	// StateLock guards State; it is never the server's own lock.
+	StateLock string
+	// Lock is held for as long as a server serves the hub.
+	Lock string
+	// Launcher is the page that sends the browser to the server with its token.
+	Launcher string
+	// Log is the server's log.
+	Log string
+}
+
+// Paths returns the board server's files under hubScratchDir, the hub's board-level `.lym`.
+func Paths(hubScratchDir string) StatePaths {
+	dir := filepath.Join(hubScratchDir, lymdirs.BoardServeDirName)
+	return StatePaths{
+		Dir:       dir,
+		State:     filepath.Join(dir, stateFileName),
+		StateLock: filepath.Join(dir, stateLockName),
+		Lock:      filepath.Join(dir, serverLockName),
+		Launcher:  filepath.Join(dir, launcherFileName),
+		Log:       filepath.Join(dir, serverLogName),
+	}
+}
+
+// State is the record a serving board server leaves for `lym board open`.
+// The token is the bearer credential of the server's API, so the file holding it is readable by its owner alone.
+type State struct {
+	PID   int    `json:"pid"`
+	Port  int    `json:"port"`
+	Token string `json:"token"`
+}
+
+// ReadState reads the state file.
+// It reports false, with no error, when none exists.
+// A file that holds a key State does not declare reads without it.
+func ReadState(paths StatePaths) (State, bool, error) {
+	return state.ReadJSON[State](paths.State, paths.StateLock)
+}
+
+// writeState writes the state file readable by its owner alone.
+func writeState(paths StatePaths, st State) error {
+	if err := state.WriteJSON(paths.State, paths.StateLock, st); err != nil {
+		return fmt.Errorf("write the board server state: %w", err)
+	}
+	return hardenFile(paths.State)
+}
+
+// Live reports whether a board server holds the hub's lock, which is a serving or a starting server.
+// The lock is tried without blocking and released at once when it was free.
+// A free lock reads not live, whatever a state file says.
+// A state directory that does not exist reads as no server and is not created.
+func Live(paths StatePaths) (bool, error) {
+	if _, err := os.Stat(paths.Dir); errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(paths.Lock)
+	if err != nil {
+		return false, err
+	}
+	if !acquired {
+		return true, nil
+	}
+	return false, held.Release()
+}
+
+// PageAddress returns the address of the page a server on port serves.
+// It names the loopback address and never localhost, which the server's Host check refuses.
+func PageAddress(port int) string {
+	return fmt.Sprintf("http://%s:%d/", loopbackHost, port)
+}
+
+// WriteLauncher writes the launcher page for the server st describes and returns its path.
+// The page's script replaces its location with the server's address and the token after a `#`,
+// so the token travels in the fragment, which a browser never sends to a server.
+// The file is readable by its owner alone, since it holds the token.
+func WriteLauncher(paths StatePaths, st State) (string, error) {
+	target, err := json.Marshal(PageAddress(st.Port) + "#" + st.Token)
+	if err != nil {
+		return "", fmt.Errorf("encode the launcher address: %w", err)
+	}
+	page := "<!doctype html>\n<meta charset=\"utf-8\">\n<title>board</title>\n<script>location.replace(" + string(target) + ")</script>\n"
+	if err := os.MkdirAll(paths.Dir, 0o755); err != nil {
+		return "", fmt.Errorf("create the board server state directory: %w", err)
+	}
+	if err := os.WriteFile(paths.Launcher, []byte(page), 0o600); err != nil {
+		return "", fmt.Errorf("write the launcher page: %w", err)
+	}
+	if err := hardenFile(paths.Launcher); err != nil {
+		return "", err
+	}
+	return paths.Launcher, nil
+}
+
+// Probe asks the server st describes for its board and succeeds when it answers 200 within timeout.
+func Probe(st State, timeout time.Duration) error {
+	request, err := http.NewRequest(http.MethodGet, PageAddress(st.Port)+"api/board", nil)
+	if err != nil {
+		return fmt.Errorf("build the probe request: %w", err)
+	}
+	request.Header.Set("Authorization", "Bearer "+st.Token)
+	response, err := (&http.Client{Timeout: timeout}).Do(request)
+	if err != nil {
+		return fmt.Errorf("probe the board server on port %d: %w", st.Port, err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("probe the board server on port %d: it answered %s", st.Port, response.Status)
+	}
+	return nil
+}
diff --git a/internal/boardserve/testmain_test.go b/internal/boardserve/testmain_test.go
new file mode 100644
index 00000000..735988e7
--- /dev/null
+++ b/internal/boardserve/testmain_test.go
@@ -0,0 +1,20 @@
+// testmain_test.go wires the package's test binary into the hermetic git test environment.
+// gitkit.HermeticGitEnv() runs once before any test, so git fixtures never inherit the operator's global gitconfig.
+// See PATTERN-test-isolation.
+// The binary also runs under tmux isolation through tmuxkit.Main.
+
+package boardserve
+
+import (
+	"os"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxkit"
+)
+
+// TestMain runs HermeticGitEnv before any test spawns git, then runs the tests under tmuxkit.Main.
+func TestMain(m *testing.M) {
+	gitkit.HermeticGitEnv()
+	os.Exit(tmuxkit.Main(m))
+}
diff --git a/internal/boardserve/write.go b/internal/boardserve/write.go
new file mode 100644
index 00000000..3a037505
--- /dev/null
+++ b/internal/boardserve/write.go
@@ -0,0 +1,216 @@
+// write.go applies the six writes the viewer page sends: create, edit, release, promote, draft and undraft.
+// Each goes through one exported method of the board, so the board's own checks all run.
+
+package boardserve
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+)
+
+// The ops of a write request.
+const (
+	opCreate  = "create"
+	opEdit    = "edit"
+	opRelease = "release"
+	opPromote = "promote"
+	opDraft   = "draft"
+	opUndraft = "undraft"
+)
+
+// writeOps lists the ops in the order refusals name them.
+var writeOps = []string{opCreate, opEdit, opRelease, opPromote, opDraft, opUndraft}
+
+// opFields is the fields each op may carry; an op absent here takes none.
+var opFields = map[string][]string{
+	opCreate: {"kind", "title", "labels", "brief", "body", "project", "depends_on"},
+	opEdit:   {"title", "labels", "brief", "body", "project", "depends_on"},
+}
+
+// writeRequest is the body of POST /api/write.
+// Revision is the entry revision the page read, empty for a create.
+type writeRequest struct {
+	Op       string         `json:"op"`
+	Slug     string         `json:"slug"`
+	Revision string         `json:"revision"`
+	Fields   map[string]any `json:"fields"`
+}
+
+// requestKeys are the keys a write request may carry.
+var requestKeys = []string{"op", "slug", "revision", "fields"}
+
+// decodeWriteRequest decodes body, one JSON object, into request, and refuses a key the request does not define.
+func decodeWriteRequest(body []byte, request *writeRequest) error {
+	var keys map[string]json.RawMessage
+	if err := json.Unmarshal(body, &keys); err != nil {
+		return err
+	}
+	for key := range keys {
+		if !slices.Contains(requestKeys, key) {
+			return fmt.Errorf("key %q is not part of a write request: way forward: send only %s", key, strings.Join(requestKeys, ", "))
+		}
+	}
+	return json.Unmarshal(body, request)
+}
+
+// staleView is a stale refusal the server derives from its own view of the board, for the ops whose rule reads the entry.
+// It answers like the board's own *boardengine.StaleEntryError.
+type staleView struct {
+	message string
+	fresh   *boardengine.ViewEntry
+}
+
+// Error returns the refusal's message.
+func (e *staleView) Error() string { return e.message }
+
+// staleEntry reports whether err is a stale refusal, and returns the fresh entry it carries, nil when the entry is gone.
+func staleEntry(err error) (*boardengine.ViewEntry, bool) {
+	var fromBoard *boardengine.StaleEntryError
+	if errors.As(err, &fromBoard) {
+		return fromBoard.Fresh, true
+	}
+	var fromView *staleView
+	if errors.As(err, &fromView) {
+		return fromView.fresh, true
+	}
+	return nil, false
+}
+
+// entryOf returns the entry slug of view and whether the view holds it.
+func entryOf(view boardengine.BoardView, slug string) (boardengine.ViewEntry, bool) {
+	index := slices.IndexFunc(view.Entries, func(e boardengine.ViewEntry) bool { return e.Slug == slug })
+	if index < 0 {
+		return boardengine.ViewEntry{}, false
+	}
+	return view.Entries[index], true
+}
+
+// checkRequest refuses an op or field the page does not send, before any write.
+// It also refuses a missing revision, and a revision on a create.
+func checkRequest(request writeRequest) error {
+	if !slices.Contains(writeOps, request.Op) {
+		return fmt.Errorf("unknown op %q: way forward: send one of %s", request.Op, strings.Join(writeOps, ", "))
+	}
+	allowed := opFields[request.Op]
+	for field := range request.Fields {
+		if !slices.Contains(allowed, field) {
+			list := "no fields"
+			if len(allowed) > 0 {
+				list = "only " + strings.Join(allowed, ", ")
+			}
+			return fmt.Errorf("field %q is not allowed for %s: way forward: send %s", field, request.Op, list)
+		}
+	}
+	if request.Op != opCreate && request.Revision == "" {
+		return fmt.Errorf("%s of entry %q carries no revision, so nothing was written: way forward: reload the board and act on what it holds now", request.Op, request.Slug)
+	}
+	if request.Op == opCreate && request.Revision != "" {
+		return fmt.Errorf("create of entry %q carries a revision, so nothing was written: way forward: send a create with no revision", request.Slug)
+	}
+	return nil
+}
+
+// applyWrite runs the one board write of request.Op and returns the entry as the board holds it afterwards.
+// The write runs on a board that expects request.Revision.
+// Its write section refuses a stale revision under the write lock.
+// A stale refusal is a *boardengine.StaleEntryError or a *staleView; any other error is the board's own refusal.
+func (s *Server) applyWrite(request writeRequest) (boardengine.ViewEntry, error) {
+	if err := checkRequest(request); err != nil {
+		return boardengine.ViewEntry{}, err
+	}
+	expecting := s.cfg.Board.Expecting(request.Slug, request.Revision)
+	var err error
+	switch request.Op {
+	case opCreate, opEdit:
+		fields := map[string]any{"slug": request.Slug}
+		for key, value := range request.Fields {
+			fields[key] = value
+		}
+		_, err = expecting.UpsertTaskReporting(fields)
+	case opPromote:
+		err = s.promote(expecting, request)
+	default:
+		err = s.setStatus(expecting, request)
+	}
+	if err != nil {
+		return boardengine.ViewEntry{}, err
+	}
+	view, err := s.cfg.Board.View()
+	if err != nil {
+		return boardengine.ViewEntry{}, fmt.Errorf("read the board after the write: %w", err)
+	}
+	entry, found := entryOf(view, request.Slug)
+	if !found {
+		return boardengine.ViewEntry{}, fmt.Errorf("entry %q is not on the board after the write", request.Slug)
+	}
+	return entry, nil
+}
+
+// promote makes the note request.Slug a task.
+// A task is refused before the write; the write section decides a stale revision and refuses a project.
+func (s *Server) promote(expecting *boardengine.Board, request writeRequest) error {
+	view, err := s.cfg.Board.View()
+	if err != nil {
+		return fmt.Errorf("read the board: %w", err)
+	}
+	if entry, found := entryOf(view, request.Slug); found && entry.Kind == boardengine.KindTask {
+		return fmt.Errorf("entry %q is a task already, and only a note is promoted: way forward: edit it, or promote a note", request.Slug)
+	}
+	_, err = expecting.PromoteTo(request.Slug, "", nil)
+	return err
+}
+
+// setStatus runs release, draft or undraft of the task request.Slug.
+// Their rule reads the entry's kind and status, so it reads them from the current view,
+// and the write section re-checks the revision of the entry the rule judged.
+func (s *Server) setStatus(expecting *boardengine.Board, request writeRequest) error {
+	view, err := s.cfg.Board.View()
+	if err != nil {
+		return fmt.Errorf("read the board: %w", err)
+	}
+	entry, found := entryOf(view, request.Slug)
+	if !found {
+		return &staleView{message: fmt.Sprintf("entry %q was removed since the page read it, so nothing was written: way forward: reload the board and act on what it holds now", request.Slug)}
+	}
+	if entry.Revision != request.Revision {
+		return &staleView{
+			message: fmt.Sprintf("entry %q changed since the page read it, so nothing was written: way forward: compare the fresh entry and send the edit again", request.Slug),
+			fresh:   &entry,
+		}
+	}
+	if entry.Kind != boardengine.KindTask {
+		return fmt.Errorf("entry %q is a %s, and the page's %s takes a task: way forward: set a note's or project's status with lym board set-status", request.Slug, entry.Kind, request.Op)
+	}
+	status := entry.Status
+	held := boardengine.IsRunStatus(&status)
+
+	var target *string
+	switch request.Op {
+	case opRelease:
+		if held {
+			return fmt.Errorf("entry %q is held by a run (status %q), and a release from the page would let its parent's dobby start it while the run holds its pair: way forward: release it with lym board set-status", request.Slug, status)
+		}
+	case opDraft:
+		if status != "" {
+			return fmt.Errorf("draft takes a task with no status; entry %q has status %q: way forward: release it first, or leave it", request.Slug, status)
+		}
+		draft := boardengine.StatusDraft
+		target = &draft
+	case opUndraft:
+		switch {
+		case status == "":
+			return fmt.Errorf("entry %q has no status, so it is released already and nothing was written", request.Slug)
+		case held:
+			return fmt.Errorf("entry %q is held by a run (status %q): way forward: clear it with lym board set-status", request.Slug, status)
+		case status != boardengine.StatusDraft:
+			return fmt.Errorf("undraft takes a draft task; entry %q has status %q: way forward: release it with the page's release", request.Slug, status)
+		}
+	}
+	_, err = expecting.SetStatusReleasingProject(request.Slug, target)
+	return err
+}
diff --git a/internal/fabricengine/doc.go b/internal/fabricengine/doc.go
index baa0001d..09655ff3 100644
--- a/internal/fabricengine/doc.go
+++ b/internal/fabricengine/doc.go
