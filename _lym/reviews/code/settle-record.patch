diff --git a/internal/shedworktree/shedworktree.go b/internal/shedworktree/shedworktree.go
new file mode 100644
index 00000000..1d49ca42
--- /dev/null
+++ b/internal/shedworktree/shedworktree.go
@@ -0,0 +1,108 @@
+// Package shedworktree reads a task's code worktree through fabric's read-only reads.
+// It serves the arbiter's worktree seam, where the arbiter may make one fix of its own,
+// and the snapshot of the worktree a tackler must leave unchanged.
+package shedworktree
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/shedarbiter"
+	"github.com/Knatte18/loomyard/internal/sheddriver"
+)
+
+// ArbiterSeam returns the arbiter's seam over the task's code worktree at location.
+func ArbiterSeam(location *lymcwd.Location) *shedarbiter.WorktreeSeam {
+	return &shedarbiter.WorktreeSeam{
+		Snapshot: func() (sheddriver.WorktreeSnapshot, error) { return Snapshot(location) },
+		IsAncestor: func(sha, ref string) (bool, error) {
+			fab, err := fabricengine.Open(location)
+			if err != nil {
+				return false, err
+			}
+			return fab.IsAncestor(sha, ref)
+		},
+		Changes: func() (map[string]string, error) {
+			fab, err := fabricengine.Open(location)
+			if err != nil {
+				return nil, err
+			}
+			paths, err := fab.CodeWorktreeChanges()
+			if err != nil {
+				return nil, err
+			}
+			changes := make(map[string]string, len(paths))
+			for _, path := range paths {
+				hash, err := hashFileOrDeleted(filepath.Join(location.WorktreePath(), filepath.FromSlash(path)))
+				if err != nil {
+					return nil, fmt.Errorf("hash uncommitted path %s: %w", path, err)
+				}
+				changes[path] = hash
+			}
+			return changes, nil
+		},
+		CommitLog: func(from, to string) ([]string, error) {
+			fab, err := fabricengine.Open(location)
+			if err != nil {
+				return nil, err
+			}
+			return fab.CommitLog(from, to)
+		},
+	}
+}
+
+// Snapshot reads the state a session must leave unchanged in the task's code worktree:
+// HEAD, branch and the SHA-256 of each tracked dirty path.
+// The records side is left out, since the run's own records change under every step.
+func Snapshot(location *lymcwd.Location) (sheddriver.WorktreeSnapshot, error) {
+	fab, err := fabricengine.Open(location)
+	if err != nil {
+		return sheddriver.WorktreeSnapshot{}, err
+	}
+	head, err := fab.HeadSHA()
+	if err != nil {
+		return sheddriver.WorktreeSnapshot{}, err
+	}
+	branch, err := fab.CurrentBranch()
+	if err != nil {
+		return sheddriver.WorktreeSnapshot{}, err
+	}
+	paths, err := fab.DirtyPaths()
+	if err != nil {
+		return sheddriver.WorktreeSnapshot{}, err
+	}
+	codeRoot := location.WorktreePath() + string(filepath.Separator)
+	dirty := map[string]string{}
+	for _, path := range paths {
+		if !strings.HasPrefix(path, codeRoot) {
+			continue
+		}
+		hash, err := hashFileOrDeleted(path)
+		if err != nil {
+			return sheddriver.WorktreeSnapshot{}, fmt.Errorf("hash dirty path %s: %w", path, err)
+		}
+		dirty[path] = hash
+	}
+	return sheddriver.WorktreeSnapshot{Head: head, Branch: branch, Dirty: dirty}, nil
+}
+
+// hashFileOrDeleted returns the hex SHA-256 of the file at path, or "deleted" when the file does not exist.
+func hashFileOrDeleted(path string) (string, error) {
+	content, err := os.ReadFile(path)
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		return "deleted", nil
+	case err != nil:
+		return "", err
+	}
+	sum := sha256.Sum256(content)
+	return hex.EncodeToString(sum[:]), nil
+}
diff --git a/internal/shedworktree/shedworktree_test.go b/internal/shedworktree/shedworktree_test.go
new file mode 100644
index 00000000..4123ef50
--- /dev/null
+++ b/internal/shedworktree/shedworktree_test.go
@@ -0,0 +1,63 @@
+package shedworktree_test
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"maps"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/shedworktree"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestArbiterSeam_Changes covers the arbiter seam's read of the uncommitted paths over a real checkout.
+// It lists an untracked file, a modified tracked file and a removed tracked file.
+// Each key is a slash-separated path relative to the worktree.
+// Each file is hashed from its place under the worktree, and a removed file reads as deleted.
+func TestArbiterSeam_Changes(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	hash := func(content string) string {
+		sum := sha256.Sum256([]byte(content))
+		return hex.EncodeToString(sum[:])
+	}
+	hub := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	worktree := hub.PrimeWorktree()
+	gitkit.CommitFile(t, worktree, "kept.go", "kept", "add kept")
+	gitkit.CommitFile(t, worktree, "edited.go", "before", "add edited")
+	gitkit.CommitFile(t, worktree, "removed.go", "removed", "add removed")
+
+	seam := shedworktree.ArbiterSeam(hub.Location)
+	got, err := seam.Changes()
+	if err != nil || len(got) != 0 {
+		t.Fatalf("Changes() over a clean worktree = %v, %v; want none, nil", got, err)
+	}
+
+	if err := os.WriteFile(filepath.Join(worktree, "edited.go"), []byte("after"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(worktree, "removed.go")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(worktree, "sub"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(worktree, "sub", "new.go"), []byte("new"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	want := map[string]string{
+		"edited.go":  hash("after"),
+		"removed.go": "deleted",
+		"sub/new.go": hash("new"),
+	}
+	got, err = seam.Changes()
+	if err != nil || !maps.Equal(got, want) {
+		t.Errorf("Changes() = %v, %v; want %v, nil", got, err, want)
+	}
+}
diff --git a/internal/shedworktree/testmain_test.go b/internal/shedworktree/testmain_test.go
new file mode 100644
index 00000000..cf3100b7
--- /dev/null
+++ b/internal/shedworktree/testmain_test.go
@@ -0,0 +1,20 @@
+// testmain_test.go wires the package's test binary into the hermetic git test environment:
+// gitkit.HermeticGitEnv() runs once before any test, so the hub fixtures never inherit the operator's global gitconfig.
+// The binary also runs under tmux isolation through tmuxkit.Main.
+
+package shedworktree_test
+
+import (
+	"os"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxkit"
+)
+
+// TestMain runs gitkit.HermeticGitEnv() before any test in this package spawns git.
+// It then runs the tests under tmuxkit.Main.
+func TestMain(m *testing.M) {
+	gitkit.HermeticGitEnv()
+	os.Exit(tmuxkit.Main(m))
+}
