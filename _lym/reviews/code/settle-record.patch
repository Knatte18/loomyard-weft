+		h.visitErr = errors.New("no visit")
+		entry := h.wrap(t, verifyEntry(gate, 2))
+		if _, err := entry.Gate(); err == nil || !strings.Contains(err.Error(), "no visit") {
+			t.Errorf("Gate() error = %v; want the visit directory error", err)
