index 00000000..c1491645
--- /dev/null
+++ b/internal/shuttleengine/claudeengine/accountstore_test.go
@@ -0,0 +1,142 @@
+// accountstore_test.go tests the account file and the usage records: their merge, their reads and their rewrites.
+
+package claudeengine
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestMergeUsage pins the usage merge and the reads and rewrites of the two cache files.
+func TestMergeUsage(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	window := func(percentage float64, resetsAt int64) usageWindow {
+		return usageWindow{UsedPercentage: percentage, ResetsAt: resetsAt}
+	}
+	record := func(windows map[string]usageWindow) usageRecord { return usageRecord{Windows: windows} }
+	blockedUntil := time.Unix(5_000, 0).UTC()
+
+	merges := []struct {
+		name         string
+		stored, read usageRecord
+		want         usageRecord
+	}{
+		{"ALaterResetReplaces", record(map[string]usageWindow{"five_hour": window(90, 100)}), record(map[string]usageWindow{"five_hour": window(10, 200)}), record(map[string]usageWindow{"five_hour": window(10, 200)})},
+		{"TheSameResetKeepsTheHigherPercentage", record(map[string]usageWindow{"five_hour": window(40, 100)}), record(map[string]usageWindow{"five_hour": window(60, 100)}), record(map[string]usageWindow{"five_hour": window(60, 100)})},
+		{"TheSameResetWithALowerPercentageKeepsTheStoredWindow", record(map[string]usageWindow{"five_hour": window(60, 100)}), record(map[string]usageWindow{"five_hour": window(40, 100)}), record(map[string]usageWindow{"five_hour": window(60, 100)})},
+		{"AnEarlierResetIsDropped", record(map[string]usageWindow{"five_hour": window(10, 200)}), record(map[string]usageWindow{"five_hour": window(90, 100)}), record(map[string]usageWindow{"five_hour": window(10, 200)})},
+		{"AWindowOnlyOneSideHoldsIsKept", record(map[string]usageWindow{"five_hour": window(10, 100)}), record(map[string]usageWindow{"seven_day": window(20, 900)}), record(map[string]usageWindow{"five_hour": window(10, 100), "seven_day": window(20, 900)})},
+		{"BlockedUntilSurvivesAMerge", usageRecord{BlockedUntil: blockedUntil}, record(map[string]usageWindow{"five_hour": window(10, 100)}), usageRecord{Windows: map[string]usageWindow{"five_hour": window(10, 100)}, BlockedUntil: blockedUntil}},
+	}
+	for _, tt := range merges {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			if got := mergeUsage(tt.stored, tt.read); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("mergeUsage(%+v, %+v) = %+v; want %+v", tt.stored, tt.read, got, tt.want)
+			}
+		})
+	}
+
+	t.Run("AMissingUsageFileReadsAsTheZeroRecord", func(t *testing.T) {
+		t.Parallel()
+
+		got, err := readUsage(t.TempDir(), []AccountConfig{{Name: "a"}})
+		if want := map[string]usageRecord{"a": {}}; err != nil || !reflect.DeepEqual(got, want) {
+			t.Errorf("readUsage() = %+v, %v; want %+v, nil", got, err, want)
+		}
+	})
+
+	t.Run("AnUndecodableAccountFileAndUsageFileReadAsZeroRecords", func(t *testing.T) {
+		t.Parallel()
+
+		dir := t.TempDir()
+		for _, path := range []string{accountFilePath(dir), usageFilePath(dir, "a")} {
+			if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+				t.Fatalf("create the directory of %s: %v", path, err)
+			}
+			if err := os.WriteFile(path, []byte("{not json"), 0o644); err != nil {
+				t.Fatalf("write %s: %v", path, err)
+			}
+		}
+		if file, err := readAccountFile(dir); err != nil || !reflect.DeepEqual(file, accountFile{}) {
+			t.Errorf("readAccountFile() = %+v, %v; want the zero file, nil", file, err)
+		}
+		if usage, err := readUsage(dir, []AccountConfig{{Name: "a"}}); err != nil || !reflect.DeepEqual(usage["a"], usageRecord{}) {
+			t.Errorf("readUsage() = %+v, %v; want the zero record, nil", usage, err)
+		}
+	})
+
+	t.Run("RecordBlockedKeepsTheLaterTimeAndTheWindowsAndWriteUsageKeepsTheBlock", func(t *testing.T) {
+		t.Parallel()
+
+		dir := t.TempDir()
+		later, earlier := time.Unix(9_000, 0).UTC(), time.Unix(8_000, 0).UTC()
+		steps := []func() error{
+			func() error {
+				return writeUsage(dir, "a", record(map[string]usageWindow{"five_hour": window(30, 100)}))
+			},
+			func() error { return recordBlocked(dir, "a", later) },
+			func() error { return recordBlocked(dir, "a", earlier) },
+			func() error {
+				return writeUsage(dir, "a", record(map[string]usageWindow{"five_hour": window(50, 100)}))
+			},
+		}
+		for i, step := range steps {
+			if err := step(); err != nil {
+				t.Fatalf("step %d: %v", i, err)
+			}
+		}
+		got, err := readUsage(dir, []AccountConfig{{Name: "a"}})
+		want := usageRecord{Windows: map[string]usageWindow{"five_hour": window(50, 100)}, BlockedUntil: later}
+		if err != nil || !got["a"].BlockedUntil.Equal(later) || !reflect.DeepEqual(got["a"].Windows, want.Windows) {
+			t.Errorf("readUsage() = %+v, %v; want %+v", got["a"], err, want)
+		}
+	})
+
+	t.Run("UpdateAccountFileKeepsAnUnknownKeyAndReplacesAnUndecodableFile", func(t *testing.T) {
+		t.Parallel()
+
+		dir := t.TempDir()
+		path := accountFilePath(dir)
+		if err := os.WriteFile(path, []byte(`{"counts":{"a":1},"future_key":7}`), 0o644); err != nil {
+			t.Fatalf("write the account file: %v", err)
+		}
+		bump := func(file accountFile) (accountFile, error) {
+			if file.Counts == nil {
+				file.Counts = map[string]float64{}
+			}
+			file.Counts["a"]++
+			return file, nil
+		}
+		if err := updateAccountFile(dir, bump); err != nil {
+			t.Fatalf("updateAccountFile() = %v; want nil", err)
+		}
+		data, err := os.ReadFile(path)
+		var raw map[string]json.RawMessage
+		if err != nil || json.Unmarshal(data, &raw) != nil || string(raw["future_key"]) != "7" {
+			t.Fatalf("account file after the update = %s, %v; want the unknown key kept", data, err)
+		}
+		if file, err := readAccountFile(dir); err != nil || file.Counts["a"] != 2 {
+			t.Errorf("readAccountFile() = %+v, %v; want a's count 2", file, err)
+		}
+
+		if err := os.WriteFile(path, []byte("{not json"), 0o644); err != nil {
+			t.Fatalf("write the undecodable account file: %v", err)
+		}
+		if err := updateAccountFile(dir, bump); err != nil {
+			t.Fatalf("updateAccountFile() over an undecodable file = %v; want nil", err)
+		}
+		if file, err := readAccountFile(dir); err != nil || file.Counts["a"] != 1 {
+			t.Errorf("readAccountFile() = %+v, %v; want a's count 1 over the zero file", file, err)
+		}
+	})
+}
diff --git a/internal/shuttleengine/claudeengine/accountswitch.go b/internal/shuttleengine/claudeengine/accountswitch.go
new file mode 100644
index 00000000..287fe417
--- /dev/null
+++ b/internal/shuttleengine/claudeengine/accountswitch.go
@@ -0,0 +1,111 @@
+// accountswitch.go implements shuttleengine.AccountSwitcher for the Claude engine:
+// the record of a usage limit against an account, and the move of the worktree to another account.
+
+package claudeengine
+
+import (
+	"fmt"
+	"runtime"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// Compile-time proof that Claude can switch a worktree's account at a usage limit.
+var _ shuttleengine.AccountSwitcher = (*Claude)(nil)
+
+// usageLimitFallback is how long a usage limit whose message states no reset blocks its account.
+const usageLimitFallback = 30 * time.Minute
+
+// SwitchAccount implements shuttleengine.AccountSwitcher.
+// It reads the account the run in runDir launched under.
+// A session on an unlisted directory records nothing and reports false.
+// It blocks that account until the reset the turn end's usage limit states.
+// When the limit states none, the block lasts usageLimitFallback from now.
+// A block already stored for a later time stays.
+// With fewer than two accounts of positive weight it then reports false.
+// Otherwise it decides under one hold of the account file's lock.
+// Under a hub pin it changes nothing and reports false.
+// The worktree may already resolve to another account with headroom, as after a sibling session's switch.
+// Then it writes nothing and reports true.
+// Otherwise it takes the best logged-in account but the launched one, with the pick's fallback off.
+// It writes that account as the worktree's entry and reports true.
+// With none eligible it changes nothing and reports false.
+// Under a beams pin the switch writes the worktree's entry only,
+// and the pinned account's block makes the resolution take that entry until the block passes.
+func (c *Claude) SwitchAccount(runDir string, turnEnd shuttleengine.Event) (bool, error) {
+	claude, err := loadConfigOrRefuse(c.dirs)
+	if err != nil {
+		return false, err
+	}
+	launched, recorded, err := readLaunchedAccount(runDir)
+	if err != nil {
+		return false, fmt.Errorf("claudeengine: read the account the run in %s launched under: %w", runDir, err)
+	}
+	worktree := c.worktree
+	if !recorded || launched.Account == "" || worktree.AccountDir == "" {
+		return false, nil
+	}
+
+	until := c.TurnEndActivity(turnEnd).UsageLimit.ResetsAt
+	if until.IsZero() {
+		until = c.now().Add(usageLimitFallback)
+	}
+	if err := recordBlocked(worktree.AccountDir, launched.Account, until); err != nil {
+		return false, fmt.Errorf("claudeengine: record the usage limit of account %q: %w", launched.Account, err)
+	}
+	if worktree.Name == "" || positiveWeightAccounts(claude) < 2 {
+		return false, nil
+	}
+
+	switched := false
+	err = updateAccountFile(worktree.AccountDir, func(file accountFile) (accountFile, error) {
+		if claude.AccountPins.Hub != "" {
+			return file, nil
+		}
+		usage, err := readUsage(worktree.AccountDir, claude.Accounts)
+		if err != nil {
+			return accountFile{}, err
+		}
+		now := c.now()
+		if resolved, ok := resolveAccount(claude, worktree, file, usage, now); ok && resolved.Name != launched.Account && hasHeadroom(resolved, usage[resolved.Name], now) {
+			switched = true
+			return file, nil
+		}
+		picked, account, ok := pickAccount(file, pickRequest{
+			accounts: claude.Accounts,
+			usage:    usage,
+			loggedIn: func(account AccountConfig) bool { return loggedIn(runtime.GOOS, account) },
+			exclude:  launched.Account,
+			now:      now,
+		})
+		if !ok {
+			return file, nil
+		}
+		if picked.Worktrees == nil {
+			picked.Worktrees = map[string]string{}
+		}
+		if picked.Picked == nil {
+			picked.Picked = map[string]time.Time{}
+		}
+		picked.Worktrees[worktree.Name] = account
+		picked.Picked[worktree.Name] = now
+		switched = true
+		return picked, nil
+	})
+	if err != nil {
+		return false, fmt.Errorf("claudeengine: switch the account of worktree %q: %w", worktree.Name, err)
+	}
+	return switched, nil
+}
+
+// positiveWeightAccounts returns how many accounts of claude take worktrees.
+func positiveWeightAccounts(claude Config) int {
+	positive := 0
+	for _, account := range claude.Accounts {
+		if account.Weight > 0 {
+			positive++
+		}
+	}
+	return positive
+}
diff --git a/internal/shuttleengine/claudeengine/accountswitch_test.go b/internal/shuttleengine/claudeengine/accountswitch_test.go
new file mode 100644
index 00000000..5268b14a
--- /dev/null
+++ b/internal/shuttleengine/claudeengine/accountswitch_test.go
@@ -0,0 +1,320 @@
+// accountswitch_test.go tests how a usage limit is recorded against the launched account and moves the worktree's entry.
+
+package claudeengine
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+const (
+	// switchTwoAccounts lists the accounts a and b under ROOT.
+	switchTwoAccounts = "accounts:\n  - {name: a, config_dir: ROOT/a, weight: 1}\n  - {name: b, config_dir: ROOT/b, weight: 1}\n"
+	// switchLimitWithReset is the message of a usage limit that states its reset, written at switchLimitWrittenAt.
+	switchLimitWithReset = "You've hit your weekly limit · resets 2pm (Europe/Oslo)"
+	// switchLimitWithoutReset is the message of a usage limit that states no reset.
+	switchLimitWithoutReset = "You've hit your limit"
+	// switchLimitWrittenAt is the time the switch tests' limit entry was written.
+	switchLimitWrittenAt = "2026-10-28T11:03:42.000Z"
+)
+
+// switchRow is one case of TestClaude_SwitchAccount.
+type switchRow struct {
+	name string
+	// machine is the machine-layer claude.yaml; ROOT stands for the temp directory of the fake config directories.
+	machine  string
+	worktree shuttleengine.Worktree
+	// launched names the account the run launched under; empty makes it a launch on a directory no account lists.
+	launched string
+	file     accountFile
+	// blocked maps an account to the time a stored limit blocks it until.
+	blocked map[string]time.Time
+	// message is the usage-limit text of the turn end.
+	message string
+	// calls is how many sessions of the worktree hit the limit; zero means one.
+	calls int
+	// wantRelaunch is the result each call must give.
+	wantRelaunch bool
+	// check judges the state after the calls; nil judges nothing more.
+	check func(t *testing.T, after switchState)
+}
+
+// switchState is what a switch left behind.
+type switchState struct {
+	engine   *Claude
+	worktree shuttleengine.Worktree
+	file     accountFile
+	usage    map[string]usageRecord
+	now      time.Time
+}
+
+// switchRig is a hub with two logged-in accounts and a run launched under one of them.
+type switchRig struct {
+	root, accountDir, runDir string
+	engine                   *Claude
+	turnEnd                  shuttleengine.Event
+	now                      time.Time
+	worktree                 shuttleengine.Worktree
+}
+
+// newSwitchRig builds the rig row describes.
+// It seeds the hub's claude.yaml, the account file and usage, and the run's account.json.
+// It writes a transcript whose newest turn end is a usage limit with row's message.
+func newSwitchRig(t *testing.T, row switchRow) *switchRig {
+	t.Helper()
+	root, accountDir, runDir := t.TempDir(), t.TempDir(), t.TempDir()
+	for _, name := range []string{"a", "b"} {
+		writeClaudeLayer(t, filepath.Join(root, name, credentialsFileName), "{}")
+	}
+	worktree := row.worktree
+	worktree.AccountDir = accountDir
+	engine, _ := engineWithAccounts(t, strings.ReplaceAll(row.machine, "ROOT", root), worktree)
+	now := time.Date(2026, 10, 28, 10, 0, 0, 0, time.UTC)
+	engine.now = func() time.Time { return now }
+
+	if err := updateAccountFile(accountDir, func(accountFile) (accountFile, error) { return row.file, nil }); err != nil {
+		t.Fatalf("seed the account file: %v", err)
+	}
+	for account, until := range row.blocked {
+		if err := recordBlocked(accountDir, account, until); err != nil {
+			t.Fatalf("seed the block of account %s: %v", account, err)
+		}
+	}
+	launched := launchedAccount{ConfigDir: filepath.Join(root, "other")}
+	if row.launched != "" {
+		launched = launchedAccount{ConfigDir: filepath.Join(root, row.launched), Account: row.launched}
+	}
+	if err := writeLaunchedAccount(runDir, launched); err != nil {
+		t.Fatalf("write the run's account record: %v", err)
+	}
+
+	message := row.message
+	if message == "" {
+		message = switchLimitWithReset
+	}
+	entry := fmt.Sprintf(`{"type":"assistant","timestamp":%q,"isApiErrorMessage":true,"error":"rate_limit","message":{"stop_reason":"stop_sequence","content":[{"type":"text","text":%q}]}}`, switchLimitWrittenAt, message)
+	transcript := filepath.Join(root, "transcript.jsonl")
+	writeClaudeLayer(t, transcript, entry+"\n")
+	raw, err := json.Marshal(map[string]string{"transcript_path": transcript})
+	if err != nil {
+		t.Fatalf("encode the turn end: %v", err)
+	}
+	return &switchRig{root: root, accountDir: accountDir, runDir: runDir, engine: engine, turnEnd: shuttleengine.Event{Kind: shuttleengine.EventStop, Raw: raw}, now: now, worktree: worktree}
+}
+
+// state reads the account file and the usage records the switches left.
+func (rig *switchRig) state(t *testing.T) switchState {
+	t.Helper()
+	file, err := readAccountFile(rig.accountDir)
+	if err != nil {
+		t.Fatalf("read the account file: %v", err)
+	}
+	claude, err := LoadConfig(rig.engine.dirs)
+	if err != nil {
+		t.Fatalf("load claude.yaml: %v", err)
+	}
+	usage, err := readUsage(rig.accountDir, claude.Accounts)
+	if err != nil {
+		t.Fatalf("read the usage records: %v", err)
+	}
+	return switchState{engine: rig.engine, worktree: rig.worktree, file: file, usage: usage, now: rig.now}
+}
+
+// TestClaude_SwitchAccount pins what a usage limit records and when it moves the worktree's entry.
+func TestClaude_SwitchAccount(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	statedReset := time.Date(2026, 10, 28, 13, 0, 0, 0, time.UTC)
+	task := shuttleengine.Worktree{Name: "t", Kind: shuttleengine.WorktreeTask}
+	beam := shuttleengine.Worktree{Name: "t", Kind: shuttleengine.WorktreeBeam}
+	entryOn := func(account string) accountFile {
+		return accountFile{Worktrees: map[string]string{"t": account}, Picked: map[string]time.Time{"t": time.Unix(1_000, 0)}}
+	}
+	// blockedUntil fails unless account's stored block ends at want.
+	blockedUntil := func(t *testing.T, after switchState, account string, want time.Time) {
+		t.Helper()
+		if got := after.usage[account].BlockedUntil; !got.Equal(want) {
+			t.Errorf("account %s blocked until %v; want %v", account, got, want)
+		}
+	}
+	// entryIs fails unless the worktree's entry names account.
+	entryIs := func(t *testing.T, after switchState, account string) {
+		t.Helper()
+		if got := after.file.Worktrees["t"]; got != account {
+			t.Errorf("worktree t's entry = %q; want %q", got, account)
+		}
+	}
+
+	tests := []switchRow{
+		{
+			name: "AHitWithAStatedResetBlocksTheLaunchedAccountAndMovesTheEntry", machine: switchTwoAccounts, worktree: task, launched: "a", file: entryOn("a"), wantRelaunch: true,
+			check: func(t *testing.T, after switchState) {
+				blockedUntil(t, after, "a", statedReset)
+				entryIs(t, after, "b")
+				if after.file.Counts["b"] != 1 || !after.file.Picked["t"].Equal(after.now) {
+					t.Errorf("counts = %v, picked = %v; want b's count 1 and t picked at %v", after.file.Counts, after.file.Picked, after.now)
+				}
+				claude, err := LoadConfig(after.engine.dirs)
+				if err != nil {
+					t.Fatalf("load claude.yaml: %v", err)
+				}
+				if account, _ := resolveAccount(claude, after.worktree, after.file, after.usage, after.now); account.Name != "b" {
+					t.Errorf("the worktree resolves to %q; want b", account.Name)
+				}
+				if hasHeadroom(claude.Accounts[0], after.usage["a"], after.now) {
+					t.Error("account a has headroom before its reset; want none")
+				}
+				if !hasHeadroom(claude.Accounts[0], after.usage["a"], statedReset) {
+					t.Error("account a has no headroom at its reset; want some")
+				}
+			},
+		},
+		{
+			name: "AHitWithNoStatedResetBlocksForThirtyMinutes", machine: switchTwoAccounts, worktree: task, launched: "a", file: entryOn("a"), message: switchLimitWithoutReset, wantRelaunch: true,
+			check: func(t *testing.T, after switchState) { blockedUntil(t, after, "a", after.now.Add(usageLimitFallback)) },
+		},
+		{
+			name: "AnEarlierHitNeverLowersAStoredLaterBlock", machine: switchTwoAccounts, worktree: task, launched: "a", file: entryOn("a"), wantRelaunch: true,
+			blocked: map[string]time.Time{"a": statedReset.Add(5 * time.Hour)},
+			check:   func(t *testing.T, after switchState) { blockedUntil(t, after, "a", statedReset.Add(5*time.Hour)) },
+		},
+		{
+			name: "NoOtherEligibleAccountLeavesTheEntryAndReportsFalse", machine: switchTwoAccounts, worktree: task, launched: "a", file: entryOn("a"),
+			blocked: map[string]time.Time{"b": statedReset},
+			check: func(t *testing.T, after switchState) {
+				blockedUntil(t, after, "a", statedReset)
+				entryIs(t, after, "a")
+				if len(after.file.Counts) != 0 {
+					t.Errorf("counts = %v; want none raised", after.file.Counts)
+				}
+			},
+		},
+		{
+			name: "AHubPinRecordsTheLimitAndChangesNothingElse", machine: switchTwoAccounts + "account_pins:\n  hub: a\n", worktree: task, launched: "a", file: entryOn("a"),
+			check: func(t *testing.T, after switchState) {
+				blockedUntil(t, after, "a", statedReset)
+				entryIs(t, after, "a")
+			},
+		},
+		{
+			name: "ABeamsPinnedWorktreeGetsAnEntryAndReturnsToThePinOnceItsBlockPasses", machine: switchTwoAccounts + "account_pins:\n  beams: a\n", worktree: beam, launched: "a", wantRelaunch: true,
+			check: func(t *testing.T, after switchState) {
+				entryIs(t, after, "b")
+				claude, err := LoadConfig(after.engine.dirs)
+				if err != nil {
+					t.Fatalf("load claude.yaml: %v", err)
+				}
+				for _, tt := range []struct {
+					at   time.Time
+					want string
+				}{{after.now, "b"}, {statedReset.Add(time.Minute), "a"}} {
+					if got, _ := resolveAccount(claude, after.worktree, after.file, after.usage, tt.at); got.Name != tt.want {
+						t.Errorf("at %v the worktree resolves to %q; want %q", tt.at, got.Name, tt.want)
+					}
+				}
+			},
+		},
+		{
+			name: "AWorktreeWithNoEntryOnAListedDirectorySwitchesToTheOtherAccount", machine: switchTwoAccounts, worktree: task, launched: "a", wantRelaunch: true,
+			check: func(t *testing.T, after switchState) { entryIs(t, after, "b") },
+		},
+		{
+			name: "TwoSessionsOfOneWorktreeMakeOneSwitch", machine: switchTwoAccounts, worktree: task, launched: "a", file: entryOn("a"), calls: 2, wantRelaunch: true,
+			check: func(t *testing.T, after switchState) {
+				entryIs(t, after, "b")
+				if !reflect.DeepEqual(after.file.Counts, map[string]float64{"a": 0, "b": 1}) {
+					t.Errorf("counts = %v; want b raised once", after.file.Counts)
+				}
+			},
+		},
+		{
+			name: "AnUnlistedLaunchedDirectoryRecordsNothing", machine: switchTwoAccounts, worktree: task, file: entryOn("a"),
+			check: func(t *testing.T, after switchState) {
+				for account, record := range after.usage {
+					if !record.BlockedUntil.IsZero() {
+						t.Errorf("account %s blocked until %v; want no block", account, record.BlockedUntil)
+					}
+				}
+				entryIs(t, after, "a")
+			},
+		},
+		{
+			name: "OneAccountOfPositiveWeightRecordsTheLimitAndReportsFalse", machine: "accounts:\n  - {name: a, config_dir: ROOT/a, weight: 1}\n  - {name: b, config_dir: ROOT/b, weight: 0}\n", worktree: task, launched: "a", file: entryOn("a"),
+			check: func(t *testing.T, after switchState) {
+				blockedUntil(t, after, "a", statedReset)
+				entryIs(t, after, "a")
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			rig := newSwitchRig(t, tt)
+			for call := 0; call < max(tt.calls, 1); call++ {
+				got, err := rig.engine.SwitchAccount(rig.runDir, rig.turnEnd)
+				if err != nil {
+					t.Fatalf("SwitchAccount() call %d error: %v", call+1, err)
+				}
+				if got != tt.wantRelaunch {
+					t.Errorf("SwitchAccount() call %d = %v; want %v", call+1, got, tt.wantRelaunch)
+				}
+			}
+			if tt.check != nil {
+				tt.check(t, rig.state(t))
+			}
+		})
+	}
+
+	t.Run("AfterASwitchAResumeLaunchesUnderTheNewAccountOnceItsTranscriptIsCarried", func(t *testing.T) {
+		t.Parallel()
+
+		rig := newSwitchRig(t, switchRow{machine: switchTwoAccounts, worktree: task, launched: "a", file: entryOn("a")})
+		if switched, err := rig.engine.SwitchAccount(rig.runDir, rig.turnEnd); err != nil || !switched {
+			t.Fatalf("SwitchAccount() = %v, %v; want true", switched, err)
+		}
+		workdir := filepath.Join(rig.root, "work")
+		writeClaudeLayer(t, filepath.Join(projectDirUnder(filepath.Join(rig.root, "a", projectsDirName), workdir), resumeTestID+".jsonl"), "{}\n")
+
+		resumeDir := t.TempDir()
+		launch, err := rig.engine.Prepare(resumeDir, shuttleengine.Spec{Prompt: "carry on", PromptEngine: engineName, ResumeSessionID: resumeTestID}, shuttleengine.Config{})
+		if err != nil {
+			t.Fatalf("Prepare() error: %v", err)
+		}
+		wantDir := filepath.Join(rig.root, "b")
+		if want := configDirAssignment(wantDir); !strings.Contains(launch.ResumeCmd, want) {
+			t.Errorf("Launch.ResumeCmd = %q; want it to hold %q", launch.ResumeCmd, want)
+		}
+		if got, found, err := readLaunchedAccount(resumeDir); err != nil || !found || got != (launchedAccount{ConfigDir: wantDir, Account: "b"}) {
+			t.Errorf("account.json = %+v, found %v, err %v; want account b", got, found, err)
+		}
+		settings, err := os.ReadFile(filepath.Join(resumeDir, settingsFileName))
+		if err != nil {
+			t.Fatalf("read settings.json: %v", err)
+		}
+		if !strings.Contains(string(settings), "claude statusline 'b'") {
+			t.Errorf("settings.json = %q; want the status line of account b", settings)
+		}
+
+		if _, err := rig.engine.CheckResume(resumeTestID, workdir); !errors.Is(err, shuttleengine.ErrNoTranscript) {
+			t.Fatalf("CheckResume() before the carry = %v; want ErrNoTranscript", err)
+		}
+		if copied, err := rig.engine.CarryTranscript(resumeTestID, workdir); err != nil || !copied {
+			t.Fatalf("CarryTranscript() = %v, %v; want true", copied, err)
+		}
+		if _, err := rig.engine.CheckResume(resumeTestID, workdir); err != nil {
+			t.Errorf("CheckResume() after the carry error = %v; want nil", err)
+		}
+	})
+}
diff --git a/internal/shuttleengine/claudeengine/accountverbs.go b/internal/shuttleengine/claudeengine/accountverbs.go
new file mode 100644
index 00000000..42955dac
--- /dev/null
+++ b/internal/shuttleengine/claudeengine/accountverbs.go
@@ -0,0 +1,229 @@
+// accountverbs.go implements the operator verbs of shuttleengine.AccountKeeper for the Claude engine:
+// setting the told worktree's account, showing the accounts, and recording a status line's usage reading.
+
+package claudeengine
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+)
+
+// statusLineWindowLengths is the length of each usage window a status line reports.
+// A reset further ahead than its window's length cannot be genuine.
+var statusLineWindowLengths = map[string]time.Duration{
+	"five_hour": 5 * time.Hour,
+	"seven_day": 7 * 24 * time.Hour,
+}
+
+// readAccountState reads the account file and the usage records of claude's accounts.
+// It reads them from the told worktree's account directory.
+// An engine told no account directory reads the zero file and no usage.
+func (c *Claude) readAccountState(claude Config) (accountFile, map[string]usageRecord, error) {
+	dir := c.worktree.AccountDir
+	if dir == "" {
+		return accountFile{}, map[string]usageRecord{}, nil
+	}
+	file, err := readAccountFile(dir)
+	if err != nil {
+		return accountFile{}, nil, fmt.Errorf("claudeengine: read the Claude account file: %w", err)
+	}
+	usage, err := readUsage(dir, claude.Accounts)
+	if err != nil {
+		return accountFile{}, nil, fmt.Errorf("claudeengine: %w", err)
+	}
+	return file, usage, nil
+}
+
+// activeAccountNames returns the names of the accounts of claude that take worktrees, in list order.
+func activeAccountNames(claude Config) []string {
+	var names []string
+	for _, account := range claude.Accounts {
+		if !account.retired() {
+			names = append(names, account.Name)
+		}
+	}
+	return names
+}
+
+// listedAccountsText names the accounts a refusal offers in place of the one asked for.
+func listedAccountsText(claude Config) string {
+	names := activeAccountNames(claude)
+	if len(names) == 0 {
+		return "no account is listed"
+	}
+	return "the listed accounts are " + strings.Join(names, ", ")
+}
+
+// SetAccount implements shuttleengine.AccountKeeper.
+// It writes the told worktree's entry in the account file under one hold of its lock.
+// The entry takes effect at the worktree's next launch the engine builds, and a running strand keeps its account.
+// It refuses an account the list lacks or has retired, naming the listed ones.
+// It refuses under a hub pin, naming the pin.
+// Under a beams pin it writes the entry, which takes effect while the pin does not apply.
+// An engine told no worktree refuses.
+func (c *Claude) SetAccount(name string) error {
+	claude, err := loadConfigOrRefuse(c.dirs)
+	if err != nil {
+		return err
+	}
+	worktree := c.worktree
+	if worktree.Name == "" || worktree.AccountDir == "" {
+		return errors.New("claudeengine: no worktree is told, so no account is set for it; way forward: run the verb from a worktree of a hub")
+	}
+	index := slices.IndexFunc(claude.Accounts, func(account AccountConfig) bool { return account.Name == name })
+	switch {
+	case index < 0:
+		return fmt.Errorf("claudeengine: claude.yaml %s lists no account %q; %s; way forward: pick one of them, or add the account with `lym config claude --layer machine`", accountsKey, name, listedAccountsText(claude))
+	case claude.Accounts[index].retired():
+		return fmt.Errorf("claudeengine: account %q is retired with weight 0; %s; way forward: pick one of them", name, listedAccountsText(claude))
+	case claude.AccountPins.Hub != "":
+		return fmt.Errorf("claudeengine: %s names %q and holds every worktree of the hub to it; way forward: change the pin with `lym config claude --layer machine`", accountPinsKey+".hub", claude.AccountPins.Hub)
+	}
+	written := c.now()
+	return updateAccountFile(worktree.AccountDir, func(file accountFile) (accountFile, error) {
+		if file.Worktrees == nil {
+			file.Worktrees = map[string]string{}
+		}
+		if file.Picked == nil {
+			file.Picked = map[string]time.Time{}
+		}
+		file.Worktrees[worktree.Name] = name
+		file.Picked[worktree.Name] = written
+		return file, nil
+	})
+}
+
+// ShowAccounts implements shuttleengine.AccountKeeper.
+// It returns one line per fact, joined by newlines.
+// The facts are the told worktree's resolved account and the two pins.
+// For each listed account they are its weight, whether it has headroom and when a limit blocks it until.
+// Under each account come its stored windows, each with the used percentage, the account's threshold and the reset time.
+func (c *Claude) ShowAccounts() (string, error) {
+	claude, err := loadConfigOrRefuse(c.dirs)
+	if err != nil {
+		return "", err
+	}
+	file, usage, err := c.readAccountState(claude)
+	if err != nil {
+		return "", err
+	}
+	now := c.now()
+
+	resolved := "none"
+	if account, ok := resolveAccount(claude, c.worktree, file, usage, now); ok {
+		resolved = account.Name
+	}
+	worktree := "no worktree is told"
+	if c.worktree.Name != "" {
+		worktree = fmt.Sprintf("worktree %s (%s)", c.worktree.Name, c.worktree.Kind)
+	}
+	pin := func(name string) string {
+		if name == "" {
+			return "none"
+		}
+		return name
+	}
+	lines := []string{
+		fmt.Sprintf("%s: resolved account %s", worktree, resolved),
+		"hub pin: " + pin(claude.AccountPins.Hub),
+		"beams pin: " + pin(claude.AccountPins.Beams),
+	}
+	for _, account := range claude.Accounts {
+		record := usage[account.Name]
+		headroom := "headroom"
+		if !hasHeadroom(account, record, now) {
+			headroom = "no headroom"
+		}
+		blocked := "none"
+		if !record.BlockedUntil.IsZero() {
+			blocked = record.BlockedUntil.UTC().Format(time.RFC3339)
+		}
+		lines = append(lines, fmt.Sprintf("%s: weight %d, %s, blocked until %s", account.Name, account.Weight, headroom, blocked))
+		for _, window := range accountWindows {
+			reading, stored := record.Windows[window]
+			if !stored {
+				continue
+			}
+			threshold := "no threshold"
+			if listed, ok := account.Windows[window]; ok {
+				threshold = fmt.Sprintf("threshold %d%%", listed)
+			}
+			lines = append(lines, fmt.Sprintf("  %s: %g%% used, %s, resets %s", window, reading.UsedPercentage, threshold, time.Unix(reading.ResetsAt, 0).UTC().Format(time.RFC3339)))
+		}
+	}
+	return strings.Join(lines, "\n"), nil
+}
+
+// RecordStatusLine implements shuttleengine.AccountKeeper.
+// It merges the usage windows of the status line payload input into the usage record of the listed account name.
+// The record's blocked-until time is kept.
+// It returns one short line naming the account and each window's percentage.
+// It refuses a name no listed account has, and writes nothing.
+// A payload with no readable window writes nothing and returns the name alone.
+func (c *Claude) RecordStatusLine(name string, input []byte) (string, error) {
+	claude, err := loadConfigOrRefuse(c.dirs)
+	if err != nil {
+		return "", err
+	}
+	if !slices.ContainsFunc(claude.Accounts, func(account AccountConfig) bool { return account.Name == name }) {
+		var listed []string
+		for _, account := range claude.Accounts {
+			listed = append(listed, account.Name)
+		}
+		return "", fmt.Errorf("claudeengine: claude.yaml %s lists no account %q, so nothing is recorded; the listed names are %s; way forward: run the status line with a listed account's name", accountsKey, name, strings.Join(listed, ", "))
+	}
+	dir := c.worktree.AccountDir
+	if dir == "" {
+		return "", errors.New("claudeengine: no worktree is told, so no usage is recorded; way forward: run the verb from a worktree of a hub")
+	}
+	record, ok := parseStatusLine(input, c.now())
+	if ok {
+		if err := writeUsage(dir, name, record); err != nil {
+			return "", fmt.Errorf("claudeengine: record the usage of account %q: %w", name, err)
+		}
+	}
+	line := name
+	for _, window := range accountWindows {
+		if reading, kept := record.Windows[window]; kept {
+			line += fmt.Sprintf(" %s %g%%", window, reading.UsedPercentage)
+		}
+	}
+	return line, nil
+}
+
+// parseStatusLine reads the usage windows of a status line payload.
+// It takes `rate_limits.five_hour` and `rate_limits.seven_day`, each with its `used_percentage` and `resets_at`.
+// It drops a window that lacks either value.
+// It drops a window whose percentage lies outside 0 to 100.
+// It drops a window whose reset lies further ahead of now than the window's length.
+// It reports false when no window is left, and for a payload that does not decode.
+func parseStatusLine(input []byte, now time.Time) (usageRecord, bool) {
+	var payload struct {
+		RateLimits map[string]struct {
+			UsedPercentage *float64 `json:"used_percentage"`
+			ResetsAt       *int64   `json:"resets_at"`
+		} `json:"rate_limits"`
+	}
+	if err := json.Unmarshal(input, &payload); err != nil {
+		return usageRecord{}, false
+	}
+	record := usageRecord{Windows: map[string]usageWindow{}}
+	for window, length := range statusLineWindowLengths {
+		reading, ok := payload.RateLimits[window]
+		if !ok || reading.UsedPercentage == nil || reading.ResetsAt == nil {
+			continue
+		}
+		if *reading.UsedPercentage < 0 || *reading.UsedPercentage > 100 {
+			continue
+		}
+		if time.Unix(*reading.ResetsAt, 0).After(now.Add(length)) {
+			continue
+		}
+		record.Windows[window] = usageWindow{UsedPercentage: *reading.UsedPercentage, ResetsAt: *reading.ResetsAt}
+	}
+	return record, len(record.Windows) > 0
+}
