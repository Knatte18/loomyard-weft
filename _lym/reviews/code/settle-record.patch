 // The maps live under Dir, one directory per package, shared by every worktree of the hub on the machine.
 // Beside them, the exit record holds the process ID of the last refresh.
 // It also holds the count of stale packages the refresh's cap left unbuilt.
+// A package owns every file under its directory except those below a nested package or module.
+// NestedPackageDirs finds those nested directories.
+//
+// A Selector selects an importing package's tests from its map against the working tree.
+// It compares each linked package's files with the map's record.
+// For a changed Go file it compares the top-level declarations at the map's commit with the working tree's,
+// ignoring comments and formatting.
+// A function whose declaration differs, or that only the commit holds, is changed.
+// The tests that covered a changed function are selected, and with them every test the spawn scan marks.
+// A change the map cannot speak for is a Miss, under which the caller runs the package whole.
+// Such changes include:
+//   - the map missing, unreadable, failed or unmarked, or its commit unreadable;
+//   - the package's own Go files;
+//   - a non-Go file, unless inert_paths matches it and no go:embed pattern names it,
+//     the package's own test files counting as embed sources;
+//   - a declaration outside functions, bar a few additions no unchanged code can reach;
+//   - an import, bar an added one of a linked or standard-library package,
+//     and bar a standard-library one that a deleted file imported;
+//   - a `//go:` line, the method set, an added init function or a declared predeclared name;
+//   - a file that does not parse.
 package testcover
diff --git a/internal/testcover/packagedirs.go b/internal/testcover/packagedirs.go
new file mode 100644
index 00000000..6a8a6506
--- /dev/null
+++ b/internal/testcover/packagedirs.go
@@ -0,0 +1,44 @@
+// packagedirs.go tells which directories below a package directory hold another package or a nested module.
+// The files under them belong to that package and not the one above.
+
+package testcover
+
+import (
+	"maps"
+	"path"
+	"slices"
+	"strings"
+)
+
+// NestedPackageDirs returns the directories below a package directory that hold another package or a nested module.
+// They are sorted.
+// files are the slash paths, relative to the package directory, of every file under it.
+// A directory holds a package when it holds a Go file directly and the go command would build it:
+// it lies under no testdata directory and no directory whose name opens with a dot or an underscore.
+// A directory holding go.mod is a nested module wherever it lies.
+// A directory whose Go files build constraints all exclude still counts as nested:
+// the bound only misses files of the owner, and never adds a false one.
+func NestedPackageDirs(files []string) []string {
+	nested := map[string]struct{}{}
+	for _, rel := range files {
+		dir, name := path.Dir(rel), path.Base(rel)
+		if dir == "." {
+			continue
+		}
+		if name == "go.mod" || (strings.HasSuffix(name, ".go") && buildableDir(dir)) {
+			nested[dir] = struct{}{}
+		}
+	}
+	return slices.Sorted(maps.Keys(nested))
+}
+
+// buildableDir reports whether the go command builds a package in the slash directory dir:
+// no element of it is testdata or opens with a dot or an underscore.
+func buildableDir(dir string) bool {
+	for _, element := range strings.Split(dir, "/") {
+		if element == "testdata" || strings.HasPrefix(element, ".") || strings.HasPrefix(element, "_") {
+			return false
+		}
+	}
+	return true
+}
