+func TestChangedTests(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	module := testreach.Module{Dir: "/w/mod", Rel: "mod", Path: "ex.com/m"}
+	tests := []struct {
+		name    string
+		base    testreach.FileSet
+		head    testreach.FileSet
