+		"internal/s/s.go":      "package s\n\ntype Deps struct{}\n",
+		"internal/c/c_test.go": "package c\n\nimport \"testing\"\n\n//lym:seam internal/s#Deps\nfunc TestDeps(t *testing.T) {}\n",
+	})
