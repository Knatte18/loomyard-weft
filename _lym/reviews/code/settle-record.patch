+		if !strings.Contains(c.Tiers[tierKey(number)].Command, "{args}") {
+			return "", useRefusal("gates.%s lists %s, whose command holds no {args}, so the words after \"--\" that select a test class reach no command", key, tierKey(number))
+		}
+	}
