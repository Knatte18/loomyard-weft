@@ -0,0 +1,80 @@
+// journal_test.go covers the run journal's idempotent append and the per-strand file names.
+
+package weaverengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+)
+
+func TestAppendJournal(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	read := func(t *testing.T, path string) string {
+		t.Helper()
+		data, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(data)
+	}
+	first := weaverengine.JournalHeading("01-one", 1)
+	second := weaverengine.JournalHeading("01-one", 2)
+
+	t.Run("two entries append in order", func(t *testing.T) {
+		t.Parallel()
+		path := filepath.Join(t.TempDir(), "run", "journal.md")
+		if err := weaverengine.AppendJournal(path, first, "first text\n"); err != nil {
+			t.Fatal(err)
+		}
+		if err := weaverengine.AppendJournal(path, second, "second text"); err != nil {
+			t.Fatal(err)
+		}
+		want := "## Batch 01-one, attempt 1\n\nfirst text\n\n## Batch 01-one, attempt 2\n\nsecond text\n"
+		if got := read(t, path); got != want {
+			t.Errorf("journal = %q; want %q", got, want)
+		}
+	})
+
+	t.Run("a repeated heading adds nothing", func(t *testing.T) {
+		t.Parallel()
+		path := filepath.Join(t.TempDir(), "journal.md")
+		if err := weaverengine.AppendJournal(path, first, "text"); err != nil {
+			t.Fatal(err)
+		}
+		before := read(t, path)
+		if err := weaverengine.AppendJournal(path, first, "other text"); err != nil {
+			t.Fatal(err)
+		}
+		if got := read(t, path); got != before {
+			t.Errorf("journal after a repeated heading = %q; want it unchanged %q", got, before)
+		}
+	})
+
+	t.Run("an empty text appends the heading alone", func(t *testing.T) {
+		t.Parallel()
+		path := filepath.Join(t.TempDir(), "journal.md")
+		if err := weaverengine.AppendJournal(path, first, ""); err != nil {
+			t.Fatal(err)
+		}
+		if got, want := read(t, path), "## Batch 01-one, attempt 1\n"; got != want {
+			t.Errorf("journal = %q; want %q", got, want)
+		}
+	})
+
+	t.Run("the strand files are named by batch, attempt and fixer", func(t *testing.T) {
+		t.Parallel()
+		reports := filepath.Join("reports")
+		if got, want := weaverengine.AttemptReportPath(reports, 3, "slug", 2), filepath.Join(reports, "03-slug-a2.yaml"); got != want {
+			t.Errorf("AttemptReportPath() = %q; want %q", got, want)
+		}
+		if got, want := weaverengine.FixerReplyPath(reports, 4), filepath.Join(reports, "fix-4.md"); got != want {
+			t.Errorf("FixerReplyPath() = %q; want %q", got, want)
+		}
+	})
+}
diff --git a/internal/weaverengine/record.go b/internal/weaverengine/record.go
new file mode 100644
index 00000000..a930f069
--- /dev/null
+++ b/internal/weaverengine/record.go
@@ -0,0 +1,400 @@
+// record.go ends every batch attempt the same way.
+// It records the attempt's outcome, journals its report, saves the run state and commits Weaver's records.
+// A recordable attempt first passes the shared post-batch checks, and a pass takes its batch terminal done.
+
+package weaverengine
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/websterengine"
+)
+
+// The outcomes an attempt record takes once it ends.
+const (
+	outcomeDone        = "done"
+	outcomeFailed      = "failed"
+	outcomeLost        = "lost"
+	outcomeNeedsParent = "needs_parent"
+	// outcomeFault marks an attempt whose end Weaver could not judge, since a check or a write of its own failed.
+	outcomeFault = "fault"
+)
+
+// defaultReentryStep is the step that re-enters the run when the told one is empty.
+const defaultReentryStep = "re-step the row"
+
+// minAbbreviatedSHA is the shortest hex head_sha that resolves as an abbreviation.
+const minAbbreviatedSHA = 4
+
+// fullSHALength is the length of a full commit id in hex digits.
+const fullSHALength = 40
+
+// recordInputs is everything endAttempt records one ended attempt from.
+type recordInputs struct {
+	// Geom is the told geometry the worktree, the run directories and the state are read from.
+	Geom Geometry
+	// State is the run state, which endAttempt updates and saves.
+	State *State
+	// Plan is the parsed plan the post-batch checks read.
+	Plan *planparser.Plan
+	// Batch is the batch the attempt builds, and Label names it as NN-<slug>.
+	Batch batcher.Batch
+	Label string
+	// Record is the batch's own record in State.Batches.
+	Record *runplan.BatchState
+	// Attempt is the ended attempt's record in State.Attempts.
+	Attempt *AttemptState
+	// Verdict is how the attempt ended, and carries its parsed report when one parsed.
+	Verdict attemptVerdict
+	// ParentBranch names the branch a clean parent merge-in comes from; nil accepts no merge.
+	ParentBranch websterengine.ParentBranchFunc
+	// CommitRecords commits Weaver's run directory and the plan directory.
+	CommitRecords func(msg string) error
+	// ReentryStep is the step that re-enters the run, and an empty one means defaultReentryStep.
+	ReentryStep string
+}
+
+// recordOutcome is what endAttempt recorded about one attempt.
+type recordOutcome struct {
+	// Outcome is the attempt's recorded outcome, one of the outcome constants.
+	Outcome string
+	// Cause says why a failed, lost or fault attempt ended so.
+	Cause string
+	// Uncommitted holds the tracked paths a failed attempt left uncommitted.
+	Uncommitted []string
+}
+
+// endAttempt ends one attempt, whatever its verdict.
+// A failed, lost or needs-parent attempt keeps its journal entry and its commit, as a done one does.
+// A recordable verdict first passes the clean-tree check, the head check and the shared post-batch checks.
+// A pass takes the batch's record terminal done and clears the run's stop record.
+// Any other finding fails the attempt.
+// Every verdict then records the attempt's outcome and cause and the batch's end commit.
+// It appends the report's journal when a report parsed, saves the state and commits.
+// The journal append precedes the state save, so a crash between them re-appends nothing.
+// A check that cannot run, a failed save or a failed commit is returned as an error.
+// The outcome is returned beside it as far as it was recorded.
+func endAttempt(in recordInputs) (recordOutcome, error) {
+	var checkErr error
+	var out recordOutcome
+	switch in.Verdict.Kind {
+	case verdictRecordable:
+		out, checkErr = checkRecordable(in)
+	case verdictFailed:
+		out = recordOutcome{Outcome: outcomeFailed, Cause: in.Verdict.Cause}
+	case verdictLost:
+		out = recordOutcome{Outcome: outcomeLost, Cause: in.Verdict.Cause}
+	case verdictNeedsParent:
+		out = recordOutcome{Outcome: outcomeNeedsParent, Cause: in.Verdict.Need}
+	default:
+		return recordOutcome{}, fmt.Errorf("weaver: attempt %d of batch %s ended with unknown verdict %q", in.Attempt.Number, in.Label, in.Verdict.Kind)
+	}
+	if checkErr != nil {
+		out = recordOutcome{Outcome: outcomeFault, Cause: checkErr.Error()}
+	}
+
+	head, err := in.Geom.git().HeadSHA(in.Geom.WorktreeRoot)
+	if err != nil {
+		return out, errors.Join(checkErr, fmt.Errorf("weaver: read HEAD to record the end of batch %s: %w", in.Label, err))
+	}
+	number, _ := runplan.BatchIdentity(in.Batch)
+	in.Attempt.Outcome = out.Outcome
+	in.Attempt.Cause = out.Cause
+	in.Attempt.Uncommitted = out.Uncommitted
+	if out.Outcome == outcomeDone {
+		in.Attempt.InFlight = false
+	}
+	if in.State.BatchEnds == nil {
+		in.State.BatchEnds = map[int]string{}
+	}
+	in.State.BatchEnds[number] = head
+	in.State.LastEnd = head
+
+	if report := in.Verdict.Report; report != nil {
+		if err := AppendJournal(JournalPath(in.Geom.RunDir), JournalHeading(in.Label, in.Attempt.Number), report.Journal); err != nil {
+			return out, errors.Join(checkErr, err)
+		}
+	}
+	if err := saveRunState(in.Geom, in.State, false); err != nil {
+		return out, errors.Join(checkErr, err)
+	}
+	if err := commitRecords(in.CommitRecords, in.Label, in.ReentryStep); err != nil {
+		return out, errors.Join(checkErr, err)
+	}
+	return out, checkErr
+}
+
+// checkRecordable runs the checks a recordable attempt owes before its batch is recorded done.
+// A finding about the attempt's work is returned as a failed outcome, and a check that cannot run as an error.
+func checkRecordable(in recordInputs) (recordOutcome, error) {
+	git := in.Geom.git()
+	report := in.Verdict.Report
+
+	dirty, err := checkCleanTree(git, in.Geom.WorktreeRoot)
+	if err != nil {
+		return recordOutcome{}, err
+	}
+	if len(dirty) > 0 {
+		cause := fmt.Sprintf("the worktree holds uncommitted paths the attempt left: %s; commit or remove them", strings.Join(dirty, ", "))
+		return recordOutcome{Outcome: outcomeFailed, Cause: cause, Uncommitted: dirty}, nil
+	}
+
+	head, problem, err := reconcileReportHead(git, in.Geom.WorktreeRoot, report.HeadSHA, in.ParentBranch)
+	if err != nil {
+		return recordOutcome{}, err
+	}
+	if problem != "" {
+		return recordOutcome{Outcome: outcomeFailed, Cause: problem}, nil
+	}
+
+	batches, err := runplan.MapPartition(in.Plan, in.State.Partition, partitionWayForward(in.ReentryStep))
+	if err != nil {
+		return recordOutcome{}, err
+	}
+	number, _ := runplan.BatchIdentity(in.Batch)
+	deviations, warnings, err := runplan.PostBatchChecks(runplan.PostBatchInputs{
+		Plan:                   in.Plan,
+		State:                  &in.State.State,
+		Batch:                  in.Record,
+		Geom:                   in.Geom.runPlan(),
+		Batches:                batches,
+		Number:                 number,
+		Cards:                  in.Batch.Cards,
+		StartSHA:               in.Record.StartSHA,
+		HeadSHA:                head,
+		Label:                  in.Label,
+		Renames:                report.Renames,
+		HandBackRemovedTargets: true,
+		HandBackWayForward:     "the next attempt of this batch is told this finding: restore the removed symbol or report its rename",
+		RecordWarning: func(id, class, detail string) (string, bool) {
+			return recordBatchWarning(in.Record, id, class, detail)
+		},
+	})
+	for _, warning := range warnings {
+		logger.Warn("weaver: post-batch warning", "batch", in.Label, "warning", warning)
+	}
+	if err != nil {
+		if errors.Is(err, runplan.ErrCardNotDone) || errors.Is(err, runplan.ErrLaterTargetRemoved) {
+			return recordOutcome{Outcome: outcomeFailed, Cause: err.Error()}, nil
+		}
+		return recordOutcome{}, err
+	}
+
+	departures, err := runplan.BatchDepartures(in.Geom.runPlan(), in.Record.StartSHA, head)
+	if err != nil {
+		return recordOutcome{}, err
+	}
+	digest := runplan.Distill(report)
+	digest.Batch = in.Label
+	digest.Deviations = deviations
+	digest.Departures = departures
+	in.Record.Digest = &digest
+	in.Record.CardSHAs = []string{head}
+	in.Record.Terminal = true
+	in.Record.Status = digest.Status
+	in.State.Stop = nil
+	return recordOutcome{Outcome: outcomeDone}, nil
+}
+
+// reconcileReportHead resolves a report's head_sha and cross-checks it against the worktree's HEAD.
+// It returns the full SHA the batch is recorded at, or a problem naming why the head cannot be accepted.
+// HEAD equal to the head is accepted.
+// Otherwise HEAD's first-parent chain is walked down to the head, and each commit on it must be a clean parent merge.
+// A merge is clean when Git.MergeRejection accepts it against the told parent branch.
+// A git failure is returned as an error.
+func reconcileReportHead(git websterengine.Git, worktree, reportHead string, parentBranch websterengine.ParentBranchFunc) (head, problem string, err error) {
+	head = reportHead
+	if len(reportHead) >= minAbbreviatedSHA && len(reportHead) < fullSHALength && isHex(reportHead) {
+		commits, err := git.CommitsNamedBy(worktree, strings.ToLower(reportHead))
+		if err != nil {
+			return "", "", err
+		}
+		if len(commits) != 1 {
+			return "", fmt.Sprintf("the report's head_sha %q names %d commits; it must be the output of `git rev-parse HEAD`", reportHead, len(commits)), nil
+		}
+		head = commits[0]
+	}
+
+	current, err := git.HeadSHA(worktree)
+	if err != nil {
+		return "", "", err
+	}
+	for walked := current; walked != head; {
+		parents, err := git.CommitParents(worktree, walked)
+		if err != nil {
+			return "", "", fmt.Errorf("weaver: walk the first-parent chain from %s: %w", current, err)
+		}
+		if len(parents) < 2 {
+			return "", fmt.Sprintf("the report's head_sha %s is not the worktree's HEAD %s, and only clean parent merges may sit between them", head, current), nil
+		}
+		if reason := git.MergeRejection(worktree, walked, parents, parentBranch); reason != "" {
+			return "", fmt.Sprintf("commit %s above the report's head_sha %s is not a clean merge of the parent branch: %s", walked, head, reason), nil
+		}
+		walked = parents[0]
+	}
+	return head, "", nil
+}
+
+// isHex reports whether s is non-empty and holds only hex digits of either case.
+func isHex(s string) bool {
+	for _, r := range s {
+		if !strings.ContainsRune("0123456789abcdefABCDEF", r) {
+			return false
+		}
+	}
+	return s != ""
+}
+
+// partitionWayForward is the way forward of a recorded partition that no longer matches the plan.
+func partitionWayForward(reentryStep string) string {
+	return "restore the plan the run recorded, or start the run over with `lym weaver reset`, then " + stepOrDefault(reentryStep)
+}
+
+// stepOrDefault returns step, or defaultReentryStep when step is empty.
+func stepOrDefault(step string) string {
+	if step == "" {
+		return defaultReentryStep
+	}
+	return step
+}
+
+// recordBatchWarning records a later card's drift finding once on bs, keyed by id.
+// It returns the warning's text and whether it was newly recorded.
+func recordBatchWarning(bs *runplan.BatchState, id, class, detail string) (string, bool) {
+	if slices.ContainsFunc(bs.AuditWarnings, func(w runplan.AuditWarning) bool { return w.Identity == id }) {
+		return "", false
+	}
+	bs.AuditWarnings = append(bs.AuditWarnings, runplan.AuditWarning{Identity: id, Class: class, Detail: detail})
+	return detail, true
+}
+
+// checkCleanTree returns the worktree's uncommitted paths through Git.DirtyPaths, empty for a clean tree.
+func checkCleanTree(git websterengine.Git, worktree string) ([]string, error) {
+	paths, err := git.DirtyPaths(worktree)
+	if err != nil {
+		return nil, fmt.Errorf("weaver: read the worktree's uncommitted paths: %w", err)
+	}
+	return paths, nil
+}
+
+// saveRunState is Weaver's one save of its state from Run.
+// With leaseHeld unset it first acquires the state-mutation lease over the scratch directory.
+// With it set the caller already holds the lease, and a second acquire in the same process would block forever.
+// Under the lease it loads the state file.
+// It merges each attempt's and fixer's delivered headings as loaded with those st holds.
+// It then writes the result and leaves st holding the merged lists.
+// The decision verb's process records deliveries into the same file, so a save never drops a heading it recorded.
+func saveRunState(geom Geometry, st *State, leaseHeld bool) error {
+	if !leaseHeld {
+		lease, err := runplan.AcquireStateMutation(geom.ScratchDir)
+		if err != nil {
+			return fmt.Errorf("weaver: save the run state: %w", err)
+		}
+		defer func() {
+			if err := lease.Release(); err != nil {
+				logger.Warn("weaver: release the state-mutation lease", "cause", err)
+			}
+		}()
+	}
+	loaded, err := LoadState(geom.RunDir, geom.ScratchDir)
+	if err != nil {
+		return err
+	}
+	if loaded != nil {
+		for _, attempt := range st.Attempts {
+			for _, before := range loaded.Attempts {
+				if before.Batch == attempt.Batch && before.Number == attempt.Number {
+					attempt.Delivered = mergeDelivered(before.Delivered, attempt.Delivered)
+				}
+			}
+		}
+		for _, fixer := range st.Fixers {
+			for _, before := range loaded.Fixers {
+				if before.Number == fixer.Number {
+					fixer.Delivered = mergeDelivered(before.Delivered, fixer.Delivered)
+				}
+			}
+		}
+	}
+	return SaveState(geom.RunDir, geom.ScratchDir, st)
+}
+
+// mergeDelivered returns the headings in loaded followed by those in held that loaded lacks.
+func mergeDelivered(loaded, held []string) []string {
+	merged := slices.Clone(loaded)
+	for _, heading := range held {
+		if !slices.Contains(merged, heading) {
+			merged = append(merged, heading)
+		}
+	}
+	return merged
+}
+
+// RecordDelivery adds headings to the Delivered list of the attempt or fixer whose strand is strandName.
+// It runs under the state-mutation lease, so it never races a batch begin or a save of the run's own process.
+// An empty strand name, a name the state does not record and an absent state file change nothing.
+func RecordDelivery(anchorRoot, strandName string, headings []string) error {
+	if strandName == "" {
+		return nil
+	}
+	runDir, scratchDir := Dir(anchorRoot), ScratchDir(anchorRoot)
+	lease, err := runplan.AcquireStateMutation(scratchDir)
+	if err != nil {
+		return fmt.Errorf("weaver: record a delivery: %w", err)
+	}
+	defer func() {
+		if err := lease.Release(); err != nil {
+			logger.Warn("weaver: release the state-mutation lease", "cause", err)
+		}
+	}()
+
+	st, err := LoadState(runDir, scratchDir)
+	if err != nil || st == nil {
+		return err
+	}
+	changed := false
+	for _, attempt := range st.Attempts {
+		if attempt.StrandName == strandName {
+			changed = addDelivered(&attempt.Delivered, headings) || changed
+		}
+	}
+	for _, fixer := range st.Fixers {
+		if fixer.StrandName == strandName {
+			changed = addDelivered(&fixer.Delivered, headings) || changed
+		}
+	}
+	if !changed {
+		return nil
+	}
+	return SaveState(runDir, scratchDir, st)
+}
+
+// addDelivered appends the headings *delivered lacks and reports whether it added any.
+func addDelivered(delivered *[]string, headings []string) bool {
+	merged := mergeDelivered(*delivered, headings)
+	if len(merged) == len(*delivered) {
+		return false
+	}
+	*delivered = merged
+	return true
+}
+
+// commitRecords commits Weaver's run directory and the plan directory through the told commit seam.
+// The commit message is `weaver: batch <label>`.
+// A failure is returned with its way forward: the fault is transient, so re-step the row.
+func commitRecords(commit func(msg string) error, label, reentryStep string) error {
+	if commit == nil {
+		return errors.New("weaver: no commit seam was told; way forward: the CLI layer must set RunDeps.CommitRecords")
+	}
+	if err := commit("weaver: batch " + label); err != nil {
+		return fmt.Errorf("weaver: commit the run records of batch %s: %w; way forward: the fault is transient, %s", label, err, stepOrDefault(reentryStep))
+	}
+	return nil
+}
diff --git a/internal/weaverengine/reentry_test.go b/internal/weaverengine/reentry_test.go
new file mode 100644
index 00000000..e9ebc068
--- /dev/null
+++ b/internal/weaverengine/reentry_test.go
@@ -0,0 +1,279 @@
+// reentry_test.go pins how a call of Run re-enters a stop:
+// the stopped batch recorded done with no spawn, and the attempt or fixer on the last rung.
+// It also pins the needs-parent step, the verify and a plan that no longer matches the recorded partition.
+
+package weaverengine_test
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/plankit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// stopFirstBatch runs fx until its first batch stops on the last rung, three failed attempts scripted.
+func stopFirstBatch(t *testing.T, fx *runFixture) {
+	t.Helper()
+	failed := attemptScript{report: runplan.Report{Status: runplan.ReportStatusFailed, Journal: "tried"}}
+	fx.runner.scripts = []attemptScript{failed, failed, failed}
+	requireStuck(t, mustRun(t, fx), "batch 01-one")
+}
+
+// rewritePlan writes the fixture's plan again with the given card slugs, numbered from one.
+func rewritePlan(t *testing.T, fx *runFixture, slugs ...string) {
+	t.Helper()
+	cards := make([]plankit.Card, len(slugs))
+	for i, slug := range slugs {
+		cards[i] = plankit.Card{Number: i + 1, Slug: slug, Groups: []plankit.Group{{Label: "Create", Targets: []string{"internal/x/" + slug + ".go"}}}}
+	}
+	plankit.Write(t, fx.deps.Geom.PlanDir, plankit.Plan{Approved: true, Language: "none", Framing: "A test plan.", Cards: cards})
+}
+
+func TestRun_Reentry(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("PassingStoppedBatchIsRecordedDoneWithNoSpawnAlsoAfterAPendingCardIsEdited", func(t *testing.T) {
+		t.Parallel()
+		fx := newRunFixture(t, 1, "one", "two")
+		stopFirstBatch(t, fx)
+		fx.git.commit("the parent repaired the batch")
+		card, err := os.OpenFile(filepath.Join(fx.deps.Geom.PlanDir, "02-two.md"), os.O_APPEND|os.O_WRONLY, 0o644)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := card.WriteString("\nAn edit the arbiter made.\n"); err != nil {
+			t.Fatal(err)
+		}
+		_ = card.Close()
+		fx.runner.scripts = append(fx.runner.scripts, attemptScript{commit: true})
+
+		requireDone(t, mustRun(t, fx), 2)
+
+		if got := len(fx.runner.specs); got != 4 {
+			t.Errorf("strands started = %d; want the stopped batch's three and the next batch's one, none to re-enter", got)
+		}
+		st := fx.loadState()
+		first := st.Batches[1]
+		head, _ := fx.git.HeadSHA("")
+		if !first.Terminal || first.Status != "done" || first.Digest == nil || first.Digest.HeadSHA == "" || st.Stop != nil {
+			t.Errorf("batch 1 = %+v, Stop = %+v; want it recorded done with a digest and no stop", first, st.Stop)
+		}
+		if st.BatchEnds[1] == "" || st.BatchEnds[1] == head {
+			t.Errorf("batch 1 end = %q, head = %q; want the end commit of the repaired batch", st.BatchEnds[1], head)
+		}
+		if got := len(fx.verify.calls); got != 3 {
+			t.Errorf("verify calls = %d; want the batch's card and batch gate and the plan-level verify", got)
+		}
+	})
+
+	reentered := []struct {
+		name string
+		// setup shapes the fixture after the stop.
+		setup func(fx *runFixture)
+	}{
+		{"DirtyTree", func(fx *runFixture) { fx.git.dirty = []string{"x.go"} }},
+		{"FailingBatchGateAtHead", func(fx *runFixture) { fx.verify.scripts = []verifyScript{{failing: "TestBroken"}} }},
+		{"RowWithGateEntries", func(fx *runFixture) {
+			fx.deps.Gate = shuttleengine.GateSpec{{Name: "drift", Attempts: 1, Gate: func() (shuttleengine.GateResult, error) {
+				return shuttleengine.GateResult{Passed: true}, nil
+			}}}
+		}},
+	}
+	for _, tt := range reentered {
+		t.Run("NotRecordedDoneAndGetsALastRungAttempt_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			fx := newRunFixture(t, 1, "one")
+			stopFirstBatch(t, fx)
+			tt.setup(fx)
+			fx.runner.scripts = append(fx.runner.scripts, attemptScript{commit: true})
+
+			requireDone(t, mustRun(t, fx), 1)
+
+			if len(fx.runner.specs) != 4 || fx.runner.specs[3].Model != "model-c" {
+				t.Fatalf("started = %d strand(s); want a fourth attempt on the last rung", len(fx.runner.specs))
+			}
+			st := fx.loadState()
+			if !st.Attempts[3].Reentry || st.Attempts[3].Number != 4 || st.Stop != nil {
+				t.Errorf("attempt 4 = reentry %v number %d, Stop = %+v; want the marked re-entry attempt and the stop cleared", st.Attempts[3].Reentry, st.Attempts[3].Number, st.Stop)
+			}
+		})
+	}
+
+	t.Run("EditToTheStoppedBatchsOwnCardRefreshesItsRecordedHash", func(t *testing.T) {
+		t.Parallel()
+		fx := newRunFixture(t, 1, "one")
+		stopFirstBatch(t, fx)
+		before := fx.loadState().Batches[1].CardHashes["01-one"]
+		fx.git.dirty = []string{"x.go"}
+		cardPath := filepath.Join(fx.deps.Geom.PlanDir, "01-one.md")
+		card, err := os.OpenFile(cardPath, os.O_APPEND|os.O_WRONLY, 0o644)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := card.WriteString("\nAn edit the parent made to the stopped card.\n"); err != nil {
+			t.Fatal(err)
+		}
+		_ = card.Close()
+		fx.runner.scripts = append(fx.runner.scripts, attemptScript{commit: true})
+
+		requireDone(t, mustRun(t, fx), 1)
+
+		sum := sha256.Sum256([]byte(readFile(t, cardPath)))
+		after := fx.loadState().Batches[1].CardHashes["01-one"]
+		if after == before || after != hex.EncodeToString(sum[:]) {
+			t.Errorf("card hash = %q after the edit, %q before; want the hash of the edited card", after, before)
+		}
+	})
+
+	t.Run("NeedsParentStartsOnTheAskingRungAndNeverRecordsDoneWithNoSpawn", func(t *testing.T) {
+		t.Parallel()
+		fx := newRunFixture(t, 1, "one")
+		fx.runner.scripts = []attemptScript{{report: runplan.Report{Status: runplan.ReportStatusNeedsParent, Need: "run lym fabric merge"}}, {commit: true}}
+		requireStuck(t, mustRun(t, fx), "run lym fabric merge")
+
+		requireDone(t, mustRun(t, fx), 1)
+
+		if len(fx.runner.specs) != 2 || fx.runner.specs[1].Model != "model-a" {
+			t.Fatalf("started = %d strand(s); want a second attempt on the asking rung", len(fx.runner.specs))
+		}
+		if !fx.loadState().Attempts[1].Reentry || len(fx.verify.calls) != 1 {
+			t.Errorf("verify calls = %d; want the plan-level verify alone, with no re-entry gate run", len(fx.verify.calls))
+		}
+	})
+
+	planEdits := []struct {
+		name  string
+		slugs []string
+	}{
+		{"LostARecordedCard", []string{"one"}},
+		{"GainedAnUnrecordedCard", []string{"one", "two", "three"}},
+	}
+	for _, tt := range planEdits {
+		t.Run("PlanThatChangedItsCardSetRefusesNamingBothWaysForward_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			fx := newRunFixture(t, 1, "one", "two")
+			stopFirstBatch(t, fx)
+			rewritePlan(t, fx, tt.slugs...)
+			if !slices.Contains(tt.slugs, "two") {
+				if err := os.Remove(filepath.Join(fx.deps.Geom.PlanDir, "02-two.md")); err != nil {
+					t.Fatal(err)
+				}
+			}
+
+			requireStuck(t, mustRun(t, fx), "put the plan's card set back as the recorded partition holds it", "lym weaver reset", "re-step the row")
+
+			if len(fx.runner.specs) != 3 {
+				t.Errorf("strands started = %d; want no attempt over a plan that does not match", len(fx.runner.specs))
+			}
+		})
+	}
+
+	t.Run("LostLastRungAttemptsThenReentryRetriesOnceOnTheLastRung", func(t *testing.T) {
+		t.Parallel()
+		for _, secondLost := range []bool{false, true} {
+			fx := newRunFixture(t, 1, "one")
+			failed := attemptScript{report: runplan.Report{Status: runplan.ReportStatusFailed}}
+			lost := attemptScript{dieAfterStart: true}
+			fx.runner.scripts = []attemptScript{failed, failed, lost, lost}
+			requireStuck(t, mustRun(t, fx), "batch 01-one")
+			fx.git.dirty = []string{"x.go"}
+			fx.runner.scripts = append(fx.runner.scripts, lost, attemptScript{commit: true})
+			if secondLost {
+				fx.runner.scripts[5] = lost
+			}
+
+			result := mustRun(t, fx)
+
+			var models []string
+			for _, spec := range fx.runner.specs {
+				models = append(models, spec.Model)
+			}
+			if want := []string{"model-a", "model-b", "model-c", "model-c", "model-c", "model-c"}; !slices.Equal(models, want) {
+				t.Errorf("models = %v; want the re-entry attempt and its one retry on the last rung %v", models, want)
+			}
+			st := fx.loadState()
+			if !st.Attempts[4].Reentry || st.Attempts[5].Reentry || st.Attempts[5].Number != 6 {
+				t.Errorf("attempts 5 and 6 = reentry %v and %v, number %d; want only the first marked", st.Attempts[4].Reentry, st.Attempts[5].Reentry, st.Attempts[5].Number)
+			}
+			if secondLost {
+				requireStuck(t, result, "batch 01-one")
+				continue
+			}
+			requireDone(t, result, 1)
+		}
+	})
+
+	t.Run("VerifyReentryRunsTheVerifyAgainAndAFailureGetsOneLastRungFixer", func(t *testing.T) {
+		t.Parallel()
+		stopVerify := func(t *testing.T) *runFixture {
+			fx := newRunFixture(t, 1, "one")
+			for range 8 {
+				fx.verify.scripts = append(fx.verify.scripts, verifyScript{failing: "TestBroken"})
+			}
+			requireStuck(t, mustRun(t, fx), "plan-level verify")
+			fx.verify.scripts = fx.verify.scripts[:len(fx.verify.calls)]
+			return fx
+		}
+
+		t.Run("FailsAgain", func(t *testing.T) {
+			fx := stopVerify(t)
+			for range 4 {
+				fx.verify.scripts = append(fx.verify.scripts, verifyScript{failing: "TestBroken"})
+			}
+
+			requireStuck(t, mustRun(t, fx), "plan-level verify")
+
+			if len(fx.fixer.specs) != 4 || fx.fixer.specs[3].ModelChoice.Model != "model-c" {
+				t.Fatalf("fixers spawned = %d; want one more, on the last rung", len(fx.fixer.specs))
+			}
+			st := fx.loadState()
+			if !st.Fixers[3].Reentry || st.Stop == nil || st.Stop.Kind != "verify" {
+				t.Errorf("fixer 4 reentry = %v, Stop = %+v; want it marked and a new verify stop", st.Fixers[3].Reentry, st.Stop)
+			}
+		})
+
+		t.Run("Passes", func(t *testing.T) {
+			fx := stopVerify(t)
+
+			requireDone(t, mustRun(t, fx), 1)
+
+			if len(fx.fixer.specs) != 3 || fx.loadState().Stop != nil {
+				t.Errorf("fixers spawned = %d, Stop = %+v; want no new fixer and the stop cleared", len(fx.fixer.specs), fx.loadState().Stop)
+			}
+		})
+	})
+
+	t.Run("LastBatchWhoseFinalRecordCommitFailsStartsNoSecondReentry", func(t *testing.T) {
+		t.Parallel()
+		fx := newRunFixture(t, 1, "one")
+		stopFirstBatch(t, fx)
+		fx.git.dirty = []string{"x.go"}
+		fx.runner.scripts = append(fx.runner.scripts, attemptScript{commit: true})
+		fx.commitErr = func(msg string) error {
+			if msg == "weaver: run record" {
+				return os.ErrPermission
+			}
+			return nil
+		}
+
+		requireStuck(t, mustRun(t, fx), "re-step the row")
+		if st := fx.loadState(); st.Stop != nil || len(st.Attempts) != 4 {
+			t.Fatalf("Stop = %+v, attempts = %d; want the stop cleared by the re-entry attempt's done", st.Stop, len(st.Attempts))
+		}
+
+		fx.commitErr = nil
+		requireDone(t, mustRun(t, fx), 1)
+
+		if len(fx.runner.specs) != 4 {
+			t.Errorf("strands started = %d; want no second re-entry", len(fx.runner.specs))
+		}
+	})
+}
diff --git a/internal/weaverengine/render.go b/internal/weaverengine/render.go
new file mode 100644
index 00000000..3a966d86
--- /dev/null
+++ b/internal/weaverengine/render.go
@@ -0,0 +1,147 @@
+// render.go renders the prompt of one Weaver batch attempt.
+// The template is read at call time through stencilstore and filled from the batch the attempt builds.
+
+package weaverengine
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/discussionparser"
+	"github.com/Knatte18/loomyard/internal/editdirective"
+	"github.com/Knatte18/loomyard/internal/friction"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/languageconfig"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/parentdirective"
+	"github.com/Knatte18/loomyard/internal/pattern"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/stencil"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+)
+
+// batchTemplateStencil is the name of the batch attempt prompt's stencil.
+const batchTemplateStencil = "weaver-template-batch"
+
+// verifyFixBodyStencil is the name of the plan-level verify fixer's body stencil.
+const verifyFixBodyStencil = "weaver-body-verify-fix"
+
+// noText is what a required marker takes when it has nothing to say.
+const noText = "none"
+
+// BatchPromptInputs is everything RenderBatchPrompt fills the batch template from.
+type BatchPromptInputs struct {
+	// StencilsDir is the told directory the template and the directive stencils are read from.
+	StencilsDir string
+	// PromptsDir is the directory the rendered prompt is written into.
+	PromptsDir string
+	// Label names the batch as NN-<slug>, and Attempt is the attempt number; together they name the prompt file.
+	Label   string
+	Attempt int
+	// Cards are the batch's cards in card order.
+	Cards []planparser.Card
+	// PlanDirDisplay is the spelling of the plan directory the card pointers carry.
+	PlanDirDisplay string
+	// Gate is the hub's gate config the card gates and the batch gate render from.
+	Gate gateslot.Config
+	// LastBatch reports that the batch is the partition's last, whose batch gate also runs the main packages.
+	LastBatch bool
+	// RepoRoot is the worktree root holding PATTERN.md, which the PATTERN directive reads.
+	RepoRoot string
+	// DecisionRecordPath, JournalPath and ReportPath are the paths the prompt names.
+	DecisionRecordPath string
+	JournalPath        string
+	ReportPath         string
+	// FailureDigest and UncommittedPaths describe a retry; blank renders `none`.
+	FailureDigest    string
+	UncommittedPaths string
+	// GateTiers is the hub's tier and gate-list lines; blank renders `none`.
+	GateTiers string
+	// RenameTools are the hub's structure-aware rename tools; empty renders `none`.
+	RenameTools []string
+	// ParentName renders the parent directive; blank renders its no-parent variant.
+	ParentName string
+	// NotePath is the friction note path, blank when friction capture is off.
+	NotePath string
+}
+
+// RenderBatchPrompt fills the batch template for one attempt, writes it under in.PromptsDir and returns its bytes.
+// The card pointers carry their card gates, and the batch gate carries the main packages for the last batch.
+// A gate config that lacks the `card` or `batch` list refuses with the config's way forward.
+// A friction directive that cannot be rendered is logged and left out.
+func RenderBatchPrompt(in BatchPromptInputs) ([]byte, error) {
+	cards, err := runplan.RenderCardGates(in.Cards, in.PlanDirDisplay, in.Gate)
+	if err != nil {
+		return nil, err
+	}
+	batchGate, err := runplan.RenderBatchGate(in.Cards, in.Gate, in.LastBatch)
+	if err != nil {
+		return nil, err
+	}
+	patternChanges, err := discussionparser.DeclaredPatternChanges(in.DecisionRecordPath)
+	if err != nil {
+		return nil, fmt.Errorf("weaver: read the declared PATTERN changes for batch %s: %w", in.Label, err)
+	}
+	patternDirective, err := pattern.Directive(in.RepoRoot, in.StencilsDir, pattern.RoleImplementer, patternChanges)
+	if err != nil {
+		return nil, fmt.Errorf("weaver: batch prompt PATTERN directive: %w", err)
+	}
+	parentDirective, err := parentdirective.Directive(in.StencilsDir, in.ParentName, false)
+	if err != nil {
+		return nil, fmt.Errorf("weaver: batch prompt parent directive: %w", err)
+	}
+	editDirective, err := editdirective.Directive(in.StencilsDir)
+	if err != nil {
+		return nil, fmt.Errorf("weaver: batch prompt edit directive: %w", err)
+	}
+	frictionDirective, err := friction.Directive(in.NotePath, in.StencilsDir, friction.RoleImplementer)
+	if err != nil {
+		logger.Warn("weaver: friction directive failed, continuing without one", "stencil", batchTemplateStencil, "error", err)
+		frictionDirective = ""
+	}
+
+	template, err := stencilstore.Read(in.StencilsDir, batchTemplateStencil)
+	if err != nil {
+		return nil, fmt.Errorf("weaver: read the batch template: %w", err)
+	}
+	friction.WarnIfMarkerAbsent(template, batchTemplateStencil, frictionDirective)
+	values := map[string]string{
+		"cards":                    cards,
+		"batch_gate":               batchGate,
+		"decision_record":          in.DecisionRecordPath,
+		"journal":                  in.JournalPath,
+		"report_path":              in.ReportPath,
+		"failure_digest":           textOrNone(in.FailureDigest),
+		"uncommitted_paths":        textOrNone(in.UncommittedPaths),
+		"gate_tiers":               textOrNone(in.GateTiers),
+		"rename_tools":             languageconfig.BulletListValue(in.RenameTools),
+		"pattern_directive":        patternDirective,
+		friction.MarkerName:        frictionDirective,
+		parentdirective.MarkerName: parentDirective,
+		editdirective.MarkerName:   editDirective,
+	}
+	prompt, err := stencil.FillOptional(template, values, []string{"pattern_directive", friction.MarkerName, parentdirective.MarkerName})
+	if err != nil {
+		return nil, fmt.Errorf("weaver: fill the batch template: %w", err)
+	}
+
+	if err := os.MkdirAll(in.PromptsDir, 0o755); err != nil {
+		return nil, fmt.Errorf("weaver: create prompts dir %s: %w", in.PromptsDir, err)
+	}
+	promptPath := filepath.Join(in.PromptsDir, fmt.Sprintf("%s-a%d.md", in.Label, in.Attempt))
+	if err := os.WriteFile(promptPath, prompt, 0o644); err != nil {
+		return nil, fmt.Errorf("weaver: write the batch prompt %s: %w", promptPath, err)
+	}
+	return prompt, nil
+}
+
+// textOrNone returns text, or `none` when it is blank.
+func textOrNone(text string) string {
+	if strings.TrimSpace(text) == "" {
+		return noText
+	}
+	return text
+}
diff --git a/internal/weaverengine/render_test.go b/internal/weaverengine/render_test.go
new file mode 100644
index 00000000..7f16523c
