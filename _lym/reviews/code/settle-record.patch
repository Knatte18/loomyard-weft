diff --git a/internal/runplan/pending.go b/internal/runplan/pending.go
new file mode 100644
index 00000000..314f8623
--- /dev/null
+++ b/internal/runplan/pending.go
@@ -0,0 +1,83 @@
+// pending.go partitions the cards a run has not yet built, and records that partition beside the batches already done.
+
+package runplan
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// PendingPartition partitions the cards of plan that no terminal done batch record of st holds.
+// A card is held by slug: each record's card ids are matched on the slug after their number,
+// so a card renumbered since its batch ran still counts as done.
+// It returns the done batches as st.Partition records them, in order,
+// and the fresh batches b forms over the remaining cards.
+// b is told that the done batches run ahead of the remaining cards.
+// A plan with no remaining card returns no fresh batch.
+func PendingPartition(plan *planparser.Plan, st *State, b batcher.Batcher, sizes batcher.SizeSource) ([]PartitionBatch, []batcher.Batch, error) {
+	doneSlugs := doneCardSlugs(st)
+
+	var done []PartitionBatch
+	for _, pb := range st.Partition {
+		if len(pb.Cards) > 0 && allSlugsDone(pb.Cards, doneSlugs) {
+			done = append(done, pb)
+		}
+	}
+
+	var remaining []planparser.Card
+	for _, c := range plan.Cards {
+		if !doneSlugs[c.Slug] {
+			remaining = append(remaining, c)
+		}
+	}
+	if len(remaining) == 0 {
+		return done, nil, nil
+	}
+
+	fresh, err := b.Batch(plan, remaining, sizes, len(done), batcher.StartBase{})
+	if err != nil {
+		return nil, nil, fmt.Errorf("runplan: batch the remaining cards of plan %s: %w", plan.Dir, err)
+	}
+	return done, fresh, nil
+}
+
+// RecordBeginPartition replaces st.Partition with the done batches as given, followed by the fresh batches.
+// The fresh batches are recorded as RecordPartition records them.
+func RecordBeginPartition(st *State, done []PartitionBatch, fresh []batcher.Batch) {
+	RecordPartition(st, fresh)
+	st.Partition = append(append([]PartitionBatch{}, done...), st.Partition...)
+}
+
+// doneCardSlugs returns the slugs of every card a terminal done batch record of st holds.
+// A record written before card ids existed names the single card of its own slug.
+func doneCardSlugs(st *State) map[string]bool {
+	slugs := make(map[string]bool)
+	for _, bs := range st.Batches {
+		if bs == nil || !bs.Terminal || bs.Status != DigestStatusDone {
+			continue
+		}
+		if len(bs.Cards) == 0 {
+			slugs[bs.Slug] = true
+			continue
+		}
+		for _, id := range bs.Cards {
+			_, slug, _ := strings.Cut(id, "-")
+			slugs[slug] = true
+		}
+	}
+	return slugs
+}
+
+// allSlugsDone reports whether the slug of every card id is in done.
+func allSlugsDone(ids []string, done map[string]bool) bool {
+	for _, id := range ids {
+		_, slug, _ := strings.Cut(id, "-")
+		if !done[slug] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/runplan/pending_test.go b/internal/runplan/pending_test.go
new file mode 100644
index 00000000..9a258c67
--- /dev/null
+++ b/internal/runplan/pending_test.go
@@ -0,0 +1,107 @@
+// pending_test.go covers the partition of a run's remaining cards.
+// Tier 0: a fake batcher, no files.
+
+package runplan
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// onePerCardBatcher forms one batch per card and records the batch count it was told ran before its cards.
+type onePerCardBatcher struct {
+	before *int
+}
+
+func (o onePerCardBatcher) Batch(_ *planparser.Plan, cards []planparser.Card, _ batcher.SizeSource, before int, _ batcher.StartBase) ([]batcher.Batch, error) {
+	*o.before = before
+	batches := make([]batcher.Batch, 0, len(cards))
+	for _, c := range cards {
+		batches = append(batches, batcher.Batch{Cards: []planparser.Card{c}, Profile: "fake"})
+	}
+	return batches, nil
+}
+
+func (onePerCardBatcher) Name() string { return "fake" }
+
+func TestPendingPartition(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	plan := &planparser.Plan{Dir: "plan", Cards: []planparser.Card{
+		{Number: 1, Slug: "one"}, {Number: 2, Slug: "two"}, {Number: 3, Slug: "three"},
+	}}
+	doneState := func(ids ...string) *State {
+		st := &State{Batches: map[int]*BatchState{}}
+		for i, id := range ids {
+			st.Batches[i+1] = &BatchState{Cards: []string{id}, Terminal: true, Status: DigestStatusDone}
+			st.Partition = append(st.Partition, PartitionBatch{Cards: []string{id}})
+		}
+		return st
+	}
+	slugsOf := func(batches []batcher.Batch) []string {
+		var slugs []string
+		for _, b := range batches {
+			for _, c := range b.Cards {
+				slugs = append(slugs, c.Slug)
+			}
+		}
+		return slugs
+	}
+
+	tests := []struct {
+		name       string
+		st         *State
+		wantDone   int
+		wantFresh  []string
+		wantBefore int
+	}{
+		{"fresh run partitions every card", &State{}, 0, []string{"one", "two", "three"}, 0},
+		{"done batch is dropped by slug and kept", doneState("01-one"), 1, []string{"two", "three"}, 1},
+		{"done batch is matched after the card was renumbered", doneState("07-two"), 1, []string{"one", "three"}, 1},
+		{"every card done returns no fresh batch", doneState("01-one", "02-two", "03-three"), 3, nil, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			before := -1
+			done, fresh, err := PendingPartition(plan, tt.st, onePerCardBatcher{&before}, nil)
+			if err != nil {
+				t.Fatalf("PendingPartition() error = %v", err)
+			}
+			if len(done) != tt.wantDone {
+				t.Errorf("PendingPartition() kept %d done batches; want %d", len(done), tt.wantDone)
+			}
+			if got := slugsOf(fresh); !slices.Equal(got, tt.wantFresh) {
+				t.Errorf("PendingPartition() fresh cards = %v; want %v", got, tt.wantFresh)
+			}
+			if len(tt.wantFresh) > 0 && before != tt.wantDone {
+				t.Errorf("PendingPartition() told the batcher %d batches ran before; want %d", before, tt.wantDone)
+			}
+		})
+	}
+
+	t.Run("RecordBeginPartition keeps the done batches first", func(t *testing.T) {
+		t.Parallel()
+
+		st := doneState("01-one")
+		done, fresh, err := PendingPartition(plan, st, onePerCardBatcher{new(int)}, nil)
+		if err != nil {
+			t.Fatalf("PendingPartition() error = %v", err)
+		}
+		RecordBeginPartition(st, done, fresh)
+
+		var got []string
+		for _, pb := range st.Partition {
+			got = append(got, pb.Cards...)
+		}
+		if want := []string{"01-one", "02-two", "03-three"}; !slices.Equal(got, want) {
+			t.Errorf("st.Partition cards = %v; want %v", got, want)
+		}
+	})
+}
diff --git a/internal/shedadapters/doc.go b/internal/shedadapters/doc.go
index 68cba25c..0e03b10b 100644
--- a/internal/shedadapters/doc.go
+++ b/internal/shedadapters/doc.go
@@ -1,6 +1,7 @@
 // Package shedadapters holds the shedengine.ShedProducer adapters for a Shed-built product's flat producer list.
 // Each adapter lets Shed drive one engine as an ordinary producer.
 // WebsterProducer wraps one websterengine multi-spawn run.
+// WeaverProducer wraps one weaverengine run, which builds every remaining batch of the plan as cold strands.
 // BurlerReviewProducer and BurlerFixProducer each wrap one half of a burlerengine round.
 // The halves are a reviewer strand and a fixer strand.
 // MultiLLMProducer wraps one seatengine table, a chair strand and its advisors' strands, as a single Shed row.
@@ -33,6 +34,12 @@
 //     Any other outcome value reaching Call is an engine-level error.
 //     WebsterProducer is a gate carrier: its done and stuck pointers carry the gate count and spans of the master run.
 //     The spans include the verify gate's entry.
+//   - WeaverProducer: Weaver's "done" outcome maps to Done, and the pointer's path is Weaver's summary path.
+//     Its "stuck" outcome maps to Stuck, and consults the plan-conflict record under the same claim as Webster's.
+//     So do ErrRunBusy and every other fault Weaver's run returns, such as a wiring error or a state read or write error;
+//     their text already names the way forward, which ends in this row's re-entry step.
+//     A cancellation replaces every non-success verdict with the context error.
+//     WeaverProducer carries no gate count: the verify fixer's gates are Weaver's own.
 //   - BurlerReviewProducer and BurlerFixProducer: a finished half maps to Stuck, never Done.
 //     A half is finished when shuttleengine.OutcomeDone is reached within the bounded retry.
 //     The pointer's path is the round's review path.
diff --git a/internal/shedadapters/weaver.go b/internal/shedadapters/weaver.go
new file mode 100644
index 00000000..5bb95aa3
--- /dev/null
+++ b/internal/shedadapters/weaver.go
@@ -0,0 +1,120 @@
+// weaver.go implements WeaverProducer, an adapter over weaverengine.Run.
+// It maps the run's RunResult and error onto the shedengine.ShedProducer contract.
+// It also holds claimConflict, the plan-conflict claim a stuck implementer row makes.
+
+package shedadapters
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/summaryparser"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+)
+
+// weaverEngineLabel is the engine label that log lines and error text carry.
+const weaverEngineLabel = "weaver"
+
+// WeaverRunner is the seam WeaverProducer calls to run Weaver.
+// It is a func type rather than an interface, because weaverengine.Run is already a free function.
+type WeaverRunner func(weaverengine.RunDeps) (weaverengine.RunResult, error)
+
+var _ WeaverRunner = weaverengine.Run
+
+// weaverengine keeps its outcome values unexported, so these constants copy its literals.
+// A rename there surfaces here: the default branch in Call errors on any value other than these two,
+// and a test drives that branch.
+const (
+	weaverOutcomeDone  = "done"
+	weaverOutcomeStuck = "stuck"
+)
+
+// WeaverProducer is a shedengine.ShedProducer that runs weaverengine.Run once per Call.
+// One Call runs every remaining batch of the plan and the plan-level verify.
+// It maps the result onto the shedengine contract.
+type WeaverProducer struct {
+	name string
+	run  WeaverRunner
+	deps weaverengine.RunDeps
+}
+
+var _ shedengine.ShedProducer = (*WeaverProducer)(nil)
+
+// NewWeaverProducer returns a WeaverProducer named name that drives deps through run.
+// A nil run defaults to weaverengine.Run.
+// An empty deps.ReentryStep becomes "re-step the <name> row", so every way forward in a stop reason names this row.
+func NewWeaverProducer(name string, run WeaverRunner, deps weaverengine.RunDeps) *WeaverProducer {
+	if run == nil {
+		run = weaverengine.Run
+	}
+	if deps.ReentryStep == "" {
+		deps.ReentryStep = fmt.Sprintf("re-step the %s row", name)
+	}
+	return &WeaverProducer{name: name, run: run, deps: deps}
+}
+
+// Call runs one iteration of the producer.
+// It checks the context on entry and maps the run's result.
+// Done points at Weaver's summary, which survives a cancellation that arrives during the run.
+// A stuck result consults the plan-conflict record the run left, through claimConflict,
+// so a new conflict asks for a reroute to plan review and a repeat does not.
+// A busy run and a fault in Weaver's config or state map to Stuck with the error's text, which names its way forward.
+// A cancellation replaces every other non-success verdict with the context error.
+func (p *WeaverProducer) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if err := entryErr(ctx, p.name, weaverEngineLabel); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+
+	result, err := p.run(p.deps)
+	if err != nil {
+		if cerr := cancelErr(ctx, p.name, weaverEngineLabel); cerr != nil {
+			return "", shedengine.OutputPointer{}, cerr
+		}
+		return shedengine.Stuck, shedengine.OutputPointer{Reason: err.Error()}, nil
+	}
+
+	switch result.Outcome {
+	case weaverOutcomeDone:
+		return shedengine.Done, shedengine.OutputPointer{Path: summaryparser.Path(p.deps.Geom.RunDir)}, nil
+
+	case weaverOutcomeStuck:
+		if cerr := cancelErr(ctx, p.name, weaverEngineLabel); cerr != nil {
+			return "", shedengine.OutputPointer{}, cerr
+		}
+		logger.Warn("shedadapters: weaver run is stuck", "producer", p.name, "engine", weaverEngineLabel, "stuckReason", result.StuckReason, "batchesDone", result.BatchesDone)
+		ptr := claimConflict(p.name, weaverEngineLabel, result.StuckReason, runplan.ConflictDir(p.deps.Geom.AnchorRoot), shedengine.OutputPointer{})
+		return shedengine.Stuck, ptr, nil
+
+	default:
+		if cerr := cancelErr(ctx, p.name, weaverEngineLabel); cerr != nil {
+			return "", shedengine.OutputPointer{}, cerr
+		}
+		return "", shedengine.OutputPointer{}, fmt.Errorf("shedadapters: %s (%s): unrecognized weaver outcome %q", p.name, weaverEngineLabel, result.Outcome)
+	}
+}
+
+// claimConflict claims the plan-conflict record in conflictDir for a stuck implementer row named name over engine.
+// It returns ptr with its Reason set.
+// A new conflict sets Reroute and asks plan review to clear it.
+// A repeat of the last routed conflict names the hand edit that clears it.
+// No record, or a claim that fails, keeps reason as it is.
+// A failed claim is logged.
+func claimConflict(name, engine, reason, conflictDir string, ptr shedengine.OutputPointer) shedengine.OutputPointer {
+	ptr.Reason = reason
+	route, err := runplan.ClaimConflictRoute(conflictDir)
+	if err != nil {
+		logger.Warn("shedadapters: plan-conflict record not claimed; the stuck outcome halts", "producer", name, "engine", engine, "error", err)
+		return ptr
+	}
+	switch {
+	case route.New:
+		ptr.Reroute = true
+		ptr.Reason = engine + " plan conflict, asking a reroute to plan review: " + reason + "; if plan review does not clear it: " + planConflictWayForward
+	case route.Found:
+		ptr.Reason = "the same " + engine + " plan conflict recurred after a reroute of it was asked for: " + reason + "; way forward: " + planConflictWayForward
+	}
+	return ptr
+}
