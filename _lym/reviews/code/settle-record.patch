+// codetip_integration_test.go covers OriginCodeTip over pair fixtures whose records origin holds planted transitions.
+// It also holds the helper that plants one, which the owner-guard rows of the pair push share.
+// Package fabricengine_test; shares the single TestMain in testmain_test.go.
+
+package fabricengine_test
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// plantRunTransition commits a transition of the run slug on origin's records branch from a second clone.
+// The commit names codeTip and carries a child record whose last history entry names machine.
+// The pair's own records worktree then fast-forwards to it, so its next push of that branch is no rejection.
+func plantRunTransition(t *testing.T, p *pairFixture, slug, codeTip, machine string) {
+	t.Helper()
+
+	_, statusRel, err := shedrun.TreeRunFileRels(slug)
+	if err != nil {
+		t.Fatalf("TreeRunFileRels(%q): %v", slug, err)
+	}
+	record, err := json.Marshal(shedengine.Status{
+		State:   shedengine.StateRunning,
+		History: []shedengine.HistoryEntry{{Producer: "Code-Burler", Outcome: shedengine.Done, Machine: machine}},
+	})
+	if err != nil {
+		t.Fatalf("marshal the child record: %v", err)
+	}
+	message := "transition\n\n" + fabricengine.TransitionTrailerKey + ": " + slug + "\n" + fabricengine.WarpSHATrailerKey + ": " + codeTip
+	p.originCommit(p.weftBranch, statusRel, string(record), message)
+	gitkit.Git(t, p.weftPath, "fetch")
+	gitkit.Git(t, p.weftPath, "merge", "--ff-only", "origin/"+p.weftBranch)
+}
+
+// TestOriginCodeTip reads the code tip the last transition on origin names, from the refs a fetch left.
+func TestOriginCodeTip(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	const slug = "tipread"
+	tests := []struct {
+		name string
+		// plant makes origin's records branch hold transitions and returns the reading wanted, its time aside.
+		plant func(t *testing.T, p *pairFixture) fabricengine.CodeTipReading
+		slug  string
+	}{
+		{
+			"ATipOriginsCodeBranchHoldsIsNotMissing",
+			func(t *testing.T, p *pairFixture) fabricengine.CodeTipReading {
+				held := bareBranchTip(t, p.hub.CodeBare, p.warpBranch)
+				plantRunTransition(t, p, slug, held, "oslo")
+				return fabricengine.CodeTipReading{Tip: held, Machine: "oslo"}
+			},
+			slug,
+		},
+		{
+			"ATipOriginsCodeBranchLacksIsMissingWithItsMachine",
+			func(t *testing.T, p *pairFixture) fabricengine.CodeTipReading {
+				lacked := gitkit.CommitFile(t, p.warpPath, "warp-file.txt", "warp\n", "unpushed code")
+				plantRunTransition(t, p, slug, lacked, "oslo")
+				return fabricengine.CodeTipReading{Tip: lacked, Missing: true, Machine: "oslo"}
+			},
+			slug,
+		},
+		{
+			"ALaterFabricCommitWithoutTheTransitionTrailerDoesNotMoveTheTip",
+			func(t *testing.T, p *pairFixture) fabricengine.CodeTipReading {
+				lacked := gitkit.CommitFile(t, p.warpPath, "warp-file.txt", "warp\n", "unpushed code")
+				plantRunTransition(t, p, slug, lacked, "oslo")
+				held := bareBranchTip(t, p.hub.CodeBare, p.warpBranch)
+				p.originCommit(p.weftBranch, "fabric-note.txt", "note\n", "fabric commit\n\n"+fabricengine.WarpSHATrailerKey+": "+held)
+				return fabricengine.CodeTipReading{Tip: lacked, Missing: true, Machine: "oslo"}
+			},
+			slug,
+		},
+		{
+			"ASlugWithNoRecordsBranchOnOriginReadsNotMissing",
+			func(t *testing.T, p *pairFixture) fabricengine.CodeTipReading {
+				return fabricengine.CodeTipReading{}
+			},
+			"ghost",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			p := newPairFixture(t, slug)
+			want := tt.plant(t, p)
+			gitkit.Git(t, p.weftPath, "fetch")
+
+			got, err := fabricengine.OriginCodeTip(p.hub.Location, tt.slug)
+
+			if err != nil {
+				t.Fatalf("OriginCodeTip(%q) error = %v; want none", tt.slug, err)
+			}
+			wantAt := want.Tip != ""
+			if got.At.IsZero() == wantAt {
+				t.Errorf("OriginCodeTip(%q) time = %v; want a commit time exactly when a tip is named", tt.slug, got.At)
+			}
+			got.At = time.Time{}
+			if got != want {
+				t.Errorf("OriginCodeTip(%q) = %+v; want %+v", tt.slug, got, want)
+			}
+		})
+	}
+}
diff --git a/internal/fabricengine/codetipsettle.go b/internal/fabricengine/codetipsettle.go
new file mode 100644
index 00000000..10649665
--- /dev/null
+++ b/internal/fabricengine/codetipsettle.go
@@ -0,0 +1,130 @@
+// codetipsettle.go holds the owner's side of a code tip origin lacks:
+// fetching a pair's tips and returning a run to its previous transition when the tip is given up.
+
+package fabricengine
+
+import (
+	"fmt"
+	"path"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// FetchPairTips fetches the code branch and the records branch of the pair at pair from origin.
+// A reader of origin's fetched refs, such as OriginCodeTip, then sees what origin holds now.
+func FetchPairTips(pair *lymcwd.Location) error {
+	if err := gitrepo.New(RecordsWorktree(pair)).Fetch(); err != nil {
+		return fmt.Errorf("fetch the records branch of the pair at %s: %w", pair.WorktreePath(), err)
+	}
+	if err := gitrepo.New(pair.WorktreePath()).Fetch(); err != nil {
+		return fmt.Errorf("fetch the code branch of the pair at %s: %w", pair.WorktreePath(), err)
+	}
+	return nil
+}
+
+// ReturnToPreviousTransition gives up the code tip the last transition of slug names.
+// It fetches the pair's records branch.
+// On origin's ref it finds the newest commit whose Run-Transition names slug, and the previous such commit.
+// It skips the records commits that mark no transition.
+// It commits, in the pair's records worktree, the run's status as that previous transition left it.
+// The commit's Warp-SHA is the previous transition's, never the pair's code HEAD.
+// The commit carries a Run-Transition trailer.
+// It reports false, committing nothing, when origin's records branch holds fewer than two transitions of slug:
+// the first transition names the tip the pair was made at, so nothing earlier can stand in.
+// It pushes nothing.
+func ReturnToPreviousTransition(pair *lymcwd.Location, slug string) (returned bool, err error) {
+	recordsDir := RecordsWorktree(pair)
+	repo := gitrepo.New(recordsDir)
+	if err := repo.Fetch(); err != nil {
+		return false, fmt.Errorf("fetch the records branch of %q: %w", slug, err)
+	}
+	upstream, hasUpstream, err := upstreamSHAAt(recordsDir)
+	if err != nil || !hasUpstream {
+		return false, err
+	}
+	commits, err := repo.Log(upstream, gitrepo.LogQuery{FirstParent: true})
+	if err != nil {
+		return false, fmt.Errorf("read the records history of %q at %s: %w", slug, upstream, err)
+	}
+	var transitions []gitrepo.LogCommit
+	for _, commit := range commits {
+		if trailerValue(commit.Message, TransitionTrailerKey) != slug {
+			continue
+		}
+		transitions = append(transitions, commit)
+		if len(transitions) == 2 {
+			break
+		}
+	}
+	if len(transitions) < 2 {
+		return false, nil
+	}
+	previous := transitions[1]
+	previousTip := trailerValue(previous.Message, WarpSHATrailerKey)
+	if previousTip == "" {
+		return false, fmt.Errorf("the previous transition %s of %q names no code tip", previous.SHA, slug)
+	}
+
+	runID, status, found, err := statusAtCommit(pair, recordsDir, previous.SHA, slug)
+	if err != nil {
+		return false, err
+	}
+	if !found {
+		return false, fmt.Errorf("the previous transition %s of %q holds no status record", previous.SHA, slug)
+	}
+	statusPath := shedrun.StatusFile(pair, runID)
+	if err := state.WriteJSON(statusPath, shedrun.StatusLock(pair, runID), status); err != nil {
+		return false, fmt.Errorf("write the status of %q as the previous transition left it: %w", slug, err)
+	}
+	statusRel, err := filepath.Rel(pair.AnchorPath(), statusPath)
+	if err != nil {
+		return false, fmt.Errorf("place the status path of %q under its anchor: %w", slug, err)
+	}
+
+	message := appendTrailerLine(appendWarpSHATrailer(slug+": return to the previous transition", previousTip), TransitionTrailerKey, slug)
+	_, committed, err := CommitAnchoredPaths(NewMutations(pair.HubPath), pair, []string{statusRel}, message, SyncOptions{})
+	if err != nil {
+		return false, fmt.Errorf("commit the return of %q to its previous transition: %w", slug, err)
+	}
+	if !committed {
+		return false, fmt.Errorf("the status of %q already equals the previous transition's, so the return committed nothing", slug)
+	}
+	return true, nil
+}
+
+// statusAtCommit reads the run record of slug at the records commit sha of the repository at recordsDir.
+// It tries the run directory named for the slug, then the legacy `self` one, and returns the run id that held it.
+func statusAtCommit(pair *lymcwd.Location, recordsDir, sha, slug string) (runID string, status shedengine.Status, found bool, err error) {
+	names, err := RepoWiredNames(pair)
+	if err != nil {
+		return "", shedengine.Status{}, false, fmt.Errorf("load the fabric config: %w", err)
+	}
+	anchor, err := treeAnchor(recordsDir, sha, names, pair.AnchorRel)
+	if err != nil {
+		return "", shedengine.Status{}, false, err
+	}
+	for _, candidate := range []string{slug, shedrun.SelfRunID} {
+		_, statusRel, err := shedrun.TreeRunFileRels(candidate)
+		if err != nil {
+			return "", shedengine.Status{}, false, err
+		}
+		data, err := showFile(recordsDir, sha, path.Join(filepath.ToSlash(anchor), statusRel))
+		if err != nil {
+			return "", shedengine.Status{}, false, fmt.Errorf("read the status of %q at %s: %w", slug, sha, err)
+		}
+		if data == nil {
+			continue
+		}
+		status, err := shedengine.ParseStatusTolerant(data)
+		if err != nil {
+			return "", shedengine.Status{}, false, fmt.Errorf("parse the status of %q at %s: %w", slug, sha, err)
+		}
+		return candidate, status, true, nil
+	}
+	return "", shedengine.Status{}, false, nil
+}
diff --git a/internal/fabricengine/codetipsettle_integration_test.go b/internal/fabricengine/codetipsettle_integration_test.go
new file mode 100644
index 00000000..3c4cc5f1
--- /dev/null
+++ b/internal/fabricengine/codetipsettle_integration_test.go
@@ -0,0 +1,121 @@
+// codetipsettle_integration_test.go covers ReturnToPreviousTransition.
+// Its pair fixtures have a records origin that holds transitions.
+// Package fabricengine_test; shares the single TestMain in testmain_test.go.
+
+package fabricengine_test
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// plantTwoTransitions makes origin's records branch hold two transitions of slug, with a fabric commit between and after.
+// The first names the tip origin's code branch holds and the second a commit only the pair's code branch holds.
+// The pair's code HEAD then moves past the second.
+// It returns the first tip and the second.
+func plantTwoTransitions(t *testing.T, p *pairFixture, slug string) (first, second string) {
+	t.Helper()
+
+	first = bareBranchTip(t, p.hub.CodeBare, p.warpBranch)
+	plantRunTransition(t, p, slug, first, "oslo")
+	p.originCommit(p.weftBranch, "fabric-note-1.txt", "note\n", "fabric commit\n\n"+fabricengine.WarpSHATrailerKey+": "+first)
+	second = gitkit.CommitFile(t, p.warpPath, "second.txt", "second\n", "second tip")
+	plantRunTransition(t, p, slug, second, "bergen")
+	gitkit.CommitFile(t, p.warpPath, "later.txt", "later\n", "later local code")
+	p.originCommit(p.weftBranch, "fabric-note-2.txt", "note\n", "fabric commit\n\n"+fabricengine.WarpSHATrailerKey+": "+first)
+	gitkit.Git(t, p.weftPath, "fetch")
+	gitkit.Git(t, p.weftPath, "merge", "--ff-only", "origin/"+p.weftBranch)
+	return first, second
+}
+
+// TestReturnToPreviousTransition gives up the last transition's code tip by committing the transition before it.
+func TestReturnToPreviousTransition(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	const slug = "giveup"
+	_, statusRel, err := shedrun.TreeRunFileRels(slug)
+	if err != nil {
+		t.Fatalf("TreeRunFileRels(%q): %v", slug, err)
+	}
+
+	t.Run("CommitsThePreviousTransitionsStatusAndNamesItsTipNotThePairsCodeHead", func(t *testing.T) {
+		t.Parallel()
+		p := newPairFixture(t, slug)
+		first, second := plantTwoTransitions(t, p, slug)
+		codeHead := gitkit.RevParse(t, p.warpPath, "HEAD")
+
+		returned, err := fabricengine.ReturnToPreviousTransition(p.location, slug)
+
+		if err != nil || !returned {
+			t.Fatalf("ReturnToPreviousTransition(%q) = %v, %v; want true, nil", slug, returned, err)
+		}
+		message := gitkit.Git(t, p.weftPath, "log", "-1", "--format=%B")
+		for _, want := range []string{
+			fabricengine.WarpSHATrailerKey + ": " + first,
+			fabricengine.TransitionTrailerKey + ": " + slug,
+		} {
+			if !strings.Contains(message, want) {
+				t.Errorf("commit message = %q; want it to hold %q", message, want)
+			}
+		}
+		for _, unwanted := range []string{second, codeHead} {
+			if strings.Contains(message, unwanted) {
+				t.Errorf("commit message = %q; want it to name neither the given-up tip nor the pair's code HEAD (%s)", message, unwanted)
+			}
+		}
+		var status shedengine.Status
+		if err := json.Unmarshal([]byte(gitkit.Git(t, p.weftPath, "show", "HEAD:"+statusRel)), &status); err != nil {
+			t.Fatalf("decode the committed status: %v", err)
+		}
+		if len(status.History) != 1 || status.History[0].Machine != "oslo" {
+			t.Errorf("committed status history = %+v; want the first transition's single entry of machine oslo", status.History)
+		}
+	})
+
+	t.Run("AGivenUpTipStaysOffOriginWhenTheOwingMachineHandsOver", func(t *testing.T) {
+		t.Parallel()
+		p := newPairFixture(t, slug)
+		first, _ := plantTwoTransitions(t, p, slug)
+		if returned, err := fabricengine.ReturnToPreviousTransition(p.location, slug); err != nil || !returned {
+			t.Fatalf("ReturnToPreviousTransition(%q) = %v, %v; want true, nil", slug, returned, err)
+		}
+		gitkit.Git(t, p.weftPath, "push")
+		entry := shedengine.Takeover{Machine: "oslo", Subject: "sub", At: "2026-11-17T10:00:00Z"}
+
+		res, err := fabricengine.HandOverTips(p.hub.Location, fabricengine.HandOverRequest{Slug: slug, Pair: p.location, Entry: entry})
+
+		if err != nil {
+			t.Fatalf("HandOverTips() error = %v; want none", err)
+		}
+		if res.TipPushed {
+			t.Errorf("HandOverTips() TipPushed = true; want false for a tip the last transition no longer names")
+		}
+		if got := bareBranchTip(t, p.hub.CodeBare, p.warpBranch); got != first {
+			t.Errorf("origin's code branch = %s; want %s, the tip the previous transition names", got, first)
+		}
+	})
+
+	t.Run("ARecordsBranchWithOneTransitionReturnsFalseAndCommitsNothing", func(t *testing.T) {
+		t.Parallel()
+		p := newPairFixture(t, slug)
+		plantRunTransition(t, p, slug, bareBranchTip(t, p.hub.CodeBare, p.warpBranch), "oslo")
+		headBefore := gitkit.RevParse(t, p.weftPath, "HEAD")
+
+		returned, err := fabricengine.ReturnToPreviousTransition(p.location, slug)
+
+		if err != nil || returned {
+			t.Fatalf("ReturnToPreviousTransition(%q) = %v, %v; want false, nil", slug, returned, err)
+		}
+		if got := gitkit.RevParse(t, p.weftPath, "HEAD"); got != headBefore {
+			t.Errorf("records HEAD = %s; want %s, unchanged", got, headBefore)
+		}
+	})
+}
