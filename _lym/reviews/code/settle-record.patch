+			},
+		},
+		{
+			name: "a symbolic ref chain of five links resolves to the last ref of the chain",
+			build: func(t *testing.T, root string) (string, []Worktree) {
+				commonDir := mainRepository(t, filepath.Join(root, "repo"), "")
