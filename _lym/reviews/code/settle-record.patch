new file mode 100755
index 00000000..f3004763
--- /dev/null
+++ b/docs/research/turn-savings-measure-2026-11-04/darn-writers.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# Usage: darn-writers.sh <dir-with-turns-and-calls> > darn-writers.tsv
+# One row per darn writer main session (role darn), then a TOTAL row, from turns.tsv and calls.tsv (extract-turns.sh of the turn audit):
+# slug session turns calls calls_per_turn edit_tool_calls shell_edit_calls awk_mv_edit_calls check_turns lookup_turns
+# edit_tool_calls are Edit and Write calls; shell_edit_calls are Bash calls the turn audit classes edit-script (sed -i, perl -i, tee, a heredoc or a redirect into a file);
+# awk_mv_edit_calls are the shell edit calls that write through awk and a temporary file moved into place, the route the shell-edit guard leaves open.
+# check_turns are turns holding a gate, test, lint or validate call, the darn writer's check loop; lookup_turns are single-call read and search turns.
+set -euo pipefail
+dir=$1
+awk -F'\t' -v OFS='\t' '
+function row(sid,    p) {
+  split(sid, p, SUBSEP)
+  print p[1], p[2], turns[sid], calls[sid], sprintf("%.2f", calls[sid] / turns[sid]), toolcalls[sid] + 0, shellcalls[sid] + 0, awkmv[sid] + 0, checks[sid] + 0, lookups[sid] + 0
+}
+FNR == 1 { next }
+FILENAME == ARGV[1] {
+  # calls.tsv: slug session kind role turn call ts tool class key
+  if ($3 != "main" || $4 != "darn") next
+  sid = $1 SUBSEP $2
+  id = sid SUBSEP $5
+  nclass[id]++
+  cls[id, nclass[id]] = $9
+  if ($9 == "edit") toolcalls[sid]++
+  if ($9 == "edit-script") {
+    shellcalls[sid]++
+    if ($10 ~ /awk .*>.*(&&|;) *mv /) awkmv[sid]++
+  }
+  next
+}
+{
+  # turns.tsv: slug session kind role turn ts ncalls ctx input cache_write cache_read output weight dep
+  if ($3 != "main" || $4 != "darn") next
+  sid = $1 SUBSEP $2
+  if (!(sid in turns)) order[++count] = sid
+  turns[sid]++; calls[sid] += $7
+  id = sid SUBSEP $5
+  hascheck = 0
+  for (j = 1; j <= nclass[id]; j++) if (cls[id, j] ~ /^(gate|test-lint|validate)$/) hascheck = 1
+  checks[sid] += hascheck
+  if ($7 == 1 && (cls[id, 1] == "read" || cls[id, 1] == "search")) lookups[sid]++
+}
+END {
+  print "slug", "session", "turns", "calls", "calls_per_turn", "edit_tool_calls", "shell_edit_calls", "awk_mv_edit_calls", "check_turns", "lookup_turns"
+  for (i = 1; i <= count; i++) {
+    s = order[i]; row(s)
+    tt += turns[s]; tc += calls[s]; tw += toolcalls[s]; ts += shellcalls[s]; ta += awkmv[s]; tk += checks[s]; tl += lookups[s]
+  }
+  print "TOTAL", count " sessions", tt, tc, sprintf("%.2f", tc / tt), tw, ts, ta, tk, tl
+}' "$dir/calls.tsv" "$dir/turns.tsv"
diff --git a/docs/research/turn-savings-measure-2026-11-04/events.jq b/docs/research/turn-savings-measure-2026-11-04/events.jq
new file mode 100644
index 00000000..a8d49ed5
--- /dev/null
+++ b/docs/research/turn-savings-measure-2026-11-04/events.jq
@@ -0,0 +1,45 @@
+# Reads one session transcript, slurped, and prints tab-separated event rows: type turn a b c (see events.sh).
+
+def restext: (.content | if type == "array" then map(.text? // "") | join(" ") else (. // "") | tostring end);
+def refusal_rule($t):
+  if ($t | test("never run Python")) then "python"
+  elif ($t | test("sed -i, perl -i, and a heredoc")) then "shell-edit"
+  elif ($t | test("rm on a computed path")) then "rm"
+  elif ($t | test("raw module-wide|go test run is refused|go run")) then "go-run"
+  else "other" end;
+def nudge_kind($t):
+  if ($t | test("each made one lookup")) then "lookup"
+  elif ($t | test("read a slice of")) then "slice"
+  elif ($t | test("only edits")) then "edit"
+  else "other" end;
+
+. as $all
+| ([$all[] | select(.type == "assistant" and .message.id != null)]
+   | group_by(.message.id) | map(sort_by(.timestamp)) | sort_by(.[0].timestamp)
+   | map([.[] | .message.content[]? | select(.type == "tool_use")] | unique_by(.id))) as $turns
+| ([range(0; $turns | length) as $n | $turns[$n][] | {key: .id, value: {turn: ($n + 1), name: .name, command: (.input.command // "")}}] | from_entries) as $call
+| ([$all[] | select(.type == "user") | (.message.content | arrays | .[]) | select(.type == "tool_result")
+    | {key: .tool_use_id, value: {text: restext, error: (.is_error // false)}}] | from_entries) as $res
+# exit codes of calls that ran in the background, from the task notifications that report them, keyed by the call's tool use id
+| ([$all[] | select(.type == "user" or .type == "queue-operation") | .. | strings | select(contains("<task-notification>"))
+    | capture("<tool-use-id>(?<id>[^<]+)</tool-use-id>.*?exit code (?<code>[0-9]+)\\)"; "s") | {key: .id, value: (.code | tonumber)}] | from_entries) as $background
+| (
+  # hook firings: the PostToolUse attachment that carries the hook's stdout
+  ($all[] | select(.type == "attachment" and (.attachment.stdout? // "" | contains("[lym batching]")))
+   | .attachment as $a | $call[$a.toolUseID] as $c | select($c != null)
+   | "nudge\t\($c.turn)\t\(nudge_kind($a.stdout))\t\(($turns[$c.turn] // []) | length)\t\($c.name)"),
+  # refused calls: a tool result that opens with a PreToolUse hook error
+  ($call | to_entries[] | .key as $id | .value as $c | $res[$id] as $r
+   | select($r != null and ($r.text | test("^PreToolUse:[A-Za-z]+ hook error")))
+   | "refusal\t\($c.turn)\t\(refusal_rule($r.text))\t\($c.name)\t"),
+  # lym gate test calls and how each ended
+  ($call | to_entries[] | .key as $id | .value as $c
+   | select($c.name == "Bash" and ($c.command | test("lym gate test")))
+   | $res[$id] as $r
+   | ((if ($c.command | test("--gate card")) then "card" elif ($c.command | test("--gate batch")) then "batch" else "other" end)) as $g
+   | (if $r == null or ($r.text | test("^Command was moved to the background|\"done\":false|the run is still going")) then
+        (if $background[$id] == null then "pending" elif $background[$id] == 0 then "green" else "fail" end)
+      elif ($r.text | test("^([Ee]xit code|exit) [1-9]")) then "fail"
+      else "green" end) as $o
+   | "gate\t\($c.turn)\t\($g)\t\($o)\t")
+)
diff --git a/docs/research/turn-savings-measure-2026-11-04/events.sh b/docs/research/turn-savings-measure-2026-11-04/events.sh
new file mode 100755
index 00000000..47017ba1
--- /dev/null
+++ b/docs/research/turn-savings-measure-2026-11-04/events.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+# Usage: events.sh <out-dir>
+# Reads the Claude Code transcripts of the slugs in slugs.txt (main sessions and fork sub-agents) under
+# ~/.claude/projects and writes <out-dir>/events.tsv, one row per hook firing, refused call or gate result:
+# slug session kind role type turn a b c
+# turn numbers a session's assistant messages as extract-turns.sh of the turn audit does, so rows join turns.tsv on slug, session and turn.
+#   type nudge:   a = the breach (lookup, slice, edit), b = the call count of the next message, c = the hook's tool
+#   type refusal: a = the refused rule (shell-edit, python, rm, go-run, other), b = the tool, c empty
+#   type gate:    a = the gate (card, batch, other), b = the result (fail, green, pending), c empty
+# A gate result is fail when the tool result opens "Exit code" or "exit" and a nonzero code, the two shapes the harness and lym's wait mode give, and green otherwise.
+# A call that moved to the background or answered done:false takes its exit code from the task notification that reports it, 0 green and any other fail;
+# with no such notification, or no result at all in the transcript, it is pending.
+# Sessions that started before CUTOFF (default 2026-11-02) are left out.
+set -euo pipefail
+out=$1
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+cutoff=${CUTOFF:-2026-11-02}
+projects=${PROJECTS:-$HOME/.claude/projects}
+mkdir -p "$out"
+printf 'slug\tsession\tkind\trole\ttype\tturn\ta\tb\tc\n' > "$out/events.tsv"
+
+process() { # file slug session kind role
+  local file=$1 slug=$2 session=$3 kind=$4 role=$5
+  jq -rs -f "$here/events.jq" "$file" |
+    awk -F'\t' -v OFS='\t' -v s="$slug" -v se="$session" -v k="$kind" -v r="$role" '{ print s, se, k, r, $0 }' >> "$out/events.tsv"
+}
+
+while read -r slug; do
+  dir=$projects/-home-knatte-Code-loomyard-LYMHUB-$slug
+  [ -d "$dir" ] || continue
+  for f in "$dir"/*.jsonl; do
+    [ -e "$f" ] || continue
+    first=$(jq -rn 'first(inputs | select(.type == "user" or .type == "assistant") | .timestamp)' "$f")
+    [[ "$first" < "$cutoff" ]] && continue
+    title=$(jq -r 'select(.type == "custom-title") | .customTitle' "$f" | tail -1)
+    role=${title##*:}; role=${role//\"/}; [ -n "$role" ] || role=untitled
+    sid=$(basename "$f" .jsonl)
+    process "$f" "$slug" "$sid" main "$role"
+    for sub in "$dir/$sid"/subagents/*.jsonl; do
+      [ -e "$sub" ] || continue
+      process "$sub" "$slug" "$(basename "$sub" .jsonl)" fork "$role+fork"
+    done
+  done
+done < "$here/slugs.txt"
diff --git a/docs/research/turn-savings-measure-2026-11-04/gate-loops.sh b/docs/research/turn-savings-measure-2026-11-04/gate-loops.sh
