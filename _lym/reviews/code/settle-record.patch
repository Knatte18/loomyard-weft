+    $darn | map(select(.profile != "-")) | group_by([.profile, .period]) | map([.[0].profile, .[0].period, (length | tostring), (map(.active) | mean | mins | r1), (map(.active) | med | mins | r1), (map(.lines) | present | med | r1)])),
