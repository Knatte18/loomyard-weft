+prompt=$(fill "$prompt" "parent_directive=" "edit_directive=" "review_path=$review_path" \
+  "instruction_1_path=$W/.bench/instr/step-1-explore-fan.md" "instruction_2_path=$W/.bench/instr/step-2-review-forkfan.md")
