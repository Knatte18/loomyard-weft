-			name: "claimed done but the seed file is empty",
-			shSet: func(seedPath string) Shuttle {
-				writeFile(t, seedPath, "   \n")
-				return &fixedShuttle{result: shuttleengine.Result{Outcome: shuttleengine.OutcomeDone}}
-			},
-		},
-	}
