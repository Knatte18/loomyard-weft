-    awk -F'|' '/^## Webster forks/{p=1;next} /^## /{p=0} p && $2!~/run|---/ && NF>5 {gsub(/^ +| +$/,"",$3); gsub(/ /,"",$6); print $3 "\t" $6}' "$md" |
-    while IFS=$'\t' read -r cl pk; do
-      fc=${cl%%,*}
