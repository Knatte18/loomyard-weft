@@ -0,0 +1,124 @@
+// upkeep.go decides, for one package's coverage map, what an upkeep pass keeps, drops and queues at a new commit.
+// It builds nothing and runs no test.
+
+package testcover
+
+import (
+	"maps"
+	"slices"
+	"strings"
+	"time"
+)
+
+// UpkeepVerdict is what an upkeep plan found for one coverage map.
+type UpkeepVerdict string
+
+// The verdicts of an upkeep plan.
+const (
+	// UpkeepCurrent is a map whose selection at the new commit has no affected test and no miss.
+	UpkeepCurrent UpkeepVerdict = "current"
+	// UpkeepAffected is a map whose selection has affected tests, whose entries the plan drops.
+	UpkeepAffected UpkeepVerdict = "affected"
+	// UpkeepMiss is a map the selector missed for: the plan leaves it as it is, and the package is rebuilt whole.
+	UpkeepMiss UpkeepVerdict = "miss"
+)
+
+// UpkeepTree is a package's file hashes at the commit an upkeep plan moves its map to, in Map's own shape.
+type UpkeepTree struct {
+	Files      map[string]string
+	OtherFiles map[string]string
+	Linked     map[string]map[string]string
+}
+
+// UpkeepInput is what PlanUpkeep decides one map from.
+type UpkeepInput struct {
+	// Map is the package's coverage map.
+	Map Map
+	// Selection is the selector's verdict on Map with Commit as target.
+	Selection Selection
+	// Commit is the commit the plan moves the map to, and At the time of the plan.
+	Commit string
+	At     time.Time
+	// Tree is the package's file hashes, and those of each package Map links, at Commit.
+	Tree UpkeepTree
+	// Declared are the tests of the package at Commit that a map holds: those of a mapped tier.
+	Declared []TestFunc
+	// Spawns returns the spawn scan of the package at Commit.
+	// The plan calls it only when a declared test has no entry.
+	Spawns func() (map[string]SpawnVerdict, error)
+}
+
+// UpkeepPlan is what an upkeep pass does with one map.
+type UpkeepPlan struct {
+	Verdict UpkeepVerdict
+	// Miss is the selector's miss under UpkeepMiss, nil otherwise.
+	Miss *Miss
+	// Map is the map at the plan's commit, set unless Verdict is UpkeepMiss.
+	Map Map
+	// Changed reports whether Map differs from the input map, so the pass writes it.
+	Changed bool
+	// Queue names the declared tests Map holds no entry for, in declared order: the tests the pass measures.
+	Queue []string
+}
+
+// PlanUpkeep plans one coverage map at a new commit from its selection there.
+// A miss leaves the map as it is.
+// Otherwise the map moves to the commit with the commit's file hashes, and keeps every entry but these, which it drops:
+// an affected test's, the entry of a test no longer declared,
+// and an outcome entry when any of the package's own files differs between the two commits.
+// A failure the map records at another commit is cleared, since the map now stands at the commit.
+// A declared test that then has no entry is queued, unless the spawn scan marks it out of process or unresolved:
+// such a test gets an entry with its verdict and is never run.
+// The error is the spawn scan's.
+func PlanUpkeep(in UpkeepInput) (UpkeepPlan, error) {
+	if in.Selection.Miss != nil {
+		return UpkeepPlan{Verdict: UpkeepMiss, Miss: in.Selection.Miss}, nil
+	}
+	plan := UpkeepPlan{Verdict: UpkeepCurrent, Changed: in.Map.Commit != in.Commit}
+	if len(in.Selection.Tests) > 0 {
+		plan.Verdict = UpkeepAffected
+	}
+	ownChanged := !maps.Equal(in.Map.Files, in.Tree.Files) || !maps.Equal(in.Map.OtherFiles, in.Tree.OtherFiles)
+	m := in.Map
+	m.Commit = in.Commit
+	m.Files, m.OtherFiles, m.Linked = in.Tree.Files, in.Tree.OtherFiles, in.Tree.Linked
+	if m.Failure != nil && m.Failure.Commit != in.Commit {
+		m.Failure = nil
+		plan.Changed = true
+	}
+	m.Tests = nil
+	declared := map[string]bool{}
+	for _, fn := range in.Declared {
+		declared[fn.Name] = true
+	}
+	entries := map[string]bool{}
+	for _, test := range in.Map.Tests {
+		if !declared[test.Name] || slices.Contains(in.Selection.Tests, test.Name) || (test.Outcome != "" && ownChanged) {
+			plan.Changed = true
+			continue
+		}
+		m.Tests = append(m.Tests, test)
+		entries[test.Name] = true
+	}
+	var spawns map[string]SpawnVerdict
+	for _, fn := range in.Declared {
+		if entries[fn.Name] {
+			continue
+		}
+		if spawns == nil {
+			var err error
+			if spawns, err = in.Spawns(); err != nil {
+				return UpkeepPlan{}, err
+			}
+		}
+		if verdict := spawns[fn.Name]; verdict.OutOfProcess || verdict.Unresolved {
+			m.Tests = append(m.Tests, MapTest{Name: fn.Name, Tier: fn.Tier, FuncHash: fn.Hash, Spawn: verdict, Commit: in.Commit, MeasuredAt: in.At})
+			plan.Changed = true
+			continue
+		}
+		plan.Queue = append(plan.Queue, fn.Name)
+	}
+	slices.SortStableFunc(m.Tests, func(a, b MapTest) int { return strings.Compare(a.Name, b.Name) })
+	plan.Map = m
+	return plan, nil
+}
diff --git a/internal/testcover/upkeep_test.go b/internal/testcover/upkeep_test.go
new file mode 100644
index 00000000..36b2dcb9
--- /dev/null
+++ b/internal/testcover/upkeep_test.go
@@ -0,0 +1,178 @@
+package testcover_test
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestPlanUpkeep(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	at := time.Date(2026, 11, 11, 12, 0, 0, 0, time.UTC)
+	files := map[string]string{"b.go": "b1", "b_test.go": "t1"}
+	planned := testcover.Map{
+		Commit: "old",
+		Files:  files,
+		Blocks: []testcover.BlockKey{{File: "b.go", Func: "Own", Hash: "own"}},
+		Tests: []testcover.MapTest{
+			{Name: "TestFailed", Outcome: testcover.OutcomeFailed},
+			{Name: "TestHit", Blocks: []int{0}},
+			{Name: "TestKeep", Blocks: []int{0}},
+			{Name: "TestSpawned", Spawn: testcover.SpawnVerdict{OutOfProcess: true}},
+		},
+	}
+	declared := []testcover.TestFunc{{Name: "TestFailed"}, {Name: "TestHit"}, {Name: "TestKeep"}, {Name: "TestSpawned"}}
+	noScan := func() (map[string]testcover.SpawnVerdict, error) {
+		return nil, errors.New("the spawn scan ran with no declared test lacking an entry")
+	}
+	tests := []struct {
+		name string
+		// edit changes the row's input from a Current selection of planned at the commit "head", its files unchanged.
+		edit        func(in *testcover.UpkeepInput)
+		wantVerdict testcover.UpkeepVerdict
+		wantChanged bool
+		// wantTests names the planned map's entries, and wantQueue the queued tests.
+		wantTests []string
+		wantQueue []string
+		// check, when set, asserts more of the plan.
+		check func(t *testing.T, plan testcover.UpkeepPlan)
+		// scans lets the row's default spawn scan run, as a dropped test lacks an entry; otherwise it fails the row.
+		scans   bool
+		wantErr bool
+	}{
+		{
+			name: "CurrentMovesTheMapToTheCommitWithEveryEntry",
+			edit: func(*testcover.UpkeepInput) {}, wantVerdict: testcover.UpkeepCurrent, wantChanged: true,
+			wantTests: []string{"TestFailed", "TestHit", "TestKeep", "TestSpawned"},
+			check: func(t *testing.T, plan testcover.UpkeepPlan) {
+				if plan.Map.Commit != "head" || !reflect.DeepEqual(plan.Map.Blocks, planned.Blocks) {
+					t.Errorf("plan map = commit %s, blocks %v; want commit head and the planned blocks", plan.Map.Commit, plan.Map.Blocks)
+				}
+			},
+		},
+		{
+			name: "CurrentAtTheMapsOwnCommitChangesNothing",
+			edit: func(in *testcover.UpkeepInput) { in.Map.Commit = "head" }, wantVerdict: testcover.UpkeepCurrent,
+			wantTests: []string{"TestFailed", "TestHit", "TestKeep", "TestSpawned"},
+		},
+		{
+			name: "AffectedDropsAndQueuesTheAffectedTests",
+			edit: func(in *testcover.UpkeepInput) { in.Selection.Tests = []string{"TestHit"} }, wantVerdict: testcover.UpkeepAffected, wantChanged: true,
+			wantTests: []string{"TestFailed", "TestKeep", "TestSpawned"}, wantQueue: []string{"TestHit"}, scans: true,
+		},
+		{
+			name: "AnOwnFileChangeDropsAndQueuesTheOutcomeEntries",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Tree.Files = map[string]string{"b.go": "b2", "b_test.go": "t1"}
+			},
+			wantVerdict: testcover.UpkeepCurrent, wantChanged: true,
+			wantTests: []string{"TestHit", "TestKeep", "TestSpawned"}, wantQueue: []string{"TestFailed"}, scans: true,
+		},
+		{
+			name: "ARemovedTestDropsItsEntry",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Declared = []testcover.TestFunc{{Name: "TestFailed"}, {Name: "TestHit"}, {Name: "TestSpawned"}}
+			},
+			wantVerdict: testcover.UpkeepCurrent, wantChanged: true,
+			wantTests: []string{"TestFailed", "TestHit", "TestSpawned"},
+		},
+		{
+			name: "AFailureAtAnEarlierCommitIsCleared",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Map.Commit = "head"
+				in.Map.Failure = &testcover.MapFailure{Commit: "older", Error: "the build failed"}
+			},
+			wantVerdict: testcover.UpkeepCurrent, wantChanged: true,
+			wantTests: []string{"TestFailed", "TestHit", "TestKeep", "TestSpawned"},
+			check: func(t *testing.T, plan testcover.UpkeepPlan) {
+				if plan.Map.Failure != nil {
+					t.Errorf("plan map failure = %+v; want it cleared", plan.Map.Failure)
+				}
+			},
+		},
+		{
+			name: "ALinkedChangeKeepsTheOutcomeEntries",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Tree.Linked = map[string]map[string]string{"m/a": {"a.go": "a2"}}
+			},
+			wantVerdict: testcover.UpkeepCurrent, wantChanged: true,
+			wantTests: []string{"TestFailed", "TestHit", "TestKeep", "TestSpawned"},
+		},
+		{
+			name: "ADeclaredTestWithNoEntryIsQueuedUnlessTheSpawnScanMarksIt",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Declared = append(in.Declared, testcover.TestFunc{Name: "TestNew"}, testcover.TestFunc{Name: "TestNewSpawns", Tier: 1, Hash: "fn"})
+				in.Spawns = func() (map[string]testcover.SpawnVerdict, error) {
+					return map[string]testcover.SpawnVerdict{"TestNewSpawns": {Unresolved: true}}, nil
+				}
+			},
+			wantVerdict: testcover.UpkeepCurrent, wantChanged: true,
+			wantTests: []string{"TestFailed", "TestHit", "TestKeep", "TestNewSpawns", "TestSpawned"}, wantQueue: []string{"TestNew"},
+			check: func(t *testing.T, plan testcover.UpkeepPlan) {
+				want := testcover.MapTest{Name: "TestNewSpawns", Tier: 1, FuncHash: "fn", Spawn: testcover.SpawnVerdict{Unresolved: true}, Commit: "head", MeasuredAt: at}
+				if got := plan.Map.Tests[3]; !reflect.DeepEqual(got, want) {
+					t.Errorf("spawn-marked entry = %+v; want %+v", got, want)
+				}
+			},
+		},
+		{
+			name: "ASpawnScanFailureIsTheError",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Declared = append(in.Declared, testcover.TestFunc{Name: "TestNew"})
+				in.Spawns = func() (map[string]testcover.SpawnVerdict, error) { return nil, errors.New("spawn scan failed") }
+			},
+			wantErr: true,
+		},
+		{
+			name: "AMissLeavesTheMapAndQueuesNoTest",
+			edit: func(in *testcover.UpkeepInput) {
+				in.Selection = testcover.Selection{Miss: &testcover.Miss{Reason: testcover.MissNonBody, Detail: "a.go"}}
+				in.Declared = append(in.Declared, testcover.TestFunc{Name: "TestNew"})
+			},
+			wantVerdict: testcover.UpkeepMiss,
+			check: func(t *testing.T, plan testcover.UpkeepPlan) {
+				if plan.Miss == nil || plan.Miss.Reason != testcover.MissNonBody {
+					t.Errorf("plan miss = %v; want the selection's miss", plan.Miss)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			in := testcover.UpkeepInput{
+				Map: planned, Commit: "head", At: at,
+				Tree:     testcover.UpkeepTree{Files: files},
+				Declared: append([]testcover.TestFunc(nil), declared...), Spawns: noScan,
+			}
+			if tt.scans {
+				in.Spawns = func() (map[string]testcover.SpawnVerdict, error) { return nil, nil }
+			}
+			tt.edit(&in)
+			plan, err := testcover.PlanUpkeep(in)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("PlanUpkeep() error = %v; want error %v", err, tt.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			var names []string
+			for _, test := range plan.Map.Tests {
+				names = append(names, test.Name)
+			}
+			if plan.Verdict != tt.wantVerdict || plan.Changed != tt.wantChanged || !reflect.DeepEqual(names, tt.wantTests) || !reflect.DeepEqual(plan.Queue, tt.wantQueue) {
+				t.Errorf("PlanUpkeep() = verdict %s, changed %v, entries %v, queue %v; want %s, %v, %v, %v",
+					plan.Verdict, plan.Changed, names, plan.Queue, tt.wantVerdict, tt.wantChanged, tt.wantTests, tt.wantQueue)
+			}
+			if tt.check != nil {
+				tt.check(t, plan)
+			}
+		})
+	}
+}
diff --git a/pattern/PATTERN-test-speed.md b/pattern/PATTERN-test-speed.md
index 6a2df251..fbec2ade 100644
--- a/pattern/PATTERN-test-speed.md
+++ b/pattern/PATTERN-test-speed.md
@@ -288,7 +288,11 @@ this section keeps only what is project-specific or stricter here.
   A map records, for each tier0 and tier1 test, its function hash, the blocks it covers of its own package's files,
   the functions it covers of each other in-module package its test binary links, and its spawn scan verdict.
   It also records the hashes of the package's files and of each linked package's files at the commit it was built from.
-  It is rebuilt when the package's own Go files change, when it outgrows `test_map_max_age_days` and after a failed build once HEAD moves.
+  Each pass plans every map at the prime's HEAD through the coverage selector, building nothing:
+  a current map moves to HEAD with its entries, an affected one drops the affected tests' entries, which are re-measured,
+  and a miss rebuilds the package whole.
+  A failed build keeps the map's entries and is not retried at the same HEAD.
+  A self-check re-measures a kept entry a fresh build cannot place, and an audit round re-measures the oldest entries.
   The prime's dobby starts the verb every `test_map_every` landings.
 - A gate key whose `reports` lists `redundancy` runs the report step after its tiers and lints.
   It takes the diff's new and changed top-level tests against the merge base with the parent branch,
