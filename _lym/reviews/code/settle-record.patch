+			if !strings.HasPrefix(got, tt.wantPrefix) || !strings.HasSuffix(got, tt.wantSuffix) || strings.Contains(got, "\n") {
+				t.Errorf("verifyGateStuckReason() = %q; want one line opening %q and ending %q", got, tt.wantPrefix, tt.wantSuffix)
+			}
+		})
+	}
