diff --git a/internal/shedadapters/sessionusage.go b/internal/shedadapters/sessionusage.go
new file mode 100644
index 00000000..2997c1c8
--- /dev/null
+++ b/internal/shedadapters/sessionusage.go
@@ -0,0 +1,216 @@
+// sessionusage.go writes a session's usage record under a run's usage directory when the session ends: its tokens split by kind and model, priced from its transcripts when the engine reads them.
+// It also builds the session-end hook that records each session of a run's worktree under the run's current row.
+
+package shedadapters
+
+import (
+	"path"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// modelTally is one model's token counts within a session and the cost of its priced messages.
+// unpriced is true once any of its messages with usage had no known price.
+type modelTally struct {
+	counts   shedrun.ModelUsage
+	costUSD  float64
+	unpriced bool
+}
+
+// RecordSessionUsage writes the usage record of the ended session end into dir, the run's usage directory, under row, the run row that spawned it.
+// With a TranscriptReader in reads it locates the session by end.SessionID, reads it with its forks, adds each message's four counts to its model's total and prices it at its own model through reads.Pricer;
+// a message whose model has no price, or no pricer at all, leaves the cost unknown.
+// The record's model is the one most of the main transcript's messages ran on, and its models list is set only when more than one model ran.
+// With no TranscriptReader, or when locating or reading any transcript fails, the counts come from end.Usage, each unknown when it is not split, and the cost is unknown; a locate or read failure is logged at Warn.
+// A failed write is logged at Warn.
+// It returns nothing and stops nothing.
+func RecordSessionUsage(dir, row string, end shuttleengine.SessionEnd, reads shuttleengine.RecordReads) {
+	record := shedrun.SessionUsageRecord{
+		SessionID: end.SessionID,
+		Row:       row,
+		Role:      end.Role,
+		Model:     end.Model,
+		Engine:    end.Engine,
+		Started:   formatUsageTime(end.StartedAt),
+		Ended:     formatUsageTime(end.EndedAt),
+	}
+	if !fillFromTranscripts(&record, end, reads) {
+		fillFromSessionUsage(&record, end.Usage)
+	}
+	if err := shedrun.WriteSessionUsage(dir, record); err != nil {
+		logger.Warn("shedadapters: write the session usage record failed (non-fatal)", "dir", dir, "sessionID", end.SessionID, "error", err)
+	}
+}
+
+// UsageRecorder returns the session-end hook of the run in l's worktree.
+// Each ended session is recorded into the run's usage directory under the run's current row, read from the run's status file when the session ends and empty when the status is absent or unreadable.
+// A session's transcripts are read with the capabilities readers holds for its engine; an engine with no entry is recorded from the counts shuttle read, its cost unknown.
+func UsageRecorder(l *lymcwd.Location, readers map[string]shuttleengine.RecordReads) func(shuttleengine.SessionEnd) {
+	return func(end shuttleengine.SessionEnd) {
+		RecordSessionUsage(shedrun.UsageDir(l), currentRunRow(l), end, readers[end.Engine])
+	}
+}
+
+// currentRunRow returns the producer the run in l's worktree is at, and "" when its status file is absent or does not read; an unreadable status is logged at Warn.
+func currentRunRow(l *lymcwd.Location) string {
+	status, _, err := state.ReadJSON[shedengine.Status](shedrun.StatusFile(l, shedrun.SelfRunID), shedrun.StatusLock(l, shedrun.SelfRunID))
+	if err != nil {
+		logger.Warn("shedadapters: read the run status for the session usage row failed; recording an empty row", "error", err)
+		return ""
+	}
+	return status.CurrentProducer
+}
+
+// formatUsageTime renders t as RFC 3339 UTC, and "" for the zero time.
+func formatUsageTime(t time.Time) string {
+	if t.IsZero() {
+		return ""
+	}
+	return t.UTC().Format(time.RFC3339)
+}
+
+// fillFromSessionUsage sets record's counts from usage, each nil unless the provider read them split, and leaves the cost unknown.
+func fillFromSessionUsage(record *shedrun.SessionUsageRecord, usage shuttleengine.SessionUsage) {
+	if !usage.SplitKnown {
+		return
+	}
+	record.InputTokens, record.CacheWriteTokens, record.CacheReadTokens, record.OutputTokens = &usage.Input, &usage.CacheWrite, &usage.CacheRead, &usage.Output
+}
+
+// fillFromTranscripts sets record's counts, cost, model and models list from the session's transcripts.
+// It reports false, leaving record untouched, when the engine reads no transcripts, the session cannot be located or read, or no message carries usage.
+func fillFromTranscripts(record *shedrun.SessionUsageRecord, end shuttleengine.SessionEnd, reads shuttleengine.RecordReads) bool {
+	if reads.Transcripts == nil {
+		return false
+	}
+	located, err := reads.Transcripts.LocateSessions(end.Worktree)
+	if err != nil {
+		logger.Warn("shedadapters: locate the session transcripts failed; taking the counts shuttle read", "sessionID", end.SessionID, "worktree", end.Worktree, "error", err)
+		return false
+	}
+	var session shuttleengine.LocatedSession
+	found := false
+	for _, candidate := range located {
+		if candidate.ID == end.SessionID || strings.TrimSuffix(candidate.ID, path.Ext(candidate.ID)) == end.SessionID {
+			session, found = candidate, true
+			break
+		}
+	}
+	if !found {
+		logger.Warn("shedadapters: no transcript found for the session; taking the counts shuttle read", "sessionID", end.SessionID, "worktree", end.Worktree)
+		return false
+	}
+	read, err := reads.Transcripts.ReadSession(session)
+	if err != nil {
+		logger.Warn("shedadapters: read the session transcripts failed; taking the counts shuttle read", "sessionID", end.SessionID, "error", err)
+		return false
+	}
+
+	tallies, mainMessages := tallyTranscripts(read, reads.Pricer)
+	if len(tallies) == 0 {
+		return false
+	}
+	models := make([]string, 0, len(tallies))
+	for model := range tallies {
+		models = append(models, model)
+	}
+	sort.Strings(models)
+
+	var input, cacheWrite, cacheRead, output int64
+	var totalCost float64
+	allPriced := true
+	perModel := make([]shedrun.ModelUsage, 0, len(models))
+	for _, model := range models {
+		tally := tallies[model]
+		input += tally.counts.InputTokens
+		cacheWrite += tally.counts.CacheWriteTokens
+		cacheRead += tally.counts.CacheReadTokens
+		output += tally.counts.OutputTokens
+		entry := tally.counts
+		if tally.unpriced {
+			allPriced = false
+		} else {
+			totalCost += tally.costUSD
+			cost := tally.costUSD
+			entry.CostUSD = &cost
+		}
+		perModel = append(perModel, entry)
+	}
+
+	record.InputTokens, record.CacheWriteTokens, record.CacheReadTokens, record.OutputTokens = &input, &cacheWrite, &cacheRead, &output
+	if allPriced {
+		record.CostUSD = &totalCost
+	}
+	if len(perModel) > 1 {
+		record.Models = perModel
+	}
+	if model, ok := dominantModel(mainMessages); ok {
+		record.Model = model
+	}
+	return true
+}
+
+// tallyTranscripts sums the usage of every message of read, forks included, by model, pricing each message at its own model.
+// A message with no tokens costs nothing whatever its model.
+// mainMessages counts the main transcript's messages carrying usage by model.
+func tallyTranscripts(read shuttleengine.SessionRead, pricer shuttleengine.MessagePricer) (tallies map[string]*modelTally, mainMessages map[string]int) {
+	tallies = map[string]*modelTally{}
+	mainMessages = map[string]int{}
+	add := func(transcript shuttleengine.TranscriptRead, isMain bool) {
+		for _, entry := range transcript.Entries {
+			if entry.Usage == nil {
+				continue
+			}
+			tally := tallies[entry.Model]
+			if tally == nil {
+				tally = &modelTally{counts: shedrun.ModelUsage{Model: entry.Model}}
+				tallies[entry.Model] = tally
+			}
+			usage := *entry.Usage
+			tally.counts.InputTokens += int64(usage.Input)
+			tally.counts.CacheWriteTokens += int64(usage.CacheWrite)
+			tally.counts.CacheReadTokens += int64(usage.CacheRead)
+			tally.counts.OutputTokens += int64(usage.Output)
+			if isMain {
+				mainMessages[entry.Model]++
+			}
+			if usage.Input+usage.CacheWrite+usage.CacheRead+usage.Output == 0 {
+				continue
+			}
+			if pricer == nil {
+				tally.unpriced = true
+				continue
+			}
+			usd, priced := pricer.PriceMessage(entry.Model, usage)
+			if !priced {
+				tally.unpriced = true
+				continue
+			}
+			tally.costUSD += usd
+		}
+	}
+	add(read.Main, true)
+	for _, fork := range read.Forks {
+		add(fork, false)
+	}
+	return tallies, mainMessages
+}
+
+// dominantModel returns the model with the most messages, the first by name among equals, and false when counts is empty.
+func dominantModel(counts map[string]int) (string, bool) {
+	best, bestCount := "", 0
+	for model, count := range counts {
+		if count > bestCount || (count == bestCount && model < best) {
+			best, bestCount = model, count
+		}
+	}
+	return best, bestCount > 0
+}
diff --git a/internal/shedadapters/sessionusage_test.go b/internal/shedadapters/sessionusage_test.go
new file mode 100644
index 00000000..4be25a4c
--- /dev/null
+++ b/internal/shedadapters/sessionusage_test.go
@@ -0,0 +1,226 @@
+// sessionusage_test.go covers the session usage writer against a fake transcript reader and a fake pricer.
+
+package shedadapters
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/testkit/logcapture"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// fakeTranscripts is a TranscriptReader over one located session, with scripted failures.
+type fakeTranscripts struct {
+	located   []shuttleengine.LocatedSession
+	locateErr error
+	session   shuttleengine.SessionRead
+	readErr   error
+}
+
+func (f fakeTranscripts) LocateSessions(string) ([]shuttleengine.LocatedSession, error) {
+	return f.located, f.locateErr
+}
+
+func (f fakeTranscripts) ReadSession(shuttleengine.LocatedSession) (shuttleengine.SessionRead, error) {
+	return f.session, f.readErr
+}
+
+// fakePricer prices a message at a per-token rate by model, and has no price for a model not in the map.
+type fakePricer map[string]float64
+
+func (p fakePricer) PriceMessage(model string, usage shuttleengine.MessageUsage) (float64, bool) {
+	rate, ok := p[model]
+	return float64(usage.Input+usage.CacheWrite+usage.CacheRead+usage.Output) * rate, ok
+}
+
+// assistantMessage returns an assistant entry of model carrying the given counts.
+func assistantMessage(model string, input, cacheWrite, cacheRead, output int) shuttleengine.TranscriptEntry {
+	return shuttleengine.TranscriptEntry{
+		Role: shuttleengine.EntryAssistant, Model: model,
+		Usage: &shuttleengine.MessageUsage{Input: input, CacheWrite: cacheWrite, CacheRead: cacheRead, Output: output},
+	}
+}
+
+// TestRecordSessionUsage pins the writer: counts summed per model and priced per message, the models list only for several models, the fallback to the counts shuttle read when a transcript cannot be had, and a write failure that is logged and stops nothing.
+// It runs serially because it captures the process-global logger output.
+func TestRecordSessionUsage(t *testing.T) {
+	tiergate.Require(t, 0)
+
+	int64Ptr := func(n int64) *int64 { return &n }
+	floatPtr := func(f float64) *float64 { return &f }
+	started := time.Date(2026, 11, 5, 9, 0, 0, 0, time.UTC)
+	end := shuttleengine.SessionEnd{
+		SessionID: "sess-1", Engine: "claude", Role: "implementer", Model: "opus", Worktree: "/wt",
+		StartedAt: started, EndedAt: started.Add(5 * time.Minute), Outcome: shuttleengine.OutcomeDone,
+		Usage: shuttleengine.SessionUsage{Known: true, SplitKnown: true, Input: 7, CacheWrite: 1, CacheRead: 70, Output: 3},
+	}
+	located := []shuttleengine.LocatedSession{{TranscriptRef: shuttleengine.TranscriptRef{ID: "other.jsonl"}}, {TranscriptRef: shuttleengine.TranscriptRef{ID: "sess-1.jsonl"}}}
+	prices := fakePricer{"m1": 1, "m2": 2}
+	base := shedrun.SessionUsageRecord{
+		SessionID: "sess-1", Row: "Implement", Role: "implementer", Model: "opus", Engine: "claude",
+		Started: "2026-11-05T09:00:00Z", Ended: "2026-11-05T09:05:00Z",
+	}
+	shuttleReading := func(r shedrun.SessionUsageRecord) shedrun.SessionUsageRecord {
+		r.InputTokens, r.CacheWriteTokens, r.CacheReadTokens, r.OutputTokens = int64Ptr(7), int64Ptr(1), int64Ptr(70), int64Ptr(3)
+		return r
+	}
+	mainOnly := shuttleengine.SessionRead{Main: shuttleengine.TranscriptRead{Entries: []shuttleengine.TranscriptEntry{
+		{Role: shuttleengine.EntryUser},
+		assistantMessage("m1", 10, 0, 100, 5),
+		assistantMessage("m1", 20, 0, 200, 7),
+	}}}
+	withFork := shuttleengine.SessionRead{
+		Main:  shuttleengine.TranscriptRead{Entries: []shuttleengine.TranscriptEntry{assistantMessage("m1", 10, 0, 100, 5)}},
+		Forks: []shuttleengine.TranscriptRead{{Entries: []shuttleengine.TranscriptEntry{assistantMessage("m2", 4, 0, 40, 1)}}},
+	}
+	unpriced := shuttleengine.SessionRead{Main: shuttleengine.TranscriptRead{Entries: []shuttleengine.TranscriptEntry{assistantMessage("m3", 10, 0, 100, 5)}}}
+
+	priced := base
+	priced.Model = "m1"
+	priced.InputTokens, priced.CacheWriteTokens, priced.CacheReadTokens, priced.OutputTokens = int64Ptr(30), int64Ptr(0), int64Ptr(300), int64Ptr(12)
+	priced.CostUSD = floatPtr(342)
+
+	forked := base
+	forked.Model = "m1"
+	forked.InputTokens, forked.CacheWriteTokens, forked.CacheReadTokens, forked.OutputTokens = int64Ptr(14), int64Ptr(0), int64Ptr(140), int64Ptr(6)
+	forked.CostUSD = floatPtr(205)
+	forked.Models = []shedrun.ModelUsage{
+		{Model: "m1", InputTokens: 10, CacheReadTokens: 100, OutputTokens: 5, CostUSD: floatPtr(115)},
+		{Model: "m2", InputTokens: 4, CacheReadTokens: 40, OutputTokens: 1, CostUSD: floatPtr(90)},
+	}
+
+	costUnknown := base
+	costUnknown.Model = "m3"
+	costUnknown.InputTokens, costUnknown.CacheWriteTokens, costUnknown.CacheReadTokens, costUnknown.OutputTokens = int64Ptr(10), int64Ptr(0), int64Ptr(100), int64Ptr(5)
+
+	tests := []struct {
+		name     string
+		reads    shuttleengine.RecordReads
+		end      shuttleengine.SessionEnd
+		want     shedrun.SessionUsageRecord
+		wantWarn string
+	}{
+		{name: "OneModelPricedPerMessage", reads: shuttleengine.RecordReads{Transcripts: fakeTranscripts{located: located, session: mainOnly}, Pricer: prices}, end: end, want: priced},
+		{name: "ForkOnAnotherModelPricedAtItsOwn", reads: shuttleengine.RecordReads{Transcripts: fakeTranscripts{located: located, session: withFork}, Pricer: prices}, end: end, want: forked},
+		{name: "UnpricedModelLeavesCostUnknown", reads: shuttleengine.RecordReads{Transcripts: fakeTranscripts{located: located, session: unpriced}, Pricer: prices}, end: end, want: costUnknown},
+		{name: "NoPricerLeavesCostUnknown", reads: shuttleengine.RecordReads{Transcripts: fakeTranscripts{located: located, session: unpriced}}, end: end, want: costUnknown},
+		{name: "NoTranscriptReaderTakesShuttleCounts", end: end, want: shuttleReading(base)},
+		{name: "NoTranscriptReaderAndUnsplitUsageLeavesCountsUnknown", end: shuttleengine.SessionEnd{SessionID: "sess-1", Engine: "claude", Role: "implementer", Model: "opus", StartedAt: started, EndedAt: started.Add(5 * time.Minute), Usage: shuttleengine.SessionUsage{Known: true}}, want: base},
