+	hookScript := "#!/bin/sh\nprintf '%s %s\\n' \"$(pwd -P)\" \"$*\" > \"$HOOK_ARGV\"\ncat > \"$HOOK_STDIN\"\necho hook-output\necho hook-error >&2\nexit \"$HOOK_EXIT\"\n"
+	if err := os.WriteFile(hookPath, []byte(hookScript), 0o755); err != nil {
+		t.Fatal(err)
