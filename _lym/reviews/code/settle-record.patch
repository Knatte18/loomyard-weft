diff --git a/internal/claudeimports/claudeimports.go b/internal/claudeimports/claudeimports.go
new file mode 100644
index 00000000..e5e2f037
--- /dev/null
+++ b/internal/claudeimports/claudeimports.go
@@ -0,0 +1,187 @@
+// claudeimports.go implements Expand, the expansion of a Claude instruction file's `@` imports.
+
+package claudeimports
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// maxImportHops is the deepest import chain Claude Code follows below the file named by the caller.
+const maxImportHops = 5
+
+// Expanded is a Claude instruction file with its imports expanded.
+type Expanded struct {
+	// Text is the file's text with each import replaced by the expanded text of the file it names.
+	Text string
+	// Files lists the absolute, cleaned path of every file an import resolved to, in the order first met, each once.
+	Files []string
+}
+
+// Expand reads the file at path and expands its `@` imports.
+// A relative import resolves against the directory of the importing file and `~/` against the user's home directory.
+// An import stays as written when it sits inside an inline code span or a fenced code block.
+// It also stays as written when its target is not a readable regular file.
+// It also stays as written when it lies past the fifth hop or names a file already on the current import chain.
+// It returns the read error of path itself.
+func Expand(path string) (Expanded, error) {
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return Expanded{}, err
+	}
+	data, err := os.ReadFile(absolute)
+	if err != nil {
+		return Expanded{}, err
+	}
+	expander := &expander{seen: map[string]bool{}}
+	text := expander.expandText(string(data), absolute, []string{absolute})
+	return Expanded{Text: text, Files: expander.files}, nil
+}
+
+// expander carries the files met so far across one Expand call.
+type expander struct {
+	files []string
+	seen  map[string]bool
+}
+
+// expandText expands the imports of text, the content of the file at filePath.
+// chain holds the files from the root down to filePath; its length minus one is filePath's hop depth.
+func (e *expander) expandText(text, filePath string, chain []string) string {
+	var out strings.Builder
+	var fence string
+	for _, line := range strings.SplitAfter(text, "\n") {
+		marker := fenceMarker(line)
+		switch {
+		case fence != "":
+			out.WriteString(line)
+			if marker != "" && marker[0] == fence[0] && len(marker) >= len(fence) {
+				fence = ""
+			}
+		case marker != "":
+			fence = marker
+			out.WriteString(line)
+		default:
+			out.WriteString(e.expandLine(line, filePath, chain))
+		}
+	}
+	return out.String()
+}
+
+// fenceMarker returns the run of three or more backticks or tildes that opens line after at most three spaces, or "".
+func fenceMarker(line string) string {
+	trimmed := strings.TrimLeft(line, " ")
+	if len(line)-len(trimmed) > 3 || trimmed == "" {
+		return ""
+	}
+	fenceChar := trimmed[0]
+	if fenceChar != '`' && fenceChar != '~' {
+		return ""
+	}
+	run := 0
+	for run < len(trimmed) && trimmed[run] == fenceChar {
+		run++
+	}
+	if run < 3 {
+		return ""
+	}
+	return trimmed[:run]
+}
+
+// expandLine expands the imports of one line outside a fenced block, leaving inline code spans untouched.
+func (e *expander) expandLine(line, filePath string, chain []string) string {
+	var out strings.Builder
+	for i := 0; i < len(line); {
+		switch {
+		case line[i] == '`':
+			end := codeSpanEnd(line, i)
+			out.WriteString(line[i:end])
+			i = end
+		case line[i] == '@' && (i == 0 || isSpace(line[i-1])):
+			end := i + 1
+			for end < len(line) && !isSpace(line[end]) {
+				end++
+			}
+			out.WriteString(e.importText(line[i:end], filePath, chain))
+			i = end
+		default:
+			out.WriteByte(line[i])
+			i++
+		}
+	}
+	return out.String()
+}
+
+// codeSpanEnd returns the index just past the inline code span opening at start.
+// A backtick run with no closing run of the same length is literal, so only the run itself is skipped.
+func codeSpanEnd(line string, start int) int {
+	runEnd := start
+	for runEnd < len(line) && line[runEnd] == '`' {
+		runEnd++
+	}
+	opening := runEnd - start
+	for i := runEnd; i < len(line); {
+		if line[i] != '`' {
+			i++
+			continue
+		}
+		closeEnd := i
+		for closeEnd < len(line) && line[closeEnd] == '`' {
+			closeEnd++
+		}
+		if closeEnd-i == opening {
+			return closeEnd
+		}
+		i = closeEnd
+	}
+	return runEnd
+}
+
+// importText returns the expanded text of the file the token (an `@` and its path) names.
+// It returns the token itself when it names no readable regular file, passes the last hop or closes an import cycle.
+func (e *expander) importText(token, filePath string, chain []string) string {
+	target, ok := resolveImport(token[1:], filepath.Dir(filePath))
+	if !ok || len(chain)-1 >= maxImportHops {
+		return token
+	}
+	for _, onChain := range chain {
+		if onChain == target {
+			return token
+		}
+	}
+	info, err := os.Stat(target)
+	if err != nil || !info.Mode().IsRegular() {
+		return token
+	}
+	data, err := os.ReadFile(target)
+	if err != nil {
+		return token
+	}
+	if !e.seen[target] {
+		e.seen[target] = true
+		e.files = append(e.files, target)
+	}
+	return e.expandText(string(data), target, append(chain[:len(chain):len(chain)], target))
+}
+
+// resolveImport returns the absolute, cleaned path an import's path names, relative to importerDir.
+func resolveImport(importPath, importerDir string) (string, bool) {
+	switch {
+	case importPath == "":
+		return "", false
+	case strings.HasPrefix(importPath, "~/"):
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return "", false
+		}
+		return filepath.Join(home, importPath[2:]), true
+	case filepath.IsAbs(importPath):
+		return filepath.Clean(importPath), true
+	default:
+		return filepath.Join(importerDir, importPath), true
+	}
+}
+
+func isSpace(b byte) bool {
+	return b == ' ' || b == '\t' || b == '\n' || b == '\r'
+}
diff --git a/internal/claudeimports/claudeimports_test.go b/internal/claudeimports/claudeimports_test.go
new file mode 100644
index 00000000..e4424753
--- /dev/null
+++ b/internal/claudeimports/claudeimports_test.go
@@ -0,0 +1,184 @@
+// claudeimports_test.go pins Expand's import rule: what expands, what stays as written and what it reports.
+
+package claudeimports_test
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/claudeimports"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestExpand does not call t.Parallel: its `~/` row sets the home directory with t.Setenv.
+// t.Setenv panics under a parallel ancestor, so only the other rows run as parallel subtests.
+func TestExpand(t *testing.T) {
+	tiergate.Require(t, 0)
+
+	tests := []struct {
+		name string
+		// files maps a slash-separated path under the temp directory to its content.
+		files map[string]string
+		// dirs lists directories created under the temp directory.
+		dirs []string
+		// entry is the file Expand reads, relative to the temp directory.
+		entry string
+		// homeIsTempDir points the user's home directory at the temp directory.
+		homeIsTempDir bool
+		wantText      string
+		// wantFiles are the expected Files, relative to the temp directory.
+		wantFiles []string
+		// wantReadError expects Expand to fail with a read error other than fs.ErrNotExist.
+		wantReadError bool
+	}{
+		{
+			name:      "RelativeImportExpands",
+			files:     map[string]string{"CLAUDE.md": "top @docs/rules.md end", "docs/rules.md": "RULES"},
+			entry:     "CLAUDE.md",
+			wantText:  "top RULES end",
+			wantFiles: []string{"docs/rules.md"},
+		},
+		{
+			name: "NestedImportResolvesAgainstItsOwnDirectory",
+			files: map[string]string{
+				"CLAUDE.md": "@sub/b.md",
+				"sub/b.md":  "b @c.md",
+				"sub/c.md":  "C",
+				"c.md":      "WRONG",
+			},
+			entry:     "CLAUDE.md",
+			wantText:  "b C",
+			wantFiles: []string{"sub/b.md", "sub/c.md"},
+		},
+		{
+			name:      "ImportInCodeSpanStaysAsWritten",
+			files:     map[string]string{"CLAUDE.md": "use `@x.md` and ``@x.md`` here", "x.md": "X"},
+			entry:     "CLAUDE.md",
+			wantText:  "use `@x.md` and ``@x.md`` here",
+			wantFiles: nil,
+		},
+		{
+			name:      "ImportInFencedBlockStaysAsWritten",
+			files:     map[string]string{"CLAUDE.md": "```\n@x.md\n```\n@x.md\n", "x.md": "X"},
+			entry:     "CLAUDE.md",
+			wantText:  "```\n@x.md\n```\nX\n",
+			wantFiles: []string{"x.md"},
+		},
+		{
+			name:      "MidWordAtSignIsNoImport",
+			files:     map[string]string{"CLAUDE.md": "mail me@x.md", "x.md": "X"},
+			entry:     "CLAUDE.md",
+			wantText:  "mail me@x.md",
+			wantFiles: nil,
+		},
+		{
+			name:      "ImportOfMissingFileStaysAsWritten",
+			files:     map[string]string{"CLAUDE.md": "see @missing.md"},
+			entry:     "CLAUDE.md",
+			wantText:  "see @missing.md",
+			wantFiles: nil,
+		},
+		{
+			name:      "ImportOfDirectoryStaysAsWritten",
+			files:     map[string]string{"CLAUDE.md": "see @docs"},
+			dirs:      []string{"docs"},
+			entry:     "CLAUDE.md",
+			wantText:  "see @docs",
+			wantFiles: nil,
+		},
+		{
+			name: "ChainStopsAfterTheFifthHop",
+			files: map[string]string{
+				"f0.md": "0 @f1.md",
+				"f1.md": "1 @f2.md",
+				"f2.md": "2 @f3.md",
+				"f3.md": "3 @f4.md",
+				"f4.md": "4 @f5.md",
+				"f5.md": "5 @f6.md",
+				"f6.md": "6",
+			},
+			entry:     "f0.md",
+			wantText:  "0 1 2 3 4 5 @f6.md",
+			wantFiles: []string{"f1.md", "f2.md", "f3.md", "f4.md", "f5.md"},
+		},
+		{
+			name:      "CycleStopsAtTheRepeatedFile",
+			files:     map[string]string{"a.md": "a @b.md", "b.md": "b @a.md"},
+			entry:     "a.md",
+			wantText:  "a b @a.md",
+			wantFiles: []string{"b.md"},
+		},
+		{
+			name:      "FileImportedTwiceIsListedOnce",
+			files:     map[string]string{"a.md": "@x.md @x.md", "x.md": "X"},
+			entry:     "a.md",
+			wantText:  "X X",
+			wantFiles: []string{"x.md"},
+		},
+		{
+			name:          "HomeImportResolvesUnderTheHomeDirectory",
+			files:         map[string]string{"CLAUDE.md": "@~/notes.md", "notes.md": "NOTES"},
+			entry:         "CLAUDE.md",
+			homeIsTempDir: true,
+			wantText:      "NOTES",
+			wantFiles:     []string{"notes.md"},
+		},
+		{
+			// A directory at the path fails os.ReadFile for every user, root included, so the row never skips.
+			name:          "UnreadableEntryReturnsAnError",
+			dirs:          []string{"CLAUDE.md"},
+			entry:         "CLAUDE.md",
+			wantReadError: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if tt.homeIsTempDir {
+				t.Setenv("HOME", dir)
+				t.Setenv("USERPROFILE", dir)
+			} else {
+				t.Parallel()
+			}
+			for _, subdir := range tt.dirs {
+				if err := os.MkdirAll(filepath.Join(dir, subdir), 0o755); err != nil {
+					t.Fatalf("MkdirAll(%q) = %v", subdir, err)
+				}
+			}
+			for name, content := range tt.files {
+				path := filepath.Join(dir, filepath.FromSlash(name))
+				if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+					t.Fatalf("MkdirAll(%q) = %v", filepath.Dir(path), err)
+				}
+				if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+					t.Fatalf("WriteFile(%q) = %v", path, err)
+				}
+			}
+
+			got, err := claudeimports.Expand(filepath.Join(dir, filepath.FromSlash(tt.entry)))
+			if tt.wantReadError {
+				if err == nil || errors.Is(err, fs.ErrNotExist) {
+					t.Fatalf("Expand(%q) error = %v; want a read error other than fs.ErrNotExist", tt.entry, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Expand(%q) error = %v; want nil", tt.entry, err)
+			}
+			if got.Text != tt.wantText {
+				t.Errorf("Expand(%q).Text = %q; want %q", tt.entry, got.Text, tt.wantText)
+			}
+			var wantFiles []string
+			for _, name := range tt.wantFiles {
+				wantFiles = append(wantFiles, filepath.Join(dir, filepath.FromSlash(name)))
+			}
+			if !reflect.DeepEqual(got.Files, wantFiles) {
+				t.Errorf("Expand(%q).Files = %v; want %v", tt.entry, got.Files, wantFiles)
+			}
+		})
+	}
+}
