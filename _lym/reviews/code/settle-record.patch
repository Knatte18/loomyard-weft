+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestNewDeps_ConditionsStopOnAHandOverMarkOrARefusedPush(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	tests := []struct {
+		name  string
+		block func(t *testing.T, h *hubforge.Hub, pair *lymcwd.Location)
+		want  bool
+	}{
+		{"NothingStandingHolds", func(*testing.T, *hubforge.Hub, *lymcwd.Location) {}, true},
+		{"HandOverMarkOfTheRunStops", func(t *testing.T, h *hubforge.Hub, _ *lymcwd.Location) {
+			mark := fabricengine.HandOverMark{Machine: "oslo", At: "2026-11-15T09:00:00Z", Written: time.Now()}
+			if err := fabricengine.WriteHandOverMark(h.Path, "task1", mark); err != nil {
+				t.Fatalf("write the hand-over mark: %v", err)
+			}
+		}, false},
+		{"RefusedPushOfTheRecordsBranchStops", func(t *testing.T, h *hubforge.Hub, pair *lymcwd.Location) {
+			hook := filepath.Join(h.RecordsBare, "hooks", "pre-receive")
+			if err := os.MkdirAll(filepath.Dir(hook), 0o755); err != nil {
+				t.Fatalf("create the hooks directory: %v", err)
+			}
+			if err := os.WriteFile(hook, []byte("#!/bin/sh\necho 'declined' >&2\nexit 1\n"), 0o755); err != nil {
+				t.Fatalf("write the hook: %v", err)
+			}
+			gitkit.CommitFile(t, h.PairRecordsSibling("task1"), "local.txt", "local\n", "local")
+			options := fabricengine.SyncOptions{BackoffSleep: func(time.Duration) {}}
+			if _, err := fabricengine.PushPairAnchored(pair, options, fabricengine.PairPush{LockWait: fabricengine.LockWaitUnbounded}); err == nil {
+				t.Fatal("PushPairAnchored() against a refusing remote = nil; want the refusal")
+			}
+		}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+			hubforge.AddPair(t, h, "task1")
+			pair, err := lymcwd.ResolveWorktree(h.PairCodeWorktree("task1"))
+			if err != nil {
+				t.Fatalf("ResolveWorktree(task1) = %v; want nil", err)
+			}
+			tt.block(t, h, pair)
+			deps := NewDeps(Target{Location: pair, Slug: "task1", Pair: true})
+
+			got, err := deps.Conditions()
+
+			if err != nil || got != tt.want {
+				t.Errorf("Conditions() = %v, %v; want %v, nil", got, err, tt.want)
+			}
+			if deps.PauseCovers == nil {
+				t.Errorf("PauseCovers = nil for a pair; want the pause read")
+			}
+			if prime := NewDeps(Target{Location: h.Location}); prime.PauseCovers != nil {
+				t.Errorf("PauseCovers set for the prime; want nil")
+			}
+		})
+	}
+}
diff --git a/internal/runpusher/pushuntillanded.go b/internal/runpusher/pushuntillanded.go
new file mode 100644
index 000000000..1f4c63b2e
--- /dev/null
+++ b/internal/runpusher/pushuntillanded.go
@@ -0,0 +1,40 @@
+// pushuntillanded.go retries an owed push without end, backing off while the push stays owed.
+
+package runpusher
+
+import (
+	"context"
+	"time"
+)
+
+const (
+	// owedRetryInitial is the wait before the first retry of an owed push.
+	owedRetryInitial = time.Second
+	// owedRetryCeiling is the longest wait between two retries of an owed push.
+	owedRetryCeiling = time.Minute
+)
+
+// PushUntilLanded runs push until it lands or fails with an error owed does not read as owed, and returns that result.
+// A push owed is retried without end, after sleeping from one second and doubling to a minute.
+// The first time the wait reaches a minute it calls atCeiling with the last error, and not again in this call.
+// A cancelled ctx ends the wait with the context's error.
+// The caller holds no lock but its own while the wait runs, since a push releases the locks it takes on return.
+func PushUntilLanded(ctx context.Context, push func() error, owed func(error) bool, sleep func(time.Duration), atCeiling func(error)) error {
+	wait := owedRetryInitial
+	notified := false
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		err := push()
+		if err == nil || !owed(err) {
+			return err
+		}
+		if wait >= owedRetryCeiling && !notified {
+			notified = true
+			atCeiling(err)
+		}
+		sleep(wait)
+		wait = min(wait*2, owedRetryCeiling)
+	}
+}
diff --git a/internal/runpusher/run.go b/internal/runpusher/run.go
new file mode 100644
index 000000000..d741ca261
--- /dev/null
+++ b/internal/runpusher/run.go
@@ -0,0 +1,224 @@
+// run.go is the pusher's body: it takes the worktree's pusher lock and pushes until the worktree is level with origin.
+
+package runpusher
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// repushInterval is the shortest time between two pushes of one pass.
+const repushInterval = time.Second
+
+// errPauseCovers ends an attempt before the guard and the push, since a pause covers the run.
+var errPauseCovers = errors.New("runpusher: a pause covers the run")
+
+// stopError wraps the failure of a read or the guard that ends the pusher, so no retry treats it as an owed push.
+type stopError struct {
+	cause error
+}
+
+// Error returns the wrapped failure's message.
+func (e *stopError) Error() string { return e.cause.Error() }
+
+// Unwrap returns the wrapped failure.
+func (e *stopError) Unwrap() error { return e.cause }
+
+// Deps holds the seams Run drives, so a test drives its pass with fakes.
+type Deps struct {
+	// Lock tries the pusher lock without waiting.
+	// It reports acquired false when another pusher holds it, and release frees a lock it took.
+	Lock func() (release func(), acquired bool, err error)
+	// Ahead reports whether the worktree holds commits origin lacks.
+	Ahead func() (bool, error)
+	// Conditions reports whether the start conditions but the lock still hold.
+	Conditions func() (bool, error)
+	// PauseCovers reports whether a pause covers the run, and is nil for the prime.
+	PauseCovers func() (bool, error)
+	// Guard runs before each push and stops the pusher with an error, and is nil for the prime.
+	Guard func() error
+	// Push pushes the worktree once.
+	Push func() error
+	// WorktreeGone reports whether the worktree no longer exists.
+	WorktreeGone func() (bool, error)
+	// Owed reports whether a failed push is owed, so the pusher retries it.
+	Owed func(err error) bool
+	// Notify posts one line about a push that stays owed.
+	Notify func(line string) error
+	// Sleep waits between the retries of an owed push and between two pushes of one pass.
+	Sleep func(time.Duration)
+}
+
+// NewDeps fills every seam of t that reads the worktree, the hub or the clock.
+// A pair gets the pause read, and the prime none.
+// The caller fills Push, Guard and Notify.
+func NewDeps(t Target) Deps {
+	deps := Deps{
+		Lock:  func() (func(), bool, error) { return tryLock(LockPath(t)) },
+		Ahead: func() (bool, error) { return fabricengine.RunCommitsAhead(t.Location) },
+		Conditions: func() (bool, error) {
+			stands, err := fabricengine.RefusedPushStands(t.Location)
+			if err != nil || stands {
+				return false, err
+			}
+			if !t.Pair {
+				return true, nil
+			}
+			marked, err := handedOver(t)
+			return !marked, err
+		},
+		WorktreeGone: func() (bool, error) { return worktreeGone(t) },
+		Owed:         fabricengine.IsPushOwed,
+		Sleep:        time.Sleep,
+	}
+	if t.Pair {
+		deps.PauseCovers = func() (bool, error) { return pauseCovers(t) }
+	}
+	return deps
+}
+
+// Run is the pusher of t: it pushes the worktree's commits to origin in order, and returns once it is level or must stop.
+// It takes the pusher lock and returns at once when another pusher holds it.
+// Each push attempt reads the pause first, then runs the guard, then pushes.
+// A pause covering the run ends the pusher before the guard and the push.
+// A guard stop returns its error, pushing nothing.
+// A failure deps.Owed does not read as owed returns, a refused push and a hand-over among them.
+// An owed push is retried through PushUntilLanded, and one notice goes out once the retry wait reaches a minute.
+// Once level it releases the lock and reads again.
+// A commit made while it exits is pushed by it or by that commit's pusher.
+func Run(ctx context.Context, t Target, deps Deps) error {
+	release, acquired, err := deps.Lock()
+	if err != nil {
+		return err
+	}
+	if !acquired {
+		return nil
+	}
+	for {
+		stopped, err := pushUntilLevel(ctx, t, deps)
+		release()
+		if stopped || err != nil {
+			return err
+		}
+		more, err := workRemains(deps)
+		if err != nil || !more {
+			return err
+		}
+		release, acquired, err = deps.Lock()
+		if err != nil {
+			return err
+		}
+		if !acquired {
+			return nil
+		}
+	}
+}
+
+// pushUntilLevel pushes while the worktree is ahead and the conditions hold.
+// It reports stopped when a condition, the pause or the guard ended the pass, and the failure of a push or a read as err.
+func pushUntilLevel(ctx context.Context, t Target, deps Deps) (stopped bool, err error) {
+	for first := true; ; first = false {
+		proceed, err := canPush(deps)
+		if err != nil {
+			return false, err
+		}
+		if !proceed {
+			return true, nil
+		}
+		ahead, err := deps.Ahead()
+		if err != nil {
+			return false, err
+		}
+		if !ahead {
+			return false, nil
+		}
+		if !first {
+			deps.Sleep(repushInterval)
+		}
+		err = PushUntilLanded(ctx, attemptOf(deps), ownedOutsideStops(deps), deps.Sleep, noticeOf(t, deps))
+		var stop *stopError
+		switch {
+		case errors.Is(err, errPauseCovers):
+			return true, nil
+		case errors.As(err, &stop):
+			return true, stop.cause
+		case err != nil:
+			return true, err
+		}
+	}
+}
+
+// workRemains reports whether the worktree still has a push to make.
+func workRemains(deps Deps) (bool, error) {
+	proceed, err := canPush(deps)
+	if err != nil || !proceed {
+		return false, err
+	}
+	return deps.Ahead()
+}
+
+// canPush reports whether the worktree exists and the start conditions but the lock hold.
+func canPush(deps Deps) (bool, error) {
+	gone, err := deps.WorktreeGone()
+	if err != nil || gone {
+		return false, err
+	}
+	return deps.Conditions()
+}
+
+// attemptOf returns one push attempt: the pause read, then the guard, then the push.
+func attemptOf(deps Deps) func() error {
+	return func() error {
+		if deps.PauseCovers != nil {
+			covered, err := deps.PauseCovers()
+			if err != nil {
+				return &stopError{cause: err}
+			}
+			if covered {
+				return errPauseCovers
+			}
+		}
+		if deps.Guard != nil {
+			if err := deps.Guard(); err != nil {
+				return &stopError{cause: err}
+			}
+		}
+		return deps.Push()
+	}
+}
+
+// ownedOutsideStops returns the owed test of a push attempt: a stop is never owed.
+func ownedOutsideStops(deps Deps) func(error) bool {
+	return func(err error) bool {
+		var stop *stopError
+		if errors.Is(err, errPauseCovers) || errors.As(err, &stop) {
+			return false
+		}
+		return deps.Owed(err)
+	}
+}
+
+// noticeOf returns the call that posts one notice naming the worktree and the error its pushes keep failing with.
+func noticeOf(t Target, deps Deps) func(error) {
+	return func(pushErr error) {
+		line := fmt.Sprintf("the pusher of %s keeps failing to push, and retries every minute: %v", t.Location.WorktreePath(), pushErr)
+		if err := deps.Notify(line); err != nil {
+			logger.Warn("runpusher: the owed-push notice was not posted", "worktree", t.Location.WorktreePath(), "error", err)
+		}
+	}
+}
+
+// worktreeGone reports whether the worktree of t no longer exists.
+func worktreeGone(t Target) (bool, error) {
+	_, err := os.Stat(t.Location.WorktreePath())
+	if os.IsNotExist(err) {
+		return true, nil
+	}
+	return false, err
+}
diff --git a/internal/runpusher/run_test.go b/internal/runpusher/run_test.go
new file mode 100644
index 000000000..41270a9e3
--- /dev/null
+++ b/internal/runpusher/run_test.go
@@ -0,0 +1,231 @@
+// run_test.go drives the pusher's body over fake seams, a recording sleep and a context the test controls.
+
+package runpusher_test
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/runpusher"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+var (
+	errOwed       = errors.New("push owed")
+	errRefused    = errors.New("push refused")
+	errHandedOver = errors.New("run handed over")
+	errGuardStop  = errors.New("guard stop")
+	errReadFailed = errors.New("read failed")
+)
+
+// runFake answers each seam from a queue, and records what Run did.
+// A queue that runs out answers its default: false for the reads of work, true for the conditions and a free lock.
+type runFake struct {
+	ahead       []bool
+	conditions  []bool
+	gone        []bool
+	paused      []bool
+	lockResults []bool
+	pushErrs    []error
+	aheadErr    error
+	condErr     error
+	lockErr     error
+	guardErr    error
+	// onSleep runs at every sleep, and lets a row cancel the context during a backoff.
+	onSleep func()
+
+	pushes     int
+	guardCalls int
+	locksTaken int
+	locksFreed int
+	sleeps     []time.Duration
+	notices    []string
+}
+
+// pop returns the head of queue and shortens it, or fallback when it is empty.
+func pop(queue *[]bool, fallback bool) bool {
+	if len(*queue) == 0 {
+		return fallback
+	}
+	head := (*queue)[0]
+	*queue = (*queue)[1:]
+	return head
+}
+
+// deps builds the seams over the fake, with the pair's pause and guard seams only when pair is set.
+func (f *runFake) deps(pair bool) runpusher.Deps {
+	deps := runpusher.Deps{
+		Lock: func() (func(), bool, error) {
+			if f.lockErr != nil {
+				return nil, false, f.lockErr
+			}
+			if !pop(&f.lockResults, true) {
+				return nil, false, nil
+			}
+			f.locksTaken++
+			return func() { f.locksFreed++ }, true, nil
+		},
+		Ahead: func() (bool, error) { return pop(&f.ahead, false), f.aheadErr },
+		Conditions: func() (bool, error) {
+			return pop(&f.conditions, true), f.condErr
+		},
+		WorktreeGone: func() (bool, error) { return pop(&f.gone, false), nil },
+		Push: func() error {
+			f.pushes++
+			if len(f.pushErrs) == 0 {
+				return nil
+			}
+			err := f.pushErrs[0]
+			f.pushErrs = f.pushErrs[1:]
+			return err
+		},
+		Owed:   func(err error) bool { return errors.Is(err, errOwed) },
+		Notify: func(line string) error { f.notices = append(f.notices, line); return nil },
+		Sleep: func(d time.Duration) {
+			f.sleeps = append(f.sleeps, d)
+			if f.onSleep != nil {
+				f.onSleep()
+			}
+		},
+	}
+	if pair {
+		deps.PauseCovers = func() (bool, error) { return pop(&f.paused, false), nil }
+		deps.Guard = func() error {
+			f.guardCalls++
+			return f.guardErr
+		}
+	}
+	return deps
+}
+
+// repeat returns n copies of err.
+func repeat(err error, n int) []error {
+	errs := make([]error, n)
+	for i := range errs {
+		errs[i] = err
+	}
+	return errs
+}
+
+// TestRun covers the pusher's pass: its lock, its stops, its pushes and its owed backoff.
+func TestRun(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	backoff := []time.Duration{time.Second, 2 * time.Second, 4 * time.Second, 8 * time.Second, 16 * time.Second, 32 * time.Second, time.Minute, time.Minute}
+	tests := []struct {
+		name           string
+		pair           bool
+		setup          func(f *runFake, cancel context.CancelFunc)
+		wantPushes     int
+		wantErr        error
+		wantGuardCalls int
+		wantLocks      int
+		// wantSleeps is checked only when non-nil.
+		wantSleeps  []time.Duration
+		wantNotices int
+	}{
+		{name: "LevelAfterOnePush", setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true} }, wantPushes: 1, wantLocks: 1},
+		{name: "TipMovedDuringThePush", setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true, true} }, wantPushes: 2, wantLocks: 1},
+		{
+			name: "ACommitWhileExitingWithTheLockFreeAgain", wantPushes: 2, wantLocks: 2,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true, false, true, true} },
+		},
+		{
+			name: "ACommitWhileExitingWithTheLockTakenByAnother", wantPushes: 1, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) {
+				f.ahead = []bool{true, false, true}
+				f.lockResults = []bool{true, false}
+			},
+		},
+		{name: "LockHeldAtStart", setup: func(f *runFake, _ context.CancelFunc) { f.lockResults = []bool{false} }},
+		{name: "WorktreeGone", setup: func(f *runFake, _ context.CancelFunc) { f.gone = []bool{true} }, wantLocks: 1},
+		{name: "ConditionsFail", setup: func(f *runFake, _ context.CancelFunc) { f.conditions = []bool{false} }, wantLocks: 1},
+		{name: "LockTakeFails", setup: func(f *runFake, _ context.CancelFunc) { f.lockErr = errReadFailed }, wantErr: errReadFailed},
+		{name: "AheadReadFails", setup: func(f *runFake, _ context.CancelFunc) { f.aheadErr = errReadFailed }, wantErr: errReadFailed, wantLocks: 1},
+		{name: "ConditionsReadFails", setup: func(f *runFake, _ context.CancelFunc) { f.condErr = errReadFailed }, wantErr: errReadFailed, wantLocks: 1},
+		{
+			name: "APauseCoversTheRunBeforeTheGuard", pair: true, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true}; f.paused = []bool{true} },
+		},
+		{
+			name: "APauseDuringAnOwedBackoffStopsTheNextAttempt", pair: true, wantPushes: 1, wantGuardCalls: 1, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) {
+				f.ahead = []bool{true}
+				f.paused = []bool{false, true}
+				f.pushErrs = []error{errOwed}
+			},
+		},
+		{
+			name: "APauseAfterALandedPushWhileStillAhead", pair: true, wantPushes: 1, wantGuardCalls: 1, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true, true}; f.paused = []bool{false, true} },
+		},
+		{
+			name: "AGuardStopPushesNothing", pair: true, wantErr: errGuardStop, wantGuardCalls: 1, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true}; f.guardErr = errGuardStop },
+		},
+		{
+			name: "OwedFailuresThenALanding", wantPushes: 9, wantLocks: 1, wantNotices: 1, wantSleeps: backoff,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true}; f.pushErrs = repeat(errOwed, 8) },
+		},
+		{
+			name: "ASecondOwedEpisodeAfterALandingNotifiesAgain", wantPushes: 16, wantLocks: 1, wantNotices: 2,
+			setup: func(f *runFake, _ context.CancelFunc) {
+				f.ahead = []bool{true, true}
+				f.pushErrs = append(append(repeat(errOwed, 7), nil), repeat(errOwed, 7)...)
+			},
+		},
+		{
+			name: "ARefusedPushReturns", wantPushes: 1, wantErr: errRefused, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true}; f.pushErrs = []error{errRefused} },
+		},
+		{
+			name: "AHandedOverPushReturns", wantPushes: 1, wantErr: errHandedOver, wantLocks: 1,
+			setup: func(f *runFake, _ context.CancelFunc) { f.ahead = []bool{true}; f.pushErrs = []error{errHandedOver} },
+		},
+		{
+			name: "ACancelledContextDuringTheBackoff", wantPushes: 1, wantErr: context.Canceled, wantLocks: 1,
+			setup: func(f *runFake, cancel context.CancelFunc) {
+				f.ahead = []bool{true}
+				f.pushErrs = repeat(errOwed, 100)
+				f.onSleep = cancel
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			f := &runFake{}
+			tt.setup(f, cancel)
+			target := runpusher.Target{Location: &lymcwd.Location{HubPath: "hub", WorktreeName: "wt"}, Pair: tt.pair}
+
+			err := runpusher.Run(ctx, target, f.deps(tt.pair))
+
+			if !errors.Is(err, tt.wantErr) {
+				t.Errorf("Run() error = %v; want %v", err, tt.wantErr)
+			}
+			if f.pushes != tt.wantPushes {
+				t.Errorf("pushes = %d; want %d", f.pushes, tt.wantPushes)
+			}
+			if f.guardCalls != tt.wantGuardCalls {
+				t.Errorf("guard calls = %d; want %d", f.guardCalls, tt.wantGuardCalls)
+			}
+			if f.locksTaken != tt.wantLocks || f.locksFreed != f.locksTaken {
+				t.Errorf("locks taken = %d, released = %d; want %d taken and all released", f.locksTaken, f.locksFreed, tt.wantLocks)
+			}
+			if len(f.notices) != tt.wantNotices {
+				t.Errorf("notices = %q; want %d", f.notices, tt.wantNotices)
+			}
+			if tt.wantSleeps != nil && !reflect.DeepEqual(f.sleeps, tt.wantSleeps) {
+				t.Errorf("sleeps = %v; want %v", f.sleeps, tt.wantSleeps)
+			}
+		})
+	}
+}
diff --git a/internal/runpusher/seams_test.go b/internal/runpusher/seams_test.go
new file mode 100644
index 000000000..25fbdb81b
--- /dev/null
+++ b/internal/runpusher/seams_test.go
@@ -0,0 +1,169 @@
+// seams_test.go drives the real reads and the lock behind the pusher's start, and its restart episodes.
+// The fake-driven tests of Start and Run leave these out.
+
+package runpusher
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// pairTargetIn returns the target of the pair task in a hub under a fresh temp directory.
+// The pair's worktree directory holds a gitdir file that reads as a linked worktree.
+func pairTargetIn(t *testing.T) Target {
+	t.Helper()
+
+	hub := t.TempDir()
+	worktree := filepath.Join(hub, "task")
+	if err := os.MkdirAll(worktree, 0o755); err != nil {
+		t.Fatalf("create the worktree: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(worktree, ".git"), []byte("gitdir: "+filepath.Join(hub, "main", ".git", "worktrees", "task")+"\n"), 0o644); err != nil {
+		t.Fatalf("write the gitdir file: %v", err)
+	}
+	return Target{Location: &lymcwd.Location{HubPath: hub, WorktreeName: "task"}, Slug: "task", Pair: true}
+}
+
+func TestPusherLock_ExcludesASecondPusherUntilReleased(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	path := LockPath(pairTargetIn(t))
+
+	release, acquired, err := tryLock(path)
+	if err != nil || !acquired {
+		t.Fatalf("first tryLock() = _, %v, %v; want it acquired", acquired, err)
+	}
+	if free, err := newStarter().lockFree(path); err != nil || free {
+		t.Errorf("lockFree() while held = %v, %v; want false, nil", free, err)
+	}
+	if _, second, err := tryLock(path); err != nil || second {
+		t.Errorf("second tryLock() acquired = %v, %v; want false, nil", second, err)
+	}
+
+	release()
+
+	if free, err := newStarter().lockFree(path); err != nil || !free {
+		t.Errorf("lockFree() after the release = %v, %v; want true, nil", free, err)
+	}
+	third, acquired, err := tryLock(path)
+	if err != nil || !acquired {
+		t.Fatalf("third tryLock() = _, %v, %v; want it acquired after the release", acquired, err)
+	}
+	third()
+}
+
+func TestWorktreeGone_ReadsWhetherTheDirectoryStands(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	target := pairTargetIn(t)
+	if gone, err := worktreeGone(target); err != nil || gone {
+		t.Errorf("worktreeGone() of a standing worktree = %v, %v; want false, nil", gone, err)
+	}
+
+	if err := os.RemoveAll(target.Location.WorktreePath()); err != nil {
+		t.Fatalf("remove the worktree: %v", err)
+	}
+
+	if gone, err := worktreeGone(target); err != nil || !gone {
+		t.Errorf("worktreeGone() of a removed worktree = %v, %v; want true, nil", gone, err)
+	}
+}
+
+func TestHandedOver_ReadsTheMarkOfTheRun(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	target := pairTargetIn(t)
+	if marked, err := handedOver(target); err != nil || marked {
+		t.Errorf("handedOver() with no mark = %v, %v; want false, nil", marked, err)
+	}
+
+	mark := fabricengine.HandOverMark{Machine: "oslo", At: "2026-11-15T09:00:00Z", Written: time.Now()}
+	if err := fabricengine.WriteHandOverMark(target.Location.HubPath, target.Slug, mark); err != nil {
+		t.Fatalf("write the hand-over mark: %v", err)
+	}
+
+	if marked, err := handedOver(target); err != nil || !marked {
+		t.Errorf("handedOver() with the run's mark = %v, %v; want true, nil", marked, err)
+	}
+}
+
+func TestPauseCovers_ReadsTheLiveEntryOfThePair(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		// scope is the scope of the live entry written, empty for no record.
+		scope string
+		want  bool
+	}{
+		{"NoRecordCoversNothing", "", false},
+		{"LiveEntryOfThePairCoversIt", "task", true},
+		{"LiveEntryOfAnotherPairDoesNot", "other", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			target := pairTargetIn(t)
+			if tt.scope != "" {
+				geometry, err := hubgeom.PauseGeometry(target.Location)
+				if err != nil {
+					t.Fatalf("PauseGeometry() = %v; want nil", err)
+				}
+				content, err := json.Marshal(pauserecord.Record{Live: []pauserecord.Entry{{Scope: tt.scope, Caller: "EXTERNAL", PausedAt: time.Now().Add(-time.Minute)}}})
+				if err != nil {
+					t.Fatalf("marshal the pause record: %v", err)
+				}
+				if err := os.MkdirAll(filepath.Dir(geometry.RecordPath), 0o755); err != nil {
+					t.Fatalf("create the pause record directory: %v", err)
+				}
+				if err := os.WriteFile(geometry.RecordPath, content, 0o644); err != nil {
+					t.Fatalf("write the pause record: %v", err)
+				}
+			}
+
+			covered, err := pauseCovers(target)
+
+			if err != nil || covered != tt.want {
+				t.Errorf("pauseCovers() = %v, %v; want %v, nil", covered, err, tt.want)
+			}
+		})
+	}
+}
+
+func TestRestartPusher_CountsEachFailureOfAnEpisodeAndClosesItOnASuccessfulStart(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const key = "restart-pusher-episode"
+	failing := func() (bool, error) { return false, errors.New("no pusher") }
+
+	RestartPusher(failing, key)
+	if got := restartEpisodes.Ticks()[key]; got != 1 {
+		t.Errorf("failed ticks after one failed start = %d; want 1", got)
+	}
+	RestartPusher(failing, key)
+	if got := restartEpisodes.Ticks()[key]; got != 2 {
+		t.Errorf("failed ticks after two failed starts = %d; want 2, one episode", got)
+	}
+
+	RestartPusher(func() (bool, error) { return true, nil }, key)
+
+	if _, open := restartEpisodes.Ticks()[key]; open {
+		t.Errorf("episode after a successful start is still open; want it closed")
+	}
+}
diff --git a/internal/runpusher/start.go b/internal/runpusher/start.go
new file mode 100644
index 000000000..aba266b3f
--- /dev/null
+++ b/internal/runpusher/start.go
@@ -0,0 +1,212 @@
+// start.go starts a worktree's pusher as a detached process when the start conditions hold.
+
+package runpusher
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/selfexec"
+)
+
+// restartEpisodes keeps one failure episode per key, so a start that fails on every tick warns once.
+var restartEpisodes logger.EpisodeSet
+
+// spawnRequest is one detached pusher process to start.
+type spawnRequest struct {
+	// Args is the command line after the lym binary.
+	Args []string
+	// Dir is the directory the process starts in.
+	Dir string
+	// RunProcDir is the directory of the owner records the process is registered in.
+	RunProcDir string
+	// Owner is the owner the process is registered under.
+	Owner string
+	// Role is the role the process is registered as.
+	Role string
+}
+
+// starter carries the reads and the spawn a start decides over, so a test drives it with fakes.
+type starter struct {
+	// skipped reports whether git or pushes are off for this process.
+	skipped func() bool
+	// lockFree reports whether nobody holds the pusher lock at path.
+	lockFree func(path string) (bool, error)
+	// refusedPushStands reports whether a refused-push record stands for the target's branches.
+	refusedPushStands func(t Target) (bool, error)
+	// pauseCovers reports whether a pause covers the target's run.
+	pauseCovers func(t Target) (bool, error)
+	// handedOver reports whether a hand-over mark names the target's run.
+	handedOver func(t Target) (bool, error)
+	// ahead reports whether the target holds commits origin lacks.
+	ahead func(t Target) (bool, error)
+	// spawn starts the pusher process.
+	spawn func(req spawnRequest) error
+}
+
+// Start starts the pusher of t when its start conditions hold, and reports whether it spawned one.
+// The conditions are a free pusher lock and no refused-push record.
+// A pair also needs no pause covering its run and no hand-over mark naming it.
+// A process with FABRIC_SKIP_GIT or FABRIC_SKIP_PUSH set starts none.
+// Two racing starts may both spawn: the loser exits at the lock.
+// A failed read returns its error and starts none.
+func Start(t Target) (bool, error) {
+	return newStarter().start(t, false)
+}
+
+// StartIfAhead is Start for a worktree that also holds commits origin lacks.
+func StartIfAhead(t Target) (bool, error) {
+	return newStarter().start(t, true)
+}
+
+// RestartPusher runs start once, as the dobby's tick and a resume do.
+// A failed start logs one warning per episode under key, and a later successful start logs the recovery.
+// It never fails or drops anything of its caller's.
+func RestartPusher(start func() (bool, error), key string) {
+	if _, err := start(); err != nil {
+		restartEpisodes.Fail(key, "runpusher: the pusher did not start", "worktree", key, "error", err)
+		return
+	}
+	restartEpisodes.Recover(key, "runpusher: the pusher starts again", "worktree", key)
+}
+
+// newStarter fills a starter from the hub.
+func newStarter() starter {
+	return starter{
+		skipped: func() bool {
+			options := fabricengine.EnvSyncOptions()
+			return options.SkipGit || options.SkipPush
+		},
+		lockFree: func(path string) (bool, error) {
+			release, acquired, err := tryLock(path)
+			if acquired {
+				release()
+			}
+			return acquired, err
+		},
+		refusedPushStands: func(t Target) (bool, error) { return fabricengine.RefusedPushStands(t.Location) },
+		pauseCovers:       pauseCovers,
+		handedOver:        handedOver,
+		ahead:             func(t Target) (bool, error) { return fabricengine.RunCommitsAhead(t.Location) },
+		spawn:             spawnPusher,
+	}
+}
+
+// start spawns the pusher of t when the conditions hold, and reports whether it did.
+// With ifAhead it also requires commits origin lacks.
+func (s starter) start(t Target, ifAhead bool) (bool, error) {
+	if s.skipped() {
+		return false, nil
+	}
+	if ifAhead {
+		ahead, err := s.ahead(t)
+		if err != nil || !ahead {
+			return false, err
+		}
+	}
+	free, err := s.lockFree(LockPath(t))
+	if err != nil || !free {
+		return false, err
+	}
+	stands, err := s.refusedPushStands(t)
+	if err != nil || stands {
+		return false, err
+	}
+	if t.Pair {
+		covered, err := s.pauseCovers(t)
+		if err != nil || covered {
+			return false, err
+		}
+		marked, err := s.handedOver(t)
+		if err != nil || marked {
+			return false, err
+		}
+	}
+	if err := s.spawn(pusherRequest(t)); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+// pusherRequest returns the detached process that serves t.
+// It starts in the hub's Bolt directory, outside the pair, so a removal of the pair leaves it standing.
+// It is registered under the hub's owner, so no run's teardown, cancel or hand-over reaches it.
+func pusherRequest(t Target) spawnRequest {
+	args := []string{"loom", "pusher", "--" + WorktreeFlag, t.Location.WorktreePath()}
+	if t.Slug != "" {
+		args = append(args, "--"+SlugFlag, t.Slug)
+	}
+	return spawnRequest{
+		Args:       args,
+		Dir:        fabricengine.BoltDir(t.Location.HubPath),
+		RunProcDir: fabricengine.RunProcDir(t.Location.HubPath),
+		Owner:      runproc.HubOwner,
+		Role:       runproc.RolePush,
+	}
+}
+
+// spawnPusher starts the detached process req describes and registers it.
+// It returns an error under go test, where the lym binary is the test binary, and starts nothing.
+// A failed registration is logged and never fails the spawn, since the pusher is already running.
+func spawnPusher(req spawnRequest) error {
+	exe, err := selfexec.LymBinary()
+	if err != nil {
+		return err
+	}
+	cmd := exec.Command(exe, req.Args...)
+	cmd.Dir = req.Dir
+	proc.Detach(cmd)
+	if err := cmd.Start(); err != nil {
+		logger.Warn("runpusher: spawn the pusher failed", "exe", exe, "args", req.Args, "dir", req.Dir, "error", err)
+		return fmt.Errorf("runpusher: spawn the pusher: %w", err)
+	}
+	proc.Reap(cmd)
+	pid := cmd.Process.Pid
+	logger.Info("runpusher: spawned the pusher", "exe", exe, "args", req.Args, "dir", req.Dir, "pid", pid)
+	if err := runproc.Register(req.RunProcDir, req.Owner, runproc.ChildRecord(pid, req.Role, req.Args)); err != nil {
+		logger.Warn("runpusher: the pusher is not registered", "owner", req.Owner, "pid", pid, "error", err)
+	}
+	return nil
+}
+
+// tryLock takes the pusher lock at path without waiting.
+// It reports acquired false when another process holds it.
+func tryLock(path string) (release func(), acquired bool, err error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return nil, false, fmt.Errorf("runpusher: create the pusher lock directory: %w", err)
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(path)
+	if err != nil || !acquired {
+		return nil, false, err
+	}
+	return func() { _ = held.Release() }, true, nil
+}
+
+// pauseCovers reports whether a pause covers the run of the pair t.
+func pauseCovers(t Target) (bool, error) {
+	geometry, err := hubgeom.PauseGeometry(t.Location)
+	if err != nil {
+		return false, fmt.Errorf("runpusher: read the pause geometry of %s: %w", t.Location.WorktreePath(), err)
+	}
+	coverage, err := pauserecord.ReadCoverage(geometry.RecordPath, geometry.Slug, time.Now())
+	if err != nil {
+		return false, fmt.Errorf("runpusher: read the pause record: %w", err)
+	}
+	return coverage.Covered, nil
+}
+
+// handedOver reports whether this machine's hand-over mark names the run of the pair t.
+func handedOver(t Target) (bool, error) {
+	_, found, err := fabricengine.ReadHandOverMark(t.Location.HubPath, t.Slug)
+	return found, err
+}
diff --git a/internal/runpusher/start_test.go b/internal/runpusher/start_test.go
new file mode 100644
index 000000000..0803c12e5
--- /dev/null
+++ b/internal/runpusher/start_test.go
@@ -0,0 +1,140 @@
+// start_test.go drives the pusher's start conditions over a starter built from fake reads and a fake spawn.
+
+package runpusher
+
+import (
+	"errors"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// startFake holds what the fake reads answer and records what the starter read and spawned.
+type startFake struct {
+	skipped  bool
+	lockFree bool
+	stands   bool
+	paused   bool
+	marked   bool
+	ahead    bool
+	// failing names the read that fails: lock, stands, paused, marked, ahead or spawn.
+	failing string
+	reads   []string
+	spawned []spawnRequest
+}
+
+var errFakeRead = errors.New("fake read failed")
+
+// starter builds the starter over the fake.
+func (f *startFake) starter() starter {
+	read := func(name string, answer bool) (bool, error) {
+		f.reads = append(f.reads, name)
+		if f.failing == name {
+			return false, errFakeRead
+		}
+		return answer, nil
+	}
+	return starter{
+		skipped:           func() bool { return f.skipped },
+		lockFree:          func(string) (bool, error) { return read("lock", f.lockFree) },
+		refusedPushStands: func(Target) (bool, error) { return read("stands", f.stands) },
+		pauseCovers:       func(Target) (bool, error) { return read("paused", f.paused) },
+		handedOver:        func(Target) (bool, error) { return read("marked", f.marked) },
+		ahead:             func(Target) (bool, error) { return read("ahead", f.ahead) },
+		spawn: func(req spawnRequest) error {
+			if f.failing == "spawn" {
+				return errFakeRead
+			}
+			f.spawned = append(f.spawned, req)
+			return nil
+		},
+	}
+}
+
+// TestStart covers when a pusher is spawned and what the spawn carries.
+func TestStart(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	hub := filepath.Join(string(filepath.Separator), "hub")
+	pair := Target{Location: &lymcwd.Location{HubPath: hub, WorktreeName: "pair-slug"}, Slug: "pair-slug", Pair: true}
+	prime := Target{Location: &lymcwd.Location{HubPath: hub, WorktreeName: "prime"}}
+	runProcDir := filepath.Join(hub, lymcwd.BoltDirName, ".lym", "runproc")
+	pairRequest := spawnRequest{
+		Args:       []string{"loom", "pusher", "--worktree", filepath.Join(hub, "pair-slug"), "--slug", "pair-slug"},
+		Dir:        filepath.Join(hub, lymcwd.BoltDirName),
+		RunProcDir: runProcDir,
+		Owner:      lymcwd.BoltDirName,
+		Role:       "push",
+	}
+	primeRequest := spawnRequest{
+		Args:       []string{"loom", "pusher", "--worktree", filepath.Join(hub, "prime")},
+		Dir:        filepath.Join(hub, lymcwd.BoltDirName),
+		RunProcDir: runProcDir,
+		Owner:      lymcwd.BoltDirName,
+		Role:       "push",
+	}
+
+	tests := []struct {
+		name        string
+		target      Target
+		ifAhead     bool
+		setup       func(f *startFake)
+		wantRequest *spawnRequest
+		wantErr     bool
+		// wantNoReads asserts the starter read nothing.
+		wantNoReads bool
+	}{
+		{name: "EveryConditionHoldsForAPair", target: pair, wantRequest: &pairRequest},
+		{name: "APrimeSpawnsWithoutASlug", target: prime, wantRequest: &primeRequest},
+		{name: "LockHeld", target: pair, setup: func(f *startFake) { f.lockFree = false }},
+		{name: "RefusedPushStands", target: pair, setup: func(f *startFake) { f.stands = true }},
+		{name: "PauseCoversAPair", target: pair, setup: func(f *startFake) { f.paused = true }},
+		{name: "HandOverMarkNamesAPair", target: pair, setup: func(f *startFake) { f.marked = true }},
+		{
+			name: "PauseAndMarkDoNotApplyToThePrime", target: prime, wantRequest: &primeRequest,
+			setup: func(f *startFake) { f.paused, f.marked = true, true },
+		},
+		{name: "GitOrPushesOffReadsNothing", target: pair, setup: func(f *startFake) { f.skipped = true }, wantNoReads: true},
+		{name: "IfAheadWithTheWorktreeLevel", target: pair, ifAhead: true, setup: func(f *startFake) { f.ahead = false }},
+		{name: "IfAheadWithTheWorktreeAhead", target: pair, ifAhead: true, wantRequest: &pairRequest},
+		{name: "LevelStartsWithoutTheAheadRead", target: pair, setup: func(f *startFake) { f.ahead = false }, wantRequest: &pairRequest},
+		{name: "LockReadFails", target: pair, setup: func(f *startFake) { f.failing = "lock" }, wantErr: true},
+		{name: "RefusedPushReadFails", target: pair, setup: func(f *startFake) { f.failing = "stands" }, wantErr: true},
+		{name: "PauseReadFails", target: pair, setup: func(f *startFake) { f.failing = "paused" }, wantErr: true},
+		{name: "HandOverMarkReadFails", target: pair, setup: func(f *startFake) { f.failing = "marked" }, wantErr: true},
+		{name: "AheadReadFails", target: pair, ifAhead: true, setup: func(f *startFake) { f.failing = "ahead" }, wantErr: true},
+		{name: "SpawnFails", target: pair, setup: func(f *startFake) { f.failing = "spawn" }, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			f := &startFake{lockFree: true, ahead: true}
+			if tt.setup != nil {
+				tt.setup(f)
+			}
+
+			spawned, err := f.starter().start(tt.target, tt.ifAhead)
+
+			if (err != nil) != tt.wantErr || (err != nil && !errors.Is(err, errFakeRead)) {
+				t.Fatalf("start() error = %v; want error %v", err, tt.wantErr)
+			}
+			if wantSpawn := tt.wantRequest != nil; spawned != wantSpawn {
+				t.Errorf("start() = %v; want %v", spawned, wantSpawn)
+			}
+			if tt.wantRequest == nil && len(f.spawned) != 0 {
+				t.Errorf("spawns = %+v; want none", f.spawned)
+			}
+			if tt.wantRequest != nil && !reflect.DeepEqual(f.spawned, []spawnRequest{*tt.wantRequest}) {
+				t.Errorf("spawns = %+v; want one %+v", f.spawned, *tt.wantRequest)
+			}
+			if tt.wantNoReads && len(f.reads) != 0 {
+				t.Errorf("reads = %v; want none", f.reads)
+			}
+		})
+	}
+}
