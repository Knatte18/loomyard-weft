+const (
+	reasonChangedToo = "origin changed the field too"
+	reasonAddedToo   = "origin added an entry with this slug too"
+)
+
+// Field is one comparable field of a record.
+// Name is its JSON name, Get a canonical getter that reads nil and empty alike, and Set copies the field from another record into dst.
+type Field[T any] struct {
+	Name string
+	Get  func(T) any
+	Set  func(dst *T, src T)
+}
+
+// Table is the key and the merged fields of a record type.
+// Fields are in the order a change reports them.
+type Table[T any] struct {
+	Key    func(T) string
+	Fields []Field[T]
+}
+
+// Finding is one field of one entry the merge set aside.
+// Local is the commit's value of the field rendered as JSON, empty when the whole entry is concerned.
+type Finding struct {
+	Entry  string
+	Field  string
+	Reason string
+	Local  string
+}
+
+// Changed returns the fields whose values differ between a commit's parent, before, and the commit, in table order.
+func (t Table[T]) Changed(before, commit T) []Field[T] {
+	var changed []Field[T]
+	for _, field := range t.Fields {
+		if !reflect.DeepEqual(field.Get(before), field.Get(commit)) {
+			changed = append(changed, field)
+		}
+	}
+	return changed
+}
+
+// Change applies the fields the commit changed against before onto origin's entry, and returns the merged entry, the names of the fields applied and the changes set aside.
+// merged starts as origin; the caller passes a deep copy when the record holds reference fields it must not share with origin's own.
+// A changed field origin already holds is skipped.
+// One origin moved to a value that is neither the merge base's nor before's keeps origin's value and is reported lost, with the commit's value as Local.
+// Every other changed field is set from the commit and named in applied.
+func (t Table[T]) Change(base, before, origin, commit T) (merged T, applied []string, lost []Finding) {
+	merged = origin
+	for _, field := range t.Changed(before, commit) {
+		current, local := field.Get(origin), field.Get(commit)
+		if reflect.DeepEqual(current, local) {
+			continue
+		}
+		if !reflect.DeepEqual(current, field.Get(base)) && !reflect.DeepEqual(current, field.Get(before)) {
+			lost = append(lost, Finding{Entry: t.Key(commit), Field: field.Name, Reason: reasonChangedToo, Local: Render(local)})
+			continue
+		}
+		field.Set(&merged, commit)
+		applied = append(applied, field.Name)
+	}
+	return merged, applied, lost
+}
+
+// AddClash reports each field the commit's added entry carries differently from an entry origin added under the same key.
+func (t Table[T]) AddClash(origin, commit T) []Finding {
+	var clashes []Finding
+	for _, field := range t.Fields {
+		if local := field.Get(commit); !reflect.DeepEqual(field.Get(origin), local) {
+			clashes = append(clashes, Finding{Entry: t.Key(commit), Field: field.Name, Reason: reasonAddedToo, Local: Render(local)})
+		}
+	}
+	return clashes
+}
+
+// Same reports whether every field of a and b is equal.
+func (t Table[T]) Same(a, b T) bool {
+	for _, field := range t.Fields {
+		if !reflect.DeepEqual(field.Get(a), field.Get(b)) {
+			return false
+		}
+	}
+	return true
+}
+
+// Render renders a field value as JSON, or as fmt.Sprint renders it when it has no JSON form.
+func Render(value any) string {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return fmt.Sprint(value)
+	}
+	return string(encoded)
+}
diff --git a/internal/entrymerge/entrymerge_test.go b/internal/entrymerge/entrymerge_test.go
new file mode 100644
index 00000000..2b07cbe7
--- /dev/null
+++ b/internal/entrymerge/entrymerge_test.go
@@ -0,0 +1,73 @@
+//go:build tier0
+
+// entrymerge_test.go drives the merge over a two-field record, through the cases the board replay's own tests do not reach.
+
+package entrymerge_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/entrymerge"
+)
+
+// record has a plain field and a slice field that reads nil and empty alike.
+type record struct {
+	Slug  string
+	Title string
+	Tags  []string
+}
+
+var recordTable = entrymerge.Table[record]{
+	Key: func(r record) string { return r.Slug },
+	Fields: []entrymerge.Field[record]{
+		{Name: "title", Get: func(r record) any { return r.Title }, Set: func(dst *record, src record) { dst.Title = src.Title }},
+		{Name: "tags", Get: func(r record) any {
+			if r.Tags == nil {
+				return []string{}
+			}
+			return r.Tags
+		}, Set: func(dst *record, src record) { dst.Tags = slices.Clone(src.Tags) }},
+	},
+}
+
+// TestTable covers the field changes, add clashes and removal judgment that the board's replay rows leave out.
+func TestTable(t *testing.T) {
+	t.Parallel()
+
+	t.Run("Changed lists only differing fields and reads nil and empty slices alike", func(t *testing.T) {
+		t.Parallel()
+		before := record{Slug: "a", Title: "one"}
+		commit := record{Slug: "a", Title: "two", Tags: []string{}}
+		changed := recordTable.Changed(before, commit)
+		if len(changed) != 1 || changed[0].Name != "title" {
+			t.Errorf("Changed() = %v; want only the title field", changed)
+		}
+	})
+
+	t.Run("Change applies the commit's value when origin still holds the commit's parent value", func(t *testing.T) {
+		t.Parallel()
+		base := record{Slug: "a", Title: "base"}
+		before := record{Slug: "a", Title: "parent"}
+		origin := record{Slug: "a", Title: "parent", Tags: []string{"kept"}}
+		commit := record{Slug: "a", Title: "commit"}
+
+		merged, applied, lost := recordTable.Change(base, before, origin, commit)
+		if merged.Title != "commit" || !slices.Equal(merged.Tags, []string{"kept"}) {
+			t.Errorf("Change() merged = %+v; want the commit's title and origin's tags", merged)
+		}
+		if !slices.Equal(applied, []string{"title"}) || len(lost) != 0 {
+			t.Errorf("Change() applied = %v, lost = %v; want [title] and nothing lost", applied, lost)
+		}
+	})
+
+	t.Run("AddClash reports each differing field with the commit's value", func(t *testing.T) {
+		t.Parallel()
+		origin := record{Slug: "a", Title: "origin", Tags: []string{"x"}}
+		commit := record{Slug: "a", Title: "commit", Tags: []string{"x"}}
+		want := []entrymerge.Finding{{Entry: "a", Field: "title", Reason: "origin added an entry with this slug too", Local: `"commit"`}}
+		if got := recordTable.AddClash(origin, commit); !slices.Equal(got, want) {
+			t.Errorf("AddClash() = %+v; want %+v", got, want)
+		}
+	})
+}
