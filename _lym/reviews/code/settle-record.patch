+	tmuxPath, _ := cmd.Flags().GetString(toggleTmuxFlag)
+	socketPath, _ := cmd.Flags().GetString(toggleSocketFlag)
+	client, _ := cmd.Flags().GetString(toggleClientFlag)
+	c.showToggle(tmuxPath, socketPath, client, message)
+}
