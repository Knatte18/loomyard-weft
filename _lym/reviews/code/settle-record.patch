+func (b boardView) projectSection(project Task, level int) []string {
+	if project.Slug == "" {
+		lines := []string{heading(level, primeSection.name), "", primeSection.meaning, ""}
+		return append(lines, b.projectBody(Task{}, level)...)
+	}
+	members := 0
+	for _, twl := range b.ordered {
