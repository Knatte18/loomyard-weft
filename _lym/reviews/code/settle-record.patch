+// rowstore_test.go covers the row fixer's record store: the round trip through records.json, the keys a newer binary wrote, the live record and the terminal mark.
+
+package gatefixer
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestRowStore pins the records file's round trip and its keeping of unknown keys, the live read and the terminal mark of one guid.
+func TestRowStore(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("RecordsRoundTripAndSaveRewritesByGuid", func(t *testing.T) {
+		t.Parallel()
+		store := newRowStore(t.TempDir(), "verify")
+		first := Record{StrandGUID: "a", SpawnedAt: "1970-01-01T00:00:00Z", ReportPath: "/r/report-1.md", ReplyPath: "/r/reply-1.md"}
+		if err := store.Save(&first); err != nil {
+			t.Fatalf("Save(a) error = %v; want none", err)
+		}
+		if err := store.Save(&Record{StrandGUID: "b"}); err != nil {
+			t.Fatalf("Save(b) error = %v; want none", err)
+		}
+		first.EventsOffset = 42
+		if err := store.Save(&first); err != nil {
+			t.Fatalf("Save(a again) error = %v; want none", err)
+		}
+
+		records, err := store.load()
+		if err != nil || len(records) != 2 || records[0] != first || records[1].StrandGUID != "b" {
+			t.Errorf("load() = %+v, %v; want a rewritten in place, then b", records, err)
+		}
+		if count, err := store.count(); err != nil || count != 2 {
+			t.Errorf("count() = %d, %v; want 2", count, err)
+		}
+		if report, reply := store.reportPath(3), store.replyPath(3); !strings.HasSuffix(report, "verify/report-3.md") || !strings.HasSuffix(reply, "verify/reply-3.md") {
+			t.Errorf("reportPath(3) = %q, replyPath(3) = %q; want report-3.md and reply-3.md in the entry directory", report, reply)
+		}
+	})
+
+	t.Run("AnUnknownKeyInTheFileSurvivesARewrite", func(t *testing.T) {
+		t.Parallel()
+		store := newRowStore(t.TempDir(), "verify")
+		if err := store.Save(&Record{StrandGUID: "a", Status: StatusDone}); err != nil {
+			t.Fatalf("Save(a) error = %v; want none", err)
+		}
+		seeded := `[{"strandGuid":"a","spawnedAt":"","status":"done","fromNewerBinary":"keep me"}]`
+		if err := os.WriteFile(store.recordsPath(), []byte(seeded), 0o644); err != nil {
+			t.Fatalf("seed records file: %v", err)
+		}
+
+		if err := store.Save(&Record{StrandGUID: "b"}); err != nil {
+			t.Fatalf("Save(b) error = %v; want none", err)
+		}
+		data, err := os.ReadFile(store.recordsPath())
+		if err != nil || !strings.Contains(string(data), `"fromNewerBinary": "keep me"`) {
+			t.Errorf("records file = %q, %v; want the unknown key kept", data, err)
+		}
+	})
+
+	t.Run("LiveReturnsOnlyARecordWithNoTerminalStatus", func(t *testing.T) {
+		t.Parallel()
+		store := newRowStore(t.TempDir(), "verify")
+		if live, err := store.Live(); err != nil || live != nil {
+			t.Fatalf("Live() on an absent file = %+v, %v; want nil", live, err)
+		}
+		for _, rec := range []Record{{StrandGUID: "old", Status: StatusDone}, {StrandGUID: "now"}, {StrandGUID: "dead", Status: StatusDead}} {
+			if err := store.Save(&rec); err != nil {
+				t.Fatalf("Save(%s) error = %v; want none", rec.StrandGUID, err)
+			}
+		}
+		if live, err := store.Live(); err != nil || live == nil || live.StrandGUID != "now" {
+			t.Errorf("Live() = %+v, %v; want the record now", live, err)
+		}
+	})
+
+	t.Run("MarkTerminalChangesOneRecordAndRefusesAnUnknownGuid", func(t *testing.T) {
+		t.Parallel()
+		store := newRowStore(t.TempDir(), "verify")
+		for _, guid := range []string{"a", "b"} {
+			if err := store.Save(&Record{StrandGUID: guid}); err != nil {
+				t.Fatalf("Save(%s) error = %v; want none", guid, err)
+			}
+		}
+		if err := store.markTerminal("a", StatusDead, DeadReasonTimeout); err != nil {
+			t.Fatalf("markTerminal(a) error = %v; want none", err)
+		}
+		records, _ := store.load()
+		if records[0].Status != StatusDead || records[0].DeadReason != DeadReasonTimeout || records[1].Status != "" {
+			t.Errorf("records = %+v; want a dead for timeout and b untouched", records)
+		}
+		if err := store.markTerminal("missing", StatusDone, ""); err == nil || !strings.Contains(err.Error(), "missing") {
+			t.Errorf("markTerminal(missing) error = %v; want one naming the guid", err)
+		}
+	})
+}
diff --git a/internal/gatefixer/spawn.go b/internal/gatefixer/spawn.go
new file mode 100644
index 00000000..3e442db7
--- /dev/null
+++ b/internal/gatefixer/spawn.go
@@ -0,0 +1,142 @@
+// spawn.go declares the seams a fixer's spawn and wait go through, and SpawnOrAttach, which gives a caller its one fixer strand per failed evaluation.
+
+package gatefixer
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// Starter is the seam a fixer strand is spawned through.
+// Start returns once the spawned provider is past its startup gates, and never waits for the run to finish.
+type Starter interface {
+	Start(shuttleengine.Spec) (*shuttleengine.Run, error)
+}
+
+// Stopper is the seam a fixer strand is stopped through by guid.
+// StopStrand records the stop on the strand's run, then ends the strand when it is live, and is a no-op for one that is not.
+type Stopper interface {
+	StopStrand(guid string) error
+}
+
+// Engines is the engine lookup a fixer's recorded engine name is resolved through.
+// An empty name resolves the default engine, and DefaultName names that engine.
+type Engines interface {
+	Lookup(name string) (shuttleengine.Engine, error)
+	DefaultName() string
+}
+
+// Clock is the time source the wait polls on, so a test advances it without waiting.
+type Clock interface {
+	Now() time.Time
+	Sleep(time.Duration)
+}
+
+// Deps carries the seams a fixer's spawn and wait need.
+type Deps struct {
+	Starter Starter
+	Stopper Stopper
+	// Reed answers the liveness read of the wait.
+	Reed    shuttleengine.ReedOps
+	Engines Engines
+	// ShuttleCfg and AnchorRoot locate a spawned strand's shuttle run.
+	ShuttleCfg shuttleengine.Config
+	AnchorRoot string
+	Clock      Clock
+	// Register registers a spawned strand with runproc by guid; nil leaves the strand unregistered.
+	Register func(guid string) error
+}
+
+// Spec is one fixer strand's launch.
+type Spec struct {
+	// Prompt is the rendered prompt the strand starts with.
+	Prompt []byte
+	// ReportPath is the report the fixer reads, kept on the record.
+	ReportPath string
+	// ReplyPath is the reply file the fixer writes as its final action, and the strand's only output file.
+	ReplyPath string
+	// Role is the strand's reed role, one of Roles.
+	Role        string
+	ModelChoice shuttleengine.ModelChoice
+	Skills      []string
+	Segment     segmentcolor.Segment
+	// Timeout bounds the strand's own run.
+	Timeout time.Duration
+}
+
+// SpawnOrAttach returns the fixer strand a caller waits on, and whether this call spawned it.
+// A live record in store is attached to as it stands, and nothing is spawned.
+// Otherwise a stale reply file is removed, a strand is started with the reply file as its only output file, registered through deps.Register when set, and its record is saved in store before it is returned.
+// A start failure is returned wrapped as transient.
+// A run that cannot be resolved, a registration that fails or a record that cannot be saved stops the strand and returns the joined error, wrapped as transient, so no unrecorded or unregistered strand outlives the call.
+// It refuses a spec.Role outside Roles, a wiring error.
+func SpawnOrAttach(deps Deps, store Store, spec Spec) (*Record, bool, error) {
+	if !IsFixerRole(spec.Role) {
+		return nil, false, fmt.Errorf("gatefixer: %q is not a fixer role; way forward: spawn under %s or %s", spec.Role, RoleGateFixer, RoleVerifyFixer)
+	}
+	live, err := store.Live()
+	if err != nil {
+		return nil, false, fmt.Errorf("gatefixer: read the live %s record: %w", spec.Role, err)
+	}
+	if live != nil {
+		return live, false, nil
+	}
+	if err := os.Remove(spec.ReplyPath); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, false, fmt.Errorf("gatefixer: remove the stale %s reply %s: %w", spec.Role, spec.ReplyPath, err)
+	}
+
+	run, err := deps.Starter.Start(shuttleengine.Spec{
+		Prompt:      string(spec.Prompt),
+		OutputFiles: []string{spec.ReplyPath},
+		ModelChoice: spec.ModelChoice,
+		Skills:      spec.Skills,
+		Role:        spec.Role,
+		Segment:     spec.Segment,
+		Timeout:     spec.Timeout,
+	})
+	if err != nil {
+		return nil, false, markTransient(fmt.Errorf("gatefixer: start the %s: %w", spec.Role, err))
+	}
+	guid := run.StrandGUID()
+
+	runState, runDir, err := shuttleengine.FindRun(deps.ShuttleCfg, deps.AnchorRoot, guid)
+	if err != nil {
+		return nil, false, abandon(deps, guid, fmt.Errorf("gatefixer: resolve the spawned %s run: %w", spec.Role, err))
+	}
+	if deps.Register != nil {
+		if err := deps.Register(guid); err != nil {
+			return nil, false, abandon(deps, guid, fmt.Errorf("gatefixer: register the spawned %s: %w", spec.Role, err))
+		}
+	}
+	rec := &Record{
+		StrandGUID:    guid,
+		SessionID:     runState.SessionID,
+		Engine:        runState.Engine,
+		SpawnedAt:     deps.Clock.Now().UTC().Format(time.RFC3339),
+		ShuttleRunDir: runDir,
+		EventsPath:    runState.EventsPath,
+		EventsOffset:  runState.PromptOffset,
+		ReportPath:    spec.ReportPath,
+		ReplyPath:     spec.ReplyPath,
+	}
+	if err := store.Save(rec); err != nil {
+		return nil, false, abandon(deps, guid, fmt.Errorf("gatefixer: save the spawned %s record: %w", spec.Role, err))
+	}
+	return rec, true, nil
+}
+
+// abandon stops the strand a failed spawn left live and returns cause joined with the stop's own error, wrapped as transient.
+func abandon(deps Deps, guid string, cause error) error {
+	return markTransient(errors.Join(cause, deps.Stopper.StopStrand(guid)))
+}
+
+// markTransient marks err as an agent start failure a single re-run may clear.
+func markTransient(err error) error {
+	return shedengine.MarkTransient(shedengine.TransientAgentStart, err)
+}
diff --git a/internal/gatefixer/spawn_test.go b/internal/gatefixer/spawn_test.go
