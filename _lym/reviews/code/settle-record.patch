diff --git a/internal/loomshed/cleangate.go b/internal/loomshed/cleangate.go
new file mode 100644
index 00000000..f14ce13e
--- /dev/null
+++ b/internal/loomshed/cleangate.go
@@ -0,0 +1,27 @@
+// cleangate.go implements the clean gate, which holds a producing session at its turn end until its worktree holds no uncommitted or untracked path.
+
+package loomshed
+
+import (
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/verifytree"
+)
+
+// NewCleanGate returns a must-pass shuttleengine.Gate that fails while git reports any uncommitted or untracked path in worktreeRoot, ignored files excluded.
+// It exists so a writing session cannot end with a stray file, such as a shell redirect's output, that would halt a later row such as Finalize.
+// The findings name every path and ask the session to commit what belongs to its change and delete the rest.
+// A failure to read git is a returned error, since it is no defect the session can fix.
+func NewCleanGate(worktreeRoot string) shuttleengine.Gate {
+	return func() (shuttleengine.GateResult, error) {
+		dirty, err := verifytree.DirtyPaths(worktreeRoot)
+		if err != nil {
+			return shuttleengine.GateResult{}, fmt.Errorf("loomshed: clean gate: %w", err)
+		}
+		if len(dirty) == 0 {
+			return shuttleengine.GateResult{Passed: true}, nil
+		}
+		return shuttleengine.GateResult{Findings: verifytree.UncommittedFindings(dirty)}, nil
+	}
+}
diff --git a/internal/loomshed/cleangate_integration_test.go b/internal/loomshed/cleangate_integration_test.go
new file mode 100644
index 00000000..0acfe3ef
--- /dev/null
+++ b/internal/loomshed/cleangate_integration_test.go
@@ -0,0 +1,86 @@
+// cleangate_integration_test.go exercises NewCleanGate against a real scratch repo, so it carries the integration tier.
+
+package loomshed
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestCleanGate(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		dirty        func(t *testing.T, worktree string)
+		wantPassed   bool
+		wantFindings []string
+	}{
+		{
+			name:       "a clean tree passes",
+			dirty:      func(t *testing.T, worktree string) {},
+			wantPassed: true,
+		},
+		{
+			name: "an ignored file passes",
+			dirty: func(t *testing.T, worktree string) {
+				writeTestFile(t, filepath.Join(worktree, ".scratch", "notes.md"), "scratch\n")
+			},
+			wantPassed: true,
+		},
+		{
+			name: "an untracked file fails naming it",
+			dirty: func(t *testing.T, worktree string) {
+				writeTestFile(t, filepath.Join(worktree, "200k"), "cautious base est\n")
+			},
+			wantFindings: []string{"200k", "Commit each one that belongs to the change, delete the rest"},
+		},
+		{
+			name:         "a modified tracked file fails naming it",
+			dirty:        func(t *testing.T, worktree string) { writeTestFile(t, filepath.Join(worktree, "a.txt"), "changed\n") },
+			wantFindings: []string{"a.txt"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			worktree := t.TempDir()
+			gitkit.Git(t, worktree, "init", "-b", "main")
+			gitkit.Git(t, worktree, "config", "user.email", "test@test.com")
+			gitkit.Git(t, worktree, "config", "user.name", "Test")
+			gitkit.CommitFile(t, worktree, ".gitignore", ".scratch/\n", "ignore scratch")
+			gitkit.CommitFile(t, worktree, "a.txt", "a\n", "init")
+			tt.dirty(t, worktree)
+
+			got, err := NewCleanGate(worktree)()
+			if err != nil {
+				t.Fatalf("NewCleanGate()() error = %v; want nil", err)
+			}
+			if got.Passed != tt.wantPassed {
+				t.Errorf("NewCleanGate()() Passed = %v; want %v (findings %q)", got.Passed, tt.wantPassed, got.Findings)
+			}
+			for _, want := range tt.wantFindings {
+				if !strings.Contains(got.Findings, want) {
+					t.Errorf("NewCleanGate()() Findings = %q; want it to contain %q", got.Findings, want)
+				}
+			}
+		})
+	}
+}
+
+// writeTestFile writes content at path, creating its directory.
+func writeTestFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
