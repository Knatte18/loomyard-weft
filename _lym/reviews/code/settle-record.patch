+// loadState loads the state Run left in the fixture's run directory.
+func (f *runFixture) loadState() *weaverengine.State {
+	f.t.Helper()
+	st, err := weaverengine.LoadState(f.deps.Geom.RunDir, f.deps.Geom.ScratchDir)
