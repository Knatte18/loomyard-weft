+				}
+			},
+			func(t *testing.T, fixture *runFixture, events chan fswatch.Event) {
+				fixture.clock.waitRegistrations(t, 1)
+				fixture.clock.advance(time.Second)
+			},
+		},
+	}
+	for _, tt := range watchTests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
