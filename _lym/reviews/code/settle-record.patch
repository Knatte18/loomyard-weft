diff --git a/internal/ideconfig/config.go b/internal/ideconfig/config.go
new file mode 100644
index 00000000..09df10b1
--- /dev/null
+++ b/internal/ideconfig/config.go
@@ -0,0 +1,88 @@
+// config.go defines ide.yaml: the Config type, the template and spec accessors, and LoadConfig.
+
+package ideconfig
+
+import (
+	_ "embed"
+	"fmt"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed template.yaml
+var configTemplate string
+
+// ConfigTemplate returns the default YAML template for the ide config module.
+func ConfigTemplate() string {
+	return configTemplate
+}
+
+// configModule is the config module name ide.yaml is loaded under.
+const configModule = "ide"
+
+// Keys of ide.yaml.
+const (
+	openFilesKey      = "open_files"
+	renderMarkdownKey = "render_markdown"
+)
+
+// BeamPlaceholder is the text an open_files entry names to stand for the beam's slug.
+const BeamPlaceholder = "{beam}"
+
+// Config represents the resolved ide.yaml configuration.
+type Config struct {
+	// OpenFiles is the files a new window opens beside its folder or workspace, per place.
+	OpenFiles OpenFiles `yaml:"open_files"`
+	// RenderMarkdown reports whether a markdown file opens as VS Code's markdown preview in a seeded worktree.
+	RenderMarkdown bool `yaml:"render_markdown"`
+}
+
+// OpenFiles is one ordered list of open_files entries per place, each a path relative to the worktree's anchored directory that may name BeamPlaceholder.
+type OpenFiles struct {
+	Prime []string `yaml:"prime"`
+	Beam  []string `yaml:"beam"`
+	Task  []string `yaml:"task"`
+}
+
+// ConfigSpec returns the ide module's layered-load spec.
+// Both keys change only what a window shows, so the local layer may hold them.
+func ConfigSpec() configengine.Spec {
+	return configengine.Spec{
+		Name:     configModule,
+		Template: []byte(ConfigTemplate()),
+		HubWide:  true,
+		Categories: map[string]configengine.Category{
+			openFilesKey:      configengine.CategoryNone,
+			renderMarkdownKey: configengine.CategoryNone,
+		},
+	}
+}
+
+// LoadConfig loads and unmarshals the ide module's configuration through the hub-wide layer stack under dirs.
+// A hub whose base file is absent resolves the template under the local layer present, so opening a window never fails on a hub not yet reconciled.
+// It refuses an open_files entry that is empty, absolute or climbs out of the worktree, naming the key.
+func LoadConfig(dirs configengine.Dirs) (Config, error) {
+	resolved, err := configengine.LoadOrTemplate(dirs, ConfigSpec())
+	if err != nil {
+		return Config{}, err
+	}
+
+	var cfg Config
+	if err := yaml.Unmarshal(resolved, &cfg); err != nil {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("unmarshal ide config: %w", err))
+	}
+	places := []struct {
+		name    string
+		entries []string
+	}{{"prime", cfg.OpenFiles.Prime}, {"beam", cfg.OpenFiles.Beam}, {"task", cfg.OpenFiles.Task}}
+	for _, place := range places {
+		for _, entry := range place.entries {
+			if !filepath.IsLocal(filepath.FromSlash(entry)) {
+				return Config{}, configengine.MarkInvalid(fmt.Errorf("ide config key %q holds %q; want a path relative to the worktree's anchored directory that stays inside it", openFilesKey+"."+place.name, entry))
+			}
+		}
+	}
+	return cfg, nil
+}
diff --git a/internal/ideconfig/config_test.go b/internal/ideconfig/config_test.go
new file mode 100644
index 00000000..bac6a713
--- /dev/null
+++ b/internal/ideconfig/config_test.go
@@ -0,0 +1,88 @@
+// config_test.go covers ideconfig.LoadConfig over a bare board and anchor, with no hub and no spawn.
+
+package ideconfig_test
+
+import (
+	"errors"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/ideconfig"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestLoadConfig covers the template defaults, a hub file and a local override setting the keys, and the refused open_files entries.
+func TestLoadConfig(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		hub     string
+		local   string
+		want    ideconfig.Config
+		wantErr string
+	}{
+		{
+			name: "TemplateDefaults",
+			want: ideconfig.Config{OpenFiles: ideconfig.OpenFiles{Prime: []string{}, Beam: []string{"README.md"}, Task: []string{}}, RenderMarkdown: true},
+		},
+		{
+			name: "HubFileSetsBothKeys",
+			hub:  "open_files:\n  prime: [docs/overview.md]\n  beam: [README.md, \"docs/{beam}.md\"]\n  task: []\nrender_markdown: false\n",
+			want: ideconfig.Config{OpenFiles: ideconfig.OpenFiles{Prime: []string{"docs/overview.md"}, Beam: []string{"README.md", "docs/{beam}.md"}, Task: []string{}}},
+		},
+		{
+			name:  "LocalOverrideSetsRenderMarkdown",
+			local: "render_markdown: false\n",
+			want:  ideconfig.Config{OpenFiles: ideconfig.OpenFiles{Prime: []string{}, Beam: []string{"README.md"}, Task: []string{}}},
+		},
+		{name: "AbsoluteEntryRefused", hub: "open_files:\n  task: [/etc/hosts]\n", wantErr: `ide config key "open_files.task" holds "/etc/hosts"`},
+		{name: "ClimbingEntryRefused", hub: "open_files:\n  beam: [../README.md]\n", wantErr: `ide config key "open_files.beam" holds "../README.md"`},
+		{name: "EmptyEntryRefused", hub: "open_files:\n  prime: [\"\"]\n", wantErr: `ide config key "open_files.prime" holds ""`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			dirs := configengine.Dirs{Board: t.TempDir(), Anchor: t.TempDir()}
+			writeLayer(t, configengine.ConfigDir(dirs.Board), configengine.ConfigFile(dirs.Board, "ide"), tt.hub)
+			if tt.local != "" {
+				// The anchor gets a _lym/config/ too, since a worktree with no _lym/ stacks no local layer.
+				writeLayer(t, configengine.ConfigDir(dirs.Anchor), "", "")
+				writeLayer(t, configengine.ScratchDir(dirs.Anchor), configengine.LocalFile(dirs.Anchor, "ide"), tt.local)
+			}
+
+			got, err := ideconfig.LoadConfig(dirs)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) || !errors.Is(err, configengine.ErrInvalid) {
+					t.Fatalf("LoadConfig() error = %v; want an ErrInvalid error containing %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig() error = %v; want nil", err)
+			}
+			sameFiles := slices.Equal(got.OpenFiles.Prime, tt.want.OpenFiles.Prime) && slices.Equal(got.OpenFiles.Beam, tt.want.OpenFiles.Beam) && slices.Equal(got.OpenFiles.Task, tt.want.OpenFiles.Task)
+			if !sameFiles || got.RenderMarkdown != tt.want.RenderMarkdown {
+				t.Errorf("LoadConfig() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+// writeLayer creates dir and, when contents is not empty, writes contents to path.
+func writeLayer(t *testing.T, dir, path, contents string) {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatalf("MkdirAll(%q) = %v; want nil", dir, err)
+	}
+	if contents == "" {
+		return
+	}
+	if err := os.WriteFile(path, []byte(contents), 0o644); err != nil {
+		t.Fatalf("WriteFile(%q) = %v; want nil", path, err)
+	}
+}
