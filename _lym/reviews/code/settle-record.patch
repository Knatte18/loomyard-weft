+		if err != nil {
+			return true
+		}
+		for _, spec := range file.Imports {
+			path, err := strconv.Unquote(spec.Path.Value)
+			if err == nil && (path == lymbinDir || strings.HasSuffix(path, "/"+lymbinDir)) {
+				return true
+			}
+		}
+	}
+	return false
+}
