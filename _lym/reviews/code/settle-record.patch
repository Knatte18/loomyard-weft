+// raddlerecipe_test.go pins the raddle recipe's rows, their routing and the gate and budget its rows carry.
+
+package loomrecipe
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/contracts/recipes"
