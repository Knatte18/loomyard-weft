+func repointDependents(store *Store, runEntry string, sinks []string) error {
+	for i, task := range store.tasks {
+		if task.Slug == runEntry || isDone(task) || !slices.Contains(task.DependsOn, runEntry) {
+			continue
+		}
+		if RunHolds(task) {
