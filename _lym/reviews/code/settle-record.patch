+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxkit"
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxrec"
+)
+
+// writeDir, when set, is the directory the real-tmux test writes each scenario's recording into, instead of comparing.
+var writeDir = flag.String("tmuxrec.write", "", "write the recordings again from real tmux into this directory")
+
+// recordCommand is the command a recording names as its source.
+const recordCommand = "lym gate test --tier 2 ./internal/testkit/tmuxrec -- -run TestRecordings_RealTmux -tmuxrec.write <dir>"
+
+// paneEndPoll is how long a scenario waits between two status reads while a pane's process ends.
+const paneEndPoll = 200 * time.Millisecond
+
+// realTmux returns the run of tmuxPath on the server of the -L socket key socket, as reed's own tmux call runs it:
+// a server it starts reads no operator config, and a failure carries tmux's standard error in its text.
+func realTmux(tmuxPath, socket string) tmuxrec.TmuxRun {
+	return func(stdin []byte, args ...string) (string, error) {
+		full := append([]string{"-f", os.DevNull, "-L", socket}, args...)
+		logger.Debug("tmuxrec: tmux", "args", full)
+		cmd := exec.Command(tmuxPath, full...)
+		var stdout, stderr bytes.Buffer
+		cmd.Stdout, cmd.Stderr = &stdout, &stderr
+		if stdin != nil {
+			cmd.Stdin = bytes.NewReader(stdin)
+		}
+		err := cmd.Run()
+		if err != nil {
+			if msg := strings.TrimSpace(stderr.String()); msg != "" {
+				err = fmt.Errorf("%w: %s", err, msg)
+			}
+		}
+		return stdout.String(), err
+	}
+}
+
+// TestRecordings_RealTmux drives every scenario over real tmux and compares what reed read with its recording.
+// With -tmuxrec.write it writes each recording again instead.
+func TestRecordings_RealTmux(t *testing.T) {
+	tiergate.Require(t, 2)
+	t.Parallel()
+	tmuxPath, err := exec.LookPath("tmux")
+	if err != nil {
+		t.Skipf("no tmux binary on PATH: %v", err)
+	}
+	for name, scenario := range scenarios {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			socket := tmuxkit.Socket(t, tmuxPath)
+			recorder := tmuxrec.NewRecorder(socket, realTmux(tmuxPath, socket))
+			session := tmuxrec.RecordSession(t, recorder, scenario.startupTimeoutS)
+			endProcess := func(pid int) {
+				if err := proc.KillPID(pid); err != nil {
+					t.Fatalf("end the pane's process %d: %v", pid, err)
+				}
+			}
+
+			got := scenario.run(t, &world{session: session, endProcess: endProcess, wait: func() { time.Sleep(paneEndPoll) }})
+
+			rec, err := recorder.Recording(recordCommand, session, got)
+			if err != nil {
+				t.Fatalf("Recording() error = %v", err)
+			}
+			if *writeDir != "" {
+				if err := tmuxrec.Save(tmuxrec.Path(*writeDir, name), rec); err != nil {
+					t.Fatalf("Save() error = %v", err)
+				}
+				return
+			}
+			stored, err := tmuxrec.Load(tmuxrec.Path("testdata", name))
+			if err != nil {
+				t.Fatalf("Load() error = %v", err)
+			}
+			if diff := cmp.Diff(stored.Readings, rec.Readings); diff != "" {
+				t.Errorf("readings over real tmux mismatch (-recorded +got):\n%s", diff)
+			}
+		})
+	}
+}
diff --git a/internal/testkit/tmuxrec/recordings_test.go b/internal/testkit/tmuxrec/recordings_test.go
new file mode 100644
index 000000000..f545758de
--- /dev/null
+++ b/internal/testkit/tmuxrec/recordings_test.go
@@ -0,0 +1,112 @@
+// recordings_test.go replays each scenario over its recording, and pins what a replay refuses.
+
+package tmuxrec_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxrec"
+)
+
+func TestRecordings_Replay(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	for name, scenario := range scenarios {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			session, replay := tmuxrec.PlaySession(t, name)
+			t.Cleanup(func() {
+				if unanswered := replay.Unanswered(); len(unanswered) > 0 {
+					t.Errorf("recording %s holds no answer to %q", name, unanswered)
+				}
+			})
+			rec, err := tmuxrec.Embedded(name)
+			if err != nil {
+				t.Fatalf("Embedded(%q) error = %v", name, err)
+			}
+
+			got := scenario.run(t, &world{session: session, endProcess: func(int) {}, wait: func() {}})
+
+			if diff := cmp.Diff(rec.Readings, got); diff != "" {
+				t.Errorf("readings over the replay mismatch (-recorded +got):\n%s", diff)
+			}
+			if remaining := replay.Remaining(); len(remaining) > 0 {
+				t.Errorf("recorded changes the scenario never made: %q", remaining)
+			}
+		})
+	}
+}
+
+func TestReplay_RefusesWhatItsRecordingCannotAnswer(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	rec, err := tmuxrec.Embedded("session-start-stop")
+	if err != nil {
+		t.Fatalf("Embedded() error = %v", err)
+	}
+	recorded := func(prefix ...string) tmuxrec.Call {
+		for _, call := range rec.Calls {
+			if len(call.Args) >= len(prefix) && slices.Equal(call.Args[:len(prefix)], prefix) {
+				return call
+			}
+		}
+		t.Fatalf("the recording holds no call starting %q", prefix)
+		return tmuxrec.Call{}
+	}
+	read := recorded("has-session")
+	firstChange := recorded("new-session")
+	secondChange := recorded("set-option", "-g", "remain-on-exit")
+	changedArgs := firstChange
+	changedArgs.Args = firstChange.Args[:len(firstChange.Args)-1]
+	cut := rec
+	cut.Calls = []tmuxrec.Call{read, firstChange, secondChange}
+
+	tests := []struct {
+		name  string
+		calls []tmuxrec.Call
+		// wantRefused says for each call whether the replay refuses it.
+		wantRefused []bool
+	}{
+		{"AChangeOutOfItsRecordedOrder", []tmuxrec.Call{secondChange}, []bool{true}},
+		{"AChangeWithOtherArguments", []tmuxrec.Call{changedArgs}, []bool{true}},
+		{"AReadAfterAChangeWithNoRecordedReadSince", []tmuxrec.Call{read, firstChange, read}, []bool{false, false, true}},
+		{"AReadRepeatedBeforeTheNextChange", []tmuxrec.Call{read, read, firstChange}, []bool{false, false, false}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			replay := tmuxrec.NewReplay("cut", cut, tmuxrec.Bindings{})
+			tmux := replay.Outside(nil).Tmux
+
+			var refused []bool
+			for _, call := range tt.calls {
+				before := len(replay.Unanswered())
+				// A recorded failure is an answer too, so the refusal shows in Unanswered and not in the error.
+				_, _ = tmux(call.Capture, nil, call.Args...)
+				refused = append(refused, len(replay.Unanswered()) > before)
+			}
+
+			if diff := cmp.Diff(tt.wantRefused, refused); diff != "" {
+				t.Errorf("refused calls mismatch (-want +got):\n%s\nunanswered: %q", diff, replay.Unanswered())
+			}
+		})
+	}
+
+	t.Run("UnansweredNamesTheRefusedCall", func(t *testing.T) {
+		t.Parallel()
+		replay := tmuxrec.NewReplay("cut", cut, tmuxrec.Bindings{})
+
+		_, err := replay.Outside(nil).Tmux(false, nil, secondChange.Args...)
+
+		if err == nil {
+			t.Errorf("Tmux() error = nil; want the refusal")
+		}
+		if diff := cmp.Diff([]string{"tmux set-option -g remain-on-exit on"}, replay.Unanswered()); diff != "" {
+			t.Errorf("Unanswered() mismatch (-want +got):\n%s", diff)
+		}
+	})
+}
diff --git a/internal/testkit/tmuxrec/scenarios_test.go b/internal/testkit/tmuxrec/scenarios_test.go
new file mode 100644
index 000000000..6f206b1e3
--- /dev/null
+++ b/internal/testkit/tmuxrec/scenarios_test.go
@@ -0,0 +1,141 @@
+// scenarios_test.go holds the scenarios the package's recordings were made from, and what drives them.
+
+package tmuxrec_test
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/agentconfig"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tmuxrec"
+)
+
+// paneEndPolls is how many status reads a scenario makes at most while a pane's process ends.
+const paneEndPolls = 50
+
+// world is what a scenario drives: the session, and how a pane's process ends in it.
+type world struct {
+	session *tmuxrec.Session
+	// endProcess ends the process pid, the process of a strand's pane.
+	// Over a replay the recording holds the end, so it does nothing.
+	endProcess func(pid int)
+	// wait spaces two reads while a pane's process ends.
+	wait func()
+}
+
+// sessionSpec is the spec the recorded sessions start under: an interactive, unawaited PR reviewer.
+func sessionSpec(resume string) shuttleengine.Spec {
+	return shuttleengine.Spec{
+		Prompt:          "Review the pull request.",
+		PromptEngine:    tmuxrec.EngineName,
+		ModelChoice:     shuttleengine.ModelChoice{Engine: tmuxrec.EngineName, Model: "fixture-model"},
+		Interactive:     true,
+		Unawaited:       true,
+		DenyPublish:     true,
+		Role:            string(agentconfig.RolePRReviewer),
+		Segment:         segmentcolor.Landing,
+		ConfigRole:      agentconfig.RolePRReviewer,
+		ResumeSessionID: resume,
+	}
+}
+
+// reading reads reed's strand table as the scenario's step.
+func reading(w *world, step string) tmuxrec.Reading {
+	status, err := w.session.Reed.Status()
+	got := tmuxrec.Reading{Step: step}
+	if err != nil {
+		got.Err = err.Error()
+		return got
+	}
+	for _, strand := range status.Strands {
+		got.Strands = append(got.Strands, tmuxrec.StrandReading{GUID: strand.GUID, Name: strand.Name, Live: strand.Live, Retiring: strand.Retiring})
+	}
+	return got
+}
+
+// notStarted is the error a reading records for a start whose provider never came up.
+const notStarted = "the provider did not start"
+
+// scenario is one recorded scenario: the runner's startup timeout it runs under, and its steps.
+// The steps return what reed read at each.
+type scenario struct {
+	startupTimeoutS int
+	run             func(t *testing.T, w *world) []tmuxrec.Reading
+}
+
+// sessionStartupTimeoutS gives a session's provider time to come up.
+const sessionStartupTimeoutS = 30
+
+// scenarios are the package's recorded scenarios, by recording name.
+// Each reads the strand table before any session starts.
+var scenarios = map[string]scenario{
+	// A session starts, is stopped, starts again resuming its provider session, and is stopped again.
+	"session-start-stop": {startupTimeoutS: sessionStartupTimeoutS, run: func(t *testing.T, w *world) []tmuxrec.Reading {
+		runner := w.session.Runner
+		readings := []tmuxrec.Reading{reading(w, "before")}
+		first, err := runner.StartSession(sessionSpec(""))
+		if err != nil {
+			t.Fatalf("StartSession() error = %v", err)
+		}
+		readings = append(readings, reading(w, "started"))
+		if err := runner.StopStrand(first.StrandGUID); err != nil {
+			t.Fatalf("StopStrand(%q) error = %v", first.StrandGUID, err)
+		}
+		readings = append(readings, reading(w, "stopped"))
+		second, err := runner.StartSession(sessionSpec(first.SessionID))
+		if err != nil {
+			t.Fatalf("StartSession() of the resume error = %v", err)
+		}
+		readings = append(readings, reading(w, "resumed"))
+		if err := runner.StopStrand(second.StrandGUID); err != nil {
+			t.Fatalf("StopStrand(%q) error = %v", second.StrandGUID, err)
+		}
+		return append(readings, reading(w, "stopped again"))
+	}},
+	// A session starts, its pane's process ends, and the strand is stopped.
+	"session-ends": {startupTimeoutS: sessionStartupTimeoutS, run: func(t *testing.T, w *world) []tmuxrec.Reading {
+		runner := w.session.Runner
+		readings := []tmuxrec.Reading{reading(w, "before")}
+		started, err := runner.StartSession(sessionSpec(""))
+		if err != nil {
+			t.Fatalf("StartSession() error = %v", err)
+		}
+		readings = append(readings, reading(w, "started"))
+		status, err := w.session.Reed.Status()
+		if err != nil || len(status.Strands) != 1 {
+			t.Fatalf("Status() = %+v, %v; want the one started strand", status, err)
+		}
+		w.endProcess(status.Strands[0].PanePID)
+		var last tmuxrec.Reading
+		ended := false
+		for range paneEndPolls {
+			last = reading(w, "ended")
+			if len(last.Strands) == 1 && !last.Strands[0].Live {
+				ended = true
+				break
+			}
+			w.wait()
+		}
+		if !ended {
+			t.Fatalf("no reading found the strand dead in paneEndPolls = %d reads; last = %+v", paneEndPolls, last)
+		}
+		readings = append(readings, last)
+		if err := runner.StopStrand(started.StrandGUID); err != nil {
+			t.Fatalf("StopStrand(%q) error = %v", started.StrandGUID, err)
+		}
+		return append(readings, reading(w, "stopped"))
+	}},
+	// A session starts under a runner that gives its provider no time, and the provider is never up.
+	"session-not-started": {startupTimeoutS: 0, run: func(t *testing.T, w *world) []tmuxrec.Reading {
+		w.session.Engine.StartupFn = func(string) shuttleengine.StartupState { return shuttleengine.StartupPending }
+		readings := []tmuxrec.Reading{reading(w, "before")}
+		_, err := w.session.Runner.StartSession(sessionSpec(""))
+		if !errors.Is(err, shuttleengine.ErrNotStarted) {
+			t.Fatalf("StartSession() error = %v; want one wrapping ErrNotStarted", err)
+		}
+		readings = append(readings, tmuxrec.Reading{Step: "start", Err: notStarted})
+		return append(readings, reading(w, "after"))
+	}},
+}
diff --git a/internal/testkit/tmuxrec/session.go b/internal/testkit/tmuxrec/session.go
new file mode 100644
index 000000000..ffdda56bc
--- /dev/null
+++ b/internal/testkit/tmuxrec/session.go
@@ -0,0 +1,187 @@
+// session.go builds the session world every recording of the package was made in:
+// a real session runner over a real reed engine, whose outside is a recorder or a replay.
+
+package tmuxrec
+
+import (
+	"embed"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/user"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/reedengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/shuttlefake"
+)
+
+// The names and launch every recorded session runs under.
+const (
+	// WorktreeName is the base name of the worktree, and so reed's session name.
+	WorktreeName = "pr-session"
+	// Shortname starts every strand name.
+	Shortname = "tr"
+	// EngineName registers the session's engine.
+	EngineName = "claude"
+	// LaunchCmd is the command the session's pane runs: a process that stays up until it is ended.
+	LaunchCmd = "sleep 3600"
+	// SessionID is the provider session id every start of the engine reports.
+	SessionID = "sess-1"
+	// GUIDPrefix starts each strand guid the session's reed mints, followed by the strand's start count.
+	GUIDPrefix = "guid-"
+)
+
+// recordings holds every recording of the package.
+//
+//go:embed testdata/*.json
+var recordings embed.FS
+
+// Session is a session runner over a real reed engine, built as every recording of the package was made.
+type Session struct {
+	// Hub is the session's hub directory, and Worktree its worktree under it.
+	Hub      string
+	Worktree string
+	// RunDir is the directory the runner makes each run's directory in.
+	RunDir string
+	// StateDir is the directory reed keeps its state and operation lock in.
+	StateDir string
+	// StartupTimeoutS is the runner's startup timeout, in seconds; 0 ends a start whose provider is not up at once.
+	StartupTimeoutS int
+	// Bindings binds the placeholders of the session's recordings to its directories.
+	Bindings Bindings
+	Reed     *reedengine.Engine
+	// Engine is the provider engine the runner starts, the one stand-in above reed.
+	Engine *shuttlefake.Engine
+	Runner *shuttleengine.Runner
+}
+
+// replaySocket is the -L socket key a replayed session's reed is told; no server listens on it.
+const replaySocket = "tmuxrec-replay"
+
+// newSession builds a session in fresh directories whose reed is told the -L socket key socket.
+// That reed reaches the outside that outside returns for the session's bindings and guid source.
+// Its runner gives a provider startupTimeoutS seconds to come up.
+func newSession(t testing.TB, socket string, startupTimeoutS int, outside func(bindings Bindings, newGUID func() (string, error)) reedengine.Outside) *Session {
+	t.Helper()
+	hub := t.TempDir()
+	bindings := Bindings{"{hub}": hub, "{tmp}": os.TempDir(), "{socket}": socket}
+	// A pane's title and prompt name the machine and the user, which a recording keeps as placeholders.
+	if host, err := os.Hostname(); err == nil {
+		bindings["{host}"] = host
+	}
+	if account, err := user.Current(); err == nil {
+		bindings["{user}"] = account.Username
+	}
+	// The uid is bound only where a socket path or a unit name spells it, since a bare number also names panes and sizes.
+	// Windows has no uid and answers -1.
+	if uid := os.Getuid(); uid >= 0 {
+		for _, prefix := range []string{"tmux-", "user-", "user@"} {
+			bindings[prefix+"{uid}"] = prefix + strconv.Itoa(uid)
+		}
+	}
+	worktree := filepath.Join(hub, WorktreeName)
+	if err := os.MkdirAll(worktree, 0o755); err != nil {
+		t.Fatalf("tmuxrec: create the worktree: %v", err)
+	}
+	cfg, err := reedengine.LoadConfig(configengine.Dirs{Anchor: hub}, "reed")
+	if err != nil {
+		t.Fatalf("tmuxrec: load the reed config template: %v", err)
+	}
+	// Reed pins the session's shell by the path the executable search finds, which differs between hosts.
+	shellPath, err := reedengine.ResolveShellPath(cfg.Shell)
+	if err != nil {
+		t.Fatalf("tmuxrec: %v", err)
+	}
+	bindings["{shell}"] = shellPath
+	geom := reedengine.Geometry{
+		SocketKey:     socket,
+		SessionName:   reedengine.SessionName(worktree),
+		AnchorPath:    worktree,
+		PaneCwd:       worktree,
+		WorktreeRoot:  worktree,
+		LogsDir:       filepath.Join(hub, "logs"),
+		WorktreeName:  WorktreeName,
+		HubPath:       hub,
+		NameShortname: Shortname,
+	}
+	scrub := reedengine.EnvScrub{Names: []string{"CLAUDECODE"}, Prefixes: []string{"CLAUDE_CODE_"}}
+	reed := reedengine.NewOver(cfg, geom, scrub, outside(bindings, guidSequence()))
+
+	engine := &shuttlefake.Engine{PrepareLaunch: &shuttleengine.Launch{Cmd: LaunchCmd, SessionID: SessionID}}
+	engines := shuttleengine.NewEngineSet(EngineName, map[string]shuttleengine.Engine{EngineName: &shuttlefake.ResumeEngine{Engine: engine}})
+	runnerCfg := shuttleengine.Config{
+		RunDir:          filepath.Join(hub, "runs"),
+		RunTimeoutMin:   60,
+		StartupTimeoutS: startupTimeoutS,
+		Agents:          shuttlefake.Agents(t),
+	}
+	return &Session{
+		Hub:             hub,
+		Worktree:        worktree,
+		RunDir:          runnerCfg.RunDir,
+		StateDir:        filepath.Join(worktree, lymdirs.DotLymDirName),
+		StartupTimeoutS: startupTimeoutS,
+		Bindings:        bindings,
+		Reed:            reed,
+		Engine:          engine,
+		Runner:          shuttleengine.NewRunner(reed, engines, worktree, worktree, runnerCfg),
+	}
+}
+
+// guidSequence returns a guid source that mints GUIDPrefix and the count of guids minted so far, from 1.
+func guidSequence() func() (string, error) {
+	n := 0
+	return func() (string, error) {
+		n++
+		return GUIDPrefix + strconv.Itoa(n), nil
+	}
+}
+
+// RecordSession builds a session whose reed runs on the real tmux server rec runs on, through rec.
+// Its runner gives a provider startupTimeoutS seconds to come up.
+func RecordSession(t testing.TB, rec *Recorder, startupTimeoutS int) *Session {
+	t.Helper()
+	return newSession(t, rec.socket, startupTimeoutS, func(_ Bindings, newGUID func() (string, error)) reedengine.Outside {
+		return rec.Outside(newGUID)
+	})
+}
+
+// PlaySession builds a session whose reed answers from the package's recording named name.
+// The runner's startup timeout is the one the recording was made under.
+// It skips the test on an operating system other than the recording's, whose tmux calls differ.
+// A call the recording holds no answer to fails in reed; the returned replay lists those calls for the test to check.
+func PlaySession(t testing.TB, name string) (*Session, *Replay) {
+	t.Helper()
+	rec, err := Embedded(name)
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	if rec.Source.OS != runtime.GOOS {
+		t.Skipf("tmuxrec: no recording %s made on %s; the stored one was made on %s", name, runtime.GOOS, rec.Source.OS)
+	}
+	var replay *Replay
+	session := newSession(t, replaySocket, rec.StartupTimeoutS, func(bindings Bindings, newGUID func() (string, error)) reedengine.Outside {
+		replay = NewReplay(name, rec, bindings)
+		return replay.Outside(newGUID)
+	})
+	return session, replay
+}
+
+// Embedded returns the package's recording named name.
+func Embedded(name string) (Recording, error) {
+	data, err := recordings.ReadFile("testdata/" + name + ".json")
+	if err != nil {
+		return Recording{}, fmt.Errorf("tmuxrec: no recording named %s: %w", name, err)
+	}
+	var rec Recording
+	if err := json.Unmarshal(data, &rec); err != nil {
+		return Recording{}, fmt.Errorf("tmuxrec: decode recording %s: %w", name, err)
+	}
+	return rec, nil
+}
diff --git a/internal/testkit/tmuxrec/testdata/session-ends.json b/internal/testkit/tmuxrec/testdata/session-ends.json
new file mode 100644
index 000000000..a609c2f3d
--- /dev/null
+++ b/internal/testkit/tmuxrec/testdata/session-ends.json
