diff --git a/internal/orchengine/reinterpret.go b/internal/orchengine/reinterpret.go
new file mode 100644
index 000000000..080e32d1d
--- /dev/null
+++ b/internal/orchengine/reinterpret.go
@@ -0,0 +1,36 @@
+// reinterpret.go carries a hub's orch.yaml across the change of remote_control's default from on to off.
+
+package orchengine
+
+import (
+	"fmt"
+
+	"gopkg.in/yaml.v3"
+)
+
+// RemoteControlOffReinterpretationID names the change that turned remote_control's default from on to off.
+const RemoteControlOffReinterpretationID = "orch-remote-control-off-by-default"
+
+// remoteControlKey is the orch.yaml key whose default the change turned off.
+const remoteControlKey = "remote_control"
+
+// FlagRemoteControlDefault carries a hub orch.yaml across the change of remote_control's default from on to off.
+// A file that sets no remote_control took remote control on before the change and takes it off now.
+// The operator decides when an orch session gets remote control.
+// Such a file is flagged with the way forward that turns it back on, and left unchanged.
+// A file that sets remote_control keeps its value and is neither changed nor flagged.
+// The worktree root and anchored directory arguments are unused, as the check judges the file alone.
+func FlagRemoteControlDefault(existing []byte, _, _ string) (rewritten []byte, rewrote, flagged []string, err error) {
+	var keys map[string]yaml.Node
+	if err := yaml.Unmarshal(existing, &keys); err != nil {
+		return nil, nil, nil, fmt.Errorf("parse the orch config: %w", err)
+	}
+	if _, set := keys[remoteControlKey]; set {
+		return existing, nil, nil, nil
+	}
+	return existing, nil, []string{fmt.Sprintf(
+		"sets no %s, whose default is now off, so the orch starts without remote control; "+
+			"to keep it on for every orch session, run `lym config orch --set %s=true` from the prime, "+
+			"or click the RC button of a pane to turn it on for that agent",
+		remoteControlKey, remoteControlKey)}, nil
+}
diff --git a/internal/orchengine/reinterpret_test.go b/internal/orchengine/reinterpret_test.go
new file mode 100644
index 000000000..28c4d7af9
--- /dev/null
+++ b/internal/orchengine/reinterpret_test.go
@@ -0,0 +1,60 @@
+// reinterpret_test.go covers FlagRemoteControlDefault over hub orch.yaml bytes.
+
+package orchengine_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/orchengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestFlagRemoteControlDefault pins the outcomes of the check.
+// A file that sets no remote_control is flagged with the step that turns it on and left unchanged.
+// A file that sets it, on or off, is neither changed nor flagged.
+// A file that is no mapping fails to parse.
+func TestFlagRemoteControlDefault(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	const wayForward = "`lym config orch --set remote_control=true`"
+	tests := []struct {
+		name        string
+		input       string
+		wantFlagged bool
+		wantError   bool
+	}{
+		{name: "OtherKeysOnly", input: "model: sonnet\n", wantFlagged: true},
+		{name: "HeaderOnly", input: "# tuned for this hub\n", wantFlagged: true},
+		{name: "SetOn", input: "remote_control: true\n"},
+		{name: "SetOff", input: "model: sonnet\nremote_control: false\n"},
+		{name: "NotAMapping", input: "- a\n- b\n", wantError: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			rewritten, rewrote, flagged, err := orchengine.FlagRemoteControlDefault([]byte(tt.input), "", "")
+			if tt.wantError {
+				if err == nil {
+					t.Errorf("FlagRemoteControlDefault(%q) = nil error; want a parse error", tt.input)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("FlagRemoteControlDefault(%q): %v", tt.input, err)
+			}
+			if string(rewritten) != tt.input {
+				t.Errorf("FlagRemoteControlDefault(%q) rewritten = %q; want the input unchanged", tt.input, rewritten)
+			}
+			if len(rewrote) != 0 {
+				t.Errorf("FlagRemoteControlDefault(%q) rewrote = %v; want none", tt.input, rewrote)
+			}
+			switch {
+			case tt.wantFlagged && (len(flagged) != 1 || !strings.Contains(flagged[0], wayForward)):
+				t.Errorf("FlagRemoteControlDefault(%q) flagged = %v; want one line naming %s", tt.input, flagged, wayForward)
+			case !tt.wantFlagged && len(flagged) != 0:
+				t.Errorf("FlagRemoteControlDefault(%q) flagged = %v; want none", tt.input, flagged)
+			}
+		})
+	}
+}
diff --git a/internal/orchengine/revival.go b/internal/orchengine/revival.go
new file mode 100644
index 000000000..f07634884
--- /dev/null
+++ b/internal/orchengine/revival.go
@@ -0,0 +1,38 @@
+// revival.go drops remote control from an orch strand's stored command line when orch.yaml has it off.
+
+package orchengine
+
+import (
+	"regexp"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// remoteControlArgument matches a ` --remote-control <name>` pair in a stored launch line.
+// The name may be quoted for either pane shell.
+var remoteControlArgument = regexp.MustCompile(`\s--remote-control\s+(?:'(?:[^']|'\\''|'')*'|\S+)`)
+
+// StripRemoteControlArgument returns line without its --remote-control argument and the session name that follows it.
+// A line with no such argument is returned unchanged.
+func StripRemoteControlArgument(line string) string {
+	return remoteControlArgument.ReplaceAllString(line, "")
+}
+
+// RevivalFilter returns the rewrite a reed resume or relaunch applies to a stored command line.
+// The line keeps its --remote-control argument only while the orch.yaml under dirs sets remote_control on.
+// The file is read at each call, so a change to it applies to the next revival.
+// A file that cannot be loaded cannot ask for remote control, so the argument is dropped then.
+func RevivalFilter(dirs configengine.Dirs) func(line string) string {
+	return func(line string) string {
+		cfg, err := LoadConfig(dirs, "orch")
+		if err != nil {
+			logger.Warn("orch: dropping remote control from a revived session, since orch.yaml does not load", "err", err)
+			return StripRemoteControlArgument(line)
+		}
+		if cfg.RemoteControl {
+			return line
+		}
+		return StripRemoteControlArgument(line)
+	}
+}
