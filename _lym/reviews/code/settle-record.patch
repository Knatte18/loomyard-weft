--- /dev/null
+++ b/internal/stencilstore/export_test.go
@@ -0,0 +1,21 @@
+// export_test.go exposes the process-global skew state to the external tests of package stencilstore.
+
+package stencilstore
+
+import "testing"
+
+// SetSkewStateForTest sets the shipped registry, the running writer and the writer ordering for the calling test.
+// It restores the previous state when the test ends.
+// It changes process-global state, so a test that calls it must not call t.Parallel.
+func SetSkewStateForTest(t *testing.T, registry Registry, running Writer, older func(recorded Writer) Ordering) {
+	t.Helper()
+	previousShipped, previousRunning, previousOlder := shipped, runningWriter, shippedOrdering.Load()
+	shipped = registry
+	runningWriter = func() Writer { return running }
+	RegisterOrdering(older)
+	t.Cleanup(func() {
+		shipped = previousShipped
+		runningWriter = previousRunning
+		shippedOrdering.Store(previousOlder)
+	})
+}
diff --git a/internal/stencilstore/reconcile.go b/internal/stencilstore/reconcile.go
index 81ddcb6b..ea0684bb 100644
--- a/internal/stencilstore/reconcile.go
+++ b/internal/stencilstore/reconcile.go
@@ -24,13 +24,18 @@ const gitattributesContent = "*.md text eol=lf\n"
 
 // Read reads name's current content from baseDir with a plain os.ReadFile on every call.
 // It does no caching, so an on-disk edit takes effect on the next Read.
-// It never falls back to a shipped default and never writes.
+// It never writes.
+// It refuses a board copy that a newer binary wrote, with a *NewerBoardCopyError.
+// That applies once the embedding package has registered its defaults through RegisterShipped.
 // A missing file is reported as an error, not silently substituted.
 func Read(baseDir, name string) ([]byte, error) {
 	content, err := os.ReadFile(Path(baseDir, name))
 	if err != nil {
 		return nil, fmt.Errorf("stencilstore: read stencil %q from %s: %w", name, baseDir, err)
 	}
+	if err := refuseNewerBoardCopy(name, content); err != nil {
+		return nil, err
+	}
 	return content, nil
 }
 
diff --git a/internal/stencilstore/skew.go b/internal/stencilstore/skew.go
new file mode 100644
index 00000000..bcb13d50
--- /dev/null
+++ b/internal/stencilstore/skew.go
@@ -0,0 +1,102 @@
+// skew.go refuses to render a board copy that a newer lym binary wrote, since the running binary may not understand it.
+// A long-running process would otherwise fail mid-run with a bare template error.
+
+package stencilstore
+
+import (
+	"fmt"
+	"sync"
+	"sync/atomic"
+
+	"github.com/Knatte18/loomyard/internal/buildvcs"
+)
+
+// shipped is the registry of the stencils embedded in the running binary, set at package init by RegisterShipped.
+// It is only compared against, never rendered from.
+// A nil shipped turns the refusal off.
+var shipped Registry
+
+// shippedOrdering is the caller's ordering of a recorded writer against the running binary, set by RegisterOrdering.
+// A nil pointer means no ordering is registered.
+var shippedOrdering atomic.Pointer[func(recorded Writer) Ordering]
+
+// runningWriter is the running binary as a board copy's writer, read once per process.
+var runningWriter = sync.OnceValue(func() Writer {
+	id := buildvcs.Running()
+	return Writer{Revision: id.Revision, Time: id.Time}
+})
+
+// NewerBoardCopyError reports that a stencil's board copy was written by a lym binary newer than the running one.
+// The running binary's renderer may not understand that copy's text, so the read is refused and the board is left alone.
+type NewerBoardCopyError struct {
+	Stencil   string
+	WrittenBy string
+	Running   string
+}
+
+// Error names the stencil, the writer's revision, the running revision, and the way forward.
+func (e *NewerBoardCopyError) Error() string {
+	return fmt.Sprintf("stencilstore: stencil %q was written by lym build %s, which is newer than the running build %s, and this process may not render it; way forward: restart the run's driver on the current lym binary, and update that binary first if it is older than the board", e.Stencil, e.WrittenBy, e.Running)
+}
+
+// RegisterShipped names the registry of the stencils embedded in the running binary.
+// From then on, a read of a board copy that a newer binary wrote is a *NewerBoardCopyError.
+// A copy whose body equals its shipped default is not refused.
+// The registry is only compared against; no read returns its bytes.
+// The owner of the registry calls it once, from its package init; a second call panics.
+func RegisterShipped(registry Registry) {
+	if shipped != nil {
+		panic("stencilstore: RegisterShipped called a second time")
+	}
+	shipped = registry
+}
+
+// RegisterOrdering names how to order a recorded writer against the running binary, normally by build ancestry.
+// A recorded writer counts as newer when older answers RecordedNotOlder and its revision differs from the running one.
+// With no ordering registered, or after a nil older, commit time decides.
+// Then a recorded writer counts as newer only when its commit time is after the running binary's.
+// A writer or running binary with no commit time is never newer.
+func RegisterOrdering(older func(recorded Writer) Ordering) {
+	if older == nil {
+		shippedOrdering.Store(nil)
+		return
+	}
+	shippedOrdering.Store(&older)
+}
+
+// refuseNewerBoardCopy returns a *NewerBoardCopyError when a binary newer than the running one wrote onDisk.
+// onDisk is the board copy of the stencil name.
+// A copy whose body equals the stencil's shipped default is never refused.
+// An edited copy is refused the same as an untouched one; neither is written or replaced.
+// Every other copy, including any copy of a stencil the binary does not ship, returns nil.
+func refuseNewerBoardCopy(name string, onDisk []byte) error {
+	if shipped == nil {
+		return nil
+	}
+	def, known := shipped.Default(name)
+	if !known {
+		return nil
+	}
+	// The body comparison runs first: it is cheap, and the registered ordering may run git.
+	if BodyHash(onDisk) == BodyHash(def) {
+		return nil
+	}
+	running := runningWriter()
+	recorded := ParseWriter(onDisk)
+	if !writtenByNewerBinary(running, recorded) {
+		return nil
+	}
+	return &NewerBoardCopyError{Stencil: name, WrittenBy: recorded.Revision, Running: running.Revision}
+}
+
+// writtenByNewerBinary reports whether recorded names a build newer than running.
+// A recorded writer with no revision, or running's own revision, is never newer.
+func writtenByNewerBinary(running, recorded Writer) bool {
+	if recorded.Revision == "" || recorded.Revision == running.Revision {
+		return false
+	}
+	if older := shippedOrdering.Load(); older != nil {
+		return (*older)(recorded) == RecordedNotOlder
+	}
+	return !running.Time.IsZero() && recorded.Time.After(running.Time)
+}
diff --git a/internal/stencilstore/skew_test.go b/internal/stencilstore/skew_test.go
new file mode 100644
index 00000000..ff259915
--- /dev/null
+++ b/internal/stencilstore/skew_test.go
@@ -0,0 +1,193 @@
+// skew_test.go covers when a read refuses a board copy that a newer lym binary wrote.
+
+package stencilstore_test
+
+import (
+	"bytes"
+	"errors"
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// skewRegistry is a stencilstore.Registry of fixed shipped defaults.
+type skewRegistry map[string][]byte
+
+// Names implements stencilstore.Registry.
+func (r skewRegistry) Names() []string {
+	return slices.Sorted(maps.Keys(r))
+}
+
+// Default implements stencilstore.Registry.
+func (r skewRegistry) Default(name string) ([]byte, bool) {
+	content, ok := r[name]
+	return content, ok
+}
+
+// writeBoardFile writes content at name's path under baseDir, creating its directories.
+func writeBoardFile(t *testing.T, baseDir, name string, content []byte) {
+	t.Helper()
+	path := stencilstore.Path(baseDir, name)
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("os.MkdirAll(%s) failed: %v", filepath.Dir(path), err)
+	}
+	if err := os.WriteFile(path, content, 0o644); err != nil {
+		t.Fatalf("os.WriteFile(%s) failed: %v", path, err)
+	}
+}
+
+// skewReadEntry is one public read path that reaches a board copy.
+// It holds the copy's stencil name, the stencil that includes it when it is not read directly, and the read itself.
+type skewReadEntry struct {
+	target  string
+	top     string
+	topBody string
+	read    func(baseDir string) (string, error)
+}
+
+// TestReadRefusesBoardCopyFromNewerBinary pins when a read refuses a board copy and when it returns it as it stands.
+// A copy a newer binary wrote with a body of its own is refused, edited or not, whatever read path reaches it.
+// Every refusal and every pass leaves the board file unchanged.
+// It is not parallel: stencilstore.SetSkewStateForTest replaces process-global state.
+func TestReadRefusesBoardCopyFromNewerBinary(t *testing.T) {
+	tiergate.Require(t, 0)
+
+	const shippedBody = "The running binary's text.\n"
+	const newerBody = "The newer binary's text.\n"
+	runningTime := time.Date(2026, 11, 18, 12, 0, 0, 0, time.UTC)
+	running := stencilstore.Writer{Revision: "running", Time: runningTime}
+	newer := stencilstore.Writer{Revision: "newer", Time: runningTime.Add(time.Hour)}
+	older := stencilstore.Writer{Revision: "older", Time: runningTime.Add(-time.Hour)}
+	sibling := stencilstore.Writer{Revision: "sibling", Time: runningTime}
+	descendantEqualTime := stencilstore.Writer{Revision: "descendant", Time: runningTime}
+	descendantEarlierTime := stencilstore.Writer{Revision: "descendant", Time: runningTime.Add(-time.Hour)}
+
+	orderedAs := func(ordering stencilstore.Ordering) func(stencilstore.Writer) stencilstore.Ordering {
+		return func(stencilstore.Writer) stencilstore.Ordering { return ordering }
+	}
+
+	const topLevel = "gatefix-body-test"
+	readTopLevel := skewReadEntry{
+		target: topLevel,
+		read: func(baseDir string) (string, error) {
+			content, err := stencilstore.Read(baseDir, topLevel)
+			return string(content), err
+		},
+	}
+	const plainInclude = "gatefix-frag-test"
+	readPlainInclude := skewReadEntry{
+		target:  plainInclude,
+		top:     "gatefix-top-test",
+		topBody: "Top.\n{{template \"" + plainInclude + "\"}}\n",
+		read: func(baseDir string) (string, error) {
+			content, err := stencilstore.ReadForEngine(baseDir, "claude", "gatefix-top-test")
+			return string(content), err
+		},
+	}
+	readEngineBlock := skewReadEntry{
+		target:  stencilstore.EngineBlockName("claude", "gatefix-block"),
+		top:     "gatefix-top-test",
+		topBody: "Top.\n{{template \"engine-gatefix-block\"}}\n",
+		read: func(baseDir string) (string, error) {
+			body, blocks, err := stencilstore.ReadSet(baseDir, "claude", "gatefix-top-test")
+			var text strings.Builder
+			text.Write(body)
+			for _, block := range blocks {
+				text.Write(block)
+			}
+			return text.String(), err
+		},
+	}
+
+	tests := []struct {
+		name       string
+		entry      skewReadEntry
+		recorded   stencilstore.Writer
+		body       string
+		edited     bool
+		running    stencilstore.Writer
+		older      func(stencilstore.Writer) stencilstore.Ordering
+		unshipped  bool
+		wantRefuse bool
+	}{
+		{name: "NewerWriterTopLevel", entry: readTopLevel, recorded: newer, wantRefuse: true},
+		{name: "NewerWriterPlainInclude", entry: readPlainInclude, recorded: newer, wantRefuse: true},
+		{name: "NewerWriterEngineBlock", entry: readEngineBlock, recorded: newer, wantRefuse: true},
+		{name: "EditedCopyFromANewerWriter", entry: readTopLevel, recorded: newer, edited: true, wantRefuse: true},
+		{name: "OlderWriter", entry: readTopLevel, recorded: older},
+		{name: "EqualCommitTime", entry: readTopLevel, recorded: sibling},
+		{name: "NoRecordedWriter", entry: readTopLevel},
+		{name: "NewerWriterWithTheShippedBody", entry: readTopLevel, recorded: newer, body: shippedBody},
+		{name: "RunningBinaryWithNoCommitTime", entry: readTopLevel, recorded: newer, running: stencilstore.Writer{Revision: "running"}},
+		{name: "StencilTheBinaryDoesNotShip", entry: readTopLevel, recorded: newer, unshipped: true},
+		{name: "DescendantWriterWithEqualCommitTime", entry: readTopLevel, recorded: descendantEqualTime, older: orderedAs(stencilstore.RecordedNotOlder), wantRefuse: true},
+		{name: "DescendantWriterWithEarlierCommitTime", entry: readTopLevel, recorded: descendantEarlierTime, older: orderedAs(stencilstore.RecordedNotOlder), wantRefuse: true},
+		{name: "AncestorWriterWithLaterCommitTime", entry: readTopLevel, recorded: newer, older: orderedAs(stencilstore.RecordedOlder)},
+		{name: "UnknownOrdering", entry: readTopLevel, recorded: newer, older: orderedAs(stencilstore.OrderingUnknown)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.body == "" {
+				tt.body = newerBody
+			}
+			if tt.running == (stencilstore.Writer{}) {
+				tt.running = running
+			}
+			registry := skewRegistry{tt.entry.target: []byte(shippedBody)}
+			if tt.unshipped {
+				registry = skewRegistry{}
+			}
+			stencilstore.SetSkewStateForTest(t, registry, tt.running, tt.older)
+
+			baseDir := t.TempDir()
+			boardCopy := stencilstore.ApplyWriter(stencilstore.ApplyStamp([]byte(tt.body), stencilstore.BodyHash([]byte(tt.body))), tt.recorded)
+			if tt.edited {
+				boardCopy = append(boardCopy, "An operator's edit.\n"...)
+			}
+			writeBoardFile(t, baseDir, tt.entry.target, boardCopy)
+			if tt.entry.top != "" {
+				writeBoardFile(t, baseDir, tt.entry.top, []byte(tt.entry.topBody))
+			}
+
+			got, err := tt.entry.read(baseDir)
+
+			if tt.wantRefuse {
+				var skew *stencilstore.NewerBoardCopyError
+				if !errors.As(err, &skew) {
+					t.Fatalf("read of %q = %q, %v; want a *NewerBoardCopyError", tt.entry.target, got, err)
+				}
+				want := stencilstore.NewerBoardCopyError{Stencil: tt.entry.target, WrittenBy: tt.recorded.Revision, Running: tt.running.Revision}
+				if *skew != want {
+					t.Errorf("read of %q error = %+v; want %+v", tt.entry.target, *skew, want)
+				}
+				for _, part := range []string{tt.entry.target, tt.recorded.Revision, tt.running.Revision, "restart the run's driver on the current lym binary"} {
+					if !strings.Contains(err.Error(), part) {
+						t.Errorf("read of %q error %q lacks %q", tt.entry.target, err.Error(), part)
+					}
+				}
+			} else {
+				if err != nil {
+					t.Fatalf("read of %q failed: %v", tt.entry.target, err)
+				}
+				if !strings.Contains(got, strings.TrimSuffix(tt.body, "\n")) {
+					t.Errorf("read of %q = %q; want it to hold the board body %q", tt.entry.target, got, tt.body)
+				}
+			}
+
+			onDisk, readErr := os.ReadFile(stencilstore.Path(baseDir, tt.entry.target))
+			if readErr != nil {
+				t.Fatalf("os.ReadFile of the board copy failed: %v", readErr)
+			}
+			if !bytes.Equal(onDisk, boardCopy) {
+				t.Errorf("board copy of %q changed to %q; want it unchanged", tt.entry.target, onDisk)
+			}
+		})
+	}
+}
