+	if err != nil || !committed {
+		return err
+	}
+	if err := deps.Spawn(); err != nil {
+		logger.Warn("battencli: the push of the run records did not start; the next push carries them", "slug", slug, "error", err)
+	}
+	return nil
 }
 
