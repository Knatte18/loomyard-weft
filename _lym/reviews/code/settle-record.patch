+
+	exited := exec.Command("true")
+	running := exec.Command("sleep", "30")
+	for _, child := range []*exec.Cmd{exited, running} {
+		if err := child.Start(); err != nil {
+			t.Fatalf("start %v: %v", child.Args, err)
+		}
