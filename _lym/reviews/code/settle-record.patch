@@ -0,0 +1,80 @@
+// archive_test.go pins ArchiveRunRecord: what it moves, and when it refuses.
+
+package weaverengine_test
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+)
+
+func TestArchiveRunRecord(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	newGeom := func(t *testing.T) weaverengine.Geometry {
+		root := t.TempDir()
+		return weaverengine.Geometry{RunDir: filepath.Join(root, "run"), ScratchDir: filepath.Join(root, "scratch")}
+	}
+
+	t.Run("EntriesMoveIntoDest", func(t *testing.T) {
+		t.Parallel()
+		geom := newGeom(t)
+		if err := os.MkdirAll(filepath.Join(geom.RunDir, "reports"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(geom.RunDir, "state.json"), []byte("{}"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		dest := filepath.Join(t.TempDir(), "archive")
+
+		if err := weaverengine.ArchiveRunRecord(geom, dest); err != nil {
+			t.Fatalf("ArchiveRunRecord() error = %v; want nil", err)
+		}
+
+		for _, name := range []string{"state.json", "reports"} {
+			if _, err := os.Stat(filepath.Join(dest, name)); err != nil {
+				t.Errorf("stat %s in dest = %v; want it moved", name, err)
+			}
+			if _, err := os.Stat(filepath.Join(geom.RunDir, name)); !errors.Is(err, os.ErrNotExist) {
+				t.Errorf("stat %s in the run dir = %v; want it gone", name, err)
+			}
+		}
+	})
+
+	t.Run("HeldRunLockRefuses", func(t *testing.T) {
+		t.Parallel()
+		geom := newGeom(t)
+		if err := os.MkdirAll(geom.ScratchDir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		held, acquired, err := lock.TryAcquireWriteLock(filepath.Join(geom.ScratchDir, "run.lock"))
+		if err != nil || !acquired {
+			t.Fatalf("acquire the run lock = %v, %v", acquired, err)
+		}
+		defer func() { _ = held.Release() }()
+
+		if err := weaverengine.ArchiveRunRecord(geom, filepath.Join(t.TempDir(), "archive")); !errors.Is(err, weaverengine.ErrRunBusy) {
+			t.Errorf("ArchiveRunRecord() error = %v; want ErrRunBusy", err)
+		}
+	})
+
+	t.Run("AbsentRunDirectoryMovesNothing", func(t *testing.T) {
+		t.Parallel()
+		geom := newGeom(t)
+		dest := filepath.Join(t.TempDir(), "archive")
+
+		if err := weaverengine.ArchiveRunRecord(geom, dest); err != nil {
+			t.Fatalf("ArchiveRunRecord() error = %v; want nil", err)
+		}
+
+		if _, err := os.Stat(dest); !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("stat dest = %v; want it never created", err)
+		}
+	})
+}
diff --git a/internal/weaverengine/config.go b/internal/weaverengine/config.go
new file mode 100644
index 00000000..2f62c834
--- /dev/null
+++ b/internal/weaverengine/config.go
@@ -0,0 +1,105 @@
+// config.go defines Config, which mirrors the keys of weaver.yaml, and the loading and ladder resolution over it.
+// LoadConfig resolves the file through configengine.LoadOrTemplate with ConfigTemplate().
+// An absent file in every layer resolves to the embedded template.
+
+package weaverengine
+
+import (
+	_ "embed"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed template.yaml
+var configTemplate string
+
+// Config is the resolved weaver.yaml configuration.
+type Config struct {
+	// Ladder is the model-specs a batch attempt climbs in order, one rung per failed attempt.
+	Ladder []string `yaml:"ladder"`
+	// FixerTimeoutMin is the number of minutes after spawn at which a plan-level verify fixer strand classifies dead.
+	FixerTimeoutMin int `yaml:"fixer_timeout_min"`
+	// VerifyGate is the gate key of the plan-level verify Weaver's Done rests on.
+	VerifyGate string `yaml:"verify_gate"`
+}
+
+// ConfigTemplate returns the default YAML template for weaver configuration.
+func ConfigTemplate() string {
+	return configTemplate
+}
+
+// ConfigOpenMaps returns the weaver.yaml keys a layer replaces whole, the ladder list.
+func ConfigOpenMaps() []string {
+	return []string{"ladder"}
+}
+
+// ConfigSpec returns weaver's layered-load spec.
+// It carries the template and the per-key classification that decides which keys a local override may hold.
+// verify_gate is a guard key: a narrower gate key would hollow the plan-level verify Weaver's Done rests on.
+func ConfigSpec() configengine.Spec {
+	return configengine.Spec{
+		Name:     "weaver",
+		Template: []byte(ConfigTemplate()),
+		Categories: map[string]configengine.Category{
+			"ladder":            configengine.CategoryNone,
+			"fixer_timeout_min": configengine.CategoryNone,
+			"verify_gate":       configengine.CategoryGuard,
+		},
+		OpenMaps: ConfigOpenMaps(),
+	}
+}
+
+// LoadConfig loads configuration from the weaver module's layer stack under dirs.
+// It refuses a ladder spec modelspec.Parse rejects, a non-positive fixer_timeout_min and an empty verify_gate.
+// Each refusal names the key and is marked configengine.MarkInvalid.
+// module names the config file to read.
+func LoadConfig(dirs configengine.Dirs, module string) (Config, error) {
+	spec := ConfigSpec()
+	spec.Name = module
+	resolved, err := configengine.LoadOrTemplate(dirs, spec)
+	if err != nil {
+		return Config{}, err
+	}
+
+	var cfg Config
+	if err := yaml.Unmarshal(resolved, &cfg); err != nil {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("unmarshal weaver config: %w", err))
+	}
+	for i, rung := range cfg.Ladder {
+		if _, err := modelspec.Parse(rung); err != nil {
+			return Config{}, configengine.MarkInvalid(fmt.Errorf("weaver config key %q rung %d: %w", "ladder", i+1, err))
+		}
+	}
+	if cfg.FixerTimeoutMin <= 0 {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("weaver config key %q: must be a positive integer, got %d", "fixer_timeout_min", cfg.FixerTimeoutMin))
+	}
+	if cfg.VerifyGate == "" {
+		return Config{}, configengine.MarkInvalid(fmt.Errorf("weaver config key %q: must name a gate key, got none", "verify_gate"))
+	}
+	return cfg, nil
+}
+
+// ResolveLadder resolves cfg's ladder against reg and returns one ModelChoice per rung, in order.
+// It refuses an empty ladder and a spec the registry cannot resolve, each naming the key and `lym config weaver`.
+func ResolveLadder(cfg Config, reg modelspec.Registry) ([]shuttleengine.ModelChoice, error) {
+	if len(cfg.Ladder) == 0 {
+		return nil, fmt.Errorf("weaver: the ladder key of weaver.yaml is empty; way forward: list at least one model-spec under ladder with `lym config weaver`")
+	}
+	choices := make([]shuttleengine.ModelChoice, 0, len(cfg.Ladder))
+	for i, rung := range cfg.Ladder {
+		parsed, err := modelspec.Parse(rung)
+		if err != nil {
+			return nil, fmt.Errorf("weaver: ladder rung %d of weaver.yaml: %w; way forward: fix the spec with `lym config weaver`", i+1, err)
+		}
+		resolved, err := reg.Resolve(parsed)
+		if err != nil {
+			return nil, fmt.Errorf("weaver: ladder rung %d of weaver.yaml: %w; way forward: name a known alias with `lym config weaver`", i+1, err)
+		}
+		choices = append(choices, shuttleengine.NewModelChoice(resolved))
+	}
+	return choices, nil
+}
diff --git a/internal/weaverengine/config_test.go b/internal/weaverengine/config_test.go
new file mode 100644
index 00000000..8da26d62
--- /dev/null
+++ b/internal/weaverengine/config_test.go
@@ -0,0 +1,140 @@
+// config_test.go verifies that weaver.yaml's template loads through LoadConfig, that a bad key refuses naming itself,
+// and that the default ladder resolves to one model choice per rung.
+// It seeds files with plain os.MkdirAll and os.WriteFile against a t.TempDir(), so it spawns nothing.
+
+package weaverengine_test
+
+import (
+	"errors"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+)
+
+// seedConfig writes content to <baseDir>/_lym/config/<module>.yaml and creates the directories above it.
+func seedConfig(t *testing.T, baseDir, module, content string) {
+	t.Helper()
+	if err := os.MkdirAll(configengine.ConfigDir(baseDir), 0o755); err != nil {
+		t.Fatalf("mkdir config dir: %v", err)
+	}
+	if err := os.WriteFile(configengine.ConfigFile(baseDir, module), []byte(content), 0o644); err != nil {
+		t.Fatalf("write config file: %v", err)
+	}
+}
+
+// TestLoadConfig pins how LoadConfig resolves weaver.yaml:
+// the template loads its three defaults, and each invalid key refuses naming itself, marked configengine.ErrInvalid.
+func TestLoadConfig(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	templateDefaults := weaverengine.Config{
+		Ladder:          []string{"sonnet[medium]", "opus[medium]", "opus[high]"},
+		FixerTimeoutMin: 60,
+		VerifyGate:      "webster",
+	}
+	tests := []struct {
+		name       string
+		body       string
+		want       weaverengine.Config
+		wantErrKey string
+	}{
+		{name: "the template seeded verbatim loads its defaults", body: weaverengine.ConfigTemplate(), want: templateDefaults},
+		{
+			name: "an absent key loads the template default",
+			body: "fixer_timeout_min: 30\n",
+			want: weaverengine.Config{Ladder: templateDefaults.Ladder, FixerTimeoutMin: 30, VerifyGate: "webster"},
+		},
+		{name: "an unparseable ladder spec names the key", body: "ladder:\n  - \"opus \"\n", wantErrKey: "ladder"},
+		{name: "a zero fixer_timeout_min names the key", body: "fixer_timeout_min: 0\n", wantErrKey: "fixer_timeout_min"},
+		{name: "an empty verify_gate names the key", body: "verify_gate: \"\"\n", wantErrKey: "verify_gate"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			baseDir := t.TempDir()
+			seedConfig(t, baseDir, "weaver", tt.body)
+
+			cfg, err := weaverengine.LoadConfig(configengine.Dirs{Anchor: baseDir}, "weaver")
+			if tt.wantErrKey != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErrKey) || !errors.Is(err, configengine.ErrInvalid) {
+					t.Fatalf("LoadConfig() error = %v; want an ErrInvalid error naming %q", err, tt.wantErrKey)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig() error = %v; want nil", err)
+			}
+			if !reflect.DeepEqual(cfg, tt.want) {
+				t.Errorf("LoadConfig() = %+v; want %+v", cfg, tt.want)
+			}
+		})
+	}
+
+	t.Run("an uninitialized hub falls back to the template", func(t *testing.T) {
+		t.Parallel()
+
+		cfg, err := weaverengine.LoadConfig(configengine.Dirs{Anchor: t.TempDir()}, "weaver")
+		if err != nil || !reflect.DeepEqual(cfg, templateDefaults) {
+			t.Errorf("LoadConfig() = %+v, %v; want the template defaults", cfg, err)
+		}
+	})
+}
+
+// TestResolveLadder pins that the default ladder resolves to one choice per rung in order,
+// and that an empty ladder and an unknown alias each refuse naming `lym config weaver`.
+func TestResolveLadder(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	registry := modelspec.Registry{
+		"sonnet": {Engine: "claude", Model: "sonnet"},
+		"opus":   {Engine: "claude", Model: "opus"},
+	}
+	t.Run("the default ladder resolves in order", func(t *testing.T) {
+		t.Parallel()
+
+		cfg, err := weaverengine.LoadConfig(configengine.Dirs{Anchor: t.TempDir()}, "weaver")
+		if err != nil {
+			t.Fatalf("LoadConfig() error = %v", err)
+		}
+		got, err := weaverengine.ResolveLadder(cfg, registry)
+		if err != nil {
+			t.Fatalf("ResolveLadder() error = %v; want nil", err)
+		}
+		want := []shuttleengine.ModelChoice{
+			{Engine: "claude", Model: "sonnet", Effort: "medium"},
+			{Engine: "claude", Model: "opus", Effort: "medium"},
+			{Engine: "claude", Model: "opus", Effort: "high"},
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("ResolveLadder() = %+v; want %+v", got, want)
+		}
+	})
+
+	refusals := []struct {
+		name   string
+		ladder []string
+	}{
+		{name: "an empty ladder", ladder: nil},
+		{name: "an unknown alias", ladder: []string{"nosuchalias"}},
+	}
+	for _, tt := range refusals {
+		t.Run(tt.name+" refuses", func(t *testing.T) {
+			t.Parallel()
+
+			_, err := weaverengine.ResolveLadder(weaverengine.Config{Ladder: tt.ladder}, registry)
+			if err == nil || !strings.Contains(err.Error(), "ladder") || !strings.Contains(err.Error(), "lym config weaver") {
+				t.Errorf("ResolveLadder() error = %v; want one naming ladder and `lym config weaver`", err)
+			}
+		})
+	}
+}
