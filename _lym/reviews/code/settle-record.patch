+func TestConfig_EffortTakesTheMostSpecificKey(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	cfg, err := loadHub(t, "efforts:\n  default: medium\n  haiku: low\n  darn: high\n  darn/haiku: max\n")
+	if err != nil {
+		t.Fatalf("Load() error = %v", err)
+	}
+	tests := []struct {
