+// raddlehandoff_test.go covers the hand-off line Beam-Up mails a beam's orch.
+
+package loomcli
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestRaddleHandOff asserts a beam whose project a stored proposal filed gets the line naming the Sketch, the record read and the proposal read, and a beam no stored proposal filed gets none.
+func TestRaddleHandOff(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const project = "the-beam"
+	tests := []struct {
+		name string
+		// store is the store.json record of the Sketch "the-sketch", nil for an empty store.
+		store     *boardengine.RaddleStoreEntry
+		wantFound bool
+	}{
+		{
+			name:      "StoredProposalThatFiledTheProjectNamesTheThreeReads",
+			store:     &boardengine.RaddleStoreEntry{Hash: "h", Filed: []string{project, "a-task"}, Project: project},
+			wantFound: true,
+		},
+		{
+			name:  "StoredProposalThatFiledOnlyTasksHandsOffNothing",
+			store: &boardengine.RaddleStoreEntry{Hash: "h", Filed: []string{"a-task", project}},
+		},
+		{name: "EmptyStoreHandsOffNothing"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			hub := t.TempDir()
+			if tt.store != nil {
+				directory := boardengine.RaddleStoreDir(fabricengine.BoardDir(hub), "the-sketch")
+				if err := os.MkdirAll(directory, 0o755); err != nil {
+					t.Fatal(err)
+				}
+				data, err := json.Marshal(tt.store)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(directory, "store.json"), data, 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+
+			line, found, err := raddleHandOff(&lymcwd.Location{HubPath: hub}, project)
+
+			if err != nil || found != tt.wantFound {
+				t.Fatalf("raddleHandOff() = (%q, %v, %v); want found %v and no error", line, found, err, tt.wantFound)
+			}
+			if !tt.wantFound {
+				if line != "" {
+					t.Errorf("raddleHandOff() line = %q; want none", line)
+				}
+				return
+			}
+			for _, want := range []string{"the-sketch", "lym board get the-beam --record", "lym board raddle the-beam"} {
+				if !strings.Contains(line, want) {
+					t.Errorf("raddleHandOff() line = %q; want it to carry %q", line, want)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/loomcli/raddleverbs.go b/internal/loomcli/raddleverbs.go
new file mode 100644
index 00000000..bd7e0a81
--- /dev/null
+++ b/internal/loomcli/raddleverbs.go
@@ -0,0 +1,276 @@
+// raddleverbs.go implements the `raddle-propose` and `raddle-approve` loom verbs: the raddle agent's check of its proposal and the operator's approval of it.
+// Both are role verbs of the Raddle-Write row and write the run's state record; Raddle-File reads the approval it records.
+
+package loomcli
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/fsx"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/loomrecipe"
+	"github.com/Knatte18/loomyard/internal/loomshed"
+	"github.com/Knatte18/loomyard/internal/orchcli"
+	"github.com/Knatte18/loomyard/internal/output"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/spf13/cobra"
+)
+
+// raddleWriteEngine is the engine of the recipe row that writes the raddle proposal.
+const raddleWriteEngine = "RaddleWrite"
+
+// raddleVerbDeps carries the told seams and paths both raddle verbs read and write through.
+type raddleVerbDeps struct {
+	// row answers the name of the recipe's RaddleWrite row, and false when the recipe has none.
+	row func() (string, bool, error)
+	// currentRow answers the status file's current producer, empty when the run has no status file.
+	currentRow func() (string, error)
+	// check carries the proposal and decision record paths and the board context builder.
+	check loomshed.RaddleCheck
+	// statePath and stateLockPath are the run's state record and its lock.
+	statePath     string
+	stateLockPath string
+	// coldPath is where the first passing proposal is stored once.
+	coldPath string
+	// approvalPath is the approval record the approve verb writes.
+	approvalPath string
+	// sketch is the slug of the Sketch the run splits.
+	sketch string
+	// notify posts the parent orch a line.
+	notify func(line string) error
+}
+
+// raddleVerbFailure is the error envelope of a seam that could not be read or written, naming a re-run.
+func raddleVerbFailure(out io.Writer, verb, what string, err error) int {
+	return output.Err(out, fmt.Sprintf("loom: %s: %s: %s; way forward: run lym loom %s again, and tell the operator when it keeps failing", verb, what, err, verb))
+}
+
+// raddleFindingLines renders each finding as one line of an envelope's findings list.
+func raddleFindingLines(findings []raddleparser.Finding) []string {
+	lines := make([]string, len(findings))
+	for i, finding := range findings {
+		lines[i] = loomshed.FormatRaddleFindings([]raddleparser.Finding{finding})
+	}
+	return lines
+}
+
+// refuseOutsideRaddleWrite refuses, with the way forward, a run whose recipe has no RaddleWrite row and a run whose current row is not that row.
+// It returns the exit code and true when it refused or could not read the rows, and false when the run stands at the row.
+func refuseOutsideRaddleWrite(out io.Writer, verb string, deps raddleVerbDeps) (int, bool) {
+	row, hasRow, err := deps.row()
+	if err != nil {
+		return raddleVerbFailure(out, verb, "read the run's recipe rows", err), true
+	}
+	if !hasRow {
+		return output.Err(out, fmt.Sprintf("loom: %s: this run's recipe has no Raddle-Write row, so it has no raddle proposal; way forward: none is needed, since only a raddle run proposes; `lym loom status` shows where the run stands", verb)), true
+	}
+
+	current, err := deps.currentRow()
+	if err != nil {
+		return raddleVerbFailure(out, verb, "read the run's current row", err), true
+	}
+	if current != row {
+		if current == "" {
+			current = "none"
+		}
+		return output.Err(out, fmt.Sprintf("loom: %s: the run's current row is %s, not %s; way forward: run lym loom %s while the run stands at %s; lym loom status shows the current row", verb, current, row, verb, row)), true
+	}
+	return 0, false
+}
+
+// raddleProposeVerb checks the proposal on disk and reports a JSON envelope naming the result, returning the exit code.
+// It refuses, each with its way forward, a recipe with no RaddleWrite row and a run whose current row is not that row.
+// Findings come back as an error envelope carrying them, and store nothing.
+// A passing call stores the proposal as the cold proposal when none is stored yet, records the session as proposed, and posts the parent orch that a proposal waits for the operator on the first pass of a Raddle-Write session.
+// A failed notice leaves the session without one, so the next passing call posts it again, and raddle-approve refuses until it is posted.
+func raddleProposeVerb(out io.Writer, deps raddleVerbDeps) int {
+	const verb = "raddle-propose"
+	if code, refused := refuseOutsideRaddleWrite(out, verb, deps); refused {
+		return code
+	}
+
+	findings, err := loomshed.CheckRaddleProposal(deps.check, false)
+	if err != nil {
+		return raddleVerbFailure(out, verb, "check the proposal", err)
+	}
+	if len(findings) > 0 {
+		return output.ErrFields(out, "loom: raddle-propose: the proposal is not yet valid; way forward: fix each finding in the proposal file, then run lym loom raddle-propose again", map[string]any{
+			"findings": raddleFindingLines(findings),
+		})
+	}
+
+	if err := loomshed.StoreColdProposal(deps.check.ProposalPath, deps.coldPath, deps.statePath, deps.stateLockPath); err != nil {
+		return raddleVerbFailure(out, verb, "store the cold proposal", err)
+	}
+	needsNotice := false
+	recorded, err := loomshed.UpdateRaddleState(deps.statePath, deps.stateLockPath, func(stored *loomshed.RaddleState) {
+		stored.ProposedSession = stored.Session
+		needsNotice = stored.NoticeSession < stored.Session
+	})
+	if err != nil {
+		return raddleVerbFailure(out, verb, "record the passing proposal", err)
+	}
+	if needsNotice {
+		line := fmt.Sprintf("raddle: the proposal for the Sketch %s passes its checks and waits for the operator's approval in the run's pane; it is at %s", deps.sketch, deps.check.ProposalPath)
+		if err := deps.notify(line); err != nil {
+			return raddleVerbFailure(out, verb, "post the parent the waiting notice", err)
+		}
+		if _, err := loomshed.UpdateRaddleState(deps.statePath, deps.stateLockPath, func(stored *loomshed.RaddleState) { stored.NoticeSession = recorded.Session }); err != nil {
+			return raddleVerbFailure(out, verb, "record the waiting notice", err)
+		}
+	}
+	return output.Ok(out, map[string]any{
+		"valid":         true,
+		"session":       recorded.Session,
+		"notice_posted": needsNotice,
+		"note":          "the proposal passes its checks; put it to the operator and run lym loom raddle-approve only on the operator's explicit approval",
+	})
+}
+
+// raddleApproveVerb approves the proposal on disk and reports a JSON envelope naming the approval, returning the exit code.
+// It refuses, each with its way forward, a recipe with no RaddleWrite row, a run whose current row is not that row, a Raddle-Write session with no passing propose, a session whose waiting notice was not posted, a proposal that is not valid and a board that moved since the proposal was checked.
+// On success it records the hash of the proposal file with the session in the run's state, then writes the approval record, and names the board entries that landed meanwhile.
+// The verb cannot tell the operator from the agent, so an approval with no operator input is prevented only by the stencil.
+func raddleApproveVerb(out io.Writer, deps raddleVerbDeps) int {
+	const verb = "raddle-approve"
+	if code, refused := refuseOutsideRaddleWrite(out, verb, deps); refused {
+		return code
+	}
+
+	stored, err := loomshed.ReadRaddleState(deps.statePath, deps.stateLockPath)
+	if err != nil {
+		return raddleVerbFailure(out, verb, "read the run's state", err)
+	}
+	if stored.ProposedSession == 0 || stored.ProposedSession < stored.Session {
+		return output.Err(out, fmt.Sprintf("loom: raddle-approve: no proposal has passed its checks in this Raddle-Write session (session %d); way forward: run lym loom raddle-propose, fix what it finds, put the proposal to the operator, then run lym loom raddle-approve", stored.Session))
+	}
+
+	if stored.NoticeSession < stored.Session {
+		return output.Err(out, fmt.Sprintf("loom: raddle-approve: the waiting notice of this Raddle-Write session (session %d) was not posted, so nothing has told the operator that a proposal waits; way forward: run lym loom raddle-propose again, which posts the waiting notice, then run lym loom raddle-approve on the operator's approval", stored.Session))
+	}
+
+	findings, err := loomshed.CheckRaddleProposal(deps.check, false)
+	if err != nil {
+		return raddleVerbFailure(out, verb, "check the proposal", err)
+	}
+	if len(findings) > 0 {
+		return output.ErrFields(out, "loom: raddle-approve: the proposal is not valid; way forward: fix each finding in the proposal file, run lym loom raddle-propose, and put the revised proposal to the operator", map[string]any{
+			"findings": raddleFindingLines(findings),
+		})
+	}
+	recheck, err := loomshed.RecheckRaddleBoard(deps.check)
+	if err != nil {
+		return raddleVerbFailure(out, verb, "re-check the board", err)
+	}
+	if len(recheck.Failures) > 0 {
+		return output.ErrFields(out, "loom: raddle-approve: the board moved since the proposal was checked; way forward: read the named entries again, revise the proposal to fit them, run lym loom raddle-propose, and put the revised proposal to the operator", map[string]any{
+			"findings": raddleFindingLines(recheck.Failures),
+		})
+	}
+
+	proposal, err := os.ReadFile(deps.check.ProposalPath)
+	if err != nil {
+		return raddleVerbFailure(out, verb, "read the proposal", err)
+	}
+	approval := loomshed.RaddleApprovalRecord{Hash: raddleparser.Hash(proposal), Session: stored.Session}
+	if _, err := loomshed.UpdateRaddleState(deps.statePath, deps.stateLockPath, func(current *loomshed.RaddleState) { current.Approval = &approval }); err != nil {
+		return raddleVerbFailure(out, verb, "record the approval", err)
+	}
+	record, err := json.MarshalIndent(approval, "", "  ")
+	if err != nil {
+		return raddleVerbFailure(out, verb, "render the approval record", err)
+	}
+	if err := fsx.AtomicWriteBytes(deps.approvalPath, append(record, '\n')); err != nil {
+		return raddleVerbFailure(out, verb, "write the approval record", err)
+	}
+	return output.Ok(out, map[string]any{
+		"approved": true,
+		"hash":     approval.Hash,
+		"session":  approval.Session,
+		"landed":   append([]string{}, recheck.Landed...),
+	})
+}
+
+// raddleVerbDeps assembles the seams of the raddle verbs for the run c armed.
+// Every closure reads or writes on demand and opens nothing at build time.
+func (c *loomCLI) raddleVerbDeps() raddleVerbDeps {
+	return raddleVerbDeps{
+		row: func() (string, bool, error) { return loomrecipe.EngineRow(c.recipe, raddleWriteEngine) },
+		currentRow: func() (string, error) {
+			status, found, err := state.ReadJSON[shedengine.Status](shedrun.StatusFile(c.location, shedrun.SelfRunID), shedrun.StatusLock(c.location, shedrun.SelfRunID))
+			// A run directory not yet created fails the lock open with not-exist; that is an absent status file too.
+			if errors.Is(err, fs.ErrNotExist) || (err == nil && !found) {
+				return "", nil
+			}
+			return status.CurrentProducer, err
+		},
+		check:         raddleCheckFor(c.location),
+		statePath:     loomengine.RaddleStatePath(c.location),
+		stateLockPath: loomengine.RaddleStateLockPath(c.location),
+		coldPath:      loomengine.RaddleColdProposal(c.location),
+		approvalPath:  loomengine.RaddleApproval(c.location),
+		sketch:        seedSlug(c.location.WorktreeName),
+		notify: func(line string) error {
+			_, err := orchcli.NotifyParent(c.location, loomProgram, line)
+			return err
+		},
+	}
+}
+
+// raddleVerbCmd builds a raddle verb's subcommand over verb.
+func (c *loomCLI) raddleVerbCmd(use, short, long string, verb func(io.Writer, raddleVerbDeps) int) *cobra.Command {
+	return &cobra.Command{
+		Use:         use,
+		Short:       short,
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceRole},
+		Long:        long,
+		Args:        cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			clihelp.SetExit(cmd.Context(), verb(cmd.OutOrStdout(), c.raddleVerbDeps()))
+			return nil
+		},
+	}
+}
+
+// raddleProposeCmd builds the `raddle-propose` subcommand.
+func (c *loomCLI) raddleProposeCmd() *cobra.Command {
+	return c.raddleVerbCmd("raddle-propose", "check the raddle proposal and mark it ready for the operator", `raddle-propose runs the checks of the raddle gate over the proposal file
+in the run's raddle directory. The raddle agent runs it in the task
+worktree once the proposal is complete, in interactive mode, before it puts
+the proposal to the operator. On a pass it stores the run's first passing
+proposal as the cold proposal, records the session as proposed, and posts the
+parent orch that a proposal waits for the operator, once per Raddle-Write
+session. Findings come back in the envelope. It takes no arguments, and is
+refused while the run stands at another row or its recipe has no Raddle-Write
+row.
+
+Example:
+  lym loom raddle-propose`, raddleProposeVerb)
+}
+
+// raddleApproveCmd builds the `raddle-approve` subcommand.
+func (c *loomCLI) raddleApproveCmd() *cobra.Command {
+	return c.raddleVerbCmd("raddle-approve", "record the operator's approval of the raddle proposal", `raddle-approve records the approval of the proposal file as it stands. The
+raddle agent runs it only on the operator's explicit approval. It is refused
+until a raddle-propose has passed and posted its waiting notice in the current
+Raddle-Write session, while
+the proposal fails a check, and when the board moved since the proposal was
+checked; the refusal names what to fix. On success it records the hash of the
+proposal with the session and names the board entries that landed since the
+proposal read them. It takes no arguments.
+
+Example:
+  lym loom raddle-approve`, raddleApproveVerb)
+}
diff --git a/internal/loomcli/raddleverbs_test.go b/internal/loomcli/raddleverbs_test.go
new file mode 100644
index 00000000..edc2281b
--- /dev/null
+++ b/internal/loomcli/raddleverbs_test.go
@@ -0,0 +1,318 @@
+// raddleverbs_test.go exercises the raddle-propose and raddle-approve verbs over injected seams and a proposal, record and state in a temp directory.
+
+package loomcli
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/loomshed"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+const (
+	// raddleTestRow is the name the injected row seam answers for the recipe's RaddleWrite row.
+	raddleTestRow = "Raddle-Write"
+	// raddleTestRecord is a decision record of one decision with one criterion, which the one-part tapestry proposal below builds.
+	raddleTestRecord = "## Decisions\n\n### D1 — First\n\nThe first decision.\n\n## Acceptance criteria\n\n- D1: first holds.\n"
+)
+
+// raddleTestProposal returns the bytes of a tapestry proposal that passes every check against raddleTestRecord and raddleTestBoard.
+// checked lists the board entries the proposal weighed, each with the revised stamp it read, and costLine changes the file without changing its validity.
+func raddleTestProposal(t *testing.T, costLine string, checked ...raddleparser.BoardCheck) []byte {
+	t.Helper()
+	data, err := json.Marshal(raddleparser.Proposal{
+		Sketch:       "the-sketch",
+		Shape:        raddleparser.ShapeTapestry,
+		BoardChecked: checked,
+		Parts: []raddleparser.Part{{
+			Slug: "part-a", Title: "Part A", Type: "enhancement", Recipe: raddleparser.RecipeTapestry, Profile: "standard",
+			Decisions: []string{"D1"}, Packages: []raddleparser.Package{{Path: "internal/a", Size: 10}},
+			Criteria: []string{"D1: first holds."}, CostLine: "one tapestry part",
+		}},
+		Cost: raddleparser.Cost{Line: costLine, NextBest: raddleparser.NextBest{Split: "two parts", Line: "two tapestry parts"}},
+	})
+	if err != nil {
+		t.Fatalf("marshal the proposal: %v", err)
+	}
+	return data
+}
+
+// raddleTestBoard returns the board context raddleTestProposal passes under: the Sketch is the run's own entry and "other" is one open entry.
+func raddleTestBoard() raddleparser.BoardContext {
+	return raddleparser.BoardContext{
+		Sketch: "the-sketch",
+		Entry:  "the-sketch",
+		Entries: []raddleparser.BoardEntry{
+			{Slug: "the-sketch", Kind: raddleparser.KindTask, Labels: []string{"sketch"}, Open: true},
+			{Slug: "other", Kind: raddleparser.KindTask, Labels: []string{"bug"}, Open: true, Revised: "2026-11-01T10:00:00Z"},
+		},
+		TypeLabels: []string{"bug", "enhancement", "sketch"},
+		Profiles:   map[string][]string{raddleparser.RecipeTapestry: {"standard"}},
+	}
+}
+
+// raddleVerbFixture is a raddle run's files in a temp directory with recording seams.
+type raddleVerbFixture struct {
+	deps      raddleVerbDeps
+	hasRow    bool
+	current   string
+	board     raddleparser.BoardContext
+	notices   []string
+	notifyErr error
+}
+
+// newRaddleVerbFixture writes proposal and the decision record into a temp directory and returns the fixture whose run stands at the Raddle-Write row.
+func newRaddleVerbFixture(t *testing.T, proposal []byte) *raddleVerbFixture {
+	t.Helper()
+	dir := t.TempDir()
+	f := &raddleVerbFixture{hasRow: true, current: raddleTestRow, board: raddleTestBoard()}
+	f.deps = raddleVerbDeps{
+		row:        func() (string, bool, error) { return raddleTestRow, f.hasRow, nil },
+		currentRow: func() (string, error) { return f.current, nil },
+		check: loomshed.RaddleCheck{
+			ProposalPath: filepath.Join(dir, "proposal.yaml"),
+			RecordPath:   filepath.Join(dir, "decision.md"),
+			Board:        func(bool) (raddleparser.BoardContext, error) { return f.board, nil },
+		},
+		statePath:     filepath.Join(dir, "state.json"),
+		stateLockPath: filepath.Join(dir, "state.json.lock"),
+		coldPath:      filepath.Join(dir, "cold-proposal.yaml"),
+		approvalPath:  filepath.Join(dir, "approval.json"),
+		sketch:        "the-sketch",
+		notify: func(line string) error {
+			if f.notifyErr != nil {
+				return f.notifyErr
+			}
+			f.notices = append(f.notices, line)
+			return nil
+		},
+	}
+	f.writeProposal(t, proposal)
+	if err := os.WriteFile(f.deps.check.RecordPath, []byte(raddleTestRecord), 0o644); err != nil {
+		t.Fatalf("write the record: %v", err)
+	}
+	return f
+}
+
+func (f *raddleVerbFixture) writeProposal(t *testing.T, proposal []byte) {
+	t.Helper()
+	if err := os.WriteFile(f.deps.check.ProposalPath, proposal, 0o644); err != nil {
+		t.Fatalf("write the proposal: %v", err)
+	}
+}
+
+// updateState applies mutate to the run's state record.
+func (f *raddleVerbFixture) updateState(t *testing.T, mutate func(*loomshed.RaddleState)) {
+	t.Helper()
+	if _, err := loomshed.UpdateRaddleState(f.deps.statePath, f.deps.stateLockPath, mutate); err != nil {
+		t.Fatalf("UpdateRaddleState() = %v; want nil", err)
+	}
+}
+
+// readState returns the run's state record.
+func (f *raddleVerbFixture) readState(t *testing.T) loomshed.RaddleState {
+	t.Helper()
+	got, err := loomshed.ReadRaddleState(f.deps.statePath, f.deps.stateLockPath)
+	if err != nil {
+		t.Fatalf("ReadRaddleState() = %v; want nil", err)
+	}
+	return got
+}
+
+// run calls verb over the fixture's deps and returns its exit code and output.
+func (f *raddleVerbFixture) run(verb func(io.Writer, raddleVerbDeps) int) (int, string) {
+	var out bytes.Buffer
+	code := verb(&out, f.deps)
+	return code, out.String()
+}
+
+func TestRaddleProposeVerb(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	refusals := []struct {
+		name       string
+		hasRow     bool
+		current    string
+		proposal   []byte
+		wantOutput []string
+	}{
+		{name: "ARecipeWithNoRaddleWriteRowIsRefused", hasRow: false, current: "Describe", proposal: raddleTestProposal(t, "one tapestry part"),
+			wantOutput: []string{"has no Raddle-Write row", "way forward: none is needed"}},
+		{name: "ARunAtAnotherRowIsRefused", hasRow: true, current: "Raddle-File", proposal: raddleTestProposal(t, "one tapestry part"),
+			wantOutput: []string{"current row is Raddle-File", "way forward: run lym loom raddle-propose while the run stands at Raddle-Write"}},
+		{name: "FindingsArePrintedAndNothingIsStored", hasRow: true, current: raddleTestRow, proposal: []byte("not json"),
+			wantOutput: []string{"proposal-unparsable", "way forward: fix each finding"}},
+	}
+	for _, tt := range refusals {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newRaddleVerbFixture(t, tt.proposal)
+			f.hasRow, f.current = tt.hasRow, tt.current
+			f.updateState(t, func(stored *loomshed.RaddleState) { stored.Session = 1 })
+
+			code, out := f.run(raddleProposeVerb)
+			if code != 1 {
+				t.Errorf("raddleProposeVerb() = %d, %s; want exit 1", code, out)
+			}
+			for _, want := range tt.wantOutput {
+				if !strings.Contains(out, want) {
+					t.Errorf("raddleProposeVerb() output = %s; want it to contain %q", out, want)
+				}
+			}
+			if got := f.readState(t); got.ColdStored || got.ProposedSession != 0 || got.NoticeSession != 0 {
+				t.Errorf("state after the refusal = %+v; want it unchanged", got)
+			}
+			if _, err := os.Stat(f.deps.coldPath); !os.IsNotExist(err) {
+				t.Errorf("cold proposal stat = %v; want not-exist", err)
+			}
+			if len(f.notices) != 0 {
+				t.Errorf("notices = %q; want none", f.notices)
+			}
+		})
+	}
+
+	t.Run("PassesStoreTheColdProposalOnceAndNotifyOncePerSession", func(t *testing.T) {
+		t.Parallel()
+		first := raddleTestProposal(t, "one tapestry part")
+		f := newRaddleVerbFixture(t, first)
+		f.updateState(t, func(stored *loomshed.RaddleState) { stored.Session = 1 })
+
+		if code, out := f.run(raddleProposeVerb); code != 0 {
+			t.Fatalf("first raddleProposeVerb() = %d, %s; want exit 0", code, out)
+		}
+		if cold, err := os.ReadFile(f.deps.coldPath); err != nil || !bytes.Equal(cold, first) {
+			t.Errorf("cold proposal = %q, %v; want the first proposal", cold, err)
+		}
+		if got := f.readState(t); !got.ColdStored || got.ProposedSession != 1 || got.NoticeSession != 1 || len(f.notices) != 1 {
+			t.Errorf("state after the first pass = %+v with %d notices; want cold stored, proposed 1, notice 1 and one notice", got, len(f.notices))
+		}
+
+		revised := raddleTestProposal(t, "one tapestry part, revised")
+		f.writeProposal(t, revised)
+		if code, out := f.run(raddleProposeVerb); code != 0 {
+			t.Fatalf("second raddleProposeVerb() = %d, %s; want exit 0", code, out)
+		}
+		if len(f.notices) != 1 {
+			t.Errorf("notices after a second pass of the session = %d; want 1", len(f.notices))
+		}
+
+		f.updateState(t, func(stored *loomshed.RaddleState) { stored.Session = 2 })
+		if code, out := f.run(raddleProposeVerb); code != 0 {
+			t.Fatalf("later-session raddleProposeVerb() = %d, %s; want exit 0", code, out)
+		}
+		if got := f.readState(t); got.ProposedSession != 2 || got.NoticeSession != 2 || len(f.notices) != 2 {
+			t.Errorf("state after the later session's pass = %+v with %d notices; want proposed 2, notice 2 and two notices", got, len(f.notices))
+		}
+		if cold, err := os.ReadFile(f.deps.coldPath); err != nil || !bytes.Equal(cold, first) {
+			t.Errorf("cold proposal after later passes = %q, %v; want the first proposal kept", cold, err)
+		}
+	})
+
+	t.Run("AFailedNoticeIsPostedOnTheNextPass", func(t *testing.T) {
+		t.Parallel()
+		f := newRaddleVerbFixture(t, raddleTestProposal(t, "one tapestry part"))
+		f.updateState(t, func(stored *loomshed.RaddleState) { stored.Session = 1 })
+		f.notifyErr = errors.New("creel unavailable")
+
+		code, out := f.run(raddleProposeVerb)
+		if code != 1 || !strings.Contains(out, "creel unavailable") || !strings.Contains(out, "run lym loom raddle-propose again") {
+			t.Fatalf("raddleProposeVerb() = %d, %s; want exit 1 naming the fault and a re-run", code, out)
+		}
+		if got := f.readState(t); got.ProposedSession != 1 || got.NoticeSession != 0 {
+			t.Errorf("state after the failed notice = %+v; want proposed 1 and no notice recorded", got)
+		}
+
+		f.notifyErr = nil
+		if code, out := f.run(raddleProposeVerb); code != 0 || len(f.notices) != 1 {
+			t.Errorf("raddleProposeVerb() = %d, %s with %d notices; want exit 0 and one notice", code, out, len(f.notices))
+		}
+	})
+}
+
+func TestRaddleApproveVerb(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	moved := raddleparser.BoardCheck{Slug: "other", Revised: "2026-11-01T10:00:00Z"}
+	gone := raddleparser.BoardCheck{Slug: "gone", Revised: "2026-11-01T08:00:00Z"}
+	tests := []struct {
+		name         string
+		current      string
+		proposal     []byte
+		state        loomshed.RaddleState
+		boardMoved   bool
+		wantCode     int
+		wantOutput   []string
+		wantApproved bool
+	}{
+		{name: "OutsideRaddleWriteIsRefused", current: "Raddle-File", proposal: raddleTestProposal(t, "line"),
+			state: loomshed.RaddleState{Session: 1, ProposedSession: 1, NoticeSession: 1}, wantCode: 1,
+			wantOutput: []string{"current row is Raddle-File", "way forward: run lym loom raddle-approve while the run stands at Raddle-Write"}},
+		{name: "NoPassingProposeThisSessionIsRefusedNamingPropose", current: raddleTestRow, proposal: raddleTestProposal(t, "line"),
+			state: loomshed.RaddleState{Session: 1}, wantCode: 1,
+			wantOutput: []string{"no proposal has passed", "lym loom raddle-propose"}},
+		{name: "ProposeInAnEarlierSessionIsRefusedNamingPropose", current: raddleTestRow, proposal: raddleTestProposal(t, "line"),
+			state: loomshed.RaddleState{Session: 2, ProposedSession: 1, NoticeSession: 1}, wantCode: 1,
+			wantOutput: []string{"session 2", "lym loom raddle-propose"}},
+		{name: "ProposeWhoseNoticeWasNotPostedIsRefusedNamingPropose", current: raddleTestRow, proposal: raddleTestProposal(t, "line"),
+			state: loomshed.RaddleState{Session: 1, ProposedSession: 1}, wantCode: 1,
+			wantOutput: []string{"waiting notice", "was not posted", "run lym loom raddle-propose again"}},
+		{name: "AnInvalidProposalIsRefusedWithItsFindings", current: raddleTestRow, proposal: []byte("not json"),
+			state: loomshed.RaddleState{Session: 1, ProposedSession: 1, NoticeSession: 1}, wantCode: 1,
+			wantOutput: []string{"proposal-unparsable", "the proposal is not valid"}},
+		{name: "AMovedBoardIsRefusedNamingTheEntry", current: raddleTestRow, proposal: raddleTestProposal(t, "line", moved),
+			state: loomshed.RaddleState{Session: 1, ProposedSession: 1, NoticeSession: 1}, boardMoved: true, wantCode: 1,
+			wantOutput: []string{"the board moved", raddleparser.CheckRevisedMoved, `\"other\"`}},
+		{name: "SuccessRecordsTheApprovalAndNamesLandedEntries", current: raddleTestRow, proposal: raddleTestProposal(t, "line", moved, gone),
+			state: loomshed.RaddleState{Session: 1, ProposedSession: 1, NoticeSession: 1}, wantCode: 0,
+			wantOutput: []string{`"approved":true`, `"landed":["gone"]`}, wantApproved: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newRaddleVerbFixture(t, tt.proposal)
+			f.current = tt.current
+			f.updateState(t, func(stored *loomshed.RaddleState) { *stored = tt.state })
+			if tt.boardMoved {
+				f.board.Entries[1].Revised = "2026-11-02T10:00:00Z"
+			}
+
+			code, out := f.run(raddleApproveVerb)
+			if code != tt.wantCode {
+				t.Errorf("raddleApproveVerb() = %d, %s; want exit %d", code, out, tt.wantCode)
+			}
+			for _, want := range tt.wantOutput {
+				if !strings.Contains(out, want) {
+					t.Errorf("raddleApproveVerb() output = %s; want it to contain %q", out, want)
+				}
+			}
+
+			record, recordErr := os.ReadFile(f.deps.approvalPath)
+			got := f.readState(t)
+			if !tt.wantApproved {
+				if !os.IsNotExist(recordErr) || got.Approval != nil {
+					t.Errorf("approval record = %q, %v with state approval %+v; want neither", record, recordErr, got.Approval)
+				}
+				return
+			}
+			want := loomshed.RaddleApprovalRecord{Hash: raddleparser.Hash(tt.proposal), Session: tt.state.Session}
+			var written loomshed.RaddleApprovalRecord
+			if recordErr != nil || json.Unmarshal(record, &written) != nil || written != want {
+				t.Errorf("approval record = %q, %v; want %+v", record, recordErr, want)
+			}
+			if got.Approval == nil || !reflect.DeepEqual(*got.Approval, want) {
+				t.Errorf("state approval = %+v; want %+v", got.Approval, want)
+			}
+		})
+	}
+}
