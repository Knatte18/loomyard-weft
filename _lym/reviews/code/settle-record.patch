++++ b/internal/testkit/tiergate/tiergate.go
+@@ -0,0 +1,28 @@
++// Package tiergate selects at run time which tier's tests a test binary runs, for the one-binary-per-package trial.
++//
++// The tier comes from the LYM_TEST_TIER environment variable, set by the gate to the number of the tier it runs.
++// Require skips a test whose tier is not the running one, so a package's tiers share one test binary.
++package tiergate
++
++import (
++	"os"
++	"strconv"
++	"testing"
++)
++
++// Current returns the running tier, or -1 when LYM_TEST_TIER is unset or not a number.
++func Current() int {
++	tier, err := strconv.Atoi(os.Getenv("LYM_TEST_TIER"))
++	if err != nil {
++		return -1
++	}
++	return tier
++}
++
++// Require skips t unless the running tier is tier.
++func Require(t testing.TB, tier int) {
++	t.Helper()
++	if Current() != tier {
++		t.Skipf("tier%d test; running tier%d", tier, Current())
++	}
++}
