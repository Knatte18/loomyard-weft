-	for grew := true; grew; {
-		grew = false
-		for variable, names := range valueReads {
-			for _, name := range names {
-				for key := range readers[variable] {
-					if addReader(name, key) {
-						grew = true
-					}
-				}
-			}
-		}
-	}
