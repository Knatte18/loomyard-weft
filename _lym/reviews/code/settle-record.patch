+plan: opus[medium]  # model-spec for the plan-phase producer agent (see contracts/specs/llm-model-spec.md)
+plan_timeout_min: 120  # minutes the plan agent's shuttle run is allowed to run (a shorter ceiling than the discussion run)
+implementer: webster  # engine of the Webster row, the implementer that builds the approved plan on the task branch and batches it its own way; webster, the only value, runs the Merriam session with one fork per batch
+plan_lenses: twill-plan  # fan name from lenses.yaml that has the Plan-Write lead explore, have one fork write the plan, then fork itself once per lens of the fan to review it before it finishes; twill-plan is the default, and empty turns the forks off; this names the writer's lens fan, not the plan_reviewer_fan of the Plan-Review perch
+plan_reviewer_model: ["opus[medium]", "sonnet[high]"]  # model-spec for the Plan-Review reviewer, one model per round with the last entry serving every later round; the default runs the first round on opus[medium] and later rounds on sonnet[high]; empty takes loom.yaml's reviewer_model
+plan_fixer_model: ""  # model-spec for the Plan-Review fixer; empty, the default, takes loom.yaml's fixer_model, a set value (one model-spec, or a per-round list whose last entry serves every later round) replaces it for this segment
+plan_reviewer_fan: ["review-plan", ""]  # fan name from lenses.yaml that turns the lens fan on for Plan-Review; one fan name, or a YAML list with one fan name per round, the last entry serving every later round; the default fans round one out over review-plan and runs later rounds solo; an empty entry runs that round solo
+plan_fixer_fan: fix-plan  # fan name from lenses.yaml that has the Plan-Review fixer fork itself once per lens of the fan to check its fixes; one fan name, or a YAML list with one fan name per round, the last entry serving every later round; fix-plan is the default, and an empty entry runs the single fixer for that round
+plan_judge: ""  # model-spec for the Plan-Review judge pass; empty takes loom.yaml's judge
+plan_seed: ""  # model-spec for the Plan-Review seed pass; empty takes loom.yaml's seed, and seed empty takes the segment's resolved judge
+plan_max_bounces: ~  # bounce budget of the Plan-Review perch: N gives N judged Burler rounds; null takes loom.yaml's review_max_bounces; 0 runs no review round: the perch's Bouncer settles approved at once; a checkpoint above this budget means the perch never rules CIRCLING and reaches the soft-cap rule, or the accept, instead
+plan_hard_max_bounces: 0  # hard cap of the Plan-Review perch: a round numbered at or past it is never continued, it is accepted or escalated hard-cap; 0 takes loom.yaml's review_hard_max_bounces
+plan_auto_accept: false  # true makes the Plan-Review perch accept a harvested round at a spent budget instead of running the soft-cap rule
