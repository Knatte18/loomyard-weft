+
+// Error returns the divergence refusal.
+func (e *leaseLostError) Error() string { return e.message }
+
+// Unwrap returns gitrepo.ErrLeaseRejected.
+func (e *leaseLostError) Unwrap() error { return gitrepo.ErrLeaseRejected }
