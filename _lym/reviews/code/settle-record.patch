-		t.Fatal(err)
-	}
-	if err := os.WriteFile(filepath.Join(module, "go.mod"), []byte("module m\n\ngo 1.22\n"), 0o644); err != nil {
-		t.Fatal(err)
-	}
-	for name, text := range files {
