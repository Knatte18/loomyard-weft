+	case "fail":
+		c.failures = append(c.failures, gateslot.TestFailure{Package: event.Package, Test: event.Test, FirstLine: c.firstLines[key]})
+		delete(c.firstLines, key)
+	case "pass", "skip":
+		delete(c.firstLines, key)
+	}
