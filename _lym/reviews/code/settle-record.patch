+	if trailer, found := newestReplaceOf(rel, trailers); found {
+		versions, err := readVersions()
+		if err != nil {
+			return nil, err
+		}
+		if cut, found := cutAtReplace(trailer, versions); found {
+			return cut, nil
+		}
+	}
+	return readWhole()
