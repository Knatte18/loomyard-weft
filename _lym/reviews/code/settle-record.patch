diff --git a/internal/reportengine/raddle.go b/internal/reportengine/raddle.go
new file mode 100644
index 00000000..f6d39dc1
--- /dev/null
+++ b/internal/reportengine/raddle.go
@@ -0,0 +1,176 @@
+// raddle.go declares the raddle report's result types and ComputeRaddle, which sets each filed Sketch's predicted cost against what its filed parts cost.
+
+package reportengine
+
+import (
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+)
+
+// RaddleSelection records what a raddle report was computed over.
+type RaddleSelection struct {
+	BoardBranch   string    `json:"board_branch"`
+	BoardTip      string    `json:"board_tip"`
+	RecordsBranch string    `json:"records_branch"`
+	RecordsTip    string    `json:"records_tip"`
+	SnapshotAt    time.Time `json:"snapshot_at"`
+}
+
+// RaddleRow is one Sketch a raddle run filed.
+// PredictedUSD is the approved proposal's expected cost and is nil when the proposal states none.
+// ActualUSD is the summed session cost of the filed parts' runs and is nil when no session cost is known.
+// ActualPartial says a run of a filed part holds a session of unknown cost, no session or an unreadable usage directory, so ActualUSD leaves it out.
+// Unlanded lists the filed parts with no archive tag.
+// ProposalChanged says the approved proposal's hash differs from the cold proposal's.
+type RaddleRow struct {
+	Sketch          string   `json:"sketch"`
+	PredictedUSD    *float64 `json:"predicted_usd"`
+	ActualUSD       *float64 `json:"actual_usd"`
+	ActualPartial   bool     `json:"actual_partial"`
+	Unlanded        []string `json:"unlanded"`
+	ProposalChanged bool     `json:"proposal_changed"`
+}
+
+// RaddleReport is the result of ComputeRaddle.
+type RaddleReport struct {
+	Selection RaddleSelection `json:"selection"`
+	Rows      []RaddleRow     `json:"rows"`
+	Findings  []Finding       `json:"findings"`
+}
+
+// ComputeRaddle lists every Sketch of the raddle store at the board branch's tip and sets its predicted cost against the cost of its filed parts.
+// A filed part's runs are the archive tags of its slug, each read through its usage files; the filed project, which never runs, is no part.
+// A store directory without a store.json holds nothing.
+// A Sketch whose store files are missing or do not decode is skipped and listed as a finding that names it.
+// An error is a failed read of the repositories themselves.
+func ComputeRaddle(src Sources) (RaddleReport, error) {
+	report := RaddleReport{
+		Selection: RaddleSelection{BoardBranch: src.BoardBranch, BoardTip: src.BoardTip, RecordsBranch: src.RecordsBranch, RecordsTip: src.RecordsTip, SnapshotAt: src.SnapshotAt},
+		Rows:      []RaddleRow{},
+		Findings:  []Finding{},
+	}
+
+	sketches, err := src.Board.SubdirsAtRevision(src.BoardTip, boardengine.RaddleStoreRootRel())
+	if err != nil {
+		return RaddleReport{}, fmt.Errorf("reportengine: list the raddle store at %s: %w", src.BoardTip, err)
+	}
+	tagsBySlug := map[string][]gitrepo.TagRef{}
+	for _, tag := range src.Tags {
+		if slug, named := fabricengine.ArchiveTagSlug(tag.Name); named {
+			tagsBySlug[slug] = append(tagsBySlug[slug], tag)
+		}
+	}
+
+	for _, sketch := range sketches {
+		row, findings, kept, err := raddleRow(src, sketch, tagsBySlug)
+		if err != nil {
+			return RaddleReport{}, err
+		}
+		report.Findings = append(report.Findings, findings...)
+		if kept {
+			report.Rows = append(report.Rows, row)
+		}
+	}
+	return report, nil
+}
+
+// raddleRow builds the row of the Sketch sketch from its store files at the board tip.
+// kept is false for a store directory that holds nothing and for a Sketch whose files are missing or do not decode, the latter with a finding.
+func raddleRow(src Sources, sketch string, tagsBySlug map[string][]gitrepo.TagRef) (row RaddleRow, findings []Finding, kept bool, err error) {
+	recordRel := boardengine.RaddleStoreRecordRel(sketch)
+	stored, found, err := boardFileAtTip(src, recordRel)
+	if err != nil || !found {
+		return RaddleRow{}, nil, false, err
+	}
+	entry, err := boardengine.ParseRaddleStoreEntry(stored)
+	if err != nil {
+		return RaddleRow{}, []Finding{raddleFinding(sketch, recordRel, err.Error())}, false, nil
+	}
+
+	approvedRel, coldRel := boardengine.RaddleProposalRel(sketch), boardengine.RaddleColdProposalRel(sketch)
+	approved, found, err := boardFileAtTip(src, approvedRel)
+	if err != nil {
+		return RaddleRow{}, nil, false, err
+	}
+	if !found {
+		return RaddleRow{}, []Finding{raddleFinding(sketch, approvedRel, "the store directory holds no approved proposal")}, false, nil
+	}
+	cold, found, err := boardFileAtTip(src, coldRel)
+	if err != nil {
+		return RaddleRow{}, nil, false, err
+	}
+	if !found {
+		return RaddleRow{}, []Finding{raddleFinding(sketch, coldRel, "the store directory holds no cold proposal")}, false, nil
+	}
+	proposal, err := raddleparser.Parse(approved)
+	if err != nil {
+		return RaddleRow{}, []Finding{raddleFinding(sketch, approvedRel, err.Error())}, false, nil
+	}
+
+	row = RaddleRow{
+		Sketch:          sketch,
+		PredictedUSD:    proposal.Cost.ExpectedUSD,
+		Unlanded:        []string{},
+		ProposalChanged: raddleparser.Hash(approved) != raddleparser.Hash(cold),
+	}
+	total, priced := 0.0, 0
+	for _, part := range entry.Filed {
+		if part == entry.Project {
+			continue
+		}
+		tags := tagsBySlug[part]
+		if len(tags) == 0 {
+			row.Unlanded = append(row.Unlanded, part)
+			continue
+		}
+		for _, tag := range tags {
+			usage, finding, err := readRunUsage(src.Records, tag)
+			if err != nil {
+				return RaddleRow{}, nil, false, err
+			}
+			if finding != nil {
+				findings = append(findings, *finding)
+				row.ActualPartial = true
+				continue
+			}
+			if len(usage.Sessions) == 0 {
+				row.ActualPartial = true
+			}
+			for _, session := range usage.Sessions {
+				if session.CostUSD == nil {
+					row.ActualPartial = true
+					continue
+				}
+				total += *session.CostUSD
+				priced++
+			}
+		}
+	}
+	if priced > 0 {
+		row.ActualUSD = &total
+	}
+	return row, findings, true, nil
+}
+
+// boardFileAtTip reads rel from the board's tip; found is false for a path the tip's tree lacks.
+func boardFileAtTip(src Sources, rel string) (data []byte, found bool, err error) {
+	data, err = src.Board.FileAtRevision(src.BoardTip, rel)
+	if errors.Is(err, gitrepo.ErrPathNotAtRevision) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, fmt.Errorf("reportengine: read %s at %s: %w", rel, src.BoardTip, err)
+	}
+	return data, true, nil
+}
+
+// raddleFinding is the finding of a store file of the Sketch sketch that is missing or does not decode.
+func raddleFinding(sketch, file, message string) Finding {
+	return Finding{File: file, Error: fmt.Sprintf("Sketch %q: %s", sketch, message)}
+}
diff --git a/internal/reportengine/raddle_test.go b/internal/reportengine/raddle_test.go
new file mode 100644
index 00000000..204d2997
--- /dev/null
+++ b/internal/reportengine/raddle_test.go
@@ -0,0 +1,131 @@
+// raddle_test.go tests ComputeRaddle over a fake board holding a raddle store and a fake records repository holding the filed parts' runs.
+
+package reportengine
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// proposalText is the text of a proposal file whose expected cost is expected, a JSON number or null.
+func proposalText(expected string) string {
+	return fmt.Sprintf(`{"sketch":"s","cost":{"expected_usd":%s}}`, expected)
+}
+
+// storeSketch commits the store directory of sketch to the board: its store.json recording filed and project, the approved proposal and the cold proposal.
+func storeSketch(t *testing.T, w *world, sketch string, filed []string, project, approved, cold string) {
+	t.Helper()
+
+	record, err := json.Marshal(boardengine.RaddleStoreEntry{Hash: raddleparser.Hash([]byte(approved)), Filed: filed, Project: project})
+	if err != nil {
+		t.Fatalf("marshal store record: %v", err)
+	}
+	w.board.commitOnChain("store-"+sketch, at(50), map[string]string{
+		boardengine.RaddleStoreRecordRel(sketch):  string(record),
+		boardengine.RaddleProposalRel(sketch):     approved,
+		boardengine.RaddleColdProposalRel(sketch): cold,
+	})
+}
+
+// landedPart adds the archive tag of the filed part slug at hour, its run holding one session per cost, each a JSON number or null.
+func landedPart(w *world, slug string, hour int, costs ...string) {
+	sessions := map[string]string{}
+	for i, cost := range costs {
+		sessions[fmt.Sprint(i)] = sessionText(cost, time.Time{}, time.Time{})
+	}
+	w.tagWith(slug, "sha-"+slug, at(hour), seedText("tapestry"), "", usageFiles(sessions, runText("tapestry", "p", false), ""))
+}
+
+// TestComputeRaddle covers the predicted and actual cost of a Sketch, its unlanded parts, a changed proposal, a partial actual cost, the filed project and an undecodable store file.
+func TestComputeRaddle(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		build        func(t *testing.T, w *world)
+		want         []RaddleRow
+		wantFindings []string
+	}{
+		{
+			name: "AProposalWhosePartsAllLandedSetsPredictedAgainstActual",
+			build: func(t *testing.T, w *world) {
+				storeSketch(t, w, "alpha", []string{"a1", "a2"}, "", proposalText("4.5"), proposalText("4.5"))
+				landedPart(w, "a1", 40, "2")
+				landedPart(w, "a2", 41, "3")
+			},
+			want: []RaddleRow{{Sketch: "alpha", PredictedUSD: figure(4.5), ActualUSD: figure(5), Unlanded: []string{}}},
+		},
+		{
+			name: "AnUnlandedPartIsListed",
+			build: func(t *testing.T, w *world) {
+				storeSketch(t, w, "beta", []string{"b1", "b2"}, "", proposalText("2"), proposalText("2"))
+				landedPart(w, "b1", 40, "1")
+			},
+			want: []RaddleRow{{Sketch: "beta", PredictedUSD: figure(2), ActualUSD: figure(1), Unlanded: []string{"b2"}}},
+		},
+		{
+			name: "AProposalTheOperatorChangedIsFlaggedAndANullPredictionStaysNull",
+			build: func(t *testing.T, w *world) {
+				storeSketch(t, w, "gamma", []string{"g1"}, "", proposalText("null"), proposalText("8"))
+				landedPart(w, "g1", 40, "1")
+			},
+			want: []RaddleRow{{Sketch: "gamma", ActualUSD: figure(1), Unlanded: []string{}, ProposalChanged: true}},
+		},
+		{
+			name: "AnUnknownCostSessionMakesTheActualPartial",
+			build: func(t *testing.T, w *world) {
+				storeSketch(t, w, "delta", []string{"d1"}, "", proposalText("3"), proposalText("3"))
+				landedPart(w, "d1", 40, "1.5", "null")
+			},
+			want: []RaddleRow{{Sketch: "delta", PredictedUSD: figure(3), ActualUSD: figure(1.5), ActualPartial: true, Unlanded: []string{}}},
+		},
+		{
+			name: "TheFiledProjectIsNoPart",
+			build: func(t *testing.T, w *world) {
+				storeSketch(t, w, "zeta", []string{"zproj", "z1"}, "zproj", proposalText("2"), proposalText("2"))
+				landedPart(w, "z1", 40, "2")
+			},
+			want: []RaddleRow{{Sketch: "zeta", PredictedUSD: figure(2), ActualUSD: figure(2), Unlanded: []string{}}},
+		},
+		{
+			name: "AnUndecodableStoreFileIsAFindingAndNoRow",
+			build: func(t *testing.T, w *world) {
+				w.board.commitOnChain("store-eps", at(50), map[string]string{boardengine.RaddleStoreRecordRel("eps"): "{"})
+			},
+			want:         []RaddleRow{},
+			wantFindings: []string{boardengine.RaddleStoreRecordRel("eps")},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newWorld(t)
+			tt.build(t, w)
+
+			got, err := ComputeRaddle(w.sources())
+
+			if err != nil {
+				t.Fatalf("ComputeRaddle() error = %v; want nil", err)
+			}
+			if diff := cmp.Diff(tt.want, got.Rows); diff != "" {
+				t.Errorf("ComputeRaddle() rows mismatch (-want +got):\n%s", diff)
+			}
+			var gotFindings []string
+			for _, finding := range got.Findings {
+				gotFindings = append(gotFindings, finding.File)
+			}
+			if diff := cmp.Diff(tt.wantFindings, gotFindings); diff != "" {
+				t.Errorf("ComputeRaddle() finding files mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
diff --git a/internal/reportengine/raddlemarkdown.go b/internal/reportengine/raddlemarkdown.go
new file mode 100644
index 00000000..a90244bc
--- /dev/null
+++ b/internal/reportengine/raddlemarkdown.go
@@ -0,0 +1,37 @@
+// raddlemarkdown.go renders a RaddleReport as markdown: the selection, then a table of Sketches.
+
+package reportengine
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+// HeadingRaddleRows is the heading of RenderRaddleMarkdown's one section.
+const HeadingRaddleRows = "## Predicted against actual cost per Sketch"
+
+// RenderRaddleMarkdown renders report as one document: the selection it was computed over, then one table row per Sketch.
+// A figure the report holds as nil renders as no data.
+func RenderRaddleMarkdown(report RaddleReport) string {
+	var b strings.Builder
+	b.WriteString("# Raddle report\n\n")
+	s := report.Selection
+	fmt.Fprintf(&b, "- board branch: %s at %s\n", s.BoardBranch, s.BoardTip)
+	fmt.Fprintf(&b, "- records branch: %s at %s\n", s.RecordsBranch, s.RecordsTip)
+	fmt.Fprintf(&b, "- snapshot: %s\n", s.SnapshotAt.UTC().Format(time.RFC3339))
+	fmt.Fprintf(&b, "- sketches: %d, findings: %d\n", len(report.Rows), len(report.Findings))
+
+	b.WriteString("\n" + HeadingRaddleRows + "\n\n")
+	header := []string{"Sketch", "Predicted USD", "Actual USD", "Actual partial", "Unlanded parts", "Proposal changed"}
+	rows := make([][]string, len(report.Rows))
+	for i, row := range report.Rows {
+		unlanded := "none"
+		if len(row.Unlanded) > 0 {
+			unlanded = strings.Join(row.Unlanded, ", ")
+		}
+		rows[i] = []string{row.Sketch, formatFigure(row.PredictedUSD), formatFigure(row.ActualUSD), fmt.Sprint(row.ActualPartial), unlanded, fmt.Sprint(row.ProposalChanged)}
+	}
+	table(&b, header, rows)
+	return b.String()
+}
