diff --git a/internal/runplan/cardgate.go b/internal/runplan/cardgate.go
new file mode 100644
index 00000000..35209e3e
--- /dev/null
+++ b/internal/runplan/cardgate.go
@@ -0,0 +1,81 @@
+// cardgate.go derives each card's gate steps and the batch's gate, which a batch prompt renders.
+// The batch's attempt runs these steps, never Go itself.
+// An attempt that skips them is caught by the plan-level verify.
+
+package runplan
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// CardPointerPath returns c's card file path re-rooted onto planDirDisplay.
+// Its pointer bullet and its card gate bullet both spell this path.
+func CardPointerPath(c planparser.Card, planDirDisplay string) string {
+	return planDirDisplay + "/" + filepath.Base(c.SourcePath)
+}
+
+// CardGateCommand returns the gate for card as its ordered steps:
+// the hub's `card` gate call over the card's own scope.
+// The call also runs the lint steps that the `card` key lists.
+// It refuses, with the config's way forward, a hub whose `card` list the config does not hold.
+func CardGateCommand(card planparser.Card, gate gateslot.Config) ([]string, error) {
+	call, err := gate.AgentGateCall("card", card.ID())
+	if err != nil {
+		return nil, err
+	}
+	return []string{call}, nil
+}
+
+// RenderCardGates renders each card in declared order as its pointer bullet with one indented sub-bullet per gate step.
+// Each step is its own backticked command, never chained, so an agent runs each as its own Bash call.
+func RenderCardGates(cards []planparser.Card, planDirDisplay string, gate gateslot.Config) (string, error) {
+	var lines []string
+	for _, c := range cards {
+		lines = append(lines, fmt.Sprintf("- `%s`:", CardPointerPath(c, planDirDisplay)))
+		steps, err := CardGateCommand(c, gate)
+		if err != nil {
+			return "", err
+		}
+		for _, step := range steps {
+			lines = append(lines, fmt.Sprintf("  - `%s`", step))
+		}
+	}
+	return strings.Join(lines, "\n"), nil
+}
+
+// RenderBatchGate renders the batch's gate as one line: the hub's `batch` gate call over every card of the batch.
+// When last is set the call also runs the module's main packages,
+// so the plan's last batch meets a break there before the plan-level verify does.
+// It refuses, with the config's way forward, a hub whose `batch` list the config does not hold.
+func RenderBatchGate(cards []planparser.Card, gate gateslot.Config, last bool) (string, error) {
+	ids := make([]string, 0, len(cards))
+	for _, c := range cards {
+		ids = append(ids, c.ID())
+	}
+	render := gate.AgentGateCall
+	if last {
+		render = gate.AgentGateCallWithMainPackages
+	}
+	call, err := render("batch", ids...)
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("- `%s`", call), nil
+}
+
+// IsLastBatch reports whether batch is the last of the execution-ordered batches.
+// batches is the run's recorded partition mapped onto the current plan, so only the run's last batch reads as last.
+func IsLastBatch(batches []batcher.Batch, batch batcher.Batch) bool {
+	if len(batches) == 0 {
+		return false
+	}
+	lastNumber, _ := BatchIdentity(batches[len(batches)-1])
+	number, _ := BatchIdentity(batch)
+	return number == lastNumber
+}
diff --git a/internal/runplan/conflict.go b/internal/runplan/conflict.go
new file mode 100644
index 00000000..3db31ba3
--- /dev/null
+++ b/internal/runplan/conflict.go
@@ -0,0 +1,271 @@
+// conflict.go holds the plan re-resolution at dispatch and its refusal, the plan conflict.
+// It also holds the never-tracked plan-conflict record that refusal leaves in the implementer's scratch directory.
+// The record has its writers, readers and removers here too.
+
+package runplan
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/planindex"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// ErrPlanConflict is the sentinel a *PlanConflictError unwraps to.
+// It marks a dispatch refused because the plan re-resolution reported a blocking finding.
+// Callers match it with errors.Is.
+// Dispatching a batch on a re-resolve that failed is worse than not dispatching.
+var ErrPlanConflict = errors.New("runplan: plan re-resolution at dispatch reported a blocking finding")
+
+// The three causes a PlanConflictError carries, and the only values its Cause takes.
+const (
+	// ConflictCausePlanDefect is a conflict found before any batch was begun: the approved plan contradicts the tree.
+	ConflictCausePlanDefect = "plan_defect"
+	// ConflictCauseTreeMoved is a conflict found after a batch was begun: the tree moved under the plan.
+	ConflictCauseTreeMoved = "tree_moved"
+	// ConflictCausePlanOrder marks a conflict where every blocking finding is a delete a later card still references.
+	ConflictCausePlanOrder = "plan_order"
+)
+
+// PlanConflictError is the refusal the dispatch re-resolution returns when it reports blocking findings.
+// Batch is the batch whose dispatch was refused.
+// Cause is ConflictCausePlanDefect, ConflictCauseTreeMoved or ConflictCausePlanOrder.
+// Findings is every blocking finding as an error string, in the order the re-resolution reported them.
+// WayForward is the implementer's way forward for Cause, which Error renders last.
+type PlanConflictError struct {
+	Batch      int
+	Cause      string
+	Findings   []string
+	WayForward string
+}
+
+// Error renders the refusal with its class and cause, the findings and the way forward.
+func (e *PlanConflictError) Error() string {
+	return fmt.Sprintf("%s (plan_conflict: %s): %s; way forward: %s", ErrPlanConflict.Error(), e.Cause, strings.Join(e.Findings, "; "), e.WayForward)
+}
+
+// Unwrap returns ErrPlanConflict, so errors.Is identifies the refusal.
+func (e *PlanConflictError) Unwrap() error { return ErrPlanConflict }
+
+// ResolveAtDispatch re-resolves plan against the current tree, never from a cache, before batch number is dispatched.
+// It returns the informational findings as advisories; the run continues past them.
+// Blocking findings refuse with a *PlanConflictError whose way forward is wayForward(cause).
+// An infrastructure error (errors.Is(err, planindex.ErrQuarryUnavailable)) blocks exactly like a blocking finding:
+// dispatching a batch on a re-resolve that failed is worse than not dispatching.
+//
+// The scope is the cards still to be built:
+// a card already built contradicts the tree by design;
+// re-resolving it would report a working plan as a blocking defect.
+// The caller records the batch after this call, so on a first dispatch this batch is still validated;
+// a re-dispatch of a batch whose earlier attempt already landed its work is not refused for it.
+// The forthcoming half keeps the Create targets of begun, unrecorded batches out of the status check,
+// so a re-dispatched batch whose attempt landed nothing does not refuse the later cards that Use them.
+// Once any batch is begun, a pending card's Delete target that is already gone is no blocking finding.
+// It arrives in the advisories as delete-target-gone.
+//
+// The resolve pass canonicalizes handles, which rewrites the plan on disk,
+// so the call re-baselines st's plan fingerprint under runDir before every refusal.
+// A restamp failure never masks a resolve error: the caller is already returning for that reason.
+func ResolveAtDispatch(geom Geometry, plan *planparser.Plan, batches []batcher.Batch, st *State, number int, wayForward func(cause string) string) (advisories []string, err error) {
+	begun, forthcoming := DispatchScope(batches, st)
+	index, err := geom.index()
+	if err != nil {
+		return nil, err
+	}
+	resolveFindings, resolveErr := index.ValidateDispatch(plan, geom.WorktreeRoot, begun, forthcoming)
+	// The status and Create-inversion passes run after the resolve pass's rewrite,
+	// so a rewritten plan routinely also reports a blocking finding,
+	// and the rewrite also survives the pass's own hard-error paths.
+	// Otherwise the state keeps the pre-rewrite fingerprint while the plan on disk carries this run's own sanctioned edit,
+	// and every later dispatch refuses it as a foreign one.
+	if err := RestampFingerprint(st, plan.Dir, geom.RunDir); err != nil && resolveErr == nil {
+		return nil, err
+	}
+	if resolveErr != nil {
+		return nil, resolveErr
+	}
+	var blocking []string
+	orderOnly := true
+	for _, f := range resolveFindings {
+		if f.Severity == planindex.SeverityBlocking {
+			blocking = append(blocking, f.Error())
+			orderOnly = orderOnly && f.Check == planindex.CheckDeleteBeforeReference
+		} else {
+			advisories = append(advisories, f.Error())
+		}
+	}
+	if len(blocking) == 0 {
+		return advisories, nil
+	}
+	// begun is computed before the caller records its batch.
+	// A first dispatch of batch 1 has none begun (plan_defect).
+	// A re-dispatch of a recorded batch has it begun (tree_moved).
+	// A set holding any other finding keeps those two causes, since moving a delete would not settle it.
+	cause := ConflictCauseTreeMoved
+	switch {
+	case orderOnly:
+		cause = ConflictCausePlanOrder
+	case len(begun) == 0:
+		cause = ConflictCausePlanDefect
+	}
+	return nil, &PlanConflictError{Batch: number, Cause: cause, Findings: blocking, WayForward: wayForward(cause)}
+}
+
+const (
+	// ConflictRecordName is the file in the scratch directory a dispatch writes when it refuses with a plan conflict.
+	ConflictRecordName = "plan-conflict.md"
+	// routedConflictName is the file holding the findings of the conflict last routed to plan review.
+	routedConflictName = "plan-conflict-routed.md"
+)
+
+// ConflictRecordPath returns the conflict record's path under scratchDir.
+func ConflictRecordPath(scratchDir string) string {
+	return filepath.Join(scratchDir, ConflictRecordName)
+}
+
+// RoutedConflictPath returns the path of the last-routed conflict file under scratchDir.
+func RoutedConflictPath(scratchDir string) string {
+	return filepath.Join(scratchDir, routedConflictName)
+}
+
+// WriteConflictRecord writes the conflict record naming conflict's batch, cause and blocking findings.
+// The scratch directory must already exist: every caller holds a lock file in it.
+func WriteConflictRecord(scratchDir string, conflict *PlanConflictError) error {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# Plan conflict at begin-batch %02d\ncause: %s\n\n", conflict.Batch, conflict.Cause)
+	for _, finding := range conflict.Findings {
+		b.WriteString("- " + finding + "\n")
+	}
+	if err := os.WriteFile(ConflictRecordPath(scratchDir), []byte(b.String()), 0o644); err != nil {
+		return fmt.Errorf("runplan: write plan-conflict record: %w", err)
+	}
+	return nil
+}
+
+// ConflictRecord is the conflict record as read back from disk.
+// Batch is 0 when the header names none.
+type ConflictRecord struct {
+	Batch    int
+	Findings []string
+}
+
+// ReadConflictRecord reads the conflict record under scratchDir.
+// An absent record reads as a ConflictRecord with no findings.
+func ReadConflictRecord(scratchDir string) (ConflictRecord, error) {
+	recordPath := ConflictRecordPath(scratchDir)
+	data, err := os.ReadFile(recordPath)
+	if os.IsNotExist(err) {
+		return ConflictRecord{}, nil
+	}
+	if err != nil {
+		return ConflictRecord{}, fmt.Errorf("runplan: read %s: %w", recordPath, err)
+	}
+	record := ConflictRecord{Findings: findingLines(string(data))}
+	for _, line := range strings.Split(string(data), "\n") {
+		if number, ok := strings.CutPrefix(line, "# Plan conflict at begin-batch "); ok {
+			record.Batch, _ = strconv.Atoi(number)
+		}
+	}
+	return record, nil
+}
+
+// RemoveConflictRecord removes the conflict record, and is a no-op when it is absent.
+func RemoveConflictRecord(scratchDir string) error {
+	return removeIfPresent(ConflictRecordPath(scratchDir))
+}
+
+// RemoveRoutedConflict removes the last-routed conflict, and is a no-op when it is absent.
+func RemoveRoutedConflict(scratchDir string) error {
+	return removeIfPresent(RoutedConflictPath(scratchDir))
+}
+
+// removeIfPresent removes the file at filePath and returns nil when there is none.
+func removeIfPresent(filePath string) error {
+	if err := os.Remove(filePath); err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("runplan: remove %s: %w", filePath, err)
+	}
+	return nil
+}
+
+// ConflictRoute is the outcome of claiming the conflict record for a reroute to plan review.
+// Found is whether a record naming at least one finding exists.
+// New is whether its findings differ from the last-routed ones,
+// so a reroute to plan review has not yet been asked for them.
+// Findings is the record's finding lines, set when Found.
+type ConflictRoute struct {
+	Found    bool
+	New      bool
+	Findings []string
+}
+
+// ClaimConflictRoute decides whether the conflict record asks for a new reroute to plan review.
+// An absent record, or one naming no finding (a torn write), claims nothing.
+// A record whose findings, compared as a set, differ from the routed file's is new:
+// its findings replace the routed file's before the claim returns.
+// A record whose findings equal the routed ones is a recurrence and writes nothing.
+// A read or write error is returned.
+func ClaimConflictRoute(scratchDir string) (ConflictRoute, error) {
+	recordFindings, err := readFindingLines(ConflictRecordPath(scratchDir))
+	if err != nil {
+		return ConflictRoute{}, err
+	}
+	if len(recordFindings) == 0 {
+		return ConflictRoute{}, nil
+	}
+	routedFindings, err := readFindingLines(RoutedConflictPath(scratchDir))
+	if err != nil {
+		return ConflictRoute{}, err
+	}
+	route := ConflictRoute{Found: true, Findings: recordFindings}
+	if SameFindingSet(recordFindings, routedFindings) {
+		return route, nil
+	}
+	var routed strings.Builder
+	for _, finding := range recordFindings {
+		routed.WriteString("- " + finding + "\n")
+	}
+	if err := os.WriteFile(RoutedConflictPath(scratchDir), []byte(routed.String()), 0o644); err != nil {
+		return ConflictRoute{}, fmt.Errorf("runplan: write routed plan-conflict file: %w", err)
+	}
+	route.New = true
+	return route, nil
+}
+
+// readFindingLines returns the text after "- " of every finding line in the file at filePath.
+// It returns nil when the file is absent.
+func readFindingLines(filePath string) ([]string, error) {
+	data, err := os.ReadFile(filePath)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("runplan: read %s: %w", filePath, err)
+	}
+	return findingLines(string(data)), nil
+}
+
+// findingLines returns the text after "- " of every finding line in a conflict record's or routed file's text.
+func findingLines(text string) []string {
+	var findings []string
+	for _, line := range strings.Split(text, "\n") {
+		if finding, ok := strings.CutPrefix(line, "- "); ok {
+			findings = append(findings, finding)
+		}
+	}
+	return findings
+}
+
+// SameFindingSet reports whether a and b hold the same conflict findings, order ignored.
+func SameFindingSet(a, b []string) bool {
+	sortedA, sortedB := slices.Clone(a), slices.Clone(b)
+	slices.Sort(sortedA)
+	slices.Sort(sortedB)
+	return slices.Equal(sortedA, sortedB)
+}
diff --git a/internal/runplan/digest.go b/internal/runplan/digest.go
new file mode 100644
index 00000000..571c9f4a
--- /dev/null
+++ b/internal/runplan/digest.go
@@ -0,0 +1,85 @@
+// digest.go defines the batch Digest, the snapshot of one batch's outcome.
+// The run records each Digest in its state file and the resume trail.
+// Distill derives a terminal Digest from a batch's Report.
+
+package runplan
+
+import "fmt"
+
+// The six legal Digest.Status values.
+// DigestStatusFailed marks a batch whose report the implementer rejected on its merits.
+// DigestStatusWaiting marks a batch stopped on a step only the run's parent can take; it is in flight, never terminal.
+const (
+	DigestStatusRunning = "running"
+	DigestStatusDone    = "done"
+	DigestStatusStuck   = "stuck"
+	DigestStatusDead    = "dead"
+	DigestStatusFailed  = "failed"
+	DigestStatusWaiting = "waiting"
+)
+
+// The three legal Digest.DeadReason values, set only when Status is DigestStatusDead.
+const (
+	DeadReasonAsking  = "asking"
+	DeadReasonTimeout = "timeout"
+	DeadReasonDied    = "died"
+)
+
+// Digest is the batch-outcome snapshot the implementer records in its state file and the resume trail.
+// Running snapshots carry only Batch, Status, and ElapsedS;
+// the other fields populate once the batch is terminal.
+type Digest struct {
+	Batch string `json:"batch"`
+	// Status is DigestStatusRunning, Done, Stuck, Dead, Failed, or Waiting.
+	Status  string `json:"status"`
+	HeadSHA string `json:"head_sha,omitempty"`
+	// Deviations are the scope guard's files changed outside the batch's targets; informational only, never affects Status.
+	Deviations []string `json:"deviations,omitempty"`
+	// Departures are the Pattern-Departure trailers of the batch's commits as "<subject>: <value>";
+	// informational only, never affects Status.
+	Departures []string `json:"departures,omitempty"`
+	// Renames are the glyph renames the batch's report lists; the post-batch pass applies them to the cards not yet begun.
+	Renames []ReportRename `json:"renames,omitempty"`
+	// DeadReason is set only when Status is Dead.
+	DeadReason string `json:"dead_reason,omitempty"`
+	// Reasons is set only when Status is Failed.
+	Reasons []string `json:"reasons,omitempty"`
+	// Need is the step only the parent can take; set only when Status is Waiting.
+	Need string `json:"need,omitempty"`
+	// ElapsedS is the seconds since spawn, for running snapshots only.
+	ElapsedS int `json:"elapsed_s,omitempty"`
+}
+
+// BatchDepartures returns the departure lines of every non-merge commit a batch made, from startSHA to headSHA.
+// An empty startSHA, from a record written before the field existed, yields none.
+// A commit before startSHA, or one a parent merge-in brought in, is never attributed to the batch.
+// A failed read is returned as an error with a transient way forward, before any batch is marked terminal.
+func BatchDepartures(geom Geometry, startSHA, headSHA string) ([]string, error) {
+	if startSHA == "" {
+		return nil, nil
+	}
+	entries, err := geom.Git.CommitLog(geom.WorktreeRoot, startSHA, headSHA)
+	if err != nil {
+		return nil, fmt.Errorf("runplan: read the commits of %s..%s for the digest's departures: %w; way forward: transient, re-run the verb", startSHA, headSHA, err)
+	}
+	var lines []string
+	for _, entry := range entries {
+		lines = append(lines, entry.DepartureLines()...)
+	}
+	return lines, nil
+}
+
+// Distill computes the digest for a batch report.
+// An OK report maps to Done, a FAILED report to Stuck, and a NEEDS_PARENT report to Waiting with its Need.
+// HeadSHA and Renames carry through.
+// The caller sets Batch, and the scope guard fills Deviations afterwards.
+func Distill(r *Report) Digest {
+	switch r.Status {
+	case ReportStatusOK:
+		return Digest{Status: DigestStatusDone, HeadSHA: r.HeadSHA, Renames: r.Renames}
+	case ReportStatusNeedsParent:
+		return Digest{Status: DigestStatusWaiting, HeadSHA: r.HeadSHA, Renames: r.Renames, Need: r.Need}
+	default:
+		return Digest{Status: DigestStatusStuck, HeadSHA: r.HeadSHA, Renames: r.Renames}
+	}
+}
diff --git a/internal/runplan/doc.go b/internal/runplan/doc.go
new file mode 100644
index 00000000..e0bb2cb6
--- /dev/null
+++ b/internal/runplan/doc.go
@@ -0,0 +1,22 @@
+// Package runplan holds the run-plan state and the batch machinery an implementer runs a plan's batches with.
+//
+// The run-plan state holds the plan fingerprint, the plan file hashes and the overview frame hash.
+// It also holds the recorded partition and the batch records.
+// An implementer's own state type embeds State beside its own fields, so the run-plan part keeps one schema.
+// A batch-record field only one implementer fills is optional and stays empty under another.
+//
+// The machinery is the batch report contract and its parser, and the plan fingerprint and its re-baseline.
+// It also covers the plan re-resolution at dispatch and its plan-conflict record.
+// The post-batch checks cover the done checks, handle binding, the scope guard and drift repair.
+// They also cover the renames that rewrite pending cards.
+// The suspect-path checks, the batch digest and the card gate rendering belong to it as well.
+// So do the bounded wait for a batch report, the recovery strand stop and the verify-failure record.
+//
+// Every piece is told its paths through Geometry: the implementer's run, reports, prompts and scratch directories,
+// and the scratch directory its state-mutation lease sits in.
+// Two texts keep webster's names because readers pin them:
+// the begin-batch header of the plan-conflict record and the handle-bind log line.
+// Nothing else here names an implementer or its verbs.
+// A refusal that ends in a way forward takes that text from its caller,
+// so each implementer names its own way forward.
+package runplan
diff --git a/internal/runplan/fingerprint.go b/internal/runplan/fingerprint.go
new file mode 100644
index 00000000..504a4122
--- /dev/null
+++ b/internal/runplan/fingerprint.go
@@ -0,0 +1,338 @@
+// fingerprint.go computes the plan-identity hash a run records at first init.
+// It also re-baselines the hash after the run's own plan rewrites.
+// Every later entry recomputes it and compares it with the plan on disk,
+// so the crash/resume guard can detect a plan that went stale across a crash/resume boundary.
+// The re-baseline also stores the content behind every recorded hash, so the plan can be restored later.
+
+package runplan
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// PlanOverviewFile is the plan's overview file, which carries the integration verify.
+// A rebaseline accepts a change to its Card Index only.
+const PlanOverviewFile = "00-overview.md"
+
+// ErrFingerprintMismatch is the sentinel an edit check returns for a plan that no longer matches its fingerprint.
+// It means the on-disk plan's recomputed fingerprint disagrees with State.PlanFingerprint.
+// It guards a crashed or resumed run against a plan edited since the run recorded its fingerprint.
+var ErrFingerprintMismatch = errors.New("runplan: on-disk plan fingerprint does not match this run's recorded state")
+
+// PlanBaselineDirName is the directory under the run directory that holds one file per recorded plan content.
+// Each file is named by the hex SHA-256 of its content.
+const PlanBaselineDirName = "plan-baseline"
+
+// Fingerprint returns the hex SHA-256 digest over the name and contents of each plan file in planDir.
+// The crash/resume guard compares this digest against the fingerprint the run recorded.
+// It does not restamp the state, so a plan rewritten after the call leaves the recorded fingerprint stale.
+func Fingerprint(planDir string) (string, error) {
+	names, err := planFileNames(planDir)
+	if err != nil {
+		return "", err
+	}
+
+	h := sha256.New()
+	for _, name := range names {
+		data, err := os.ReadFile(filepath.Join(planDir, name))
+		if err != nil {
+			return "", fmt.Errorf("runplan: fingerprint %s: read %s: %w", planDir, name, err)
+		}
+		// Trailing NUL separates name and contents to prevent concatenation collisions.
+		h.Write([]byte(name))
+		h.Write([]byte{0})
+		h.Write(data)
+		h.Write([]byte{0})
+	}
+
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+// planFileNames lists the ".md" files in planDir that are plan content, sorted.
+// The pipeline's own records are left out: the amendment log, the lens review, and the lens reports saved beside it.
+// They record changes to the plan rather than plan content.
+// Including them would make the run's own drift repair invalidate the plan it had just repaired.
+func planFileNames(planDir string) ([]string, error) {
+	entries, err := os.ReadDir(planDir)
+	if err != nil {
+		return nil, fmt.Errorf("runplan: plan files %s: %w", planDir, err)
+	}
+	var names []string
+	for _, e := range entries {
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".md") || e.Name() == planparser.AmendmentsFileName || e.Name() == planparser.LensReviewFileName || planparser.IsLensReportFileName(e.Name()) {
+			continue
+		}
+		names = append(names, e.Name())
+	}
+	sort.Strings(names)
+	return names, nil
+}
+
+// PlanFileHashes returns the hex SHA-256 of each plan file in planDir, keyed by file name.
+func PlanFileHashes(planDir string) (map[string]string, error) {
+	names, err := planFileNames(planDir)
+	if err != nil {
+		return nil, err
+	}
+	hashes := make(map[string]string, len(names))
+	for _, name := range names {
+		data, err := os.ReadFile(filepath.Join(planDir, name))
+		if err != nil {
+			return nil, fmt.Errorf("runplan: plan file hashes %s: read %s: %w", planDir, name, err)
+		}
+		sum := sha256.Sum256(data)
+		hashes[name] = hex.EncodeToString(sum[:])
+	}
+	return hashes, nil
+}
+
+// OverviewFrameHash returns the hex SHA-256 of planDir's overview with its Card Index section cut out.
+// It is the frame that State.PlanOverviewFrameHash records.
+// A plan directory without an overview has no frame and hashes to "".
+// That value makes a rebaseline refuse any overview change.
+func OverviewFrameHash(planDir string) (string, error) {
+	data, err := os.ReadFile(filepath.Join(planDir, PlanOverviewFile))
+	if errors.Is(err, fs.ErrNotExist) {
+		return "", nil
+	}
+	if err != nil {
+		return "", fmt.Errorf("runplan: overview frame hash %s: read %s: %w", planDir, PlanOverviewFile, err)
+	}
+	hash, err := OverviewFrameHashOf(data)
+	if err != nil {
+		return "", fmt.Errorf("runplan: overview frame hash %s: %w", planDir, err)
+	}
+	return hash, nil
+}
+
+// OverviewFrameHashOf returns the hex SHA-256 of overview, an overview file's content, with its Card Index cut out.
+// It fails when overview has no Card Index or no well-formed frontmatter.
+func OverviewFrameHashOf(overview []byte) (string, error) {
+	frame, err := planparser.OverviewWithoutCardIndex(overview)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(frame)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+// ChangedPlanFiles returns the plan file names whose current hash differs from st.PlanFileHashes.
+// It also returns files added or removed since, all sorted.
+func ChangedPlanFiles(st *State, planDir string) ([]string, error) {
+	now, err := PlanFileHashes(planDir)
+	if err != nil {
+		return nil, err
+	}
+	var changed []string
+	for name, h := range now {
+		if want, ok := st.PlanFileHashes[name]; !ok || want != h {
+			changed = append(changed, name)
+		}
+	}
+	for name := range st.PlanFileHashes {
+		if _, ok := now[name]; !ok {
+			changed = append(changed, name)
+		}
+	}
+	sort.Strings(changed)
+	return changed, nil
+}
+
+// PlanEditError returns nil when the plan on disk fingerprints to st.PlanFingerprint.
+// Otherwise it returns the ErrFingerprintMismatch wrap naming both fingerprints, followed by the text wayForward returns.
+// That text is the caller's own account of the mismatch and its way forward.
+// wayForward runs only on a mismatch, so a caller may read the changed files to word it.
+// Callers that rewrite the plan call it before their own rewrites,
+// so any difference it sees is someone else's edit rather than the run's own.
+func PlanEditError(st *State, planDir string, wayForward func() string) error {
+	fp, err := Fingerprint(planDir)
+	if err != nil {
+		return err
+	}
+	if st.PlanFingerprint != fp {
+		return fmt.Errorf("%w: on-disk plan fingerprint %s does not match this run's recorded fingerprint %s; %s", ErrFingerprintMismatch, fp, st.PlanFingerprint, wayForward())
+	}
+	return nil
+}
+
+// BatchCardEditError returns nil when every card of b still hashes to the content bs recorded at begin.
+// It also returns nil when bs recorded none.
+// Otherwise it returns an ErrFingerprintMismatch wrap naming each card that changed since its batch was begun.
+// The wrap ends in the way forward wayForward returns.
+func BatchCardEditError(bs *BatchState, b batcher.Batch, planDir string, wayForward func() string) error {
+	if len(bs.CardHashes) == 0 {
+		return nil
+	}
+	now, err := BatchCardHashes(b, planDir)
+	if err != nil {
+		return err
+	}
+	number, _ := BatchIdentity(b)
+	var changed []string
+	for _, id := range BatchCardIDs(b) {
+		if want, ok := bs.CardHashes[id]; ok && want != now[id] {
+			changed = append(changed, fmt.Sprintf("batch %02d card %s changed since it was begun", number, id))
+		}
+	}
+	if len(changed) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: %s; %s", ErrFingerprintMismatch, strings.Join(changed, "; "), wayForward())
+}
+
+// RestampFingerprint re-baselines planDir's fingerprint into st.PlanFingerprint.
+// It sets st.PlanFileHashes to the per-file hashes of planDir too.
+// Callers call it after any pass that may have rewritten the plan on disk.
+//
+// The staleness guard catches a plan edited from outside the run between two batches,
+// and it cannot tell such an edit apart from the run's own rewrites unless the run re-baselines after making them.
+// Sanctioned rewrites: handle canonicalization at dispatch; handle binding and drift repair in the post-batch checks.
+// Without the re-baseline, one rewrite would make every later dispatch fail with ErrFingerprintMismatch.
+//
+// Re-baselining gives up nothing the guard provides:
+// an edit that lands between this call and the next dispatch is still caught.
+//
+// It stores the hashed content under runDir before it mutates st.
+// A store failure therefore leaves the state's hashes unchanged.
+//
+// It moves each begun batch's recorded CardHashes entry along with the rewrite,
+// so a card that the run's own rewrite changed is not later refused as an operator edit.
+// The move is bounded: only a card whose recorded hash equals the pre-rewrite PlanFileHashes entry for its file moves.
+// Callers run a foreign-edit check first, so an edit already on disk is refused rather than adopted;
+// an edit that lands between that check and this restamp is adopted with the rewrite.
+func RestampFingerprint(st *State, planDir, runDir string) error {
+	before := st.PlanFileHashes
+	if err := RestampBaseline(st, planDir, runDir); err != nil {
+		return err
+	}
+	moveBegunCardHashes(st, before, st.PlanFileHashes)
+	return nil
+}
+
+// RestampBaseline records planDir's fingerprint, per-file hashes, overview frame hash and stored baseline into st.
+// It touches no batch record.
+func RestampBaseline(st *State, planDir, runDir string) error {
+	fp, err := Fingerprint(planDir)
+	if err != nil {
+		return err
+	}
+	hashes, err := PlanFileHashes(planDir)
+	if err != nil {
+		return err
+	}
+	frame, err := OverviewFrameHash(planDir)
+	if err != nil {
+		return fmt.Errorf("%w; way forward: transient, re-run the verb", err)
+	}
+	if err := StorePlanBaseline(runDir, planDir, hashes); err != nil {
+		return err
+	}
+	st.PlanFingerprint = fp
+	st.PlanFileHashes = hashes
+	st.PlanOverviewFrameHash = frame
+	return nil
+}
+
+// moveBegunCardHashes moves each batch record's CardHashes entry for a card to that card's hash in after.
+// It moves only an entry equal to the card's hash in before.
+// An entry that differs keeps its hash, so a card an earlier untracked rewrite already moved stays refused.
+// A file absent from either map is left alone, and so is every record when before is empty.
+func moveBegunCardHashes(st *State, before, after map[string]string) {
+	if len(before) == 0 {
+		return
+	}
+	for _, bs := range st.Batches {
+		if bs == nil {
+			continue
+		}
+		for id, recorded := range bs.CardHashes {
+			file := id + ".md"
+			old, okBefore := before[file]
+			now, okAfter := after[file]
+			if okBefore && okAfter && recorded == old {
+				bs.CardHashes[id] = now
+			}
+		}
+	}
+}
+
+// PlanBaselinePath returns the stored copy's path for a content hash under runDir.
+func PlanBaselinePath(runDir, hash string) string {
+	return filepath.Join(runDir, PlanBaselineDirName, hash)
+}
+
+// StorePlanBaseline writes each plan file's bytes to its hash's file under runDir when that file is absent.
+// The store is content-addressed, so a repeat write is a no-op.
+// A file whose bytes no longer hash to their recorded value is refused, and nothing is written for it,
+// so no stored copy is ever wrong.
+// An empty runDir is a wiring error, returned rather than resolved against the working directory.
+func StorePlanBaseline(runDir, planDir string, hashes map[string]string) error {
+	if runDir == "" {
+		return errors.New("runplan: store plan baseline: empty run dir")
+	}
+	dir := filepath.Join(runDir, PlanBaselineDirName)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("runplan: store plan baseline: %w", err)
+	}
+	names := make([]string, 0, len(hashes))
+	for name := range hashes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		dst := PlanBaselinePath(runDir, hashes[name])
+		if _, err := os.Stat(dst); err == nil {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(planDir, name))
+		if err != nil {
+			return fmt.Errorf("runplan: store plan baseline: read %s: %w", name, err)
+		}
+		if sum := sha256.Sum256(data); hex.EncodeToString(sum[:]) != hashes[name] {
+			return fmt.Errorf("runplan: store plan baseline: %s changed since its hash was recorded; way forward: transient, re-run the verb once nothing else is editing the plan", name)
+		}
+		if err := WriteFileAtomic(dir, dst, data); err != nil {
+			return fmt.Errorf("runplan: store plan baseline: %s: %w", name, err)
+		}
+	}
+	return nil
+}
+
+// WriteFileAtomic writes data to dst through a temp file in dir and a rename,
+// so a reader never observes a half-written file.
+func WriteFileAtomic(dir, dst string, data []byte) error {
+	tmp, err := os.CreateTemp(dir, ".tmp-*")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	if _, err := tmp.Write(data); err != nil {
+		_ = tmp.Close()
+		_ = os.Remove(tmpName)
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	if err := os.Chmod(tmpName, 0o644); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	if err := os.Rename(tmpName, dst); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	return nil
+}
diff --git a/internal/runplan/fingerprint_test.go b/internal/runplan/fingerprint_test.go
new file mode 100644
index 00000000..955132a9
--- /dev/null
+++ b/internal/runplan/fingerprint_test.go
@@ -0,0 +1,58 @@
+// fingerprint_test.go covers the begun-card hash move a plan re-baseline makes.
+// Tier 0: no git, no files.
+
+package runplan
+
+import (
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestMoveBegunCardHashes proves a begun card's recorded hash moves only when it equals the pre-rewrite file hash.
+// A mismatching one keeps its old hash, and a file absent from either map is left alone.
+// An empty PlanFileHashes is a no-op.
+func TestMoveBegunCardHashes(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	newState := func() *State {
+		return &State{Batches: map[int]*BatchState{
+			1: {CardHashes: map[string]string{"01-a": "a0"}},
+			2: {CardHashes: map[string]string{"02-b": "stale"}},
+			3: {CardHashes: map[string]string{"03-c": "c0"}},
+			4: {CardHashes: map[string]string{"04-d": "d0"}},
+			5: nil,
+			6: {},
+		}}
+	}
+	before := map[string]string{"01-a.md": "a0", "02-b.md": "b0", "03-c.md": "c0"}
+	after := map[string]string{"01-a.md": "a1", "02-b.md": "b1", "04-d.md": "d1"}
+
+	t.Run("moves only an exact match", func(t *testing.T) {
+		t.Parallel()
+		st := newState()
+		moveBegunCardHashes(st, before, after)
+		if got := st.Batches[1].CardHashes["01-a"]; got != "a1" {
+			t.Errorf("matching hash = %q; want it moved to a1", got)
+		}
+		if got := st.Batches[2].CardHashes["02-b"]; got != "stale" {
+			t.Errorf("mismatching hash = %q; want it kept as stale", got)
+		}
+		if got := st.Batches[3].CardHashes["03-c"]; got != "c0" {
+			t.Errorf("hash for a file absent from after = %q; want it left at c0", got)
+		}
+		if got := st.Batches[4].CardHashes["04-d"]; got != "d0" {
+			t.Errorf("hash for a file absent from before = %q; want it left at d0", got)
+		}
+	})
+
+	t.Run("empty before is a no-op", func(t *testing.T) {
+		t.Parallel()
+		st := newState()
+		moveBegunCardHashes(st, nil, after)
+		if got := st.Batches[1].CardHashes["01-a"]; got != "a0" {
+			t.Errorf("hash = %q; want it unchanged with no PlanFileHashes", got)
+		}
+	})
+}
diff --git a/internal/runplan/geometry.go b/internal/runplan/geometry.go
new file mode 100644
index 00000000..cca5483c
--- /dev/null
+++ b/internal/runplan/geometry.go
@@ -0,0 +1,87 @@
+// geometry.go declares Geometry, the paths, Git and code index the shared batch machinery is told by its implementer.
+// It also declares Git, the questions the machinery asks a worktree's repository.
+
+package runplan
+
+import (
+	"errors"
+
+	"github.com/Knatte18/loomyard/internal/planindex"
+)
+
+// errNoIndex is returned by a call that needs the code index when Geometry.Index was never wired.
+var errNoIndex = errors.New("runplan: the geometry carries no code index; the implementer's CLI layer must set Geometry.Index")
+
+// Geometry is the set of paths an implementer tells the shared batch machinery.
+// It also carries the Git and code index the machinery reads through.
+// No method validates or recomputes a field: the caller populates every path field with a usable absolute path.
+type Geometry struct {
+	// WorktreeRoot is the git worktree's root; every git call opens the repository here.
+	WorktreeRoot string
+	// PaneCwd is the directory the implementer's sessions run in.
+	// A relative recorded path resolves against it, and the run's `_lym` is read under it.
+	PaneCwd string
+	// PlanDir is the plan directory the run builds.
+	PlanDir string
+	// RunDir is the implementer's durable run directory, which holds its state file and the plan baseline store.
+	RunDir string
+	// ReportsDir is the directory holding the implementer's per-batch report files and its verify-failure record.
+	ReportsDir string
+	// PromptsDir is the directory holding the implementer's rendered batch prompts.
+	PromptsDir string
+	// ScratchDir is the implementer's never-tracked directory.
+	// It holds its locks, its state-mutation lease and its plan-conflict record.
+	ScratchDir string
+	// Git is the git surface every worktree read goes through; the caller always sets it.
+	Git Git
+	// Index is the code index the dispatch re-resolution and the post-batch checks call.
+	// A call that reaches a nil Index returns an error naming the missing wiring.
+	Index planindex.Index
+}
+
+// index returns the geometry's code index, or errNoIndex when none was wired.
+func (g Geometry) index() (planindex.Index, error) {
+	if g.Index == nil {
+		return nil, errNoIndex
+	}
+	return g.Index, nil
+}
+
+// Git is every question the shared batch machinery puts to a worktree's git repository.
+// Each method takes the worktree to ask about, so one Git serves a run and its linked worktrees alike.
+type Git interface {
+	// SHAExists reports whether sha names a commit in the worktree's repository.
+	SHAExists(worktree, sha string) bool
+	// IsAncestor reports whether sha is an ancestor of ref.
+	IsAncestor(worktree, sha, ref string) (bool, error)
+	// IgnoredPath reports whether git ignores path in the worktree.
+	IgnoredPath(worktree, path string) (bool, error)
+	// PathDiffers reports whether path differs from base in the worktree: a changed tracked file or an untracked new one.
+	PathDiffers(worktree, base, path string) (bool, error)
+	// WorktreeBlob returns the blob id of path's content in the worktree, or "" when the file is absent.
+	WorktreeBlob(worktree, path string) (string, error)
+	// CommitBlob returns the blob id of path at commit, or "" when the commit does not hold the path.
+	CommitBlob(worktree, commit, path string) (string, error)
+	// TreePathsWithBlob returns, sorted, every path in commit's tree whose object id is blob.
+	TreePathsWithBlob(worktree, commit, blob string) ([]string, error)
+	// CommitLog returns, oldest first, the non-merge commits on head's first-parent line after base, both full SHAs.
+	// A base that is not on that line, or a SHA the repository does not hold, is an error.
+	CommitLog(worktree, base, head string) ([]CommitLogEntry, error)
+}
+
+// CommitLogEntry is one commit in a commit log, with the departures its message declares.
+type CommitLogEntry struct {
+	SHA     string
+	Subject string
+	// Departures holds the value of each `Pattern-Departure:` trailer line of the commit message, in order and verbatim.
+	Departures []string
+}
+
+// DepartureLines renders each departure as "<subject>: <value>", in order.
+func (e CommitLogEntry) DepartureLines() []string {
+	lines := make([]string, 0, len(e.Departures))
+	for _, departure := range e.Departures {
+		lines = append(lines, e.Subject+": "+departure)
+	}
+	return lines
+}
diff --git a/internal/runplan/partition.go b/internal/runplan/partition.go
new file mode 100644
index 00000000..d7c4b7f5
--- /dev/null
+++ b/internal/runplan/partition.go
@@ -0,0 +1,145 @@
+// partition.go maps a run's recorded partition onto the current plan's cards.
+
+package runplan
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// ErrPartitionMismatch is the sentinel error for a recorded partition that does not name the same cards as the plan.
+var ErrPartitionMismatch = errors.New("runplan: recorded partition does not match the plan")
+
+// MapPartition maps the recorded batches onto the plan's cards by id.
+// Each batch keeps its recorded profile and estimate.
+// It refuses with ErrPartitionMismatch when a recorded id is not a card of the plan.
+// It refuses the same way when a plan card is in no recorded batch.
+// The refusal ends in wayForward, the caller's way forward from a plan that no longer matches its partition.
+func MapPartition(plan *planparser.Plan, partition []PartitionBatch, wayForward string) ([]batcher.Batch, error) {
+	cardsByID := make(map[string]planparser.Card, len(plan.Cards))
+	for _, c := range plan.Cards {
+		cardsByID[CardID(c)] = c
+	}
+
+	recorded := make(map[string]bool, len(plan.Cards))
+	var unknown []string
+	batches := make([]batcher.Batch, 0, len(partition))
+	for _, pb := range partition {
+		batch := batcher.Batch{Profile: pb.Profile, Estimate: pb.Estimate, Breakdown: pb.Breakdown}
+		for _, id := range pb.Cards {
+			card, ok := cardsByID[id]
+			if !ok {
+				unknown = append(unknown, id)
+				continue
+			}
+			recorded[id] = true
+			batch.Cards = append(batch.Cards, card)
+		}
+		batches = append(batches, batch)
+	}
+
+	var unrecorded []string
+	for _, c := range plan.Cards {
+		if id := CardID(c); !recorded[id] {
+			unrecorded = append(unrecorded, id)
+		}
+	}
+	if len(unknown) == 0 && len(unrecorded) == 0 {
+		return batches, nil
+	}
+
+	sort.Strings(unknown)
+	var problems []string
+	if len(unknown) > 0 {
+		problems = append(problems, "recorded cards "+strings.Join(unknown, ", ")+" are not cards of the plan")
+	}
+	if len(unrecorded) > 0 {
+		problems = append(problems, "plan cards "+strings.Join(unrecorded, ", ")+" are in no recorded batch")
+	}
+	return nil, fmt.Errorf("%w: %s; way forward: %s", ErrPartitionMismatch, strings.Join(problems, "; "), wayForward)
+}
+
+// FindBatch returns the batch in batches whose number matches number.
+// When none matches, it returns an error ending in wayForward, the caller's way to list the run's batches.
+func FindBatch(batches []batcher.Batch, number int, wayForward string) (batcher.Batch, error) {
+	for _, b := range batches {
+		if n, _ := BatchIdentity(b); n == number {
+			return b, nil
+		}
+	}
+	return batcher.Batch{}, fmt.Errorf("runplan: batch %d not found in the plan's execution batches; way forward: %s", number, wayForward)
+}
+
+// CompletedCards returns the cards of every batch that has reached a terminal classification, in batches' own order.
+//
+// It scopes the dispatch-boundary re-resolution and the post-batch drift detection to work that has not landed yet.
+// A plan describes intended change, so a card already built contradicts the tree it is re-resolved against:
+// its Create target exists, its Delete target is gone, and its Rename's old side no longer resolves.
+// A non-zero exclude also counts that batch as completed:
+// the post-batch checks run while the batch they record is still non-terminal, and that batch's work has just landed.
+func CompletedCards(batches []batcher.Batch, st *State, exclude int) []planparser.Card {
+	if st == nil {
+		return nil
+	}
+
+	var done []planparser.Card
+	for _, b := range batches {
+		number, _ := BatchIdentity(b)
+		if number != exclude {
+			bs, ok := st.Batches[number]
+			if !ok || bs == nil || !bs.Terminal {
+				continue
+			}
+		}
+		done = append(done, b.Cards...)
+	}
+	return done
+}
+
+// UnbegunCards returns the cards of every batch with no record in st, in batches' own order.
+func UnbegunCards(batches []batcher.Batch, st *State) []planparser.Card {
+	var cards []planparser.Card
+	for _, b := range batches {
+		number, _ := BatchIdentity(b)
+		if bs, ok := st.Batches[number]; ok && bs != nil {
+			continue
+		}
+		cards = append(cards, b.Cards...)
+	}
+	return cards
+}
+
+// DispatchScope computes the dispatch scoping an implementer's begin, run and validate paths share.
+// begun is every card of a batch that has a record, terminal or not, in batches' own order.
+// forthcoming is the cards of every begun batch whose record is not terminal.
+// A terminal batch's cards are never forthcoming: its done-checks proved its targets present.
+// A nil state returns two nil slices.
+//
+// A batch begun but never recorded may already have landed its work, so its Create targets can exist.
+// Validating it as unstarted would refuse the very resume that records it.
+// Its targets may equally not have landed yet, which is why forthcoming exists:
+// the dispatch validation excludes a forthcoming card's Create and Rename New targets from its status check,
+// so a later card that Uses them is not refused.
+func DispatchScope(batches []batcher.Batch, st *State) (begun, forthcoming []planparser.Card) {
+	if st == nil {
+		return nil, nil
+	}
+
+	for _, b := range batches {
+		number, _ := BatchIdentity(b)
+		bs, ok := st.Batches[number]
+		if !ok || bs == nil {
+			continue
+		}
+		begun = append(begun, b.Cards...)
+		if !bs.Terminal {
+			forthcoming = append(forthcoming, b.Cards...)
+		}
+	}
+	return begun, forthcoming
+}
diff --git a/internal/runplan/postbatch.go b/internal/runplan/postbatch.go
new file mode 100644
index 00000000..3b993fb5
--- /dev/null
+++ b/internal/runplan/postbatch.go
@@ -0,0 +1,428 @@
+// postbatch.go holds the post-batch checks every terminal batch owes.
+// They are the done checks, the re-sign rebind, handle binding and the glyph scope guard.
+// They also include drift detection with the renames that rewrite the cards not yet begun.
+
+package runplan
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/planindex"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// ErrCardNotDone is the sentinel the post-batch checks return when a done-check reports a blocking finding.
+// Such a finding concerns the batch's own cards.
+// It is a Create target that still does not resolve, or a Delete target that still does.
+// The implementer turns it into a failed batch, with the findings as its reasons.
+var ErrCardNotDone = errors.New("runplan: the post-batch done-checks reported a blocking finding")
+
+// ErrLaterTargetRemoved is the sentinel the post-batch checks return for a removed symbol a later card names.
+// A batch causes it by removing that symbol.
+// The batch is handed back to its attempt once, while that attempt still holds the batch's context.
+var ErrLaterTargetRemoved = errors.New("runplan: the batch removed a symbol a later card names")
+
+// LaterTargetRemovedError is the refusal the post-batch checks return, once per bracket.
+// It covers a batch that removes a symbol a later card names without reporting a rename.
+// The batch stays non-terminal with its report in place.
+// The next record of the batch records it instead of refusing again.
+type LaterTargetRemovedError struct {
+	// Batch names the batch as NN-<slug>.
+	Batch string
+	// Number is the batch's number.
+	Number int
+	// Reasons holds one line per later card and removed symbol.
+	Reasons []string
+	// WayForward is the implementer's way forward through the batch's attempt.
+	WayForward string
+}
+
+// Error names each removed symbol and the later card that names it, then the way forward.
+func (e *LaterTargetRemovedError) Error() string {
+	return fmt.Sprintf("%s: batch %s: %s; way forward: %s", ErrLaterTargetRemoved, e.Batch, strings.Join(e.Reasons, "; "), e.WayForward)
+}
+
+// Unwrap returns the later-target-removed sentinel, so errors.Is matches it.
+func (e *LaterTargetRemovedError) Unwrap() error { return ErrLaterTargetRemoved }
+
+// CardNotDoneError is the error the post-batch done-checks return, and it unwraps to ErrCardNotDone.
+// Its message carries the findings' text.
+// The flags record which kinds of finding it holds, so the implementer can word the way forward.
+type CardNotDoneError struct {
+	// Reasons is each finding's text.
+	Reasons []string
+	// DeleteNotDone is set for a Delete target that still resolves.
+	DeleteNotDone bool
+	// GlyphRejected is set when quarry rejects a card's target before resolving it.
+	GlyphRejected bool
+	// CreateNotDone is set for a Create target that still does not resolve, or for a Rename pair that did not happen.
+	CreateNotDone bool
+	// SignatureMismatch is set when a target's member is declared only with another parameter list.
+	SignatureMismatch bool
+}
+
+func (e *CardNotDoneError) Error() string {
+	return fmt.Sprintf("%s: %s", ErrCardNotDone, strings.Join(e.Reasons, "; "))
+}
+
+func (e *CardNotDoneError) Unwrap() error { return ErrCardNotDone }
+
+// LaterDeleteReferenceReasons returns one reason per blocking reference to a symbol the cards in own delete.
+// The reference comes from an unbegun card.
+// batches is the run's recorded partition mapped onto the current plan, so the unbegun cards are the pending ones.
+// A method matched by name alone is informational and gives no reason:
+// its receiver is not resolved, and the later card's verify build catches a real call.
+// An infrastructure error is wrapped in planindex.ErrQuarryUnavailable.
+func LaterDeleteReferenceReasons(plan *planparser.Plan, batches []batcher.Batch, st *State, own []planparser.Card, geom Geometry) ([]string, error) {
+	index, err := geom.index()
+	if err != nil {
+		return nil, err
+	}
+	findings, err := index.LaterDeleteReferences(plan, own, UnbegunCards(batches, st), geom.WorktreeRoot)
+	if err != nil {
+		return nil, err
+	}
+	reasons := make([]string, 0, len(findings))
+	for _, f := range findings {
+		if f.Severity == planindex.SeverityBlocking {
+			reasons = append(reasons, f.Error())
+		}
+	}
+	return reasons, nil
+}
+
+// PostBatchInputs carries everything the post-batch checks need.
+type PostBatchInputs struct {
+	// Plan is the parsed plan the checks read and rewrite.
+	Plan *planparser.Plan
+	// State is the run-plan state the plan re-baselines record into.
+	State *State
+	// Batch is the record being finished; a removed later target sets its LaterTargetsReturned.
+	Batch *BatchState
+	// Geom is the told geometry the checks read the worktree, plan and run directories from.
+	Geom Geometry
+	// Batches is the run's recorded partition mapped onto the current plan, in execution order.
+	// Drift detection scopes to the cards of the batches not yet terminal, this one excluded.
+	Batches []batcher.Batch
+	// Number is the batch's number, and Cards its own cards.
+	Number int
+	Cards  []planparser.Card
+	// StartSHA is the bracket record's captured start SHA and HeadSHA the reconciled report head.
+	StartSHA string
+	HeadSHA  string
+	// Label names the batch in warnings.
+	Label string
+	// Renames are the glyph renames the batch's report lists, which drift detection repairs in the cards not yet begun.
+	Renames []ReportRename
+	// HandBackRemovedTargets asks the checks to refuse with *LaterTargetRemovedError for a removed later target.
+	// The refusal applies when the batch removed a symbol a later card names.
+	// The refusal comes before any plan rewrite past the re-sign rebind.
+	HandBackRemovedTargets bool
+	// HandBackWayForward is the way forward that refusal names.
+	HandBackWayForward string
+	// RecordWarning records a later card's drift finding once on the batch, keyed by id.
+	// It returns the warning's text and whether it was newly recorded.
+	RecordWarning func(id, class, detail string) (text string, added bool)
+}
+
+// Bind reasons that PostBatchChecks decides itself.
+const (
+	// bindCardNotDone marks a handle of a card the done-checks reported findings for.
+	bindCardNotDone planindex.BindReason = "card-not-done"
+	// bindBatchNotDone marks a handle of a card whose batch-mate failed the done-checks, so the pass never bound it.
+	bindBatchNotDone planindex.BindReason = "batch-not-done"
+	// bindDeltaUnavailable marks a handle the pass could not bind because the batch's delta was unavailable.
+	bindDeltaUnavailable planindex.BindReason = "delta-unavailable"
+	// bindLanguageNone marks a handle of a plan whose language opts out of glyphs.
+	bindLanguageNone planindex.BindReason = "language-none"
+)
+
+// failedBindOutcomes returns one failed outcome for each handle the cards own, in card and body order.
+// reasonFor picks the reason each card's handles fail with.
+func failedBindOutcomes(cards []planparser.Card, reasonFor func(planparser.Card) planindex.BindReason) []planindex.BindOutcome {
+	var outcomes []planindex.BindOutcome
+	for _, c := range cards {
+		for _, handle := range planparser.OwnedHandles(c) {
+			outcomes = append(outcomes, planindex.BindOutcome{Card: c.Number, Handle: handle, Reason: reasonFor(c)})
+		}
+	}
+	return outcomes
+}
+
+// logBindOutcomes writes one Info line per handle outcome, so the bind rate is countable by grep.
+func logBindOutcomes(batch int, outcomes []planindex.BindOutcome) {
+	for _, o := range outcomes {
+		if o.Reason == "" {
+			logger.Info("webster: handle bind", "batch", batch, "card", o.Card, "handle", o.Handle, "outcome", "bound", "glyph", o.Glyph)
+			continue
+		}
+		logger.Info("webster: handle bind", "batch", batch, "card", o.Card, "handle", o.Handle, "outcome", "failed", "reason", string(o.Reason))
+	}
+}
+
+// CardNotDoneFor returns the *CardNotDoneError that findings make against batch number's own cards.
+// It returns nil when findings is empty.
+// It logs every handle of the batch as failed,
+// so the bind trace names the card that was not done and the batch-mates held back with it.
+func CardNotDoneFor(number int, cards []planparser.Card, findings []planindex.Finding) *CardNotDoneError {
+	if len(findings) == 0 {
+		return nil
+	}
+	notDone := &CardNotDoneError{}
+	notDoneCards := map[string]bool{}
+	for _, f := range findings {
+		notDone.Reasons = append(notDone.Reasons, f.Error())
+		notDoneCards[f.Card] = true
+		switch f.Check {
+		case "delete-not-done":
+			notDone.DeleteNotDone = true
+		case "glyph-rejected":
+			notDone.GlyphRejected = true
+		case "create-not-done", "rename-not-done":
+			notDone.CreateNotDone = true
+		case "signature-mismatch":
+			notDone.SignatureMismatch = true
+		}
+	}
+	logBindOutcomes(number, failedBindOutcomes(cards, func(c planparser.Card) planindex.BindReason {
+		if notDoneCards[c.ID()] {
+			return bindCardNotDone
+		}
+		return bindBatchNotDone
+	}))
+	return notDone
+}
+
+// rereadCards returns cards as plan holds them now, matched by card ID; a card plan no longer holds stays as given.
+func rereadCards(plan *planparser.Plan, cards []planparser.Card) []planparser.Card {
+	reread := make([]planparser.Card, len(cards))
+	for i, c := range cards {
+		reread[i] = c
+		for _, current := range plan.Cards {
+			if current.ID() == c.ID() {
+				reread[i] = current
+				break
+			}
+		}
+	}
+	return reread
+}
+
+// PostBatchChecks runs the mechanical pass every terminal batch owes, whichever path takes it terminal.
+// It runs the card done-checks and carries a recorded C# re-sign into the plan.
+// It computes the single delta that the rest of the pass shares.
+// It then binds handles, runs the glyph scope guard, and runs drift detection with its exact-tier auto-repair.
+// It also runs the plan-staleness re-baseline each of those rewrites requires.
+//
+// The scope guard's findings come back as deviations.
+// They are the deduplicated, sorted files the batch changed outside its targets.
+// They are informational and never join the warnings.
+// When the delta cannot be computed, there are no deviations, and the could-not-run warning is returned instead.
+//
+// A batch that reached done through a recovery is exactly as done as one its first attempt finished:
+// its Create targets have to resolve, its plan: handles have to bind,
+// and the drift its work caused has to be repaired or reported.
+// Skipping this pass for a recovered batch would leave its plan: handles unbound.
+// Every later card would then reference an unbound handle.
+// Drift detection would not see those references, since its reference index keys on the ref as the card spells it.
+//
+// Findings about the batch's own cards (done-checks, blocking bind findings) come back as an error.
+// That error wraps ErrCardNotDone.
+// Drift findings concern later cards, so they become `later card:` warnings recorded once through in.RecordWarning.
+// Informational findings ride out on warnings too.
+// Warnings come back alongside any error, so a caller never loses them.
+func PostBatchChecks(in PostBatchInputs) (deviations, warnings []string, err error) {
+	// A card's completion has a mechanical verdict.
+	// A Create target that still does not resolve, or a Delete target that still does, blocks the card.
+	// This runs its own batched Resolve against the post-card tree, distinct from the single delta call below.
+	index, err := in.Geom.index()
+	if err != nil {
+		return nil, nil, err
+	}
+	doneFindings, err := index.DoneChecks(in.Plan, in.Cards, in.Geom.WorktreeRoot)
+	if err != nil {
+		return nil, nil, err
+	}
+	if notDone := CardNotDoneFor(in.Number, in.Cards, doneFindings); notDone != nil {
+		return nil, nil, notDone
+	}
+
+	// A recorded C# re-sign is carried into the plan once its edit is in the tree:
+	// every later card naming the member by its old glyph then names the minted id.
+	// This rewrite runs before the delta, so everything after it reads the re-read plan,
+	// and the plan is re-baselined before the guard and drift detection run.
+	fingerprintBefore, err := Fingerprint(in.Geom.PlanDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	resignFindings, err := index.RebindResigns(in.Plan, in.Cards, in.Geom.WorktreeRoot)
+	if err != nil {
+		return nil, nil, err
+	}
+	if notDone := CardNotDoneFor(in.Number, in.Cards, resignFindings); notDone != nil {
+		return nil, nil, notDone
+	}
+	fingerprintAfter, err := Fingerprint(in.Geom.PlanDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	recordedCards := in.Cards
+	if fingerprintAfter != fingerprintBefore {
+		if err := RestampFingerprint(in.State, in.Geom.PlanDir, in.Geom.RunDir); err != nil {
+			return nil, nil, err
+		}
+		reparsed, err := in.Plan.Reparse()
+		if err != nil {
+			return nil, nil, fmt.Errorf("re-parse plan %s after re-sign rebinding: %w", in.Geom.PlanDir, err)
+		}
+		in.Plan = reparsed
+		in.Cards = rereadCards(reparsed, in.Cards)
+	}
+	completed := CompletedCards(in.Batches, in.State, in.Number)
+
+	// One planindex.Delta serves the whole batch: BindHandles, ScopeGuard and DetectDrift all consume it.
+	// HeadSHA is the reconciled report head, which the caller has already cross-checked against the worktree's real HEAD.
+	// That cross-check is why the delta can be trusted here and nowhere earlier.
+	// A DeltaGit infrastructure error does not abort the sequence.
+	// The scope guard degrades to an informational notice on this same deltaErr.
+	// The done-checks above ran on their own Resolve and are unaffected.
+	// delta is the zero value on error, so BindHandles cannot confirm any handle bound.
+	// It reports bind-count-mismatch for every card that declared one.
+	// An unconfirmed Create is exactly a not-done card.
+	// The floor error of a git below lym's minimum is not a quarry degrade,
+	// so it stops the batch here like any other non-quarry error.
+	delta, deltaErr := index.Delta(in.Geom.WorktreeRoot, in.StartSHA, in.HeadSHA)
+	if deltaErr != nil && !errors.Is(deltaErr, planindex.ErrQuarryUnavailable) {
+		return nil, nil, deltaErr
+	}
+
+	// The report's renames are what drift detection repairs further down,
+	// so a removal the batch reported is no hand-back.
+	reported := make([]planindex.Rename, len(in.Renames))
+	for i, r := range in.Renames {
+		reported[i] = planindex.Rename{Old: r.Old, New: r.New}
+	}
+
+	// A removed later target is handed back before binding,
+	// so the plan carries no bind or drift rewrite of a batch its attempt is still to change.
+	if in.HandBackRemovedTargets && deltaErr == nil && !in.Batch.LaterTargetsReturned {
+		if removed := delta.RemovedTargets(in.Plan, completed, in.Cards, reported); len(removed) > 0 {
+			reasons := make([]string, len(removed))
+			for i, f := range removed {
+				reasons[i] = f.Error()
+			}
+			in.Batch.LaterTargetsReturned = true
+			return nil, nil, &LaterTargetRemovedError{Batch: in.Label, Number: in.Number, Reasons: reasons, WayForward: in.HandBackWayForward}
+		}
+	}
+
+	// Binding runs after the done-checks above, so a card that already failed create-not-done is never bound.
+	// It applies its whole batch of substitutions in one RewriteRefs call.
+	bindFindings, bindOutcomes, bindErr := delta.BindHandles(in.Plan, in.Geom.PlanDir, in.Cards)
+	// The trace is logged before the restamp below, so a restamp failure still reports the bind that landed.
+	// The trace names the reason the pass decided.
+	// That reason overrides the outcomes BindHandles computed when there is no glyph language or no delta.
+	if bindErr == nil {
+		if !in.Plan.GlyphLanguage() {
+			bindOutcomes = failedBindOutcomes(in.Cards, func(planparser.Card) planindex.BindReason { return bindLanguageNone })
+		} else if deltaErr != nil {
+			bindOutcomes = failedBindOutcomes(in.Cards, func(planparser.Card) planindex.BindReason { return bindDeltaUnavailable })
+		}
+		logBindOutcomes(in.Number, bindOutcomes)
+	}
+	// BindHandles rewrites plan references on disk before it reports a finding or an error.
+	// The substitutions come from delta.Created;
+	// a bind-count mismatch comes from a card whose handle matched nothing.
+	// One call can therefore do both.
+	// The staleness re-baseline runs here, not once after every refusal below.
+	// A restamp failure never masks bindErr: the caller is already returning for that reason.
+	if rebaseErr := RestampFingerprint(in.State, in.Geom.PlanDir, in.Geom.RunDir); rebaseErr != nil && bindErr == nil {
+		return nil, nil, rebaseErr
+	}
+	if bindErr != nil {
+		return nil, nil, bindErr
+	}
+	var bindBlocking []string
+	for _, f := range bindFindings {
+		bindBlocking = append(bindBlocking, f.Error())
+	}
+	if len(bindBlocking) > 0 {
+		return nil, nil, fmt.Errorf("%w: %s", ErrCardNotDone, strings.Join(bindBlocking, "; "))
+	}
+
+	// The informational glyph scope guard never blocks.
+	// It degrades explicitly on the deltaErr above rather than running against a zero-value delta;
+	// such a delta would look like a real, empty one.
+	// An unavailable diff costs visibility, not correctness,
+	// and the done-checks above have already blocked on the same infrastructure error.
+	if deltaErr != nil {
+		warnings = append(warnings, fmt.Sprintf("glyph scope guard could not run for batch %s: %v", in.Label, deltaErr))
+	} else {
+		deviationSet := map[string]bool{}
+		// The guard's targets are the cards as recorded and as re-read.
+		// A re-signed member's old glyph and its minted id both count as the batch's own.
+		for _, f := range delta.ScopeGuard(in.Plan, append(slices.Clone(recordedCards), in.Cards...)) {
+			if f.File != "" && !deviationSet[f.File] {
+				deviationSet[f.File] = true
+				deviations = append(deviations, f.File)
+			}
+		}
+		sort.Strings(deviations)
+	}
+
+	// Drift detection runs after binding and before the digest is persisted.
+	// It works on the delta's own deleted-symbols-still-referenced signal.
+	// HeadSHA is the triggering SHA that every exact-tier repair's own amendment records.
+	// Drift runs against the remaining plan:
+	// the delta's deleted symbols intersected with what the plan still has to do.
+	// Every already-built card is excluded, and so is this batch's own.
+	// Without that exclusion, a Delete card's own deletion is reported against the very card that asked for it,
+	// and no Delete card could ever be recorded.
+	// in.Plan rides along as DetectDrift's fullPlan so gate one can recognize this batch's own declared Rename outcome:
+	// the pending view excludes exactly the cards whose renames the delta reports.
+	// The report's renames ride along,
+	// so a later card naming a glyph the batch renamed is rewritten even where quarry cannot prove the rename.
+	driftFindings, driftErr := delta.DetectDrift(in.Plan, completed, reported, in.Geom.PlanDir, in.Geom.WorktreeRoot, in.HeadSHA, time.Now().UTC().Format(time.RFC3339))
+	// The exact-tier repair's RewriteRefs writes to disk before this call reports anything.
+	// Its blocking plan-references-deleted-symbol finding comes from another part of the same delta,
+	// so the re-baseline runs here, for the reason the bind step above gives.
+	if rebaseErr := RestampFingerprint(in.State, in.Geom.PlanDir, in.Geom.RunDir); rebaseErr != nil && driftErr == nil {
+		return nil, warnings, rebaseErr
+	}
+	if driftErr != nil {
+		return nil, warnings, driftErr
+	}
+	// DetectDrift is the one index call in this sequence that returns a mixed severity set:
+	// its plan-references-deleted-symbol finding is blocking;
+	// the evidence tier's rename-candidate is informational by construction.
+	// The rename-versus-genuine-delete decision is the reviewer's, never the pipeline's.
+	// Failing the batch on it would destroy the very tier it belongs to.
+	// So the split is by whose card the finding concerns.
+	// A blocking finding concerns a later card, still to be built;
+	// it is recorded as a "later card:" warning rather than failing this batch, and refuses at that card's own dispatch.
+	// An informational one rides out on warnings.
+	for _, f := range driftFindings {
+		if f.Severity != planindex.SeverityBlocking {
+			warnings = append(warnings, f.Error())
+			continue
+		}
+		detail := "later card: " + f.Error()
+		if text, added := in.RecordWarning("later-card-drift:"+f.Error(), "later-card-drift", detail); added {
+			warnings = append(warnings, text)
+		}
+	}
+
+	// No third restamp is needed.
+	// The two above cover every rewrite this pass performs,
+	// and each runs right after its own rewriting call rather than past the refusals between them.
+	// The amendment log the exact-tier repair writes is excluded from the fingerprint,
+	// so it needs no re-baseline.
+	return deviations, warnings, nil
+}
diff --git a/internal/runplan/report.go b/internal/runplan/report.go
new file mode 100644
index 00000000..47e5d576
--- /dev/null
+++ b/internal/runplan/report.go
@@ -0,0 +1,128 @@
+// report.go defines the batch report contract: the minimal YAML a batch's attempt writes as its final action.
+// It also holds the strict parser that reads a report back.
+// A report holds the attempt's status, its head SHA, its glyph renames, any step it needs its parent to take,
+// and an optional journal of what the batch did.
+// ParseReport fails only on shape violations of Status, HeadSHA, Need and Renames;
+// an older report's deviations key is accepted and never read.
+
+package runplan
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// The three legal Report.Status values.
+// NEEDS_PARENT marks a batch stopped on a step only the run's parent can take.
+// No recovery strand could take such a step either.
+const (
+	ReportStatusOK          = "OK"
+	ReportStatusFailed      = "FAILED"
+	ReportStatusNeedsParent = "NEEDS_PARENT"
+)
+
+// Report is a batch's return contract.
+// It is the in-memory form of the per-batch report YAML file the batch's attempt writes as its final action.
+type Report struct {
+	// Status is one of ReportStatusOK, ReportStatusFailed or ReportStatusNeedsParent.
+	Status string `yaml:"status"`
+	// HeadSHA is the commit SHA the attempt left the worktree at.
+	HeadSHA string `yaml:"head_sha"`
+	// Need names the one step only the parent can take; it is required with ReportStatusNeedsParent and refused otherwise.
+	Need string `yaml:"need,omitempty"`
+	// Renames lists every glyph the batch renamed, so a later card still naming the old glyph is rewritten to the new one.
+	Renames []ReportRename `yaml:"renames,omitempty"`
+	// Journal is the attempt's own account of what the batch did, for the run's journal.
+	// It is optional: an implementer that keeps no journal leaves it empty.
+	Journal string `yaml:"journal,omitempty"`
+	// Deviations is accepted and never read: an older report carries the key,
+	// and the known-fields decoding must keep accepting it.
+	Deviations []string `yaml:"deviations,omitempty"`
+}
+
+// ReportRename is one glyph rename a batch reports.
+// It names the glyph before the batch, the glyph that replaced it, and why the attempt could not keep the plan's name.
+type ReportRename struct {
+	Old    string `yaml:"old" json:"old"`
+	New    string `yaml:"new" json:"new"`
+	Reason string `yaml:"reason" json:"reason"`
+}
+
+// ReportFileName returns the per-batch report file's name, "NN-<slug>.yaml".
+func ReportFileName(number int, slug string) string {
+	return fmt.Sprintf("%02d-%s.yaml", number, slug)
+}
+
+// ParseReport reads and strictly decodes the batch report YAML file at path, then validates its fields.
+// Status must be one of the three legal values; head_sha must be non-empty.
+// need must be non-empty exactly when status is ReportStatusNeedsParent.
+// Each renames entry must name two different, non-empty glyphs.
+// Each violation is returned as its own distinct wrapped error.
+func ParseReport(path string) (*Report, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("runplan: read report %s: %w", path, err)
+	}
+
+	var r Report
+	dec := yaml.NewDecoder(bytes.NewReader(data))
+	dec.KnownFields(true)
+	if err := dec.Decode(&r); err != nil {
+		return nil, fmt.Errorf("runplan: report %s: %w", path, err)
+	}
+
+	if err := validateReportFields(path, r); err != nil {
+		return nil, err
+	}
+
+	return &r, nil
+}
+
+// validateReportFields checks the status, head_sha, need and renames fields of a decoded report.
+func validateReportFields(path string, r Report) error {
+	switch r.Status {
+	case ReportStatusOK, ReportStatusFailed, ReportStatusNeedsParent:
+	default:
+		return fmt.Errorf("runplan: report %s: unrecognized status %q; want %q, %q or %q", path, r.Status, ReportStatusOK, ReportStatusFailed, ReportStatusNeedsParent)
+	}
+
+	if strings.TrimSpace(r.HeadSHA) == "" {
+		return fmt.Errorf("runplan: report %s: missing required field %q", path, "head_sha")
+	}
+
+	hasNeed := strings.TrimSpace(r.Need) != ""
+	if r.Status == ReportStatusNeedsParent && !hasNeed {
+		return fmt.Errorf("runplan: report %s: status %q requires a non-empty %q naming the step only the parent can take", path, r.Status, "need")
+	}
+	if r.Status != ReportStatusNeedsParent && hasNeed {
+		return fmt.Errorf("runplan: report %s: %q is allowed only with status %q, not %q", path, "need", ReportStatusNeedsParent, r.Status)
+	}
+
+	for i, rn := range r.Renames {
+		if strings.TrimSpace(rn.Old) == "" || strings.TrimSpace(rn.New) == "" {
+			return fmt.Errorf("runplan: report %s: renames entry %d needs %q and %q", path, i+1, "old", "new")
+		}
+		if rn.Old == rn.New {
+			return fmt.Errorf("runplan: report %s: renames entry %d names %q as both its old and its new glyph", path, i+1, rn.Old)
+		}
+	}
+
+	return nil
+}
+
+// WriteReport serializes r to path, the per-batch report file under the implementer's reports directory.
+// The caller supplies path.
+func WriteReport(path string, r *Report) error {
+	data, err := yaml.Marshal(r)
+	if err != nil {
+		return fmt.Errorf("runplan: marshal report for %s: %w", path, err)
+	}
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		return fmt.Errorf("runplan: write report %s: %w", path, err)
+	}
+	return nil
+}
diff --git a/internal/runplan/report_test.go b/internal/runplan/report_test.go
new file mode 100644
index 00000000..8012ccae
--- /dev/null
+++ b/internal/runplan/report_test.go
@@ -0,0 +1,42 @@
+// report_test.go covers the batch report's optional journal: absent, or carried through a round-trip.
+// Tier 0: no git, only t.TempDir().
+
+package runplan_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestReport_JournalIsOptional(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		journal string
+	}{
+		{"Absent", ""},
+		{"Present", "built the parser; renamed one helper"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			path := filepath.Join(t.TempDir(), runplan.ReportFileName(1, "journal"))
+			want := &runplan.Report{Status: runplan.ReportStatusOK, HeadSHA: "abc123", Journal: tt.journal}
+			if err := runplan.WriteReport(path, want); err != nil {
+				t.Fatalf("WriteReport() error = %v; want nil", err)
+			}
+			got, err := runplan.ParseReport(path)
+			if err != nil {
+				t.Fatalf("ParseReport() error = %v; want nil", err)
+			}
+			if got.Journal != tt.journal {
+				t.Errorf("ParseReport().Journal = %q; want %q", got.Journal, tt.journal)
+			}
+		})
+	}
+}
diff --git a/internal/runplan/state.go b/internal/runplan/state.go
new file mode 100644
index 00000000..4fe28a6a
--- /dev/null
+++ b/internal/runplan/state.go
@@ -0,0 +1,268 @@
+// state.go holds the run-plan state an implementer's state file embeds:
+// the plan fingerprint, the plan file hashes, the overview frame hash, the recorded partition and the batch records.
+// It also holds the state-mutation lease, and the card ids and hashes a batch record keeps.
+
+package runplan
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+// stateMutateLockName names the exclusive lease that serializes an implementer's state-file read-modify-write sequences.
+// The lease covers one scratch directory.
+// The state file's own .lock guards only the individual read or write.
+// Without this lease, two concurrent verb invocations each load, mutate and save their own copy,
+// and the last save erases the other's mutation.
+// The lease lives in the never-tracked scratch directory.
+const stateMutateLockName = "mutate.lock"
+
+// AcquireStateMutation acquires scratchDir's exclusive state-mutation lease, blocking until it is free.
+// Every holder's critical section is bounded, so the wait is short and never a deadlock risk.
+// Callers hold the lease across their whole load-mutate-save sequence.
+// A caller that spawns a strand under the lease holds it through that strand's startup window.
+// Shuttle returns a *Run handle only past the provider's startup gates, which startup_timeout_s bounds.
+// A concurrent verb blocks on the lease for that time rather than failing.
+// This serializes two concurrent recoveries of one batch:
+// the second reads the first's recorded guid and attaches instead of spawning a duplicate.
+// An unbounded or poll-length wait never runs under the lease.
+// Release the lease as soon as the save lands.
+func AcquireStateMutation(scratchDir string) (*lock.FileLock, error) {
+	if err := os.MkdirAll(scratchDir, 0o755); err != nil {
+		return nil, fmt.Errorf("runplan: create scratch dir %s: %w", scratchDir, err)
+	}
+	l, err := lock.AcquireWriteLock(filepath.Join(scratchDir, stateMutateLockName))
+	if err != nil {
+		return nil, fmt.Errorf("runplan: acquire state-mutation lease in %s: %w", scratchDir, err)
+	}
+	return l, nil
+}
+
+// State is the run-plan part of an implementer's durable run state.
+// An implementer's state type embeds it, so its keys sit beside the implementer's own in one JSON object.
+type State struct {
+	// PlanFingerprint is the plan-identity hash recorded at first init.
+	// Run entry recomputes it and compares it against this value.
+	// A mismatch means the on-disk plan went stale across a crash or resume boundary.
+	PlanFingerprint string `json:"planFingerprint"`
+	// PlanFileHashes is the hex SHA-256 of every plan file the fingerprint covers, keyed by file name.
+	// A rebaseline uses these hashes to tell which plan files an edit touched, the overview included.
+	// A state written before this field existed leaves it empty.
+	PlanFileHashes map[string]string `json:"planFileHashes,omitempty"`
+	// PlanOverviewFrameHash is the hex SHA-256 of the overview without its Card Index section.
+	// planparser.OverviewWithoutCardIndex produces that frame, and the hash is recorded wherever PlanFileHashes is.
+	// A rebaseline accepts an overview change when the frame still equals this hash, so only the Card Index changed.
+	PlanOverviewFrameHash string `json:"planOverviewFrameHash,omitempty"`
+	// Partition is the run's batches in execution order, recorded at first init.
+	// Every verb reads it and only a first init or a rebaseline replaces it.
+	// A state written before this field existed loads with it nil.
+	Partition []PartitionBatch `json:"partition,omitempty"`
+	// Batches holds every batch's persisted record, keyed by batch number.
+	Batches map[int]*BatchState `json:"batches"`
+}
+
+// PartitionBatch is one recorded batch of a run's partition:
+// the NN-<slug> ids of its cards in card order, the profile that formed it, and its estimate.
+// Breakdown keeps the estimate's components.
+// A finished run can then be fitted against the peak context its batches measured.
+type PartitionBatch struct {
+	Cards     []string           `json:"cards"`
+	Profile   string             `json:"profile,omitempty"`
+	Estimate  float64            `json:"estimate,omitempty"`
+	Breakdown *batcher.Breakdown `json:"breakdown,omitempty"`
+}
+
+// AuditWarning is one recorded warning: the finding's identity, its class, and the detail line.
+type AuditWarning struct {
+	// Identity is the finding's ledger identity.
+	Identity string `json:"identity"`
+	// Class is the finding's class name.
+	Class string `json:"class"`
+	// Detail is the human-readable detail.
+	Detail string `json:"detail"`
+}
+
+// SuspectPath is one path a failed batch's correctness findings name.
+// Blob is the git blob id of the path's worktree content when the batch first failed.
+// A re-failed recovery keeps it.
+// It is empty when the file was absent or lies outside the task worktree's tracked tree.
+type SuspectPath struct {
+	Path string `json:"path"`
+	Blob string `json:"blob,omitempty"`
+}
+
+// AmendedCard is one card of an in-flight batch that an operator edited mid-run and a rebaseline accepted.
+type AmendedCard struct {
+	// Card is the amended card's NN-<slug> id.
+	Card string `json:"card"`
+	// Rendered is false while the amendment is recorded only.
+	// It turns true once a recovery spawn renders the edited card into its prompt.
+	Rendered bool `json:"rendered"`
+}
+
+// BatchState is one batch's own persisted run record.
+// A field an implementer has no use for stays empty and is left out of its state file.
+type BatchState struct {
+	// Slug is the batch's <batch-slug> segment.
+	Slug string `json:"slug"`
+	// Cards is the batch's card set as begun: one NN-<slug> entry per card, in the batch's card order.
+	// A record written before the field existed has none.
+	// Such a record reads as the single card NN-<Slug> that the identity batcher produced.
+	Cards []string `json:"cards,omitempty"`
+	// CardHashes is the hex SHA-256 of each card file's bytes at begin, keyed by the same NN-<slug> id Cards holds.
+	// A rebaseline compares it so a begun card whose body changed while its file name stayed is refused.
+	// A record written before the field existed has none, and a rebaseline compares only its ids.
+	CardHashes map[string]string `json:"cardHashes,omitempty"`
+	// AmendedCards lists the cards of this batch that a rebaseline accepted an edit to while the batch was in flight.
+	// It holds one entry per card.
+	// The attempt running then keeps the old text; a recovery re-runs the batch on the edited cards.
+	AmendedCards []AmendedCard `json:"amendedCards,omitempty"`
+	// StartSHA is the repo HEAD immediately before this batch's first attempt started.
+	// It is the durable base-commit record that a resume, an operator diagnosis and the post-batch delta read.
+	// A recovery inherits the stuck attempt's value instead of capturing the head at recovery spawn,
+	// so the SHA always names the whole bracket's base commit.
+	// It never names a point partway through the batch's own committed work.
+	StartSHA string `json:"startSha"`
+	// Kind is how this batch's attempt ran.
+	// "fork" is an in-session fork of a master session.
+	// "recovery" is a cold recovery strand.
+	Kind string `json:"kind"`
+	// SpawnedAt is the RFC3339 UTC timestamp at which this batch's attempt was forked or spawned.
+	SpawnedAt string `json:"spawnedAt"`
+	// SessionID is the master session that opened this batch, for an implementer whose batches are forks of one session.
+	// A run-exit audit scopes its begun-batch count to the current master session through this field.
+	// A crash-resumed run's whole-session audit covers only the fresh session's own forks.
+	// Empty for a recovery batch and under an implementer with no master session.
+	SessionID string `json:"sessionId,omitempty"`
+	// Engine is the engine SessionID's session ran under.
+	// Empty whenever SessionID is.
+	Engine string `json:"engine,omitempty"`
+	// Terminal reports whether this batch has reached a terminal classification (done, stuck, dead, or failed).
+	Terminal bool `json:"terminal"`
+	// Status is the batch's terminal status once Terminal is true (done, stuck, dead, or failed).
+	// It is empty while the batch is in flight, or "waiting" while it waits on a step only the run's parent can take.
+	Status string `json:"status"`
+	// Digest is the distilled digest persisted at terminal classification.
+	// It is the carry-forward home: the next batch's prompt renders it,
+	// and a crash-resumed run rebuilds its progress context from it.
+	// The report is never re-distilled against a HEAD that has since moved.
+	Digest *Digest `json:"digest,omitempty"`
+	// CardSHAs is the ordered per-card commit SHA trail for this batch.
+	// The resume trail and the verify gate's card-hint trail both use it.
+	CardSHAs []string `json:"cardShas,omitempty"`
+	// ForkTranscripts is the set of fork transcript filenames already attributed to this batch.
+	// Only an implementer that audits fork transcripts fills it.
+	ForkTranscripts []string `json:"forkTranscripts,omitempty"`
+	// BracketTranscripts is the subset of ForkTranscripts attributed to this batch during its current bracket.
+	// Every begin and every recovery spawn opens an empty list.
+	BracketTranscripts []string `json:"bracketTranscripts,omitempty"`
+	// AuditWarnings is every warning recorded against this batch, each added once per finding identity.
+	// A re-begin and a recovery carry it onto their fresh record.
+	AuditWarnings []AuditWarning `json:"auditWarnings,omitempty"`
+	// SuspectPaths is the correctness findings' paths with the content each held when the batch failed.
+	// A recovery carries it forward and checks it before recording the batch done.
+	SuspectPaths []SuspectPath `json:"suspectPaths,omitempty"`
+	// Uncheckable is one entry per correctness finding the recovery check cannot verify:
+	// the path, or "<class>: <detail>" for a finding with no path.
+	// A recovery refuses a failed batch carrying any, toward the reset-to-start route.
+	Uncheckable []string `json:"uncheckable,omitempty"`
+	// LaterTargetsReturned is set once the post-batch checks have handed the batch back to its attempt.
+	// The batch was handed back because a later card names a symbol the batch removed.
+	// A later record of the same bracket then records the batch without handing it back again.
+	LaterTargetsReturned bool `json:"laterTargetsReturned,omitempty"`
+
+	// The fields below are populated only for a recovery batch (Kind == "recovery").
+	// A fork batch carries none, since there is no separate strand to track.
+
+	// StrandGUID identifies the reed strand the recovery spawned into.
+	StrandGUID string `json:"strandGuid,omitempty"`
+	// ShuttleRunDir is the shuttle run directory the recovery spawn persisted (run.json, events.jsonl, ...).
+	ShuttleRunDir string `json:"shuttleRunDir,omitempty"`
+	// EventsPath is the run dir's events.jsonl path.
+	// The recovery's Stop-event detection reads it to classify a recovery as dead or asking.
+	EventsPath string `json:"eventsPath,omitempty"`
+	// EventsOffset is where the recovery's own events begin in EventsPath, past the skill-load turns shuttle ran at start.
+	// It is zero for a record written before the field existed.
+	EventsOffset int64 `json:"eventsOffset,omitempty"`
+	// Recoveries counts the batch's recovery spawns that count toward the recovery cap.
+	// It is carried across a re-begin and a respawn.
+	// A spawn whose prompt renders an amendment no earlier spawn rendered keeps the count,
+	// and a start that fails counts nothing.
+	Recoveries int `json:"recoveries,omitempty"`
+	// RecoverySessions is the session id of every recovery strand spawned for the batch, in spawn order.
+	// It is carried across a re-begin and a respawn.
+	// The run's write evidence audits each, so a recovery's writes count as the run's own.
+	RecoverySessions []string `json:"recoverySessions,omitempty"`
+	// RecoveryEngines maps each RecoverySessions id to the engine its session ran under, carried the same way.
+	// An id with no entry belongs to a record written before the field existed.
+	RecoveryEngines map[string]string `json:"recoveryEngines,omitempty"`
+	// RecoveryStartSHA is the repo HEAD when the record's recovery was spawned.
+	// It is empty for a fork record and for a record written before the field existed.
+	// A dead recovery's retry reads it to tell whether that recovery committed work of its own.
+	RecoveryStartSHA string `json:"recoveryStartSha,omitempty"`
+}
+
+// CardID returns the NN-<slug> id of c.
+func CardID(c planparser.Card) string {
+	return fmt.Sprintf("%02d-%s", c.Number, c.Slug)
+}
+
+// BatchIdentity returns the number and slug that identify b: a batch takes both from its first card.
+// So a batch is named by its first card's number.
+func BatchIdentity(b batcher.Batch) (number int, slug string) {
+	if len(b.Cards) == 0 {
+		return 0, ""
+	}
+	return b.Cards[0].Number, b.Cards[0].Slug
+}
+
+// BatchCardIDs returns one NN-<slug> entry per card of b, in the batch's card order.
+func BatchCardIDs(b batcher.Batch) []string {
+	ids := make([]string, 0, len(b.Cards))
+	for _, c := range b.Cards {
+		ids = append(ids, CardID(c))
+	}
+	return ids
+}
+
+// BatchCardHashes returns the hex SHA-256 of each card file of b, keyed by the card's NN-<slug> id.
+// A card's file is read from planDir under the file name its SourcePath carries, else NN-<slug>.md.
+func BatchCardHashes(b batcher.Batch, planDir string) (map[string]string, error) {
+	return CardHashesFrom(b, func(name string) ([]byte, error) { return os.ReadFile(filepath.Join(planDir, name)) })
+}
+
+// CardHashesFrom hashes the card files of b, reading each through read, which returns the plan file called name.
+func CardHashesFrom(b batcher.Batch, read func(name string) ([]byte, error)) (map[string]string, error) {
+	hashes := make(map[string]string, len(b.Cards))
+	for _, c := range b.Cards {
+		id := CardID(c)
+		name := id + ".md"
+		if c.SourcePath != "" {
+			name = filepath.Base(c.SourcePath)
+		}
+		data, err := read(name)
+		if err != nil {
+			return nil, fmt.Errorf("runplan: read card file %s: %w", name, err)
+		}
+		sum := sha256.Sum256(data)
+		hashes[id] = hex.EncodeToString(sum[:])
+	}
+	return hashes, nil
+}
+
+// RecordPartition writes the batches' card ids, profiles, estimates and estimate breakdowns into st.Partition.
+// It replaces any partition st held.
+func RecordPartition(st *State, batches []batcher.Batch) {
+	partition := make([]PartitionBatch, len(batches))
+	for i, b := range batches {
+		partition[i] = PartitionBatch{Cards: BatchCardIDs(b), Profile: b.Profile, Estimate: b.Estimate, Breakdown: b.Breakdown}
+	}
+	st.Partition = partition
+}
diff --git a/internal/runplan/strand.go b/internal/runplan/strand.go
new file mode 100644
index 00000000..4da37952
--- /dev/null
+++ b/internal/runplan/strand.go
@@ -0,0 +1,120 @@
+// strand.go holds the strand seams a batch's attempt spawns and stops through, and the bounded wait for a batch report.
+
+package runplan
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/batcher"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// Starter is the seam a batch's attempt or recovery strand spawns through.
+// Start blocks until the spawned provider is past its startup gates, which shuttle guarantees.
+// It returns an error when the provider never becomes ready, and it never waits for the run to finish.
+// A *shuttleengine.Runner satisfies it.
+type Starter interface {
+	Start(shuttleengine.Spec) (*shuttleengine.Run, error)
+}
+
+// StrandStopper is the seam a leftover strand is stopped through, by guid.
+// StopStrand records the stop on the strand's run.
+// It ends a live strand, logging that kill at Warn, and does nothing for a strand that is not live.
+type StrandStopper interface {
+	StopStrand(guid string) error
+}
+
+// RecoveryStrandRemoveError is a recovery strand that could not be removed, with its guid and the cause.
+type RecoveryStrandRemoveError struct {
+	GUID string
+	Err  error
+}
+
+func (e *RecoveryStrandRemoveError) Error() string {
+	return fmt.Sprintf("could not remove recovery strand %s: %v", e.GUID, e.Err)
+}
+
+func (e *RecoveryStrandRemoveError) Unwrap() error { return e.Err }
+
+// StopRecoveryStrands stops every recovery strand the batch records name, in batch-number order.
+// Only a recovery batch with a StrandGUID has one.
+// The first failure returns a *RecoveryStrandRemoveError naming the strand guid.
+func StopRecoveryStrands(stopper StrandStopper, batches map[int]*BatchState) error {
+	numbers := make([]int, 0, len(batches))
+	for number := range batches {
+		numbers = append(numbers, number)
+	}
+	sort.Ints(numbers)
+	for _, number := range numbers {
+		bs := batches[number]
+		if bs == nil || bs.Kind != "recovery" || bs.StrandGUID == "" {
+			continue
+		}
+		if err := stopper.StopStrand(bs.StrandGUID); err != nil {
+			return &RecoveryStrandRemoveError{GUID: bs.StrandGUID, Err: err}
+		}
+	}
+	return nil
+}
+
+// Clock abstracts time.Now and time.Sleep, so a bounded wait runs instantly under test.
+// Any type with these two methods satisfies it, so a Clock goes straight into a polling loop without an adapter.
+type Clock interface {
+	Now() time.Time
+	Sleep(time.Duration)
+}
+
+// awaitTick is the interval between checks of the report path while waiting.
+const awaitTick = time.Second
+
+// DefaultAwaitWaitS is the default block of one await call, in seconds.
+// It is short so that an agent's foreground call stays under the ~2-minute auto-background threshold of Claude Code.
+const DefaultAwaitWaitS = 30
+
+// AwaitResult reports the outcome of one bounded wait for a batch report.
+type AwaitResult struct {
+	BatchName     string
+	ReportPresent bool
+	ElapsedS      int
+}
+
+// AwaitBatch blocks until batchNumber's batch-report file exists in reportsDir or wait elapses.
+// It reads and mutates nothing but the report path's existence.
+// An unknown batch refuses with findWayForward, the caller's way to list the run's batches.
+func AwaitBatch(batches []batcher.Batch, reportsDir string, batchNumber int, wait time.Duration, clk Clock, findWayForward string) (*AwaitResult, error) {
+	batch, err := FindBatch(batches, batchNumber, findWayForward)
+	if err != nil {
+		return nil, err
+	}
+	number, slug := BatchIdentity(batch)
+
+	batchName := fmt.Sprintf("%02d-%s", number, slug)
+	reportPath := filepath.Join(reportsDir, ReportFileName(number, slug))
+
+	start := clk.Now()
+	for {
+		if _, statErr := os.Stat(reportPath); statErr == nil {
+			return &AwaitResult{
+				BatchName:     batchName,
+				ReportPresent: true,
+				ElapsedS:      int(clk.Now().Sub(start).Seconds()),
+			}, nil
+		} else if !os.IsNotExist(statErr) {
+			return nil, fmt.Errorf("runplan: stat batch report %s: %w", reportPath, statErr)
+		}
+
+		elapsed := clk.Now().Sub(start)
+		if elapsed >= wait {
+			return &AwaitResult{
+				BatchName:     batchName,
+				ReportPresent: false,
+				ElapsedS:      int(elapsed.Seconds()),
+			}, nil
+		}
+		clk.Sleep(awaitTick)
+	}
+}
diff --git a/internal/runplan/suspect.go b/internal/runplan/suspect.go
new file mode 100644
index 00000000..df34fb67
--- /dev/null
+++ b/internal/runplan/suspect.go
@@ -0,0 +1,436 @@
+// suspect.go checks suspect paths against what the run recorded.
+// A tracked file in the task worktree is checked against a commit its caller chooses.
+// The run's start and last commits are picked by git ancestry, not by batch number.
+// A plan file is checked against the run's plan hashes.
+// Every other path has nothing recorded to compare with, so it is reported unverifiable rather than guessed at.
+// It also holds the link-resolving path helpers those checks compare paths with.
+
+package runplan
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+)
+
+// EvidenceBases holds the two commits the suspect-path evidence is checked against.
+// They are picked by git ancestry rather than batch number.
+type EvidenceBases struct {
+	// Start is the run's start commit: the recorded batch StartSHA that is an ancestor of every other.
+	Start string
+	// Last is the last batch head: the recorded terminal Digest.HeadSHA every other terminal head is an ancestor of.
+	Last string
+	// Missing lists every recorded StartSHA and terminal HeadSHA absent from the repository, sorted and deduplicated.
+	Missing []string
+	// Starts lists every recorded StartSHA, sorted and deduplicated, to tell no recorded start from no qualifying one.
+	Starts []string
+}
+
+// RunEvidenceBases picks st's start commit and last batch head by git ancestry.
+// A batch number names a batch and does not date it, so the pick follows ancestry.
+// A pick is "" when nothing is recorded or no candidate qualifies.
+// It is also "" when any recorded commit of its kind is missing from the repository.
+// A missing commit blanks the pick rather than being skipped: the pick among the rest would name an older commit.
+// A state recording no SHA returns the zero value without running git.
+// The error is an IsAncestor failure.
+func RunEvidenceBases(geom Geometry, st *State) (EvidenceBases, error) {
+	git, worktree := geom.Git, geom.WorktreeRoot
+	var starts, heads []string
+	for _, bs := range st.Batches {
+		if bs == nil {
+			continue
+		}
+		if bs.StartSHA != "" && !slices.Contains(starts, bs.StartSHA) {
+			starts = append(starts, bs.StartSHA)
+		}
+		if bs.Terminal && bs.Digest != nil && bs.Digest.HeadSHA != "" && !slices.Contains(heads, bs.Digest.HeadSHA) {
+			heads = append(heads, bs.Digest.HeadSHA)
+		}
+	}
+	var out EvidenceBases
+	if len(starts) == 0 && len(heads) == 0 {
+		return out, nil
+	}
+	out.Starts = slices.Sorted(slices.Values(starts))
+	startsMissing, headsMissing := false, false
+	for _, sha := range starts {
+		if !git.SHAExists(worktree, sha) {
+			startsMissing = true
+			out.Missing = append(out.Missing, sha)
+		}
+	}
+	for _, sha := range heads {
+		if !git.SHAExists(worktree, sha) {
+			headsMissing = true
+			if !slices.Contains(out.Missing, sha) {
+				out.Missing = append(out.Missing, sha)
+			}
+		}
+	}
+	sort.Strings(out.Missing)
+	var err error
+	if !startsMissing {
+		if out.Start, err = pickByAncestry(git, worktree, starts, true); err != nil {
+			return EvidenceBases{}, err
+		}
+	}
+	if !headsMissing {
+		if out.Last, err = pickByAncestry(git, worktree, heads, false); err != nil {
+			return EvidenceBases{}, err
+		}
+	}
+	return out, nil
+}
+
+// pickByAncestry returns the commit of shas that is an ancestor of every other when oldest is true.
+// When oldest is false it returns the commit that every other is an ancestor of.
+// It returns "" when none qualifies.
+func pickByAncestry(git Git, worktree string, shas []string, oldest bool) (string, error) {
+	for _, cand := range shas {
+		qualifies := true
+		for _, other := range shas {
+			if other == cand {
+				continue
+			}
+			sha, ref := cand, other
+			if !oldest {
+				sha, ref = other, cand
+			}
+			ok, err := git.IsAncestor(worktree, sha, ref)
+			if err != nil {
+				return "", err
+			}
+			if !ok {
+				qualifies = false
+				break
+			}
+		}
+		if qualifies {
+			return cand, nil
+		}
+	}
+	return "", nil
+}
+
+// MissingCommitsClause names the recorded commits absent from the repository and the way forward.
+// It returns "" for an empty list.
+func MissingCommitsClause(missing []string) string {
+	if len(missing) == 0 {
+		return ""
+	}
+	return fmt.Sprintf("commit(s) %s recorded by this run are not in this repository; way forward: fetch the task branch from the machine that ran those batches with git, then re-run the verb", strings.Join(missing, ", "))
+}
+
+// SplitPlanPaths sorts paths into those under geom.PlanDir and the rest, each in input order.
+// The error is a link-resolution failure.
+func SplitPlanPaths(geom Geometry, paths []string) (plan, rest []string, err error) {
+	planDir, err := CanonicalPath(geom.PlanDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	for _, p := range paths {
+		canon, err := CanonicalPath(ResolveWritePath(geom.PaneCwd, p))
+		if err != nil {
+			return nil, nil, err
+		}
+		if PathWithin(planDir, canon) {
+			plan = append(plan, p)
+		} else {
+			rest = append(rest, p)
+		}
+	}
+	return plan, rest, nil
+}
+
+// PlanFileName returns the slash-separated name of the plan path p relative to geom.PlanDir.
+// It is the key State.PlanFileHashes is indexed by.
+func PlanFileName(geom Geometry, p string) (string, error) {
+	planDir, err := CanonicalPath(geom.PlanDir)
+	if err != nil {
+		return "", err
+	}
+	canon, err := CanonicalPath(ResolveWritePath(geom.PaneCwd, p))
+	if err != nil {
+		return "", err
+	}
+	rel, err := filepath.Rel(planDir, canon)
+	if err != nil {
+		return "", fmt.Errorf("runplan: relate %s to %s: %w", canon, planDir, err)
+	}
+	return filepath.ToSlash(rel), nil
+}
+
+// CheckSuspectPaths sorts each of paths into differing or unverifiable, both returned sorted.
+// A plan file differs when its hash is not the one st.PlanFileHashes recorded.
+// It is unverifiable when no hashes were recorded.
+// A tracked or new file in the task worktree differs when it changed against base.
+// It is unverifiable when base is empty or not in the repository.
+// Paths under its _lym or under geom.ScratchDir, and git-ignored paths, are also unverifiable.
+// Any other path is unverifiable.
+// The error is a git probe's or a read's failure other than not-exist;
+// the check changes nothing.
+func CheckSuspectPaths(geom Geometry, st *State, base string, paths []string) (differing, unverifiable []string, err error) {
+	worktree, err := CanonicalPath(geom.WorktreeRoot)
+	if err != nil {
+		return nil, nil, err
+	}
+	planDir, err := CanonicalPath(geom.PlanDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	scratch, err := CanonicalPath(geom.ScratchDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	lym, err := CanonicalPath(filepath.Join(geom.PaneCwd, lymdirs.LymDirName))
+	if err != nil {
+		return nil, nil, err
+	}
+	git := geom.Git
+	if base != "" && !git.SHAExists(geom.WorktreeRoot, base) {
+		base = ""
+	}
+	for _, p := range paths {
+		lexical := ResolveWritePath(geom.PaneCwd, p)
+		canon, err := CanonicalPath(lexical)
+		if err != nil {
+			return nil, nil, err
+		}
+		switch {
+		case PathWithin(planDir, canon):
+			differs, ok, err := planFileDiffers(st, planDir, canon)
+			if err != nil {
+				return nil, nil, err
+			}
+			if !ok {
+				unverifiable = append(unverifiable, p)
+			} else if differs {
+				differing = append(differing, p)
+			}
+		case !PathWithin(worktree, canon),
+			PathWithin(lym, canon), PathWithin(filepath.Join(geom.PaneCwd, lymdirs.LymDirName), lexical),
+			PathWithin(scratch, canon):
+			unverifiable = append(unverifiable, p)
+		default:
+			ignored, err := git.IgnoredPath(geom.WorktreeRoot, canon)
+			if err != nil {
+				return nil, nil, err
+			}
+			if ignored || base == "" {
+				unverifiable = append(unverifiable, p)
+				continue
+			}
+			differs, err := git.PathDiffers(geom.WorktreeRoot, base, canon)
+			if err != nil {
+				return nil, nil, err
+			}
+			if differs {
+				differing = append(differing, p)
+			}
+		}
+	}
+	sort.Strings(differing)
+	sort.Strings(unverifiable)
+	return differing, unverifiable, nil
+}
+
+// planFileDiffers compares the plan file at canon against st.PlanFileHashes.
+// ok is false when no hashes were recorded.
+// An absent file matches only an absent entry.
+func planFileDiffers(st *State, planDir, canon string) (differs, ok bool, err error) {
+	if len(st.PlanFileHashes) == 0 {
+		return false, false, nil
+	}
+	rel, err := filepath.Rel(planDir, canon)
+	if err != nil {
+		return false, false, fmt.Errorf("runplan: relate %s to %s: %w", canon, planDir, err)
+	}
+	want, recorded := st.PlanFileHashes[filepath.ToSlash(rel)]
+	data, err := os.ReadFile(canon)
+	if errors.Is(err, os.ErrNotExist) {
+		return recorded, true, nil
+	}
+	if err != nil {
+		return false, false, fmt.Errorf("runplan: read %s: %w", canon, err)
+	}
+	sum := sha256.Sum256(data)
+	return !recorded || want != hex.EncodeToString(sum[:]), true, nil
+}
+
+// TrackedRel returns the slash-separated path of p relative to worktree when p lies in the task worktree's tracked tree.
+// That tree is the part inside the worktree, outside the _lym under paneCwd and not git-ignored.
+// A relative p is resolved against paneCwd, the directory the session that recorded it ran in.
+// ok is false for every other path, which has no blob to compare.
+func TrackedRel(git Git, paneCwd, worktree, p string) (rel string, ok bool, err error) {
+	root, err := CanonicalPath(worktree)
+	if err != nil {
+		return "", false, err
+	}
+	lexical := ResolveWritePath(paneCwd, p)
+	canon, err := CanonicalPath(lexical)
+	if err != nil {
+		return "", false, err
+	}
+	lymLink := filepath.Join(paneCwd, lymdirs.LymDirName)
+	lymReal, err := CanonicalPath(lymLink)
+	if err != nil {
+		return "", false, err
+	}
+	if !PathWithin(root, canon) || PathWithin(lymReal, canon) || PathWithin(lymLink, lexical) {
+		return "", false, nil
+	}
+	ignored, err := git.IgnoredPath(worktree, canon)
+	if err != nil || ignored {
+		return "", false, err
+	}
+	r, err := filepath.Rel(root, canon)
+	if err != nil {
+		return "", false, fmt.Errorf("runplan: relate %s to %s: %w", canon, root, err)
+	}
+	return filepath.ToSlash(r), true, nil
+}
+
+// SuspectBlobs records, for each path, the blob of its worktree content at call time.
+// A relative path is resolved against paneCwd.
+// A path outside the tracked tree, or an absent file, gets an empty Blob.
+func SuspectBlobs(git Git, paneCwd, worktree string, paths []string) ([]SuspectPath, error) {
+	var out []SuspectPath
+	for _, p := range paths {
+		sp := SuspectPath{Path: p}
+		rel, ok, err := TrackedRel(git, paneCwd, worktree, p)
+		if err != nil {
+			return nil, err
+		}
+		if ok {
+			if sp.Blob, err = git.WorktreeBlob(worktree, filepath.Join(worktree, filepath.FromSlash(rel))); err != nil {
+				return nil, err
+			}
+		}
+		out = append(out, sp)
+	}
+	return out, nil
+}
+
+// CheckRecoveredSuspects returns one reason per suspect path the recovery leaves unresolved at head.
+// A path differing from the run's recorded plan hashes, or differing from head, is unresolved.
+// A path is also unresolved when its flagged blob is still at head under another path:
+// a path that did not hold that blob at the start commit.
+// The blob search covers the whole head tree, so a strand that moves the flagged file keeps the finding.
+// Only a path in the tracked tree when the batch failed records a blob,
+// so a strand that untracks the original path still has its moved copy found.
+// A suspect path that cannot be verified is not checked here:
+// the recovery entry point refuses a batch that records one, so none reaches this check.
+// Each reason about a plan file ends in planWayForward, the caller's way to settle a plan edit and recover again.
+func CheckRecoveredSuspects(geom Geometry, st *State, bs *BatchState, head, planWayForward string) ([]string, error) {
+	var paths []string
+	blobs := map[string]string{}
+	for _, sp := range bs.SuspectPaths {
+		paths = append(paths, sp.Path)
+		blobs[sp.Path] = sp.Blob
+	}
+	planDiff, _, err := CheckSuspectPaths(geom, st, "", paths)
+	if err != nil {
+		return nil, err
+	}
+	headDiff, _, err := CheckSuspectPaths(geom, st, head, paths)
+	if err != nil {
+		return nil, err
+	}
+	var reasons []string
+	isPlan := map[string]bool{}
+	for _, p := range planDiff {
+		isPlan[p] = true
+		reasons = append(reasons, fmt.Sprintf("suspect path %s still differs from the plan as the run recorded it; way forward: %s", p, planWayForward))
+	}
+	for _, p := range headDiff {
+		if !isPlan[p] {
+			reasons = append(reasons, fmt.Sprintf("suspect path %s has changes the recovery report's head %s does not hold", p, head))
+		}
+	}
+	for _, p := range paths {
+		if isPlan[p] || blobs[p] == "" || slices.Contains(headDiff, p) {
+			continue
+		}
+		listed, err := geom.Git.TreePathsWithBlob(geom.WorktreeRoot, head, blobs[p])
+		if err != nil {
+			return nil, err
+		}
+		for _, lp := range listed {
+			// With no start commit recorded, nothing was held at the start;
+			// the commit lookup would otherwise read ":<path>", the index entry.
+			atStart := ""
+			if bs.StartSHA != "" {
+				if atStart, err = geom.Git.CommitBlob(geom.WorktreeRoot, bs.StartSHA, lp); err != nil {
+					return nil, err
+				}
+			}
+			if atStart != blobs[p] {
+				reasons = append(reasons, fmt.Sprintf("suspect path %s still holds the content the audit flagged, at %s; revert it to %s or re-derive it", p, lp, bs.StartSHA))
+			}
+		}
+	}
+	return reasons, nil
+}
+
+// ResolveWritePath canonicalizes a recorded write path: cleaned, and, when relative, resolved against workdir.
+// This prevents false matches when agents mix absolute and relative spellings for the same file.
+func ResolveWritePath(workdir, path string) string {
+	cleaned := filepath.Clean(path)
+	if isTranscriptPathAbsolute(path) {
+		return cleaned
+	}
+	return filepath.Join(workdir, cleaned)
+}
+
+// isTranscriptPathAbsolute reports whether a recorded write path is absolute:
+// either in the running OS's sense or as a POSIX path with a leading "/".
+// Recorded write paths and the workdir and contract paths are always POSIX-style, whatever the platform.
+// On Windows, filepath.IsAbs alone misses a leading "/".
+// Joining such a path onto workdir again yields a path that never matches the contract paths.
+func isTranscriptPathAbsolute(path string) bool {
+	return filepath.IsAbs(path) || strings.HasPrefix(path, "/")
+}
+
+// PathWithin reports whether path is dir itself or lies beneath it;
+// both must already be canonical.
+func PathWithin(dir, path string) bool {
+	rel, err := filepath.Rel(dir, path)
+	if err != nil {
+		return false
+	}
+	return rel == "." || (rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)))
+}
+
+// CanonicalPath resolves links in path through its nearest existing ancestor.
+// It re-joins the missing tail, so a path that does not exist yet still compares against a link-resolved directory.
+func CanonicalPath(path string) (string, error) {
+	cleaned := filepath.Clean(path)
+	var tail []string
+	cur := cleaned
+	for {
+		resolved, err := filepath.EvalSymlinks(cur)
+		if err == nil {
+			for i := len(tail) - 1; i >= 0; i-- {
+				resolved = filepath.Join(resolved, tail[i])
+			}
+			return resolved, nil
+		}
+		if !errors.Is(err, os.ErrNotExist) {
+			return "", fmt.Errorf("runplan: resolve links in %s: %w", cur, err)
+		}
+		parent := filepath.Dir(cur)
+		if parent == cur {
+			return cleaned, nil
+		}
+		tail = append(tail, filepath.Base(cur))
+		cur = parent
+	}
+}
