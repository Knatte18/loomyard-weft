+// mergeparent.go is the "lym beam merge-parent" sequence: it judges the named beam and files the darn task, in the beam's project, whose run merges the beam's parent branch into the beam with its Code-Review perch on.
+
+package beamcli
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/reviewbudget"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+)
+
+// mergeParentSuffix ends the slug of every merge task `lym beam merge-parent` files, before the number a second one takes.
+const mergeParentSuffix = "-merge-in"
+
+// mergeTaskSlugPattern matches the slug of a merge task: the suffix, then an optional number.
+var mergeTaskSlugPattern = regexp.MustCompile(regexp.QuoteMeta(mergeParentSuffix) + `(-[0-9]+)?$`)
+
+// mergeParentMinRounds is the fewest Code-Review rounds a merge task runs, so its perch is on whatever the hub's budget.
+const mergeParentMinRounds = 1
+
+// mergeParent files the merge task of the beam slug and returns the task's slug, the parent branch it merges and how the run follows.
+// It refuses what `land`'s entry check refuses, a beam whose origin record names no parent branch, and a beam that holds an open merge task already.
+// The task is a released darn task in the beam's project, carrying the beam's labels, so the beam's dobby starts it as any member.
+// Its run settings set the Code-Review budget to the hub's, or to mergeParentMinRounds when the hub's is lower, with a hard cap above it.
+func mergeParent(deps landDeps, slug string) (map[string]any, error) {
+	const verb = "lym beam merge-parent"
+	owners, err := deps.ReadOwners()
+	if err != nil {
+		return nil, fmt.Errorf("%s: read the board's owners: %w", verb, err)
+	}
+	if err := judgeLandEntry(deps, owners, verb, slug); err != nil {
+		return nil, err
+	}
+	origin, _, err := deps.OriginRecord(slug)
+	if err != nil {
+		return nil, fmt.Errorf("%s: read the origin record of %s: %w", verb, slug, err)
+	}
+	if origin.ParentBranch == "" {
+		return nil, fmt.Errorf("%s: the origin record of the beam %s names no parent branch; way forward: run `lym fabric reconcile` to restore its records worktree, then `%s %s`", verb, slug, verb, slug)
+	}
+
+	tasks, err := deps.Tasks()
+	if err != nil {
+		return nil, fmt.Errorf("%s: read the board: %w", verb, err)
+	}
+	if open, found := openMergeTask(tasks, slug); found {
+		return nil, fmt.Errorf("%s: the merge task %s stands open in the beam %s; way forward: run `lym batten status %s` and let it land, or remove it with `lym batten cancel %s --remove`, then `%s %s`", verb, open, slug, open, open, verb, slug)
+	}
+	var labels []string
+	for _, task := range tasks {
+		if task.Slug == slug {
+			labels = task.Labels
+		}
+	}
+	caps, err := deps.CodeReviewCaps()
+	if err != nil {
+		return nil, fmt.Errorf("%s: read the hub's Code-Review budget: %w", verb, err)
+	}
+	rounds := max(caps.Soft, mergeParentMinRounds)
+	perch := string(loomengine.PerchCode)
+
+	taskSlug := freeMergeTaskSlug(tasks, slug)
+	fields := map[string]any{
+		"slug":    taskSlug,
+		"title":   fmt.Sprintf("Merge %s into the beam %s", origin.ParentBranch, slug),
+		"kind":    boardengine.KindTask,
+		"project": slug,
+		"recipe":  shedrun.RecipeDarn,
+		"labels":  labels,
+		"body":    mergeParentBody(slug, origin.ParentBranch),
+		"run_settings": map[string]any{
+			"loom": map[string]any{
+				reviewbudget.SoftKey(perch): rounds,
+				reviewbudget.HardKey(perch): max(caps.Hard, rounds+1),
+			},
+		},
+	}
+	if err := deps.FileTask(fields); err != nil {
+		return nil, fmt.Errorf("%s: file the merge task %s: %w; way forward: fix the cause it names, then run `%s %s` again", verb, taskSlug, err, verb, slug)
+	}
+	return map[string]any{
+		"slug":          slug,
+		"task":          taskSlug,
+		"parent_branch": origin.ParentBranch,
+		"way_forward":   fmt.Sprintf("the beam's dobby starts %s as any member; run `lym batten status %s` to follow it", taskSlug, taskSlug),
+	}, nil
+}
+
+// openMergeTask returns the slug of a merge task of beam that is not done, found by its project and its slug's suffix.
+func openMergeTask(tasks []boardengine.Task, beam string) (string, bool) {
+	for _, task := range tasks {
+		if task.Kind == boardengine.KindTask && task.Project == beam && !boardengine.IsDoneStatus(task.Status) && mergeTaskSlugPattern.MatchString(task.Slug) {
+			return task.Slug, true
+		}
+	}
+	return "", false
+}
+
+// freeMergeTaskSlug returns the first merge task slug of beam no board entry holds: the beam's slug and the suffix, then the same with -2, -3 and so on.
+// The beam's slug is cut so the whole fits the board's slug length.
+func freeMergeTaskSlug(tasks []boardengine.Task, beam string) string {
+	taken := make(map[string]bool, len(tasks))
+	for _, task := range tasks {
+		taken[task.Slug] = true
+	}
+	for number := 1; ; number++ {
+		tail := mergeParentSuffix
+		if number > 1 {
+			tail += "-" + strconv.Itoa(number)
+		}
+		head := beam
+		if room := boardengine.MaxSlugLength - len(tail); len(head) > room {
+			head = head[:room]
+		}
+		if candidate := head + tail; !taken[candidate] {
+			return candidate
+		}
+	}
+}
+
+// mergeParentBody returns the body of the merge task of beam, which merges parentBranch.
+// The decision record carries it as the task's goal, so it instructs both the darn writer and the Code-Review perch.
+func mergeParentBody(beam, parentBranch string) string {
+	return fmt.Sprintf(`Merge in from parent: bring the parent branch %[2]s into the beam %[1]s.
+This task's branch forks from the beam, so its landing carries the merge into the beam.
+Filed by `+"`lym beam merge-parent %[1]s`"+`.
+
+- Run `+"`lym fabric merge-in %[2]s`"+` in this task's worktree.
+  On a conflict, settle each path it lists, stage them with `+"`lym fabric merge-stage <paths>`"+` and conclude with `+"`lym fabric merge --continue`"+`.
+- Make the gate pass on the merged tree: fix what the merge broke, on either side, and nothing else.
+- Make no change the merge does not need: no refactor, no feature and no fix of an older fault.
+- When the merge is already up to date, change nothing and say so in the change description.
+- The Code-Review perch reviews the merge alone: each merge commit's conflict resolution and every commit after the merge, never the parent's own commits the merge brings in.
+  Checking the project's goal is no part of this task.
+`, beam, parentBranch)
+}
diff --git a/internal/beamcli/mergeparent_test.go b/internal/beamcli/mergeparent_test.go
new file mode 100644
index 00000000..bedd31b1
--- /dev/null
+++ b/internal/beamcli/mergeparent_test.go
@@ -0,0 +1,131 @@
+// mergeparent_test.go drives the merge-parent sequence over the land test's fake hub: the entries that are not a beam, a beam with no parent branch or an open merge task, and the darn task filed with its perch on under the first free slug.
+
+package beamcli
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/reviewbudget"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestMergeParent(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	done := boardengine.StatusDone
+	longBeam := strings.Repeat("x", boardengine.MaxSlugLength-2)
+	tests := []struct {
+		name  string
+		slug  string
+		setup func(w *landWorld)
+		// wantErr is empty for a filing, else every substring the refusal names.
+		wantErr []string
+		// wantTask is the filed task's slug, and wantRounds and wantHard the Code-Review caps its run settings carry.
+		wantTask   string
+		wantRounds int
+		wantHard   int
+	}{
+		{name: "TaskRefusedNamingItsOwnLanding", slug: "task1", wantErr: []string{"lym beam merge-parent:", "lym batten run task1"}},
+		{name: "GroupingProjectRefusedNamingCreate", slug: "group", wantErr: []string{"grouping project", "lym beam create group"}},
+		{name: "DoneBeamRefused", slug: "landed", wantErr: []string{"already landed"}},
+		{
+			name: "BeamWithNoParentBranchRefusedNamingReconcile", slug: "b",
+			setup:   func(w *landWorld) { w.origins["b"] = fabricengine.Origin{Beam: true} },
+			wantErr: []string{"names no parent branch", "lym fabric reconcile"},
+		},
+		{
+			name: "OpenMergeTaskRefused", slug: "b",
+			setup: func(w *landWorld) {
+				w.tasks = append(w.tasks, boardengine.Task{Slug: "b-merge-in-2", Kind: boardengine.KindTask, Project: "b"})
+			},
+			wantErr: []string{"b-merge-in-2 stands open", "lym batten cancel b-merge-in-2 --remove"},
+		},
+		{name: "OffPerchTurnedOnForOneRound", slug: "b", wantTask: "b-merge-in", wantRounds: 1, wantHard: 2},
+		{
+			name: "HubBudgetKept", slug: "b",
+			setup:    func(w *landWorld) { w.caps = reviewbudget.Caps{Soft: 3, Hard: 5} },
+			wantTask: "b-merge-in", wantRounds: 3, wantHard: 5,
+		},
+		{
+			name: "DoneMergeTaskTakesTheNextNumber", slug: "b",
+			setup: func(w *landWorld) {
+				w.tasks = append(w.tasks, boardengine.Task{Slug: "b-merge-in", Kind: boardengine.KindTask, Project: "b", Status: &done})
+			},
+			wantTask: "b-merge-in-2", wantRounds: 1, wantHard: 2,
+		},
+		{
+			name: "LongBeamSlugCutToTheBoardsLength", slug: longBeam,
+			setup: func(w *landWorld) {
+				w.owners.Entries[longBeam] = boardengine.OwnerEntry{IsProject: true, Beam: true, Owner: here}
+				w.pairs[longBeam] = true
+				w.origins[longBeam] = fabricengine.Origin{Beam: true, ParentBranch: "main"}
+			},
+			wantTask: longBeam[:boardengine.MaxSlugLength-len(mergeParentSuffix)] + mergeParentSuffix, wantRounds: 1, wantHard: 2,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newLandWorld()
+			if tt.setup != nil {
+				tt.setup(w)
+			}
+
+			got, err := mergeParent(w.deps(), tt.slug)
+
+			if len(tt.wantErr) > 0 {
+				if err == nil {
+					t.Fatalf("mergeParent(%q) = %v, nil; want a refusal naming %v", tt.slug, got, tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("mergeParent(%q) error = %q; want it to name %q", tt.slug, err.Error(), want)
+					}
+				}
+				if len(w.filed) != 0 {
+					t.Errorf("mergeParent(%q) filed %v; want nothing filed on a refusal", tt.slug, w.filed)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("mergeParent(%q) = %v; want the merge task filed", tt.slug, err)
+			}
+			if len(w.filed) != 1 {
+				t.Fatalf("mergeParent(%q) filed %d tasks; want 1", tt.slug, len(w.filed))
+			}
+			fields := w.filed[0]
+			if len(tt.wantTask) > boardengine.MaxSlugLength {
+				t.Fatalf("want slug %q is longer than the board's slug length", tt.wantTask)
+			}
+			wantSettings := map[string]any{"loom": map[string]any{"code_max_bounces": tt.wantRounds, "code_hard_max_bounces": tt.wantHard}}
+			if fields["slug"] != tt.wantTask || fields["kind"] != boardengine.KindTask || fields["project"] != tt.slug || fields["recipe"] != "darn" || !reflect.DeepEqual(fields["run_settings"], wantSettings) {
+				t.Errorf("mergeParent(%q) filed %v; want slug %q, a darn task in project %q with run settings %v", tt.slug, fields, tt.wantTask, tt.slug, wantSettings)
+			}
+			if body, _ := fields["body"].(string); !strings.Contains(body, "lym fabric merge-in main") || !strings.Contains(body, "reviews the merge alone") {
+				t.Errorf("mergeParent(%q) body = %q; want it to name `lym fabric merge-in main` and the perch's review of the merge alone", tt.slug, body)
+			}
+			if got["task"] != tt.wantTask || got["parent_branch"] != "main" || !strings.Contains(got["way_forward"].(string), "lym batten status "+tt.wantTask) {
+				t.Errorf("mergeParent(%q) = %v; want task %q, parent_branch main and a way forward naming its batten status", tt.slug, got, tt.wantTask)
+			}
+		})
+	}
+}
+
+func TestMergeParentCarriesTheBeamsLabels(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	w := newLandWorld()
+
+	if _, err := mergeParent(w.deps(), "b"); err != nil {
+		t.Fatalf("mergeParent(b) = %v; want the merge task filed", err)
+	}
+
+	if got, want := w.filed[0]["labels"], []string{"enhancement", "reed"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("mergeParent(b) labels = %v; want the beam's %v", got, want)
+	}
+}
