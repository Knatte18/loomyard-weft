+	if err := os.WriteFile(p.RemoteControlPath, []byte("{not json"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := RemoteControlOn(p, "g1"); err == nil {
+		t.Error("RemoteControlOn of undecodable JSON returned no error")
 	}
 }
 
