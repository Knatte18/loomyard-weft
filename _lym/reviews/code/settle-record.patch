new file mode 100644
index 00000000..3f5e32fd
--- /dev/null
+++ b/internal/proc/memorycap_windows.go
@@ -0,0 +1,41 @@
+// memorycap_windows.go caps a command's memory with the memory limit of a kill-on-close job object.
+
+package proc
+
+import (
+	"os/exec"
+
+	"golang.org/x/sys/windows"
+)
+
+// runMemoryCappedPlatform runs cmd in a job object whose memory limit is limit bytes.
+// The job fails an allocation past the limit in the process that asks for it, so killed is always false.
+// A cancel of cmd ends every process of the job before it ends cmd, and the job ends with the call.
+// cmd joins the job once it has started, so a process it starts in between is outside the limit and the cancel.
+func runMemoryCappedPlatform(cmd *exec.Cmd, limit int64) (bool, error) {
+	job, err := createKillOnCloseJob(nil, uintptr(limit))
+	if err != nil {
+		return false, err
+	}
+	defer windows.CloseHandle(job)
+	if cancel := cmd.Cancel; cancel != nil {
+		cmd.Cancel = func() error {
+			_ = windows.TerminateJobObject(job, 1)
+			return cancel()
+		}
+	}
+	if err := cmd.Start(); err != nil {
+		return false, err
+	}
+	if err := assignProcessToJob(job, cmd.Process.Pid); err != nil {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		return false, err
+	}
+	return false, cmd.Wait()
+}
+
+// memoryCapCoversTreePlatform is always true: a job object holds every process its command starts.
+func memoryCapCoversTreePlatform() bool {
+	return true
+}
diff --git a/internal/proc/memorylimit.go b/internal/proc/memorylimit.go
new file mode 100644
index 00000000..915910e0
--- /dev/null
+++ b/internal/proc/memorylimit.go
@@ -0,0 +1,97 @@
+// memorylimit.go reads the cgroup v2 memory limit that the calling process sits under.
+// It is the level of the cgroup ancestry with the least memory left.
+
+package proc
+
+import (
+	"os"
+	"path"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// MemoryLimit is one cgroup's memory use and its limit.
+type MemoryLimit struct {
+	// Used is the bytes the cgroup and its descendants hold outside the file cache, which the kernel drops under pressure.
+	Used int64
+	// Max is the lower of the cgroup's `memory.high` and `memory.max`.
+	Max int64
+	// Cgroup is the cgroup's path below the cgroup v2 mount, such as `/user.slice/user-1000.slice`.
+	Cgroup string
+}
+
+// Headroom is the bytes the cgroup can still take before its limit throttles or kills.
+func (l MemoryLimit) Headroom() int64 {
+	return l.Max - l.Used
+}
+
+// ReadMemoryLimit reads the memory limit closest to being reached over the calling process's cgroup and its ancestors.
+// A level's limit is the lower of its `memory.high`, where the kernel throttles the level, and its `memory.max`.
+// Reading every level sees a limit wherever it is set, such as a systemd user slice.
+// found is false when the process's cgroup v2 path is unreadable, as on Windows or a cgroup v1 host.
+// It is also false when no level sets a numeric limit.
+func ReadMemoryLimit() (limit MemoryLimit, found bool) {
+	return readMemoryLimitAt(selfCgroupFile, cgroupMount)
+}
+
+// readMemoryLimitAt reads the memory limit closest to being reached for the process whose cgroup file is selfCgroup.
+// mount is the cgroup v2 mount the levels are read under.
+func readMemoryLimitAt(selfCgroup, mount string) (MemoryLimit, bool) {
+	cgroup, ok := readCgroupV2Path(selfCgroup)
+	if !ok {
+		return MemoryLimit{}, false
+	}
+	var tightest MemoryLimit
+	found := false
+	for level := cgroup; ; level = path.Dir(level) {
+		if limit, ok := readMemoryLevel(mount, level); ok && (!found || limit.Headroom() < tightest.Headroom()) {
+			tightest, found = limit, true
+		}
+		if level == "/" {
+			break
+		}
+	}
+	return tightest, found
+}
+
+// readMemoryLevel reads the memory use and numeric limit of the cgroup at level under mount;
+// ok is false when the level sets no limit or its `memory.current` is unreadable or malformed.
+func readMemoryLevel(mount, level string) (MemoryLimit, bool) {
+	dir := filepath.Join(mount, filepath.FromSlash(level))
+	throttle, throttled := readIntFile(filepath.Join(dir, "memory.high"))
+	hard, capped := readIntFile(filepath.Join(dir, "memory.max"))
+	limit := hard
+	switch {
+	case !throttled && !capped:
+		return MemoryLimit{}, false
+	case throttled && (!capped || throttle < hard):
+		limit = throttle
+	}
+	current, ok := readIntFile(filepath.Join(dir, "memory.current"))
+	if !ok {
+		return MemoryLimit{}, false
+	}
+	return MemoryLimit{Used: int64(current) - fileCacheBytes(dir), Max: int64(limit), Cgroup: level}, true
+}
+
+// fileCacheBytes returns the file cache the cgroup at dir holds:
+// the `inactive_file` and `active_file` lines of its `memory.stat`.
+// An unreadable file reads as none.
+func fileCacheBytes(dir string) int64 {
+	content, err := os.ReadFile(filepath.Join(dir, "memory.stat"))
+	if err != nil {
+		return 0
+	}
+	var cache int64
+	for _, line := range strings.Split(string(content), "\n") {
+		key, value, found := strings.Cut(line, " ")
+		if !found || (key != "inactive_file" && key != "active_file") {
+			continue
+		}
+		if bytes, err := strconv.ParseInt(strings.TrimSpace(value), 10, 64); err == nil {
+			cache += bytes
+		}
+	}
+	return cache
+}
diff --git a/internal/proc/memorylimit_test.go b/internal/proc/memorylimit_test.go
new file mode 100644
index 00000000..f01a8870
--- /dev/null
+++ b/internal/proc/memorylimit_test.go
@@ -0,0 +1,97 @@
+// memorylimit_test.go pins the memory-limit reader over fixture cgroup files.
+// The level with the least memory left wins, and an unreadable or limitless ancestry reads as not found.
+
+package proc
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+func TestReadMemoryLimitAt(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const leaf = "/user.slice/user-1000.slice/user@1000.service/app.slice/run.scope"
+	// level holds one cgroup's memory.high, memory.max, memory.current and memory.stat; an empty text leaves the file absent.
+	type level struct{ high, max, current, stat string }
+	tests := []struct {
+		name string
+		// selfCgroup is the cgroup file's content; empty leaves the file absent.
+		selfCgroup string
+		levels     map[string]level
+		want       MemoryLimit
+		wantFound  bool
+	}{
+		{
+			name:       "the lower of high and max is the limit, and the file cache does not count as used",
+			selfCgroup: "0::" + leaf + "\n",
+			levels: map[string]level{
+				"/user.slice/user-1000.slice": {
+					high: "17179869184", max: "23622320128", current: "14037016576",
+					stat: "anon 5658374144\nfile 7582158848\ninactive_file 4161351680\nactive_file 2899247104\n",
+				},
+			},
+			want:      MemoryLimit{Used: 6976417792, Max: 17179869184, Cgroup: "/user.slice/user-1000.slice"},
+			wantFound: true,
+		},
+		{
+			name:       "the level with the least memory left wins over a larger limit closer to the root",
+			selfCgroup: "0::" + leaf + "\n",
+			levels: map[string]level{
+				"/user.slice/user-1000.slice": {high: "max", max: "8000", current: "1000"},
+				leaf:                          {high: "500", max: "max", current: "450"},
+			},
+			want:      MemoryLimit{Used: 450, Max: 500, Cgroup: leaf},
