+				}
+			},
+			gatePasses:   true,
+			wantFindings: []string{"seal fault", "--restore"},
+		},
+		{
+			name:  "a failed current capture names its log",
+			setup: func(f *checkFixture) { f.seed(countedScope(), baseline); f.captureFails = true },
