+// codetipsettle_test.go pins settleCodeTip over fake deps: which branch of the owner's code-tip wait each reading takes.
+
+package battencli
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
