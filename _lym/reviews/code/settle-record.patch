@@ -106,6 +106,17 @@
 // ProbeReview and ResumeReview build the same table from the same RunOpts.
 // So the caller passes the recorded token and assistant.
 //
+// # Parent-review asks
+//
+// A run's asks to its parent orch to review a round live in a never-tracked record that ParentReviewFilesOf locates.
+// RecordParentAsk numbers each ask from 1 up in recording order.
+// An ask moves only from pending-post to open and from either to an end state: done, timeout, no-parent or not-sent.
+// Every move takes the record's one lock, so an answer and a timeout never both land.
+// AnswerParentAsk writes the parent's report beside the record and sets the latest ask done.
+// It numbers the report's findings P1 up and refuses with a ParentAnswerRefusal that names its kind.
+// An ask at or past its deadline is set timeout instead.
+// ExpireParentAsk sets the latest active ask timeout once its deadline has passed.
+//
 // # The fix half
 //
 // Engine.Fix runs one fresh fixer session as the chair of the fix table.
diff --git a/internal/burlerengine/parentreview.go b/internal/burlerengine/parentreview.go
new file mode 100644
index 00000000..071c40d5
--- /dev/null
+++ b/internal/burlerengine/parentreview.go
@@ -0,0 +1,283 @@
+// parentreview.go keeps a run's parent-review asks: the never-tracked record of each ask to the parent orch,
+// and the parent's report for each answered one.
+// Every state move is forward-only and runs under the record's one lock, so an answer and a timeout never both land.
+
+package burlerengine
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fsx"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lymdirs"
+	"github.com/Knatte18/loomyard/internal/state"
+	"gopkg.in/yaml.v3"
+)
+
+// ParentAskState is where one parent-review ask stands.
+type ParentAskState string
+
+// The states of a parent-review ask.
+// An ask moves only from pending-post to open, and from either of those to an end state.
+const (
+	// ParentAskPendingPost is an ask recorded before its mail was posted; the mail may have gone out before a crash.
+	ParentAskPendingPost ParentAskState = "pending-post"
+	// ParentAskOpen is an ask whose mail went out and that the parent has not answered.
+	ParentAskOpen ParentAskState = "open"
+	// ParentAskDone is an ask the parent answered; its report sits beside the record.
+	ParentAskDone ParentAskState = "done"
+	// ParentAskTimeout is an ask that reached its deadline, or whose round closed, with no answer.
+	ParentAskTimeout ParentAskState = "timeout"
+	// ParentAskNoParent is an ask that never went out because no parent orch resolved.
+	ParentAskNoParent ParentAskState = "no-parent"
+	// ParentAskNotSent is an ask that never went out because its deadline cap left no room; Reason says why.
+	ParentAskNotSent ParentAskState = "not-sent"
+)
+
+// Ended reports whether s is an end state, from which an ask never moves.
+// A state this binary does not know counts as ended, so it is never moved.
+func (s ParentAskState) Ended() bool {
+	return s != ParentAskPendingPost && s != ParentAskOpen
+}
+
+// ParentAsk is one ask to the parent orch to review a round.
+type ParentAsk struct {
+	// Number is the ask's number within the run, from 1 up in the order the asks were recorded.
+	Number int `json:"number"`
+	// Round is the review round the ask belongs to.
+	Round int            `json:"round"`
+	State ParentAskState `json:"state"`
+	// Strand is the orch strand the ask went to, which may answer it whichever orch the run's parent resolves to later.
+	Strand  string    `json:"strand,omitempty"`
+	AskedAt time.Time `json:"asked_at"`
+	// Deadline is when an ask still pending-post or open is set timeout; every ask that goes out carries one.
+	Deadline time.Time `json:"deadline"`
+	// Reason says why an ask never went out.
+	Reason string `json:"reason,omitempty"`
+	// Report is the parent report's path, set once the ask is done.
+	Report     string    `json:"report,omitempty"`
+	AnsweredAt time.Time `json:"answered_at,omitzero"`
+}
+
+// ParentAskRecord is a run's record of its parent-review asks, oldest first.
+type ParentAskRecord struct {
+	Asks []ParentAsk `json:"asks"`
+}
+
+// Latest returns the run's latest ask, and false when the run holds none.
+func (r ParentAskRecord) Latest() (ParentAsk, bool) {
+	if len(r.Asks) == 0 {
+		return ParentAsk{}, false
+	}
+	return r.Asks[len(r.Asks)-1], true
+}
+
+// Ask returns the ask numbered number, and false when the run holds no such ask.
+func (r ParentAskRecord) Ask(number int) (ParentAsk, bool) {
+	for _, ask := range r.Asks {
+		if ask.Number == number {
+			return ask, true
+		}
+	}
+	return ParentAsk{}, false
+}
+
+// ParentReviewFiles locates a run's parent-review files: the ask record, its lock and the directory holding the reports.
+// None is tracked.
+type ParentReviewFiles struct {
+	Dir    string
+	Record string
+	Lock   string
+}
+
+// parentReviewLockName is the name of the ask record's lock in the checkout's lock directory.
+const parentReviewLockName = "parent-review.lock"
+
+// ParentReviewFilesOf returns the parent-review files of the run whose worktree is anchored at anchorPath.
+func ParentReviewFilesOf(anchorPath string) ParentReviewFiles {
+	dir := filepath.Join(anchorPath, lymdirs.DotLymDirName, lymdirs.ParentReviewDirName)
+	return ParentReviewFiles{
+		Dir:    dir,
+		Record: filepath.Join(dir, "asks.json"),
+		Lock:   lock.TrackedLockPath(anchorPath, parentReviewLockName),
+	}
+}
+
+// ReportPath returns the path of the parent's report for the ask numbered number, beside the ask record.
+func (f ParentReviewFiles) ReportPath(number int) string {
+	return filepath.Join(f.Dir, fmt.Sprintf("ask-%d.report.yaml", number))
+}
+
+// ParentFinding is one finding of the parent's report.
+// Change names what to change and where; Severity and Class are optional and, when set, in the review format's words.
+type ParentFinding struct {
+	ID       string   `yaml:"id"`
+	Severity Severity `yaml:"severity,omitempty"`
+	Class    Class    `yaml:"class,omitempty"`
+	Change   string   `yaml:"change"`
+}
+
+// ParentReport is the parent's answer to one ask, written as YAML beside the ask record.
+// Satisfied is true for a report with no findings.
+type ParentReport struct {
+	Ask       int             `yaml:"ask"`
+	Satisfied bool            `yaml:"satisfied"`
+	Findings  []ParentFinding `yaml:"findings"`
+}
+
+// ReadParentAsks reads the run's ask record; found is false when the run never recorded an ask.
+func ReadParentAsks(files ParentReviewFiles) (ParentAskRecord, bool, error) {
+	return state.ReadJSON[ParentAskRecord](files.Record, files.Lock)
+}
+
+// RecordParentAsk appends ask as the run's next ask, numbered one past the latest, and returns it as recorded.
+// Its state is the caller's.
+// It is pending-post for an ask about to be posted, and no-parent or not-sent for one that never goes out.
+func RecordParentAsk(files ParentReviewFiles, ask ParentAsk) (ParentAsk, error) {
+	err := state.UpdateJSON(files.Record, files.Lock, func(record ParentAskRecord, _ bool) (ParentAskRecord, error) {
+		ask.Number = 1
+		if latest, ok := record.Latest(); ok {
+			ask.Number = latest.Number + 1
+		}
+		record.Asks = append(record.Asks, ask)
+		return record, nil
+	})
+	if err != nil {
+		return ParentAsk{}, fmt.Errorf("burler: record a parent-review ask: %w", err)
+	}
+	return ask, nil
+}
+
+// errParentAskUnchanged aborts a locked update that has nothing to write.
+var errParentAskUnchanged = errors.New("burler: the parent-review ask is unchanged")
+
+// MarkParentAskPosted moves the ask numbered number from pending-post to open once its mail went out.
+// An ask past pending-post is left as it stands, and so is a number the run holds no ask for.
+func MarkParentAskPosted(files ParentReviewFiles, number int) error {
+	err := state.UpdateJSON(files.Record, files.Lock, func(record ParentAskRecord, _ bool) (ParentAskRecord, error) {
+		for i := range record.Asks {
+			if record.Asks[i].Number == number && record.Asks[i].State == ParentAskPendingPost {
+				record.Asks[i].State = ParentAskOpen
+				return record, nil
+			}
+		}
+		return record, errParentAskUnchanged
+	})
+	if err != nil && !errors.Is(err, errParentAskUnchanged) {
+		return fmt.Errorf("burler: mark parent-review ask %d posted: %w", number, err)
+	}
+	return nil
+}
+
+// ParentAnswerRefusalKind names why an answer was refused.
+type ParentAnswerRefusalKind string
+
+// The reasons an answer is refused.
+const (
+	// ParentAnswerNoAsk: the run holds no ask.
+	ParentAnswerNoAsk ParentAnswerRefusalKind = "no-ask"
+	// ParentAnswerNotLatest: the answer names an ask other than the run's latest.
+	ParentAnswerNotLatest ParentAnswerRefusalKind = "not-latest"
+	// ParentAnswerEnded: the ask is already in an end state.
+	ParentAnswerEnded ParentAnswerRefusalKind = "ended"
+	// ParentAnswerPastDeadline: the ask was at or past its deadline, and the answer set it timeout.
+	ParentAnswerPastDeadline ParentAnswerRefusalKind = "past-deadline"
+)
+
+// ParentAnswerRefusal is the error AnswerParentAsk returns for an answer it did not record.
+// Latest is the run's latest ask as it stands after the call, and the zero ask when the run holds none.
+type ParentAnswerRefusal struct {
+	Kind   ParentAnswerRefusalKind
+	Latest ParentAsk
+}
+
+func (r *ParentAnswerRefusal) Error() string {
+	return fmt.Sprintf("burler: parent-review answer refused (%s); the latest ask is %d, %s", r.Kind, r.Latest.Number, r.Latest.State)
+}
+
+// AnswerParentAsk records the parent's answer to the ask numbered number as one step under the record's lock.
+// It writes the report and sets the ask done.
+// findings become the report's items in their order, with ids P1, P2 and so on; no findings make a satisfied report.
+// It answers only the run's latest ask, and only while that ask is pending-post or open and now is before its deadline.
+// An ask still pending-post or open at or past its deadline is set timeout instead, and the answer refused.
+// Every refusal is a *ParentAnswerRefusal and writes no report.
+func AnswerParentAsk(files ParentReviewFiles, number int, now time.Time, findings []ParentFinding) (ParentAsk, error) {
+	var refusal *ParentAnswerRefusal
+	var answered ParentAsk
+	err := state.UpdateJSON(files.Record, files.Lock, func(record ParentAskRecord, _ bool) (ParentAskRecord, error) {
+		latest, ok := record.Latest()
+		switch {
+		case !ok:
+			refusal = &ParentAnswerRefusal{Kind: ParentAnswerNoAsk}
+			return record, errParentAskUnchanged
+		case latest.Number != number:
+			refusal = &ParentAnswerRefusal{Kind: ParentAnswerNotLatest, Latest: latest}
+			return record, errParentAskUnchanged
+		case latest.State.Ended():
+			refusal = &ParentAnswerRefusal{Kind: ParentAnswerEnded, Latest: latest}
+			return record, errParentAskUnchanged
+		}
+		ask := &record.Asks[len(record.Asks)-1]
+		if !now.Before(ask.Deadline) {
+			ask.State = ParentAskTimeout
+			refusal = &ParentAnswerRefusal{Kind: ParentAnswerPastDeadline, Latest: *ask}
+			return record, nil
+		}
+		path := files.ReportPath(number)
+		if err := writeParentReport(path, number, findings); err != nil {
+			return record, err
+		}
+		ask.State, ask.Report, ask.AnsweredAt = ParentAskDone, path, now
+		answered = *ask
+		return record, nil
+	})
+	if err != nil && !errors.Is(err, errParentAskUnchanged) {
+		return ParentAsk{}, fmt.Errorf("burler: answer parent-review ask %d: %w", number, err)
+	}
+	if refusal != nil {
+		return ParentAsk{}, refusal
+	}
+	return answered, nil
+}
+
+// writeParentReport writes the report of findings for the ask numbered number to path, numbering the findings P1 up.
+func writeParentReport(path string, number int, findings []ParentFinding) error {
+	report := ParentReport{Ask: number, Satisfied: len(findings) == 0, Findings: make([]ParentFinding, len(findings))}
+	for i, finding := range findings {
+		finding.ID = fmt.Sprintf("P%d", i+1)
+		report.Findings[i] = finding
+	}
+	data, err := yaml.Marshal(report)
+	if err != nil {
+		return fmt.Errorf("marshal the parent report: %w", err)
+	}
+	return fsx.AtomicWriteBytes(path, data)
+}
+
+// ExpireParentAsk moves the run's latest ask to timeout as one step under the record's lock.
+// It does so only when the ask is pending-post or open and now is at or past its deadline.
+// It returns the latest ask as it then stands.
+// found is false when the run holds no ask, and nothing is written then.
+func ExpireParentAsk(files ParentReviewFiles, now time.Time) (ask ParentAsk, found bool, err error) {
+	err = state.UpdateJSON(files.Record, files.Lock, func(record ParentAskRecord, _ bool) (ParentAskRecord, error) {
+		latest, ok := record.Latest()
+		if !ok {
+			return record, errParentAskUnchanged
+		}
+		found = true
+		ask = latest
+		if latest.State.Ended() || now.Before(latest.Deadline) {
+			return record, errParentAskUnchanged
+		}
+		record.Asks[len(record.Asks)-1].State = ParentAskTimeout
+		ask.State = ParentAskTimeout
+		return record, nil
+	})
+	if err != nil && !errors.Is(err, errParentAskUnchanged) {
+		return ParentAsk{}, false, fmt.Errorf("burler: expire the parent-review ask: %w", err)
+	}
+	return ask, found, nil
+}
diff --git a/internal/burlerengine/parentreview_test.go b/internal/burlerengine/parentreview_test.go
new file mode 100644
index 00000000..ef442322
--- /dev/null
+++ b/internal/burlerengine/parentreview_test.go
@@ -0,0 +1,313 @@
+// parentreview_test.go tables the parent-review ask record.
+// It covers numbering and the forward-only state moves.
+// It also covers the parent's answer and its report, an answer racing the deadline,
+// and a record write that fails at the deadline.
+
+package burlerengine_test
+
+import (
+	"errors"
+	"os"
+	"reflect"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"gopkg.in/yaml.v3"
+)
+
+// parentAskBase is the clock every parent-review ask test judges deadlines against.
+var parentAskBase = time.Date(2026, 11, 11, 12, 0, 0, 0, time.UTC)
+
+// recordParentAsks records asks in order into a fresh run's files and returns those files.
+func recordParentAsks(t *testing.T, asks ...burlerengine.ParentAsk) burlerengine.ParentReviewFiles {
+	t.Helper()
+	files := burlerengine.ParentReviewFilesOf(t.TempDir())
+	for _, ask := range asks {
+		if _, err := burlerengine.RecordParentAsk(files, ask); err != nil {
+			t.Fatalf("RecordParentAsk() error = %v", err)
+		}
+	}
+	return files
+}
+
+// parentAskStates returns the state of every ask the run's record holds, oldest first.
+func parentAskStates(t *testing.T, files burlerengine.ParentReviewFiles) []burlerengine.ParentAskState {
+	t.Helper()
+	record, _, err := burlerengine.ReadParentAsks(files)
+	if err != nil {
+		t.Fatalf("ReadParentAsks() error = %v", err)
+	}
+	states := make([]burlerengine.ParentAskState, len(record.Asks))
+	for i, ask := range record.Asks {
+		states[i] = ask.State
+	}
+	return states
+}
+
+// TestParentAsks_RecordAndMoveForward verifies asks are numbered in order and move only forward.
+// MarkParentAskPosted opens only a pending-post ask;
+// ExpireParentAsk sets an active latest ask timeout only at or past its deadline and never moves an ended one.
+func TestParentAsks_RecordAndMoveForward(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	open := burlerengine.ParentAsk{State: burlerengine.ParentAskPendingPost, Deadline: parentAskBase.Add(time.Minute)}
+	tests := []struct {
+		name      string
+		asks      []burlerengine.ParentAsk
+		move      func(burlerengine.ParentReviewFiles) error
+		want      []burlerengine.ParentAskState
+		wantFound bool
+	}{
+		{
+			name: "posting opens a pending-post ask",
+			asks: []burlerengine.ParentAsk{open},
+			move: func(f burlerengine.ParentReviewFiles) error { return burlerengine.MarkParentAskPosted(f, 1) },
+			want: []burlerengine.ParentAskState{burlerengine.ParentAskOpen},
+		},
+		{
+			name: "posting leaves an ended ask ended",
+			asks: []burlerengine.ParentAsk{{State: burlerengine.ParentAskTimeout}},
+			move: func(f burlerengine.ParentReviewFiles) error { return burlerengine.MarkParentAskPosted(f, 1) },
+			want: []burlerengine.ParentAskState{burlerengine.ParentAskTimeout},
+		},
+		{
+			name: "expiry before the deadline leaves the ask active",
+			asks: []burlerengine.ParentAsk{open},
+			move: expireAt(parentAskBase),
+			want: []burlerengine.ParentAskState{burlerengine.ParentAskPendingPost},
+		},
+		{
+			name: "expiry at the deadline sets the latest ask timeout",
+			asks: []burlerengine.ParentAsk{{State: burlerengine.ParentAskDone}, open},
+			move: expireAt(parentAskBase.Add(time.Minute)),
+			want: []burlerengine.ParentAskState{burlerengine.ParentAskDone, burlerengine.ParentAskTimeout},
+		},
+		{
+			name: "expiry past the deadline leaves a done ask done",
+			asks: []burlerengine.ParentAsk{{State: burlerengine.ParentAskDone, Deadline: parentAskBase}},
+			move: expireAt(parentAskBase.Add(time.Hour)),
+			want: []burlerengine.ParentAskState{burlerengine.ParentAskDone},
+		},
+		{
+			name: "expiry past the deadline leaves an ask in an unknown state unmoved",
+			asks: []burlerengine.ParentAsk{{State: "future-state", Deadline: parentAskBase}},
+			move: expireAt(parentAskBase.Add(time.Hour)),
+			want: []burlerengine.ParentAskState{"future-state"},
+		},
+		{
+			name: "expiry of a run with no ask writes nothing",
+			move: expireAt(parentAskBase),
+			want: []burlerengine.ParentAskState{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			files := recordParentAsks(t, tt.asks...)
+			if err := tt.move(files); err != nil {
+				t.Fatalf("move error = %v", err)
+			}
+			if got := parentAskStates(t, files); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("ask states = %v; want %v", got, tt.want)
+			}
+			record, found, _ := burlerengine.ReadParentAsks(files)
+			if found != (len(tt.asks) > 0) {
+				t.Errorf("ReadParentAsks() found = %v; want %v", found, len(tt.asks) > 0)
+			}
+			for i, ask := range record.Asks {
+				if ask.Number != i+1 {
+					t.Errorf("ask %d Number = %d; want %d", i, ask.Number, i+1)
+				}
+			}
+		})
+	}
+}
+
+// expireAt returns a move that runs ExpireParentAsk at now.
+func expireAt(now time.Time) func(burlerengine.ParentReviewFiles) error {
+	return func(files burlerengine.ParentReviewFiles) error {
+		_, _, err := burlerengine.ExpireParentAsk(files, now)
+		return err
+	}
+}
+
+// TestAnswerParentAsk verifies an answer writes the report and sets the ask done,
+// and that each refusal names its kind, writes no report and leaves the ask as the refusal says.
+func TestAnswerParentAsk(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	active := burlerengine.ParentAsk{State: burlerengine.ParentAskOpen, Deadline: parentAskBase.Add(time.Minute)}
+	findings := []burlerengine.ParentFinding{
+		{Severity: burlerengine.SeverityMedium, Class: burlerengine.ClassDesign, Change: "name the lock in D5"},
+		{Change: "drop the duplicated bound"},
+	}
+	tests := []struct {
+		name        string
+		asks        []burlerengine.ParentAsk
+		number      int
+		now         time.Time
+		findings    []burlerengine.ParentFinding
+		wantRefusal burlerengine.ParentAnswerRefusalKind
+		wantStates  []burlerengine.ParentAskState
+		wantReport  burlerengine.ParentReport
+	}{
+		{
+			name:       "no findings make a satisfied report",
+			asks:       []burlerengine.ParentAsk{active},
+			number:     1,
+			now:        parentAskBase,
+			wantStates: []burlerengine.ParentAskState{burlerengine.ParentAskDone},
+			wantReport: burlerengine.ParentReport{Ask: 1, Satisfied: true, Findings: []burlerengine.ParentFinding{}},
+		},
+		{
+			name:       "findings are numbered in order and keep their severity and class",
+			asks:       []burlerengine.ParentAsk{{State: burlerengine.ParentAskTimeout}, {State: burlerengine.ParentAskPendingPost, Deadline: parentAskBase.Add(time.Minute)}},
+			number:     2,
+			now:        parentAskBase,
+			findings:   findings,
+			wantStates: []burlerengine.ParentAskState{burlerengine.ParentAskTimeout, burlerengine.ParentAskDone},
+			wantReport: burlerengine.ParentReport{Ask: 2, Findings: []burlerengine.ParentFinding{
+				{ID: "P1", Severity: burlerengine.SeverityMedium, Class: burlerengine.ClassDesign, Change: "name the lock in D5"},
+				{ID: "P2", Change: "drop the duplicated bound"},
+			}},
+		},
+		{name: "a run with no ask is refused", number: 1, now: parentAskBase, wantRefusal: burlerengine.ParentAnswerNoAsk, wantStates: []burlerengine.ParentAskState{}},
+		{
+			name:        "an ask other than the latest is refused",
+			asks:        []burlerengine.ParentAsk{{State: burlerengine.ParentAskTimeout}, active},
+			number:      1,
+			now:         parentAskBase,
+			wantRefusal: burlerengine.ParentAnswerNotLatest,
+			wantStates:  []burlerengine.ParentAskState{burlerengine.ParentAskTimeout, burlerengine.ParentAskOpen},
+		},
+		{
+			name:        "an ended ask is refused",
+			asks:        []burlerengine.ParentAsk{{State: burlerengine.ParentAskNotSent}},
+			number:      1,
+			now:         parentAskBase,
+			wantRefusal: burlerengine.ParentAnswerEnded,
+			wantStates:  []burlerengine.ParentAskState{burlerengine.ParentAskNotSent},
+		},
+		{
+			name:        "an ask in an unknown state past its deadline is refused as ended and left unmoved",
+			asks:        []burlerengine.ParentAsk{{State: "future-state", Deadline: parentAskBase}},
+			number:      1,
+			now:         parentAskBase.Add(time.Minute),
+			wantRefusal: burlerengine.ParentAnswerEnded,
+			wantStates:  []burlerengine.ParentAskState{"future-state"},
+		},
+		{
+			name:        "an ask at its deadline is set timeout and the answer refused",
+			asks:        []burlerengine.ParentAsk{active},
+			number:      1,
+			now:         parentAskBase.Add(time.Minute),
+			wantRefusal: burlerengine.ParentAnswerPastDeadline,
+			wantStates:  []burlerengine.ParentAskState{burlerengine.ParentAskTimeout},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			files := recordParentAsks(t, tt.asks...)
+			ask, err := burlerengine.AnswerParentAsk(files, tt.number, tt.now, tt.findings)
+			if got := parentAskStates(t, files); !reflect.DeepEqual(got, tt.wantStates) {
+				t.Errorf("ask states = %v; want %v", got, tt.wantStates)
+			}
+			if tt.wantRefusal != "" {
+				var refusal *burlerengine.ParentAnswerRefusal
+				if !errors.As(err, &refusal) || refusal.Kind != tt.wantRefusal {
+					t.Fatalf("AnswerParentAsk() error = %v; want a %s refusal", err, tt.wantRefusal)
+				}
+				if _, statErr := os.Stat(files.ReportPath(tt.number)); !errors.Is(statErr, os.ErrNotExist) {
+					t.Errorf("report at %s stat error = %v; want no report", files.ReportPath(tt.number), statErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("AnswerParentAsk() error = %v", err)
+			}
+			if ask.State != burlerengine.ParentAskDone || ask.Report != files.ReportPath(tt.number) || !ask.AnsweredAt.Equal(tt.now) {
+				t.Errorf("AnswerParentAsk() = %+v; want done with report %s answered at %s", ask, files.ReportPath(tt.number), tt.now)
+			}
+			data, err := os.ReadFile(ask.Report)
+			if err != nil {
+				t.Fatalf("read the report: %v", err)
+			}
+			var report burlerengine.ParentReport
+			if err := yaml.Unmarshal(data, &report); err != nil {
+				t.Fatalf("parse the report: %v", err)
+			}
+			if len(report.Findings) == 0 {
+				report.Findings = []burlerengine.ParentFinding{}
+			}
+			if !reflect.DeepEqual(report, tt.wantReport) {
+				t.Errorf("report = %+v; want %+v", report, tt.wantReport)
+			}
+		})
+	}
+}
+
+// TestAnswerParentAsk_FailedWriteAtDeadline verifies a failed record write returns a plain error, not a refusal.
+// The ask at its deadline stays open on disk.
+func TestAnswerParentAsk_FailedWriteAtDeadline(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	if runtime.GOOS == "windows" || os.Geteuid() == 0 {
+		t.Skip("a read-only directory does not block writes on Windows or for root")
+	}
+	files := recordParentAsks(t, burlerengine.ParentAsk{State: burlerengine.ParentAskOpen, Deadline: parentAskBase})
+	if err := os.Chmod(files.Dir, 0o500); err != nil {
+		t.Fatalf("make the record directory read-only: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(files.Dir, 0o700) })
+
+	_, err := burlerengine.AnswerParentAsk(files, 1, parentAskBase.Add(time.Minute), nil)
+	if err == nil {
+		t.Fatal("AnswerParentAsk() error = nil; want the failed record write")
+	}
+	var refusal *burlerengine.ParentAnswerRefusal
+	if errors.As(err, &refusal) {
+		t.Errorf("AnswerParentAsk() error = %v; want a write error, not a refusal", err)
+	}
+	if got, want := parentAskStates(t, files), []burlerengine.ParentAskState{burlerengine.ParentAskOpen}; !reflect.DeepEqual(got, want) {
+		t.Errorf("ask states = %v; want %v", got, want)
+	}
+}
+
+// TestAnswerParentAsk_RacingTheDeadline verifies an answer and an expiry run at once leave exactly one end state.
+// When the expiry wins the answer is refused; when the answer wins the expiry reads it done.
+//
+//testtiming:keep pins that a concurrent answer and expiry leave exactly one end state under the one lock
+func TestAnswerParentAsk_RacingTheDeadline(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	for range 20 {
+		files := recordParentAsks(t, burlerengine.ParentAsk{State: burlerengine.ParentAskOpen, Deadline: parentAskBase})
+		var answerErr, expireErr error
+		var expired burlerengine.ParentAsk
+		var wg sync.WaitGroup
+		wg.Go(func() { _, answerErr = burlerengine.AnswerParentAsk(files, 1, parentAskBase.Add(-time.Second), nil) })
+		wg.Go(func() { expired, _, expireErr = burlerengine.ExpireParentAsk(files, parentAskBase) })
+		wg.Wait()
+		if expireErr != nil {
+			t.Fatalf("ExpireParentAsk() error = %v", expireErr)
+		}
+		switch states := parentAskStates(t, files); {
+		case reflect.DeepEqual(states, []burlerengine.ParentAskState{burlerengine.ParentAskDone}):
+			if answerErr != nil || expired.State != burlerengine.ParentAskDone {
+				t.Errorf("done ask: answer error = %v, expiry read %s; want no error and done", answerErr, expired.State)
+			}
+		case reflect.DeepEqual(states, []burlerengine.ParentAskState{burlerengine.ParentAskTimeout}):
+			var refusal *burlerengine.ParentAnswerRefusal
+			if !errors.As(answerErr, &refusal) || refusal.Kind != burlerengine.ParentAnswerEnded {
+				t.Errorf("timed-out ask: answer error = %v; want an ended refusal", answerErr)
+			}
+		default:
+			t.Fatalf("ask states = %v; want exactly one of done or timeout", states)
+		}
+	}
+}
