+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatalf("mkdir %s: %v", dir, err)
+		}
+	}
+	recordsLink := filepath.Join(backendDir, "_lym")
+	if err := fslink.CreateDirLink(recordsLink, siblingRecordsDir); err != nil {
