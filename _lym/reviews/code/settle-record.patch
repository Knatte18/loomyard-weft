+// capabilities_test.go pins Codex's side of creel's hook delivery that runs no process: the hook-input parse and the hook output that hands mail over.
+
+package codexengine
+
+import (
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
