+}
+
+func buildParts(env SeatEnv) ([]seatengine.Table, error) {
+	cfg, err := loomConfigOf(env)
+	if err != nil {
+		return nil, err
+	}
+	location, err := standInLocation(env)
+	if err != nil {
+		return nil, err
+	}
+	table, err := loomengine.PartsTable(location, env.StencilsDir, env.SpecsDir, cfg, env.Registry)
