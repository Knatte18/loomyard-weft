+		{"engine", row.Engine != ""},
+		{"config", row.Config != nil},
+		{"on_stuck", row.OnStuck != ""},
+		{"on_reroute", row.OnReroute != ""},
+		{"segment", row.Segment != ""},
+		{"max_bounces", row.MaxBounces != 0},
+		{"entry_gate", len(row.EntryGate) > 0},
+	} {
+		if key.set {
+			set = append(set, key.name)
+		}
+	}
+	if len(set) > 0 {
+		keys := strings.Join(set, ", ")
