-	own := groups[p.importPath]
-	if p.table == nil {
-		table, err := p.newBlockTable(own)
-		if err != nil {
-			return err
-		}
-		p.table = table
-	}
-	if run.outcome != "" {
-		return nil
-	}
-	run.covered = testcover.CoveredPositions(own)
-	for importPath, index := range p.indexes {
-		covered, err := index.CoveredFuncs(groups[importPath])
-		if err != nil {
