-				markFixed(n, fixed)
-				switch n := n.(type) {
-				case *ast.IfStmt:
-					conditions[n.Cond] = true
-					add(n.Cond, OperatorNegateCondition, "lymMutantBool", "", nil)
-				case *ast.ForStmt:
-					if n.Cond != nil {
-						conditions[n.Cond] = true
-						add(n.Cond, OperatorNegateCondition, "lymMutantBool", "", nil)
-					}
-				case *ast.BinaryExpr:
-					markConstantIntegerExpression(n, locals, decls, fixed)
