+//go:build tier0
+
+// seam_test.go drives the worktree seam over temporary directories, without git.
+
+package heddleengine
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// seamFixture is a seam over a store holding a claude-file and a codex-file entry.
+type seamFixture struct {
+	renderFixture
+	event fabricengine.WorktreeEvent
+}
+
+func newSeamFixture(t *testing.T) seamFixture {
+	t.Helper()
+	f := newRenderFixture(t, Store{Entries: []Entry{
+		entryFor("claude", "claude text", 1, "claude-file"),
+		entryFor("codex", "codex text", 2, "codex-file"),
+	}})
+	return seamFixture{
+		renderFixture: f,
+		event:         fabricengine.WorktreeEvent{Root: f.root, ScratchDir: f.scratch, BoltDir: f.bolt, Excluded: f.excluded},
+	}
+}
+
+// tookInAfterClearing fires a took-in event over paths after removing both renders, so a file present afterwards was rendered by the event.
+func (f seamFixture) tookInAfterClearing(t *testing.T, paths ...string) {
+	t.Helper()
+	for _, name := range []string{"CLAUDE.local.md", "AGENTS.override.md"} {
+		if err := os.Remove(filepath.Join(f.root, name)); err != nil && !os.IsNotExist(err) {
+			t.Fatal(err)
+		}
+	}
+	event := f.event
+	event.Paths = paths
+	if err := (Seam{}).TookIn(event); err != nil {
+		t.Fatalf("TookIn(%v) = %v", paths, err)
+	}
+}
+
+func TestSeam(t *testing.T) {
+	t.Parallel()
+
+	t.Run("MadeWritesBothFileTargets", func(t *testing.T) {
+		t.Parallel()
+		f := newSeamFixture(t)
+		if err := (Seam{}).Made(f.event); err != nil {
+			t.Fatalf("Made() = %v", err)
+		}
+		if !f.rootHas("CLAUDE.local.md") || !f.rootHas("AGENTS.override.md") {
+			t.Error("Made did not write both file targets")
+		}
+	})
+
+	t.Run("TookInRendersTheTargetsBuiltFromAChangedPath", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name         string
+			paths        []string
+			wantClaude   bool
+			wantOverride bool
+		}{
+			{"AgentsMd", []string{"AGENTS.md"}, true, true},
+			{"UnrelatedPath", []string{"src/x.go"}, false, false},
+			{"ClaudeDirClaudeMd", []string{".claude/CLAUDE.md"}, true, false},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				f := newSeamFixture(t)
+				f.writeRoot(t, "AGENTS.md", "new rules\n")
+				f.tookInAfterClearing(t, tt.paths...)
+				if f.rootHas("CLAUDE.local.md") != tt.wantClaude || f.rootHas("AGENTS.override.md") != tt.wantOverride {
+					t.Errorf("after TookIn(%v): CLAUDE.local.md present = %v, AGENTS.override.md present = %v; want %v and %v",
+						tt.paths, f.rootHas("CLAUDE.local.md"), f.rootHas("AGENTS.override.md"), tt.wantClaude, tt.wantOverride)
+				}
+				if tt.wantOverride && !strings.Contains(f.readRoot(t, "AGENTS.override.md"), "new rules") {
+					t.Errorf("AGENTS.override.md = %q; want it built from the changed AGENTS.md", f.readRoot(t, "AGENTS.override.md"))
+				}
+			})
+		}
+	})
+}
diff --git a/internal/heddleengine/store.go b/internal/heddleengine/store.go
new file mode 100644
index 00000000..4b8f53ac
--- /dev/null
+++ b/internal/heddleengine/store.go
@@ -0,0 +1,313 @@
+// store.go holds heddle.json's in-memory shape, its tolerant JSON encoding, and its load, save and entry edits.
+
+package heddleengine
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"sort"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/fsx"
+)
+
+// FileName is the store's file name at the Bolt checkout's root.
+const FileName = "heddle.json"
+
+// slugRule is the form an entry's slug takes.
+var slugRule = regexp.MustCompile(`^[a-z0-9-]+$`)
+
+// Entry is one instruction text and where it is delivered.
+// Unknown holds the keys this binary does not know, each with its raw JSON value, written back after the known ones in key order.
+type Entry struct {
+	Slug    string
+	Text    string
+	Order   int
+	Targets []string
+	Unknown map[string]json.RawMessage
+}
+
+// entryKeys is the set of JSON keys Entry declares.
+var entryKeys = map[string]bool{"slug": true, "text": true, "order": true, "targets": true}
+
+// entryWire is the known part of Entry's JSON form.
+type entryWire struct {
+	Slug    string   `json:"slug"`
+	Text    string   `json:"text"`
+	Order   int      `json:"order"`
+	Targets []string `json:"targets"`
+}
+
+// MarshalJSON encodes the known keys, then the Unknown ones in key order.
+func (e Entry) MarshalJSON() ([]byte, error) {
+	known := entryWire{Slug: e.Slug, Text: e.Text, Order: e.Order, Targets: e.Targets}
+	if known.Targets == nil {
+		known.Targets = []string{}
+	}
+	object, err := json.Marshal(known)
+	if err != nil {
+		return nil, err
+	}
+	return appendUnknown(object, e.Unknown)
+}
+
+// UnmarshalJSON decodes the known keys and keeps every other key raw.
+func (e *Entry) UnmarshalJSON(data []byte) error {
+	var known entryWire
+	if err := json.Unmarshal(data, &known); err != nil {
+		return err
+	}
+	unknown, err := unknownKeys(data, entryKeys)
+	if err != nil {
+		return err
+	}
+	*e = Entry{Slug: known.Slug, Text: known.Text, Order: known.Order, Targets: known.Targets, Unknown: unknown}
+	return nil
+}
+
+// Store is the content of heddle.json.
+// Unknown holds the top-level keys this binary does not know, kept the way an entry's are.
+type Store struct {
+	Entries []Entry
+	Unknown map[string]json.RawMessage
+}
+
+// storeKeys is the set of JSON keys Store declares.
+var storeKeys = map[string]bool{"entries": true}
+
+// storeWire is the known part of Store's JSON form.
+type storeWire struct {
+	Entries []Entry `json:"entries"`
+}
+
+// MarshalJSON encodes the entries, then the Unknown keys in key order.
+func (s Store) MarshalJSON() ([]byte, error) {
+	known := storeWire{Entries: s.Entries}
+	if known.Entries == nil {
+		known.Entries = []Entry{}
+	}
+	object, err := json.Marshal(known)
+	if err != nil {
+		return nil, err
+	}
+	return appendUnknown(object, s.Unknown)
+}
+
+// UnmarshalJSON decodes the entries and keeps every other top-level key raw.
+func (s *Store) UnmarshalJSON(data []byte) error {
+	var known storeWire
+	if err := json.Unmarshal(data, &known); err != nil {
+		return err
+	}
+	unknown, err := unknownKeys(data, storeKeys)
+	if err != nil {
+		return err
+	}
+	*s = Store{Entries: known.Entries, Unknown: unknown}
+	return nil
+}
+
+// unknownKeys returns the members of the JSON object data whose key is not in known, or nil when there are none.
+func unknownKeys(data []byte, known map[string]bool) (map[string]json.RawMessage, error) {
+	var members map[string]json.RawMessage
+	if err := json.Unmarshal(data, &members); err != nil {
+		return nil, err
+	}
+	var unknown map[string]json.RawMessage
+	for key, value := range members {
+		if known[key] {
+			continue
+		}
+		if unknown == nil {
+			unknown = map[string]json.RawMessage{}
+		}
+		unknown[key] = slices.Clone(value)
+	}
+	return unknown, nil
+}
+
+// appendUnknown writes the unknown members into the encoded JSON object after its known ones, in key order.
+func appendUnknown(object []byte, unknown map[string]json.RawMessage) ([]byte, error) {
+	if len(unknown) == 0 {
+		return object, nil
+	}
+	keys := make([]string, 0, len(unknown))
+	for key := range unknown {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	out := bytes.TrimSuffix(slices.Clone(object), []byte("}"))
+	for _, key := range keys {
+		encodedKey, err := json.Marshal(key)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, ',')
+		out = append(out, encodedKey...)
+		out = append(out, ':')
+		out = append(out, unknown[key]...)
+	}
+	return append(out, '}'), nil
+}
+
+// Decode decodes the bytes of a heddle.json committed in git, empty or whitespace-only bytes being an empty store.
+// Bytes that do not decode are refused with the way forward for a malformed committed blob.
+func Decode(data []byte) (Store, error) {
+	store, err := decodeBytes(data)
+	if err != nil {
+		return Store{}, fmt.Errorf("%s holds malformed JSON: %w; way forward: fix the file with a new commit on the branch that holds this blob", FileName, err)
+	}
+	return store, nil
+}
+
+// decodeBytes decodes data, empty or whitespace-only data being an empty store.
+func decodeBytes(data []byte) (Store, error) {
+	if len(bytes.TrimSpace(data)) == 0 {
+		return Store{}, nil
+	}
+	var store Store
+	if err := json.Unmarshal(data, &store); err != nil {
+		return Store{}, err
+	}
+	return store, nil
+}
+
+// Load reads heddle.json from the Bolt checkout boltDir, an absent file holding no entry.
+// It takes no lock; the caller does.
+func Load(boltDir string) (Store, error) {
+	data, err := os.ReadFile(filepath.Join(boltDir, FileName))
+	if errors.Is(err, os.ErrNotExist) {
+		return Store{}, nil
+	}
+	if err != nil {
+		return Store{}, fmt.Errorf("read %s: %w", FileName, err)
+	}
+	store, err := decodeBytes(data)
+	if err != nil {
+		return Store{}, fmt.Errorf("%s does not decode: %w; way forward: restore the last committed file with `git -C %s checkout HEAD -- %s`, or an earlier commit found with `git -C %s log -- %s`", FileName, err, boltDir, FileName, boltDir, FileName)
+	}
+	return store, nil
+}
+
+// Save writes s as heddle.json in the Bolt checkout boltDir, indented and ending in a newline, atomically.
+// It takes no lock; the caller does.
+func Save(boltDir string, s Store) error {
+	data, err := json.MarshalIndent(s, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encode %s: %w", FileName, err)
+	}
+	return fsx.AtomicWrite(boltDir, FileName, string(data)+"\n")
+}
+
+// Ordered returns the entries by ascending order, a tie broken by slug.
+func (s Store) Ordered() []Entry {
+	ordered := slices.Clone(s.Entries)
+	sort.SliceStable(ordered, func(i, j int) bool {
+		if ordered[i].Order != ordered[j].Order {
+			return ordered[i].Order < ordered[j].Order
+		}
+		return ordered[i].Slug < ordered[j].Slug
+	})
+	return ordered
+}
+
+// Get returns the entry with slug, and false when the store holds none.
+func (s Store) Get(slug string) (Entry, bool) {
+	for _, entry := range s.Entries {
+		if entry.Slug == slug {
+			return entry, true
+		}
+	}
+	return Entry{}, false
+}
+
+// Patch holds the fields of an entry a Set changes; a nil field is left as it is.
+type Patch struct {
+	Text    *string
+	Order   *int
+	Targets []string
+}
+
+// Set updates the entry with slug by the fields p gives, or creates it, which needs all three fields.
+// The result must pass ValidateEntry or nothing changes.
+func (s *Store) Set(slug string, p Patch) error {
+	index := slices.IndexFunc(s.Entries, func(entry Entry) bool { return entry.Slug == slug })
+	candidate := Entry{Slug: slug}
+	if index >= 0 {
+		candidate = s.Entries[index]
+		candidate.Targets = slices.Clone(candidate.Targets)
+	} else if p.Text == nil || p.Order == nil || p.Targets == nil {
+		return fmt.Errorf("entry %q is new, so it needs %s; way forward: give them all in the same call", slug, missingFlags(p))
+	}
+	if p.Text != nil {
+		candidate.Text = *p.Text
+	}
+	if p.Order != nil {
+		candidate.Order = *p.Order
+	}
+	if p.Targets != nil {
+		candidate.Targets = slices.Clone(p.Targets)
+	}
+	if err := ValidateEntry(candidate); err != nil {
+		return err
+	}
+	entries := slices.Clone(s.Entries)
+	if index >= 0 {
+		entries[index] = candidate
+	} else {
+		entries = append(entries, candidate)
+	}
+	s.Entries = entries
+	return nil
+}
+
+// missingFlags names the flags of the fields p leaves unset.
+func missingFlags(p Patch) string {
+	var flags []string
+	if p.Text == nil {
+		flags = append(flags, "--text-file")
+	}
+	if p.Order == nil {
+		flags = append(flags, "--order")
+	}
+	if p.Targets == nil {
+		flags = append(flags, "--targets")
+	}
+	return strings.Join(flags, ", ")
+}
+
+// Remove deletes the entry with slug, and refuses a slug the store does not hold.
+func (s *Store) Remove(slug string) error {
+	index := slices.IndexFunc(s.Entries, func(entry Entry) bool { return entry.Slug == slug })
+	if index < 0 {
+		return fmt.Errorf("no entry %q; way forward: list the entries with `lym heddle list`", slug)
+	}
+	s.Entries = slices.Delete(slices.Clone(s.Entries), index, index+1)
+	return nil
+}
+
+// ValidateEntry refuses an entry that cannot be rendered: a slug off the slug rule, an empty text, no target or a target the table does not hold.
+// Each message names the way forward.
+func ValidateEntry(e Entry) error {
+	if !slugRule.MatchString(e.Slug) {
+		return fmt.Errorf("slug %q is not valid; way forward: use lower-case letters, digits and hyphens only, matching [a-z0-9-]+", e.Slug)
+	}
+	if strings.TrimSpace(e.Text) == "" {
+		return fmt.Errorf("entry %q has an empty text; way forward: give a non-empty --text-file", e.Slug)
+	}
+	if len(e.Targets) == 0 {
+		return fmt.Errorf("entry %q has no target; way forward: give at least one of %s in --targets", e.Slug, strings.Join(TargetNames(), ", "))
+	}
+	for _, name := range e.Targets {
+		if _, ok := LookupTarget(name); !ok {
+			return fmt.Errorf("entry %q names the unknown target %q; way forward: use one of %s", e.Slug, name, strings.Join(TargetNames(), ", "))
+		}
+	}
+	return nil
+}
diff --git a/internal/heddleengine/store_test.go b/internal/heddleengine/store_test.go
new file mode 100644
index 00000000..3d9cae65
--- /dev/null
+++ b/internal/heddleengine/store_test.go
@@ -0,0 +1,219 @@
+//go:build tier0
+
+// store_test.go drives the store through its file contract: load, save, ordering, entry edits and their refusals.
+
+package heddleengine
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// storeWithUnknownKeys is a heddle.json with an unknown top-level key and an unknown key on each of three entries.
+const storeWithUnknownKeys = `{
+  "entries": [
+    {"slug": "a", "text": "first", "order": 1, "targets": ["claude-file"], "extra_a": 1},
+    {"slug": "b", "text": "second", "order": 2, "targets": ["codex-file"], "extra_b": {"k": [1, 2]}},
+    {"slug": "c", "text": "third", "order": 3, "targets": ["claude-prompt"], "extra_c": "x"}
+  ],
+  "top_extra": true
+}`
+
+func writeStoreFile(t *testing.T, dir, content string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(dir, FileName), []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func loadStore(t *testing.T, dir string) Store {
+	t.Helper()
+	store, err := Load(dir)
+	if err != nil {
+		t.Fatalf("Load(%q) = %v", dir, err)
+	}
+	return store
+}
+
+func saveStore(t *testing.T, dir string, store Store) {
+	t.Helper()
+	if err := Save(dir, store); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+}
+
+func textOf(s string) *string { return &s }
+
+func orderOf(n int) *int { return &n }
+
+// assertUnknownKeysKept fails when the store lost the top-level key or an entry's unknown key.
+func assertUnknownKeysKept(t *testing.T, store Store, wantSlugs ...string) {
+	t.Helper()
+	if _, ok := store.Unknown["top_extra"]; !ok {
+		t.Errorf("top-level unknown key lost: %v", store.Unknown)
+	}
+	for _, slug := range wantSlugs {
+		entry, ok := store.Get(slug)
+		if !ok {
+			t.Errorf("entry %q missing", slug)
+			continue
+		}
+		if len(entry.Unknown) != 1 {
+			t.Errorf("entry %q unknown keys = %v; want one", slug, entry.Unknown)
+		}
+	}
+}
+
+func TestStore(t *testing.T) {
+	t.Parallel()
+
+	t.Run("UnknownKeysSurviveEdits", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		writeStoreFile(t, dir, storeWithUnknownKeys)
+
+		store := loadStore(t, dir)
+		if err := store.Set("b", Patch{Text: textOf("second, edited")}); err != nil {
+			t.Fatal(err)
+		}
+		saveStore(t, dir, store)
+		store = loadStore(t, dir)
+		assertUnknownKeysKept(t, store, "a", "b", "c")
+		if got, _ := store.Get("b"); got.Text != "second, edited" {
+			t.Errorf("b.Text = %q; want the edit", got.Text)
+		}
+
+		if err := store.Set("d", Patch{Text: textOf("fourth"), Order: orderOf(4), Targets: []string{"claude-file"}}); err != nil {
+			t.Fatal(err)
+		}
+		saveStore(t, dir, store)
+		store = loadStore(t, dir)
+		assertUnknownKeysKept(t, store, "a", "b", "c")
+
+		if err := store.Remove("a"); err != nil {
+			t.Fatal(err)
+		}
+		saveStore(t, dir, store)
+		store = loadStore(t, dir)
+		assertUnknownKeysKept(t, store, "b", "c")
+		if _, ok := store.Get("a"); ok {
+			t.Error("a still held after Remove")
+		}
+		data, err := os.ReadFile(filepath.Join(dir, FileName))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.HasSuffix(string(data), "}\n") {
+			t.Errorf("saved file does not end in a newline: %q", data)
+		}
+	})
+
+	t.Run("AbsentFileHoldsNoEntry", func(t *testing.T) {
+		t.Parallel()
+		store := loadStore(t, t.TempDir())
+		if got := store.Ordered(); len(got) != 0 {
+			t.Errorf("Ordered() = %v; want none", got)
+		}
+	})
+
+	t.Run("OrderedBreaksTiesBySlug", func(t *testing.T) {
+		t.Parallel()
+		store := Store{Entries: []Entry{
+			{Slug: "z", Order: 1}, {Slug: "m", Order: 2}, {Slug: "a", Order: 2}, {Slug: "k", Order: 0},
+		}}
+		var got []string
+		for _, entry := range store.Ordered() {
+			got = append(got, entry.Slug)
+		}
+		if want := "k z a m"; strings.Join(got, " ") != want {
+			t.Errorf("Ordered() = %v; want %s", got, want)
+		}
+	})
+
+	t.Run("SetRefusals", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name  string
+			slug  string
+			patch Patch
+			want  string
+		}{
+			{"BadSlug", "Bad Slug", Patch{Text: textOf("t"), Order: orderOf(1), Targets: []string{"claude-file"}}, "[a-z0-9-]+"},
+			{"EmptyText", "x", Patch{Text: textOf("  \n"), Order: orderOf(1), Targets: []string{"claude-file"}}, "--text-file"},
+			{"UnknownTarget", "x", Patch{Text: textOf("t"), Order: orderOf(1), Targets: []string{"nope"}}, "claude-file"},
+			{"NewWithoutOrder", "x", Patch{Text: textOf("t"), Targets: []string{"claude-file"}}, "--order"},
+			{"NewWithoutTargets", "x", Patch{Text: textOf("t"), Order: orderOf(1)}, "--targets"},
+			{"ExistingWithEmptyTargets", "a", Patch{Targets: []string{}}, "--targets"},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				dir := t.TempDir()
+				writeStoreFile(t, dir, storeWithUnknownKeys)
+				store := loadStore(t, dir)
+				before := store.Ordered()
+				err := store.Set(tt.slug, tt.patch)
+				if err == nil || !strings.Contains(err.Error(), tt.want) {
+					t.Fatalf("Set(%q) = %v; want an error naming %q", tt.slug, err, tt.want)
+				}
+				if got := store.Ordered(); len(got) != len(before) {
+					t.Errorf("store changed on a refused Set: %v", got)
+				}
+			})
+		}
+	})
+
+	t.Run("RemoveAndGetOfUnknownSlug", func(t *testing.T) {
+		t.Parallel()
+		store := Store{Entries: []Entry{{Slug: "a"}}}
+		if err := store.Remove("nope"); err == nil || !strings.Contains(err.Error(), "lym heddle list") {
+			t.Errorf("Remove(nope) = %v; want an error naming lym heddle list", err)
+		}
+		if _, ok := store.Get("nope"); ok {
+			t.Error("Get(nope) reported the slug held")
+		}
+	})
+
+	t.Run("PartialSetChangesOnlyGivenField", func(t *testing.T) {
+		t.Parallel()
+		store := Store{Entries: []Entry{{Slug: "a", Text: "t", Order: 1, Targets: []string{"claude-file"}}}}
+		if err := store.Set("a", Patch{Order: orderOf(9)}); err != nil {
+			t.Fatal(err)
+		}
+		got, _ := store.Get("a")
+		if got.Order != 9 || got.Text != "t" || len(got.Targets) != 1 || got.Targets[0] != "claude-file" {
+			t.Errorf("entry after partial Set = %+v", got)
+		}
+	})
+
+	t.Run("MalformedBlobFailsDecodeWithBlobWayForward", func(t *testing.T) {
+		t.Parallel()
+		_, err := Decode([]byte(`{"entries": [`))
+		if err == nil {
+			t.Fatal("Decode of malformed JSON succeeded")
+		}
+		if !strings.Contains(err.Error(), "with a new commit") {
+			t.Errorf("Decode error %q lacks a way forward fitting a committed blob", err)
+		}
+		if strings.Contains(err.Error(), "checkout HEAD") || strings.Contains(err.Error(), "<Bolt checkout>") {
+			t.Errorf("Decode error %q carries the Load-only advice", err)
+		}
+	})
+
+	t.Run("MalformedFileFailsLoadWithWayForward", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		writeStoreFile(t, dir, `{"entries": [`)
+		_, err := Load(dir)
+		if err == nil {
+			t.Fatal("Load of malformed JSON succeeded")
+		}
+		for _, want := range []string{FileName, "git -C " + dir + " checkout HEAD -- " + FileName} {
+			if !strings.Contains(err.Error(), want) {
+				t.Errorf("Load error %q lacks %q", err, want)
+			}
+		}
+	})
+}
diff --git a/internal/heddleengine/target.go b/internal/heddleengine/target.go
new file mode 100644
index 00000000..c0176eea
--- /dev/null
+++ b/internal/heddleengine/target.go
@@ -0,0 +1,51 @@
+// target.go holds the target table: the places an entry's text is delivered to.
+
+package heddleengine
+
+import "slices"
+
+// The deliveries a target has.
+const (
+	// DeliveryFile renders the target into a file at a worktree's root.
+	DeliveryFile = "file"
+	// DeliveryPrompt appends the target's passages to a session's system prompt.
+	DeliveryPrompt = "prompt"
+)
+
+// Target is one place an entry's text is delivered to.
+// File is the root-relative path of a file target and empty for a prompt target.
+// ReRender lists the root-relative paths whose change re-renders a file target.
+type Target struct {
+	Name     string
+	Delivery string
+	File     string
+	ReRender []string
+}
+
+// targetTable holds one row per target; a further target is one new row.
+var targetTable = []Target{
+	{Name: "claude-file", Delivery: DeliveryFile, File: "CLAUDE.local.md", ReRender: []string{"CLAUDE.local.md", "AGENTS.md", "CLAUDE.md", ".claude/AGENTS.md", ".claude/CLAUDE.md"}},
+	{Name: "codex-file", Delivery: DeliveryFile, File: "AGENTS.override.md", ReRender: []string{"AGENTS.md", "AGENTS.override.md"}},
+	{Name: "claude-prompt", Delivery: DeliveryPrompt},
+	{Name: "codex-prompt", Delivery: DeliveryPrompt},
+}
+
+// LookupTarget returns the target named name, and false when the table holds none.
+func LookupTarget(name string) (Target, bool) {
+	for _, target := range targetTable {
+		if target.Name == name {
+			target.ReRender = slices.Clone(target.ReRender)
+			return target, true
+		}
+	}
+	return Target{}, false
+}
+
+// TargetNames returns the names of the table's targets in table order.
+func TargetNames() []string {
+	names := make([]string, 0, len(targetTable))
+	for _, target := range targetTable {
+		names = append(names, target.Name)
+	}
+	return names
+}
