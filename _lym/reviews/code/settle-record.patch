+	"github.com/Knatte18/loomyard/internal/parentdirective"
+	"github.com/Knatte18/loomyard/internal/pullrequest"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/stencil"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+)
+
+// prReviewerRole is the agent-name role the PR-Review session's spawn carries.
+const prReviewerRole = "pr-reviewer"
+
+// prReviewStencilName is the registered name of the PR-Review session's opening prompt.
+const prReviewStencilName = "landing-template-pr-review"
+
+// prReviewerSkills are the skills the PR-Review session loads before its prompt.
+var prReviewerSkills = []string{"scribe:prose", "scribe:conversation"}
+
+// prSessions is the seam the PR-Review row starts and stops its interactive session through.
+type prSessions interface {
+	// StartSession starts one unawaited session and returns once its provider is past startup.
+	StartSession(spec shuttleengine.Spec) (shuttleengine.OpenResult, error)
+	// StopStrand ends the strand guid names and records the stop.
+	StopStrand(guid string) error
+}
+
+var _ prSessions = (*shuttleengine.Runner)(nil)
+
+// sessionStartHalt is a session start that failed for a reason that is not transient, which Call turns into a Stuck verdict with Halt.
+type sessionStartHalt struct {
+	cause error
+}
+
+func (h *sessionStartHalt) Error() string {
+	return fmt.Sprintf("the PR-Review session could not be started: %v", h.cause)
+}
+
+func (h *sessionStartHalt) Unwrap() error { return h.cause }
+
+// haltReason is the Stuck reason of the failed start.
+func (h *sessionStartHalt) haltReason() string {
+	return fmt.Sprintf("%s; way forward: run lym loom resume", h.Error())
+}
+
+// ensureSession makes sure the run has a live PR-Review session and returns rec with the session's identity.
+// A recorded strand that is live is reused; a recorded session id whose strand is not live is resumed; with none recorded a new session starts.
+// A transient start failure is an error, and any other is a *sessionStartHalt.
+// A failed registration is logged, since the registration only lets a teardown end the pane process.
+func (p *PRReview) ensureSession(ctx context.Context, rec pullrequest.Record) (pullrequest.Record, error) {
+	pr := p.deps.PullRequest
+	if rec.StrandGUID != "" {
+		live, err := pr.SessionLive(rec.StrandGUID)
+		if err != nil {
+			return rec, fmt.Errorf("landingshed: %s: read whether the PR-Review session is live: %w", p.name, err)
+		}
+		if live {
+			return rec, nil
+		}
+	}
+
+	spec, err := p.sessionSpec(rec)
+	if err != nil {
+		return rec, err
+	}
+	spec.ResumeSessionID = rec.SessionID
+	result, err := pr.Sessions.StartSession(spec)
+	if err != nil {
+		if terr := transientFailure(ctx, p.name, "start the PR-Review session", err); terr != nil {
+			return rec, terr
+		}
+		return rec, &sessionStartHalt{cause: err}
+	}
+	if err := pr.RegisterSession(result.StrandGUID); err != nil {
+		logger.Warn("landingshed: could not register the PR-Review session's process, so a teardown will not end it", "row", p.name, "strand", result.StrandGUID, "cause", err)
+	}
+	rec.StrandGUID, rec.StrandName, rec.SessionID, rec.Engine = result.StrandGUID, result.StrandName, result.SessionID, result.Engine
+	err = p.updateRecord(func(r *pullrequest.Record) {
+		r.StrandGUID, r.StrandName, r.SessionID, r.Engine = rec.StrandGUID, rec.StrandName, rec.SessionID, rec.Engine
+	})
+	if err != nil {
+		// A session the record does not name could never be found again, and the re-entry would start a second one.
+		if stopErr := pr.Sessions.StopStrand(result.StrandGUID); stopErr != nil {
+			logger.Warn("landingshed: could not stop the PR-Review session whose record write failed", "row", p.name, "strand", result.StrandGUID, "cause", stopErr)
+		}
+	}
+	return rec, err
+}
+
+// sessionSpec builds the spec the PR-Review session starts under for the pull request rec records.
+// The prompt carries paths only, never file content.
+func (p *PRReview) sessionSpec(rec pullrequest.Record) (shuttleengine.Spec, error) {
+	parsed, err := modelspec.Parse(p.deps.Config.PRReviewer)
+	if err != nil {
+		return shuttleengine.Spec{}, fmt.Errorf("landingshed: %s: pr_reviewer model-spec: %w", p.name, err)
+	}
+	resolved, err := p.deps.Registry.Resolve(parsed)
+	if err != nil {
+		return shuttleengine.Spec{}, fmt.Errorf("landingshed: %s: pr_reviewer model-spec: %w", p.name, err)
+	}
+
+	template, err := stencilstore.Read(p.deps.StencilsDir, prReviewStencilName)
+	if err != nil {
+		return shuttleengine.Spec{}, fmt.Errorf("landingshed: %s: %w", p.name, err)
+	}
+	directive, err := parentdirective.Directive(p.deps.StencilsDir, p.deps.ParentName, true)
+	if err != nil {
+		return shuttleengine.Spec{}, fmt.Errorf("landingshed: %s: %w", p.name, err)
+	}
+	editDirective, err := editdirective.Directive(p.deps.StencilsDir)
+	if err != nil {
+		return shuttleengine.Spec{}, fmt.Errorf("landingshed: %s: %w", p.name, err)
+	}
+	prompt, err := stencil.Fill(template, map[string]string{
+		"slug":                     p.deps.Slug,
+		"pr_url":                   rec.URL,
+		"task_worktree":            p.deps.WorktreeRoot,
+		"task_branch":              p.deps.TaskBranch,
+		"parent_branch":            p.deps.ParentBranch,
+		"description_path":         p.deps.DescriptionPath,
+		"run_material":             p.runMaterial(),
+		parentdirective.MarkerName: directive,
+		editdirective.MarkerName:   editDirective,
+	})
+	if err != nil {
+		return shuttleengine.Spec{}, fmt.Errorf("landingshed: %s: fill the PR-Review prompt: %w", p.name, err)
+	}
+
+	return shuttleengine.Spec{
+		Prompt:      string(prompt),
+		ModelChoice: shuttleengine.NewModelChoice(resolved),
+		Interactive: true,
+		Unawaited:   true,
+		DenyPublish: true,
+		Role:        prReviewerRole,
+		Segment:     segmentcolor.Landing,
+		Skills:      languageconfig.AppendSkills(prReviewerSkills, p.deps.LanguageSkills),
+	}, nil
+}
+
+// runMaterial lists, one path per line, the decision record, plan directory and board entry snapshot the run has on disk.
+// The stencil needs a non-empty value, so a run with none of them lists that instead.
+func (p *PRReview) runMaterial() string {
+	var lines []string
+	for _, path := range []string{p.deps.DecisionRecordPath, p.deps.PlanDir, p.deps.PullRequest.BoardEntryPath} {
+		if path == "" {
+			continue
+		}
+		if _, err := os.Stat(path); err == nil {
+			lines = append(lines, "- "+path)
+		}
+	}
+	if len(lines) == 0 {
+		return "- none"
+	}
+	return strings.Join(lines, "\n")
+}
+
+// stopLiveSession stops the session rec records when its strand is live, and reports whether it stopped one.
+func (p *PRReview) stopLiveSession(rec pullrequest.Record) (bool, error) {
+	if rec.StrandGUID == "" {
+		return false, nil
+	}
+	pr := p.deps.PullRequest
+	live, err := pr.SessionLive(rec.StrandGUID)
+	if err != nil {
+		return false, fmt.Errorf("landingshed: %s: read whether the PR-Review session is live: %w", p.name, err)
+	}
+	if !live {
+		return false, nil
+	}
+	if err := pr.Sessions.StopStrand(rec.StrandGUID); err != nil {
+		return false, fmt.Errorf("landingshed: %s: stop the PR-Review session: %w", p.name, err)
+	}
+	return true, nil
+}
+
+// stopRecordedSession stops the session the run's record names, and reports whether it stopped one.
+// A run with no record has no session.
+func (p *PRReview) stopRecordedSession() (bool, error) {
+	pr := p.deps.PullRequest
+	rec, found, err := pullrequest.ReadRecord(pr.RecordPath, pr.RecordLockPath)
+	if err != nil {
+		return false, fmt.Errorf("landingshed: %s: read the pull request record: %w", p.name, err)
+	}
+	if !found {
+		return false, nil
+	}
+	return p.stopLiveSession(rec)
+}
+
+// resumeSession brings the session back after a stop that left the review going.
+// A review the operator already ended has no session to bring back.
+func (p *PRReview) resumeSession(ctx context.Context) error {
+	pr := p.deps.PullRequest
+	rec, found, err := pullrequest.ReadRecord(pr.RecordPath, pr.RecordLockPath)
+	if err != nil {
+		return fmt.Errorf("landingshed: %s: read the pull request record: %w", p.name, err)
+	}
+	if !found || rec.ClosedForContinue {
+		return nil
+	}
+	_, err = p.ensureSession(ctx, rec)
+	return err
+}
+
+// endSession stops the session when the call ends with a verdict or a failure of its own, and leaves it running when the context was cancelled, so the re-call after an interrupt finds it live.
+// A failed stop is logged, since the verdict stands whatever it says.
+func (p *PRReview) endSession(ctx context.Context, err error) {
+	if ctx.Err() != nil || errors.Is(err, context.Canceled) {
+		return
+	}
+	if _, stopErr := p.stopRecordedSession(); stopErr != nil {
+		logger.Warn("landingshed: could not stop the PR-Review session at the end of the row", "row", p.name, "cause", stopErr)
+	}
+}
diff --git a/internal/landingshed/pullrequestmode.go b/internal/landingshed/pullrequestmode.go
new file mode 100644
index 00000000..7753c637
--- /dev/null
+++ b/internal/landingshed/pullrequestmode.go
@@ -0,0 +1,124 @@
+// pullrequestmode.go holds ResolvePullRequest, the one decision of whether a landing goes through a pull request.
+
+package landingshed
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/githubclient"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// githubHost is the one host a landing opens a pull request on.
+const githubHost = "github.com"
+
+// Pull-request modes of the receiving branch's beam.yaml and the landing entry's field.
+const (
+	pullRequestOn       = "on"
+	pullRequestOff      = "off"
+	pullRequestRequired = "required"
+)
+
+// Origin holds the facts about the origin a pull request needs.
+type Origin struct {
+	// URL is the task pair's origin remote URL, empty when there is none.
+	URL string
+	// Upstream reports whether the parent branch has an upstream.
+	Upstream bool
+	// PushSkipped reports whether the hub's push skip is set.
+	PushSkipped bool
+}
+
+// PullRequestDecision is the outcome of ResolvePullRequest.
+type PullRequestDecision struct {
+	// Open reports whether the landing goes through a pull request.
+	Open bool
+	// Reason names the values the decision read.
+	Reason string
+	// Halt is a Stuck reason with its way forward, non-empty only when the landing must stop.
+	Halt string
+}
+
+// ResolvePullRequest decides whether a landing goes through a pull request.
+// parentMode is the receiving branch's beam.yaml pull_request (on, off or required) and entryField the landing entry's pull_request (empty, on or off); slug is the landing run's slug.
+// A required parent wants one whatever the field says, an on parent wants one unless the field is off, and an off parent wants one only when the field is on.
+// A field off under a required parent logs one Warn and still wants one.
+// A wanted pull request needs, in this order, an origin on github.com, an origin ParseOwnerRepo accepts, an upstream for the parent and no push skip.
+// A missing fact is a Halt when the parent is required or the field is on, and an origin on github.com that ParseOwnerRepo refuses is always a Halt; any other missing fact under an on parent alone is no pull request, naming the fact.
+// It reads no file: the caller reads the parent's beam.yaml and the entry and tells the values.
+func ResolvePullRequest(slug, parentMode, entryField string, origin Origin) PullRequestDecision {
+	if parentMode == pullRequestRequired && entryField == pullRequestOff {
+		logger.Warn("landingshed: the entry's pull_request is off but the parent's beam.yaml pull_request is required, so a pull request is still required", "slug", slug)
+	}
+
+	field := entryField
+	if field == "" {
+		field = "empty"
+	}
+	wanted := false
+	demand := ""
+	switch {
+	case parentMode == pullRequestRequired:
+		wanted, demand = true, "the parent's beam.yaml pull_request is required"
+	case entryField == pullRequestOn:
+		wanted, demand = true, "the entry's pull_request is on"
+	case parentMode == pullRequestOn && entryField != pullRequestOff:
+		wanted, demand = true, "the parent's beam.yaml pull_request is on"
+	}
+	if !wanted {
+		return PullRequestDecision{Reason: fmt.Sprintf("pull request off: the parent's beam.yaml pull_request is %s and the entry's pull_request is %s", parentMode, field)}
+	}
+
+	owner, repo, missing, alwaysHalt := checkOrigin(origin)
+	if missing == "" {
+		return PullRequestDecision{Open: true, Reason: fmt.Sprintf("pull request on: the parent's beam.yaml pull_request is %s, the entry's pull_request is %s and the origin is %s/%s", parentMode, field, owner, repo)}
+	}
+
+	demanded := parentMode == pullRequestRequired || entryField == pullRequestOn
+	if !demanded && !alwaysHalt {
+		return PullRequestDecision{Reason: fmt.Sprintf("no pull request: the parent's beam.yaml pull_request is on and %s", missing)}
+	}
+	halt := fmt.Sprintf("a pull request is required here (%s) but %s; way forward: give the hub a GitHub origin, an upstream for the parent branch and no push skip, then run lym loom resume", demand, missing)
+	if entryField == pullRequestOn && parentMode != pullRequestRequired {
+		halt += fmt.Sprintf(", or run lym batten cancel %s and start a new run with the entry's pull_request changed", slug)
+	}
+	return PullRequestDecision{Halt: halt}
+}
+
+// checkOrigin returns the origin's owner and repository, or the first missing fact in the order a pull request needs them, or "" when none is missing.
+// alwaysHalt is true for an origin on github.com that ParseOwnerRepo refuses.
+func checkOrigin(origin Origin) (owner, repo, missing string, alwaysHalt bool) {
+	if !strings.EqualFold(originHost(origin.URL), githubHost) {
+		if origin.URL == "" {
+			return "", "", "the task pair has no origin remote", false
+		}
+		return "", "", fmt.Sprintf("the origin %s is not on %s", origin.URL, githubHost), false
+	}
+	owner, repo, err := githubclient.ParseOwnerRepo(origin.URL)
+	if err != nil {
+		return "", "", fmt.Sprintf("the origin %s is on %s but names no repository lym reads: %v", origin.URL, githubHost, err), true
+	}
+	switch {
+	case !origin.Upstream:
+		return "", "", "the parent branch has no upstream", false
+	case origin.PushSkipped:
+		return "", "", "the hub's push skip is set", false
+	}
+	return owner, repo, "", false
+}
+
+// originHost returns the host of a remote URL: the part after any scheme:// and any user-info@, up to the first : or /.
+// The user@host:path scp form gives the part between @ and :, and a local path gives "".
+func originHost(remoteURL string) string {
+	rest := remoteURL
+	if i := strings.Index(rest, "://"); i >= 0 {
+		rest = rest[i+len("://"):]
+	}
+	authority, _, _ := strings.Cut(rest, "/")
+	if i := strings.LastIndex(authority, "@"); i >= 0 {
+		authority = authority[i+1:]
+	}
+	host, _, _ := strings.Cut(authority, ":")
+	return host
+}
diff --git a/internal/landingshed/pullrequestmode_test.go b/internal/landingshed/pullrequestmode_test.go
new file mode 100644
index 00000000..de6a7f42
--- /dev/null
+++ b/internal/landingshed/pullrequestmode_test.go
@@ -0,0 +1,102 @@
+//go:build tier0
+
+// pullrequestmode_test.go covers ResolvePullRequest: the nine mode and field combinations, the warning for an off field under a required parent, and each origin fact that blocks a pull request.
+
+package landingshed
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/logcapture"
+)
+
+// TestResolvePullRequest stays serial: logcapture redirects the process-global logger.
+func TestResolvePullRequest(t *testing.T) {
+	const warnLine = "the entry's pull_request is off but the parent's beam.yaml pull_request is required"
+	githubOrigin := Origin{URL: "https://github.com/o/r.git", Upstream: true}
+
+	t.Run("ModeAndFieldCombinations", func(t *testing.T) {
+		tests := []struct {
+			parent   string
+			field    string
+			wantOpen bool
+		}{
+			{"on", "", true}, {"on", "on", true}, {"on", "off", false},
+			{"off", "", false}, {"off", "on", true}, {"off", "off", false},
+			{"required", "", true}, {"required", "on", true}, {"required", "off", true},
+		}
+		for _, tt := range tests {
+			t.Run(tt.parent+"_"+tt.field, func(t *testing.T) {
+				logs := logcapture.CaptureVerbose(t)
+				got := ResolvePullRequest("slug", tt.parent, tt.field, githubOrigin)
+				if got.Open != tt.wantOpen || got.Halt != "" || got.Reason == "" {
+					t.Errorf("ResolvePullRequest(%q, %q) = %+v; want Open %v, no halt and a reason", tt.parent, tt.field, got, tt.wantOpen)
+				}
+				wantWarn := tt.parent == "required" && tt.field == "off"
+				if gotWarn := strings.Contains(logs.String(), warnLine); gotWarn != wantWarn {
+					t.Errorf("ResolvePullRequest(%q, %q) warned = %v; want %v\n%s", tt.parent, tt.field, gotWarn, wantWarn, logs.String())
+				}
+			})
+		}
+		off := ResolvePullRequest("slug", "off", "", githubOrigin)
+		if want := "pull request off: the parent's beam.yaml pull_request is off and the entry's pull_request is empty"; off.Reason != want {
+			t.Errorf("off reason = %q; want %q", off.Reason, want)
+		}
+	})
+
+	t.Run("Origins", func(t *testing.T) {
+		const haltStart = "a pull request is required here ("
+		const wayForward = "way forward: give the hub a GitHub origin, an upstream for the parent branch and no push skip, then run lym loom resume"
+		const cancelClause = ", or run lym batten cancel slug and start a new run with the entry's pull_request changed"
+		local := Origin{URL: "/srv/hub.git", Upstream: true}
+		tests := []struct {
+			name     string
+			parent   string
+			field    string
+			origin   Origin
+			wantHalt bool
+			// wantIn is a substring the reason, or the halt when one is wanted, holds.
+			wantIn string
+			// wantCancel is whether the halt carries the cancel clause.
+			wantCancel bool
+		}{
+			{"LocalPathUnderOnIsNo", "on", "", local, false, "/srv/hub.git", false},
+			{"LocalPathUnderRequiredHalts", "required", "", local, true, "the parent's beam.yaml pull_request is required", false},
+			{"LocalPathUnderFieldOnHalts", "on", "on", local, true, "the entry's pull_request is on", true},
+			{"LocalPathUnderFieldOnAndOffParentHalts", "off", "on", local, true, "the entry's pull_request is on", true},
+			{"OwnerOnlyHalts", "on", "", Origin{URL: "https://github.com/onlyowner", Upstream: true}, true, "names no repository", false},
+			{"EmptyUserInfoHalts", "on", "", Origin{URL: "https://@github.com/o/r", Upstream: true}, true, "names no repository", false},
+			{"SSHWithPortHalts", "on", "", Origin{URL: "ssh://git@github.com:22/o/r.git", Upstream: true}, true, "names no repository", false},
+			{"GitSchemeHalts", "on", "", Origin{URL: "git://github.com/o/r", Upstream: true}, true, "names no repository", false},
+			{"UpperCaseHostHalts", "on", "", Origin{URL: "https://GitHub.com/o/r", Upstream: true}, true, "names no repository", false},
+			{"OtherHostUnderOnIsNo", "on", "", Origin{URL: "ssh://git@gitlab.com/o/r.git", Upstream: true}, false, "gitlab.com", false},
+			{"NoOriginUnderOnIsNo", "on", "", Origin{Upstream: true}, false, "no origin remote", false},
+			{"NoUpstreamUnderOnIsNo", "on", "", Origin{URL: githubOrigin.URL}, false, "no upstream", false},
+			{"NoUpstreamUnderRequiredHalts", "required", "", Origin{URL: githubOrigin.URL}, true, "no upstream", false},
+			{"PushSkipUnderOnIsNo", "on", "", Origin{URL: githubOrigin.URL, Upstream: true, PushSkipped: true}, false, "push skip", false},
+			{"PushSkipUnderRequiredHalts", "required", "", Origin{URL: githubOrigin.URL, Upstream: true, PushSkipped: true}, true, "push skip", false},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				logcapture.CaptureVerbose(t)
+				got := ResolvePullRequest("slug", tt.parent, tt.field, tt.origin)
+				if got.Open {
+					t.Fatalf("ResolvePullRequest() = %+v; want no pull request", got)
+				}
+				if tt.wantHalt {
+					if !strings.HasPrefix(got.Halt, haltStart) || !strings.Contains(got.Halt, tt.wantIn) || !strings.Contains(got.Halt, wayForward) {
+						t.Errorf("Halt = %q; want it to start %q, hold %q and the way forward", got.Halt, haltStart, tt.wantIn)
+					}
+					if gotCancel := strings.Contains(got.Halt, cancelClause); gotCancel != tt.wantCancel {
+						t.Errorf("Halt = %q; cancel clause present = %v, want %v", got.Halt, gotCancel, tt.wantCancel)
+					}
+					return
+				}
+				if got.Halt != "" || !strings.Contains(got.Reason, tt.wantIn) {
+					t.Errorf("ResolvePullRequest() = %+v; want no halt and a reason holding %q", got, tt.wantIn)
+				}
+			})
+		}
+	})
+}
