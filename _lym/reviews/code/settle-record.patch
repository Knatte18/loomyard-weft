diff --git a/internal/yamlengine/follow.go b/internal/yamlengine/follow.go
new file mode 100644
index 00000000..cd88e629
--- /dev/null
+++ b/internal/yamlengine/follow.go
@@ -0,0 +1,246 @@
+// follow.go carries a template change into an operator-owned file unit by unit, judging each unit against the template the file last followed so a value the operator set is kept.
+
+package yamlengine
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"slices"
+	"sort"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// FollowReport lists, each sorted, what FollowTemplate changed in a file and the operator's values it kept against a template that holds them otherwise.
+type FollowReport struct {
+	// Added lists the dotted path of each template unit the file gained.
+	Added []string
+	// Updated lists, as "<path>: <old> -> <new>", each unit the file held at the base's value and now holds at the template's.
+	Updated []string
+	// Removed lists the dotted path of each unit the file held at the base's value and the template dropped.
+	Removed []string
+	// Differs lists, as "<path>: file <value>, template <value>", each unit the operator set that the template holds otherwise, kept as the file holds it.
+	// A value absent from one side renders as "absent".
+	Differs []string
+}
+
+// Changed reports whether the merge rewrote the file.
+func (r FollowReport) Changed() bool {
+	return len(r.Added)+len(r.Updated)+len(r.Removed) > 0
+}
+
+// ErrInvalidBase marks a FollowTemplate error caused by the base document, one that does not parse or whose top level is not a mapping, as opposed to the template or the file.
+var ErrInvalidBase = errors.New("the template base is not a YAML mapping")
+
+// FollowTemplate carries template into existing, an operator-owned file seeded from an earlier template, and keeps every value the operator set.
+// base is the template the file last followed, and haveBase false says the file has no record of one, so base is not read.
+// A unit is a mapping key, descended into while the file, the template and the base each hold a mapping or nothing there, and otherwise compared whole, so a scalar or a sequence is always one unit.
+// With a base, a unit the file holds as the base does, absence included, takes the template's value, gaining, changing or losing it;
+// any other unit is the operator's and is kept, listed under Differs when the template holds a third value.
+// Without a base, a unit the file lacks is added from the template, one it holds with a value the template holds otherwise is kept and listed under Differs, and one only the file holds is kept silently.
+// A mapping a removal empties is removed with it, and a unit copied in from the template carries none of its comments.
+// An unchanged file comes back byte for byte; a changed one is re-encoded, keeping its comments and each node's style, a long flow mapping on one line, and dropping the blank lines between entries.
+// A document whose top level is not a mapping is an error naming the document, and an error caused by the base wraps ErrInvalidBase.
+func FollowTemplate(base, template, existing []byte, haveBase bool) ([]byte, FollowReport, error) {
+	var baseRoot *yaml.Node
+	if haveBase {
+		var err error
+		_, baseRoot, err = parseMappingRoot(base, "base")
+		if err != nil {
+			return nil, FollowReport{}, fmt.Errorf("%w: %w", ErrInvalidBase, err)
+		}
+	}
+	_, templateRoot, err := parseMappingRoot(template, "template")
+	if err != nil {
+		return nil, FollowReport{}, err
+	}
+	doc, existingRoot, err := parseMappingRoot(existing, "file")
+	if err != nil {
+		return nil, FollowReport{}, err
+	}
+	if existingRoot == nil {
+		existingRoot = &yaml.Node{Kind: yaml.MappingNode, Tag: "!!map"}
+		if doc.Kind != yaml.DocumentNode {
+			doc = &yaml.Node{Kind: yaml.DocumentNode}
+		}
+		doc.Content = append(doc.Content, existingRoot)
+	}
+
+	f := follower{haveBase: haveBase}
+	f.followMapping("", baseRoot, templateRoot, existingRoot)
+	for _, list := range []*[]string{&f.report.Added, &f.report.Updated, &f.report.Removed, &f.report.Differs} {
+		sort.Strings(*list)
+	}
+	if !f.report.Changed() {
+		return existing, f.report, nil
+	}
+
+	var out bytes.Buffer
+	encoder := yaml.NewEncoder(&out)
+	encoder.SetIndent(2)
+	if err := encoder.Encode(doc); err != nil {
+		return nil, FollowReport{}, fmt.Errorf("encode the followed YAML: %w", err)
+	}
+	if err := encoder.Close(); err != nil {
+		return nil, FollowReport{}, fmt.Errorf("encode the followed YAML: %w", err)
+	}
+	return out.Bytes(), f.report, nil
+}
+
+// follower walks one FollowTemplate merge and gathers its report.
+type follower struct {
+	haveBase bool
+	report   FollowReport
+}
+
+// follow returns the value the file holds at path after the merge, nil to leave the key out.
+func (f *follower) follow(path string, base, template, existing *yaml.Node) *yaml.Node {
+	if isMapping(existing) && isMapping(template) && (base == nil || isMapping(base)) {
+		hadEntries := len(existing.Content) > 0
+		f.followMapping(path, base, template, existing)
+		if hadEntries && len(existing.Content) == 0 {
+			return nil
+		}
+		return existing
+	}
+	return f.followUnit(path, base, template, existing)
+}
+
+// followMapping merges the entries of the template and base mappings at path into existing in place, file keys first, then the keys only the template holds in its order.
+// A nil base or template mapping holds no entry.
+func (f *follower) followMapping(path string, base, template, existing *yaml.Node) {
+	keys := mappingKeys(existing)
+	for _, mapping := range []*yaml.Node{template, base} {
+		for _, key := range mappingKeys(mapping) {
+			if !slices.Contains(keys, key) {
+				keys = append(keys, key)
+			}
+		}
+	}
+	for _, key := range keys {
+		_, existingValue := mappingEntry(existing, key)
+		_, baseValue := mappingEntry(base, key)
+		templateKey, templateValue := mappingEntry(template, key)
+		result := f.follow(joinKeyPath(path, key), baseValue, templateValue, existingValue)
+		switch {
+		case result == existingValue:
+		case existingValue == nil:
+			existing.Content = append(existing.Content, copyWithoutComments(templateKey), result)
+		case result == nil:
+			at := mappingIndex(existing, key)
+			existing.Content = slices.Delete(existing.Content, at, at+2)
+		default:
+			existing.Content[mappingIndex(existing, key)+1] = result
+		}
+	}
+}
+
+// followUnit decides one unit compared whole and returns the value the file holds after the merge, nil for absent.
+func (f *follower) followUnit(path string, base, template, existing *yaml.Node) *yaml.Node {
+	if !f.haveBase {
+		switch {
+		case existing == nil && template != nil:
+			f.report.Added = append(f.report.Added, path)
+			return copyWithoutComments(template)
+		case existing != nil && template != nil && !nodesEqual(existing, template):
+			f.differs(path, existing, template)
+		}
+		return existing
+	}
+	if !nodesEqual(existing, base) {
+		if !nodesEqual(template, base) && !nodesEqual(template, existing) {
+			f.differs(path, existing, template)
+		}
+		return existing
+	}
+	switch {
+	case nodesEqual(existing, template):
+		return existing
+	case template == nil:
+		f.report.Removed = append(f.report.Removed, path)
+		return nil
+	case existing == nil:
+		f.report.Added = append(f.report.Added, path)
+		return copyWithoutComments(template)
+	default:
+		f.report.Updated = append(f.report.Updated, fmt.Sprintf("%s: %s -> %s", path, inlineValue(existing), inlineValue(template)))
+		updated := copyWithoutComments(template)
+		updated.HeadComment, updated.LineComment, updated.FootComment = existing.HeadComment, existing.LineComment, existing.FootComment
+		return updated
+	}
+}
+
+// differs records a unit the operator set that the template holds otherwise.
+func (f *follower) differs(path string, existing, template *yaml.Node) {
+	f.report.Differs = append(f.report.Differs, fmt.Sprintf("%s: file %s, template %s", path, inlineValue(existing), inlineValue(template)))
+}
+
+// isMapping reports whether node is a mapping.
+func isMapping(node *yaml.Node) bool {
+	return node != nil && node.Kind == yaml.MappingNode
+}
+
+// mappingKeys returns the keys of mapping in order, none for a nil mapping.
+func mappingKeys(mapping *yaml.Node) []string {
+	if mapping == nil {
+		return nil
+	}
+	keys := make([]string, 0, len(mapping.Content)/2)
+	for i := 0; i+1 < len(mapping.Content); i += 2 {
+		keys = append(keys, mapping.Content[i].Value)
+	}
+	return keys
+}
+
+// mappingEntry returns the key and value nodes of key in mapping, both nil when mapping is nil or lacks key.
+func mappingEntry(mapping *yaml.Node, key string) (keyNode, value *yaml.Node) {
+	if mapping == nil {
+		return nil, nil
+	}
+	at := mappingIndex(mapping, key)
+	if at < 0 {
+		return nil, nil
+	}
+	return mapping.Content[at], mapping.Content[at+1]
+}
+
+// copyWithoutComments returns a deep copy of node with every comment cleared and every style kept.
+func copyWithoutComments(node *yaml.Node) *yaml.Node {
+	clone := deepCopyNode(node)
+	clearComments(clone)
+	return clone
+}
+
+// clearComments clears the comments of node and every node under it.
+func clearComments(node *yaml.Node) {
+	node.HeadComment, node.LineComment, node.FootComment = "", "", ""
+	for _, child := range node.Content {
+		clearComments(child)
+	}
+}
+
+// inlineValue renders node as one line of flow YAML for a report, "absent" for nil.
+func inlineValue(node *yaml.Node) string {
+	if node == nil {
+		return "absent"
+	}
+	flow := copyWithoutComments(node)
+	setFlowStyle(flow)
+	rendered, err := yaml.Marshal(flow)
+	if err != nil {
+		return fmt.Sprintf("<unrenderable %s>", nodeShape(node))
+	}
+	return strings.TrimSpace(string(rendered))
+}
+
+// setFlowStyle sets every mapping and sequence at or under node to flow style.
+func setFlowStyle(node *yaml.Node) {
+	if node.Kind == yaml.MappingNode || node.Kind == yaml.SequenceNode {
+		node.Style = yaml.FlowStyle
+	}
+	for _, child := range node.Content {
+		setFlowStyle(child)
+	}
+}
diff --git a/internal/yamlengine/follow_test.go b/internal/yamlengine/follow_test.go
new file mode 100644
index 00000000..911c3b6c
--- /dev/null
+++ b/internal/yamlengine/follow_test.go
@@ -0,0 +1,185 @@
+// follow_test.go table-drives FollowTemplate: what a file gains, changes and loses against its template base, and the operator values it keeps.
+
+package yamlengine_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/yamlengine"
+)
+
+func TestFollowTemplate(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	const longFlowMapping = "m: {alpha: aaaaaaaaaaaaaaaaaaaa, beta: bbbbbbbbbbbbbbbbbbbb, gamma: cccccccccccccccccccc, delta: dddddddddddddddd}\n"
+	tests := []struct {
+		name     string
+		base     string
+		haveBase bool
+		template string
+		existing string
+		want     string
+		report   yamlengine.FollowReport
+	}{
+		{
+			name:     "a unit at the base's value takes the template's new value and keeps its comments",
+			base:     "a: 1\n",
+			haveBase: true,
+			template: "a: 2\n",
+			existing: "# note\na: 1 # mine\n",
+			want:     "# note\na: 2 # mine\n",
+			report:   yamlengine.FollowReport{Updated: []string{"a: 1 -> 2"}},
+		},
+		{
+			name:     "a unit the template dropped leaves while the file holds the base's value",
+			base:     "p:\n  x: 1\nq: 1\n",
+			haveBase: true,
+			template: "q: 1\n",
+			existing: "p:\n  x: 1\nq: 1\n",
+			want:     "q: 1\n",
+			report:   yamlengine.FollowReport{Removed: []string{"p"}},
+		},
+		{
+			name:     "a removal that empties a mapping removes the mapping",
+			base:     "p:\n  x: 1\nq: 1\n",
+			haveBase: true,
+			template: "p: {}\nq: 1\n",
+			existing: "p:\n  x: 1\nq: 1\n",
+			want:     "q: 1\n",
+			report:   yamlengine.FollowReport{Removed: []string{"p.x"}},
+		},
+		{
+			name:     "a subtree the template added is copied in its style without the template's comments",
+			haveBase: true,
+			template: "# head\nm: {a: 1, b: [x]}\n",
+			existing: "k: v\n",
+			want:     "k: v\nm: {a: 1, b: [x]}\n",
+			report:   yamlengine.FollowReport{Added: []string{"m"}},
+		},
+		{
+			name:     "a key the template added joins a flow mapping the file holds",
+			base:     "p: {a: 1}\n",
+			haveBase: true,
+			template: "p: {a: 1, b: \"\"}\n",
+			existing: "p: {a: 5}\n",
+			want:     "p: {a: 5, b: \"\"}\n",
+			report:   yamlengine.FollowReport{Added: []string{"p.b"}},
+		},
+		{
+			name:     "a value the operator set is kept and listed when the template moved it to a third value",
+			base:     "a: 1\n",
+			haveBase: true,
+			template: "a: 2\n",
+			existing: "a: 3\n",
+			want:     "a: 3\n",
+			report:   yamlengine.FollowReport{Differs: []string{"a: file 3, template 2"}},
+		},
+		{
+			name:     "a value the operator set is kept silently while the template holds the base's value",
+			base:     "a: 1\n",
+			haveBase: true,
+			template: "a: 1\n",
+			existing: "a: 3\n",
+			want:     "a: 3\n",
+		},
+		{
+			name:     "a unit the operator removed stays removed and is listed when the template moved it",
+			base:     "a: 1\nb: 1\n",
+			haveBase: true,
+			template: "a: 2\nb: 1\n",
+			existing: "c: 1\n",
+			want:     "c: 1\n",
+			report:   yamlengine.FollowReport{Differs: []string{"a: file absent, template 2"}},
+		},
+		{
+			name:     "without a base a lacking unit is added, a differing one kept and listed, and an extra one kept silently",
+			template: "a: 1\nb: 2\n",
+			existing: "a: 5\nc: 3\n",
+			want:     "a: 5\nc: 3\nb: 2\n",
+			report:   yamlengine.FollowReport{Added: []string{"b"}, Differs: []string{"a: file 5, template 1"}},
+		},
+		{
+			name:     "a scalar the template turned into a mapping is one unit",
+			base:     "a: 1\n",
+			haveBase: true,
+			template: "a: {x: 1}\n",
+			existing: "a: 1\n",
+			want:     "a: {x: 1}\n",
+			report:   yamlengine.FollowReport{Updated: []string{"a: 1 -> {x: 1}"}},
+		},
+		{
+			name:     "a sequence at the base's value takes the template's new sequence as one unit",
+			base:     "a: [1, 2]\n",
+			haveBase: true,
+			template: "a: [1, 3]\n",
+			existing: "a: [1, 2]\n",
+			want:     "a: [1, 3]\n",
+			report:   yamlengine.FollowReport{Updated: []string{"a: [1, 2] -> [1, 3]"}},
+		},
+		{
+			name:     "a sequence the operator edited is kept whole and listed",
+			base:     "a: [1, 2]\n",
+			haveBase: true,
+			template: "a: [1, 3]\n",
+			existing: "a: [1, 2, 9]\n",
+			want:     "a: [1, 2, 9]\n",
+			report:   yamlengine.FollowReport{Differs: []string{"a: file [1, 2, 9], template [1, 3]"}},
+		},
+		{
+			name:     "a changed file keeps a flow mapping past 80 columns on one line",
+			base:     "a: 1\n",
+			haveBase: true,
+			template: "a: 2\n",
+			existing: "a: 1\n\n" + longFlowMapping,
+			want:     "a: 2\n" + longFlowMapping,
+			report:   yamlengine.FollowReport{Updated: []string{"a: 1 -> 2"}},
+		},
+		{
+			name:     "a base that is not a mapping is not read while the file has no base",
+			base:     "- not\n- a mapping\n",
+			template: "a: 1\n",
+			existing: "a: 1\n",
+			want:     "a: 1\n",
+		},
+		{
+			name:     "an empty file gains the template",
+			template: "a: 1\n",
+			want:     "a: 1\n",
+			report:   yamlengine.FollowReport{Added: []string{"a"}},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, report, err := yamlengine.FollowTemplate([]byte(tt.base), []byte(tt.template), []byte(tt.existing), tt.haveBase)
+			if err != nil {
+				t.Fatalf("FollowTemplate() error = %v; want none", err)
+			}
+			if string(got) != tt.want {
+				t.Errorf("FollowTemplate() = %q; want %q", got, tt.want)
+			}
+			for _, field := range []struct {
+				name      string
+				got, want []string
+			}{
+				{"Added", report.Added, tt.report.Added},
+				{"Updated", report.Updated, tt.report.Updated},
+				{"Removed", report.Removed, tt.report.Removed},
+				{"Differs", report.Differs, tt.report.Differs},
+			} {
+				if !slices.Equal(field.got, field.want) {
+					t.Errorf("FollowTemplate() %s = %q; want %q", field.name, field.got, field.want)
+				}
+			}
+			if wantChanged := tt.want != tt.existing; report.Changed() != wantChanged {
+				t.Errorf("FollowTemplate() Changed = %v; want %v", report.Changed(), wantChanged)
+			}
+		})
+	}
+
+	if _, _, err := yamlengine.FollowTemplate(nil, []byte("a: 1\n"), []byte("- 1\n"), false); err == nil {
+		t.Error("FollowTemplate(a list document) error = nil; want a refusal naming the top level")
+	}
+}
diff --git a/pattern/PATTERN-config-layers.md b/pattern/PATTERN-config-layers.md
index 7b16d13d..9f7a22f1 100644
--- a/pattern/PATTERN-config-layers.md
+++ b/pattern/PATTERN-config-layers.md
@@ -52,6 +52,10 @@ Every other reconcile, the binary-change walk, a clone and `lym fabric reconcile
 A binary older than the one that wrote a key cannot tell a key it never knew from one the template dropped, so an automatic removal would strip a newer binary's settings from the committed board.
 A local override file is pruned of every such key on any reconcile, since its load refuses one.
 
+A seed-only board file's key that its template base, `<module>.template-base` beside it, holds is no such key: the base records that the template held it, so the template dropped it.
+Every reconcile of the board dir removes it while the file holds the base's value, and keeps it as the operator's otherwise.
+A binary older than the base's writer reads that drop the same way, and the newer binary's next walk adds the key back, since the older one wrote its own template as the base.
+
 ## Strictness
 
 `internal/configengine` offers `Load` (strict) and `LoadOrTemplate` (degrades to the embedded template); a caller adopts exactly one, except `runprofile`.
