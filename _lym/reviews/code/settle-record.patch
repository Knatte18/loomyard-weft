-	for worker := range min(sideBySide, len(tests)) {
-		workers.Add(1)
-		go func() {
-			defer workers.Done()
-			profile := filepath.Join(r.tmp, fmt.Sprintf("cover-%d.out", worker))
-			for i := range indexes {
-				runs[i] = r.runTest(p, tests[i], profile)
-				ended <- i
-			}
-		}()
-	}
-	go func() {
-		for i := range tests {
-			indexes <- i
-		}
-		close(indexes)
-		workers.Wait()
-		close(ended)
