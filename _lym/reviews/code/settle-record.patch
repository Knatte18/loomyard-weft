diff --git a/tools/tapestryrename/main.go b/tools/tapestryrename/main.go
new file mode 100644
index 00000000..f35fd9fb
--- /dev/null
+++ b/tools/tapestryrename/main.go
@@ -0,0 +1,132 @@
+// Command tapestryrename renames the loom recipe to tapestry across the repository it is run in.
+// It leaves every other `loom` in place, since those name the general run every recipe shares.
+// It moves the files its move table lists and substitutes the whole tokens its substitution table lists, identifiers, recipe-name values and prose phrases alike, in every file outside its excluded paths.
+// It formats each Go file it changes, since a renamed identifier shifts the alignment gofmt gives its neighbours.
+// It never runs git and never touches a hub's records.
+//
+//	go run ./tools/tapestryrename [-dry-run] [-root <dir>]
+//
+// Run once on 2026-10-31, by the tapestry-rename task.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"go/format"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func main() {
+	dryRun := flag.Bool("dry-run", false, "report what would change without moving or writing files")
+	root := flag.String("root", ".", "the repository root to rename in")
+	flag.Parse()
+
+	moved, err := applyMoves(*root, moves, *dryRun)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "tapestryrename:", err)
+		os.Exit(1)
+	}
+	for _, m := range moved {
+		fmt.Printf("moved: %s -> %s\n", m.from, m.to)
+	}
+
+	changed, err := substituteTree(*root, *dryRun)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "tapestryrename:", err)
+		os.Exit(1)
+	}
+	for _, path := range changed {
+		fmt.Printf("changed: %s\n", path)
+	}
+	fmt.Printf("\n%d moved, %d changed\n", len(moved), len(changed))
+}
+
+// applyMoves renames each listed file under root whose source exists, refusing a move whose target already exists.
+// A move whose source is absent and whose target exists counts as done, so a second run moves nothing.
+// It returns the moves it made, or would make under dryRun.
+func applyMoves(root string, table []move, dryRun bool) ([]move, error) {
+	var done []move
+	for _, m := range table {
+		from := filepath.Join(root, filepath.FromSlash(m.from))
+		to := filepath.Join(root, filepath.FromSlash(m.to))
+		if _, err := os.Stat(from); os.IsNotExist(err) {
+			continue
+		}
+		if _, err := os.Stat(to); err == nil {
+			return done, fmt.Errorf("move %s: the target %s already exists", m.from, m.to)
+		}
+		if !dryRun {
+			if err := os.Rename(from, to); err != nil {
+				return done, err
+			}
+		}
+		done = append(done, m)
+	}
+	return done, nil
+}
+
+// substituteTree runs substitute over every regular file under root outside the excluded paths, formats each Go file it changes, and writes back each file it changes with its mode kept, unless dryRun is set.
+// It returns the slash-separated paths, relative to root, of the files it changed.
+func substituteTree(root string, dryRun bool) ([]string, error) {
+	var changed []string
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		if rel != "." && excluded(rel, entry.IsDir()) {
+			if entry.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !entry.Type().IsRegular() {
+			return nil
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		out := substitute(string(data), substitutionKeys(rel))
+		if strings.HasSuffix(rel, ".go") && out != string(data) {
+			formatted, err := format.Source([]byte(out))
+			if err != nil {
+				return fmt.Errorf("format %s: %w", rel, err)
+			}
+			out = string(formatted)
+		}
+		if out == string(data) {
+			return nil
+		}
+		changed = append(changed, rel)
+		if dryRun {
+			return nil
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		return os.WriteFile(path, []byte(out), info.Mode().Perm())
+	})
+	return changed, err
+}
+
+// excluded reports whether the slash-separated path rel, relative to the root, lies under an excluded path.
+func excluded(rel string, isDir bool) bool {
+	if isDir {
+		rel += "/"
+	}
+	for _, prefix := range excludedPaths {
+		if strings.HasPrefix(rel, prefix) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/tools/tapestryrename/rename_test.go b/tools/tapestryrename/rename_test.go
new file mode 100644
index 00000000..f32c71af
--- /dev/null
+++ b/tools/tapestryrename/rename_test.go
@@ -0,0 +1,126 @@
+//go:build tier0
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// TestSubstitute covers which occurrences of loom the substitution tables rename and which they leave.
+func TestSubstitute(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{"IdentifierAfterPackage", "shedrun.RecipeLoom", "shedrun.RecipeTapestry"},
+		{"IdentifierCamelStart", "NameLoomPreflight", "NameTapestryPreflight"},
+		{"IdentifierCamelEnd", "loomPreflightProducer", "tapestryPreflightProducer"},
+		{"RowName", "running · Loom-Preflight", "running · Tapestry-Preflight"},
+		{"FileName", "loom-recipe.yaml and loompreflight_test.go", "tapestry-recipe.yaml and tapestrypreflight_test.go"},
+		{"Phrase", "a loom run's status", "a tapestry run's status"},
+		{"LongestPhraseWins", "both loom runs", "both tapestry runs"},
+		{"CapitalisedPhrase", "Loom and darn alike", "Tapestry and darn alike"},
+		{"VerbKeepsItsName", "`lym loom run <run-id>`", "`lym loom run <run-id>`"},
+		{"GeneralLoomStays", "loom.yaml, internal/loomcli, lym loom status and the LOOM program", "loom.yaml, internal/loomcli, lym loom status and the LOOM program"},
+		{"PackageNameStays", "loomrecipe.New", "loomrecipe.New"},
+		{"NoTokenInsideAWord", "heirloom run", "heirloom run"},
+		{"PhraseFollowedByAWordStays", "loom running", "loom running"},
+		{"RecipeValueInASeed", `{"recipe":"loom","driver":"go"}`, `{"recipe":"tapestry","driver":"go"}`},
+		{"RecipeValueInAFlag", "lym shed seed self --recipe loom --driver go", "lym shed seed self --recipe tapestry --driver go"},
+		{"RecipeValueInAnArgument", `"seed", "self", "--recipe", "loom", "--driver"`, `"seed", "self", "--recipe", "tapestry", "--driver"`},
+		{"RecipeValueInATableCell", "| `base` | loom |  |", "| `base` | tapestry |  |"},
+		{"ValueKeyCarriesAnIdentifier", `{"loom", RecipeLoom, false}`, `{"tapestry", RecipeTapestry, false}`},
+		{"ConfigModuleStays", `LoadConfig(dirs, "loom") and {"loom": {"code_max_bounces": 1}}`, `LoadConfig(dirs, "loom") and {"loom": {"code_max_bounces": 1}}`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := substitute(tt.in, substitutionKeys("")); got != tt.want {
+				t.Errorf("substitute(%q) = %q; want %q", tt.in, got, tt.want)
+			}
+		})
+	}
+
+	t.Run("PathRuleAppliesInItsFileAloneAndOnce", func(t *testing.T) {
+		t.Parallel()
+		list := "\t\t\t\"LoomPreflight\",\n\t\t\t\"MultiLLM\",\n\t\t\t\"Stub\",\n\t\t\t\"WorktreeCreate\",\n"
+		sorted := "\t\t\t\"MultiLLM\",\n\t\t\t\"Stub\",\n\t\t\t\"TapestryPreflight\",\n\t\t\t\"WorktreeCreate\",\n"
+		keys := substitutionKeys("internal/shedrecipe/registry_test.go")
+		if got := substitute(list, keys); got != sorted {
+			t.Errorf("substitute(registry list) = %q; want %q", got, sorted)
+		}
+		if got := substitute(sorted, keys); got != sorted {
+			t.Errorf("substitute(sorted list) = %q; want it unchanged", got)
+		}
+		if got, want := substitute(list, substitutionKeys("other.go")), "\t\t\t\"TapestryPreflight\",\n\t\t\t\"MultiLLM\",\n\t\t\t\"Stub\",\n\t\t\t\"WorktreeCreate\",\n"; got != want {
+			t.Errorf("substitute(list elsewhere) = %q; want %q", got, want)
+		}
+	})
+}
+
+// TestRenameTree runs the moves and substitutions over a small tree:
+// a listed file moves, a file outside the excluded paths is rewritten, a Go file is formatted after its rename, an excluded one is left, and a second run changes nothing.
+func TestRenameTree(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	write := func(rel, text string) {
+		t.Helper()
+		path := filepath.Join(root, filepath.FromSlash(rel))
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(text), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	read := func(rel string) string {
+		t.Helper()
+		data, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(data)
+	}
+	write("contracts/recipes/loom-recipe.yaml", "# the loom recipe\n")
+	write("internal/x/x.go", "package x\n\nconst (\n\tRecipeLoom = 1\n\tOther      = 2\n)\n")
+	write("docs/research/report.md", "a loom run\n")
+
+	moved, err := applyMoves(root, moves, false)
+	if err != nil {
+		t.Fatalf("applyMoves() error = %v", err)
+	}
+	if want := []move{moves[0]}; !slices.Equal(moved, want) {
+		t.Errorf("applyMoves() = %v; want %v", moved, want)
+	}
+	changed, err := substituteTree(root, false)
+	if err != nil {
+		t.Fatalf("substituteTree() error = %v", err)
+	}
+	if want := []string{"contracts/recipes/tapestry-recipe.yaml", "internal/x/x.go"}; !slices.Equal(changed, want) {
+		t.Errorf("substituteTree() = %v; want %v", changed, want)
+	}
+	if got, want := read("contracts/recipes/tapestry-recipe.yaml"), "# the tapestry recipe\n"; got != want {
+		t.Errorf("moved recipe = %q; want %q", got, want)
+	}
+	if got, want := read("internal/x/x.go"), "package x\n\nconst (\n\tRecipeTapestry = 1\n\tOther          = 2\n)\n"; got != want {
+		t.Errorf("x.go = %q; want %q", got, want)
+	}
+	if got, want := read("docs/research/report.md"), "a loom run\n"; got != want {
+		t.Errorf("excluded report = %q; want %q", got, want)
+	}
+
+	moved, err = applyMoves(root, moves, false)
+	if err != nil || len(moved) != 0 {
+		t.Errorf("second applyMoves() = %v, %v; want nothing moved", moved, err)
+	}
+	changed, err = substituteTree(root, false)
+	if err != nil || len(changed) != 0 {
+		t.Errorf("second substituteTree() = %v, %v; want nothing changed", changed, err)
+	}
+}
diff --git a/tools/tapestryrename/tables.go b/tools/tapestryrename/tables.go
new file mode 100644
index 00000000..90bcbafb
--- /dev/null
+++ b/tools/tapestryrename/tables.go
@@ -0,0 +1,196 @@
+// tables.go holds the rename as data: the file moves, the token substitutions and the excluded paths.
+// It also holds substitute, which applies the substitution table to one file's text.
+
+package main
+
+import "strings"
+
+// move is one file rename, both paths slash-separated and relative to the repository root.
+type move struct {
+	from string
+	to   string
+}
+
+// moves lists the files whose names say loom for the tapestry recipe.
+var moves = []move{
+	{"contracts/recipes/loom-recipe.yaml", "contracts/recipes/tapestry-recipe.yaml"},
+	{"internal/loomshed/loompreflight.go", "internal/loomshed/tapestrypreflight.go"},
+	{"internal/loomshed/loompreflight_test.go", "internal/loomshed/tapestrypreflight_test.go"},
+}
+
+// identifierSubstitutions maps each identifier or file-name token that names the tapestry recipe onto its new spelling, case exact.
+var identifierSubstitutions = map[string]string{
+	"RecipeLoom":      "RecipeTapestry",
+	"LoomRecipe":      "TapestryRecipe",
+	"loom-recipe":     "tapestry-recipe",
+	"LoomRetiredRows": "TapestryRetiredRows",
+	"Loom-Preflight":  "Tapestry-Preflight",
+	"LoomPreflight":   "TapestryPreflight",
+	"loomPreflight":   "tapestryPreflight",
+	"loompreflight":   "tapestrypreflight",
+}
+
+// phraseSubstitutions maps each prose phrase that says loom for the tapestry recipe onto its new wording, written in lower case;
+// substitute also applies each with its first letter upper-cased.
+var phraseSubstitutions = map[string]string{
+	"loom run":      "tapestry run",
+	"loom runs":     "tapestry runs",
+	"loom recipe":   "tapestry recipe",
+	"loom recipes":  "tapestry recipes",
+	"loom task":     "tapestry task",
+	"loom tasks":    "tapestry tasks",
+	"loom and darn": "tapestry and darn",
+	"loom or darn":  "tapestry or darn",
+	"loom, darn":    "tapestry, darn",
+	"darn and loom": "darn and tapestry",
+	"darn or loom":  "darn or tapestry",
+}
+
+// valueSubstitutions maps each fragment that spells the tapestry recipe's name as the value `loom` onto its new spelling, case exact.
+// Each fragment carries the context that tells the recipe name from the `loom` config module, which keeps its name:
+// a seed's `recipe` key, a `--recipe` flag, a board task's recipe, a run profile's recipe block, or a test helper or table that takes a recipe.
+var valueSubstitutions = map[string]string{
+	`--recipe loom`:                                      `--recipe tapestry`,
+	`"--recipe", "loom"`:                                 `"--recipe", "tapestry"`,
+	`"recipe":"loom"`:                                    `"recipe":"tapestry"`,
+	`task["recipe"] != "loom"`:                           `task["recipe"] != "tapestry"`,
+	`want [bug]/loom`:                                    `want [bug]/tapestry`,
+	`Recipe: "loom"`:                                     `Recipe: "tapestry"`,
+	`seed.Recipe != "loom"`:                              `seed.Recipe != "tapestry"`,
+	`seed.Recipe, "loom")`:                               `seed.Recipe, "tapestry")`,
+	`seeded with recipe "loom"`:                          `seeded with recipe "tapestry"`,
+	`seedText("loom")`:                                   `seedText("tapestry")`,
+	`seedBoardTask(t, h, slug, "loom")`:                  `seedBoardTask(t, h, slug, "tapestry")`,
+	`seedBoardTask(t, h, "b", "loom")`:                   `seedBoardTask(t, h, "b", "tapestry")`,
+	`newSeedChildDeps("loom"`:                            `newSeedChildDeps("tapestry"`,
+	`typeAtWiring: "loom"`:                               `typeAtWiring: "tapestry"`,
+	`wantRecipe:  "loom"`:                                `wantRecipe:  "tapestry"`,
+	`"some-slug", "loom"`:                                `"some-slug", "tapestry"`,
+	`seedRecipe("loom")`:                                 `seedRecipe("tapestry")`,
+	`recipes["loom"]`:                                    `recipes["tapestry"]`,
+	`"step", "loom", "run"`:                              `"step", "tapestry", "run"`,
+	`{"loom", loomcli.BootstrapVerb`:                     `{"tapestry", loomcli.BootstrapVerb`,
+	`{"batten", "darn", "loom", "pawl"}`:                 `{"batten", "darn", "pawl", "tapestry"}`,
+	`exactly batten, darn, loom and pawl`:                `exactly batten, darn, pawl and tapestry`,
+	`{"loom", RecipeLoom`:                                `{"tapestry", RecipeTapestry`,
+	`{RecipeBatten, RecipeDarn, RecipeLoom, RecipePawl}`: `{RecipeBatten, RecipeDarn, RecipePawl, RecipeTapestry}`,
+	`recipe = "loom"`:                                    `recipe = "tapestry"`,
+	`{"loom": 2, "darn": 1}`:                             `{"tapestry": 2, "darn": 1}`,
+	`"loom %d"`:                                          `"tapestry %d"`,
+	`| loom |`:                                           `| tapestry |`,
+	`{"loom": "solid"`:                                   `{"tapestry": "solid"`,
+	`"light:\n  loom:\n    loom: {plan_max_bounces: 1, code_max_bounces: 1, merge_max_bounces: 1}`: `"light:\n  tapestry:\n    loom: {plan_max_bounces: 1, code_max_bounces: 1, merge_max_bounces: 1}`,
+	`lie over the loom block`:                            `lie over the tapestry block`,
+	"`\"docs\"`, \"no loom block\"":                      "`\"docs\"`, \"no tapestry block\"",
+	`1, 0, []string{"loom"}}`:                            `1, 0, []string{"tapestry"}}`,
+	`[]string{"loom", "darn", "pawl"}`:                   `[]string{"tapestry", "darn", "pawl"}`,
+	`loom, err := profiles.Settings(tt.profile, "loom")`: `tapestry, err := profiles.Settings(tt.profile, "tapestry")`,
+	`keys := loom["loom"]`:                               `keys := tapestry["loom"]`,
+	`{"loom": loom["loom"]`:                              `{"tapestry": tapestry["loom"]`,
+	`profiles.Settings("docs", "loom")`:                  `profiles.Settings("docs", "tapestry")`,
+	`Settings(docs, loom) error = nil; want a refusal for the missing loom block`: `Settings(docs, tapestry) error = nil; want a refusal for the missing tapestry block`,
+	`"docs", "loom", []string{`: `"docs", "tapestry", []string{`,
+	`profiles.Default("loom")`:  `profiles.Default("tapestry")`,
+}
+
+// pathSubstitutions maps a slash-separated path, relative to the root, onto substitutions that apply in that file alone.
+// Each keeps a sorted list sorted once a name in it is renamed.
+var pathSubstitutions = map[string]map[string]string{
+	"internal/shedrecipe/registry_test.go": {
+		"\t\t\t\"LoomPreflight\",\n\t\t\t\"MultiLLM\",\n": "\t\t\t\"MultiLLM\",\n",
+		"\t\t\t\"Stub\",\n\t\t\t\"WorktreeCreate\",\n":    "\t\t\t\"Stub\",\n\t\t\t\"TapestryPreflight\",\n\t\t\t\"WorktreeCreate\",\n",
+	},
+}
+
+// excludedPaths lists the slash-separated path prefixes substitute never reads.
+// They are version control and run records, the measurement reports that record past runs, this program and the earlier rename program, whose texts describe their own runs, and the archived README.
+var excludedPaths = []string{
+	".git/",
+	"_lym/",
+	".lym/",
+	"docs/research/",
+	"tools/tapestryrename/",
+	"tools/wordswap/",
+	"README.old.md",
+}
+
+// substitute replaces in text every whole-token occurrence of a key of keys with its value, longest key first at each position.
+// A token starts at the start of the text, after a byte that is no ASCII letter or digit, or anywhere for a key that starts with no lower-case letter: the camelCase start.
+// A token ends at the end of the text, before a byte that is no ASCII letter or digit, before an upper-case letter, or anywhere for a key that ends with no letter or digit.
+// No key starts right after `lym `, so a verb such as `lym loom run` keeps its name.
+// The output is never re-scanned, so a replacement is never matched again.
+func substitute(text string, keys map[string]string) string {
+	var out strings.Builder
+	for i := 0; i < len(text); {
+		key, ok := matchAt(text, i, keys)
+		if !ok {
+			out.WriteByte(text[i])
+			i++
+			continue
+		}
+		out.WriteString(keys[key])
+		i += len(key)
+	}
+	return out.String()
+}
+
+// substitutionKeys merges the tables that apply to the file at the slash-separated path rel:
+// the identifier and value tables, every phrase in its lower and its capitalised form, and the path's own table.
+func substitutionKeys(rel string) map[string]string {
+	keys := map[string]string{}
+	for _, table := range []map[string]string{identifierSubstitutions, valueSubstitutions, pathSubstitutions[rel]} {
+		for from, to := range table {
+			keys[from] = to
+		}
+	}
+	for from, to := range phraseSubstitutions {
+		keys[from] = to
+		keys[capitalise(from)] = capitalise(to)
+	}
+	return keys
+}
+
+// matchAt returns the longest key that occurs in text at i as a whole token.
+func matchAt(text string, i int, keys map[string]string) (string, bool) {
+	best := ""
+	for key := range keys {
+		if len(key) <= len(best) || !strings.HasPrefix(text[i:], key) {
+			continue
+		}
+		if !tokenStart(text, i, key) || !tokenEnd(text, i+len(key), key) {
+			continue
+		}
+		best = key
+	}
+	return best, best != ""
+}
+
+// tokenStart reports whether key may start a token at i in text.
+func tokenStart(text string, i int, key string) bool {
+	if strings.HasSuffix(text[:i], "lym ") {
+		return false
+	}
+	return i == 0 || !isAlphanumeric(text[i-1]) || !isLower(key[0])
+}
+
+// tokenEnd reports whether key may end a token at end in text.
+func tokenEnd(text string, end int, key string) bool {
+	return !isAlphanumeric(key[len(key)-1]) || end == len(text) || !isAlphanumeric(text[end]) || isUpper(text[end])
+}
+
+// capitalise upper-cases the first byte of s, an ASCII letter.
+func capitalise(s string) string {
+	return strings.ToUpper(s[:1]) + s[1:]
+}
+
+func isAlphanumeric(b byte) bool {
+	return isUpper(b) || isLower(b) || (b >= '0' && b <= '9')
+}
+
+func isUpper(b byte) bool {
+	return b >= 'A' && b <= 'Z'
+}
+
+func isLower(b byte) bool {
+	return b >= 'a' && b <= 'z'
+}
