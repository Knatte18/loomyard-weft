diff --git a/internal/testreach/fresh.go b/internal/testreach/fresh.go
new file mode 100644
index 00000000..412cfbeb
--- /dev/null
+++ b/internal/testreach/fresh.go
@@ -0,0 +1,118 @@
+// fresh.go compares a coverage map's recorded file hashes with the files on disk.
+
+package testreach
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"maps"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+)
+
+// Fresh reports whether the hashes the map m of the package pkg records match the worktree's files under module.Dir.
+// pkg is a module-relative slash path.
+// The map's Files and OtherFiles are compared with the package's files.
+// Each Linked package's hashes are compared with that package's files.
+// Each file is hashed by testcover.ContentHash.
+// A file on one side alone makes the map stale.
+// It reads the disk only.
+func Fresh(module Module, pkg string, m testcover.Map) (bool, error) {
+	onDisk, err := diskPackageHashes(module, pkg)
+	if err != nil {
+		return false, err
+	}
+	recorded := make(map[string]string, len(m.Files)+len(m.OtherFiles))
+	maps.Copy(recorded, m.Files)
+	maps.Copy(recorded, m.OtherFiles)
+	if !maps.Equal(onDisk, recorded) {
+		return false, nil
+	}
+	for linked, hashes := range m.Linked {
+		rel, inModule := relativePackage(module, linked)
+		if !inModule {
+			return false, nil
+		}
+		linkedOnDisk, err := diskPackageHashes(module, rel)
+		if err != nil {
+			return false, err
+		}
+		if !maps.Equal(linkedOnDisk, hashes) {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+// importPathOf returns the import path of the package at the module-relative slash path pkg.
+func importPathOf(module Module, pkg string) string {
+	if pkg == "." {
+		return module.Path
+	}
+	return module.Path + "/" + pkg
+}
+
+// relativePackage returns the module-relative slash path of the package at importPath, false for one outside the module.
+func relativePackage(module Module, importPath string) (string, bool) {
+	if importPath == module.Path {
+		return ".", true
+	}
+	return strings.CutPrefix(importPath, module.Path+"/")
+}
+
+// diskPackageHashes returns the ContentHash of each file that the package at the module-relative slash path pkg owns.
+// The result is keyed by slash path relative to the package directory.
+// The package owns every file under its directory down to the next package directory or nested module.
+// An absent directory owns none.
+func diskPackageHashes(module Module, pkg string) (map[string]string, error) {
+	dir := filepath.Join(module.Dir, filepath.FromSlash(pkg))
+	var files []string
+	err := filepath.WalkDir(dir, func(file string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			if errors.Is(err, fs.ErrNotExist) {
+				return nil
+			}
+			return err
+		}
+		if !entry.Type().IsRegular() {
+			return nil
+		}
+		rel, err := filepath.Rel(dir, file)
+		if err != nil {
+			return err
+		}
+		files = append(files, filepath.ToSlash(rel))
+		return nil
+	})
+	if err != nil {
+		return nil, fmt.Errorf("list the files of %s: %w", pkg, err)
+	}
+	nested := testcover.NestedPackageDirs(files)
+	hashes := map[string]string{}
+	for _, rel := range files {
+		if slices.ContainsFunc(nested, func(nestedDir string) bool { return strings.HasPrefix(rel, nestedDir+"/") }) {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(rel)))
+		if err != nil {
+			return nil, fmt.Errorf("read %s of %s: %w", path.Base(rel), pkg, err)
+		}
+		hashes[rel] = testcover.ContentHash(data)
+	}
+	return hashes, nil
+}
+
+// digestHashes returns one digest of a file-hash table, independent of the table's order.
+func digestHashes(hashes map[string]string) string {
+	var lines strings.Builder
+	for _, name := range slices.Sorted(maps.Keys(hashes)) {
+		fmt.Fprintf(&lines, "%s=%s\n", name, hashes[name])
+	}
+	return testcover.ContentHash([]byte(lines.String()))
+}
diff --git a/internal/testreach/index.go b/internal/testreach/index.go
new file mode 100644
index 00000000..011db78d
--- /dev/null
+++ b/internal/testreach/index.go
@@ -0,0 +1,146 @@
+// index.go declares the index file of the shared coverage maps and the stamp that says whether it is current.
+
+package testreach
+
+import (
+	"cmp"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/testcover"
+)
+
+// indexFileName is the file name of the index beside the shared maps.
+const indexFileName = "index.json"
+
+// indexVersion is the shape of the index file; an index of another shape is read as absent.
+const indexVersion = 1
+
+// indexFile is the reverse table of the shared maps, from each function to the tests that reach it, as a cache file.
+type indexFile struct {
+	Version int `json:"version"`
+	// Stamp is the directoryStamp of the maps directory the table was built from.
+	Stamp string `json:"stamp"`
+	// Packages holds what the reader needs of each map but its tests, by module-relative package.
+	Packages map[string]packageInfo `json:"packages"`
+	Reaches  []funcReaches          `json:"reaches"`
+}
+
+// funcReaches is the tests of the shared maps that reach one function.
+type funcReaches struct {
+	Func  testcover.FuncKey `json:"func"`
+	Tests []reachEntry      `json:"tests"`
+}
+
+// packageInfo is what the reader keeps of one package's map besides its reach entries.
+type packageInfo struct {
+	Commit  string    `json:"commit"`
+	BuiltAt time.Time `json:"built_at"`
+	// SpawnMarked is set when an entry of the map has a spawn verdict that marks it out of process or unresolved.
+	SpawnMarked bool `json:"spawn_marked,omitempty"`
+	// LinkedDigests maps each linked package's import path to the digestHashes of the file hashes the map recorded for it.
+	LinkedDigests map[string]string `json:"linked_digests,omitempty"`
+	// Worktree is set for a map read from the worktree's own maps; it is never stored.
+	Worktree bool `json:"-"`
+}
+
+// reachEntry is one test that reaches a function, with the map it came from.
+type reachEntry struct {
+	// MapPackage is the module-relative package whose map holds the test.
+	MapPackage string `json:"map_package"`
+	// Package is the import path of the test's package.
+	Package string `json:"package"`
+	Test    string `json:"test"`
+	// Funcs is how many functions the test's entry reaches, own and linked together.
+	Funcs int `json:"funcs"`
+}
+
+// mapTable is the reverse table of a set of maps and the facts kept per package.
+type mapTable struct {
+	Packages map[string]packageInfo
+	Reaches  map[testcover.FuncKey][]reachEntry
+}
+
+// WriteIndex writes the index of the shared coverage maps of module in sharedDir, beside the maps.
+// It builds the reverse table from the maps as Open builds it, and stamps it with the directory's stamp.
+// The stamp is read before the maps, so a map rewritten meanwhile makes the next Open ignore the index.
+// Bound: a map rewritten at the same size within one modification-time tick keeps its stamp.
+// Open can then serve the index's old pairs until the next WriteIndex.
+// A failed write returns an error naming the index path; the index is a cache, so no reader depends on it.
+func WriteIndex(module Module, sharedDir string) error {
+	stamp, err := directoryStamp(sharedDir)
+	if err != nil {
+		return err
+	}
+	coverageMaps, err := readMapDir(sharedDir)
+	if err != nil {
+		return err
+	}
+	table := buildTable(module, coverageMaps, false)
+	index := indexFile{Version: indexVersion, Stamp: stamp, Packages: table.Packages}
+	for fn, tests := range table.Reaches {
+		slices.SortFunc(tests, func(a, b reachEntry) int {
+			return cmp.Or(strings.Compare(a.MapPackage, b.MapPackage), strings.Compare(a.Test, b.Test))
+		})
+		index.Reaches = append(index.Reaches, funcReaches{Func: fn, Tests: tests})
+	}
+	slices.SortFunc(index.Reaches, func(a, b funcReaches) int { return testcover.CompareFuncKeys(a.Func, b.Func) })
+	path := indexPath(sharedDir)
+	if err := state.WriteJSON(path, lock.TrackedFileLockPath(path, ".lock"), index); err != nil {
+		return fmt.Errorf("write the index %s: %w", path, err)
+	}
+	return nil
+}
+
+// indexPath returns the path of the index file beside the maps in dir.
+func indexPath(dir string) string {
+	return filepath.Join(dir, indexFileName)
+}
+
+// readIndex reads the index beside the maps in dir.
+// It reports false for an index that is absent, does not parse or has another version;
+// the index is a cache, so none of those stops the reader.
+func readIndex(dir string) (indexFile, bool) {
+	// The read takes no lock, since WriteIndex replaces the file atomically; a lock file would be written beside the maps.
+	data, err := os.ReadFile(indexPath(dir))
+	if err != nil {
+		return indexFile{}, false
+	}
+	var index indexFile
+	if err := json.Unmarshal(data, &index); err != nil || index.Version != indexVersion {
+		return indexFile{}, false
+	}
+	return index, true
+}
+
+// directoryStamp returns a text that changes when a map file is added to or removed from the maps directory dir.
+// The text also changes when a map file changes its size or modification time.
+// An absent directory has the stamp of one with no map.
+func directoryStamp(dir string) (string, error) {
+	packages, err := mapFilePackages(dir)
+	if err != nil {
+		return "", err
+	}
+	lines := make([]string, 0, len(packages))
+	for _, pkg := range packages {
+		info, err := os.Stat(testcover.MapPath(dir, pkg))
+		if errors.Is(err, fs.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return "", fmt.Errorf("stamp the coverage map of %s: %w", pkg, err)
+		}
+		lines = append(lines, fmt.Sprintf("%s|%d|%d", pkg, info.Size(), info.ModTime().UnixNano()))
+	}
+	slices.Sort(lines)
+	return testcover.ContentHash([]byte(strings.Join(lines, "\n"))), nil
+}
diff --git a/internal/testreach/mapread.go b/internal/testreach/mapread.go
new file mode 100644
index 00000000..281cd2f8
--- /dev/null
+++ b/internal/testreach/mapread.go
@@ -0,0 +1,100 @@
+// mapread.go reads the coverage maps of one maps directory, passing over a map no reader can use.
+
+package testreach
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"path/filepath"
+	"slices"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/testcover"
+)
+
+// rebuildHint is the way forward the reader names for a coverage map it cannot use.
+const rebuildHint = "rebuild it with `lym gate test --map` from the prime"
+
+// ReadPackageMap reads the coverage map of the package pkg, a module-relative slash path, from the maps directory dir.
+// It reports false for a package with no map.
+// It also reports false for a map that holds only a build failure.
+// It reports false as well for a map whose tests name a block or function outside its tables.
+// A map file that does not parse is an error naming the package and the way forward.
+func ReadPackageMap(dir, pkg string) (testcover.Map, bool, error) {
+	m, found, err := testcover.ReadMap(dir, pkg)
+	if err != nil {
+		return testcover.Map{}, false, fmt.Errorf("read the coverage map of %s: %w; %s", pkg, err, rebuildHint)
+	}
+	if !found || m.BuildFailure != "" || !indexesInTables(m) {
+		return testcover.Map{}, false, nil
+	}
+	return m, true, nil
+}
+
+// indexesInTables reports whether every block and function index of m's tests lies inside m's tables.
+func indexesInTables(m testcover.Map) bool {
+	for _, test := range m.Tests {
+		for _, i := range test.Blocks {
+			if i < 0 || i >= len(m.Blocks) {
+				return false
+			}
+		}
+		for _, i := range test.Funcs {
+			if i < 0 || i >= len(m.Funcs) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// mapFilePackages returns the module-relative slash path of each package that has a map file under dir, sorted.
+// An absent directory holds none.
+func mapFilePackages(dir string) ([]string, error) {
+	var packages []string
+	mapFileName := filepath.Base(testcover.MapPath(".", "."))
+	err := filepath.WalkDir(dir, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			if errors.Is(err, fs.ErrNotExist) {
+				return nil
+			}
+			return err
+		}
+		if entry.IsDir() || entry.Name() != mapFileName {
+			return nil
+		}
+		rel, err := filepath.Rel(dir, filepath.Dir(path))
+		if err != nil {
+			return err
+		}
+		packages = append(packages, filepath.ToSlash(rel))
+		return nil
+	})
+	if err != nil {
+		return nil, fmt.Errorf("list the coverage maps under %s: %w", dir, err)
+	}
+	slices.Sort(packages)
+	return packages, nil
+}
+
+// readMapDir reads every usable map under the maps directory dir, by module-relative package.
+// A map that does not parse is logged and left out, so one corrupt map never stops the others from answering.
+func readMapDir(dir string) (map[string]testcover.Map, error) {
+	packages, err := mapFilePackages(dir)
+	if err != nil {
+		return nil, err
+	}
+	maps := map[string]testcover.Map{}
+	for _, pkg := range packages {
+		m, found, err := ReadPackageMap(dir, pkg)
+		if err != nil {
+			logger.Warn("coverage map skipped", "package", pkg, "error", err)
+			continue
+		}
+		if found {
+			maps[pkg] = m
+		}
+	}
+	return maps, nil
+}
diff --git a/internal/testreach/reader.go b/internal/testreach/reader.go
new file mode 100644
index 00000000..8f59fb63
--- /dev/null
+++ b/internal/testreach/reader.go
@@ -0,0 +1,268 @@
+// reader.go opens the shared and the worktree's coverage maps and answers which tests reach a function.
+
+package testreach
+
+import (
+	"cmp"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+)
+
+// Reader answers lookups over the coverage maps of a module, from the shared maps and the worktree's own.
+// It is read-only and safe for concurrent use once opened.
+type Reader struct {
+	module Module
+	// packages holds the winning map of each package, by module-relative path.
+	packages map[string]packageInfo
+	// shared and worktree are the reverse tables of the two directories; an entry counts only while its map wins.
+	shared, worktree map[testcover.FuncKey][]reachEntry
+}
+
+// Reach is one test that reaches a function.
+type Reach struct {
+	// Package is the import path of the test's package.
+	Package string
+	// Test is the test's name.
+	Test string
+	// Own is set when the test is of the function's own package.
+	Own bool
+	// Funcs is how many functions the test's entry reaches, own and linked together.
+	Funcs int
+	// MapCommit is the commit of the map the entry came from.
+	MapCommit string
+}
+
+// MapSource describes one map a Reader read.
+type MapSource struct {
+	// Package is the module-relative slash path of the map's package.
+	Package string
+	Commit  string
+	BuiltAt time.Time
+	// Worktree is set for a map read from the worktree's own maps.
+	Worktree bool
+}
+
+// Open reads the coverage maps of module from the hub's shared maps directory sharedDir.
+// It also reads the worktree's own maps directory worktreeDir, which is "" where the worktree keeps none.
+// An absent directory reads as one with no maps.
+// For a package both hold, the worktree's map wins when Fresh holds for it; otherwise the map built later wins.
+// A map that holds only a build failure, names a block or function outside its tables or does not parse is passed over.
+// The reverse table of the shared maps comes from the index beside them when the index's stamp is current.
+// Otherwise it is built in memory; Open never writes the index.
+func Open(module Module, sharedDir, worktreeDir string) (*Reader, error) {
+	shared, err := readSharedTable(module, sharedDir)
+	if err != nil {
+		return nil, err
+	}
+	r := &Reader{module: module, packages: shared.Packages, shared: shared.Reaches}
+	if worktreeDir == "" {
+		return r, nil
+	}
+	worktreeMaps, err := readMapDir(worktreeDir)
+	if err != nil {
+		return nil, err
+	}
+	table := buildTable(module, worktreeMaps, true)
+	r.worktree = table.Reaches
+	for pkg, m := range worktreeMaps {
+		own, sharedHas := shared.Packages[pkg]
+		wins := !sharedHas
+		if sharedHas {
+			if wins, err = worktreeMapWins(module, pkg, m, own); err != nil {
+				return nil, err
+			}
+		}
+		if wins {
+			r.packages[pkg] = table.Packages[pkg]
+		}
+	}
+	return r, nil
+}
+
+// worktreeMapWins reports whether the worktree's map m of pkg is read instead of the shared map described by shared.
+func worktreeMapWins(module Module, pkg string, m testcover.Map, shared packageInfo) (bool, error) {
+	fresh, err := Fresh(module, pkg, m)
+	if err != nil {
+		return false, err
+	}
+	return fresh || !shared.BuiltAt.After(m.BuiltAt), nil
+}
+
+// readSharedTable returns the reverse table of the shared maps in dir, from a current index or else from the maps.
+func readSharedTable(module Module, dir string) (mapTable, error) {
+	stamp, err := directoryStamp(dir)
+	if err != nil {
+		return mapTable{}, err
+	}
+	if index, usable := readIndex(dir); usable && index.Stamp == stamp {
+		table := mapTable{Packages: index.Packages, Reaches: map[testcover.FuncKey][]reachEntry{}}
+		if table.Packages == nil {
+			table.Packages = map[string]packageInfo{}
+		}
+		for _, reaches := range index.Reaches {
+			table.Reaches[reaches.Func] = reaches.Tests
+		}
+		return table, nil
+	}
+	maps, err := readMapDir(dir)
+	if err != nil {
+		return mapTable{}, err
+	}
+	return buildTable(module, maps, false), nil
+}
+
+// buildTable returns the reverse table of maps, by module-relative package.
+// worktree marks the packages as read from the worktree's own maps.
+func buildTable(module Module, maps map[string]testcover.Map, worktree bool) mapTable {
+	table := mapTable{Packages: map[string]packageInfo{}, Reaches: map[testcover.FuncKey][]reachEntry{}}
+	for pkg, m := range maps {
+		importPath := importPathOf(module, pkg)
+		info := packageInfo{Commit: m.Commit, BuiltAt: m.BuiltAt, Worktree: worktree}
+		for linked, hashes := range m.Linked {
+			if info.LinkedDigests == nil {
+				info.LinkedDigests = map[string]string{}
+			}
+			info.LinkedDigests[linked] = digestHashes(hashes)
+		}
+		for _, test := range m.Tests {
+			if test.Spawn.OutOfProcess || test.Spawn.Unresolved {
+				info.SpawnMarked = true
+			}
+			if !test.Measured() {
+				continue
+			}
+			reached := map[testcover.FuncKey]struct{}{}
+			for _, i := range test.Blocks {
+				reached[testcover.FuncKey{Package: importPath, File: m.Blocks[i].File, Func: m.Blocks[i].Func}] = struct{}{}
+			}
+			for _, i := range test.Funcs {
+				reached[m.Funcs[i]] = struct{}{}
+			}
+			for fn := range reached {
+				table.Reaches[fn] = append(table.Reaches[fn], reachEntry{MapPackage: pkg, Package: importPath, Test: test.Name, Funcs: len(reached)})
+			}
+		}
+		table.Packages[pkg] = info
+	}
+	return table
+}
+
+// TestsReaching returns every test that reaches fn.
+// A test of fn's own package reaches it through a block of the function;
+// a test of another package reaches it through the functions its map lists.
+// The tests of fn's own package come first, then those of other packages;
+// within each group the test reaching the fewest functions comes first, then by package and name.
+func (r *Reader) TestsReaching(fn testcover.FuncKey) []Reach {
+	var reaches []Reach
+	for _, source := range []struct {
+		table    map[testcover.FuncKey][]reachEntry
+		worktree bool
+	}{{r.shared, false}, {r.worktree, true}} {
+		for _, entry := range source.table[fn] {
+			info, wins := r.packages[entry.MapPackage]
+			if !wins || info.Worktree != source.worktree {
+				continue
+			}
+			reaches = append(reaches, Reach{
+				Package: entry.Package, Test: entry.Test, Own: entry.Package == fn.Package, Funcs: entry.Funcs, MapCommit: info.Commit,
+			})
+		}
+	}
+	slices.SortFunc(reaches, func(a, b Reach) int {
+		return cmp.Or(
+			cmp.Compare(boolRank(b.Own), boolRank(a.Own)),
+			cmp.Compare(a.Funcs, b.Funcs),
+			strings.Compare(a.Package, b.Package),
+			strings.Compare(a.Test, b.Test),
+		)
+	})
+	return reaches
+}
+
+// FuncsReachedBy returns the functions of among that the test named test of the package pkg reaches, in among's order.
+// pkg is the module-relative slash path of the package whose map holds the test.
+// A test reaches a function by the rules TestsReaching states.
+// It also returns the map that holds the test and whether a map holds a measured entry of that name.
+// A test whose entry reaches no function counts as held by no map.
+func (r *Reader) FuncsReachedBy(pkg, test string, among []testcover.FuncKey) ([]testcover.FuncKey, MapSource, bool) {
+	info, wins := r.packages[pkg]
+	if !wins {
+		return nil, MapSource{}, false
+	}
+	table := r.shared
+	if info.Worktree {
+		table = r.worktree
+	}
+	holdsTest := func(entries []reachEntry) bool {
+		return slices.ContainsFunc(entries, func(entry reachEntry) bool { return entry.MapPackage == pkg && entry.Test == test })
+	}
+	var reached []testcover.FuncKey
+	for _, fn := range among {
+		if holdsTest(table[fn]) {
+			reached = append(reached, fn)
+		}
+	}
+	held := len(reached) > 0
+	for _, entries := range table {
+		if held {
+			break
+		}
+		held = holdsTest(entries)
+	}
+	if !held {
+		return nil, MapSource{}, false
+	}
+	return reached, MapSource{Package: pkg, Commit: info.Commit, BuiltAt: info.BuiltAt, Worktree: info.Worktree}, true
+}
+
+// boolRank orders false before true.
+func boolRank(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// Maps lists the map of each package the reader read, sorted by package.
+func (r *Reader) Maps() []MapSource {
+	sources := make([]MapSource, 0, len(r.packages))
+	for pkg, info := range r.packages {
+		sources = append(sources, MapSource{Package: pkg, Commit: info.Commit, BuiltAt: info.BuiltAt, Worktree: info.Worktree})
+	}
+	slices.SortFunc(sources, func(a, b MapSource) int { return strings.Compare(a.Package, b.Package) })
+	return sources
+}
+
+// SpawnMarked reports whether the map of the module-relative package pkg holds an entry.
+// The entry's spawn verdict must mark the test out of process or unresolved.
+// Such a test may run the function in a process the map's coverage cannot see.
+func (r *Reader) SpawnMarked(pkg string) bool {
+	return r.packages[pkg].SpawnMarked
+}
+
+// StaleLinkers names, sorted, the module-relative packages whose maps record the package at import path pkg as linked.
+// Only packages whose recorded file hashes differ from the worktree's files of pkg count.
+// A test of such a package may reach a function new to pkg without the map showing it.
+func (r *Reader) StaleLinkers(pkg string) ([]string, error) {
+	rel, inModule := relativePackage(r.module, pkg)
+	if !inModule {
+		return nil, fmt.Errorf("package %s lies outside the module %s", pkg, r.module.Path)
+	}
+	onDisk, err := diskPackageHashes(r.module, rel)
+	if err != nil {
+		return nil, err
+	}
+	current := digestHashes(onDisk)
+	var stale []string
+	for mapPkg, info := range r.packages {
+		if digest, linked := info.LinkedDigests[pkg]; linked && digest != current {
+			stale = append(stale, mapPkg)
+		}
+	}
+	slices.Sort(stale)
+	return stale, nil
+}
