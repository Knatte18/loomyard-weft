diff --git a/internal/driftengine/recordsguard.go b/internal/driftengine/recordsguard.go
new file mode 100644
index 00000000..72582948
--- /dev/null
+++ b/internal/driftengine/recordsguard.go
@@ -0,0 +1,218 @@
+// recordsguard.go — the guard over the drift records, scope.json and judged.json: every write commits both files with a digest trailer, and a read tells a file edited by hand from the committed copy.
+
+package driftengine
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// RecordsTrailerKey is the records commit trailer that carries the digest of the two records as that commit wrote them.
+const RecordsTrailerKey = "Drift-Records"
+
+// Records is the two drift records as a reader may trust them.
+type Records struct {
+	// Scope is the scope record, and ScopeFound reports that the file exists.
+	Scope      ScopeRecord
+	ScopeFound bool
+	// Judged is the stored rulings, and JudgedFound reports that the file exists.
+	Judged      JudgedRecord
+	JudgedFound bool
+	// Committed is true when the copies come from the newest Drift-Records commit, and false when no such commit exists and the files are read as they are.
+	Committed bool
+	// Mismatch is true when the files on disk are not the newest Drift-Records commit's: a hand edit, or a write interrupted before its commit.
+	// The copies are then the committed ones.
+	Mismatch bool
+}
+
+// RecordsDigest returns the sha256 over each file's presence and content, so an absent file differs from an empty one.
+func RecordsDigest(scope, judged []byte, scopeFound, judgedFound bool) string {
+	hash := sha256.New()
+	for _, file := range []struct {
+		found bool
+		data  []byte
+	}{{scopeFound, scope}, {judgedFound, judged}} {
+		if !file.found {
+			fmt.Fprint(hash, "absent;")
+			continue
+		}
+		fmt.Fprintf(hash, "present:%d:", len(file.data))
+		hash.Write(file.data)
+	}
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+// readRecordFile reads a record file's bytes, answering found false for an absent file.
+func readRecordFile(path string) (data []byte, found bool, err error) {
+	data, err = os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, fmt.Errorf("drift: read %s: %w", path, err)
+	}
+	return data, true, nil
+}
+
+// decodeRecord decodes a record's bytes, leaving the zero value for an absent file; it accepts keys the type does not declare.
+func decodeRecord[T any](name string, data []byte, found bool) (T, error) {
+	var record T
+	if !found {
+		return record, nil
+	}
+	if err := json.Unmarshal(data, &record); err != nil {
+		return record, fmt.Errorf("drift: decode %s: %w", name, err)
+	}
+	return record, nil
+}
+
+// currentDigest returns the digest of the two record files as they are on disk.
+func currentDigest(p Paths) (string, error) {
+	scope, scopeFound, err := readRecordFile(p.Scope)
+	if err != nil {
+		return "", err
+	}
+	judged, judgedFound, err := readRecordFile(p.Judged)
+	if err != nil {
+		return "", err
+	}
+	return RecordsDigest(scope, judged, scopeFound, judgedFound), nil
+}
+
+// ReadRecords reads the two records from the newest records commit carrying Drift-Records, through the FileAt seam, and sets Mismatch when the files on disk differ from that commit's digest.
+// With no such commit it returns the files as they are, Committed and Mismatch false, so a run seeded before the guard existed reads its records unguarded until its first write.
+func ReadRecords(d Deps) (Records, error) {
+	if err := requireSeams("the records guard", seam{"TrailerCommit", d.TrailerCommit != nil}, seam{"FileAt", d.FileAt != nil}); err != nil {
+		return Records{}, err
+	}
+	commit, found, err := d.TrailerCommit(RecordsTrailerKey, true)
+	if err != nil {
+		return Records{}, fmt.Errorf("drift: find the newest %s commit: %w", RecordsTrailerKey, err)
+	}
+
+	var scopeData, judgedData []byte
+	var scopeFound, judgedFound bool
+	if found {
+		if scopeData, scopeFound, err = d.FileAt(commit.SHA, durableRel(scopeFileName)); err != nil {
+			return Records{}, fmt.Errorf("drift: read %s at %s: %w", scopeFileName, commit.SHA, err)
+		}
+		if judgedData, judgedFound, err = d.FileAt(commit.SHA, durableRel(judgedFileName)); err != nil {
+			return Records{}, fmt.Errorf("drift: read %s at %s: %w", judgedFileName, commit.SHA, err)
+		}
+	} else {
+		if scopeData, scopeFound, err = readRecordFile(d.Paths.Scope); err != nil {
+			return Records{}, err
+		}
+		if judgedData, judgedFound, err = readRecordFile(d.Paths.Judged); err != nil {
+			return Records{}, err
+		}
+	}
+
+	records := Records{ScopeFound: scopeFound, JudgedFound: judgedFound, Committed: found}
+	if records.Scope, err = decodeRecord[ScopeRecord](scopeFileName, scopeData, scopeFound); err != nil {
+		return Records{}, err
+	}
+	if records.Judged, err = decodeRecord[JudgedRecord](judgedFileName, judgedData, judgedFound); err != nil {
+		return Records{}, err
+	}
+	if found {
+		digest, err := currentDigest(d.Paths)
+		if err != nil {
+			return Records{}, err
+		}
+		records.Mismatch = digest != commit.Value
+	}
+	return records, nil
+}
+
+// WriteRecords applies change to the records ReadRecords returns, never to the files on disk, writes both files through internal/state and commits both at once through CommitWithTrailers.
+// The commit ends in `Drift-Records: <digest of the written files>` and then the extra trailers.
+// It refuses while the files on disk differ from the newest Drift-Records commit, since a write would hide the difference; only RestoreRecords clears it.
+// A write interrupted before its commit leaves such a difference.
+func WriteRecords(d Deps, change func(scope *ScopeRecord, judged *JudgedRecord) error, extra ...fabricengine.Trailer) error {
+	if err := requireSeams("the records guard", seam{"CommitWithTrailers", d.CommitWithTrailers != nil}); err != nil {
+		return err
+	}
+	records, err := ReadRecords(d)
+	if err != nil {
+		return err
+	}
+	if records.Mismatch {
+		return fmt.Errorf("drift: the records differ from their newest %s commit, so nothing is written over them; way forward: lym drift amend <slug> --restore", RecordsTrailerKey)
+	}
+	scope, judged := records.Scope, records.Judged
+	if err := change(&scope, &judged); err != nil {
+		return err
+	}
+
+	if err := writeRecord(d.Paths, scopeFileName, d.Paths.Scope, scope); err != nil {
+		return err
+	}
+	if err := writeRecord(d.Paths, judgedFileName, d.Paths.Judged, judged); err != nil {
+		return err
+	}
+	digest, err := currentDigest(d.Paths)
+	if err != nil {
+		return err
+	}
+	trailers := append([]fabricengine.Trailer{{Key: RecordsTrailerKey, Value: digest}}, extra...)
+	if err := d.CommitWithTrailers([]string{durableRel(scopeFileName), durableRel(judgedFileName)}, trailers); err != nil {
+		return fmt.Errorf("drift: commit the records: %w", err)
+	}
+	return nil
+}
+
+// writeRecord writes the record file called name through internal/state, which keeps the keys of the file it replaces that the value's type does not declare.
+func writeRecord[T any](p Paths, name, path string, value T) error {
+	lock, err := recordLock(p, name)
+	if err != nil {
+		return err
+	}
+	if err := state.WriteJSON(path, lock, value); err != nil {
+		return fmt.Errorf("drift: write %s: %w", name, err)
+	}
+	return nil
+}
+
+// RestoreRecords writes both records back from the newest Drift-Records commit and removes a file that commit lacks.
+// It adds no commit, so the history stays as it was and the files match the commit's digest again.
+func RestoreRecords(d Deps) error {
+	if err := requireSeams("the records guard", seam{"TrailerCommit", d.TrailerCommit != nil}, seam{"FileAt", d.FileAt != nil}); err != nil {
+		return err
+	}
+	commit, found, err := d.TrailerCommit(RecordsTrailerKey, true)
+	if err != nil {
+		return fmt.Errorf("drift: find the newest %s commit: %w", RecordsTrailerKey, err)
+	}
+	if !found {
+		return fmt.Errorf("drift: no %s commit holds records to restore", RecordsTrailerKey)
+	}
+	for _, file := range []struct{ name, path string }{{scopeFileName, d.Paths.Scope}, {judgedFileName, d.Paths.Judged}} {
+		data, present, err := d.FileAt(commit.SHA, durableRel(file.name))
+		if err != nil {
+			return fmt.Errorf("drift: read %s at %s: %w", file.name, commit.SHA, err)
+		}
+		if !present {
+			if err := os.Remove(file.path); err != nil && !errors.Is(err, fs.ErrNotExist) {
+				return fmt.Errorf("drift: remove %s: %w", file.name, err)
+			}
+			continue
+		}
+		lock, err := recordLock(d.Paths, file.name)
+		if err != nil {
+			return err
+		}
+		if err := state.WriteFile(file.path, lock, data); err != nil {
+			return fmt.Errorf("drift: restore %s: %w", file.name, err)
+		}
+	}
+	return nil
+}
diff --git a/internal/driftengine/recordsguard_test.go b/internal/driftengine/recordsguard_test.go
new file mode 100644
index 00000000..9ec5a4d5
--- /dev/null
+++ b/internal/driftengine/recordsguard_test.go
@@ -0,0 +1,218 @@
+// recordsguard_test.go — tier 0 tests for the records guard, over the in-memory commitStore.
+
+package driftengine
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// setFull is a records change that records scope full and one stored ruling.
+func setFull(scope *ScopeRecord, judged *JudgedRecord) error {
+	scope.Scope = ScopeFull
+	judged.Tuples = []JudgedTuple{{Case: "a.txt", Ruling: RulingMatches, Reason: "fits"}}
+	return nil
+}
+
+// readFileString returns a file's content as a string, failing the test when it cannot be read.
+func readFileString(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	return string(data)
+}
+
+// writeFileString writes content to path, creating its directory.
+func writeFileString(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("create the directory of %s: %v", path, err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatalf("write %s: %v", path, err)
+	}
+}
+
+// TestRecords covers the guard: a write's single commit and its digest, a read of the committed copies, a hand edit setting Mismatch, a restore, an unguarded read before the first commit, an extra trailer and an unknown key surviving a write.
+func TestRecords(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("WriteMakesOneCommitWhoseTrailerIsTheDigest", func(t *testing.T) {
+		t.Parallel()
+		store := newCommitStore(t)
+		d := store.deps(NewPaths(store.root))
+		if err := WriteRecords(d, setFull); err != nil {
+			t.Fatalf("WriteRecords() = %v; want nil", err)
+		}
+		if len(store.commits) != 1 {
+			t.Fatalf("WriteRecords() made %d commits; want 1", len(store.commits))
+		}
+		wantDigest := RecordsDigest([]byte(readFileString(t, d.Paths.Scope)), []byte(readFileString(t, d.Paths.Judged)), true, true)
+		wantTrailers := []fabricengine.Trailer{{Key: RecordsTrailerKey, Value: wantDigest}}
+		if diff := cmp.Diff(wantTrailers, store.commits[0].trailers); diff != "" {
+			t.Errorf("commit trailers mismatch (-want +got):\n%s", diff)
+		}
+		for _, name := range []string{scopeFileName, judgedFileName} {
+			if _, found := store.commits[0].files[durableRel(name)]; !found {
+				t.Errorf("the commit lacks %s", name)
+			}
+		}
+
+		records, err := ReadRecords(d)
+		if err != nil {
+			t.Fatalf("ReadRecords() = %v; want nil", err)
+		}
+		if !records.Committed || records.Mismatch || !records.ScopeFound || !records.JudgedFound {
+			t.Errorf("ReadRecords() = %+v; want committed, found and no mismatch", records)
+		}
+		if records.Scope.Scope != ScopeFull || len(records.Judged.Tuples) != 1 {
+			t.Errorf("ReadRecords() returned scope %q and %d tuples; want the written ones", records.Scope.Scope, len(records.Judged.Tuples))
+		}
+	})
+
+	t.Run("HandEditSetsMismatchAndTheReadKeepsTheCommittedCopy", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name string
+			edit func(t *testing.T, d Deps)
+		}{
+			{"AmendmentAddedToScope", func(t *testing.T, d Deps) {
+				err := UpdateScope(d.Paths, func(cur ScopeRecord, _ bool) (ScopeRecord, error) {
+					cur.Amendments = append(cur.Amendments, Amendment{By: "hand", Kind: "discard"})
+					return cur, nil
+				})
+				if err != nil {
+					t.Fatalf("UpdateScope() = %v; want nil", err)
+				}
+			}},
+			{"TupleAddedToJudged", func(t *testing.T, d Deps) {
+				writeFileString(t, d.Paths.Judged, `{"tuples":[{"case":"a.txt"},{"case":"hand-added"}]}`)
+			}},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				store := newCommitStore(t)
+				d := store.deps(NewPaths(store.root))
+				if err := WriteRecords(d, setFull); err != nil {
+					t.Fatalf("WriteRecords() = %v; want nil", err)
+				}
+				tt.edit(t, d)
+
+				records, err := ReadRecords(d)
+				if err != nil {
+					t.Fatalf("ReadRecords() = %v; want nil", err)
+				}
+				if !records.Mismatch {
+					t.Errorf("ReadRecords().Mismatch = false after a hand edit; want true")
+				}
+				if len(records.Scope.Amendments) != 0 || len(records.Judged.Tuples) != 1 || records.Judged.Tuples[0].Case != "a.txt" {
+					t.Errorf("ReadRecords() returned %+v; want the committed copy", records)
+				}
+
+				err = WriteRecords(d, func(*ScopeRecord, *JudgedRecord) error { return nil })
+				if err == nil || !strings.Contains(err.Error(), "--restore") {
+					t.Errorf("WriteRecords() over a mismatch = %v; want a refusal naming --restore", err)
+				}
+				if len(store.commits) != 1 {
+					t.Errorf("a refused write made %d commits in all; want the 1 from before", len(store.commits))
+				}
+
+				if err := RestoreRecords(d); err != nil {
+					t.Fatalf("RestoreRecords() = %v; want nil", err)
+				}
+				if len(store.commits) != 1 {
+					t.Errorf("RestoreRecords() changed the history to %d commits; want 1", len(store.commits))
+				}
+				if records, err := ReadRecords(d); err != nil || records.Mismatch {
+					t.Errorf("ReadRecords() after RestoreRecords() = %+v, %v; want no mismatch", records, err)
+				}
+			})
+		}
+	})
+
+	t.Run("RestoreRemovesAFileTheCommitLacks", func(t *testing.T) {
+		t.Parallel()
+		store := newCommitStore(t)
+		d := store.deps(NewPaths(store.root))
+		scope := `{"scope":"full"}`
+		writeFileString(t, d.Paths.Scope, scope)
+		digest := RecordsDigest([]byte(scope), nil, true, false)
+		if err := d.CommitWithTrailers([]string{durableRel(scopeFileName)}, []fabricengine.Trailer{{Key: RecordsTrailerKey, Value: digest}}); err != nil {
+			t.Fatalf("commit the scope alone: %v", err)
+		}
+		writeFileString(t, d.Paths.Judged, `{}`)
+		writeFileString(t, d.Paths.Scope, `{"scope":"off"}`)
+		if records, err := ReadRecords(d); err != nil || !records.Mismatch {
+			t.Fatalf("ReadRecords() = %+v, %v; want a mismatch", records, err)
+		}
+
+		if err := RestoreRecords(d); err != nil {
+			t.Fatalf("RestoreRecords() = %v; want nil", err)
+		}
+		if _, err := os.Stat(d.Paths.Judged); !os.IsNotExist(err) {
+			t.Errorf("judged.json after RestoreRecords() = %v; want it removed", err)
+		}
+		if got := readFileString(t, d.Paths.Scope); got != scope {
+			t.Errorf("scope.json after RestoreRecords() = %q; want %q", got, scope)
+		}
+	})
+
+	t.Run("NoCommitReadsTheFilesAsTheyAreUnguarded", func(t *testing.T) {
+		t.Parallel()
+		store := newCommitStore(t)
+		d := store.deps(NewPaths(store.root))
+		writeFileString(t, d.Paths.Scope, `{"scope":"partial"}`)
+
+		records, err := ReadRecords(d)
+		if err != nil {
+			t.Fatalf("ReadRecords() = %v; want nil", err)
+		}
+		if records.Committed || records.Mismatch || !records.ScopeFound || records.JudgedFound || records.Scope.Scope != ScopePartial {
+			t.Errorf("ReadRecords() = %+v; want the file as it is, uncommitted, with no mismatch and no judged file", records)
+		}
+	})
+
+	t.Run("ExtraTrailerRidesOnTheCommit", func(t *testing.T) {
+		t.Parallel()
+		store := newCommitStore(t)
+		d := store.deps(NewPaths(store.root))
+		extra := fabricengine.Trailer{Key: "Drift-Baseline", Value: "abc"}
+		if err := WriteRecords(d, setFull, extra); err != nil {
+			t.Fatalf("WriteRecords() = %v; want nil", err)
+		}
+		trailers := store.commits[0].trailers
+		if len(trailers) != 2 || trailers[0].Key != RecordsTrailerKey || trailers[1] != extra {
+			t.Errorf("commit trailers = %v; want %s then %v", trailers, RecordsTrailerKey, extra)
+		}
+	})
+
+	t.Run("UnknownKeySurvivesAWrite", func(t *testing.T) {
+		t.Parallel()
+		store := newCommitStore(t)
+		d := store.deps(NewPaths(store.root))
+		writeFileString(t, d.Paths.Scope, `{"scope":"full","future_key":7}`)
+		for round := range 2 {
+			err := WriteRecords(d, func(scope *ScopeRecord, _ *JudgedRecord) error {
+				scope.AwaitedAt = "2026-01-01T00:00:00Z"
+				return nil
+			})
+			if err != nil {
+				t.Fatalf("WriteRecords() round %d = %v; want nil", round, err)
+			}
+			if got := readFileString(t, d.Paths.Scope); !strings.Contains(got, `"future_key": 7`) {
+				t.Errorf("scope.json after write %d = %s; want future_key kept", round, got)
+			}
+		}
+	})
+}
diff --git a/internal/driftengine/seal.go b/internal/driftengine/seal.go
new file mode 100644
index 00000000..4748d449
--- /dev/null
+++ b/internal/driftengine/seal.go
@@ -0,0 +1,200 @@
+// seal.go — the expectation's seal and the baseline's digest: the two checks every drift check runs first, over the records commits that hold their trailers.
+
+package driftengine
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// The commit trailers that hold the seal and the baseline digest, and the prefix that marks a halt only `lym drift defer` settles.
+const (
+	// SealTrailerKey carries the sha256 of expected.yaml as Drift-Expect sealed it.
+	SealTrailerKey = "Drift-Seal"
+	// BaselineTrailerKey carries the BaselineDigest of the baseline directory as it was when its capture counted.
+	BaselineTrailerKey = "Drift-Baseline"
+	// DeferHaltPrefix marks a Stuck reason whose way forward is `lym drift defer`; it follows the decision halt prefix a row's Stuck opens with, so the verb tells such a halt from another on the same row.
+	DeferHaltPrefix = "drift defer halt: "
+)
+
+// expectRow is the recipe row that seals the expectation.
+const expectRow = "Drift-Expect"
+
+// amendmentKindDiscard is the Kind of an amendment that drops the expectation.
+const amendmentKindDiscard = "discard"
+
+// PastRow reports whether current comes after row in rows, the run's recipe row order.
+// A row absent from rows, or an absent current, is not past.
+func PastRow(rows []string, current, row string) bool {
+	currentIndex, rowIndex := slices.Index(rows, current), slices.Index(rows, row)
+	return currentIndex >= 0 && rowIndex >= 0 && currentIndex > rowIndex
+}
+
+// BaselineDigest hashes the baseline directory's tree with sha256: every regular file's slash-separated relative path and content, in path order.
+// A missing directory is an error wrapping fs.ErrNotExist.
+func BaselineDigest(dir string) (string, error) {
+	var names []string
+	err := filepath.WalkDir(dir, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !entry.Type().IsRegular() {
+			return nil
+		}
+		relative, err := filepath.Rel(dir, path)
+		if err != nil {
+			return err
+		}
+		names = append(names, filepath.ToSlash(relative))
+		return nil
+	})
+	if err != nil {
+		return "", fmt.Errorf("drift: digest the baseline directory %s: %w", dir, err)
+	}
+	sort.Strings(names)
+
+	hash := sha256.New()
+	for _, name := range names {
+		content, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(name)))
+		if err != nil {
+			return "", fmt.Errorf("drift: digest the baseline file %s: %w", name, err)
+		}
+		fmt.Fprintf(hash, "%d:%s\n%d:", len(name), name, len(content))
+		hash.Write(content)
+	}
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
+
+// BaselineState is what CheckBaseline found.
+type BaselineState struct {
+	// Fault is the reason the baseline cannot be trusted, opening with DeferHaltPrefix and naming `lym drift defer` as the way forward, and empty when the baseline holds.
+	Fault string
+	// Unguarded is true when no commit carries BaselineTrailerKey, so only the digest compare was skipped: a capture that counted before the digest existed.
+	Unguarded bool
+}
+
+// CheckBaseline recomputes the digest of the baseline directory and compares it with the one the oldest commit carrying BaselineTrailerKey recorded, so an edit of the baseline after its capture counted is found.
+// A missing directory is a Fault whether or not a commit carries the trailer.
+// With no such commit it is Unguarded and only the compare is skipped.
+func CheckBaseline(d Deps) (BaselineState, error) {
+	if err := requireSeams("the baseline check", seam{"TrailerCommit", d.TrailerCommit != nil}); err != nil {
+		return BaselineState{}, err
+	}
+	commit, found, err := d.TrailerCommit(BaselineTrailerKey, false)
+	if err != nil {
+		return BaselineState{}, fmt.Errorf("drift: find the oldest %s commit: %w", BaselineTrailerKey, err)
+	}
+	state := BaselineState{Unguarded: !found}
+
+	digest, err := BaselineDigest(d.Paths.BaselineDir)
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		state.Fault = DeferHaltPrefix + fmt.Sprintf("the baseline directory %s is missing, so the counted capture cannot be compared; way forward: the parent runs lym drift defer, then lym loom resume", d.Paths.BaselineDir)
+	case err != nil:
+		return BaselineState{}, err
+	case found && digest != commit.Value:
+		state.Fault = DeferHaltPrefix + fmt.Sprintf("the baseline under %s no longer matches the digest recorded when its capture counted; way forward: the parent runs lym drift defer, then lym loom resume", d.Paths.BaselineDir)
+	}
+	return state, nil
+}
+
+// sealDigest returns the sha256 of an expectation file's bytes, as the seal trailer carries it.
+func sealDigest(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+// SealExpectation reads expected.yaml, hashes it and commits it alone through CommitWithTrailers with `Drift-Seal: <sha256>` and then any extra trailer, such as the baseline digest of a counted capture that has none yet.
+func SealExpectation(d Deps, extra ...fabricengine.Trailer) error {
+	if err := requireSeams("the seal", seam{"CommitWithTrailers", d.CommitWithTrailers != nil}); err != nil {
+		return err
+	}
+	data, err := os.ReadFile(d.Paths.Expected)
+	if err != nil {
+		return fmt.Errorf("drift: read the expectation to seal it: %w", err)
+	}
+	trailers := append([]fabricengine.Trailer{{Key: SealTrailerKey, Value: sealDigest(data)}}, extra...)
+	if err := d.CommitWithTrailers([]string{durableRel(expectedFileName)}, trailers); err != nil {
+		return fmt.Errorf("drift: commit the sealed expectation: %w", err)
+	}
+	return nil
+}
+
+// SealState is the expectation containment reads, as CheckSeal decided it.
+// Exactly one of Sealed, Empty, NotYet and Fault is the verdict, except a Fault after an edit, which keeps the seal's copy in Sealed.
+type SealState struct {
+	// Sealed is the expectation's bytes as the seal commit holds them.
+	Sealed []byte
+	// Empty is true when containment reads the empty expectation: nothing was written, the parent discarded it, or the run passed Drift-Expect unsealed.
+	Empty bool
+	// NotYet is true when the run has not reached Drift-Expect's end, so no expectation exists to check.
+	NotYet bool
+	// Fault names the failed check and its way forward; a gate or verb that only reports checks against Sealed regardless.
+	Fault string
+}
+
+// CheckSeal decides the expectation containment reads, in this order:
+// a `discard` amendment in rec, or an Unsealed record, is Empty with no check;
+// a status row not past Drift-Expect is NotYet;
+// with no seal commit, a missing file is Empty and a present one is a Fault naming `--discard`;
+// otherwise the oldest commit carrying SealTrailerKey is the seal, and its copy must hash to the trailer's value and its code head must equal baselineHead, else a Fault naming `--discard`,
+// and the current file must hash to the trailer's value, else a Fault naming `--restore` with Sealed still the seal's copy.
+func CheckSeal(d Deps, rec Records, baselineHead string) (SealState, error) {
+	if err := requireSeams("the seal check", seam{"Status", d.Status != nil}, seam{"TrailerCommit", d.TrailerCommit != nil}, seam{"FileAt", d.FileAt != nil}); err != nil {
+		return SealState{}, err
+	}
+	for _, amendment := range rec.Scope.Amendments {
+		if amendment.Kind == amendmentKindDiscard {
+			return SealState{Empty: true}, nil
+		}
+	}
+	if rec.Scope.Unsealed {
+		return SealState{Empty: true}, nil
+	}
+	status, err := d.Status()
+	if err != nil {
+		return SealState{}, fmt.Errorf("drift: read the run status for the seal check: %w", err)
+	}
+	if !PastRow(d.Rows, status.CurrentProducer, expectRow) {
+		return SealState{NotYet: true}, nil
+	}
+
+	current, fileFound, err := readRecordFile(d.Paths.Expected)
+	if err != nil {
+		return SealState{}, err
+	}
+	seal, sealFound, err := d.TrailerCommit(SealTrailerKey, false)
+	if err != nil {
+		return SealState{}, fmt.Errorf("drift: find the oldest %s commit: %w", SealTrailerKey, err)
+	}
+	if !sealFound {
+		if !fileFound {
+			return SealState{Empty: true}, nil
+		}
+		return SealState{Fault: "expected.yaml exists but no commit sealed it; way forward: the parent runs lym drift amend <slug> --discard"}, nil
+	}
+
+	sealed, copyFound, err := d.FileAt(seal.SHA, durableRel(expectedFileName))
+	if err != nil {
+		return SealState{}, fmt.Errorf("drift: read the sealed expectation at %s: %w", seal.SHA, err)
+	}
+	if !copyFound || sealDigest(sealed) != seal.Value {
+		return SealState{Fault: "the sealed copy of expected.yaml fails its own seal hash; way forward: the parent runs lym drift amend <slug> --discard"}, nil
+	}
+	if seal.CodeHead != baselineHead {
+		return SealState{Fault: fmt.Sprintf("the seal was made at code head %s, not at the baseline's %s; way forward: the parent runs lym drift amend <slug> --discard", seal.CodeHead, baselineHead)}, nil
+	}
+	if !fileFound || sealDigest(current) != seal.Value {
+		return SealState{Sealed: sealed, Fault: "expected.yaml was changed after Drift-Expect sealed it; way forward: the parent runs lym drift amend <slug> --restore"}, nil
+	}
+	return SealState{Sealed: sealed}, nil
+}
diff --git a/internal/driftengine/seal_test.go b/internal/driftengine/seal_test.go
new file mode 100644
index 00000000..991d61de
--- /dev/null
+++ b/internal/driftengine/seal_test.go
@@ -0,0 +1,240 @@
+// seal_test.go — tier 0 tests for the expectation's seal, the baseline digest and the row order, over the in-memory commitStore.
+
+package driftengine
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// sealHead is the code head the store reports while a test seals or commits.
+const sealHead = "code-head-1"
+
+// sealDeps returns a store and its Deps with the status at row current and a recipe order that holds Drift-Expect.
+func sealDeps(t *testing.T, current string) (*commitStore, Deps) {
+	t.Helper()
+	store := newCommitStore(t)
+	store.codeHead = sealHead
+	d := store.deps(NewPaths(store.root))
+	d.Rows = []string{"Drift-Baseline", "Drift-Await", "Drift-Expect", "Darn-Write", "Drift-Verify"}
+	d.Status = func() (shedengine.Status, error) { return shedengine.Status{CurrentProducer: current}, nil }
+	return store, d
+}
+
+// seedBaseline writes the baseline directory's files.
+func seedBaseline(t *testing.T, d Deps) {
+	t.Helper()
+	writeFileString(t, filepath.Join(d.Paths.BaselineDir, "a.txt"), "one\n")
+	writeFileString(t, filepath.Join(d.Paths.BaselineDir, "sub", "b.txt"), "two\n")
+}
+
+// commitBaselineDigest commits the baseline's current digest under the baseline trailer.
+func commitBaselineDigest(t *testing.T, d Deps) {
+	t.Helper()
+	digest, err := BaselineDigest(d.Paths.BaselineDir)
+	if err != nil {
+		t.Fatalf("BaselineDigest() = %v; want nil", err)
+	}
+	if err := d.CommitWithTrailers(nil, []fabricengine.Trailer{{Key: BaselineTrailerKey, Value: digest}}); err != nil {
+		t.Fatalf("commit the baseline digest: %v", err)
+	}
+}
+
+// TestSealAndBaseline covers CheckSeal's order and each of its faults, the baseline digest read from its commit, and the row order.
+func TestSealAndBaseline(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const expected = "cases: {}\n"
+	sealed := func(t *testing.T, _ *commitStore, d Deps) Records {
+		t.Helper()
+		writeFileString(t, d.Paths.Expected, expected)
+		if err := SealExpectation(d); err != nil {
+			t.Fatalf("SealExpectation() = %v; want nil", err)
+		}
+		return Records{}
+	}
+
+	sealTests := []struct {
+		name         string
+		current      string
+		baselineHead string
+		setup        func(t *testing.T, store *commitStore, d Deps) Records
+		want         SealState
+		wantFault    string
+	}{
+		{name: "ValidSealReadsItsBytes", current: "Drift-Verify", setup: sealed, want: SealState{Sealed: []byte(expected)}},
+		{
+			name: "EditedFileFaultsRestoreAndKeepsTheSealedCopy", current: "Drift-Verify",
+			setup: func(t *testing.T, store *commitStore, d Deps) Records {
+				rec := sealed(t, store, d)
+				writeFileString(t, d.Paths.Expected, "cases: {x: {}}\n")
+				return rec
+			},
+			want: SealState{Sealed: []byte(expected)}, wantFault: "--restore",
+		},
+		{name: "SealMadeAtAnotherCodeHeadFaultsDiscard", current: "Drift-Verify", baselineHead: "another-head", setup: sealed, wantFault: "--discard"},
+		{
+			name: "SealCopyFailingItsOwnHashFaultsDiscard", current: "Drift-Verify",
+			setup: func(t *testing.T, _ *commitStore, d Deps) Records {
+				writeFileString(t, d.Paths.Expected, expected)
+				if err := d.CommitWithTrailers([]string{durableRel(expectedFileName)}, []fabricengine.Trailer{{Key: SealTrailerKey, Value: "not-the-hash"}}); err != nil {
+					t.Fatalf("commit the bad seal: %v", err)
+				}
+				return Records{}
+			},
+			wantFault: "--discard",
+		},
+		{
+			name: "FileWithNoSealPastDriftExpectFaultsDiscard", current: "Drift-Verify",
+			setup: func(t *testing.T, _ *commitStore, d Deps) Records {
+				writeFileString(t, d.Paths.Expected, expected)
+				return Records{}
+			},
+			wantFault: "--discard",
+		},
+		{name: "NoFileAndNoSealPastDriftExpectIsEmpty", current: "Drift-Verify", setup: func(*testing.T, *commitStore, Deps) Records { return Records{} }, want: SealState{Empty: true}},
+		{name: "RowBeforeDriftExpectIsNotYet", current: "Drift-Await", setup: sealed, want: SealState{NotYet: true}},
+		{
+			name: "UnsealedRecordIgnoresALaterSeal", current: "Drift-Verify",
+			setup: func(t *testing.T, store *commitStore, d Deps) Records {
+				rec := sealed(t, store, d)
+				rec.Scope.Unsealed = true
+				return rec
+			},
+			want: SealState{Empty: true},
+		},
+		{
+			name: "DiscardAmendmentSkipsTheCheck", current: "Drift-Verify",
+			setup: func(t *testing.T, _ *commitStore, d Deps) Records {
+				writeFileString(t, d.Paths.Expected, expected)
+				return Records{Scope: ScopeRecord{Amendments: []Amendment{{Kind: amendmentKindDiscard}}}}
+			},
+			want: SealState{Empty: true},
+		},
+	}
+	for _, tt := range sealTests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			store, d := sealDeps(t, tt.current)
+			rec := tt.setup(t, store, d)
+			baselineHead := tt.baselineHead
+			if baselineHead == "" {
+				baselineHead = sealHead
+			}
+			got, err := CheckSeal(d, rec, baselineHead)
+			if err != nil {
+				t.Fatalf("CheckSeal() = %v; want nil", err)
+			}
+			if tt.wantFault != "" {
+				if !strings.Contains(got.Fault, tt.wantFault) {
+					t.Fatalf("CheckSeal().Fault = %q; want it to name %q", got.Fault, tt.wantFault)
+				}
+				got.Fault = ""
+			}
+			if diff := cmp.Diff(tt.want, got); diff != "" {
+				t.Errorf("CheckSeal() mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+
+	t.Run("SealCommitsTheFileAloneWithAnExtraTrailer", func(t *testing.T) {
+		t.Parallel()
+		store, d := sealDeps(t, "Drift-Verify")
+		writeFileString(t, d.Paths.Expected, expected)
+		extra := fabricengine.Trailer{Key: BaselineTrailerKey, Value: "digest"}
+		if err := SealExpectation(d, extra); err != nil {
+			t.Fatalf("SealExpectation() = %v; want nil", err)
+		}
+		if len(store.commits) != 1 {
+			t.Fatalf("SealExpectation() made %d commits; want 1", len(store.commits))
+		}
+		if _, found := store.commits[0].files[durableRel(expectedFileName)]; !found || len(store.commits[0].files) != 1 {
+			t.Fatalf("SealExpectation() committed %d files; want the expectation alone", len(store.commits[0].files))
+		}
+		want := []fabricengine.Trailer{{Key: SealTrailerKey, Value: sealDigest([]byte(expected))}, extra}
+		if diff := cmp.Diff(want, store.commits[0].trailers); diff != "" {
+			t.Errorf("commit trailers mismatch (-want +got):\n%s", diff)
+		}
+	})
+
+	baselineTests := []struct {
+		name  string
+		setup func(t *testing.T, d Deps)
+		want  BaselineState
+		fault bool
+	}{
+		{name: "IntactBaselineHolds", setup: func(t *testing.T, d Deps) { seedBaseline(t, d); commitBaselineDigest(t, d) }},
+		{
+			name: "EditedBaselineFileFaults",
+			setup: func(t *testing.T, d Deps) {
+				seedBaseline(t, d)
+				commitBaselineDigest(t, d)
+				writeFileString(t, filepath.Join(d.Paths.BaselineDir, "a.txt"), "edited\n")
+			},
+			fault: true,
+		},
+		{
+			name: "MissingBaselineDirectoryFaults",
+			setup: func(t *testing.T, d Deps) {
+				seedBaseline(t, d)
+				commitBaselineDigest(t, d)
+				if err := os.RemoveAll(d.Paths.BaselineDir); err != nil {
+					t.Fatalf("remove the baseline: %v", err)
+				}
+			},
+			fault: true,
+		},
+		{name: "NoDigestCommitIsUnguardedWithNoFault", setup: seedBaseline, want: BaselineState{Unguarded: true}},
+		{name: "MissingDirectoryWithNoDigestCommitFaults", setup: func(*testing.T, Deps) {}, want: BaselineState{Unguarded: true}, fault: true},
+	}
+	for _, tt := range baselineTests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, d := sealDeps(t, "Drift-Verify")
+			tt.setup(t, d)
+			got, err := CheckBaseline(d)
+			if err != nil {
+				t.Fatalf("CheckBaseline() = %v; want nil", err)
+			}
+			if tt.fault {
+				if !strings.HasPrefix(got.Fault, DeferHaltPrefix) || !strings.Contains(got.Fault, "lym drift defer") {
+					t.Fatalf("CheckBaseline().Fault = %q; want it to open with %q and name lym drift defer", got.Fault, DeferHaltPrefix)
+				}
+				got.Fault = ""
+			}
+			if diff := cmp.Diff(tt.want, got); diff != "" {
+				t.Errorf("CheckBaseline() mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+
+	t.Run("PastRow", func(t *testing.T) {
+		t.Parallel()
+		rows := []string{"a", "b", "c"}
+		tests := []struct {
+			name         string
+			current, row string
+			want         bool
+		}{
+			{"CurrentAfterRow", "c", "b", true},
+			{"CurrentIsRow", "b", "b", false},
+			{"CurrentBeforeRow", "a", "b", false},
+			{"RowAbsentIsNotPast", "c", "x", false},
+			{"CurrentAbsentIsNotPast", "x", "a", false},
+		}
+		for _, tt := range tests {
+			if got := PastRow(rows, tt.current, tt.row); got != tt.want {
+				t.Errorf("%s: PastRow(%v, %q, %q) = %v; want %v", tt.name, rows, tt.current, tt.row, got, tt.want)
+			}
+		}
+	})
+}
