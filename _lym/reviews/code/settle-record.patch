+func TestFixSlug(t *testing.T) {
+	t.Parallel()
+
+	t.Run("a short subject's prefix is adopt-fix and the subject", func(t *testing.T) {
+		t.Parallel()
+		if got := fixSlugPrefix("alpha"); got != "adopt-fix-alpha" {
+			t.Errorf("fixSlugPrefix(alpha) = %q; want adopt-fix-alpha", got)
+		}
+		// The longest subject that still fits with the -t999 suffix.
+		fits := strings.Repeat("a", boardengine.MaxSlugLength-len("adopt-fix-")-len("-t999"))
+		if got := fixSlugPrefix(fits); got != "adopt-fix-"+fits {
+			t.Errorf("fixSlugPrefix(%q) = %q; want it uncut", fits, got)
+		}
+	})
+
+	t.Run("long subjects sharing their cut get two prefixes within the limit and no doubled hyphen", func(t *testing.T) {
+		t.Parallel()
+		subjects := []string{"a-very-long-beam-slug-name-one", "a-very-long-beam-slug-name-two", "abcdefghi-jklmnopqrstuvwxyz"}
+		seen := map[string]string{}
+		for _, subject := range subjects {
+			prefix := fixSlugPrefix(subject)
+			if len(prefix)+len("-t999") > boardengine.MaxSlugLength || strings.Contains(prefix, "--") {
+				t.Errorf("fixSlugPrefix(%q) = %q; want it to leave room for -t999 within %d with no doubled hyphen", subject, prefix, boardengine.MaxSlugLength)
+			}
+			if other, dup := seen[prefix]; dup {
+				t.Errorf("fixSlugPrefix(%q) = fixSlugPrefix(%q) = %q; want distinct prefixes", subject, other, prefix)
+			}
+			seen[prefix] = subject
+		}
+	})
+
+	t.Run("the next slug is one past the highest number among the taken slugs of its prefix", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name  string
+			taken []string
+			want  string
+		}{
+			{"NoneTaken", nil, "adopt-fix-alpha-t1"},
+			{"HighestPlusOne", []string{"adopt-fix-alpha-t1", "adopt-fix-alpha-t4", "adopt-fix-alpha-t2"}, "adopt-fix-alpha-t5"},
+			{"OtherPrefixesAndShapesIgnored", []string{"adopt-fix-beta-t9", "adopt-fix-alpha-t2-t7", "adopt-fix-alpha-tx", "adopt-fix-alpha-t03", "alpha"}, "adopt-fix-alpha-t1"},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				if got := nextFixSlug("adopt-fix-alpha", tt.taken); got != tt.want {
+					t.Errorf("nextFixSlug(adopt-fix-alpha, %q) = %q; want %q", tt.taken, got, tt.want)
+				}
+			})
+		}
+	})
+}
+
+func TestFixBody(t *testing.T) {
+	t.Parallel()
+	record := failedRecord()
+	record.Tiers[0].Tier = 1
+	record.Tiers[0].Failures = append(record.Tiers[0].Failures, gateslot.TestFailure{Package: "example.com/b", Test: "TestB", FirstLine: "not in the log"})
+	var logLines []string
+	for i := range 40 {
+		logLines = append(logLines, fmt.Sprintf("log line %d", i))
+	}
+	logLines[20] = "a_test.go:12: got 1; want 2"
+	suiteLog := strings.Join(logLines, "\n")
+
+	body := fixBody("alpha", record, suiteLog)
+	for _, want := range []string{
+		"tier1",
+		"- example.com/a TestA: a_test.go:12: got 1; want 2",
+		"log line 18\nlog line 19\na_test.go:12: got 1; want 2",
+		"Stop condition: the failure is a machine failure. Write a stop report naming the exact steps the operator must take on this machine and, as its way forward, a re-run of lym adopt alpha once the machine is settled, never lym loom resume.",
+	} {
+		if !strings.Contains(body, want) {
+			t.Errorf("body = %q; want it to hold %q", body, want)
+		}
+	}
+	if strings.Contains(body, "log line 31") || strings.Contains(body, "log line 17") {
+		t.Errorf("body = %q; want the excerpt bounded to %d lines from 2 before the failed test's first line", body, fixExcerptLines)
+	}
+	if strings.Count(body, "```")/2 != 1 {
+		t.Errorf("body = %q; want one excerpt, since the second test's first line is not in the log", body)
+	}
+
+	many := failedRecord()
+	many.Tiers[0].Failures = nil
+	for i := range maxListedFailures + 3 {
+		many.Tiers[0].Failures = append(many.Tiers[0].Failures, gateslot.TestFailure{Package: "example.com/p", Test: fmt.Sprintf("Test%d", i)})
+	}
+	if got := fixBody("alpha", many, ""); !strings.Contains(got, "and 3 more") || strings.Contains(got, fmt.Sprintf("Test%d", maxListedFailures)) {
+		t.Errorf("body = %q; want the failed tests capped at %d with the remainder counted", got, maxListedFailures)
+	}
+}
diff --git a/internal/adoptcli/green.go b/internal/adoptcli/green.go
new file mode 100644
index 00000000..744363c5
--- /dev/null
+++ b/internal/adoptcli/green.go
@@ -0,0 +1,287 @@
+// green.go is the green end of the adopt check: it lifts the subject's holds, brings its dobby and orch up, starts the lifted runs, resumes the children halted at Finalize's owner check and removes the subject's fix task.
+
+package adoptcli
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/battencli"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/fronttask"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/landingshed"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/machinename"
+	"github.com/Knatte18/loomyard/internal/orchcli"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/tendercli"
+	"github.com/Knatte18/loomyard/internal/tenderengine"
+)
+
+// greenDeps holds the seams of one subject's green end: the subject, its scratch directory, the name of its worktree (the prime's for `root`) and its project (none for `root`).
+// PauseRecord reads the pause record, and Lift lifts the entry a reference names.
+// BeamUp brings up the dobby and orch of the named worktree, leaving a live pair alone.
+// RunRecord reads the batten run record of a slug, reporting false when none exists, and StartFirstPass starts a slug's first pass detached and returns the envelope of that start, where an envelope whose "ok" is false is a refusal.
+// Tasks reads the board's entries, ParentOf names the beam a slug runs under or "" for the prime, and ChildStatus reads the shed status of a slug's own run in its pair, reporting false when it has none.
+// ResumeChild runs `lym loom resume` in the pair of a slug.
+// Owner returns the machine that owns a slug's run when it is not this one, "" otherwise.
+// FrontDeps are the seams a front task's removal reads.
+type greenDeps struct {
+	Subject        string
+	Dir            string
+	Worktree       string
+	Project        string
+	PauseRecord    func() (pauserecord.Record, error)
+	Lift           func(ref tenderengine.EntryRef) error
+	BeamUp         func(worktree string) error
+	RunRecord      func(slug string) (shedengine.Status, bool, error)
+	StartFirstPass func(slug string) (map[string]any, error)
+	Tasks          func() ([]boardengine.Task, error)
+	ParentOf       func(slug string) (string, error)
+	ChildStatus    func(slug string) (shedengine.Status, bool, error)
+	ResumeChild    func(slug string) error
+	Owner          func(slug string) (string, error)
+	FrontDeps      fronttask.Deps
+}
+
+// greenEnd runs the green end of the subject's adopt check and returns one line for each step that failed, each naming its way forward; the other steps go on.
+// It lifts the holds the subject's holds file lists, brings the subject's dobby and orch up, starts the first pass of each lifted run that has a batten run record not done, resumes the children of the subject halted at Finalize's owner check whose run this machine owns, removes the subject's fix task and writes the subject's fix-try count to 0.
+// A released task without a run record is left to the dobby, which starts it once its pause is gone.
+// A hold lifted by hand before the end is gone and lifts nothing, and a start that races the dobby's own pass reads ok, since the pass that loses the driver lock exits on its own.
+func greenEnd(deps greenDeps) []string {
+	lifted, lines := liftHolds(deps)
+
+	if err := deps.BeamUp(deps.Worktree); err != nil {
+		lines = append(lines, fmt.Sprintf("the dobby and orch of %s were not brought up (%v); way forward: fix the cause it names, then run `lym beam start %s`", deps.Subject, err, deps.Subject))
+	}
+	lines = append(lines, startLiftedRuns(deps, lifted)...)
+	lines = append(lines, resumeHaltedChildren(deps)...)
+	lines = append(lines, removeFixTask(deps)...)
+
+	if err := writeTries(deps.Dir, 0); err != nil {
+		lines = append(lines, fmt.Sprintf("the fix-try count of %s was not reset (%v); way forward: re-run lym adopt %s", deps.Subject, err, deps.Subject))
+	}
+	return lines
+}
+
+// liftHolds lifts, by scope, caller and pause time, the live hold entry of each slug the subject's holds file lists, then drops every listed slug from the file in one update.
+// It returns the slugs whose hold it lifted and a line for each failure.
+// A slug a concurrent adopt appended after the read stays listed, for the check of that adopt to lift.
+func liftHolds(deps greenDeps) (lifted, lines []string) {
+	listed, err := readHolds(deps.Dir)
+	if err != nil {
+		return nil, []string{fmt.Sprintf("the holds of %s were not read (%v), so none was lifted; way forward: fix the cause it names, then re-run lym adopt %s", deps.Subject, err, deps.Subject)}
+	}
+	if len(listed) == 0 {
+		return nil, nil
+	}
+	record, err := deps.PauseRecord()
+	if err != nil {
+		return nil, []string{fmt.Sprintf("the pause record was not read (%v), so no hold of %s was lifted; way forward: fix the cause it names, then re-run lym adopt %s", err, deps.Subject, deps.Subject)}
+	}
+
+	for _, slug := range listed {
+		index := slices.IndexFunc(record.Live, func(entry pauserecord.Entry) bool {
+			return entry.Scope == slug && entry.Caller == pauserecord.HoldCaller
+		})
+		if index < 0 {
+			continue
+		}
+		entry := record.Live[index]
+		if err := deps.Lift(tenderengine.EntryRef{Scope: entry.Scope, Caller: entry.Caller, PausedAt: entry.PausedAt}); err != nil {
+			lines = append(lines, fmt.Sprintf("the hold of %s was not lifted (%v); way forward: run `lym tender resume %s`", slug, err, slug))
+			continue
+		}
+		lifted = append(lifted, slug)
+	}
+	if err := removeHolds(deps.Dir, listed); err != nil {
+		lines = append(lines, fmt.Sprintf("the holds file of %s was not cleaned (%v); the next green check of %s drops the slugs it lists", deps.Subject, err, deps.Subject))
+	}
+	return lifted, lines
+}
+
+// startLiftedRuns starts the detached first pass of each slug in lifted whose batten run record exists and is not done, and returns a line for each that did not start.
+func startLiftedRuns(deps greenDeps, lifted []string) []string {
+	var lines []string
+	for _, slug := range lifted {
+		hand := fmt.Sprintf("run `lym batten run %s` from the prime", slug)
+		status, found, err := deps.RunRecord(slug)
+		if err != nil {
+			lines = append(lines, fmt.Sprintf("the batten run record of %s was not read (%v), so its first pass did not start; way forward: %s", slug, err, hand))
+			continue
+		}
+		if !found || status.State == shedengine.StateDone {
+			continue
+		}
+		envelope, err := deps.StartFirstPass(slug)
+		if err != nil {
+			lines = append(lines, fmt.Sprintf("the first pass of %s did not start (%v); way forward: %s", slug, err, hand))
+			continue
+		}
+		if ok, _ := envelope["ok"].(bool); !ok {
+			message, _ := envelope["error"].(string)
+			lines = append(lines, fmt.Sprintf("the first pass of %s was refused (%s); way forward: %s", slug, message, hand))
+		}
+	}
+	return lines
+}
+
+// resumeHaltedChildren runs `lym loom resume` in the pair of each task entry not done that runs directly under the subject, under the prime for `root`, whose run is blocked with a reason opening landingshed.OwnerHaltPrefix and whose effective owner is this machine.
+// A child halted for any other reason, a child under another beam and a child owned by another machine are left alone.
+// It returns a line for each read or resume that failed.
+func resumeHaltedChildren(deps greenDeps) []string {
+	tasks, err := deps.Tasks()
+	if err != nil {
+		return []string{fmt.Sprintf("the board was not read (%v), so no child halted at Finalize's owner check was resumed; way forward: run `lym loom resume` in the pair of each child halted so under %s", err, deps.Subject)}
+	}
+	slugs := make([]string, 0, len(tasks))
+	for _, task := range tasks {
+		if task.Kind == boardengine.KindTask && !entryDone(task) {
+			slugs = append(slugs, task.Slug)
+		}
+	}
+	slices.Sort(slugs)
+
+	var lines []string
+	for _, slug := range slugs {
+		resume := fmt.Sprintf("run `lym loom resume` in the pair of %s", slug)
+		parent, err := deps.ParentOf(slug)
+		if err != nil {
+			lines = append(lines, fmt.Sprintf("the parent of %s was not read (%v), so it was not checked for a halt at Finalize's owner check; way forward: if it is halted so, %s", slug, err, resume))
+			continue
+		}
+		if (parent == "" && deps.Subject != boardengine.RootSubject) || (parent != "" && parent != deps.Subject) {
+			continue
+		}
+		status, found, err := deps.ChildStatus(slug)
+		if err != nil {
+			lines = append(lines, fmt.Sprintf("the status of %s was not read (%v), so it was not checked for a halt at Finalize's owner check; way forward: if it is halted so, %s", slug, err, resume))
+			continue
+		}
+		if !found || status.State != shedengine.StateBlocked || !strings.HasPrefix(status.Error, landingshed.OwnerHaltPrefix) {
+			continue
+		}
+		owner, err := deps.Owner(slug)
+		if err != nil {
+			lines = append(lines, fmt.Sprintf("the owner of %s was not read (%v), so its halt at Finalize's owner check was not resumed; way forward: %s", slug, err, resume))
+			continue
+		}
+		if owner != "" {
+			continue
+		}
+		if err := deps.ResumeChild(slug); err != nil {
+			lines = append(lines, fmt.Sprintf("the run of %s halted at Finalize's owner check was not resumed (%v); way forward: %s", slug, err, resume))
+		}
+	}
+	return lines
+}
+
+// removeFixTask removes the subject's adopt-check front task, in whatever status it stands not done, and returns a line when its removal fails.
+// The removal ends a running task's run first, and the line carries the failing step's error with the command that finishes it by hand.
+func removeFixTask(deps greenDeps) []string {
+	tasks, err := deps.Tasks()
+	if err != nil {
+		return []string{fmt.Sprintf("the board was not read (%v), so the fix task of %s was not looked for; way forward: re-run lym adopt %s", err, deps.Subject, deps.Subject)}
+	}
+	task, found := fronttask.FrontOf(tasks, deps.Project, fronttask.ActionAdoptCheck)
+	if !found {
+		return nil
+	}
+	if err := fronttask.Remove(deps.FrontDeps, task.Slug); err != nil {
+		var removal *fronttask.RemoveError
+		if errors.As(err, &removal) {
+			return []string{fmt.Sprintf("the fix task %s of %s was not removed: the %s step failed (%v); way forward: %s", task.Slug, deps.Subject, removal.Step, removal.Err, removal.HandRemoval())}
+		}
+		return []string{fmt.Sprintf("the fix task %s of %s was not removed (%v); way forward: run `lym batten cancel %s --remove`, then `lym board remove %s`", task.Slug, deps.Subject, err, task.Slug, task.Slug)}
+	}
+	return nil
+}
+
+// entryDone reports whether task carries the done status.
+func entryDone(task boardengine.Task) bool {
+	return task.Status != nil && *task.Status == "done"
+}
+
+// hubGreenDeps fills greenDeps for the green end of subject over the hub of prime.
+// The subject's worktree is the prime for `root` and the beam's pair otherwise, and its project is empty for `root`.
+func hubGreenDeps(prime *lymcwd.Location, subject string) (greenDeps, error) {
+	frontDeps, err := fronttask.HubDeps(prime)
+	if err != nil {
+		return greenDeps{}, err
+	}
+	boardDir := fabricengine.BoardDir(prime.HubPath)
+	parentOf := func(slug string) (string, error) { return hubgeom.ParentOf(prime, slug) }
+	worktree, project := prime.WorktreeName, ""
+	if subject != boardengine.RootSubject {
+		worktree, project = subject, subject
+	}
+	return greenDeps{
+		Subject:  subject,
+		Dir:      subjectDir(prime.HubPath, subject),
+		Worktree: worktree,
+		Project:  project,
+		PauseRecord: func() (pauserecord.Record, error) {
+			geometry, err := hubgeom.PauseGeometry(prime)
+			if err != nil {
+				return pauserecord.Record{}, err
+			}
+			return pauserecord.Read(geometry.RecordPath)
+		},
+		Lift: func(ref tenderengine.EntryRef) error {
+			deps, _, err := tendercli.HubDeps(prime, callerLabel)
+			if err != nil {
+				return err
+			}
+			_, err = tenderengine.Lift(deps, ref)
+			return err
+		},
+		BeamUp: func(worktree string) error { return orchcli.BeamUpWorktree(prime, worktree) },
+		RunRecord: func(slug string) (shedengine.Status, bool, error) {
+			return readStatus(shedrun.StatusFile(prime, slug))
+		},
+		StartFirstPass: func(slug string) (map[string]any, error) {
+			return battencli.StartFirstPass(prime, slug, battencli.FirstPassOptions{})
+		},
+		Tasks:    func() ([]boardengine.Task, error) { return boardengine.ReadTasks(boardDir) },
+		ParentOf: parentOf,
+		ChildStatus: func(slug string) (shedengine.Status, bool, error) {
+			pairPath := fabricengine.WorktreePath(prime, slug)
+			if _, err := os.Stat(pairPath); errors.Is(err, fs.ErrNotExist) {
+				return shedengine.Status{}, false, nil
+			}
+			pair, err := lymcwd.ResolveWorktree(pairPath)
+			if err != nil {
+				return shedengine.Status{}, false, err
+			}
+			return readStatus(shedrun.StatusFile(pair, shedrun.SelfRunID))
+		},
+		ResumeChild: func(slug string) error { return resumeChild(fabricengine.WorktreePath(prime, slug)) },
+		Owner: func(slug string) (string, error) {
+			owners, err := boardengine.ReadOwners(boardDir)
+			if err != nil {
+				return "", err
+			}
+			here, err := machinename.Name()
+			if err != nil {
+				return "", err
+			}
+			owner, err := owners.Effective(slug, parentOf)
+			if err != nil {
+				return "", err
+			}
+			if !boardengine.OwnedElsewhere(owner, here) {
+				return "", nil
+			}
+			return owner, nil
+		},
+		FrontDeps: frontDeps,
+	}, nil
+}
diff --git a/internal/adoptcli/green_test.go b/internal/adoptcli/green_test.go
new file mode 100644
index 00000000..7dc390d5
--- /dev/null
+++ b/internal/adoptcli/green_test.go
@@ -0,0 +1,414 @@
+//go:build tier0
+
+// green_test.go pins the green end of the adopt check over fake seams and a temp subject directory: the lifts, the pair, the first passes, the resumed children, the fix task's removal and the try count.
+
+package adoptcli
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fronttask"
+	"github.com/Knatte18/loomyard/internal/landingshed"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/tenderengine"
+)
+
+// greenHoldTime is the pause time every hold entry of a green fixture carries.
+var greenHoldTime = time.Date(2026, 11, 1, 9, 0, 0, 0, time.UTC)
+
+// greenFixture is a greenEnd over a temp adopt directory holding the subject `alpha` and a second subject `beta`, with every seam faked and recording its calls.
+type greenFixture struct {
+	t        *testing.T
+	deps     greenDeps
+	root     string
+	dir      string
+	otherDir string
+
+	record     pauserecord.Record
+	liftErrs   map[string]error
+	lifted     []string
+	beamUps    []string
+	beamUpErr  error
+	runRecords map[string]shedengine.Status
+	started    []string
+	envelopes  map[string]map[string]any
+	tasks      []boardengine.Task
+	parents    map[string]string
+	children   map[string]shedengine.Status
+	owners     map[string]string
+	resumed    []string
+	resumeErrs map[string]error
+	statusErrs map[string]error
+
+	cancelled      []string
+	cancelErr      error
+	removedEntries []string
+	removeEntryErr error
+	// afterPauseRead runs when the pause record is read, which is after the holds file was read.
+	afterPauseRead func()
+}
+
+func newGreenFixture(t *testing.T) *greenFixture {
+	t.Helper()
+	root := t.TempDir()
+	f := &greenFixture{
+		t: t, root: root, dir: filepath.Join(root, "alpha"), otherDir: filepath.Join(root, "beta"),
+		liftErrs: map[string]error{}, runRecords: map[string]shedengine.Status{}, envelopes: map[string]map[string]any{},
+		parents: map[string]string{}, children: map[string]shedengine.Status{}, owners: map[string]string{}, resumeErrs: map[string]error{}, statusErrs: map[string]error{},
+	}
+	f.deps = greenDeps{
+		Subject:  "alpha",
+		Dir:      f.dir,
+		Worktree: "alpha",
+		Project:  "alpha",
+		PauseRecord: func() (pauserecord.Record, error) {
+			if f.afterPauseRead != nil {
+				f.afterPauseRead()
+			}
+			return f.record, nil
+		},
+		Lift: func(ref tenderengine.EntryRef) error {
+			if err := f.liftErrs[ref.Scope]; err != nil {
+				return err
+			}
+			if ref.Caller != pauserecord.HoldCaller || !ref.PausedAt.Equal(greenHoldTime) {
+				t.Errorf("Lift(%+v); want the hold caller and the entry's pause time", ref)
+			}
+			f.lifted = append(f.lifted, ref.Scope)
+			return nil
+		},
+		BeamUp: func(worktree string) error {
+			f.beamUps = append(f.beamUps, worktree)
+			return f.beamUpErr
+		},
+		RunRecord: func(slug string) (shedengine.Status, bool, error) {
+			status, found := f.runRecords[slug]
+			return status, found, nil
+		},
+		StartFirstPass: func(slug string) (map[string]any, error) {
+			f.started = append(f.started, slug)
+			if envelope, refused := f.envelopes[slug]; refused {
+				return envelope, nil
+			}
+			return map[string]any{"ok": true}, nil
+		},
+		Tasks:    func() ([]boardengine.Task, error) { return f.tasks, nil },
+		ParentOf: func(slug string) (string, error) { return f.parents[slug], nil },
+		ChildStatus: func(slug string) (shedengine.Status, bool, error) {
+			if err := f.statusErrs[slug]; err != nil {
+				return shedengine.Status{}, false, err
+			}
+			status, found := f.children[slug]
+			return status, found, nil
+		},
+		ResumeChild: func(slug string) error {
+			if err := f.resumeErrs[slug]; err != nil {
+				return err
+			}
+			f.resumed = append(f.resumed, slug)
+			return nil
+		},
+		Owner: func(slug string) (string, error) { return f.owners[slug], nil },
+		FrontDeps: fronttask.Deps{
+			Tasks: func() ([]boardengine.Task, error) { return f.tasks, nil },
+			HasRun: func(slug string) (bool, error) {
+				for _, task := range f.tasks {
+					if task.Slug == slug {
+						return boardengine.IsRunStatus(task.Status), nil
+					}
+				}
+				return false, nil
+			},
+			Cancel: func(_ context.Context, slug string) error {
+				f.cancelled = append(f.cancelled, slug)
+				return f.cancelErr
+			},
+			RemoveEntry: func(slug string) error {
+				if f.removeEntryErr != nil {
+					return f.removeEntryErr
+				}
+				f.removedEntries = append(f.removedEntries, slug)
+				return nil
+			},
+			RecordPath: filepath.Join(root, "front-records.json"),
+		},
+	}
+	return f
+}
+
+// hold lists slugs in the holds file of dir, and gives each of them a live hold entry when entry is set.
+func (f *greenFixture) hold(dir string, entry bool, slugs ...string) {
+	f.t.Helper()
+	if err := appendHolds(dir, slugs); err != nil {
+		f.t.Fatalf("appendHolds(%s): %v", dir, err)
+	}
+	if entry {
+		for _, slug := range slugs {
+			f.record.Live = append(f.record.Live, pauserecord.Entry{Scope: slug, PausedAt: greenHoldTime, GraceEnd: greenHoldTime, Caller: pauserecord.HoldCaller})
+		}
+	}
+}
+
+func (f *greenFixture) holds(dir string) []string {
+	f.t.Helper()
+	got, err := readHolds(dir)
+	if err != nil {
+		f.t.Fatalf("readHolds(%s): %v", dir, err)
+	}
+	return got
+}
+
+// fixTask returns the front task of alpha's adopt check with status.
+func fixTask(slug string, status *string) boardengine.Task {
+	return boardengine.Task{Slug: slug, Kind: boardengine.KindTask, Front: true, OnLand: fronttask.ActionAdoptCheck, Project: "alpha", Status: status}
+}
+
+func statusOf(text string) *string { return &text }
+
+func mentions(lines []string, wants ...string) bool {
+	return slices.ContainsFunc(lines, func(line string) bool {
+		for _, want := range wants {
+			if !strings.Contains(line, want) {
+				return false
+			}
+		}
+		return true
+	})
+}
+
+func TestGreenEnd(t *testing.T) {
+	t.Parallel()
+
+	t.Run("lifts the standing holds of its subject and leaves the holds appended meanwhile and another subject's", func(t *testing.T) {
+		t.Parallel()
+		f := newGreenFixture(t)
+		f.hold(f.dir, true, "t1", "t2")
+		f.hold(f.otherDir, true, "x1")
+		f.afterPauseRead = func() { f.hold(f.dir, true, "t3") }
+
+		if lines := greenEnd(f.deps); len(lines) != 0 {
+			t.Errorf("greenEnd() = %q; want no line", lines)
+		}
+		if !slices.Equal(f.lifted, []string{"t1", "t2"}) {
+			t.Errorf("lifted = %q; want t1, t2", f.lifted)
+		}
+		if got := f.holds(f.dir); !slices.Equal(got, []string{"t3"}) {
+			t.Errorf("holds of alpha = %q; want only t3, appended after the read", got)
+		}
+		if got := f.holds(f.otherDir); !slices.Equal(got, []string{"x1"}) {
+			t.Errorf("holds of beta = %q; want x1 left", got)
+		}
+	})
+
+	t.Run("a hold lifted by hand meanwhile is skipped and its run is not started", func(t *testing.T) {
+		t.Parallel()
+		f := newGreenFixture(t)
+		f.hold(f.dir, true, "t1")
+		f.hold(f.dir, false, "t2")
+		f.runRecords["t1"] = shedengine.Status{State: shedengine.StatePaused}
+		f.runRecords["t2"] = shedengine.Status{State: shedengine.StatePaused}
+
+		if lines := greenEnd(f.deps); len(lines) != 0 {
+			t.Errorf("greenEnd() = %q; want no line", lines)
+		}
+		if !slices.Equal(f.lifted, []string{"t1"}) || !slices.Equal(f.started, []string{"t1"}) {
+			t.Errorf("lifted = %q, started = %q; want only t1", f.lifted, f.started)
+		}
+		if got := f.holds(f.dir); len(got) != 0 {
+			t.Errorf("holds = %q; want both listed slugs dropped", got)
+		}
+	})
+
+	t.Run("a failed lift names the hand resume and the other steps go on", func(t *testing.T) {
+		t.Parallel()
+		f := newGreenFixture(t)
+		f.hold(f.dir, true, "t1", "t2")
+		f.liftErrs["t1"] = errors.New("pause record locked")
+
+		lines := greenEnd(f.deps)
+		if !mentions(lines, "lym tender resume t1", "pause record locked") {
+			t.Errorf("greenEnd() = %q; want a line naming `lym tender resume t1`", lines)
+		}
+		if !slices.Equal(f.lifted, []string{"t2"}) || !slices.Equal(f.beamUps, []string{"alpha"}) {
+			t.Errorf("lifted = %q, beam ups = %q; want t2 lifted and the pair brought up", f.lifted, f.beamUps)
+		}
+	})
+
+	t.Run("a failed pair bring-up names lym beam start", func(t *testing.T) {
+		t.Parallel()
+		f := newGreenFixture(t)
+		f.beamUpErr = errors.New("no tmux")
+
+		if lines := greenEnd(f.deps); !mentions(lines, "lym beam start alpha", "no tmux") {
+			t.Errorf("greenEnd() = %q; want a line naming `lym beam start alpha`", lines)
+		}
+	})
+
+	t.Run("starts a first pass per lifted run with a record and none for a released task or a done run, a refusal naming the hand pass", func(t *testing.T) {
+		t.Parallel()
+		f := newGreenFixture(t)
+		f.hold(f.dir, true, "run", "released", "finished", "refused")
+		f.runRecords["run"] = shedengine.Status{State: shedengine.StatePaused}
+		f.runRecords["finished"] = shedengine.Status{State: shedengine.StateDone}
+		f.runRecords["refused"] = shedengine.Status{State: shedengine.StatePaused}
+		f.envelopes["refused"] = map[string]any{"ok": false, "error": "run status covers it"}
+
+		lines := greenEnd(f.deps)
+		if want := []string{"run", "refused"}; !slices.Equal(f.started, want) {
+			t.Errorf("started = %q; want %q", f.started, want)
+		}
+		if len(lines) != 1 || !mentions(lines, "lym batten run refused", "run status covers it") {
+			t.Errorf("greenEnd() = %q; want one line naming `lym batten run refused`", lines)
+		}
+	})
+
+	t.Run("resumes the children of its subject halted at Finalize's owner check that this machine owns", func(t *testing.T) {
+		t.Parallel()
+		ownerHalt := shedengine.Status{State: shedengine.StateBlocked, Error: landingshed.OwnerHaltPrefix + "the parent is owned elsewhere"}
+		tests := []struct {
+			name        string
+			subject     string
+			child       string
+			status      shedengine.Status
+			parent      string
+			owner       string
+			wantResumed bool
+		}{
+			{"HaltedUnderTheSubject", "alpha", "c1", ownerHalt, "alpha", "", true},
+			{"HaltedForAnotherReason", "alpha", "c1", shedengine.Status{State: shedengine.StateBlocked, Error: "tests failed"}, "alpha", "", false},
+			{"NotBlocked", "alpha", "c1", shedengine.Status{State: shedengine.StateRunning}, "alpha", "", false},
+			{"UnderAnotherBeam", "alpha", "c1", ownerHalt, "beta", "", false},
+			{"UnderThePrimeWhileTheSubjectIsABeam", "alpha", "c1", ownerHalt, "", "", false},
+			{"OwnedByAnotherMachine", "alpha", "c1", ownerHalt, "alpha", "otherbox", false},
+			{"UnderThePrimeForRoot", "root", "c1", ownerHalt, "", "", true},
+			{"UnderABeamForRoot", "root", "c1", ownerHalt, "alpha", "", false},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				f := newGreenFixture(t)
+				f.deps.Subject = tt.subject
+				f.tasks = []boardengine.Task{{Slug: tt.child, Kind: boardengine.KindTask}}
+				f.children[tt.child] = tt.status
+				f.parents[tt.child] = tt.parent
+				f.owners[tt.child] = tt.owner
+
+				if lines := greenEnd(f.deps); len(lines) != 0 {
+					t.Errorf("greenEnd() = %q; want no line", lines)
+				}
+				if got := slices.Contains(f.resumed, tt.child); got != tt.wantResumed {
+					t.Errorf("resumed = %q; want %s resumed: %v", f.resumed, tt.child, tt.wantResumed)
+				}
+			})
+		}
+
+		t.Run("AFailedStatusReadOfAnotherSubjectsChildAddsNoLine", func(t *testing.T) {
+			t.Parallel()
+			f := newGreenFixture(t)
+			f.tasks = []boardengine.Task{{Slug: "c1", Kind: boardengine.KindTask}, {Slug: "c2", Kind: boardengine.KindTask}}
+			f.parents["c1"] = "beta"
+			f.statusErrs["c1"] = errors.New("status unreadable")
+			f.parents["c2"] = "alpha"
+			f.statusErrs["c2"] = errors.New("own status unreadable")
+
+			lines := greenEnd(f.deps)
+			if mentions(lines, "c1") {
+				t.Errorf("greenEnd() = %q; want no line naming c1, a child of another subject", lines)
+			}
+			if !mentions(lines, "status of c2", "own status unreadable") {
+				t.Errorf("greenEnd() = %q; want a line for the unreadable status of c2, a child of this subject", lines)
+			}
+		})
+
+		t.Run("AFailedResumeNamesLymLoomResume", func(t *testing.T) {
+			t.Parallel()
+			f := newGreenFixture(t)
+			f.tasks = []boardengine.Task{{Slug: "c1", Kind: boardengine.KindTask}}
+			f.children["c1"] = ownerHalt
+			f.parents["c1"] = "alpha"
+			f.resumeErrs["c1"] = errors.New("exit 1")
+
+			if lines := greenEnd(f.deps); !mentions(lines, "`lym loom resume` in the pair of c1", "exit 1") {
+				t.Errorf("greenEnd() = %q; want a line naming `lym loom resume` in c1's pair", lines)
+			}
+		})
+	})
+
+	t.Run("removes the fix task in whatever status it stands, ending a running one first", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name       string
+			status     *string
+			wantCancel bool
+		}{
+			{"Draft", statusOf("draft"), false},
+			{"ReleasedThatNeverStarted", nil, false},
+			{"Running", statusOf(boardengine.RunStatus("running", "Code-Write")), true},
+			{"Halted", statusOf(boardengine.RunStatus("blocked", "Code-Write")), true},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				f := newGreenFixture(t)
+				f.tasks = []boardengine.Task{fixTask("adopt-fix-alpha-t1", tt.status)}
+
+				if lines := greenEnd(f.deps); len(lines) != 0 {
+					t.Errorf("greenEnd() = %q; want no line", lines)
+				}
+				if !slices.Equal(f.removedEntries, []string{"adopt-fix-alpha-t1"}) || (len(f.cancelled) == 1) != tt.wantCancel {
+					t.Errorf("removed = %q, cancelled = %q; want the entry removed, cancelled: %v", f.removedEntries, f.cancelled, tt.wantCancel)
+				}
+			})
+		}
+
+		t.Run("ADoneFixTaskAndAnotherProjectsAreLeft", func(t *testing.T) {
+			t.Parallel()
+			f := newGreenFixture(t)
+			other := fixTask("adopt-fix-beta-t1", nil)
+			other.Project = "beta"
+			f.tasks = []boardengine.Task{fixTask("adopt-fix-alpha-t1", statusOf("done")), other}
+
+			if lines := greenEnd(f.deps); len(lines) != 0 || len(f.removedEntries) != 0 {
+				t.Errorf("greenEnd() = %q, removed = %q; want nothing removed", lines, f.removedEntries)
+			}
+		})
+
+		t.Run("AFailedRemovalNamesItsHandRemoval", func(t *testing.T) {
+			t.Parallel()
+			f := newGreenFixture(t)
+			f.tasks = []boardengine.Task{fixTask("adopt-fix-alpha-t1", nil)}
+			f.removeEntryErr = errors.New("board locked")
+
+			if lines := greenEnd(f.deps); !mentions(lines, "adopt-fix-alpha-t1", "board locked", "`lym board remove adopt-fix-alpha-t1`") {
+				t.Errorf("greenEnd() = %q; want a line with the step's error and its hand removal", lines)
+			}
+		})
+	})
+
+	t.Run("writes the try count to 0", func(t *testing.T) {
+		t.Parallel()
+		f := newGreenFixture(t)
+		if err := writeTries(f.dir, 2); err != nil {
+			t.Fatal(err)
+		}
+		if err := writeTries(f.otherDir, 2); err != nil {
+			t.Fatal(err)
+		}
+
+		greenEnd(f.deps)
+		if got, err := readTries(f.dir); err != nil || got != 0 {
+			t.Errorf("readTries(alpha) = %d, %v; want 0", got, err)
+		}
+		if got, err := readTries(f.otherDir); err != nil || got != 2 {
+			t.Errorf("readTries(beta) = %d, %v; want its 2 left", got, err)
+		}
+	})
+}
