+	here := fabricengine.MachineNames{Current: "neve"}
+
+	t.Run("EntryNamingAnotherMachineReturnsATakeoverErrorAndPushesNothing", func(t *testing.T) {
+		d := newDivergedPair(t, slug, entry)
