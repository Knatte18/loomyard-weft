-			var blocks []string
-			if len(s.variables) == 0 {
-				if key, ok := blockAt(f.name, s.start); ok {
-					blocks = []string{key}
-				}
-			} else {
-				for _, variable := range s.variables {
-					blocks = append(blocks, slices.Collect(maps.Keys(readers[variable]))...)
-				}
-				slices.Sort(blocks)
-				blocks = slices.Compact(blocks)
-			}
