+| ([ $all[] | select(.type=="user") | .message.content | if type=="array" then .[] | select(.type=="tool_result") | (.content|rtext) else empty end ] | map(select(test("# Webster implementer job"))) | .[0]) as $p
+| if $p == null then empty else
+([ $all[] | select(.type=="user" and (.message.content|type)=="string") | .message.content ] | map(select(test("^Load these skills")|not)) | .[0] // "") as $first
+| ($p | split("## Your cards")[1] // "" | split("For EACH card")[0]) as $cs
+| ([ $cs | split("\n")[] | select(test("- `_lyx/plan/\\d+-")) ] | length) as $cards
+| ($p | test("## Kick-start pack")) as $pack
+| ($p | split("## Kick-start pack")[1] // "" | split("### Unresolved")) as $ps
+| ([ ($ps[0]//"") | split("\n")[] | select(test("^\\s*\\d+\\t- `")) ] | length) as $pres
+| ([ ($ps[1]//"") | split("\n")[] | select(test("^\\s*\\d+\\t- `")) ] | length) as $punres
+| ([ $all[] | select(.type=="assistant") | .message.content[]? | select(.type=="tool_use") ]) as $tu0
+| ($tu0 | map(select(.name!="Skill" and .name!="Agent"))) as $tu1
+| (if ($tu1|length)>0 and $tu1[0].name=="Read" and (($tu1[0].input.file_path//"")|test("prompt\\.md$|/webster/prompts/")) then $tu1[1:] else $tu1 end) as $tu
+| ([ $tu | to_entries[] | select(.value.name|test("^(Edit|Write|MultiEdit|NotebookEdit)$")) | .key ] | .[0]) as $fe
+| ($tu | if $fe==null then . else .[0:$fe] end) as $pre
+| (reduce $tu[] as $t ({ex:true, n:0, g:0, r:0, segs:0};
+    if ($t.name|test("^(Edit|Write|MultiEdit|NotebookEdit)$")) then (if .ex then .segs+=1 else . end) | .ex=false
+    elif ($t.name=="Bash" and (($t.input.command//"")|test("git commit"))) then .ex=true
+    elif .ex then .n+=1 | .g += ([$t|cls[]|select(.=="grep")]|length) | .r += ([$t|cls[]|select(.=="rfull" or .=="rpart")]|length)
+    else . end)) as $ex
+| ([ $tu[] | cls[] ]) as $c
+| ([ $pre[] | cls[] ]) as $cp
+| def cnt($a; $k): $a | map(select(.==$k)) | length;
+  ([ $all[] | select(.type=="assistant" and .message.id!=null) ] | group_by(.message.id) | map(.[-1])) as $msgs
+| { proj: (input_filename|split("/")|map(select(startswith("-home")))[0]|sub("-home-knatte-Code-loomyard-LYXHUB-";"")), fork: (input_filename|test("/subagents/")), sid: (input_filename|sub("^\\./";"")),
+    start: ($all|map(.timestamp//empty)|min),
+    model: ($msgs|map(.message.model)|unique|map(select(.!="<synthetic>"))|join(",")), pack: $pack, pack_res: $pres, pack_unres: $punres, cards: $cards, shuttle: ($first|test("prompt\\.md")),
+    tools: ($tu|length), pre_edit: $fe,
+    grep: cnt($c;"grep"), grep_pre: cnt($cp;"grep"), gmem: cnt($c;"gmem"), gmem_pre: cnt($cp;"gmem"), quarry: cnt($c;"quarry"), quarry_pre: cnt($cp;"quarry"),
+    rfull: cnt($c;"rfull"), rpart: cnt($c;"rpart"), rfull_pre: cnt($cp;"rfull"), rpart_pre: cnt($cp;"rpart"),
+    turns: ($msgs|length), ex_tools: $ex.n, ex_grep: $ex.g, ex_reads: $ex.r, ex_segs: $ex.segs,
+    out: ($msgs|map(.message.usage.output_tokens//0)|add),
+    fresh_in: ($msgs|map((.message.usage.input_tokens//0)+(.message.usage.cache_creation_input_tokens//0))|add),
+    cache_read: ($msgs|map(.message.usage.cache_read_input_tokens//0)|add) }
+end
diff --git a/docs/research/glyph/glyph-audit-2026-10-12/report.md b/docs/research/glyph/glyph-audit-2026-10-12/report.md
new file mode 100644
index 00000000..8c434daf
--- /dev/null
+++ b/docs/research/glyph/glyph-audit-2026-10-12/report.md
@@ -0,0 +1,22 @@
+# Webster kick-start pack audit, 2026-10-12
+
+Pack on: 35 implementer forks over 11 runs (150 cards); pack off: 113 forks over 43 runs (508 cards), 2026-10-08 to 2026-10-11; all on Sonnet.
+
+- No measurable gain: calls before the first edit (median 6 on, 7 off), exploration calls per card (5.8 on, 5.9 off), turns and tokens are all within noise.
+- The one consistent signal is about 20% fewer whole-file reads and greps, offset by more partial reads: pack spans replace whole-file reads rather than cutting exploration.
+- Forks never used quarry lookups either way.
+- Main confounder: forks inherit the Master's orientation, so a fork explores only about 6 calls before its first edit; most exploration is in the Master, which the pack does not reach.
+  Pack quality also varies widely (1 to 144 resolved entries, up to 41 unresolved).
+
+Verdict: the evidence did not justify building the Burler side of the pack.
+The follow-up audits are `glyph-audit-2026-10-13` and `glyph-audit-2026-10-15`; `tools/forkaudit` makes the measurement repeatable.
+
+## Files
+
+`extract.jq` is the per-transcript extractor, `sessions.tsv` its collected output (one row per fork), and `stats.jq` the pack-on versus pack-off medians and means.
+They are copies from the scratch directory `.scratch/kickstart-measure/`.
+
+## Running
+
+`jq -s -c -f extract.jq <transcript>` per fork transcript, concatenated; `jq -s -r --arg from <ISO timestamp> -f stats.jq <records>` for the comparison.
+The transcript list and the `$from` value used are not recorded.
