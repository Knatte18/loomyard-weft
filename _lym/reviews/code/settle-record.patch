diff --git a/internal/loomcli/fixerendguard.go b/internal/loomcli/fixerendguard.go
new file mode 100644
index 00000000..ff42513a
--- /dev/null
+++ b/internal/loomcli/fixerendguard.go
@@ -0,0 +1,66 @@
+// fixerendguard.go wraps loom's goto guard so that a move of the run onto a row ends every gate fixer registered under the pair before the move is written.
+
+package loomcli
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gatefixer"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// endGateFixers ends every process of each gatefixer role that the pair named by slug has registered under runProcDir, through end, sparing the calling process.
+// An empty slug, the prime's or one outside a hub, ends nothing.
+// A slug read error, and an end that fails, are returned wrapping their cause; the caller's guard check adds the way forward.
+func endGateFixers(runProcDir string, slug func() (string, error), end func(dir, owner, role string, callerPID int) ([]runproc.Ended, error)) error {
+	owner, err := slug()
+	if err != nil {
+		return fmt.Errorf("loomcli: read the pair slug to end its gate fixers: %w", err)
+	}
+	if owner == "" {
+		return nil
+	}
+	for _, role := range gatefixer.Roles() {
+		if _, err := end(runProcDir, owner, role, os.Getpid()); err != nil {
+			return fmt.Errorf("loomcli: end the %s processes of pair %s: %w", role, owner, err)
+		}
+	}
+	return nil
+}
+
+// fixerEndingGuard returns a goto guard that runs inner and, only when inner admits the target, calls endFixers before the move is written.
+// A refusal or error from inner is returned unchanged and ends nothing; an endFixers error is returned as the guard's error, so the move is refused and the run stays where it is.
+func fixerEndingGuard(inner shedengine.GotoGuard, endFixers func() error) shedengine.GotoGuard {
+	return func(target string) (string, error) {
+		refusal, err := inner(target)
+		if err != nil || refusal != "" {
+			return refusal, err
+		}
+		if err := endFixers(); err != nil {
+			return "", err
+		}
+		return "", nil
+	}
+}
+
+// gotoGuardEndingFixers wraps inner so a goto it admits first ends this worktree's gate fixers.
+// Every site that moves the run onto a row builds its guard through it.
+func (c *loomCLI) gotoGuardEndingFixers(inner shedengine.GotoGuard) shedengine.GotoGuard {
+	end := c.endRunFixers
+	if c.endFixers != nil {
+		end = c.endFixers
+	}
+	return fixerEndingGuard(inner, end)
+}
+
+// endRunFixers ends every gate fixer registered under this worktree's pair.
+// A receiver with no location ends nothing.
+func (c *loomCLI) endRunFixers() error {
+	if c.location == nil {
+		return nil
+	}
+	return endGateFixers(fabricengine.RunProcDir(c.location.HubPath), func() (string, error) { return pairSlugOf(c.location) }, runproc.EndRole)
+}
diff --git a/internal/loomcli/fixerendguard_test.go b/internal/loomcli/fixerendguard_test.go
new file mode 100644
index 00000000..a4723df4
--- /dev/null
+++ b/internal/loomcli/fixerendguard_test.go
@@ -0,0 +1,151 @@
+// fixerendguard_test.go covers the goto guard that ends a pair's gate fixers once a move is admitted.
+
+package loomcli
+
+import (
+	"errors"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/gatefixer"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// endCall is one recorded call of an end seam.
+type endCall struct {
+	dir, owner, role string
+	callerPID        int
+}
+
+// TestEndGateFixers covers which processes a pair's fixer end reaches: each fixer role under the owner with the caller's pid, nothing for an empty slug, and the errors of the slug read and of an end.
+func TestEndGateFixers(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	slugOf := func(slug string, err error) func() (string, error) {
+		return func() (string, error) { return slug, err }
+	}
+	failFirst := errors.New("end refused")
+	tests := []struct {
+		name      string
+		slug      func() (string, error)
+		endErr    error
+		wantCalls []endCall
+		wantErr   string
+	}{
+		{
+			name: "ends every fixer role under the owner",
+			slug: slugOf("pair", nil),
+			wantCalls: []endCall{
+				{"run-procs", "pair", gatefixer.Roles()[0], os.Getpid()},
+				{"run-procs", "pair", gatefixer.Roles()[1], os.Getpid()},
+			},
+		},
+		{name: "an empty slug ends nothing", slug: slugOf("", nil)},
+		{name: "a slug read error is returned and ends nothing", slug: slugOf("", errors.New("origin unreadable")), wantErr: "origin unreadable"},
+		{
+			name:      "an error from the first role stops the loop and names the role",
+			slug:      slugOf("pair", nil),
+			endErr:    failFirst,
+			wantCalls: []endCall{{"run-procs", "pair", gatefixer.Roles()[0], os.Getpid()}},
+			wantErr:   gatefixer.Roles()[0],
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			var calls []endCall
+			end := func(dir, owner, role string, callerPID int) ([]runproc.Ended, error) {
+				calls = append(calls, endCall{dir, owner, role, callerPID})
+				return nil, tt.endErr
+			}
+
+			err := endGateFixers("run-procs", tt.slug, end)
+
+			if tt.wantErr == "" && err != nil {
+				t.Fatalf("endGateFixers() = %v; want nil", err)
+			}
+			if tt.wantErr != "" && (err == nil || !strings.Contains(err.Error(), tt.wantErr)) {
+				t.Errorf("endGateFixers() = %v; want an error naming %q", err, tt.wantErr)
+			}
+			if tt.endErr != nil && !errors.Is(err, tt.endErr) {
+				t.Errorf("endGateFixers() = %v; want it to wrap %v", err, tt.endErr)
+			}
+			if !slices.Equal(calls, tt.wantCalls) {
+				t.Errorf("end calls = %v; want %v", calls, tt.wantCalls)
+			}
+		})
+	}
+}
+
+// TestFixerEndingGuard covers when the wrapped goto guard ends the fixers: only once the inner guard admits, with the fixers' end error refusing the move, and a receiver with no location ending nothing.
+func TestFixerEndingGuard(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	endFailure := errors.New("fixer survived")
+	innerFailure := errors.New("cannot decide")
+	tests := []struct {
+		name        string
+		refusal     string
+		innerErr    error
+		endErr      error
+		wantRefusal string
+		wantErr     error
+		wantEnds    int
+	}{
+		{name: "an admitting inner ends the fixers once and admits", wantEnds: 1},
+		{name: "a refusing inner is returned and ends nothing", refusal: "settled", wantRefusal: "settled"},
+		{name: "an inner error is returned and ends nothing", innerErr: innerFailure, wantErr: innerFailure},
+		{name: "an end error is the guard's error", endErr: endFailure, wantErr: endFailure, wantEnds: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			ends := 0
+			guard := fixerEndingGuard(
+				func(string) (string, error) { return tt.refusal, tt.innerErr },
+				func() error { ends++; return tt.endErr },
+			)
+
+			refusal, err := guard("Plan-Write")
+
+			if refusal != tt.wantRefusal || !errors.Is(err, tt.wantErr) {
+				t.Errorf("guard() = %q, %v; want %q, %v", refusal, err, tt.wantRefusal, tt.wantErr)
+			}
+			if ends != tt.wantEnds {
+				t.Errorf("fixers ended %d times; want %d", ends, tt.wantEnds)
+			}
+		})
+	}
+
+	t.Run("the guard specFor builds ends the fixers once the goto is admitted", func(t *testing.T) {
+		t.Parallel()
+		ends := 0
+		c := &loomCLI{
+			location:  &lymcwd.Location{HubPath: t.TempDir(), WorktreeName: "pair", AnchorRel: "."},
+			runID:     "self",
+			endFixers: func() error { ends++; return nil },
+		}
+
+		refusal, err := c.specFor("step").GotoGuard("Plan-Write")
+
+		if refusal != "" || err != nil || ends != 1 {
+			t.Errorf("GotoGuard() = %q, %v with %d ends; want an admission that ended the fixers once", refusal, err, ends)
+		}
+	})
+
+	t.Run("a receiver with no location ends nothing", func(t *testing.T) {
+		t.Parallel()
+		c := &loomCLI{}
+		guard := fixerEndingGuard(func(string) (string, error) { return "", nil }, c.endRunFixers)
+
+		if refusal, err := guard("Plan-Write"); refusal != "" || err != nil {
+			t.Errorf("guard() = %q, %v; want an admission", refusal, err)
+		}
+	})
+}
diff --git a/internal/loomcli/gatefixer.go b/internal/loomcli/gatefixer.go
new file mode 100644
index 00000000..1a9b075b
--- /dev/null
+++ b/internal/loomcli/gatefixer.go
@@ -0,0 +1,284 @@
+// gatefixer.go wires Env.GateFixer for the Darn-Write, Plan-Write and Discussion-Write rows:
+// the seam that wraps a row's gate with a cold fixer, the visit directory that keys a row's fixer records, and the launch each fixer's prompt, model and skills make.
+
+package loomcli
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/discussionparser"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/friction"
+	"github.com/Knatte18/loomyard/internal/gatefixer"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/languageconfig"
+	"github.com/Knatte18/loomyard/internal/loomrecipe"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrecipe"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+const (
+	// gateFixerDirName is the directory under a run's scratch directory that holds the row fixers' records.
+	gateFixerDirName = "gatefix"
+	// darnWriteGateKey is the gate.yaml key a Darn-Write row's verify gate runs, and so the call its fixer re-runs.
+	darnWriteGateKey = "darn-write"
+	// planCheckCommand and planLensReviewCheckCommand are the plan self-checks a Plan-Write fixer re-runs, the second for a run whose gate also demands the lens review.
+	planCheckCommand           = "lym loom validate-plan"
+	planLensReviewCheckCommand = "lym loom validate-plan --lens-review"
+	// discussionCheckCommand is the discussion self-check a Discussion-Write fixer re-runs.
+	discussionCheckCommand = "lym loom validate-discussion"
+	// discussionWriteEngine is the engine of the Discussion-Write row, whose discussion gate element carries a fixer.
+	discussionWriteEngine = "DiscussionWrite"
+	// darnGateEntry, planGateEntry and discussionGateEntry name the gate elements of the Darn-Write, Plan-Write and Discussion-Write rows that carry a fixer.
+	darnGateEntry       = "verify"
+	planGateEntry       = "plan"
+	discussionGateEntry = "discussion"
+)
+
+// gateFixerInputs is every told value the row fixers' wrap and launch read, gathered by wire so the seam opens nothing itself.
+type gateFixerInputs struct {
+	// pairSlug is the worktree's pair slug, empty on the prime and outside a hub, where no fixer runs.
+	pairSlug string
+	// runProcDir is the hub's directory of run process owner records.
+	runProcDir string
+
+	starter    gatefixer.Starter
+	stopper    gatefixer.Stopper
+	reed       shuttleengine.ReedOps
+	engines    gatefixer.Engines
+	shuttleCfg shuttleengine.Config
+	anchorRoot string
+
+	registry modelspec.Registry
+	gate     gateslot.Config
+
+	stencilsDir    string
+	repoRoot       string
+	languageSkills []string
+	parentName     string
+	frictionDir    string
+
+	// scratchDir, statusPath and statusLockPath locate the run's scratch directory and status file, which key a row visit.
+	scratchDir     string
+	statusPath     string
+	statusLockPath string
+
+	// patternRecordPath is the record whose declared PATTERN changes the prompt renders, empty for a run that declares none.
+	patternRecordPath string
+
+	// The paths below are the ones the body stencils name.
+	worktreeRoot       string
+	decisionRecordPath string
+	supportLogPath     string
+	relevantPath       string
+	planDir            string
+	lensReviewPath     string
+}
+
+// gateFixerBody is one fixer body: the stencil joined behind the shared frame, the segment color of its session and the marker values it is filled with.
+type gateFixerBody struct {
+	stencil string
+	segment segmentcolor.Segment
+	values  func(in gateFixerInputs, req shedrecipe.GateFixerRequest) (map[string]string, error)
+}
+
+// gateFixerBodies maps the gate entry that carries a fixer to its body.
+var gateFixerBodies = map[string]gateFixerBody{
+	darnGateEntry:       {"gatefix-body-darn", segmentcolor.Darn, darnFixerValues},
+	planGateEntry:       {"gatefix-body-plan", segmentcolor.Plan, planFixerValues},
+	discussionGateEntry: {"gatefix-body-discussion", segmentcolor.Discussion, discussionFixerValues},
+}
+
+func darnFixerValues(in gateFixerInputs, _ shedrecipe.GateFixerRequest) (map[string]string, error) {
+	fixGate, err := in.gate.AgentGateCall(darnWriteGateKey)
+	if err != nil {
+		return nil, fmt.Errorf("loomcli: render the Darn-Write fixer's gate call: %w", err)
+	}
+	return map[string]string{
+		"fix_gate":             fixGate,
+		"worktree_root":        in.worktreeRoot,
+		"decision_record_path": in.decisionRecordPath,
+	}, nil
+}
+
+func planFixerValues(in gateFixerInputs, req shedrecipe.GateFixerRequest) (map[string]string, error) {
+	recheck := planCheckCommand
+	if req.Forked {
+		recheck = planLensReviewCheckCommand
+	}
+	return map[string]string{
+		"plan_dir":         in.planDir,
+		"lens_review_path": in.lensReviewPath,
+		"recheck_command":  recheck,
+	}, nil
+}
+
+func discussionFixerValues(in gateFixerInputs, _ shedrecipe.GateFixerRequest) (map[string]string, error) {
+	return map[string]string{
+		"decision_record_path": in.decisionRecordPath,
+		"support_log_path":     in.supportLogPath,
+		"relevant_path":        in.relevantPath,
+		"recheck_command":      discussionCheckCommand,
+	}, nil
+}
+
+// wallClock is the real time source of a fixer's wait.
+type wallClock struct{}
+
+func (wallClock) Now() time.Time        { return time.Now() }
+func (wallClock) Sleep(d time.Duration) { time.Sleep(d) }
+
+// pairSlugOf returns location's worktree name when the fabric origin record names it, and "" on the prime and outside a hub.
+// A record that cannot be read is returned as an error.
+func pairSlugOf(location *lymcwd.Location) (string, error) {
+	_, found, err := fabricengine.ReadOrigin(location)
+	if err != nil {
+		return "", fmt.Errorf("loomcli: read the fabric origin record: %w", err)
+	}
+	if !found {
+		return "", nil
+	}
+	return location.WorktreeName, nil
+}
+
+// writerFixerOn reports whether a cold fixer clears the gate element gate of the recipe's row running engine, so its writer's prompt drops the validator loop.
+// It holds exactly when gateFixerSeam wraps that gate: the worktree has a pair slug, the element names a fixer setting, and setting holds a non-empty value for it.
+// A setting that cannot be read, or that holds a non-string, is returned as an error.
+func writerFixerOn(recipe, engine, gate string, setting func(module, key string) (any, error), pairSlug string) (bool, error) {
+	if pairSlug == "" {
+		return false, nil
+	}
+	reference, err := loomrecipe.GateFixerSetting(recipe, engine, gate)
+	if err != nil {
+		return false, err
+	}
+	if reference == "" {
+		return false, nil
+	}
+	module, key, dotted := strings.Cut(reference, ".")
+	if !dotted || module == "" || key == "" {
+		return false, fmt.Errorf("loomcli: the %s gate fixer names %q, which is not a <module>.<key> setting", gate, reference)
+	}
+	value, err := setting(module, key)
+	if err != nil {
+		return false, fmt.Errorf("loomcli: read the %s gate fixer setting %s: %w", gate, reference, err)
+	}
+	text, isString := value.(string)
+	if !isString {
+		return false, fmt.Errorf("loomcli: the %s gate fixer setting %s holds %v, want a model-spec string", gate, reference, value)
+	}
+	return text != "", nil
+}
+
+// rowVisitDir returns the directory the fixer records of one visit to row live in: `<scratchDir>/gatefix/<row>-<history length>-<newest entry's Repeats>`.
+// A call that ends appends a history entry or folds into the newest,
+// and a goto appends one.
+// A crash re-step, and a resume that appended none, keep the directory;
+// a goto, a resume of a halt that appended an entry, and a fresh entry into the row get a new one.
+// A missing status file is an error naming its path.
+func rowVisitDir(scratchDir, statusPath, statusLockPath, row string) (string, error) {
+	status, found, err := state.ReadJSON[shedengine.Status](statusPath, statusLockPath)
+	if err != nil {
+		return "", fmt.Errorf("loomcli: read the run status %s to key the %s fixer directory: %w", statusPath, row, err)
+	}
+	if !found {
+		return "", fmt.Errorf("loomcli: the run status %s is missing, so the %s fixer directory cannot be keyed; way forward: step the run again once its status file exists", statusPath, row)
+	}
+	repeats := 0
+	if n := len(status.History); n > 0 {
+		repeats = status.History[n-1].Repeats
+	}
+	return filepath.Join(scratchDir, gateFixerDirName, fmt.Sprintf("%s-%d-%d", row, len(status.History), repeats)), nil
+}
+
+// gateFixerSeam returns the Env.GateFixer seam over in.
+// With no pair slug it returns the request's spec unchanged, so a row on the prime or outside a hub spawns no fixer and its gate failure reaches the writer.
+// Otherwise it resolves the request's model-spec through the registry and returns the spec wrapped so a failure at the entry goes to a cold fixer.
+func gateFixerSeam(in gateFixerInputs) func(shedrecipe.GateFixerRequest) (shuttleengine.GateSpec, error) {
+	return func(req shedrecipe.GateFixerRequest) (shuttleengine.GateSpec, error) {
+		if in.pairSlug == "" {
+			return req.Spec, nil
+		}
+		resolved, err := in.registry.Resolve(req.Model)
+		if err != nil {
+			return nil, fmt.Errorf("loomcli: resolve the %s gate fixer's model-spec: %w; way forward: set the setting that names it to an alias models.yaml holds with lym config, or to \"\" to turn the fixer off", req.Row, err)
+		}
+		choice := shuttleengine.NewModelChoice(resolved)
+		spec, err := fixerSpec(in, req, choice)
+		if err != nil {
+			return nil, err
+		}
+		return gatefixer.WrapRowGate(req.Spec, req.Entry, gatefixer.RowFixer{
+			Fixer: gatefixer.NewStrandFixer(gatefixer.Deps{
+				Starter:    in.starter,
+				Stopper:    in.stopper,
+				Reed:       in.reed,
+				Engines:    in.engines,
+				ShuttleCfg: in.shuttleCfg,
+				AnchorRoot: in.anchorRoot,
+				Clock:      wallClock{},
+				Register:   gatefixer.Registrar(in.reed, in.runProcDir, in.pairSlug, gatefixer.RoleGateFixer),
+			}),
+			VisitDir: func() (string, error) {
+				return rowVisitDir(in.scratchDir, in.statusPath, in.statusLockPath, req.Row)
+			},
+			Spec:       spec,
+			Timeout:    in.gate.FixerTimeout(),
+			Forked:     req.Forked,
+			SkipForked: req.SkipForked,
+		})
+	}
+}
+
+// fixerSpec returns the closure that builds one fixer's launch from the report it reads and the reply file it writes, for the body req's entry names.
+// An entry with no body is refused, since the row wiring sends only the entries gateFixerBodies names.
+// The closure renders the prompt and reads the declared PATTERN changes at each spawn, so a record edited between spawns is read fresh.
+func fixerSpec(in gateFixerInputs, req shedrecipe.GateFixerRequest, choice shuttleengine.ModelChoice) (func(reportPath, replyPath string) (gatefixer.Spec, error), error) {
+	body, ok := gateFixerBodies[req.Entry]
+	if !ok {
+		return nil, fmt.Errorf("loomcli: the %s row names a gate fixer on entry %q, which has no fixer body; way forward: put the fixer element on the verify, plan or discussion entry", req.Row, req.Entry)
+	}
+	values, err := body.values(in, req)
+	if err != nil {
+		return nil, err
+	}
+	notePath := friction.NotePath(in.frictionDir, "gate-fixer-"+strings.ToLower(req.Row))
+	return func(reportPath, replyPath string) (gatefixer.Spec, error) {
+		patternChanges, err := discussionparser.DeclaredPatternChanges(in.patternRecordPath)
+		if err != nil {
+			return gatefixer.Spec{}, err
+		}
+		prompt, err := gatefixer.RenderPrompt(gatefixer.PromptInputs{
+			StencilsDir:    in.stencilsDir,
+			BodyStencil:    body.stencil,
+			BodyValues:     values,
+			ReportPath:     reportPath,
+			ReplyPath:      replyPath,
+			RepoRoot:       in.repoRoot,
+			PatternChanges: patternChanges,
+			ParentName:     in.parentName,
+			NotePath:       notePath,
+		})
+		if err != nil {
+			return gatefixer.Spec{}, err
+		}
+		return gatefixer.Spec{
+			Prompt:      prompt,
+			ReportPath:  reportPath,
+			ReplyPath:   replyPath,
+			Role:        gatefixer.RoleGateFixer,
+			ModelChoice: choice,
+			Skills:      languageconfig.AppendSkills(nil, in.languageSkills),
+			Segment:     body.segment,
+			Timeout:     in.gate.FixerTimeout(),
+		}, nil
+	}, nil
+}
