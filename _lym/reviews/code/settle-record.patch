index b28b05d9..4e81510e 100644
--- a/internal/planglyph/doc.go
+++ b/internal/planglyph/doc.go
@@ -45,6 +45,8 @@
 //     Build-constraint partitioning reads `.go` candidate sets only: a candidate set holding any other file is never partitioned, and such a file is described as carrying no constraint, so a name such as `Foo_windows.cs` is never read as one.
 //     A self glyph that two alphabets both match is an ambiguous answer with no candidates and a non-empty list of languages, and its detail names those languages and the way forward in place of an empty candidate list:
 //     name the file as a slashed path self glyph, or a member as `lym quarry glyphs` lists them.
+//     The policy is shared through resolveVerdict, which statusFindings and the index's ResolveGlyphs both call, so a glyph resolves for one exactly when it resolves for the other.
+//     ResolveGlyphs backs the discussion citation check and the plan seam-test and `doc.go` checks.
 //     The passes that raise glyph-rejected are resolve.go, create.go, deleteorder.go and donecheck.go — one per fail-closed status policy in the package;
 //     each is named at its own bullet, and the double report one anomalous target can produce across two of them is accepted by design.
 //   - create-already-exists (blocking), create-new-unit (informational) — the Create inversion
diff --git a/internal/planglyph/index.go b/internal/planglyph/index.go
index b79646b7..d0b6dfaf 100644
--- a/internal/planglyph/index.go
+++ b/internal/planglyph/index.go
@@ -118,3 +118,51 @@ func (d batchDelta) RemovedTargets(fullPlan *planparser.Plan, completed, own []p
 func (d batchDelta) DetectDrift(fullPlan *planparser.Plan, completed []planparser.Card, reported []planindex.Rename, planDir, worktreeRoot, sha, now string) ([]Finding, error) {
 	return DetectDrift(fullPlan, PendingPlan(fullPlan, completed), planDir, worktreeRoot, d.answer, reported, sha, now)
 }
+
+// ResolveGlyphs resolves glyphs through the package's Resolve and answers each by the status policy statusFindings applies, so a glyph resolves here exactly when a card ref naming it would raise no glyph-not-found or glyph-ambiguous finding.
+// A quarry failure is returned wrapping ErrQuarryUnavailable, never an answer.
+func (index) ResolveGlyphs(worktreeRoot string, glyphs []string) ([]planindex.GlyphAnswer, error) {
+	if len(glyphs) == 0 {
+		return nil, nil
+	}
+	results, err := Resolve(worktreeRoot, glyphs)
+	if err != nil {
+		return nil, err
+	}
+
+	answers := make([]planindex.GlyphAnswer, len(glyphs))
+	for i, r := range results {
+		verdict, _, classified := resolveVerdict(worktreeRoot, r)
+		answer := planindex.GlyphAnswer{Glyph: glyphs[i], Verdict: verdict}
+		switch verdict {
+		case planindex.GlyphFound:
+			var files []string
+			for _, symbol := range r.Symbols {
+				files = append(files, symbol.File)
+			}
+			for _, candidate := range classified.Candidates {
+				files = append(files, candidate.File)
+			}
+			answer.Files = dedupe(files)
+		case planindex.GlyphAmbiguous:
+			for _, candidate := range classified.Candidates {
+				answer.Candidates = append(answer.Candidates, candidateList([]constrainedCandidate{candidate}))
+			}
+		}
+		answers[i] = answer
+	}
+	return answers, nil
+}
+
+// dedupe returns values without repeats, keeping first-seen order.
+func dedupe(values []string) []string {
+	seen := make(map[string]bool, len(values))
+	var unique []string
+	for _, value := range values {
+		if !seen[value] {
+			seen[value] = true
+			unique = append(unique, value)
+		}
+	}
+	return unique
+}
