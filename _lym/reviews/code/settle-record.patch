+				return
+			}
+			if err != nil || got != tt.want {
+				t.Fatalf("ParseMachineAddress(%q) = %+v, %v; want %+v", tt.address, got, err, tt.want)
+			}
+		})
+	}
+
+	routing := []struct {
+		name string
+		want bool
+	}{{"neve::ly:orch", true}, {"ly:orch", false}, {"ly::orch", true}}
+	for _, tt := range routing {
