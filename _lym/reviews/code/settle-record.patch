@@ -0,0 +1,219 @@
+// hook.go implements the hidden `hook` verb that an orch session's prompt and turn-end hooks run.
+// It sets the machine's presence back to terminal on a line the operator typed.
+// It also forwards a turn's final reply while away.
+
+package slackcli
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengines"
+	"github.com/Knatte18/loomyard/internal/slackengine"
+)
+
+const (
+	// hookVerb is the hidden verb's name, which slackengine.HookCommand spells.
+	hookVerb = "hook"
+	// injectMatchWindow is how long before a prompt an inject creel typed into the strand's pane still counts as its source.
+	injectMatchWindow = 2 * time.Minute
+	// replyLimit is the most bytes of a reply the hook forwards, under creel's 8 KiB cap on a message's line.
+	replyLimit = 7000
+	// replyCutNote closes a reply cut to replyLimit.
+	replyCutNote = "\n… (cut here; the whole reply is in the terminal)"
+	// lymLinePrefix opens every line lym's own modules type into a pane without creel.
+	// Examples are shuttle's API-error retry line and tender's resume line.
+	lymLinePrefix = "[lym]"
+)
+
+// The actions a hook run reports, under `action`.
+const (
+	hookActionNone     = "none"
+	hookActionLymLine  = "lym-line"
+	hookActionInject   = "inject"
+	hookActionBack     = "presence-terminal"
+	hookActionForward  = "forwarded"
+	hookActionSubagent = "subagent"
+)
+
+// strandClient is the creel client of the orch strand a hook runs in.
+type strandClient interface {
+	// Post leaves body as a message for receiver and returns its id.
+	Post(receiver, body string) (int64, error)
+	// Log returns the journal entries matching filter, oldest first.
+	Log(filter creelengine.LogFilter) ([]creelengine.LogEntry, error)
+	// Shortname returns the shortname of the client's hub.
+	Shortname() string
+}
+
+// hookCmd returns the hidden `slack hook` verb.
+func (c *slackCLI) hookCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:         hookVerb + " <engine>",
+		Short:       "switch the presence on the operator's typed line and forward a turn's reply while away (run by the hook)",
+		Hidden:      true,
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceInternal},
+		Long: `hook is what an orch session's prompt and turn-end hooks run, never an operator.
+It reads the named engine's hook input on standard input.
+
+On a prompt typed into the orch's pane while the presence is slack, it sets the
+presence to terminal: the operator is back at the terminal. A line lym put in
+the pane switches nothing: a slash command, a prompt the provider submits by
+itself, a line that opens [creel] or [lym], and a line creel typed into this
+pane as an inject in the two minutes before.
+
+On the end of a turn of the session's main thread while the presence is slack,
+it posts the turn's final reply to the relay as the orch, so it reaches the
+orch's own Slack channel. A turn that ended with no text sends nothing, and a
+reply over 7000 bytes is cut.
+
+It runs only in an orch's pane, and its output is the hook's to discard.`,
+		Args: cobra.ExactArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			return c.runVerb(cmd, func() (map[string]any, error) { return c.hook(cmd, args[0]) })
+		},
+	}
+}
+
+// hook parses the engine's hook input on the command's standard input and acts on a prompt or a turn end.
+// A subagent's call and any other event do nothing.
+func (c *slackCLI) hook(cmd *cobra.Command, engine string) (map[string]any, error) {
+	renderer, ok := shuttleengines.ToolBoundaryRenderer(engine)
+	if !ok {
+		return nil, fmt.Errorf("slack: the engine %q parses no hook input; the registered engines: %s", engine, strings.Join(shuttleengines.Names(), ", "))
+	}
+	payload, err := io.ReadAll(cmd.InOrStdin())
+	if err != nil {
+		return nil, fmt.Errorf("slack: read the hook input: %w", err)
+	}
+	input, err := renderer.HookInput(payload)
+	if err != nil {
+		return nil, err
+	}
+	if input.Subagent {
+		return hookAction(hookActionSubagent), nil
+	}
+	switch input.Event {
+	case shuttleengine.HookEventPrompt:
+		return c.promptHook(input.Prompt)
+	case shuttleengine.HookEventStop:
+		return c.replyHook(input.Reply)
+	}
+	return hookAction(hookActionNone), nil
+}
+
+// hookAction returns the fields of a hook run that took action.
+func hookAction(action string) map[string]any {
+	return map[string]any{"action": action}
+}
+
+// promptHook sets the presence to terminal for prompt, a line the operator typed into the orch's pane while away.
+// It changes nothing for an empty prompt, which is a slash command or one the provider submitted.
+// It changes nothing for a line that opens creelengine.LinePrefix, as every line creel types or hands over does.
+// It changes nothing for a line that opens lymLinePrefix, nor while the presence is not slack.
+// Nor does it for a prompt creel typed into the strand's pane as an inject within injectMatchWindow before now.
+func (c *slackCLI) promptHook(prompt string) (map[string]any, error) {
+	if prompt == "" || strings.HasPrefix(prompt, creelengine.LinePrefix) || strings.HasPrefix(prompt, lymLinePrefix) {
+		return hookAction(hookActionLymLine), nil
+	}
+	presence, err := slackengine.ReadPresence(c.geom.PresencePath)
+	if err != nil {
+		return nil, warnHookFailure("reading the presence failed", "", err)
+	}
+	if presence != slackengine.PresenceSlack {
+		return hookAction(hookActionNone), nil
+	}
+	client, strand, err := c.orchClient()
+	if err != nil {
+		return nil, warnHookFailure("finding the orch's creel client failed", "", err)
+	}
+	now := c.clock.Now()
+	entries, err := client.Log(creelengine.LogFilter{To: strand, Since: now.Add(-injectMatchWindow)})
+	if err != nil {
+		// The turn hook discards the verb's output, so the log is the only place the failure shows.
+		logger.Warn("slack: hook: reading creel's injects failed; the presence stays slack", "strand", strand, "error", err)
+		return nil, fmt.Errorf("slack: read creel's injects into %s: %w", strand, err)
+	}
+	for _, entry := range entries {
+		if entry.TypesInject() && strings.TrimSpace(entry.Subject) == prompt {
+			return hookAction(hookActionInject), nil
+		}
+	}
+	if _, err := slackengine.WritePresence(c.geom.PresencePath, slackengine.PresenceTerminal, now); err != nil {
+		return nil, warnHookFailure("setting the presence to terminal failed; replies keep going to Slack", strand, err)
+	}
+	return hookAction(hookActionBack), nil
+}
+
+// replyHook posts reply, a turn's final text, to the relay as the orch while the presence is slack.
+// The relay posts it to that orch's own channel.
+// An empty reply, and any presence but slack, send nothing.
+func (c *slackCLI) replyHook(reply string) (map[string]any, error) {
+	if reply == "" {
+		return hookAction(hookActionNone), nil
+	}
+	presence, err := slackengine.ReadPresence(c.geom.PresencePath)
+	if err != nil {
+		return nil, warnHookFailure("reading the presence failed", "", err)
+	}
+	if presence != slackengine.PresenceSlack {
+		return hookAction(hookActionNone), nil
+	}
+	client, strand, err := c.orchClient()
+	if err != nil {
+		return nil, warnHookFailure("finding the orch's creel client failed", "", err)
+	}
+	receiver, err := agentname.FormatProgram(client.Shortname(), slackengine.SlackProgram)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := client.Post(receiver, fitReply(reply)); err != nil {
+		logger.Warn("slack: hook: posting the turn's reply failed; the reply is lost to Slack", "strand", strand, "error", err)
+		return nil, fmt.Errorf("slack: post the turn's reply to %s: %w", receiver, err)
+	}
+	return hookAction(hookActionForward), nil
+}
+
+// warnHookFailure logs a hook step's failure and returns err unchanged.
+// The turn hook discards the verb's output, so the log is the only place the failure shows.
+func warnHookFailure(message, strand string, err error) error {
+	logger.Warn("slack: hook: "+message, "strand", strand, "error", err)
+	return err
+}
+
+// orchClient returns the creel client of the orch strand the process runs in, and that strand's name.
+// It refuses a process whose strand name names no orch; creel refuses a claim from outside that strand's pane.
+func (c *slackCLI) orchClient() (strandClient, string, error) {
+	strand := c.strandName()
+	if !creelengine.IsOrchStrand(strand) {
+		return nil, "", fmt.Errorf("slack: this runs in no orch's pane (strand %q); way forward: none, only an orch session's hooks run `lym slack %s`", strand, hookVerb)
+	}
+	client, err := c.newStrandClient(strand)
+	if err != nil {
+		return nil, "", err
+	}
+	return client, strand, nil
+}
+
+// fitReply returns reply whole when it fits replyLimit.
+// Otherwise it returns the longest start of reply that fits with replyCutNote after it, cut at a rune's start.
+func fitReply(reply string) string {
+	if len(reply) <= replyLimit {
+		return reply
+	}
+	cut := replyLimit - len(replyCutNote)
+	for cut > 0 && !utf8.RuneStart(reply[cut]) {
+		cut--
+	}
+	return reply[:cut] + replyCutNote
+}
diff --git a/internal/slackcli/hook_test.go b/internal/slackcli/hook_test.go
new file mode 100644
index 00000000..50d794d8
--- /dev/null
+++ b/internal/slackcli/hook_test.go
@@ -0,0 +1,187 @@
+// hook_test.go covers the hidden hook verb over the real claude engine's hook payloads and a fake strand client,
+// and the cut of a reply to creel's line limit.
+
+package slackcli
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+
+	"github.com/Knatte18/loomyard/internal/creelengine"
+	"github.com/Knatte18/loomyard/internal/slackengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// hookJSON renders fields as the JSON object Claude Code passes a hook on standard input.
+func hookJSON(fields map[string]any) string {
+	payload, err := json.Marshal(fields)
+	if err != nil {
+		panic(err)
+	}
+	return string(payload)
+}
+
+// promptInput is the payload of a UserPromptSubmit hook.
+func promptInput(prompt string) string {
+	return hookJSON(map[string]any{"hook_event_name": "UserPromptSubmit", "prompt": prompt})
+}
+
+// stopInput is the payload of a Stop hook.
+func stopInput(reply string) string {
+	return hookJSON(map[string]any{"hook_event_name": "Stop", "last_assistant_message": reply})
+}
+
+func TestHook(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	injected := func(event, subject string) []creelengine.LogEntry {
+		return []creelengine.LogEntry{{Event: event, To: "hub:orch", Subject: subject}}
+	}
+	tests := []struct {
+		name         string
+		engine       string
+		stdin        string
+		strand       string
+		presence     slackengine.Presence
+		entries      []creelengine.LogEntry
+		logErr       error
+		postErr      error
+		clientErr    error
+		wantAction   string
+		wantRefusal  []string
+		wantPresence slackengine.Presence
+		wantLogged   bool
+		wantPosts    []sentPost
+	}{
+		{name: "PromptSlashCommandIsLymsLine", stdin: promptInput("/compact"), presence: slackengine.PresenceSlack,
+			wantAction: "lym-line", wantPresence: slackengine.PresenceSlack},
+		{name: "PromptOpeningCreelPrefixIsLymsLine", stdin: promptInput("[creel] mail"), presence: slackengine.PresenceSlack,
+			wantAction: "lym-line", wantPresence: slackengine.PresenceSlack},
+		{name: "PromptOpeningLymPrefixIsLymsLine", stdin: promptInput("[lym] Your last turn ended on an API error. Carry on."),
+			presence: slackengine.PresenceSlack, wantAction: "lym-line", wantPresence: slackengine.PresenceSlack},
+		{name: "PromptTaskNotificationIsLymsLine", stdin: promptInput("<task-notification>done</task-notification>"),
+			presence: slackengine.PresenceSlack, wantAction: "lym-line", wantPresence: slackengine.PresenceSlack},
+		{name: "PromptWhilePresenceIsTerminalDoesNothing", stdin: promptInput("hello"), presence: slackengine.PresenceTerminal,
+			wantAction: "none", wantPresence: slackengine.PresenceTerminal},
+		{name: "PromptOutsideAnOrchIsRefused", stdin: promptInput("hello"), strand: "hub:impl", presence: slackengine.PresenceSlack,
+			wantRefusal: []string{"no orch's pane", "hub:impl"}, wantPresence: slackengine.PresenceSlack},
+		{name: "PromptWhoseStrandClientCannotBeBuiltIsRefused", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			clientErr: errors.New("creel is down"), wantRefusal: []string{"creel is down"}, wantPresence: slackengine.PresenceSlack},
+		{name: "PromptMatchingAnInjectedLineIsNotTheOperators", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			entries: injected("injected", "  hello "), wantAction: "inject", wantPresence: slackengine.PresenceSlack, wantLogged: true},
+		{name: "PromptMatchingASendingInjectIsNotTheOperators", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			entries: injected("sending", "hello"), wantAction: "inject", wantPresence: slackengine.PresenceSlack, wantLogged: true},
+		{name: "PromptMatchingAnUnconfirmedInjectIsNotTheOperators", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			entries: injected("unconfirmed", "hello"), wantAction: "inject", wantPresence: slackengine.PresenceSlack, wantLogged: true},
+		{name: "PromptMatchingAnEntryThatTypedNothingSetsTerminal", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			entries: injected("posted", "hello"), wantAction: "presence-terminal", wantPresence: slackengine.PresenceTerminal, wantLogged: true},
+		{name: "PromptOfAnotherSubjectSetsTerminal", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			entries: injected("injected", "goodbye"), wantAction: "presence-terminal", wantPresence: slackengine.PresenceTerminal, wantLogged: true},
+		{name: "PromptWithNoInjectSetsTerminal", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			wantAction: "presence-terminal", wantPresence: slackengine.PresenceTerminal, wantLogged: true},
+		{name: "PromptWhoseLogCannotBeReadIsRefusedAndKeepsSlack", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			logErr: errors.New("journal unreadable"), wantRefusal: []string{"read creel's injects into hub:orch", "journal unreadable"},
+			wantPresence: slackengine.PresenceSlack, wantLogged: true},
+		{name: "StopForwardsTheTrimmedReplyToTheSlackProgram", stdin: stopInput(" done "), presence: slackengine.PresenceSlack,
+			wantAction: "forwarded", wantPresence: slackengine.PresenceSlack, wantPosts: []sentPost{{"hub:SLACK", "done"}}},
+		{name: "StopWithNoReplyDoesNothing", stdin: stopInput("  "), presence: slackengine.PresenceSlack,
+			wantAction: "none", wantPresence: slackengine.PresenceSlack},
+		{name: "StopWhilePresenceIsTerminalDoesNothing", stdin: stopInput("done"), presence: slackengine.PresenceTerminal,
+			wantAction: "none", wantPresence: slackengine.PresenceTerminal},
+		{name: "StopOutsideAnOrchIsRefused", stdin: stopInput("done"), strand: "hub:impl", presence: slackengine.PresenceSlack,
+			wantRefusal: []string{"no orch's pane", "hub:impl"}, wantPresence: slackengine.PresenceSlack},
+		{name: "StopWhosePostFailsIsRefusedNamingTheReceiver", stdin: stopInput("done"), presence: slackengine.PresenceSlack,
+			postErr: errors.New("creel refused"), wantRefusal: []string{"hub:SLACK", "creel refused"},
+			wantPresence: slackengine.PresenceSlack, wantPosts: []sentPost{{"hub:SLACK", "done"}}},
+		{name: "SubagentPromptDoesNothingButNameItself",
+			stdin:    hookJSON(map[string]any{"hook_event_name": "UserPromptSubmit", "prompt": "hello", "agent_id": "a1"}),
+			presence: slackengine.PresenceSlack, wantAction: "subagent", wantPresence: slackengine.PresenceSlack},
+		{name: "SubagentStopForwardsNothing",
+			stdin:    hookJSON(map[string]any{"hook_event_name": "Stop", "last_assistant_message": "done", "agent_id": "a1"}),
+			presence: slackengine.PresenceSlack, wantAction: "subagent", wantPresence: slackengine.PresenceSlack},
+		{name: "OtherEventDoesNothing", stdin: hookJSON(map[string]any{"hook_event_name": "PostToolUse"}), presence: slackengine.PresenceSlack,
+			wantAction: "none", wantPresence: slackengine.PresenceSlack},
+		{name: "PayloadThatIsNoJSONObjectIsRefused", stdin: "not json", presence: slackengine.PresenceSlack,
+			wantRefusal: []string{"parse hook input"}, wantPresence: slackengine.PresenceSlack},
+		{name: "UnknownEngineIsRefusedNamingTheRegisteredOnes", engine: "nosuch", stdin: promptInput("hello"), presence: slackengine.PresenceSlack,
+			wantRefusal: []string{`"nosuch"`, "claude"}, wantPresence: slackengine.PresenceSlack},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			h := newHarness(t, nil)
+			h.storePresence(tt.presence)
+			if tt.strand != "" {
+				h.strand = tt.strand
+			}
+			h.client.entries, h.client.logErr, h.client.postErr, h.clientErr = tt.entries, tt.logErr, tt.postErr, tt.clientErr
+			engine := tt.engine
+			if engine == "" {
+				engine = "claude"
+			}
+
+			code, env := h.run(tt.stdin, "hook", engine)
+
+			if tt.wantRefusal != nil {
+				wantRefused(t, code, env, tt.wantRefusal...)
+			} else {
+				wantOK(t, code, env)
+				if diff := cmp.Diff(map[string]any{"action": tt.wantAction}, env.Raw); diff != "" {
+					t.Errorf("hook fields mismatch (-want +got):\n%s", diff)
+				}
+			}
+			if got := h.presence(); got != tt.wantPresence {
+				t.Errorf("presence = %q; want %q", got, tt.wantPresence)
+			}
+			var wantFilters []creelengine.LogFilter
+			if tt.wantLogged {
+				wantFilters = []creelengine.LogFilter{{To: h.strand, Since: fixedClock{}.Now().Add(-2 * time.Minute)}}
+			}
+			if diff := cmp.Diff(wantFilters, h.client.filters, cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("creel log filters mismatch (-want +got):\n%s", diff)
+			}
+			if diff := cmp.Diff(tt.wantPosts, h.client.posts, cmp.AllowUnexported(sentPost{}), cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("posts mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestFitReply(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	cut := replyLimit - len(replyCutNote)
+	// The two-byte rune starts at cut-1, so the byte at cut is its continuation and the cut falls back to cut-1.
+	multiByte := strings.Repeat("a", cut-1) + "é" + strings.Repeat("a", replyLimit)
+	tests := []struct {
+		name  string
+		reply string
+		want  string
+	}{
+		{"ShortReplyIsReturnedWhole", "hello", "hello"},
+		{"ReplyAtTheLimitIsReturnedWhole", strings.Repeat("a", replyLimit), strings.Repeat("a", replyLimit)},
+		{"LongASCIIReplyIsCutToTheLimitWithTheNote", strings.Repeat("a", replyLimit+1), strings.Repeat("a", cut) + replyCutNote},
+		{"CutInsideARuneFallsBackToItsStart", multiByte, strings.Repeat("a", cut-1) + replyCutNote},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got := fitReply(tt.reply)
+			if got != tt.want {
+				t.Errorf("fitReply(%d bytes) = %d bytes ending %q; want %d bytes", len(tt.reply), len(got), got[max(0, len(got)-20):], len(tt.want))
+			}
+			if !utf8.ValidString(got) || len(got) > replyLimit {
+				t.Errorf("fitReply(%d bytes) = %d bytes, valid UTF-8 %v; want valid UTF-8 within %d bytes", len(tt.reply), len(got), utf8.ValidString(got), replyLimit)
+			}
+		})
+	}
+}
