new file mode 100644
index 00000000..b9b9b665
--- /dev/null
+++ b/internal/loomshed/raddlecheck.go
@@ -0,0 +1,122 @@
+// raddlecheck.go holds the checks a raddle proposal on disk is judged by and the raddle gate that runs them.
+
+package loomshed
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// checkProposalUnparsable names the finding of a proposal file that is missing or does not parse.
+const checkProposalUnparsable = "proposal-unparsable"
+
+// RaddleCheck carries the told values of the checks run over a raddle proposal.
+// ProposalPath and RecordPath are absolute.
+// Board builds the board context the checks read, with filing set at Raddle-File's run.
+type RaddleCheck struct {
+	// ProposalPath is the proposal file.
+	ProposalPath string
+	// RecordPath is the Sketch's decision record.
+	RecordPath string
+	// Board builds the context from the board, the raddle store and the profiles.
+	Board func(filing bool) (raddleparser.BoardContext, error)
+}
+
+// readProposal reads and parses the proposal file.
+// A file that is missing or does not parse comes back as the finding that names it, with a nil error, so a caller tells that from a fault of the read.
+func readProposal(path string) (proposal raddleparser.Proposal, unparsable *raddleparser.Finding, err error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return proposal, &raddleparser.Finding{Check: checkProposalUnparsable, Detail: fmt.Sprintf("no proposal is written at %s; way forward: write it there in the form of the raddle proposal spec", path)}, nil
+	}
+	if err != nil {
+		return proposal, nil, err
+	}
+	proposal, err = raddleparser.Parse(data)
+	if err != nil {
+		return proposal, &raddleparser.Finding{Check: checkProposalUnparsable, Detail: err.Error()}, nil
+	}
+	return proposal, nil, nil
+}
+
+// CheckRaddleProposal judges the proposal on disk against the Sketch's decision record and the board, and returns one finding per broken rule.
+// A proposal file that is missing or does not parse is the one finding `proposal-unparsable`, carrying the parser's way forward.
+// A read error of the decision record or a failure to build the board context is returned, with no findings.
+// filing is told to the board context, which Raddle-File's run sets.
+func CheckRaddleProposal(check RaddleCheck, filing bool) ([]raddleparser.Finding, error) {
+	proposal, unparsable, err := readProposal(check.ProposalPath)
+	if err != nil {
+		return nil, err
+	}
+	if unparsable != nil {
+		return []raddleparser.Finding{*unparsable}, nil
+	}
+
+	record, err := os.ReadFile(check.RecordPath)
+	if err != nil {
+		return nil, err
+	}
+	board, err := check.Board(filing)
+	if err != nil {
+		return nil, err
+	}
+	return raddleparser.Check(proposal, record, board), nil
+}
+
+// RecheckRaddleBoard judges the proposal on disk against the board as it is now, with the board context built for a filing run so the entries a part's dependency dropped are named.
+// A proposal that is missing or does not parse is a returned error, since the re-check follows a check that passed.
+func RecheckRaddleBoard(check RaddleCheck) (raddleparser.Recheck, error) {
+	proposal, unparsable, err := readProposal(check.ProposalPath)
+	if err != nil {
+		return raddleparser.Recheck{}, err
+	}
+	if unparsable != nil {
+		return raddleparser.Recheck{}, fmt.Errorf("loomshed: re-check the proposal: %s", unparsable.Detail)
+	}
+	board, err := check.Board(true)
+	if err != nil {
+		return raddleparser.Recheck{}, err
+	}
+	return raddleparser.RecheckBoard(proposal, board), nil
+}
+
+// FormatRaddleFindings renders findings as one semicolon-separated list, each as `check[/part]: detail`.
+func FormatRaddleFindings(findings []raddleparser.Finding) string {
+	parts := make([]string, len(findings))
+	for i, finding := range findings {
+		head := finding.Check
+		if finding.Part != "" {
+			head += "/" + finding.Part
+		}
+		parts[i] = head + ": " + finding.Detail
+	}
+	return strings.Join(parts, "; ")
+}
+
+// NewRaddleGate returns the raddle gate closure of the Raddle-Write row: a shuttleengine.Gate that runs CheckRaddleProposal(check, false) once and maps the result onto the gate contract.
+// A returned error is an infrastructure fault and burns no attempt.
+// Findings fail the gate, with the findings joined as the result's Findings and logged, since the findings file is ephemeral.
+// A pass calls onPass before it passes, and an error of onPass is an infrastructure error too.
+func NewRaddleGate(check RaddleCheck, onPass func() error) shuttleengine.Gate {
+	return func() (shuttleengine.GateResult, error) {
+		findings, err := CheckRaddleProposal(check, false)
+		if err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		if len(findings) > 0 {
+			formatted := FormatRaddleFindings(findings)
+			logger.Warn("loomshed: raddle gate failed validation", "gate", "Raddle-Gate", "proposal", check.ProposalPath, "findings", formatted)
+			return shuttleengine.GateResult{Passed: false, Findings: formatted}, nil
+		}
+		if err := onPass(); err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		return shuttleengine.GateResult{Passed: true}, nil
+	}
+}
diff --git a/internal/loomshed/raddlecheck_test.go b/internal/loomshed/raddlecheck_test.go
new file mode 100644
index 00000000..19f9b39c
--- /dev/null
+++ b/internal/loomshed/raddlecheck_test.go
@@ -0,0 +1,255 @@
+// raddlecheck_test.go exercises the proposal check, the board re-check and the raddle gate over a proposal and decision record in a temp directory.
+
+package loomshed_test
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/loomshed"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// raddleRecord is a decision record of two decisions with two risks, two criteria and two PATTERN changes; § stands for a backtick.
+var raddleRecord = strings.NewReplacer("§", "`").Replace(`## Decisions
+
+### D1 — First
+
+The first decision.
+
+### D2 — Second
+
+The second decision.
+
+## Open risks
+
+- Risk one
+- Risk two
+
+## Acceptance criteria
+
+- D1: first holds.
+- D2: second holds.
+
+## PATTERN changes
+
+- §PATTERN-a§ — adds: Rule a.
+- §PATTERN-b§ — adds: Rule b.
+`)
+
+// validRaddleProposal returns a proposal of two parts that passes every check against raddleRecord and validRaddleBoard.
+func validRaddleProposal() raddleparser.Proposal {
+	return raddleparser.Proposal{
+		Sketch:       "sketch-x",
+		Shape:        raddleparser.ShapeTasks,
+		BoardChecked: []raddleparser.BoardCheck{{Slug: "other-open", Revised: "2026-11-01T10:00:00Z"}},
+		Parts: []raddleparser.Part{
+			{
+				Slug: "part-a", Title: "Part A", Type: "feature", Recipe: raddleparser.RecipeTapestry, Profile: "standard",
+				Decisions: []string{"D1"}, Packages: []raddleparser.Package{{Path: "internal/a", Size: 10}},
+				OpenRisks: []string{"Risk one"}, Criteria: []string{"D1: first holds."}, PatternChanges: []string{"PATTERN-a"},
+				CostLine: "one tapestry part",
+			},
+			{
+				Slug: "part-b", Title: "Part B", Type: "feature", Recipe: raddleparser.RecipeTapestry, Profile: "standard",
+				Decisions: []string{"D2"}, Packages: []raddleparser.Package{{Path: "internal/b", Size: 10}}, DependsOn: []string{"part-a"},
+				OpenRisks: []string{"Risk two"}, Criteria: []string{"D2: second holds."}, PatternChanges: []string{"PATTERN-b"},
+				CostLine: "one tapestry part",
+			},
+		},
+		Cost: raddleparser.Cost{Line: "two tapestry parts", NextBest: raddleparser.NextBest{Split: "one part", Line: "one tapestry part"}},
+	}
+}
+
+// validRaddleBoard returns a board context under which validRaddleProposal passes.
+func validRaddleBoard() raddleparser.BoardContext {
+	return raddleparser.BoardContext{
+		Sketch:       "sketch-x",
+		Entry:        "sketch-x",
+		ModuleLabels: []string{"mod-a"},
+		Entries: []raddleparser.BoardEntry{
+			{Slug: "sketch-x", Kind: raddleparser.KindTask, Labels: []string{"mod-a", "sketch"}, Open: true, Revised: "2026-11-01T09:00:00Z"},
+			{Slug: "other-open", Kind: raddleparser.KindTask, Labels: []string{"mod-z"}, Open: true, Revised: "2026-11-01T10:00:00Z"},
+		},
+		TypeLabels: []string{"feature", "fix", "sketch"},
+		Profiles:   map[string][]string{raddleparser.RecipeTapestry: {"standard"}, raddleparser.RecipeDarn: {"quick"}},
+	}
+}
+
+// raddleCheckFixture writes proposal as JSON and the record into a temp directory and returns the check over them, whose Board answers board and boardErr and records the filing flag it was asked for.
+func raddleCheckFixture(t *testing.T, proposal []byte, board raddleparser.BoardContext, boardErr error, askedFiling *[]bool) loomshed.RaddleCheck {
+	t.Helper()
+	dir := t.TempDir()
+	check := loomshed.RaddleCheck{
+		ProposalPath: filepath.Join(dir, "proposal.yaml"),
+		RecordPath:   filepath.Join(dir, "decision.md"),
+		Board: func(filing bool) (raddleparser.BoardContext, error) {
+			if askedFiling != nil {
+				*askedFiling = append(*askedFiling, filing)
+			}
+			return board, boardErr
+		},
+	}
+	if proposal != nil {
+		if err := os.WriteFile(check.ProposalPath, proposal, 0o644); err != nil {
+			t.Fatalf("write the proposal: %v", err)
+		}
+	}
+	if err := os.WriteFile(check.RecordPath, []byte(raddleRecord), 0o644); err != nil {
+		t.Fatalf("write the record: %v", err)
+	}
+	return check
+}
+
+// marshalRaddleProposal returns the proposal as the JSON object the file holds.
+func marshalRaddleProposal(t *testing.T, proposal raddleparser.Proposal) []byte {
+	t.Helper()
+	data, err := json.Marshal(proposal)
+	if err != nil {
+		t.Fatalf("marshal the proposal: %v", err)
+	}
+	return data
+}
+
+func TestCheckRaddleProposal(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	boardFault := errors.New("board unavailable")
+	dependsUnknown := validRaddleProposal()
+	dependsUnknown.Parts[1].DependsOn = []string{"ghost"}
+
+	tests := []struct {
+		name         string
+		proposal     []byte
+		removeRecord bool
+		boardErr     error
+		filing       bool
+		wantChecks   []string
+		wantErr      error
+	}{
+		{name: "ValidProposalHasNoFinding", proposal: marshalRaddleProposal(t, validRaddleProposal())},
+		{name: "FindingPassesThrough", proposal: marshalRaddleProposal(t, dependsUnknown), wantChecks: []string{raddleparser.CheckDependsUnknown}},
+		{name: "UnparsableFileIsOneFinding", proposal: []byte("not json"), wantChecks: []string{"proposal-unparsable"}},
+		{name: "MissingFileIsOneFinding", proposal: nil, wantChecks: []string{"proposal-unparsable"}},
+		{name: "RecordReadErrorIsReturned", proposal: marshalRaddleProposal(t, validRaddleProposal()), removeRecord: true, wantErr: os.ErrNotExist},
+		{name: "BoardErrorIsReturned", proposal: marshalRaddleProposal(t, validRaddleProposal()), boardErr: boardFault, wantErr: boardFault},
+		{name: "FilingFlagReachesTheBoard", proposal: marshalRaddleProposal(t, validRaddleProposal()), filing: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			var asked []bool
+			check := raddleCheckFixture(t, tt.proposal, validRaddleBoard(), tt.boardErr, &asked)
+			if tt.removeRecord {
+				if err := os.Remove(check.RecordPath); err != nil {
+					t.Fatalf("remove the record: %v", err)
+				}
+			}
+
+			findings, err := loomshed.CheckRaddleProposal(check, tt.filing)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("CheckRaddleProposal() error = %v; want %v", err, tt.wantErr)
+			}
+			var got []string
+			for _, finding := range findings {
+				got = append(got, finding.Check)
+			}
+			if !slices.Equal(got, tt.wantChecks) {
+				t.Errorf("CheckRaddleProposal() checks = %v; want %v", got, tt.wantChecks)
+			}
+			if tt.filing && !slices.Equal(asked, []bool{true}) {
+				t.Errorf("Board was asked for filing %v; want [true]", asked)
+			}
+		})
+	}
+}
+
+func TestRecheckRaddleBoard(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("NamesAMovedEntryAndLandedOnes", func(t *testing.T) {
+		t.Parallel()
+		proposal := validRaddleProposal()
+		proposal.BoardChecked = append(proposal.BoardChecked, raddleparser.BoardCheck{Slug: "gone", Revised: "2026-11-01T08:00:00Z"})
+		board := validRaddleBoard()
+		board.Entries[1].Revised = "2026-11-02T10:00:00Z"
+		var asked []bool
+		check := raddleCheckFixture(t, marshalRaddleProposal(t, proposal), board, nil, &asked)
+
+		recheck, err := loomshed.RecheckRaddleBoard(check)
+		if err != nil {
+			t.Fatalf("RecheckRaddleBoard() error = %v; want nil", err)
+		}
+		if len(recheck.Failures) != 1 || recheck.Failures[0].Check != raddleparser.CheckRevisedMoved {
+			t.Errorf("RecheckRaddleBoard() failures = %+v; want one %s", recheck.Failures, raddleparser.CheckRevisedMoved)
+		}
+		if !reflect.DeepEqual(recheck.Landed, []string{"gone"}) {
+			t.Errorf("RecheckRaddleBoard() landed = %v; want [gone]", recheck.Landed)
+		}
+		if !slices.Equal(asked, []bool{true}) {
+			t.Errorf("Board was asked for filing %v; want [true]", asked)
+		}
+	})
+
+	t.Run("UnparsableProposalIsAnError", func(t *testing.T) {
+		t.Parallel()
+		check := raddleCheckFixture(t, []byte("not json"), validRaddleBoard(), nil, nil)
+		if _, err := loomshed.RecheckRaddleBoard(check); err == nil {
+			t.Error("RecheckRaddleBoard() = nil error; want one for an unparsable proposal")
+		}
+	})
+}
+
+func TestNewRaddleGate(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	onPassFault := errors.New("store failed")
+	tests := []struct {
+		name         string
+		proposal     []byte
+		onPassErr    error
+		wantPassed   bool
+		wantFindings string
+		wantOnPass   int
+		wantErr      error
+	}{
+		{name: "PassCallsOnPassOnce", proposal: marshalRaddleProposal(t, validRaddleProposal()), wantPassed: true, wantOnPass: 1},
+		{name: "FailReturnsFindingsAndSkipsOnPass", proposal: []byte("not json"), wantFindings: "proposal-unparsable"},
+		{name: "OnPassErrorIsReturned", proposal: marshalRaddleProposal(t, validRaddleProposal()), onPassErr: onPassFault, wantOnPass: 1, wantErr: onPassFault},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			check := raddleCheckFixture(t, tt.proposal, validRaddleBoard(), nil, nil)
+			onPassCalls := 0
+			gate := loomshed.NewRaddleGate(check, func() error {
+				onPassCalls++
+				return tt.onPassErr
+			})
+
+			result, err := gate()
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("gate() error = %v; want %v", err, tt.wantErr)
+			}
+			if result.Passed != tt.wantPassed {
+				t.Errorf("gate() passed = %v; want %v", result.Passed, tt.wantPassed)
+			}
+			if tt.wantFindings != "" && !strings.Contains(result.Findings, tt.wantFindings) {
+				t.Errorf("gate() findings = %q; want it to contain %q", result.Findings, tt.wantFindings)
+			}
+			if onPassCalls != tt.wantOnPass {
+				t.Errorf("onPass calls = %d; want %d", onPassCalls, tt.wantOnPass)
+			}
+		})
+	}
+}
diff --git a/internal/loomshed/raddlefile.go b/internal/loomshed/raddlefile.go
new file mode 100644
index 00000000..768e4e42
--- /dev/null
+++ b/internal/loomshed/raddlefile.go
@@ -0,0 +1,557 @@
+// raddlefile.go implements the Raddle-File producer: a Go row with no agent that checks an approved raddle proposal once more, stages its store files and part records, files the entries on the board and ends the run's entry.
+
+package loomshed
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/discussionparser"
+	"github.com/Knatte18/loomyard/internal/fsx"
+	"github.com/Knatte18/loomyard/internal/raddleparser"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// raddleMaxReturns is how many times Raddle-File sends a proposal back to Raddle-Write; the failure after that halts the run for its parent.
+const raddleMaxReturns = 2
+
+// raddleWriteRow is the row a return sends the run to, and the row the halt's goto names.
+const raddleWriteRow = "Raddle-Write"
+
+// The files of the stage directory: the store files the board write keeps, the entry's created stamp and, written last, the hash of the proposal they were staged from.
+const (
+	stageProposalFile = "proposal.yaml"
+	stageColdFile     = "cold-proposal.yaml"
+	stageRecordFile   = "decision-record.md"
+	stageCreatedFile  = "created"
+	stageHashFile     = "hash"
+)
+
+// recordHashSuffix names the file beside a part record that holds the hash of the proposal the record was written from.
+const recordHashSuffix = ".hash"
+
+// RaddleRunEntry is what Raddle-File reads of the raddle run's own board entry: its slug, its created stamp, the labels that are not type labels, and its own project field.
+type RaddleRunEntry struct {
+	Slug         string
+	Created      time.Time
+	ModuleLabels []string
+	// Project is the project the Sketch belongs to, the level its entries are filed at; empty for the top level.
+	Project string
+}
+
+// RaddleFileDeps are the told paths and seams of the Raddle-File producer.
+type RaddleFileDeps struct {
+	// ProposalPath, ColdPath and RecordPath are the proposal, the cold proposal and the Sketch's decision record.
+	ProposalPath string
+	ColdPath     string
+	RecordPath   string
+	// StageDir holds the staged store files, and RecordsDir the part records PartRecordPath names.
+	StageDir   string
+	RecordsDir string
+	// PartRecordPath returns the path of the decision record of the entry slug.
+	PartRecordPath func(slug string) string
+	// StatePath and StateLockPath are the run's state record and its lock.
+	StatePath     string
+	StateLockPath string
+
+	// Check runs the proposal's checks at filing.
+	Check func() ([]raddleparser.Finding, error)
+	// Recheck runs the board re-check.
+	Recheck func() (raddleparser.Recheck, error)
+	// Entry reads the run's own board entry.
+	Entry func() (RaddleRunEntry, error)
+	// StoreDone reports whether the raddle store holds the Sketch's directory with that created stamp and hash, the filing's done marker.
+	StoreDone func(created time.Time, hash string) (bool, error)
+	// AlreadyFiled reports whether the board already holds every slug as an entry filed from the Sketch, the state a filing leaves when it fails between saving the board and writing the raddle store.
+	AlreadyFiled func(sketch string, slugs []string) (bool, error)
+	// File writes the filing on the board in one write.
+	File func(boardengine.RaddleFiling) error
+	// CreateBeam makes the filed project a beam; it is told the project's slug.
+	CreateBeam func(project string) error
+	// Release releases the filed tasks that are still draft.
+	Release func(slugs []string) error
+	// Notify tells the run's parent what was filed.
+	Notify func(line string) error
+	// EndEntry ends the run's own board entry.
+	EndEntry func() error
+	// Commit commits the raddle directory.
+	Commit func() error
+}
+
+// raddleFile is the Raddle-File producer.
+type raddleFile struct {
+	name string
+	deps RaddleFileDeps
+}
+
+var _ shedengine.ShedProducer = (*raddleFile)(nil)
+
+// NewRaddleFile returns the producer of the Raddle-File row, identified as name.
+func NewRaddleFile(name string, deps RaddleFileDeps) shedengine.ShedProducer {
+	return &raddleFile{name: name, deps: deps}
+}
+
+// Call implements shedengine.ShedProducer.
+// It reads the proposal and its hash and asks whether the store already holds the filing, which skips the checks below and steps 1 to 3.
+// When the store does not but the board already holds every filed entry and the stage still holds this proposal's hash, the filing's board write landed and its store write did not:
+// the checks and the approval match are skipped, since the filed slugs would count as taken, only the entries the re-check names as landed are read, and steps 1 to 3 run so the store is written.
+// Otherwise it runs the checks, the approval match in interactive mode and the board re-check; a failure of one sends the proposal back, deleting the stage and the part records.
+// Step 1 stages the store files, step 2 writes the part records and commits, and step 3 files the entries.
+// A step whose outputs carry the hash of the proposal now approved is skipped, so a retry after a crash finishes the steps it missed.
+// Step 4 makes the project a beam and step 5 releases its parts, both for the beam shape; step 6 notifies the parent once; step 7 ends the run's entry and the row is Done.
+// A failure of steps 4 to 7 is Stuck with Halt naming the step and the resume that re-runs the row.
+func (p *raddleFile) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if err := entryErr(ctx, p.name); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+
+	data, err := os.ReadFile(p.deps.ProposalPath)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("read the proposal", err)
+	}
+	hash := raddleparser.Hash(data)
+	current, err := ReadRaddleState(p.deps.StatePath, p.deps.StateLockPath)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("read the run's state", err)
+	}
+	entry, err := p.deps.Entry()
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("read the run's board entry", err)
+	}
+	filed, err := p.deps.StoreDone(entry.Created, hash)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("read the raddle store", err)
+	}
+
+	proposal, parseErr := raddleparser.Parse(data)
+	resumed := false
+	if !filed && parseErr == nil && p.stagedHashIs(hash) {
+		resumed, err = p.deps.AlreadyFiled(proposal.Sketch, raddleFiledSlugs(proposal))
+		if err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("read the board's filed entries", err)
+		}
+	}
+
+	var landed []string
+	if resumed {
+		// The filed entries hold the slugs, so the re-check's failures are ignored and only the entries it names as landed are read.
+		recheck, err := p.deps.Recheck()
+		if err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("re-check the board", err)
+		}
+		landed = recheck.Landed
+	} else if !filed {
+		reason, entries, err := p.verify(current, hash)
+		if err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("check the proposal", err)
+		}
+		if reason != "" {
+			return p.sendBack(ctx, current, reason)
+		}
+		landed = entries
+	}
+
+	if parseErr != nil {
+		return "", shedengine.OutputPointer{}, p.fail("parse the proposal", parseErr)
+	}
+	if !filed {
+		reason, err := p.stageAndFile(proposal, data, hash, entry)
+		if err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("file the proposal", err)
+		}
+		if reason != "" {
+			return p.sendBack(ctx, current, reason)
+		}
+	}
+	return p.finish(ctx, current, proposal, landed)
+}
+
+// verify returns the reason the proposal is sent back, empty when it passes every check, with the board_checked entries that landed meanwhile.
+// It runs the proposal's checks, then in interactive mode matches the proposal's hash against the recorded approval, then the board re-check.
+func (p *raddleFile) verify(current RaddleState, hash string) (reason string, landed []string, err error) {
+	findings, err := p.deps.Check()
+	if err != nil {
+		return "", nil, err
+	}
+	if len(findings) > 0 {
+		return "the proposal fails its checks: " + FormatRaddleFindings(findings), nil, nil
+	}
+
+	if current.Mode == RaddleModeInteractive {
+		switch {
+		case current.Approval == nil:
+			return "the proposal has no recorded approval, so it is not filed until the operator approves it", nil, nil
+		case current.Approval.Hash != hash:
+			return fmt.Sprintf("the proposal was edited after it was approved: its hash is %s and the approved hash is %s", hash, current.Approval.Hash), nil, nil
+		}
+	}
+
+	recheck, err := p.deps.Recheck()
+	if err != nil {
+		return "", nil, err
+	}
+	if len(recheck.Failures) > 0 {
+		return "the board moved since the proposal was approved: " + FormatRaddleFindings(recheck.Failures), nil, nil
+	}
+	return "", recheck.Landed, nil
+}
+
+// stageAndFile runs steps 1 to 3: it stages the store files, writes the part records and commits them, and files the entries.
+// It returns the reason the proposal is sent back when the board write's own re-check refuses, and any other failure as an error.
+func (p *raddleFile) stageAndFile(proposal raddleparser.Proposal, data []byte, hash string, entry RaddleRunEntry) (reason string, err error) {
+	record, err := os.ReadFile(p.deps.RecordPath)
+	if err != nil {
+		return "", err
+	}
+	if err := p.stage(data, record, hash, entry); err != nil {
+		return "", fmt.Errorf("stage the store files: %w", err)
+	}
+	if err := p.writeRecords(proposal, record, hash); err != nil {
+		return "", err
+	}
+	if err := p.deps.Commit(); err != nil {
+		return "", fmt.Errorf("commit the raddle directory: %w", err)
+	}
+
+	filing, err := p.filing(proposal, hash, entry)
+	if err != nil {
+		return "", err
+	}
+	if err := p.deps.File(filing); err != nil {
+		if errors.Is(err, boardengine.ErrRaddleRecheck) {
+			return "the board moved while the proposal was being filed: " + err.Error(), nil
+		}
+		return "", err
+	}
+	return "", nil
+}
+
+// stagedHashIs reports whether the stage directory holds the hash file of the proposal whose hash is hash, which step 1 writes last.
+func (p *raddleFile) stagedHashIs(hash string) bool {
+	staged, err := os.ReadFile(filepath.Join(p.deps.StageDir, stageHashFile))
+	return err == nil && string(staged) == hash
+}
+
+// stage writes step 1's store files into the stage directory, the hash last, unless the stage already holds this proposal's hash.
+func (p *raddleFile) stage(data, record []byte, hash string, entry RaddleRunEntry) error {
+	if p.stagedHashIs(hash) {
+		return nil
+	}
+	cold, err := os.ReadFile(p.deps.ColdPath)
+	if err != nil {
+		return fmt.Errorf("read the cold proposal: %w", err)
+	}
+	files := []struct {
+		name    string
+		content []byte
+	}{
+		{stageProposalFile, data},
+		{stageColdFile, cold},
+		{stageRecordFile, record},
+		{stageCreatedFile, []byte(entry.Created.UTC().Format(time.RFC3339Nano))},
+		{stageHashFile, []byte(hash)},
+	}
+	for _, file := range files {
+		if err := fsx.AtomicWriteBytes(filepath.Join(p.deps.StageDir, file.name), file.content); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// writeRecords writes step 2's part records: the Sketch's record whole for the project and for the tapestry shape's one part, and a record cut by SplicePart for every other part.
+// A record whose hash file already holds the proposal's hash is left as it is.
+// A SplicePart error is returned naming the part.
+func (p *raddleFile) writeRecords(proposal raddleparser.Proposal, record []byte, hash string) error {
+	if proposal.Project != nil {
+		if err := p.writeRecord(proposal.Project.Slug, record, hash); err != nil {
+			return err
+		}
+	}
+	for _, part := range proposal.Parts {
+		content := record
+		if proposal.Shape != raddleparser.ShapeTapestry {
+			spliced, err := discussionparser.SplicePart(record, discussionparser.PartSplice{
+				Goal:           raddlePartGoal(part),
+				Scope:          raddlePartScope(part),
+				Decisions:      part.Decisions,
+				OpenRisks:      part.OpenRisks,
+				Criteria:       part.Criteria,
+				PatternChanges: part.PatternChanges,
+			})
+			if err != nil {
+				return fmt.Errorf("cut the decision record of the part %s: %w", part.Slug, err)
+			}
+			content = spliced
+		}
+		if err := p.writeRecord(part.Slug, content, hash); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// writeRecord writes the record of the entry slug and the hash file beside it, the hash last, unless the hash file already holds hash and the record exists.
+func (p *raddleFile) writeRecord(slug string, content []byte, hash string) error {
+	path := p.deps.PartRecordPath(slug)
+	_, statErr := os.Stat(path)
+	if held, err := os.ReadFile(path + recordHashSuffix); err == nil && string(held) == hash && statErr == nil {
+		return nil
+	}
+	if err := fsx.AtomicWriteBytes(path, content); err != nil {
+		return fmt.Errorf("write the decision record of %s: %w", slug, err)
+	}
+	return fsx.AtomicWriteBytes(path+recordHashSuffix, []byte(hash))
+}
+
+// raddlePartGoal renders the Goal section of a part's record from its title and contract.
+func raddlePartGoal(part raddleparser.Part) string {
+	return fmt.Sprintf("%s\n\nTakes: %s\nDelivers: %s\nExports: %s", part.Title, part.Contract.Takes, part.Contract.Delivers, part.Contract.Exports)
+}
+
+// raddlePartScope renders the Scope section of a part's record from its packages.
+func raddlePartScope(part raddleparser.Part) string {
+	if len(part.Packages) == 0 {
+		return "The part names no package."
+	}
+	lines := make([]string, len(part.Packages))
+	for i, pkg := range part.Packages {
+		lines[i] = fmt.Sprintf("- %s (about %d changed lines)", pkg.Path, pkg.Size)
+	}
+	return "The part changes these packages:\n\n" + strings.Join(lines, "\n")
+}
+
+// raddlePartBody renders the board body of a filed part: the Sketch it comes from, its contract and its packages with their sizes.
+func raddlePartBody(sketch string, part raddleparser.Part) string {
+	return fmt.Sprintf("%s.\n\nTakes: %s\nDelivers: %s\nExports: %s\n\n%s\n", boardengine.RaddlePartBodyPrefix(sketch), part.Contract.Takes, part.Contract.Delivers, part.Contract.Exports, raddlePartScope(part))
+}
+
+// filing builds the board filing from the proposal, the part records on disk and the staged store files.
+// The parts are in dependency order, the project is the project shapes' own entry, and the entries are filed at the run's own project level.
+// Every entry carries its type label and the Sketch's module labels, never the sketch label.
+func (p *raddleFile) filing(proposal raddleparser.Proposal, hash string, entry RaddleRunEntry) (boardengine.RaddleFiling, error) {
+	staged := make(map[string][]byte, 3)
+	for _, name := range []string{stageProposalFile, stageColdFile, stageRecordFile} {
+		content, err := os.ReadFile(filepath.Join(p.deps.StageDir, name))
+		if err != nil {
+			return boardengine.RaddleFiling{}, fmt.Errorf("read the staged %s: %w", name, err)
+		}
+		staged[name] = content
+	}
+
+	labels := func(entryType string) []string {
+		return append([]string{entryType}, entry.ModuleLabels...)
+	}
+	filing := boardengine.RaddleFiling{
+		Sketch:       proposal.Sketch,
+		Created:      entry.Created,
+		Project:      entry.Project,
+		Hash:         hash,
+		RunEntry:     entry.Slug,
+		Release:      proposal.Shape != raddleparser.ShapeBeam,
+		Proposal:     staged[stageProposalFile],
+		ColdProposal: staged[stageColdFile],
+		SketchRecord: staged[stageRecordFile],
+		Check: func(tasks []boardengine.Task, store boardengine.RaddleStore) error {
+			board := raddleparser.BoardContext{
+				Sketch:       entry.Slug,
+				Entry:        entry.Slug,
+				ModuleLabels: entry.ModuleLabels,
+				Entries:      raddleBoardEntries(tasks),
+				Store:        store.Slugs(),
+				Filing:       true,
+			}
+			if failures := raddleparser.RecheckBoard(proposal, board).Failures; len(failures) > 0 {
+				return errors.New(FormatRaddleFindings(failures))
+			}
+			return nil
+		},
+	}
+
+	var slugs []string
+	for _, part := range dependencyOrder(proposal.Parts) {
+		record, err := os.ReadFile(p.deps.PartRecordPath(part.Slug))
+		if err != nil {
+			return boardengine.RaddleFiling{}, fmt.Errorf("read the decision record of %s: %w", part.Slug, err)
+		}
+		slugs = append(slugs, part.Slug)
+		filing.Parts = append(filing.Parts, boardengine.RaddleEntry{
+			Slug:      part.Slug,
+			Title:     part.Title,
+			Kind:      boardengine.KindTask,
+			Labels:    labels(part.Type),
+			Recipe:    part.Recipe,
+			Profile:   part.Profile,
+			DependsOn: part.DependsOn,
+			Body:      raddlePartBody(proposal.Sketch, part),
+			Record:    record,
+		})
+	}
+	if proposal.Project != nil {
+		record, err := os.ReadFile(p.deps.PartRecordPath(proposal.Project.Slug))
+		if err != nil {
+			return boardengine.RaddleFiling{}, fmt.Errorf("read the decision record of %s: %w", proposal.Project.Slug, err)
+		}
+		filing.ProjectEntry = &boardengine.RaddleEntry{
+			Slug:   proposal.Project.Slug,
+			Title:  proposal.Project.Title,
+			Kind:   boardengine.KindProject,
+			Labels: labels(proposal.Project.Type),
+			Body:   fmt.Sprintf("%s: %s.\n", boardengine.RaddleProjectBodyPrefix(proposal.Sketch), strings.Join(slugs, ", ")),
+			Record: record,
+		}
+	}
+	return filing, nil
+}
+
+// raddleBoardEntries maps the board's entries onto the entries the proposal's checks read.
+func raddleBoardEntries(tasks []boardengine.Task) []raddleparser.BoardEntry {
+	entries := make([]raddleparser.BoardEntry, len(tasks))
+	for i, task := range tasks {
+		entries[i] = raddleparser.BoardEntry{Slug: task.Slug, Kind: task.Kind, Labels: task.Labels, Open: !boardengine.IsDoneStatus(task.Status)}
+		if !task.Revised.IsZero() {
+			entries[i].Revised = task.Revised.UTC().Format(time.RFC3339)
+		}
+	}
+	return entries
+}
+
+// dependencyOrder returns parts so that each follows every part of the list it depends on, keeping the proposal's order otherwise.
+// A part left over by a cycle, which the proposal's checks refuse, is appended last.
+func dependencyOrder(parts []raddleparser.Part) []raddleparser.Part {
+	ordered := make([]raddleparser.Part, 0, len(parts))
+	placed := map[string]bool{}
+	isPart := func(slug string) bool {
+		return slices.ContainsFunc(parts, func(part raddleparser.Part) bool { return part.Slug == slug })
+	}
+	for len(ordered) < len(parts) {
+		progressed := false
+		for _, part := range parts {
+			if placed[part.Slug] {
+				continue
+			}
+			ready := !slices.ContainsFunc(part.DependsOn, func(dep string) bool { return isPart(dep) && !placed[dep] })
+			if ready {
+				ordered = append(ordered, part)
+				placed[part.Slug] = true
+				progressed = true
+			}
+		}
+		if !progressed {
+			for _, part := range parts {
+				if !placed[part.Slug] {
+					ordered = append(ordered, part)
+					placed[part.Slug] = true
+				}
+			}
+		}
+	}
+	return ordered
+}
+
+// finish runs steps 4 to 7 over the filed entries.
+// Each is skipped when its result is there: the beam and the release are idempotent calls, the notice is marked in the state, and the entry's end is the last write.
+func (p *raddleFile) finish(ctx context.Context, current RaddleState, proposal raddleparser.Proposal, landed []string) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if proposal.Shape == raddleparser.ShapeBeam {
+		if err := p.deps.CreateBeam(proposal.Project.Slug); err != nil {
+			return p.halt(ctx, "make the project a beam", err)
+		}
+		slugs := make([]string, len(proposal.Parts))
+		for i, part := range dependencyOrder(proposal.Parts) {
+			slugs[i] = part.Slug
+		}
+		if err := p.deps.Release(slugs); err != nil {
+			return p.halt(ctx, "release the filed parts", err)
+		}
+	}
+
+	if !current.NoticeSent {
+		if err := p.deps.Notify(raddleFiledNotice(proposal, landed)); err != nil {
+			return p.halt(ctx, "notify the parent", err)
+		}
+		if _, err := UpdateRaddleState(p.deps.StatePath, p.deps.StateLockPath, func(stored *RaddleState) { stored.NoticeSent = true }); err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("record the notice", err)
+		}
+	}
+	if err := p.deps.EndEntry(); err != nil {
+		return p.halt(ctx, "end the run's board entry", err)
+	}
+	if err := cancelErr(ctx, p.name); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	return shedengine.Done, shedengine.OutputPointer{}, nil
+}
+
+// raddleFiledSlugs returns the slug of the proposal's project, when it has one, followed by the slug of each part in the proposal's order.
+func raddleFiledSlugs(proposal raddleparser.Proposal) []string {
+	var slugs []string
+	if proposal.Project != nil {
+		slugs = append(slugs, proposal.Project.Slug)
+	}
+	for _, part := range proposal.Parts {
+		slugs = append(slugs, part.Slug)
+	}
+	return slugs
+}
+
+// raddleFiledNotice renders the line that tells the parent what the run filed and which weighed entries landed meanwhile.
+func raddleFiledNotice(proposal raddleparser.Proposal, landed []string) string {
+	slugs := raddleFiledSlugs(proposal)
+	line := fmt.Sprintf("raddle: filed %d entries from the Sketch %s as the %s shape: %s", len(slugs), proposal.Sketch, proposal.Shape, strings.Join(slugs, ", "))
+	if len(landed) > 0 {
+		line += "; entries the proposal weighed that landed meanwhile: " + strings.Join(landed, ", ")
+	}
+	return line
+}
+
+// sendBack answers a failure of the proposal.
+// With the run's returns spent it is Stuck with Halt for the parent, naming the failures, the used returns and the goto that restarts the row.
+// Otherwise it deletes the stage and the part records of the failed attempt, raises the return count, records the reason and clears the approval in one state update, and is Stuck without Halt, which the row's on_stuck sends to Raddle-Write.
+func (p *raddleFile) sendBack(ctx context.Context, current RaddleState, reason string) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if err := cancelErr(ctx, p.name); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	if current.Returns >= raddleMaxReturns {
+		return shedengine.Stuck, shedengine.OutputPointer{
+			Reason: fmt.Sprintf("%s failed the filing again: %s; the run used its %d returns to %s; way forward: settle the cause, then run lym loom goto --to %s, which starts a new session with the approval cleared; the count of returns is not reset, so each further failure halts for the parent again", p.name, reason, raddleMaxReturns, raddleWriteRow, raddleWriteRow),
+			Halt:   true,
+		}, nil
+	}
+
+	for _, dir := range []string{p.deps.StageDir, p.deps.RecordsDir} {
+		if err := os.RemoveAll(dir); err != nil {
+			return "", shedengine.OutputPointer{}, p.fail("delete the outputs of the failed attempt", err)
+		}
+	}
+	if _, err := UpdateRaddleState(p.deps.StatePath, p.deps.StateLockPath, func(stored *RaddleState) {
+		stored.Returns++
+		stored.ReturnReason = reason
+		stored.Approval = nil
+	}); err != nil {
+		return "", shedengine.OutputPointer{}, p.fail("record the return", err)
+	}
+	return shedengine.Stuck, shedengine.OutputPointer{Reason: fmt.Sprintf("%s returned the proposal to %s: %s", p.name, raddleWriteRow, reason)}, nil
+}
+
+// halt is the Stuck-with-Halt verdict of a failed step after the filing, naming the step and the resume that re-runs the row from the first step not done.
+func (p *raddleFile) halt(ctx context.Context, step string, err error) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if cancelled := cancelErr(ctx, p.name); cancelled != nil {
+		return "", shedengine.OutputPointer{}, cancelled
+	}
+	return shedengine.Stuck, shedengine.OutputPointer{
+		Reason: fmt.Sprintf("%s: could not %s: %v; way forward: fix what the error names, then run lym loom resume, which re-runs the row from the first step not done", p.name, step, err),
+		Halt:   true,
+	}, nil
+}
+
+// fail returns the error of a failed step, naming the producer and the re-step that retries it.
+func (p *raddleFile) fail(step string, err error) error {
+	return fmt.Errorf("loomshed: %s: %s: %w; way forward: the fault is transient, re-step the %s row", p.name, step, err, p.name)
+}
