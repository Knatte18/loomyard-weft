+		startedAt = createdAt
+	}
+	r.reportSessionEnd(SessionEnd{
+		SessionID: rs.SessionID,
+		Engine:    engineName,
+		Role:      rs.Role,
+		Model:     rs.Model,
+		Worktree:  r.paneCwd,
+		StartedAt: startedAt,
+		EndedAt:   r.clock.Now(),
+		Outcome:   Outcome(runOutcomeStopped),
+		Usage:     usage,
+	})
+}
