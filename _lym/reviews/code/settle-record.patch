+// blockRowYAML returns a one-row recipe whose row is a well-formed block row, with the extra line appended to the row when non-empty.
+func blockRowYAML(extra string) string {
+	yaml := `version: 1
+entry: Motif
+terminals: [done]
+producers:
+  - name: Motif
+    block: motif
+    block_gate: always
+`
+	if extra != "" {
+		yaml += "    " + extra + "\n"
+	}
+	return yaml
+}
