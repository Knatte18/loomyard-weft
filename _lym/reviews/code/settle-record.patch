+// longestBacktickRun returns the length of the longest run of consecutive backticks in text.
+func longestBacktickRun(text string) int {
+	longestRun, run := 0, 0
+	for _, r := range text {
+		if r != '`' {
+			run = 0
+			continue
+		}
+		run++
