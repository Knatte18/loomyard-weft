+// tmuxkit_snapshot_linux_test.go holds the tier-1 test of the process snapshot.
+// The snapshot reads /proc, so the test runs only on Linux.
+
+package tmuxkit
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
