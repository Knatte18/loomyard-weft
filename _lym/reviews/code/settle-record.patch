+package testcover_test
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// mutantSource is the fixture file the mutant tests plan over.
+const mutantSource = `package fix
+
+func Classify(n int) string {
+	if n < 0 {
+		return "negative"
+	}
+	return "non-negative"
+}
+
+func Count(xs []int) int {
+	total := 0
+	for i := 0; i < len(xs); i++ {
+		total += xs[i]
+	}
+	const limit = 3
+	_ = limit
+	return total
+}
+
+func Join(x, y []int) int {
+	var total int
+	total += len(x) +
+		len(y)
+	return total
+}
+`
+
+// Indexes of the fixture's blocks in mutantBlocks, in the order a coverage profile lists them.
+const (
+	blockClassifyHead = iota
+	blockClassifyNegative
+	blockClassifyTail
+	blockCountHead
+	blockCountLoop
+	blockCountTail
+	blockJoinSplitStatement
+)
+
+// mutantBlocks returns the coverage blocks of mutantSource, each spanning the text from one marker to the end of another.
+func mutantBlocks(t *testing.T) []testcover.ProfileBlock {
+	t.Helper()
+	spans := [][2]string{
+		{"{\n\tif n < 0", "if n < 0 {"},
+		{"{\n\t\treturn \"negative\"", "\"negative\"\n\t}"},
+		{"return \"non-negative\"", "\"non-negative\"\n}"},
+		{"{\n\ttotal := 0", "i++ {"},
+		{"{\n\t\ttotal +=", "xs[i]\n\t}"},
+		{"const limit", "return total\n}"},
+		{"total += len(x)", "len(y)"},
+	}
+	var blocks []testcover.ProfileBlock
+	for _, span := range spans {
+		start := strings.Index(mutantSource, span[0])
+		end := start + strings.Index(mutantSource[start:], span[1]) + len(span[1])
+		if start < 0 || end < start {
+			t.Fatalf("the fixture holds no span from %q to %q", span[0], span[1])
+		}
+		startLine, startCol := lineCol(mutantSource, start)
+		endLine, endCol := lineCol(mutantSource, end)
+		blocks = append(blocks, testcover.ProfileBlock{
+			File: "m/fix/fix.go", StartLine: startLine, StartCol: startCol, EndLine: endLine, EndCol: endCol, Statements: 1,
+		})
+	}
+	return blocks
+}
+
+// lineCol returns the line and byte column, both counted from 1, of offset in text.
+func lineCol(text string, offset int) (int, int) {
+	before := text[:offset]
+	return strings.Count(before, "\n") + 1, offset - strings.LastIndex(before, "\n")
+}
+
+// planFixture writes mutantSource into a package directory and plans the mutants of the blocks targets indexes.
+func planFixture(t *testing.T, targets ...int) (string, *testcover.MutantPlan) {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "fix.go"), []byte(mutantSource), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	blocks := mutantBlocks(t)
+	keys, err := testcover.KeyBlocks(dir, blocks)
+	if err != nil {
+		t.Fatal(err)
+	}
+	set := testcover.BlockSet{}
+	for _, i := range targets {
+		set[keys[i].String()] = struct{}{}
+	}
+	plan, err := testcover.PlanMutants(dir, "m/fix", blocks, set)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return dir, plan
+}
+
+//testtiming:keep pins each site's operator and line and the sites the mutator leaves alone
+func TestPlanMutants(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	type site struct {
+		Line     int
+		Operator string
+	}
+	tests := []struct {
+		name    string
+		targets []int
+		want    []site
+	}{
+		{
+			name:    "a condition and its literals become mutants, and a site of a block no target holds does not",
+			targets: []int{blockClassifyHead},
+			want:    []site{{4, testcover.OperatorNegateCondition}, {4, testcover.OperatorChangeConstant}},
+		},
+		{
+			name:    "a string literal is a constant to change",
+			targets: []int{blockClassifyNegative, blockClassifyTail},
+			want:    []site{{5, testcover.OperatorChangeConstant}, {7, testcover.OperatorChangeConstant}},
+		},
+		{
+			name:    "a declaring assignment and a for post statement are kept while their literals and the condition change",
+			targets: []int{blockCountHead},
+			want:    []site{{11, testcover.OperatorChangeConstant}, {12, testcover.OperatorChangeConstant}, {12, testcover.OperatorNegateCondition}},
+		},
+		{
+			name:    "an assignment statement is dropped",
+			targets: []int{blockCountLoop},
+			want:    []site{{13, testcover.OperatorDropStatement}},
+		},
+		{
+			name:    "a constant declaration and a blank assignment hold no mutant",
+			targets: []int{blockCountTail},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, plan := planFixture(t, tt.targets...)
+			var got []site
+			for i, m := range plan.Mutants {
+				if m.ID != i+1 || m.File != "fix.go" {
+					t.Errorf("mutant %d = %+v; want ID %d in fix.go", i, m, i+1)
+				}
+				got = append(got, site{m.Line, m.Operator})
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("PlanMutants sites = %v; want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestMutantPlan_WriteOverlay(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	dir, plan := planFixture(t, blockClassifyHead, blockClassifyNegative, blockClassifyTail, blockCountLoop)
+	out := t.TempDir()
+	overlay, err := plan.WriteOverlay(out, map[int]bool{2: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(overlay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got struct{ Replace map[string]string }
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatal(err)
+	}
+	helpers := filepath.Join(dir, "lym_testcover_mutant.go")
+	wantReplace := map[string]string{filepath.Join(dir, "fix.go"): filepath.Join(out, "fix.go"), helpers: filepath.Join(out, "lym_testcover_mutant.go")}
+	if !reflect.DeepEqual(got.Replace, wantReplace) {
+		t.Fatalf("overlay Replace = %v; want %v", got.Replace, wantReplace)
+	}
+
+	mutated, err := os.ReadFile(got.Replace[filepath.Join(dir, "fix.go")])
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := strings.NewReplacer(
+		"if n < 0 {", "if lymMutantBool(n < 0, 1) {",
+		`return "negative"`, `return lymMutantString("negative", 3)`,
+		`return "non-negative"`, `return lymMutantString("non-negative", 4)`,
+		"total += xs[i]", "if lymMutantKeep(5) { total += xs[i] }",
+	).Replace(mutantSource)
+	if string(mutated) != want {
+		t.Errorf("mutated fix.go =\n%s\nwant, with the dropped mutant 2 left out and no line added,\n%s", mutated, want)
+	}
+	switchFile, err := os.ReadFile(got.Replace[helpers])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(string(switchFile), "package fix\n") || !strings.Contains(string(switchFile), testcover.MutantEnv) {
+		t.Errorf("helper file =\n%s\nwant one in package fix reading %s", switchFile, testcover.MutantEnv)
+	}
+}
+
+func TestMutantPlan_UnbuildableMutants(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	classify := []int{blockClassifyHead, blockClassifyNegative}
+	tests := []struct {
+		name    string
+		targets []int
+		err     error
+		dropped map[int]bool
+		want    []int
+	}{
+		{name: "every mutant spanning a refused line", targets: classify, err: &testcover.MutantBuildError{Lines: []testcover.SourceLine{{File: "fix.go", Line: 4}}}, want: []int{1, 2}},
+		{name: "a dropped mutant stays dropped", targets: classify, err: &testcover.MutantBuildError{Lines: []testcover.SourceLine{{File: "fix.go", Line: 4}}}, dropped: map[int]bool{1: true}, want: []int{2}},
+		{name: "a line of another file", targets: classify, err: &testcover.MutantBuildError{Lines: []testcover.SourceLine{{File: "other.go", Line: 5}}}},
+		{name: "an error that names no line", targets: classify, err: errors.New("mutant binary: timed out")},
+		{name: "a mutant spanning two lines when the second is refused", targets: []int{blockJoinSplitStatement}, err: &testcover.MutantBuildError{Lines: []testcover.SourceLine{{File: "fix.go", Line: 23}}}, want: []int{1}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, plan := planFixture(t, tt.targets...)
+			if got := plan.UnbuildableMutants(tt.err, tt.dropped); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("UnbuildableMutants = %v; want %v", got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/testcover/mutantverdict.go b/internal/testcover/mutantverdict.go
new file mode 100644
index 00000000..61fa7378
--- /dev/null
+++ b/internal/testcover/mutantverdict.go
@@ -0,0 +1,107 @@
+// mutantverdict.go confirms coverage redundancy candidates by the mutants each one kills.
+// A candidate is redundant only when its covering tests kill every mutant it kills.
+
+package testcover
+
+import (
+	"cmp"
+	"slices"
+	"strings"
+)
+
+// Reasons a mutation check does not judge a candidate.
+const (
+	ReasonNoMutant       = "its blocks hold no mutant"
+	ReasonKillsNone      = "kills no mutant of its blocks"
+	ReasonFailsUnmutated = "does not pass with no mutant on"
+)
+
+// MutantCandidate is one coverage redundancy candidate as JudgeMutants sees it.
+type MutantCandidate struct {
+	Name string
+	// Elapsed is the test's standalone seconds; the greedy pass removes slower tests first.
+	Elapsed float64
+	// Covering names the tests that cover the candidate's blocks.
+	Covering []string
+	// Mutants are the IDs of the mutants in the blocks the candidate covers.
+	Mutants []int
+	// FailsUnmutated is set when the candidate did not pass with no mutant on.
+	FailsUnmutated bool
+}
+
+// Kills holds, for each mutant by ID, the tests that failed while it was on.
+type Kills map[int]map[string]bool
+
+// MutantVerdict is the mutation check's judgement of one candidate.
+type MutantVerdict struct {
+	Name string
+	// Reason is non-empty for a candidate the check cannot judge, and names why.
+	Reason string
+	// Killed are the IDs of the mutants the candidate killed, ascending.
+	Killed []int
+	// Unique are the IDs of the mutants it killed that none of its covering tests killed, ascending.
+	Unique []int
+	// Redundant is set when it killed a mutant and a covering test killed each one it killed.
+	Redundant bool
+	// Removable is set for a redundant candidate the greedy pass drops:
+	// a test it keeps killed each mutant the candidate killed.
+	Removable bool
+}
+
+// JudgeMutants returns the verdict of each of candidates, in the order given, from kills.
+// A candidate that did not pass with no mutant on, whose blocks hold no mutant or that killed none is not judged.
+// The removable set is a greedy pass over the redundant candidates, slowest first, then by name.
+// It drops a candidate while some other test still kept killed each mutant the candidate killed.
+func JudgeMutants(candidates []MutantCandidate, kills Kills) []MutantVerdict {
+	out := make([]MutantVerdict, len(candidates))
+	var redundant []int
+	for i, c := range candidates {
+		verdict := MutantVerdict{Name: c.Name}
+		switch {
+		case c.FailsUnmutated:
+			verdict.Reason = ReasonFailsUnmutated
+		case len(c.Mutants) == 0:
+			verdict.Reason = ReasonNoMutant
+		}
+		if verdict.Reason == "" {
+			for _, id := range slices.Sorted(slices.Values(c.Mutants)) {
+				if !kills[id][c.Name] {
+					continue
+				}
+				verdict.Killed = append(verdict.Killed, id)
+				if !slices.ContainsFunc(c.Covering, func(name string) bool { return kills[id][name] }) {
+					verdict.Unique = append(verdict.Unique, id)
+				}
+			}
+			switch {
+			case len(verdict.Killed) == 0:
+				verdict.Reason = ReasonKillsNone
+			case len(verdict.Unique) == 0:
+				verdict.Redundant = true
+				redundant = append(redundant, i)
+			}
+		}
+		out[i] = verdict
+	}
+
+	slices.SortStableFunc(redundant, func(a, b int) int {
+		return cmp.Or(cmp.Compare(candidates[b].Elapsed, candidates[a].Elapsed), strings.Compare(candidates[a].Name, candidates[b].Name))
+	})
+	removed := map[string]bool{}
+	for _, i := range redundant {
+		name := candidates[i].Name
+		killedElsewhere := func(id int) bool {
+			for killer := range kills[id] {
+				if killer != name && !removed[killer] {
+					return true
+				}
+			}
+			return false
+		}
+		if !slices.ContainsFunc(out[i].Killed, func(id int) bool { return !killedElsewhere(id) }) {
+			out[i].Removable = true
+			removed[name] = true
+		}
+	}
+	return out
+}
diff --git a/internal/testcover/mutantverdict_test.go b/internal/testcover/mutantverdict_test.go
new file mode 100644
index 00000000..8eef39ab
--- /dev/null
+++ b/internal/testcover/mutantverdict_test.go
@@ -0,0 +1,77 @@
+package testcover_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testcover"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// killedBy returns a set of test names.
+func killedBy(names ...string) map[string]bool {
+	set := map[string]bool{}
+	for _, name := range names {
+		set[name] = true
+	}
+	return set
+}
+
+func TestJudgeMutants(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	tests := []struct {
+		name       string
+		candidates []testcover.MutantCandidate
+		kills      testcover.Kills
+		want       []testcover.MutantVerdict
+	}{
+		{
+			name:       "a covering test that kills every mutant the candidate kills makes it redundant and removable",
+			candidates: []testcover.MutantCandidate{{Name: "A", Elapsed: 1, Covering: []string{"B"}, Mutants: []int{2, 1, 3}}},
+			kills:      testcover.Kills{1: killedBy("A", "B"), 2: killedBy("A", "B"), 3: killedBy("B")},
+			want:       []testcover.MutantVerdict{{Name: "A", Killed: []int{1, 2}, Redundant: true, Removable: true}},
+		},
+		{
+			name:       "a kill no covering test shares refutes the candidate, though a test outside its covers shares it",
+			candidates: []testcover.MutantCandidate{{Name: "A", Elapsed: 1, Covering: []string{"B"}, Mutants: []int{1, 2}}},
+			kills:      testcover.Kills{1: killedBy("A", "B"), 2: killedBy("A", "X")},
+			want:       []testcover.MutantVerdict{{Name: "A", Killed: []int{1, 2}, Unique: []int{2}}},
+		},
+		{
+			name: "a candidate that fails unmutated, holds no mutant or kills none is not judged",
+			candidates: []testcover.MutantCandidate{
+				{Name: "Fails", Covering: []string{"B"}, Mutants: []int{1}, FailsUnmutated: true},
+				{Name: "Empty", Covering: []string{"B"}},
+				{Name: "Silent", Covering: []string{"B"}, Mutants: []int{1}},
+			},
+			kills: testcover.Kills{1: killedBy("Fails", "B")},
+			want: []testcover.MutantVerdict{
+				{Name: "Fails", Reason: testcover.ReasonFailsUnmutated},
+				{Name: "Empty", Reason: testcover.ReasonNoMutant},
+				{Name: "Silent", Reason: testcover.ReasonKillsNone},
+			},
+		},
+		{
+			name: "two candidates killing only each other's mutants: the slower is removable and the other kept",
+			candidates: []testcover.MutantCandidate{
+				{Name: "D", Elapsed: 1, Covering: []string{"C"}, Mutants: []int{1}},
+				{Name: "C", Elapsed: 2, Covering: []string{"D"}, Mutants: []int{1}},
+			},
+			kills: testcover.Kills{1: killedBy("C", "D")},
+			want: []testcover.MutantVerdict{
+				{Name: "D", Killed: []int{1}, Redundant: true},
+				{Name: "C", Killed: []int{1}, Redundant: true, Removable: true},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := testcover.JudgeMutants(tt.candidates, tt.kills); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("JudgeMutants = %+v\nwant           %+v", got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/testcover/runner.go b/internal/testcover/runner.go
index def6e0c9..5f614362 100644
--- a/internal/testcover/runner.go
+++ b/internal/testcover/runner.go
@@ -10,6 +10,8 @@ import (
 	"fmt"
 	"os"
 	"os/exec"
+	"path"
+	"path/filepath"
 	"regexp"
 	"slices"
 	"strconv"
@@ -144,14 +146,17 @@ func (tc Toolchain) ListTests(importPath, tags string) ([]string, error) {
 
 var testResultLine = regexp.MustCompile(`(?m)^--- (PASS|FAIL|SKIP): (\S+) \(([0-9.]+)s\)$`)
 
-// RunAlone runs the top-level test name alone under the coverage binary bin in dir, writing its profile to profile.
+// RunAlone runs the top-level test name alone under the test binary bin in dir, writing its profile to profile.
 // It reads the test's outcome and elapsed time from the binary's verbose output,
 // and the profile's blocks for a test that passed, or skipped after writing one.
