+				{"AwkProgramAndStrandStayLiteral", "awk '{print $1}' {strand}", map[string]string{"slug": "s"}, "awk '{print $1}' {strand}"},
+				{"UnknownPlaceholderStaysLiteral", "echo {x}", map[string]string{"slug": "s"}, "echo {x}"},
