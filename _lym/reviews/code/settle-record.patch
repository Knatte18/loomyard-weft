+// roundsnapshot_test.go tests the round snapshot record the review producer writes at a round's start.
+
+package shedadapters
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/testkit/shedfake"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestBurlerReviewProducer_Call_RecordsRoundSnapshot covers what the record holds after an accepted review.
+// It also covers that a failed first attempt's record survives an edited target.
+// It also covers that a row with no snapshot records no target id.
+func TestBurlerReviewProducer_Call_RecordsRoundSnapshot(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	const (
+		firstEntry  = "### Added after Discussion (parent, 2026-11-17): First call\n\nDecision: cache per run.\n"
+		secondEntry = "### Added after Discussion (parent, 2026-11-17): Second call\n\nDecision: no retry.\n"
+	)
+	digestOf := func(text string) string {
+		sum := sha256.Sum256([]byte(text))
+		return hex.EncodeToString(sum[:])
+	}
+	wantDecisions := []addedDecisionDigest{
+		{Title: "First call", Digest: digestOf("### Added after Discussion (parent, 2026-11-17): First call\n\nDecision: cache per run.")},
+		{Title: "Second call", Digest: digestOf("### Added after Discussion (parent, 2026-11-17): Second call\n\nDecision: no retry.")},
+	}
+
+	tests := []struct {
+		name string
+		// withSnapshot gives the producer an overlay snapshot over the temp target.
+		withSnapshot bool
+		// failFirst makes the first Call fail through its failure exit, and the target is edited before the second.
+		failFirst bool
+	}{
+		{name: "an accepted review leaves the scope, paths, target id and decision digests", withSnapshot: true},
+		{name: "a second call keeps the first attempt's target id", withSnapshot: true, failFirst: true},
+		{name: "a nil snapshot leaves no target id"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			root := t.TempDir()
+			if err := os.WriteFile(filepath.Join(root, "target.txt"), []byte("one\n"), 0o644); err != nil {
+				t.Fatalf("WriteFile(target) = %v; want nil", err)
+			}
+			recordPath := filepath.Join(root, "decisions.md")
+			if err := os.WriteFile(recordPath, []byte("# Record\n\n## Decisions\n\n"+firstEntry+"\n"+secondEntry), 0o644); err != nil {
+				t.Fatalf("WriteFile(record) = %v; want nil", err)
+			}
+			snapshot := TargetSnapshot{Scope: burlerengine.FixScopeOverlay, WorktreeRoot: root, Paths: []string{"target.txt"}, CacheDir: filepath.Join(root, "cache")}
+			wantID, err := snapshot.ID()
+			if err != nil {
+				t.Fatalf("ID() = %v; want nil", err)
+			}
+
+			spec := newHalfSpec()
+			spec.profile.Target = burlerengine.FileSet{Paths: []string{"target.txt"}}
+			spec.decisionRecordPath = recordPath
+			if tt.withSnapshot {
+				spec.snapshot = &snapshot
+			}
+			runner := &shedfake.BurlerHalfRunner{ReviewResults: []burlerengine.ReviewResult{reviewDone("d1")}}
+			if tt.failFirst {
+				runner = &shedfake.BurlerHalfRunner{
+					ReviewResults: []burlerengine.ReviewResult{{}, reviewDone("d1")},
+					ReviewErrs:    []error{errors.New("runner failed"), nil},
+				}
+			}
+			runDir := filepath.Join(root, "run")
+			p := newReviewProducer(t, runDir, runner, spec)
+
+			if tt.failFirst {
+				if _, _, err := p.Call(context.Background()); err == nil {
+					t.Fatal("first Call() error = nil; want the runner's failure")
+				}
+				if err := os.WriteFile(filepath.Join(root, "target.txt"), []byte("edited\n"), 0o644); err != nil {
+					t.Fatalf("WriteFile(edited target) = %v; want nil", err)
+				}
+			}
+			shedfake.RequireOutcome(t, p, shedengine.Stuck)
+
+			got, found, err := readRoundSnapshot(runDir, 1)
+			if err != nil || !found {
+				t.Fatalf("readRoundSnapshot() = %v, %v; want the record", found, err)
+			}
+			wantTargetID := ""
+			if tt.withSnapshot {
+				wantTargetID = wantID
+			}
+			if got.FixScope != "overlay" || !slices.Equal(got.TargetPaths, []string{"target.txt"}) || got.TargetID != wantTargetID {
+				t.Errorf("record = %+v; want scope overlay, paths [target.txt] and target id %q", got, wantTargetID)
+			}
+			if !slices.Equal(got.AddedDecisions, wantDecisions) {
+				t.Errorf("record added decisions = %+v; want %+v", got.AddedDecisions, wantDecisions)
+			}
+		})
+	}
+}
diff --git a/internal/shedadapters/targetsnapshot.go b/internal/shedadapters/targetsnapshot.go
new file mode 100644
index 00000000..5fab9a78
--- /dev/null
+++ b/internal/shedadapters/targetsnapshot.go
@@ -0,0 +1,255 @@
+// targetsnapshot.go implements TargetSnapshot, the seam that names a review round's target by an id.
+// It also lists the paths that changed since an earlier id.
+// A segment's review producer and its Bouncer both hold one, so each reads the target the same way.
+
+package shedadapters
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// TargetSnapshot names the target of a review round by an id and lists what changed since an earlier id.
+// Overlay scope reads the target files under WorktreeRoot and keeps a copy of them per id under CacheDir.
+// Source scope asks the two closures, which answer from the code checkout's git trees.
+// A closure left nil makes source scope answer an error, or false from ChangedSince.
+// The zero value is not usable; Scope must name one of the two scopes.
+type TargetSnapshot struct {
+	// Scope selects overlay or source behavior.
+	Scope burlerengine.FixScope
+	// WorktreeRoot is the absolute root the overlay target paths are relative to.
+	WorktreeRoot string
+	// Paths are the worktree-relative target paths, files or directories.
+	Paths []string
+	// CacheDir is the absolute directory holding one overlay copy per id.
+	CacheDir string
+	// SourceTreeID returns the id of the checkout's current tree.
+	SourceTreeID func() (string, error)
+	// SourceChanges returns the paths that differ between two tree ids.
+	SourceChanges func(fromID, toID string) ([]string, error)
+}
+
+// ID returns the id of the target as it stands now.
+// Overlay scope returns the hex SHA-256 over every target file's path and bytes, in path order;
+// a target path that does not exist is skipped.
+// Source scope returns the checkout's tree id.
+func (s TargetSnapshot) ID() (string, error) {
+	switch s.Scope {
+	case burlerengine.FixScopeOverlay:
+		return s.overlayID()
+	case burlerengine.FixScopeSource:
+		return s.sourceID()
+	}
+	return "", fmt.Errorf("shedadapters: target snapshot scope %q is neither overlay nor source", s.Scope)
+}
+
+// Take returns the target's id as ID does and, in overlay scope, keeps a copy of the target files under CacheDir/<id>.
+// An existing copy for the id is left as it is.
+func (s TargetSnapshot) Take() (string, error) {
+	id, err := s.ID()
+	if err != nil || s.Scope != burlerengine.FixScopeOverlay {
+		return id, err
+	}
+	return id, s.copyOverlay(id)
+}
+
+// ChangedSince returns the sorted paths that differ between the target at fromID and the target now.
+// It reports false when the answer is unknown: a missing copy, a read error, an unwired closure or a closure error.
+// A false answer is logged at Warn and never an error, since callers fall back to treating the whole target as changed.
+func (s TargetSnapshot) ChangedSince(fromID string) ([]string, bool) {
+	var changed []string
+	var err error
+	switch s.Scope {
+	case burlerengine.FixScopeOverlay:
+		changed, err = s.overlayChangedSince(fromID)
+	case burlerengine.FixScopeSource:
+		changed, err = s.sourceChangedSince(fromID)
+	default:
+		err = fmt.Errorf("target snapshot scope %q is neither overlay nor source", s.Scope)
+	}
+	if err != nil {
+		logger.Warn("shedadapters: target snapshot could not list the changed paths", "scope", s.Scope, "fromID", fromID, "error", err)
+		return nil, false
+	}
+	return changed, true
+}
+
+// sourceID returns the checkout's tree id through SourceTreeID.
+func (s TargetSnapshot) sourceID() (string, error) {
+	if s.SourceTreeID == nil {
+		return "", fmt.Errorf("shedadapters: source target snapshot has no tree id reader")
+	}
+	return s.SourceTreeID()
+}
+
+// sourceChangedSince lists the paths between fromID and the checkout's current tree id.
+func (s TargetSnapshot) sourceChangedSince(fromID string) ([]string, error) {
+	if s.SourceChanges == nil {
+		return nil, fmt.Errorf("source target snapshot has no changed-path reader")
+	}
+	current, err := s.sourceID()
+	if err != nil {
+		return nil, err
+	}
+	return s.SourceChanges(fromID, current)
+}
+
+// overlayID hashes every target file's relative path and bytes in path order.
+func (s TargetSnapshot) overlayID() (string, error) {
+	files, err := listTargetFiles(s.WorktreeRoot, s.Paths)
+	if err != nil {
+		return "", err
+	}
+	hash := sha256.New()
+	for _, rel := range files {
+		content, err := os.ReadFile(filepath.Join(s.WorktreeRoot, filepath.FromSlash(rel)))
+		if err != nil {
+			return "", fmt.Errorf("shedadapters: read target file %q: %w", rel, err)
+		}
+		hash.Write([]byte(rel))
+		hash.Write([]byte{0})
+		hash.Write(content)
+		hash.Write([]byte{0})
+	}
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
+
+// copyOverlay copies every target file to CacheDir/<id>/<relative path>, unless that directory exists already.
+// The copy is built beside its destination and renamed into place, so a crash never leaves a half copy under the id.
+func (s TargetSnapshot) copyOverlay(id string) error {
+	destination := filepath.Join(s.CacheDir, id)
+	if _, err := os.Stat(destination); err == nil {
+		return nil
+	}
+	files, err := listTargetFiles(s.WorktreeRoot, s.Paths)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(s.CacheDir, 0o755); err != nil {
+		return fmt.Errorf("shedadapters: create the target snapshot cache %q: %w", s.CacheDir, err)
+	}
+	staging, err := os.MkdirTemp(s.CacheDir, ".take-*")
+	if err != nil {
+		return fmt.Errorf("shedadapters: create a target snapshot staging directory in %q: %w", s.CacheDir, err)
+	}
+	for _, rel := range files {
+		content, err := os.ReadFile(filepath.Join(s.WorktreeRoot, filepath.FromSlash(rel)))
+		if err != nil {
+			_ = os.RemoveAll(staging)
+			return fmt.Errorf("shedadapters: read target file %q: %w", rel, err)
+		}
+		target := filepath.Join(staging, filepath.FromSlash(rel))
+		if err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {
+			_ = os.RemoveAll(staging)
+			return fmt.Errorf("shedadapters: create the snapshot directory for %q: %w", rel, err)
+		}
+		if err := os.WriteFile(target, content, 0o644); err != nil {
+			_ = os.RemoveAll(staging)
+			return fmt.Errorf("shedadapters: copy target file %q: %w", rel, err)
+		}
+	}
+	if err := os.Rename(staging, destination); err != nil {
+		_ = os.RemoveAll(staging)
+		return fmt.Errorf("shedadapters: place the target snapshot %q: %w", destination, err)
+	}
+	return nil
+}
+
+// overlayChangedSince compares the copy under CacheDir/<fromID> with the target files now.
+func (s TargetSnapshot) overlayChangedSince(fromID string) ([]string, error) {
+	cacheRoot := filepath.Join(s.CacheDir, fromID)
+	if _, err := os.Stat(cacheRoot); err != nil {
+		return nil, fmt.Errorf("no target snapshot copy for %q: %w", fromID, err)
+	}
+	before, err := listTargetFiles(cacheRoot, []string{"."})
+	if err != nil {
+		return nil, err
+	}
+	after, err := listTargetFiles(s.WorktreeRoot, s.Paths)
+	if err != nil {
+		return nil, err
+	}
+	changed := map[string]bool{}
+	for _, rel := range before {
+		if !slices.Contains(after, rel) {
+			changed[rel] = true
+		}
+	}
+	for _, rel := range after {
+		if !slices.Contains(before, rel) {
+			changed[rel] = true
+			continue
+		}
+		same, err := sameFileBytes(filepath.Join(cacheRoot, filepath.FromSlash(rel)), filepath.Join(s.WorktreeRoot, filepath.FromSlash(rel)))
+		if err != nil {
+			return nil, err
+		}
+		if !same {
+			changed[rel] = true
+		}
+	}
+	paths := make([]string, 0, len(changed))
+	for rel := range changed {
+		paths = append(paths, rel)
+	}
+	sort.Strings(paths)
+	return paths, nil
+}
+
+// sameFileBytes reports whether the two files hold the same bytes.
+func sameFileBytes(left, right string) (bool, error) {
+	leftBytes, err := os.ReadFile(left)
+	if err != nil {
+		return false, fmt.Errorf("shedadapters: read %q: %w", left, err)
+	}
+	rightBytes, err := os.ReadFile(right)
+	if err != nil {
+		return false, fmt.Errorf("shedadapters: read %q: %w", right, err)
+	}
+	return bytes.Equal(leftBytes, rightBytes), nil
+}
+
+// listTargetFiles returns the sorted, slash-separated root-relative paths of the regular files under paths.
+// A path that does not exist is skipped, and a directory contributes every regular file below it.
+func listTargetFiles(root string, paths []string) ([]string, error) {
+	seen := map[string]bool{}
+	for _, path := range paths {
+		start := filepath.Join(root, filepath.FromSlash(path))
+		if _, err := os.Lstat(start); os.IsNotExist(err) {
+			continue
+		}
+		err := filepath.WalkDir(start, func(current string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			if !entry.Type().IsRegular() {
+				return nil
+			}
+			rel, err := filepath.Rel(root, current)
+			if err != nil {
+				return err
+			}
+			seen[filepath.ToSlash(rel)] = true
+			return nil
+		})
+		if err != nil {
+			return nil, fmt.Errorf("shedadapters: list the target files under %q: %w", start, err)
+		}
+	}
+	files := make([]string, 0, len(seen))
+	for rel := range seen {
+		files = append(files, rel)
+	}
+	sort.Strings(files)
+	return files, nil
+}
diff --git a/internal/shedadapters/targetsnapshot_test.go b/internal/shedadapters/targetsnapshot_test.go
new file mode 100644
index 00000000..e12ff945
--- /dev/null
+++ b/internal/shedadapters/targetsnapshot_test.go
@@ -0,0 +1,165 @@
+// targetsnapshot_test.go tests TargetSnapshot's ids, its overlay copies and its changed-path lists in both scopes.
+
+package shedadapters
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/burlerengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// writeSnapshotFile writes content to rel under root, creating its directories.
+func writeSnapshotFile(t *testing.T, root, rel, content string) {
+	t.Helper()
+	path := filepath.Join(root, filepath.FromSlash(rel))
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("MkdirAll(%s) = %v; want nil", path, err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatalf("WriteFile(%s) = %v; want nil", path, err)
+	}
+}
+
+// newOverlaySnapshot returns an overlay snapshot over a temp worktree holding a.txt and dir/b.txt, with an empty cache.
+func newOverlaySnapshot(t *testing.T, paths ...string) TargetSnapshot {
+	t.Helper()
+	root := t.TempDir()
+	writeSnapshotFile(t, root, "a.txt", "a\n")
+	writeSnapshotFile(t, root, "dir/b.txt", "b\n")
+	if len(paths) == 0 {
+		paths = []string{"a.txt", "dir"}
+	}
+	return TargetSnapshot{Scope: burlerengine.FixScopeOverlay, WorktreeRoot: root, Paths: paths, CacheDir: filepath.Join(t.TempDir(), "cache")}
+}
+
+// mustTake returns the id Take answers, failing the test on an error.
+func mustTake(t *testing.T, s TargetSnapshot) string {
+	t.Helper()
+	id, err := s.Take()
+	if err != nil {
+		t.Fatalf("Take() = %v; want nil", err)
+	}
+	return id
+}
+
+// TestTargetSnapshot covers the overlay id, copy and changed-path list, and both source-scope answers.
+func TestTargetSnapshot(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("an overlay id follows the target bytes", func(t *testing.T) {
+		t.Parallel()
+		s := newOverlaySnapshot(t)
+		first, err := s.ID()
+		if err != nil {
+			t.Fatalf("ID() = %v; want nil", err)
+		}
+		if again, _ := s.ID(); again != first {
+			t.Errorf("ID() with no edit = %q; want %q", again, first)
+		}
+		writeSnapshotFile(t, s.WorktreeRoot, "dir/b.txt", "edited\n")
+		if edited, _ := s.ID(); edited == first {
+			t.Errorf("ID() after an edit = %q; want a new id", edited)
+		}
+	})
+
+	t.Run("a missing target path is skipped", func(t *testing.T) {
+		t.Parallel()
+		with := newOverlaySnapshot(t, "a.txt", "gone.txt")
+		without := newOverlaySnapshot(t, "a.txt")
+		writeSnapshotFile(t, without.WorktreeRoot, "dir/b.txt", "b\n")
+		withID, err := with.ID()
+		if err != nil {
+			t.Fatalf("ID() = %v; want nil", err)
+		}
+		withoutID, _ := without.ID()
+		if withID != withoutID {
+			t.Errorf("ID() with a missing path = %q; want %q, the id without it", withID, withoutID)
+		}
+	})
+
+	t.Run("an overlay change list holds an edited, an added and a removed file", func(t *testing.T) {
+		t.Parallel()
+		s := newOverlaySnapshot(t)
+		writeSnapshotFile(t, s.WorktreeRoot, "dir/keep.txt", "keep\n")
+		id := mustTake(t, s)
+		writeSnapshotFile(t, s.WorktreeRoot, "a.txt", "edited\n")
+		writeSnapshotFile(t, s.WorktreeRoot, "dir/new.txt", "new\n")
+		if err := os.Remove(filepath.Join(s.WorktreeRoot, "dir", "b.txt")); err != nil {
+			t.Fatalf("Remove = %v; want nil", err)
+		}
+
+		got, ok := s.ChangedSince(id)
+
+		if want := []string{"a.txt", "dir/b.txt", "dir/new.txt"}; !ok || !slices.Equal(got, want) {
+			t.Errorf("ChangedSince(%q) = %v, %v; want %v, true", id, got, ok, want)
+		}
+	})
+
+	t.Run("a second take keeps the first copy", func(t *testing.T) {
+		t.Parallel()
+		s := newOverlaySnapshot(t)
+		id := mustTake(t, s)
+		copyPath := filepath.Join(s.CacheDir, id, "a.txt")
+		past := time.Now().Add(-time.Hour).Truncate(time.Second)
+		if err := os.Chtimes(copyPath, past, past); err != nil {
+			t.Fatalf("Chtimes = %v; want nil", err)
+		}
+
+		if again := mustTake(t, s); again != id {
+			t.Fatalf("second Take() = %q; want %q", again, id)
+		}
+
+		info, err := os.Stat(copyPath)
+		if err != nil || !info.ModTime().Equal(past) {
+			t.Errorf("copy after the second Take = %v, %v; want the first copy's modification time %v", info, err, past)
+		}
+	})
+
+	t.Run("a deleted cache gives false", func(t *testing.T) {
+		t.Parallel()
+		s := newOverlaySnapshot(t)
+		id := mustTake(t, s)
+		if err := os.RemoveAll(s.CacheDir); err != nil {
+			t.Fatalf("RemoveAll = %v; want nil", err)
+		}
+		if got, ok := s.ChangedSince(id); ok {
+			t.Errorf("ChangedSince(%q) = %v, true; want false", id, got)
+		}
+	})
+
+	t.Run("source scope answers from the closures", func(t *testing.T) {
+		t.Parallel()
+		s := TargetSnapshot{
+			Scope:        burlerengine.FixScopeSource,
+			SourceTreeID: func() (string, error) { return "tree-now", nil },
+			SourceChanges: func(fromID, toID string) ([]string, error) {
+				return []string{fromID + ">" + toID}, nil
+			},
+		}
+		if id, err := s.Take(); err != nil || id != "tree-now" {
+			t.Errorf("Take() = %q, %v; want tree-now", id, err)
+		}
+		if got, ok := s.ChangedSince("tree-then"); !ok || !slices.Equal(got, []string{"tree-then>tree-now"}) {
+			t.Errorf("ChangedSince() = %v, %v; want the closure's list, true", got, ok)
+		}
+	})
+
+	t.Run("a failing source closure gives false", func(t *testing.T) {
+		t.Parallel()
+		s := TargetSnapshot{
+			Scope:         burlerengine.FixScopeSource,
+			SourceTreeID:  func() (string, error) { return "tree-now", nil },
+			SourceChanges: func(string, string) ([]string, error) { return nil, errors.New("tree gone") },
+		}
+		if got, ok := s.ChangedSince("tree-then"); ok {
+			t.Errorf("ChangedSince() = %v, true; want false", got)
+		}
+	})
+}
