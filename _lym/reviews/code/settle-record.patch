+//go:build tier0
+
+// parts_test.go — untagged unit tests for PartsTable.
+// Pure Go over an in-memory Config, a temp-dir modelspec registry and a seeded stencils directory;
+// the lead's prompt is composed through seatengine.Prompts, which starts nothing.
+
+package loomengine
+
+import (
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/friction"
+	"github.com/Knatte18/loomyard/internal/partsparser"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/stencil"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+	"github.com/Knatte18/loomyard/internal/testkit/stencilkit"
+)
+
+// partsTableConfig returns a config whose parts keys are depth, max and the model-spec parts.
+func partsTableConfig(depth string, max int, parts string) Config {
+	return Config{Parts: parts, PartsDepth: depth, PartsMax: max, PlanTimeoutMin: 120}
+}
+
+// fragmentText returns the text of the named depth fragment under stencilsDir as PartsTable fills it into the prompt.
+func fragmentText(t *testing.T, stencilsDir, name string) string {
+	t.Helper()
+	body, err := stencilstore.Read(stencilsDir, name)
+	if err != nil {
+		t.Fatalf("stencilstore.Read(%q) = _, %v; want nil error", name, err)
+	}
+	return strings.TrimSpace(stencil.StripLeadingComment(string(body)))
+}
+
+// TestPartsTable verifies PartsTable builds the lead the Parts-Write row needs: its role, segment, timeout, inputs, output and model key.
+// It also verifies the parts_depth fragment and parts_max reach the composed prompt, and the outcomes of a missing fragment and a missing friction stencil.
+//
+//testtiming:keep pins the lead's fields and the depth fragment choice, which no producer-level test asserts
+func TestPartsTable(t *testing.T) {
+	t.Parallel()
+	reg := discussionTableRegistry(t)
+
+	t.Run("the table carries the role, segment, timeout, inputs, output and model", func(t *testing.T) {
+		t.Parallel()
+		layout := planTableLayout(t, "backend")
+		stencilsDir := newTestStencilsDir(t)
+
+		table, err := PartsTable(layout, stencilsDir, newTestSpecsDir(t), partsTableConfig("light", 4, "sonnet[low]"), reg)
+		if err != nil {
+			t.Fatalf("PartsTable(...) = _, %v; want nil error", err)
+		}
+		if err := table.Validate(stencilsDir); err != nil {
+			t.Fatalf("table.Validate() = %v; want nil", err)
+		}
+		if table.RolePrefix != "parts" || table.Segment != segmentcolor.Plan || table.Timeout != 120*time.Minute || table.Interactive {
+			t.Errorf("table role/segment/timeout/interactive = %q/%q/%s/%v; want parts/%q/2h0m0s/false", table.RolePrefix, table.Segment, table.Timeout, table.Interactive, segmentcolor.Plan)
+		}
+		if len(table.Seats) != 1 {
+			t.Fatalf("table has %d seats; want the lead alone", len(table.Seats))
+		}
+		lead := table.Chair()
+		if want := []string{partsparser.File(layout.AnchorPath())}; !slices.Equal(lead.Outputs, want) {
+			t.Errorf("lead outputs = %v; want the parts file %v", lead.Outputs, want)
+		}
+		if want := []string{DiscussionDecisionRecord(layout), DiscussionRelevant(layout)}; !slices.Equal(lead.Inputs, want) {
+			t.Errorf("lead inputs = %v; want the decision record and the relevant list %v", lead.Inputs, want)
+		}
+		if lead.Model != "sonnet" || lead.Effort != "low" {
+			t.Errorf("lead model/effort = %q/%q; want sonnet/low from parts: sonnet[low]", lead.Model, lead.Effort)
+		}
+		if want := (shuttleengine.ModelKey{Module: "tapestry", Key: "parts"}); lead.ModelKey != want {
+			t.Errorf("lead ModelKey = %+v; want %+v", lead.ModelKey, want)
+		}
+		if lead.ForkSubagents {
+			t.Error("lead ForkSubagents = true; want false")
+		}
+	})
+
+	t.Run("the depth fragment and parts_max reach the composed prompt", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			depth, wantFragment, otherFragment string
+		}{
+			{"light", "loom-fragment-parts-light", "loom-fragment-parts-medium"},
+			{"medium", "loom-fragment-parts-medium", "loom-fragment-parts-light"},
+		}
+		for _, tt := range tests {
+			t.Run(tt.depth, func(t *testing.T) {
+				t.Parallel()
+				layout := planTableLayout(t, "")
+				stencilsDir := newTestStencilsDir(t)
+				table, err := PartsTable(layout, stencilsDir, newTestSpecsDir(t), partsTableConfig(tt.depth, 7, "sonnet[low]"), reg)
+				if err != nil {
+					t.Fatalf("PartsTable(depth %s) = _, %v; want nil error", tt.depth, err)
+				}
+				prompts, err := seatengine.Prompts(discussionTableGeometry(layout, stencilsDir), table)
+				if err != nil {
+					t.Fatalf("seatengine.Prompts() = _, %v; want nil error", err)
+				}
+				prompt := prompts[""]
+				want := fragmentText(t, stencilsDir, tt.wantFragment)
+				if !strings.Contains(prompt, want) {
+					t.Errorf("prompt at depth %s lacks the %s fragment text", tt.depth, tt.depth)
+				}
+				if other := fragmentText(t, stencilsDir, tt.otherFragment); strings.Contains(prompt, other) {
+					t.Errorf("prompt at depth %s carries the other depth's fragment text", tt.depth)
+				}
+				if !strings.Contains(prompt, "Hold at most 7 parts.") {
+					t.Errorf("prompt lacks the configured parts_max 7")
+				}
+			})
+		}
+	})
+
+	t.Run("a stencils directory without the chosen fragment fails the table naming it", func(t *testing.T) {
+		t.Parallel()
+		layout := planTableLayout(t, "")
+		stencilsDir := newTestStencilsDir(t)
+		stencilkit.Remove(t, stencilsDir, "loom-fragment-parts-medium")
+
+		_, err := PartsTable(layout, stencilsDir, newTestSpecsDir(t), partsTableConfig("medium", 6, "sonnet[low]"), reg)
+		if err == nil || !strings.Contains(err.Error(), "loom-fragment-parts-medium") {
+			t.Errorf("PartsTable(medium, fragment removed) = _, %v; want an error naming loom-fragment-parts-medium", err)
+		}
+	})
+
+	t.Run("a stencils directory without the friction stencil leaves the friction directive empty", func(t *testing.T) {
+		t.Parallel()
+		layout := planTableLayout(t, "")
+		stencilsDir := newMinimalStencilsDir(t)
+		cfg := partsTableConfig("light", 6, "sonnet[low]")
+		cfg.Friction = "sonnet[medium]"
+
+		table, err := PartsTable(layout, stencilsDir, newTestSpecsDir(t), cfg, reg)
+		if err != nil {
+			t.Fatalf("PartsTable(friction stencil removed) = _, %v; want nil error", err)
+		}
+		if got := table.Values[friction.MarkerName]; got != "" {
+			t.Errorf("friction directive = %q; want empty", got)
+		}
+	})
+}
diff --git a/internal/loomengine/partsplan.go b/internal/loomengine/partsplan.go
new file mode 100644
index 00000000..6c25f827
--- /dev/null
+++ b/internal/loomengine/partsplan.go
@@ -0,0 +1,184 @@
+// partsplan.go implements PartsPlanTable, the Parts-Plan-Write row's seat-table builder.
+// The row writes the plan in parts: one writer seat per part of the parts file, each turning its part's contract into plan cards in the part's own directory, and a chair that joins the parts into the plan in `_lym/plan/`.
+// PartsPlanTable reads the parts file at call time, so the seats the row runs are the parts the file holds when the row starts.
+// It is a pure builder: it reads the parts file and the stencils it composes from, and does not create the part directories or spawn anything.
+
+package loomengine
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/discussionparser"
+	"github.com/Knatte18/loomyard/internal/friction"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/partsparser"
+	"github.com/Knatte18/loomyard/internal/pattern"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// PartsPlanRole is the agent-name role prefix of the Parts-Plan-Write row's seats.
+const PartsPlanRole = "parts-plan"
+
+// partWriterStencil is the stencil that opens every part writer seat.
+const partWriterStencil = "loom-template-part-writer"
+
+// partsChairStencil is the stencil that opens the Parts-Plan-Write chair.
+const partsChairStencil = "loom-template-parts-chair"
+
+// partsPlanLiveStrandsNote is the remedy both parts-file refusals add: the table fails before the resume probe can stop a live strand.
+const partsPlanLiveStrandsNote = "a resumed row whose chair or writers are still live keeps their strands, since the table fails before the probe can stop them, so first remove each `parts-plan` strand of the task with `lym reed remove --name <strand>`"
+
+// PartsPlanTable builds the seatengine.Table of one Parts-Plan-Write run from the parts file under layout: a chair as the lead, then one writer seat per part in file order.
+// The chair writes the join record `partsparser.JoinRecord` and reads the decision record, the parts file and every part's overview; each writer writes its part's overview and reads the decision record, the relevant list and the parts file.
+// runTimeout is shuttle's run_timeout_min as a duration, told by the caller so a plan_timeout_min of 0 resolves to the effective plan timeout: it bounds every writer, and the chair's seat timeout is cfg.PartsChairTimeout(runTimeout), whose error fails the table.
+// gates, accept and findingsPath build each writer's gate, Accept and failed-gate findings path from its part's name; an error from gates fails the table.
+// An absent parts file fails the table with the way forward of running the Parts-Write row again, and a malformed one with the way forward of `lym loom validate-parts`.
+// specsDir and gateTiers are told, never derived: this package is bound by the Told-Geometry Invariant.
+// The table carries no chair gate; the producer entry sets it.
+// A PATTERN directive that cannot be rendered fails the table; a friction directive that cannot be rendered is left empty, the failure logged.
+func PartsPlanTable(layout *lymcwd.Location, stencilsDir, specsDir string, cfg Config, reg modelspec.Registry, gateTiers string, runTimeout time.Duration, gates func(part string) (shuttleengine.GateSpec, error), accept func(part string) func(shuttleengine.Result) error, findingsPath func(part string) string) (seatengine.Table, error) {
+	anchor := layout.AnchorPath()
+	parts, err := readPartsFile(anchor)
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+
+	chairChoice, err := resolveModelChoice(cfg.PartsChair, reg)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("loom: PartsPlanTable: parts_chair role model-spec: %w", err)
+	}
+	writerChoice, err := resolveModelChoice(cfg.PartWriter, reg)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("loom: PartsPlanTable: part_writer role model-spec: %w", err)
+	}
+	chairTimeout, err := cfg.PartsChairTimeout(runTimeout)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("loom: PartsPlanTable: %w", err)
+	}
+
+	declaredChanges, err := discussionparser.DeclaredPatternChanges(DiscussionDecisionRecord(layout))
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("loom: PartsPlanTable: %w re-step the row with %q", err, "lym loom start")
+	}
+	patternDirective, err := pattern.Directive(layout.WorktreePath(), stencilsDir, pattern.RoleImplementer, declaredChanges)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("loom: PartsPlanTable: %w", err)
+	}
+
+	var frictionDir string
+	if cfg.Friction != "" {
+		frictionDir = LoomFrictionDir(layout)
+	}
+	seatFriction := func(noteName string) map[string]string {
+		directive, err := friction.Directive(friction.NotePath(frictionDir, noteName), stencilsDir, friction.RoleImplementer)
+		if err != nil {
+			// A friction directive is optional bookkeeping, so a stencil read failure here must never fail the Parts-Plan-Write spawn.
+			logger.Warn("loom: friction directive failed, continuing without one", "role", "parts-plan-write", "note", noteName, "error", err)
+			return nil
+		}
+		if directive == "" {
+			return nil
+		}
+		return map[string]string{friction.MarkerName: directive}
+	}
+
+	partsFile := partsparser.File(anchor)
+	overviews := make([]string, 0, len(parts.Parts))
+	for _, part := range parts.Parts {
+		overviews = append(overviews, partsparser.PartOverview(anchor, part.Name))
+	}
+
+	chairValues := map[string]string{
+		"plan_dir":      planparser.PlanDir(anchor),
+		"overview_path": planparser.PlanOverview(anchor),
+		"join_path":     partsparser.JoinRecord(anchor),
+	}
+	for name, value := range seatFriction("Parts-Plan-Write") {
+		chairValues[name] = value
+	}
+	chair := seatengine.Seat{
+		Stencil:     partsChairStencil,
+		ModelChoice: chairChoice,
+		ModelKey:    shuttleengine.ModelKey{Module: tapestryModule, Key: "parts_chair"},
+		Inputs:      append([]string{DiscussionDecisionRecord(layout), partsFile}, overviews...),
+		Outputs:     []string{partsparser.JoinRecord(anchor)},
+		Skills:      planSkills,
+		Values:      chairValues,
+		Timeout:     chairTimeout,
+	}
+
+	seats := []seatengine.Seat{chair}
+	for _, part := range parts.Parts {
+		gate, err := gates(part.Name)
+		if err != nil {
+			return seatengine.Table{}, fmt.Errorf("loom: PartsPlanTable: gate of part %q: %w", part.Name, err)
+		}
+		writerValues := map[string]string{
+			"part_name":     part.Name,
+			"plan_dir":      partsparser.PartDir(anchor, part.Name),
+			"overview_path": partsparser.PartOverview(anchor, part.Name),
+		}
+		for name, value := range seatFriction("Parts-Plan-Write-" + part.Name) {
+			writerValues[name] = value
+		}
+		seats = append(seats, seatengine.Seat{
+			Name:             part.Name,
+			Stencil:          partWriterStencil,
+			ModelChoice:      writerChoice,
+			ModelKey:         shuttleengine.ModelKey{Module: tapestryModule, Key: "part_writer"},
+			Inputs:           []string{DiscussionDecisionRecord(layout), DiscussionRelevant(layout), partsFile},
+			Outputs:          []string{partsparser.PartOverview(anchor, part.Name)},
+			Skills:           planSkills,
+			Values:           writerValues,
+			Gate:             gate,
+			GateFindingsPath: findingsPath(part.Name),
+			Accept:           accept(part.Name),
+			Writer:           true,
+		})
+	}
+
+	return seatengine.Table{
+		RolePrefix: PartsPlanRole,
+		Segment:    segmentcolor.Plan,
+		Timeout:    cfg.PlanTimeout(runTimeout),
+		Values: map[string]string{
+			"decision_record_path": DiscussionDecisionRecord(layout),
+			"relevant_path":        DiscussionRelevant(layout),
+			"parts_path":           partsFile,
+			"parts_dir":            partsparser.Dir(anchor),
+			"specs_dir":            specsDir,
+			"gate_tiers":           gateTiers,
+			"pattern_directive":    patternDirective,
+			friction.MarkerName:    "",
+		},
+		Optional: []string{"pattern_directive", friction.MarkerName},
+		Seats:    seats,
+	}, nil
+}
+
+// readPartsFile reads and parses the parts file of the worktree anchored at anchor.
+// An absent file and a malformed one each return an error ending in a way forward.
+func readPartsFile(anchor string) (*partsparser.Parts, error) {
+	path := partsparser.File(anchor)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil, fmt.Errorf("loom: PartsPlanTable: the parts file %s is absent; way forward: run the Parts-Write row with `lym loom goto --to Parts-Write`; %s", path, partsPlanLiveStrandsNote)
+		}
+		return nil, fmt.Errorf("loom: PartsPlanTable: read the parts file %s: %w", path, err)
+	}
+	parts, err := partsparser.Parse(data)
+	if err != nil {
+		return nil, fmt.Errorf("loom: PartsPlanTable: the parts file %s is malformed: %w; way forward: run `lym loom validate-parts`, fix what it reports in the parts file, and re-step the row; %s", path, err, partsPlanLiveStrandsNote)
+	}
+	return parts, nil
+}
diff --git a/internal/loomengine/partsplan_test.go b/internal/loomengine/partsplan_test.go
new file mode 100644
index 00000000..c9735df0
--- /dev/null
+++ b/internal/loomengine/partsplan_test.go
@@ -0,0 +1,272 @@
+//go:build tier0
+
+// partsplan_test.go — untagged unit tests for PartsPlanTable.
+// Pure Go over an in-memory Config, a written parts file, a temp-dir modelspec registry and a seeded stencils directory;
+// every seat's prompt is composed through seatengine.Prompts, which starts nothing.
+
+package loomengine
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/partsparser"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// twoPartsFile is a parts file of two parts, alpha then beta.
+const twoPartsFile = `# Parts: Demo
+
+## Split note
+
+The task splits along its two modules.
+
+## Part: alpha
+
+- Decisions: D1
+- Takes in: the decision record
+- Delivers: the alpha behaviour
+- Exports:
+  - ` + "`plan:internal/a#NewA`" + `
+- Area:
+  - ` + "`internal/a`" + `
+
+## Part: beta
+
+- Decisions: D2
+- Takes in: alpha's export
+- Delivers: the beta behaviour
+- Depends on: alpha
+- Area:
+  - ` + "`internal/b`" + `
+`
+
+// partsPlanConfig returns a config whose plan and parts keys are set for PartsPlanTable.
+func partsPlanConfig(planTimeoutMin int, chairTimeoutMin *int) Config {
+	return Config{
+		PlanTimeoutMin:       planTimeoutMin,
+		PartWriter:           "sonnet[low]",
+		PartsChair:           "opus[high]",
+		PartsChairTimeoutMin: chairTimeoutMin,
+	}
+}
+
+// writePartsFile writes content as the parts file of layout.
+func writePartsFile(t *testing.T, layout *lymcwd.Location, content string) {
+	t.Helper()
+	path := partsparser.File(layout.AnchorPath())
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("MkdirAll(%q) = %v; want nil", filepath.Dir(path), err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatalf("WriteFile(%q) = %v; want nil", path, err)
+	}
+}
+
+// partsPlanHooks are the told per-part closures of PartsPlanTable, recording the parts they were built for and the parts whose Accept ran.
+type partsPlanHooks struct {
+	gated, accepts, accepted []string
+}
+
+func (h *partsPlanHooks) gates(part string) (shuttleengine.GateSpec, error) {
+	h.gated = append(h.gated, part)
+	return shuttleengine.GateSpec{{Name: "gate-" + part}}, nil
+}
+
+func (h *partsPlanHooks) accept(part string) func(shuttleengine.Result) error {
+	h.accepts = append(h.accepts, part)
+	return func(shuttleengine.Result) error {
+		h.accepted = append(h.accepted, part)
+		return nil
+	}
+}
+
+func (h *partsPlanHooks) findingsPath(part string) string {
+	return "/findings/" + part + ".md"
+}
+
+// buildPartsPlanTable builds the table of layout over the hooks and the config.
+func buildPartsPlanTable(t *testing.T, layout *lymcwd.Location, stencilsDir string, cfg Config, runTimeout time.Duration, hooks *partsPlanHooks) (seatengine.Table, error) {
+	t.Helper()
+	return PartsPlanTable(layout, stencilsDir, newTestSpecsDir(t), cfg, discussionTableRegistry(t), "none", runTimeout, hooks.gates, hooks.accept, hooks.findingsPath)
+}
+
+// TestPartsPlanTable verifies PartsPlanTable builds the chair and one writer seat per part of the parts file, their timeouts, models and composed prompts, and refuses an absent or malformed parts file with its way forward.
+//
+//testtiming:keep pins every seat field and the timeout resolution, which no producer-level test asserts
+func TestPartsPlanTable(t *testing.T) {
+	t.Parallel()
+
+	t.Run("one writer seat per part in file order, and the chair over every part overview", func(t *testing.T) {
+		t.Parallel()
+		layout := planTableLayout(t, "backend")
+		writePartsFile(t, layout, twoPartsFile)
+		stencilsDir := newTestStencilsDir(t)
+		hooks := &partsPlanHooks{}
+
+		table, err := buildPartsPlanTable(t, layout, stencilsDir, partsPlanConfig(120, nil), 0, hooks)
+		if err != nil {
+			t.Fatalf("PartsPlanTable(...) = _, %v; want nil error", err)
+		}
+		if err := table.Validate(stencilsDir); err != nil {
+			t.Fatalf("table.Validate() = %v; want nil", err)
+		}
+		anchor := layout.AnchorPath()
+		if table.RolePrefix != PartsPlanRole || table.Segment != segmentcolor.Plan || table.Interactive {
+			t.Errorf("table role/segment/interactive = %q/%q/%v; want %s/%q/false", table.RolePrefix, table.Segment, table.Interactive, PartsPlanRole, segmentcolor.Plan)
+		}
+		if len(table.Seats) != 3 {
+			t.Fatalf("table has %d seats; want the chair and two writers", len(table.Seats))
+		}
+
+		chair := table.Chair()
+		wantChairInputs := []string{DiscussionDecisionRecord(layout), partsparser.File(anchor), partsparser.PartOverview(anchor, "alpha"), partsparser.PartOverview(anchor, "beta")}
+		if !slices.Equal(chair.Inputs, wantChairInputs) {
+			t.Errorf("chair inputs = %v; want %v", chair.Inputs, wantChairInputs)
+		}
+		if want := []string{partsparser.JoinRecord(anchor)}; !slices.Equal(chair.Outputs, want) {
+			t.Errorf("chair outputs = %v; want the join record %v", chair.Outputs, want)
+		}
+		if chair.Model != "opus" || chair.Effort != "high" || chair.ModelKey != (shuttleengine.ModelKey{Module: "tapestry", Key: "parts_chair"}) {
+			t.Errorf("chair model/effort/key = %q/%q/%+v; want opus/high/tapestry parts_chair", chair.Model, chair.Effort, chair.ModelKey)
+		}
+		if chair.Writer || len(chair.Gate) != 0 {
+			t.Errorf("chair writer/gate = %v/%v; want a plain lead with no gate", chair.Writer, chair.Gate)
+		}
+
+		for i, part := range []string{"alpha", "beta"} {
+			seat := table.Seats[i+1]
+			if seat.Name != part || !seat.Writer || seat.Stencil != "loom-template-part-writer" {
+				t.Errorf("seat %d name/writer/stencil = %q/%v/%q; want %q/true/loom-template-part-writer", i+1, seat.Name, seat.Writer, seat.Stencil, part)
+			}
+			if want := []string{partsparser.PartOverview(anchor, part)}; !slices.Equal(seat.Outputs, want) {
+				t.Errorf("seat %q outputs = %v; want %v", part, seat.Outputs, want)
+			}
+			if want := []string{DiscussionDecisionRecord(layout), DiscussionRelevant(layout), partsparser.File(anchor)}; !slices.Equal(seat.Inputs, want) {
+				t.Errorf("seat %q inputs = %v; want %v", part, seat.Inputs, want)
+			}
+			if len(seat.Gate) != 1 || seat.Gate[0].Name != "gate-"+part {
+				t.Errorf("seat %q gate = %v; want the entry gates(%q) built", part, seat.Gate, part)
+			}
+			if want := hooks.findingsPath(part); seat.GateFindingsPath != want {
+				t.Errorf("seat %q GateFindingsPath = %q; want %q", part, seat.GateFindingsPath, want)
+			}
+			if seat.Model != "sonnet" || seat.Effort != "low" || seat.ModelKey != (shuttleengine.ModelKey{Module: "tapestry", Key: "part_writer"}) {
+				t.Errorf("seat %q model/effort/key = %q/%q/%+v; want sonnet/low/tapestry part_writer", part, seat.Model, seat.Effort, seat.ModelKey)
+			}
+			if seat.ForkSubagents {
