 // ReadLandingFailure reads it, and IsLogPath checks a log path against the verify directory.
 // The record sits in the verify directory beside the logs.
 //
+// WithReachTurn is the reach turn.
+// It is a decorator over any verify gate that hands a writer the reach note through its own gate.
+// A ReachTurn tells it a source of the pending report and the entry's attempt budget.
+// It also tells it the entry's shuttleengine.RerunMark and the listed file.
+// `ReachListedPath` names the listed file in the verify directory.
+// A failing result of the inner gate is returned as it is and counts one failing arrival.
+// A passing result reads the pending report.
+// The turn runs when the report holds a function whose id and hash the listed file lacks.
+// The count plus one must also be below the budget.
+// The turn then adds the report's functions to those the listed file holds.
+// It returns one failing result marked WriterOnly.
+// Its findings are the note and the way forward: add the missing tests and commit them, or end the turn unchanged.
+// Any other pass is returned and resets the count.
+// So a function listed once brings no second turn, and an arrival one failure short of the budget passes without one.
+// A call inside the turn's RerunMark, the re-run after a cold fixer, adds nothing to the count.
+// That arrival's first, failing call counted already.
+// The pending source's error is the gate's error.
+// A listed file that cannot be read or written is logged at Warn, and the gate returns the pass without the turn.
+// Bound: the turn costs one writer turn and one gate attempt per arrival.
+// Only an arrival whose report lists an unreached function no earlier turn listed costs them.
+//
 // Every site of one worktree shares one directory, Dir(anchorRoot), so a pass at one site lets the next site skip.
 // The package imports no resolver: the worktree and the directory are told through Paths.
 package verifytree
diff --git a/internal/verifytree/reach.go b/internal/verifytree/reach.go
new file mode 100644
index 00000000..3d2b52d1
--- /dev/null
+++ b/internal/verifytree/reach.go
@@ -0,0 +1,140 @@
+// reach.go declares the reach turn.
+// It is a decorator over a verify gate that hands a writer the reach note through its own gate.
+
+package verifytree
+
+import (
+	"maps"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// The name of the file a site's turns record their listed functions in is the prefix, the site slug and the suffix.
+const (
+	reachListedPrefix = "reach-listed-"
+	reachListedSuffix = ".json"
+)
+
+// reachWayForward closes the findings of a reach turn.
+const reachWayForward = "Add the missing tests and commit them, or end your turn unchanged."
+
+// ReachPending is what a reach report that matches the tree asks of the writer.
+type ReachPending struct {
+	// Note is the reach note's lines joined by newlines.
+	Note string
+	// Functions maps the id of each unreached changed function to the text hash of its declaration.
+	Functions map[string]string
+}
+
+// ReachTurn tells WithReachTurn where its pending report comes from and how often it may spend a writer turn.
+type ReachTurn struct {
+	// Pending returns the pending report.
+	// It returns false when no report of the gate's key matches HEAD or the report lists no unreached function.
+	Pending func() (ReachPending, bool, error)
+	// Attempts is the gate entry's attempt budget.
+	Attempts int
+	// Rerun is the entry's mark of a re-run after a cold fixer; nil where nothing re-runs the gate.
+	Rerun *shuttleengine.RerunMark
+	// ListedPath is the file recording the functions the turns of this gate listed, with their hashes.
+	ListedPath string
+}
+
+// reachListed is the record a turn leaves in its listed file.
+type reachListed struct {
+	Functions map[string]string `json:"functions"`
+}
+
+// ReachListedPath names the file in verifyDir that records the functions each turn of site listed, with their hashes.
+func ReachListedPath(verifyDir, site string) string {
+	slug := strings.ReplaceAll(strings.ToLower(site), " ", "-")
+	return filepath.Join(verifyDir, reachListedPrefix+slug+reachListedSuffix)
+}
+
+// WithReachTurn returns a gate that runs inner and then, once inner passes, hands the writer the pending reach note.
+// A failing result of inner is returned as it is and counts one failing arrival.
+// A passing result reads turn.Pending.
+// The turn runs when the report holds a function whose id and hash the listed file lacks.
+// The failing count plus one must also be below turn.Attempts.
+// The turn then adds the pending functions to those the listed file holds.
+// It returns one failing result marked WriterOnly.
+// Its findings are the note followed by the way forward.
+// Any other pass is returned and resets the count.
+// A call inside turn.Rerun adds nothing to the count, since its arrival's first, failing call counted already.
+// An error of turn.Pending is the gate's error.
+// A listed file that cannot be read or written is logged at Warn, and the gate returns the pass without the turn.
+func WithReachTurn(inner shuttleengine.Gate, turn ReachTurn) shuttleengine.Gate {
+	var mu sync.Mutex
+	failing := 0
+	return func() (shuttleengine.GateResult, error) {
+		rerun := turn.Rerun.On()
+		result, err := inner()
+		if err != nil {
+			return result, err
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		if !result.Passed {
+			if !rerun && !result.Pending && !result.Terminal {
+				failing++
+			}
+			return result, nil
+		}
+		findings, listed, err := turn.findings(failing)
+		if err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		if !listed {
+			failing = 0
+			return result, nil
+		}
+		if !rerun {
+			failing++
+		}
+		return shuttleengine.GateResult{Findings: findings, WriterOnly: true}, nil
+	}
+}
+
+// findings returns the findings of a turn after failing failing arrivals, and false when the arrival passes without one.
+func (t ReachTurn) findings(failing int) (string, bool, error) {
+	pending, found, err := t.Pending()
+	if err != nil || !found || failing+1 >= t.Attempts {
+		return "", false, err
+	}
+	lockPath := lock.TrackedFileLockPath(t.ListedPath, ".lock")
+	listed, _, err := state.ReadJSON[reachListed](t.ListedPath, lockPath)
+	if err != nil {
+		t.warnListedFile(err)
+		return "", false, nil
+	}
+	missing := false
+	for id, hash := range pending.Functions {
+		if recorded, ok := listed.Functions[id]; !ok || recorded != hash {
+			missing = true
+			break
+		}
+	}
+	if !missing {
+		return "", false, nil
+	}
+	everListed := maps.Clone(listed.Functions)
+	if everListed == nil {
+		everListed = map[string]string{}
+	}
+	maps.Copy(everListed, pending.Functions)
+	if err := state.WriteJSON(t.ListedPath, lockPath, reachListed{Functions: everListed}); err != nil {
+		t.warnListedFile(err)
+		return "", false, nil
+	}
+	return pending.Note + "\n\n" + reachWayForward, true, nil
+}
+
+// warnListedFile logs a listed file the turn could not use.
+func (t ReachTurn) warnListedFile(cause error) {
+	logger.Warn("verifytree: the reach turn cannot use its listed file, so the gate passes without the turn", "path", t.ListedPath, "cause", cause)
+}
diff --git a/internal/verifytree/reach_test.go b/internal/verifytree/reach_test.go
new file mode 100644
index 00000000..71b08662
--- /dev/null
+++ b/internal/verifytree/reach_test.go
@@ -0,0 +1,172 @@
+// reach_test.go covers WithReachTurn over a scripted inner gate and a scripted pending report.
+// The test is not parallel as a whole: one row captures the process-wide logger output.
+
+package verifytree
+
+import (
+	"errors"
+	"maps"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/state"
+	"github.com/Knatte18/loomyard/internal/testkit/logcapture"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// turnOutcome is what one arrival at the decorated gate answers.
+type turnOutcome string
+
+const (
+	outcomePass         turnOutcome = "pass"
+	outcomeInnerFailure turnOutcome = "inner failure"
+	outcomeTurn         turnOutcome = "turn"
+	outcomeError        turnOutcome = "error"
+)
+
+// turnStep is one arrival: what the inner gate and the pending source answer, and what the decorated gate must answer.
+type turnStep struct {
+	inner shuttleengine.GateResult
+	// rerun runs the arrival inside the turn's RerunMark.
+	rerun      bool
+	pending    ReachPending
+	found      bool
+	pendingErr error
+	want       turnOutcome
+	// wantListed, when non-nil, is what the listed file holds after the arrival.
+	wantListed map[string]string
+}
+
+// TestWithReachTurn pins the turn's outcomes over scripted arrivals, each scenario with its own gate and listed file.
+func TestWithReachTurn(t *testing.T) {
+	tiergate.Require(t, 0)
+
+	pendingOf := func(id, hash string) ReachPending {
+		return ReachPending{Note: "gate test: reach: no mapped test reaches " + id, Functions: map[string]string{id: hash}}
+	}
+	errPending := errors.New("reach report unreadable")
+	pass := shuttleengine.GateResult{Passed: true}
+	innerFailure := shuttleengine.GateResult{Findings: "inner broke"}
+
+	tests := []struct {
+		name     string
+		attempts int
+		steps    []turnStep
+	}{
+		{"AFunctionListedOnceBringsNoSecondTurnUntilItsHashChanges", 3, []turnStep{
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomeTurn, wantListed: map[string]string{"a.go#F": "h1"}},
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomePass},
+			{inner: pass, pending: pendingOf("a.go#F", "h2"), found: true, want: outcomeTurn, wantListed: map[string]string{"a.go#F": "h2"}},
+		}},
+		{"ALaterTurnKeepsTheFunctionsAnEarlierTurnListed", 4, []turnStep{
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomeTurn, wantListed: map[string]string{"a.go#F": "h1"}},
+			{inner: pass, pending: pendingOf("b.go#G", "h2"), found: true, want: outcomeTurn, wantListed: map[string]string{"a.go#F": "h1", "b.go#G": "h2"}},
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomePass},
+		}},
+		{"APendingOrTerminalInnerFailureAddsNothingToTheFailingCount", 2, []turnStep{
+			{inner: shuttleengine.GateResult{Findings: "waiting", Pending: true}, want: outcomeInnerFailure},
+			{inner: shuttleengine.GateResult{Findings: "stop", Terminal: true}, want: outcomeInnerFailure},
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomeTurn},
+		}},
+		{"AnArrivalOneFailureShortOfTheBudgetPassesWithoutTheTurn", 3, []turnStep{
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomePass},
+		}},
+		{"APassResetsTheFailureCount", 4, []turnStep{
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: pass, want: outcomePass},
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: pass, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomeTurn},
+		}},
+		{"AFailureAndATurnInsideTheReRunAddNothingToTheCount", 3, []turnStep{
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: innerFailure, rerun: true, want: outcomeInnerFailure},
+			{inner: pass, rerun: true, pending: pendingOf("a.go#F", "h1"), found: true, want: outcomeTurn},
+			{inner: innerFailure, want: outcomeInnerFailure},
+			{inner: pass, pending: pendingOf("b.go#G", "h2"), found: true, want: outcomePass},
+		}},
+		{"APassWithNoPendingReportPasses", 3, []turnStep{
+			{inner: pass, want: outcomePass},
+		}},
+		{"APendingErrorIsReturnedAsTheGatesError", 3, []turnStep{
+			{inner: pass, pendingErr: errPending, want: outcomeError},
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			listedPath := filepath.Join(t.TempDir(), "listed.json")
+			mark := &shuttleengine.RerunMark{}
+			var current turnStep
+			gate := WithReachTurn(
+				func() (shuttleengine.GateResult, error) { return current.inner, nil },
+				ReachTurn{
+					Pending: func() (ReachPending, bool, error) {
+						return current.pending, current.found, current.pendingErr
+					},
+					Attempts:   tt.attempts,
+					Rerun:      mark,
+					ListedPath: listedPath,
+				})
+			for i, step := range tt.steps {
+				current = step
+				run := gate
+				if step.rerun {
+					run = func() (shuttleengine.GateResult, error) { return mark.Run(gate) }
+				}
+				got, err := run()
+				switch step.want {
+				case outcomePass:
+					if err != nil || !got.Passed || got.WriterOnly {
+						t.Errorf("step %d: gate() = %+v, %v; want a plain pass", i, got, err)
+					}
+				case outcomeInnerFailure:
+					if err != nil || got != step.inner {
+						t.Errorf("step %d: gate() = %+v, %v; want the inner failure %+v unchanged", i, got, err, step.inner)
+					}
+				case outcomeTurn:
+					if err != nil || got.Passed || !got.WriterOnly ||
+						!strings.HasPrefix(got.Findings, step.pending.Note) || !strings.HasSuffix(got.Findings, reachWayForward) {
+						t.Errorf("step %d: gate() = %+v, %v; want a writer-only failure of the note and the way forward", i, got, err)
+					}
+				case outcomeError:
+					if !errors.Is(err, step.pendingErr) {
+						t.Errorf("step %d: gate() error = %v; want %v", i, err, step.pendingErr)
+					}
+				}
+				if step.wantListed != nil {
+					listed, _, err := state.ReadJSON[reachListed](listedPath, lock.TrackedFileLockPath(listedPath, ".lock"))
+					if err != nil || !maps.Equal(listed.Functions, step.wantListed) {
+						t.Errorf("step %d: listed file = %v, %v; want %v", i, listed.Functions, err, step.wantListed)
+					}
+				}
+			}
+		})
+	}
+
+	t.Run("AListedPathHeldByADirectoryPassesWithoutTheTurnAndWarns", func(t *testing.T) {
+		logs := logcapture.Capture(t)
+		listedPath := t.TempDir()
+		gate := WithReachTurn(
+			func() (shuttleengine.GateResult, error) { return pass, nil },
+			ReachTurn{
+				Pending:    func() (ReachPending, bool, error) { return pendingOf("a.go#F", "h1"), true, nil },
+				Attempts:   3,
+				ListedPath: listedPath,
+			})
+
+		got, err := gate()
+		if err != nil || !got.Passed || got.WriterOnly {
+			t.Errorf("gate() = %+v, %v; want a plain pass", got, err)
+		}
+		if !strings.Contains(logs.String(), listedPath) {
+			t.Errorf("logged %q; want a Warn naming the listed path %q", logs.String(), listedPath)
+		}
+	})
+}
diff --git a/internal/weaverengine/doc.go b/internal/weaverengine/doc.go
index 95c88f78..1e3c5e60 100644
--- a/internal/weaverengine/doc.go
+++ b/internal/weaverengine/doc.go
@@ -28,6 +28,8 @@
 //
 // One batch attempt is one cold strand started through StrandRunner, with a gate entry per card and one for the batch.
 // Each entry runs its `lym gate test` call through `verifytree.Verify`, so the agent fixes its own gate failures.
+// When the geometry tells a `ReachPending` source, the batch entry runs under `verifytree.WithReachTurn`.
+// A writer whose batch gate passes then gets one turn for each unreached function of its reach report.
 // A waited attempt is judged into one verdict.
 // An OK report with every gate passed is recordable.
 // A FAILED report, a gate that still fails, a timeout and a missing or unparseable report are failures.
@@ -46,6 +48,7 @@
 // After the last batch, the plan-level verify runs the hub's verify gate call through `verifytree.Verify`.
 // A failure is rerun once, and a pass on the rerun is flaky.
 // A failure that survives writes the verify-failure record and goes to one cold verify fixer on the next ladder rung.
+// The record carries the triage lines the verify log's failure report holds under its failed tests.
 // Weaver runs the verify again after it.
 // The fixer carries no gates, since the re-run of the verify judges it.
 // RunDeps is everything the row's producer is told.
diff --git a/internal/weaverengine/export_test.go b/internal/weaverengine/export_test.go
index 765c8f39..4f757678 100644
--- a/internal/weaverengine/export_test.go
+++ b/internal/weaverengine/export_test.go
@@ -2,7 +2,22 @@
 
 package weaverengine
 
-import "github.com/Knatte18/loomyard/internal/runplan"
+import (
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/verifytree"
+)
+
+// FailureReport returns the verify-failure record of a failed run of command.
+func FailureReport(command string, attempt, budget int, res verifytree.Result, output string) runplan.VerifyGateReport {
+	return failureReport(command, attempt, budget, res, output)
+}
 
 // RunPlanOf returns the shared machinery's view of g.
 func RunPlanOf(g Geometry) runplan.Geometry { return g.runPlan() }
+
+// BatchGateSpec returns the must-pass gates of one batch attempt's strand.
+func BatchGateSpec(geom Geometry, cards []planparser.Card, last bool, rowGates shuttleengine.GateSpec) (shuttleengine.GateSpec, error) {
