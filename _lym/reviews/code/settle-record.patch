diff --git a/internal/pawlengine/retiredmove.go b/internal/pawlengine/retiredmove.go
new file mode 100644
index 00000000..1658e113
--- /dev/null
+++ b/internal/pawlengine/retiredmove.go
@@ -0,0 +1,175 @@
+// retiredmove.go holds the side effects of moving a pawl run off a row its recipe retired: the pull request carried into the landing record, the standing requests and ready record removed, the hold lifted and the beam's orch told.
+
+package pawlengine
+
+import (
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// RetiredMoveDeps is every path and seam MoveOffRetired reads, told by the recipe wiring.
+type RetiredMoveDeps struct {
+	// Slug is the beam's slug, which names its landing record and its notice.
+	Slug string
+	// Paths holds the run's land request, reopen request and dobby-stop marker.
+	Paths Paths
+	// LandingPath and LandingLockPath name the beam's landing record and its lock.
+	LandingPath     string
+	LandingLockPath string
+	// ReadyPath and ReadyLockPath name the beam's ready record and its lock.
+	ReadyPath     string
+	ReadyLockPath string
+	// EndSession ends a live PR-Review session of the run.
+	EndSession func() error
+	// ScratchPullRequest reads the run's scratch pull-request record as it stands.
+	ScratchPullRequest func() (number int, url string, found bool, err error)
+	// PullRequestOpen reports whether GitHub reports the pull request number open.
+	PullRequestOpen func(number int) (bool, error)
+	// BeamHead reads the beam worktree's HEAD.
+	BeamHead func() (string, error)
+	// RemoveScratch removes the run's scratch pull-request record.
+	RemoveScratch func() error
+	// Commit commits the beam worktree's landing directory.
+	Commit func() error
+	// SetStatus writes the beam entry's run status naming producer as the row the run is at.
+	SetStatus func(producer string) error
+	// Notify posts one line to the beam's own orch.
+	Notify func(line string) error
+}
+
+// MoveOffRetired gives the pawl run of the beam moved from the retired row `from` to the row `to` the side effects an in-flight landing under the old rows needs.
+// It ends the PR-Review session and carries the run's scratch pull request into the landing record, with the beam's head as both its pushed and announce head, unless GitHub reports it closed or merged;
+// a pull request whose state does not read is carried too, so a transient failure never drops it.
+// A move repeated after the scratch record was removed finds no scratch pull request, and names the one the landing record already holds unless GitHub reports it closed or merged.
+// It then removes the scratch record, the ready record, the land request, the dobby-stop marker and the reopen request, commits the landing directory, writes the status naming `to`, which lifts the landing hold, and posts one notice telling the orch how to go on.
+// A resumed move, one made by a halted run stepped again, tells the orch to resume a second time, since the resume that made the move ends at the pause.
+// Every step is idempotent, so a retried move repeats safely; a failed step is returned naming it, and a failed notice is only logged.
+// A nil seam is refused naming the field.
+func MoveOffRetired(deps RetiredMoveDeps, from, to string, resumed bool) error {
+	if err := deps.requireSeams(); err != nil {
+		return err
+	}
+	if err := deps.EndSession(); err != nil {
+		return retiredMoveStep(from, "end the PR-Review session", err)
+	}
+	carried, err := deps.carryPullRequest()
+	if err != nil {
+		return retiredMoveStep(from, "carry the pull request into the landing record", err)
+	}
+	if err := deps.RemoveScratch(); err != nil {
+		return retiredMoveStep(from, "remove the scratch pull request record", err)
+	}
+	if _, err := RemoveReady(deps.ReadyPath, deps.ReadyLockPath, deps.Slug); err != nil {
+		return retiredMoveStep(from, "remove the ready record", err)
+	}
+	if err := RemoveLandRequest(deps.Paths); err != nil {
+		return retiredMoveStep(from, "remove the land request", err)
+	}
+	if err := removeFile(deps.Paths.DobbyStopMarker); err != nil {
+		return retiredMoveStep(from, "remove the dobby-stop marker", err)
+	}
+	if err := removeFile(deps.Paths.ReopenRequest); err != nil {
+		return retiredMoveStep(from, "remove the reopen request", err)
+	}
+	if err := deps.Commit(); err != nil {
+		return retiredMoveStep(from, "commit the landing directory", err)
+	}
+	if err := deps.SetStatus(to); err != nil {
+		return retiredMoveStep(from, "write the entry's status", err)
+	}
+	if err := deps.Notify(retiredMoveNotice(deps.Slug, from, to, resumed, carried)); err != nil {
+		logger.Warn("pawlengine: the notice of a move off a retired row was not posted", "slug", deps.Slug, "from", from, "to", to, "cause", err)
+	}
+	return nil
+}
+
+// requireSeams returns an error naming the first seam of deps that is nil.
+func (d RetiredMoveDeps) requireSeams() error {
+	for _, s := range []seam{
+		{"EndSession", d.EndSession != nil},
+		{"ScratchPullRequest", d.ScratchPullRequest != nil},
+		{"PullRequestOpen", d.PullRequestOpen != nil},
+		{"BeamHead", d.BeamHead != nil},
+		{"RemoveScratch", d.RemoveScratch != nil},
+		{"Commit", d.Commit != nil},
+		{"SetStatus", d.SetStatus != nil},
+		{"Notify", d.Notify != nil},
+	} {
+		if !s.set {
+			return fmt.Errorf("pawlengine: MoveOffRetired: RetiredMoveDeps.%s is unset", s.field)
+		}
+	}
+	return nil
+}
+
+// carryPullRequest writes the scratch pull request into the landing record when GitHub does not report it closed, and returns what it wrote.
+// With no scratch record it writes nothing and returns the pull request the landing record already holds, unless GitHub reports that one closed or merged.
+// It returns nil when GitHub reports the scratch pull request closed, and when there is no scratch record and the landing record holds no open pull request.
+func (d RetiredMoveDeps) carryPullRequest() (*LandingPullRequest, error) {
+	number, url, found, err := d.ScratchPullRequest()
+	if err != nil {
+		return nil, fmt.Errorf("read the scratch record: %w", err)
+	}
+	if !found {
+		return d.recordedPullRequest()
+	}
+	open, err := d.PullRequestOpen(number)
+	if err != nil {
+		logger.Warn("pawlengine: GitHub's state of the scratch pull request did not read, so it is carried", "slug", d.Slug, "number", number, "cause", err)
+		open = true
+	}
+	if !open {
+		return nil, nil
+	}
+	head, err := d.BeamHead()
+	if err != nil {
+		return nil, fmt.Errorf("read the beam head: %w", err)
+	}
+	carried := LandingPullRequest{Number: number, URL: url, PushedHead: head, AnnounceHead: head}
+	err = UpdateLanding(d.LandingPath, d.LandingLockPath, d.Slug, func(rec *LandingRecord) error {
+		rec.PullRequest = &carried
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &carried, nil
+}
+
+// recordedPullRequest returns the pull request the beam's landing record holds, nil when the record is absent, holds none, or holds one GitHub reports closed or merged.
+// A state that does not read counts as open, as it does for the scratch pull request.
+func (d RetiredMoveDeps) recordedPullRequest() (*LandingPullRequest, error) {
+	record, found, err := ReadLanding(d.LandingPath, d.LandingLockPath, d.Slug)
+	if err != nil || !found || record.PullRequest == nil {
+		return nil, err
+	}
+	open, err := d.PullRequestOpen(record.PullRequest.Number)
+	if err != nil {
+		logger.Warn("pawlengine: GitHub's state of the landing record's pull request did not read, so it is named as open", "slug", d.Slug, "number", record.PullRequest.Number, "cause", err)
+		open = true
+	}
+	if !open {
+		return nil, nil
+	}
+	return record.PullRequest, nil
+}
+
+// retiredMoveStep words the failure of one step of a move off the retired row from.
+func retiredMoveStep(from, step string, err error) error {
+	return fmt.Errorf("pawlengine: move off %s: %s: %w", from, step, err)
+}
+
+// retiredMoveNotice words the notice of the move of the beam slug from the row `from` to the row `to`.
+// It names the pull request when one was carried, the commands that bring the beam's orch and run back, a second resume when resumed, and the verbs that land the beam.
+func retiredMoveNotice(slug, from, to string, resumed bool, carried *LandingPullRequest) string {
+	line := fmt.Sprintf("the pawl run of the beam %s was moved from %s to %s and paused", slug, from, to)
+	if carried != nil {
+		line += fmt.Sprintf("; its pull request %s stays open", carried.URL)
+	}
+	line += fmt.Sprintf("; in the beam's worktree run `lym beam start %s` and `lym loom resume`", slug)
+	if resumed {
+		line += ", then `lym loom resume` again, since the resume that made this move ends at the pause"
+	}
+	return line + "; then land the beam with `lym beam describe`, `lym beam pr open|update|status|close` and `lym beam ready`"
+}
diff --git a/internal/pawlengine/retiredmove_test.go b/internal/pawlengine/retiredmove_test.go
new file mode 100644
index 00000000..5419e1d7
--- /dev/null
+++ b/internal/pawlengine/retiredmove_test.go
@@ -0,0 +1,332 @@
+// retiredmove_test.go covers MoveOffRetired over a temp beam directory and told seams that log their calls in order: what it carries, removes, writes and posts, and that a retried move repeats safely.
+
+package pawlengine_test
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/pawlengine"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+const (
+	moveHead       = "0123abc"
+	moveScratchURL = "https://github.com/o/r/pull/7"
+	moveRetired    = "PR-Review"
+	moveTarget     = "Beam-Await"
+)
+
+// moveWorld is a beam directory holding the records a move off a retired row removes or carries, and the ordered record of the seams' calls.
+type moveWorld struct {
+	paths                                          pawlengine.Paths
+	landingPath, landingLock, readyPath, readyLock string
+	scratchPath                                    string
+
+	// open and openErr are what the pull request state seam answers.
+	open    bool
+	openErr error
+	// commitErr fails the commit seam, and notifyErr the notice.
+	commitErr, notifyErr error
+
+	events  []string
+	notices []string
+	// removedAtCommit holds whether every record a move removes was gone when the commit seam ran.
+	removedAtCommit []bool
+}
+
+// newMoveWorld returns a beam directory holding a ready record, a land request, a dobby-stop marker, a reopen request and a scratch pull request record, whose pull request GitHub reports open.
+func newMoveWorld(t *testing.T) *moveWorld {
+	t.Helper()
+	dir := t.TempDir()
+	w := &moveWorld{
+		paths: pawlengine.Paths{
+			LandRequest:     filepath.Join(dir, "beam", pawlengine.LandRequestFileName),
+			ReopenRequest:   filepath.Join(dir, "beam", pawlengine.ReopenRequestFileName),
+			DobbyStopMarker: filepath.Join(dir, "beam", pawlengine.DobbyStopMarkerName),
+		},
+		landingPath: filepath.Join(dir, "landing", "beam-landing.json"),
+		landingLock: filepath.Join(dir, "locks", "beam-landing.json.lock"),
+		readyPath:   filepath.Join(dir, "landing", "beam-ready.json"),
+		readyLock:   filepath.Join(dir, "locks", "beam-ready.json.lock"),
+		scratchPath: filepath.Join(dir, "scratch", "pull-request.json"),
+		open:        true,
+	}
+	at := time.Date(2026, 11, 5, 9, 0, 0, 0, time.UTC)
+	if err := pawlengine.WriteReady(w.readyPath, w.readyLock, pawlengine.ReadyRecord{Slug: testSlug, SetAt: at}); err != nil {
+		t.Fatal(err)
+	}
+	if err := pawlengine.WriteLandRequest(w.paths, pawlengine.LandRequest{RunID: testRunID, RequestedAt: at}); err != nil {
+		t.Fatal(err)
+	}
+	touch(t, w.paths.DobbyStopMarker)
+	touch(t, w.paths.ReopenRequest)
+	touch(t, w.scratchPath)
+	return w
+}
+
+// removable lists the records a move removes, bar the scratch record.
+func (w *moveWorld) removable() []string {
+	return []string{w.readyPath, w.paths.LandRequest, w.paths.DobbyStopMarker, w.paths.ReopenRequest}
+}
+
+func (w *moveWorld) deps() pawlengine.RetiredMoveDeps {
+	return pawlengine.RetiredMoveDeps{
+		Slug:            testSlug,
+		Paths:           w.paths,
+		LandingPath:     w.landingPath,
+		LandingLockPath: w.landingLock,
+		ReadyPath:       w.readyPath,
+		ReadyLockPath:   w.readyLock,
+		EndSession: func() error {
+			w.events = append(w.events, "end-session")
+			return nil
+		},
+		ScratchPullRequest: func() (int, string, bool, error) {
+			return 7, moveScratchURL, exists(w.scratchPath), nil
+		},
+		PullRequestOpen: func(number int) (bool, error) {
+			w.events = append(w.events, "pull-request-open")
+			return w.open, w.openErr
+		},
+		BeamHead: func() (string, error) { return moveHead, nil },
+		RemoveScratch: func() error {
+			w.events = append(w.events, "remove-scratch")
+			if err := os.Remove(w.scratchPath); err != nil && !errors.Is(err, os.ErrNotExist) {
+				return err
+			}
+			return nil
+		},
+		Commit: func() error {
+			w.events = append(w.events, "commit")
+			gone := true
+			for _, path := range w.removable() {
+				gone = gone && !exists(path)
+			}
+			w.removedAtCommit = append(w.removedAtCommit, gone)
+			return w.commitErr
+		},
+		SetStatus: func(producer string) error {
+			w.events = append(w.events, "status:"+producer)
+			return nil
+		},
+		Notify: func(line string) error {
+			w.events = append(w.events, "notify")
+			w.notices = append(w.notices, line)
+			return w.notifyErr
+		},
+	}
+}
+
+func TestMoveOffRetired(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	t.Run("the scratch pull request is carried unless GitHub reports it closed, and the rest of the move happens either way", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name        string
+			scratch     bool
+			open        bool
+			openErr     error
+			wantCarried bool
+		}{
+			{"OpenPullRequestIsCarried", true, true, nil, true},
+			{"UnreadableStateIsCarried", true, false, errors.New("github unreachable"), true},
+			{"ClosedPullRequestIsNotCarried", true, false, nil, false},
+			{"NoScratchRecordCarriesNothing", false, true, nil, false},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				w := newMoveWorld(t)
+				w.open, w.openErr = tt.open, tt.openErr
+				if !tt.scratch {
+					if err := os.Remove(w.scratchPath); err != nil {
+						t.Fatal(err)
+					}
+				}
+
+				if err := pawlengine.MoveOffRetired(w.deps(), moveRetired, moveTarget, false); err != nil {
+					t.Fatalf("MoveOffRetired() = %v; want nil", err)
+				}
+
+				record, found, err := pawlengine.ReadLanding(w.landingPath, w.landingLock, testSlug)
+				if err != nil {
+					t.Fatal(err)
+				}
+				switch {
+				case tt.wantCarried && (!found || record.PullRequest == nil || *record.PullRequest != pawlengine.LandingPullRequest{Number: 7, URL: moveScratchURL, PushedHead: moveHead, AnnounceHead: moveHead}):
+					t.Errorf("landing record = %+v, %v; want the pull request carried with the beam head as pushed and announce head", record, found)
+				case !tt.wantCarried && found && record.PullRequest != nil:
+					t.Errorf("landing record = %+v; want no pull request carried", record)
+				}
+				if exists(w.scratchPath) {
+					t.Error("the scratch pull request record stands; want it removed")
+				}
+				for _, path := range w.removable() {
+					if exists(path) {
+						t.Errorf("%s stands; want it removed", filepath.Base(path))
+					}
+				}
+				if slices.Equal(w.removedAtCommit, []bool{true}) == false {
+					t.Errorf("records gone at each commit = %v; want one commit after every removal", w.removedAtCommit)
+				}
+				if got := countOf(w.events, "end-session"); got != 1 {
+					t.Errorf("EndSession called %d times; want once", got)
+				}
+				if want := []string{"status:" + moveTarget, "notify"}; !slices.Equal(w.events[len(w.events)-2:], want) {
+					t.Errorf("last events = %v; want the status write and then the notice %v", w.events[len(w.events)-2:], want)
+				}
+				if len(w.notices) != 1 {
+					t.Fatalf("notices = %q; want one", w.notices)
+				}
+				notice := w.notices[0]
+				for _, want := range []string{"lym beam start " + testSlug, moveRetired, moveTarget, "lym beam describe", "lym beam ready"} {
+					if !strings.Contains(notice, want) {
+						t.Errorf("notice = %q; want it to carry %q", notice, want)
+					}
+				}
+				if got := strings.Count(notice, "lym loom resume"); got != 1 {
+					t.Errorf("notice names `lym loom resume` %d times; want once", got)
+				}
+				if got := strings.Contains(notice, moveScratchURL); got != tt.wantCarried {
+					t.Errorf("notice names the pull request = %v; want %v", got, tt.wantCarried)
+				}
+			})
+		}
+	})
+
+	t.Run("a resumed move names the resume twice", func(t *testing.T) {
+		t.Parallel()
+		w := newMoveWorld(t)
+
+		if err := pawlengine.MoveOffRetired(w.deps(), moveRetired, moveTarget, true); err != nil {
+			t.Fatalf("MoveOffRetired() = %v; want nil", err)
+		}
+
+		if got := strings.Count(w.notices[0], "lym loom resume"); got != 2 {
+			t.Errorf("notice = %q; want `lym loom resume` twice, got %d", w.notices[0], got)
+		}
+	})
+
+	t.Run("a failing commit returns its step before the status is written", func(t *testing.T) {
+		t.Parallel()
+		w := newMoveWorld(t)
+		w.commitErr = errors.New("index locked")
+
+		err := pawlengine.MoveOffRetired(w.deps(), moveRetired, moveTarget, false)
+
+		if !errors.Is(err, w.commitErr) || !strings.Contains(err.Error(), "commit the landing directory") {
+			t.Fatalf("MoveOffRetired() = %v; want the commit's error naming its step", err)
+		}
+		if slices.ContainsFunc(w.events, func(event string) bool { return strings.HasPrefix(event, "status:") || event == "notify" }) {
+			t.Errorf("events = %v; want no status write or notice after the failed commit", w.events)
