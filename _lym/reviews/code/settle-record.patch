new file mode 100644
index 00000000..d2177799
--- /dev/null
+++ b/internal/machinecli/cli.go
@@ -0,0 +1,138 @@
+// cli.go builds the `lym machine` cobra group with its `name` verb and holds the seams the verb runs through.
+// The RunCLI and RunCLIIn seams run that group with its output written to an io.Writer.
+
+package machinecli
+
+import (
+	"fmt"
+	"io"
+	"path/filepath"
+
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/machinename"
+	"github.com/Knatte18/loomyard/internal/output"
+	"github.com/Knatte18/loomyard/internal/standalonestate"
+)
+
+// deps holds the seams the verb runs through, so a test hands in a file path, a hostname and hubs of its own.
+// A hand-built deps sets every field the path under test calls.
+// The show calls only locate and hostName.
+type deps struct {
+	// locate returns the machine file's path and its writer's lock's path.
+	// It also reports whether a directory resolved, and the error of a relative variable.
+	locate func() (file, lock string, ok bool, err error)
+	// hostName returns the hostname rule's name of this host.
+	hostName func() (string, error)
+	// hubs returns the paths of the hubs a sweep reaches through the machine record.
+	hubs func() ([]string, error)
+	// cwdHub returns the hub the directory lies in, and false when it lies in none.
+	cwdHub func(dir string) (string, bool)
+	// pull brings the board at boardDir level with its upstream and reports a skip with its detail.
+	pull func(boardDir string) (fabricengine.BoltSkip, string, error)
+	// unpushed reports whether the board at boardDir holds commits origin lacks.
+	unpushed func(boardDir string) (bool, error)
+	// readOwners reads the owners the local board at boardDir records.
+	readOwners func(boardDir string) (boardengine.Owners, error)
+	// setOwners makes the owner write on the board at boardDir.
+	setOwners func(boardDir string, req boardengine.OwnerRequest) (boardengine.OwnerWrite, error)
+}
+
+// productionDeps returns the seams over the per-user machine file, this host's hostname and the real hubs.
+func productionDeps() deps {
+	return deps{
+		locate:   machinename.FilePath,
+		hostName: machinename.FromThisHost,
+		hubs: func() ([]string, error) {
+			dir, err := standalonestate.UserStateDir()
+			if err != nil {
+				return nil, fmt.Errorf("the per-user state directory of the machine record of hubs does not resolve: %w", err)
+			}
+			return liveHubs(dir)
+		},
+		cwdHub:     hubOfDir,
+		pull:       pullBoard,
+		unpushed:   func(boardDir string) (bool, error) { return fabricengine.NewBolt(boardDir).HasUnpushed() },
+		readOwners: boardengine.ReadOwners,
+		setOwners:  boardengine.SetOwners,
+	}
+}
+
+// pullBoard brings the board at boardDir level with its upstream, with the skip options the owner write builds.
+func pullBoard(boardDir string) (fabricengine.BoltSkip, string, error) {
+	cfg := boardengine.ApplySkipEnv(boardengine.Config{Path: boardDir})
+	opts := fabricengine.SyncOptions{SkipGit: cfg.SkipGit, SkipPush: cfg.SkipPush}
+	return fabricengine.NewBolt(boardDir).Pull(opts, fabricengine.NewMutations(filepath.Dir(boardDir)))
+}
+
+// Command returns the cobra command for `lym machine`: the bare group and its name verb.
+func Command() *cobra.Command {
+	return newCommand(productionDeps())
+}
+
+// newCommand builds the `lym machine` group over d.
+func newCommand(d deps) *cobra.Command {
+	machine := &cobra.Command{
+		Use:   "machine",
+		Short: "show or set this machine's name",
+		Long: `machine shows or sets this machine's name, the name lym records as the owner of
+its runs, projects and the hub's prime.`,
+		RunE: clihelp.GroupRunE,
+	}
+	machine.AddCommand(&cobra.Command{
+		Use:         "name [<name>]",
+		Short:       "show this machine's name, or set it and sweep the owners recorded under its former names",
+		Annotations: map[string]string{clihelp.AudienceAnnotation: clihelp.AudienceOperator},
+		Long: `name with no argument shows this machine's name, whether it comes from the
+machine file or from the hostname, the file's path and the former names the file
+records. It writes nothing.
+
+name <name> sets the name in the machine file, keeping the former names, then
+rewrites, on every live hub of the machine record and the hub of the working
+directory, the owners recorded under those former names to the new name. It
+refuses a name that a board records as another machine's owner. A hub whose
+sweep fails or keeps an owner makes it exit non-zero; re-run it with the same
+name. The result lists the recoveries each state needs.
+
+Example:
+  lym machine name
+  lym machine name osl46`,
+		Args: cobra.MaximumNArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if clihelp.ShouldAbort(cmd.Context()) {
+				return nil
+			}
+			out := cmd.OutOrStdout()
+			if len(args) == 0 {
+				clihelp.SetExit(cmd.Context(), showName(out, d))
+				return nil
+			}
+			cwd, err := lymcwd.CwdFrom(cmd.Context())
+			if err != nil {
+				clihelp.SetExit(cmd.Context(), output.Err(out, err.Error()))
+				return nil
+			}
+			clihelp.SetExit(cmd.Context(), runSet(out, d, cwd, args[0]))
+			return nil
+		},
+	})
+	return machine
+}
+
+// RunCLI runs the `lym machine` command with args, writes its output to out, and returns its exit code.
+func RunCLI(out io.Writer, args []string) int {
+	return RunCLIIn("", out, args)
+}
+
+// RunCLIIn runs the `lym machine` command with cwd as its working directory.
+// An empty cwd reads the process directory instead, since seeding an empty directory into the context panics.
+func RunCLIIn(cwd string, out io.Writer, args []string) int {
+	if cwd == "" {
+		return clihelp.Execute(Command(), out, args)
+	}
+	return clihelp.ExecuteIn(Command(), cwd, out, args)
+}
diff --git a/internal/machinecli/cli_test.go b/internal/machinecli/cli_test.go
new file mode 100644
index 00000000..ae14013a
--- /dev/null
+++ b/internal/machinecli/cli_test.go
@@ -0,0 +1,175 @@
+// cli_test.go covers `lym machine name` through the command built over hand-made seams.
+
+package machinecli
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// runName runs `lym machine name` with args over d in cwd and returns the exit code and the decoded envelope.
+func runName(t *testing.T, d deps, cwd string, args ...string) (int, map[string]any) {
+	t.Helper()
+	var out bytes.Buffer
+	code := clihelp.ExecuteIn(newCommand(d), cwd, &out, append([]string{"name"}, args...))
+	var envelope map[string]any
+	if err := json.Unmarshal(out.Bytes(), &envelope); err != nil {
+		t.Fatalf("decode envelope %q: %v", out.String(), err)
+	}
+	return code, envelope
+}
+
+// fileState describes what stands at path: absent, a directory, or a file with its bytes.
+func fileState(t *testing.T, path string) string {
+	t.Helper()
+	info, err := os.Stat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return "absent"
+	}
+	if err != nil {
+		t.Fatalf("stat %s: %v", path, err)
+	}
+	if info.IsDir() {
+		return "dir"
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	return "file:" + string(data)
+}
+
+// hostNamed returns a hostName seam that yields name.
+func hostNamed(name string) func() (string, error) {
+	return func() (string, error) { return name, nil }
+}
+
+func TestName_Show(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	tests := []struct {
+		name string
+		// content is the machine file's content; "" writes no file.
+		content string
+		// dirAtPath makes the machine file's path a directory.
+		dirAtPath bool
+		// noDirectory makes the locate seam resolve no directory.
+		noDirectory bool
+		locateErr   error
+		hostErr     error
+		wantOK      bool
+		wantName    string
+		wantSource  string
+		wantFormer  []string
+		// wantErr is a substring the refusal's message must carry, with each of wantErrAlso.
+		wantErr     string
+		wantErrAlso []string
+	}{
+		{name: "NoFileReadsTheHostnameRule", wantOK: true, wantName: "osl-1046", wantSource: "hostname", wantFormer: []string{}},
+		{name: "NoDirectoryReadsTheHostnameRule", noDirectory: true, wantOK: true, wantName: "osl-1046", wantSource: "hostname", wantFormer: []string{}},
+		{
+			name: "FileNameWithFormerNames", content: `{"name":"osl46","names":["neve","","osl46"]}`,
+			wantOK: true, wantName: "osl46", wantSource: "file", wantFormer: []string{"neve"},
+		},
+		{
+			name: "UndecodableFileShowsItsErrorAndPath", content: "not json",
+			wantErr: "does not decode", wantErrAlso: []string{"machine.json", "lym machine name <name>"},
+		},
+		{
+			name: "InvalidNameShowsItsErrorAndPath", content: `{"name":"BAD","names":["BAD"]}`,
+			wantErr: "holds no valid name", wantErrAlso: []string{"machine.json", "lym machine name <name>"},
+		},
+		{
+			name: "UnreadableFileShowsItsPathAndRemoval", dirAtPath: true,
+			wantErr: "does not read", wantErrAlso: []string{"machine.json", "remove the file", "lym machine name <name>"},
+		},
+		{name: "RelativeVariableShowsItsError", locateErr: errors.New("XDG_CONFIG_HOME is relative"), wantErr: "XDG_CONFIG_HOME is relative"},
+		{name: "UnreadableHostnameShowsItsError", hostErr: errors.New("hostname unreadable"), wantErr: "hostname unreadable"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			dir := t.TempDir()
+			path := filepath.Join(dir, "machine.json")
+			switch {
+			case tt.dirAtPath:
+				if err := os.Mkdir(path, 0o755); err != nil {
+					t.Fatalf("mkdir %s: %v", path, err)
+				}
+			case tt.content != "":
+				if err := os.WriteFile(path, []byte(tt.content), 0o644); err != nil {
+					t.Fatalf("write %s: %v", path, err)
+				}
+			}
+			before := fileState(t, path)
+			d := deps{
+				locate: func() (string, string, bool, error) {
+					if tt.locateErr != nil {
+						return "", "", false, tt.locateErr
+					}
+					if tt.noDirectory {
+						return "", "", false, nil
+					}
+					return path, path + ".lock", true, nil
+				},
+				hostName: func() (string, error) {
+					if tt.hostErr != nil {
+						return "", tt.hostErr
+					}
+					return "osl-1046", nil
+				},
+			}
+
+			code, envelope := runName(t, d, dir)
+
+			if after := fileState(t, path); after != before {
+				t.Errorf("machine file after the show = %q; want it unchanged from %q", after, before)
+			}
+			if !tt.wantOK {
+				if code == 0 || envelope["ok"] != false {
+					t.Fatalf("show exit %d, envelope %v; want a non-zero refusal", code, envelope)
+				}
+				message, _ := envelope["error"].(string)
+				for _, want := range append([]string{tt.wantErr}, tt.wantErrAlso...) {
+					if !strings.Contains(message, want) {
+						t.Errorf("refusal %q; want it to name %q", message, want)
+					}
+				}
+				if _, named := envelope["machine"]; named {
+					t.Errorf("refusal carries machine %v; want no name", envelope["machine"])
+				}
+				return
+			}
+			if code != 0 || envelope["ok"] != true {
+				t.Fatalf("show exit %d, envelope %v; want ok", code, envelope)
+			}
+			machine, _ := envelope["machine"].(map[string]any)
+			if machine["name"] != tt.wantName || machine["source"] != tt.wantSource {
+				t.Errorf("show name %v from %v; want %q from %q", machine["name"], machine["source"], tt.wantName, tt.wantSource)
+			}
+			wantFile := path
+			if tt.noDirectory {
+				wantFile = ""
+			}
+			if machine["file"] != wantFile {
+				t.Errorf("show file = %v; want %q", machine["file"], wantFile)
+			}
+			var former []string
+			for _, name := range machine["former"].([]any) {
+				former = append(former, name.(string))
+			}
+			if !slices.Equal(former, tt.wantFormer) {
+				t.Errorf("show former = %v; want %v", former, tt.wantFormer)
+			}
+		})
+	}
+}
diff --git a/internal/machinecli/current.go b/internal/machinecli/current.go
new file mode 100644
index 00000000..4fb12a70
--- /dev/null
+++ b/internal/machinecli/current.go
@@ -0,0 +1,106 @@
+// current.go reads this machine's current name state from the machine file and the hostname rule, and shows it.
+
+package machinecli
+
+import (
+	"fmt"
+	"io"
+
+	"github.com/Knatte18/loomyard/internal/machinename"
+	"github.com/Knatte18/loomyard/internal/output"
+)
+
+// Where a current name comes from.
+const (
+	sourceFile     = "file"
+	sourceHostname = "hostname"
+)
+
+// current is what readCurrent reads: the machine file's state and the name it yields.
+type current struct {
+	// file and lock are the machine file's and its lock's paths; hasDirectory is false when no directory resolved.
+	file, lock   string
+	hasDirectory bool
+	// locateErr is the error of a relative variable, which names the variable.
+	locateErr error
+	// exists reports whether the machine file exists; decoded is its content when it decodes.
+	exists  bool
+	decoded machinename.File
+	// readErr is a file that does not read; decodeErr is a file that exists and does not decode.
+	readErr, decodeErr error
+	// nameErr is why a decoded file's name is invalid, nil when it is valid.
+	nameErr error
+	// name is the valid current name, "" when there is none.
+	// It is the file's name, else the hostname rule's name when no file or no directory exists.
+	name string
+	// source is sourceFile or sourceHostname when name is set.
+	source string
+	// former holds the decoded file's non-empty names other than the current name; empty for a hostname name.
+	former []string
+	// hostname is the hostname rule's name of this host, "" when hostName errors, which hostErr carries.
+	hostname string
+	hostErr  error
+}
+
+// readCurrent reads the machine file through machinename.ReadFile, never machinename.Name, so a bad file stays readable.
+func readCurrent(d deps) current {
+	cur := current{former: []string{}}
+	cur.file, cur.lock, cur.hasDirectory, cur.locateErr = d.locate()
+	cur.hostname, cur.hostErr = d.hostName()
+	if cur.locateErr != nil {
+		return cur
+	}
+	if cur.hasDirectory {
+		file, exists, err := machinename.ReadFile(cur.file)
+		cur.exists = exists
+		switch {
+		case err != nil && exists:
+			cur.decodeErr = err
+		case err != nil:
+			cur.readErr = err
+		default:
+			cur.decoded = file
+		}
+	}
+	switch {
+	case cur.hasDirectory && cur.exists && cur.decodeErr == nil:
+		if cur.nameErr = machinename.CheckName(cur.decoded.Name); cur.nameErr != nil {
+			break
+		}
+		cur.name, cur.source = cur.decoded.Name, sourceFile
+		for _, name := range cur.decoded.Names {
+			if name != "" && name != cur.name {
+				cur.former = append(cur.former, name)
+			}
+		}
+	case cur.hasDirectory && (cur.exists || cur.readErr != nil):
+		// A file that exists but yields no name never falls back to the hostname, as machinename.Name never does.
+	case cur.hostErr == nil:
+		cur.name, cur.source = cur.hostname, sourceHostname
+	}
+	return cur
+}
+
+// showName prints the machine name state under `machine` and returns the exit code.
+func showName(out io.Writer, d deps) int {
+	cur := readCurrent(d)
+	fields := map[string]any{"file": cur.file}
+	switch {
+	case cur.locateErr != nil:
+		return output.Err(out, cur.locateErr.Error())
+	case cur.readErr != nil:
+		return output.ErrFields(out, fmt.Sprintf("the machine file %s does not read: %v; way forward: remove the file or fix its permissions, then run `lym machine name <name>`", cur.file, cur.readErr), fields)
+	case cur.decodeErr != nil:
+		return output.ErrFields(out, fmt.Sprintf("the machine file %s does not decode: %v; way forward: run `lym machine name <name>`, which rewrites the file, or remove the file", cur.file, cur.decodeErr), fields)
+	case cur.nameErr != nil:
+		return output.ErrFields(out, fmt.Sprintf("the machine file %s holds no valid name: %v; way forward: run `lym machine name <name>`, which rewrites the file, or remove the file", cur.file, cur.nameErr), fields)
+	case cur.name == "":
+		return output.Err(out, cur.hostErr.Error())
+	}
+	return output.Ok(out, map[string]any{"machine": map[string]any{
+		"name":   cur.name,
+		"source": cur.source,
+		"file":   cur.file,
+		"former": cur.former,
+	}})
+}
diff --git a/internal/machinecli/doc.go b/internal/machinecli/doc.go
new file mode 100644
index 00000000..76ac3ec9
--- /dev/null
+++ b/internal/machinecli/doc.go
@@ -0,0 +1,47 @@
+// Package machinecli builds the `lym machine` group with its one verb, `lym machine name`.
+// With no argument the verb shows this machine's name, where it comes from and the former names the machine file records.
+// The package is the only writer of the machine file.
+//
+// The module is not standalone-capable.
+// It resolves no `--target-dir`, repository root or mode-derived state, so internal/cliwire does not serve it.
+// `name` carries the operator audience.
+// The envelope carries the result under `machine`.
+// A refusal goes through output.ErrFields with a message that names its way forward.
+//
+// # Seams
+//
+// Every outside effect goes through a deps value that the command closes over, never a package-level variable.
+// The file seam locates the machine file and its lock; the hostname seam gives the hostname rule's name of this host.
+// Tests build a deps by hand, so each hands in a file path under its own temporary directory.
+// None reads or writes the developer's machine file.
+//
+// # Show
+//
+// The show reads the machine file through machinename.ReadFile and never through machinename.Name,
+// so a file that does not decode or holds an invalid name is shown with its error and path, not hidden behind a fallback.
+// It writes nothing and opens no hub.
+//
+// # Set
+//
+// `lym machine name <name>` checks the name, reads every hub's board, and only then writes.
+// The hubs are the live hubs of the machine record and the hub of the working directory, each once.
+// A board that does not read, and a name a board records as another machine's owner, refuse the verb before any write.
+// A name this machine already holds, as its current name, a former name or its hostname rule's name, passes that check.
+// The machine file is rewritten only when it differs from what the verb would write.
+// The file keeps the former names, the old name and the hostname rule's name, and drops empty entries.
+// The new name comes last.
+// A file that did not decode loses its names, and the result says so.
+// Each hub then takes one owner write whose replace set is the former names.
+// It takes over the prime and every open beam project recorded under one of them, after the write's own pull.
+// A hub whose write fails or keeps an owner is reported, the other hubs go on, and the verb exits non-zero.
+// The re-run with the same name finishes the sweep and leaves the machine file as it is.
+// The result lists the recoveries each state needs.
+//
+// # Bounds
+//
+// The verb writes the machine file and, on each swept hub, owners recorded under this machine's former names.
+// It never takes an owner recorded under any other name.
+// An owner another machine pushes after the verb's pull stays for the re-run.
+// A hub that is neither in the machine record nor the hub of the working directory is not swept;
+// run the verb from that hub's container directory or one of its worktrees.
+package machinecli
diff --git a/internal/machinecli/hubs.go b/internal/machinecli/hubs.go
new file mode 100644
index 00000000..5b3e5f01
--- /dev/null
+++ b/internal/machinecli/hubs.go
@@ -0,0 +1,62 @@
+// hubs.go finds the hubs a machine-name sweep reaches.
+// They are the live hubs of the machine record and the hub of the working directory.
+
+package machinecli
+
+import (
+	"fmt"
+	"path/filepath"
+	"slices"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubregistry"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/preflight"
+)
+
+// liveHubs returns the paths of the hubs the machine record in dir lists as live.
+// An unreadable record is an error naming the record's path.
+func liveHubs(dir string) ([]string, error) {
+	entries, err := hubregistry.Live(dir)
+	if err != nil {
+		return nil, fmt.Errorf("read the machine record of hubs %s: %w", filepath.Join(dir, hubregistry.RecordFileName), err)
+	}
+	paths := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		paths = append(paths, entry.HubPath)
+	}
+	return paths, nil
+}
+
+// hubOfDir returns the hub dir lies in.
+// A hub worktree and its subdirectories count, and so does the hub's container directory.
+// A directory outside any hub has none.
+func hubOfDir(dir string) (string, bool) {
+	if location, err := lymcwd.ResolveWorktree(dir); err == nil && preflight.BoardLymPresent(location) {
+		return location.HubPath, true
+	}
+	if _, found := fabricengine.ReadShortname(fabricengine.BoltDir(dir)); found {
+		return dir, true
+	}
+	return "", false
+}
+
+// hubsToSweep returns the hubs of the machine record plus the hub of cwd, each once.
+// The record's order stands, with the hub of cwd last when the record lacks it.
+// A record that does not read refuses before any write.
+func hubsToSweep(d deps, cwd string) ([]string, error) {
+	recorded, err := d.hubs()
+	if err != nil {
+		return nil, err
+	}
+	var hubs []string
+	for _, hub := range recorded {
+		if !slices.Contains(hubs, hub) {
+			hubs = append(hubs, hub)
+		}
+	}
+	if hub, found := d.cwdHub(cwd); found && !slices.Contains(hubs, hub) {
+		hubs = append(hubs, hub)
+	}
+	return hubs, nil
+}
diff --git a/internal/machinecli/set.go b/internal/machinecli/set.go
new file mode 100644
index 00000000..93d38d67
--- /dev/null
+++ b/internal/machinecli/set.go
@@ -0,0 +1,290 @@
+// set.go sets this machine's name in the machine file.
+// It then sweeps, on every swept hub, the owners recorded under the former names.
+
+package machinecli
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"maps"
+	"runtime"
+	"slices"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/machinename"
+	"github.com/Knatte18/loomyard/internal/output"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// How a hub's sweep ended.
+const (
+	outcomeSwept   = "swept"
+	outcomePushed  = "pushed"
+	outcomeNothing = "nothing to sweep"
+	outcomeKept    = "kept by another owner"
+	outcomeFailed  = "failed"
+)
+
+// lostWayForwardSuffix is added to the re-run as the way forward of an entry another owner keeps.
+const lostWayForwardSuffix = "; `lym adopt` takes back an entry whose standing owner is another name"
+
+// recoveries lists how each state the sweep can leave behind is recovered, as constant text.
+var recoveries = []string{
+	"A run paused for an owner other than this machine resumes once the sweep records this machine as owner: the dobby's probe lifts that owner pause.",
+	"A pause the probe does not lift stays: run `lym tender resume <slug>` for it.",
+	"A board commit left ahead of origin is pushed by the re-run: run `lym machine name <name>` again with the same name.",
+	"A Finalize that halted at its owner check goes on with `lym loom resume` in its pair.",
+	"A worktree the owner change skipped or refused starts with `lym beam start <slug>`, or `lym beam start root` for the prime.",
+	"Lift a pause with `lym tender resume` only after that hub's sweep reports done.",
+}
+
+// lostEntry is an entry the sweep left with the owner that stands.
+type lostEntry struct {
+	Slug       string `json:"slug"`
+	Owner      string `json:"owner"`
+	WayForward string `json:"way_forward"`
+}
+
+// hubOutcome is how the sweep ended on one hub.
+type hubOutcome struct {
+	Hub string `json:"hub"`
+	// CheckedLocally carries why the hub's board was checked against its local Bolt alone.
+	CheckedLocally string `json:"checked_locally,omitempty"`
+	// UnpushedNote carries why the read of whether the board is ahead of origin failed.
+	UnpushedNote string      `json:"unpushed_read_note,omitempty"`
+	Outcome      string      `json:"outcome"`
+	Slugs        []string    `json:"slugs,omitempty"`
+	Lost         []lostEntry `json:"lost,omitempty"`
+	Error        string      `json:"error,omitempty"`
+	WayForward   string      `json:"way_forward,omitempty"`
+}
+
+// setResult is what a set reports under `machine`.
+type setResult struct {
+	Name string `json:"name"`
+	File string `json:"file"`
+	// Names is the written file's names, the new name last.
+	Names []string `json:"names"`
+	// Written reports whether the machine file was written.
+	Written bool `json:"written"`
+	// DroppedEmptyEntries counts the empty entries the rewrite dropped from the file's names.
+	DroppedEmptyEntries int `json:"dropped_empty_entries,omitempty"`
+	// InvalidNameDropped reports that the file's name was invalid and the rewrite replaced it.
+	InvalidNameDropped bool `json:"invalid_name_dropped,omitempty"`
+	// NamesLost reports that the file did not decode, so the rewrite lost the names it held.
+	NamesLost  bool         `json:"names_lost,omitempty"`
+	Hubs       []hubOutcome `json:"hubs"`
+	Recoveries []string     `json:"recoveries"`
+}
+
+// rerun returns the way forward of a hub whose sweep did not finish.
+func rerun(name string) string {
+	return fmt.Sprintf("re-run `lym machine name %s`", name)
+}
+
+// noDirectoryRefusal names the variables the machine file's directory resolves from on this platform.
+func noDirectoryRefusal() string {
+	variables := "XDG_CONFIG_HOME or HOME"
+	if runtime.GOOS == "windows" {
+		variables = "LOCALAPPDATA"
+	}
+	return fmt.Sprintf("no directory for the machine file resolves from the environment; way forward: set %s to an absolute path", variables)
+}
+
+// ownNames returns the names that are this machine's own.
+// They are the valid current name and the non-empty names of a decoded file.
+// The hostname rule's name joins them when it yields one.
+func ownNames(cur current) []string {
+	var names []string
+	add := func(name string) {
+		if name != "" && !slices.Contains(names, name) {
+			names = append(names, name)
+		}
+	}
+	add(cur.name)
+	if cur.exists && cur.decodeErr == nil {
+		for _, name := range cur.decoded.Names {
+			add(name)
+		}
+	}
+	add(cur.hostname)
+	return names
+}
+
+// nextFile returns the machine file a set of name writes, and how many empty entries it dropped.
+// The names start from a decoded file's names.
+// They gain the old name and the hostname rule's name when absent.
+// They lose every empty entry and end with name.
+func nextFile(cur current, name string) (machinename.File, int) {
+	var names []string
+	if cur.exists && cur.decodeErr == nil {
+		names = slices.Clone(cur.decoded.Names)
+	}
+	dropped := 0
+	names = slices.DeleteFunc(names, func(entry string) bool {
+		if entry == "" {
+			dropped++
+		}
+		return entry == ""
+	})
+	for _, old := range []string{cur.name, cur.hostname} {
+		if old != "" && !slices.Contains(names, old) {
+			names = append(names, old)
+		}
+	}
+	names = slices.DeleteFunc(names, func(entry string) bool { return entry == name })
+	return machinename.File{Name: name, Names: append(names, name)}, dropped
+}
+
+// needsWrite reports whether file differs from what the machine file holds.
+func needsWrite(cur current, file machinename.File) bool {
+	return !cur.exists || cur.decodeErr != nil || cur.nameErr != nil ||
+		file.Name != cur.decoded.Name || !slices.Equal(file.Names, cur.decoded.Names)
+}
+
+// checkHub reads the state of the hub's board that the sweep judges, and writes nothing.
+// It returns the hub's outcome so far and whether its board is ahead of origin.
+// It also returns a refusal when the board does not read or records the new name under another machine.
+func checkHub(d deps, hub, name string, own []string, file string) (hubOutcome, bool, error) {
+	boardDir := fabricengine.BoardDir(hub)
+	check := hubOutcome{Hub: hub}
+	ahead, err := d.unpushed(boardDir)
+	if err != nil {
+		check.UnpushedNote = fmt.Sprintf("read whether the board is ahead of origin: %v", err)
+		ahead = false
+	}
+	skip, detail, err := d.pull(boardDir)
+	switch {
+	case err != nil:
+		check.CheckedLocally = err.Error()
+	case skip != "":
+		check.CheckedLocally = fmt.Sprintf("pull skipped (%s): %s", skip, detail)
+	}
+	owners, err := d.readOwners(boardDir)
+	if err != nil {
+		return check, false, fmt.Errorf("the board of hub %s does not read: %w; way forward: repair that hub's board as the error says, then %s", hub, err, rerun(name))
+	}
+	if slices.Contains(own, name) {
+		return check, ahead, nil
+	}
+	if owners.Prime == name {
+		return check, false, collision(hub, boardengine.OwnerWritePrime, name, file)
+	}
+	for _, slug := range slices.Sorted(maps.Keys(owners.Entries)) {
+		if owners.Entries[slug].Owner == name {
+			return check, false, collision(hub, slug, name, file)
+		}
+	}
+	return check, ahead, nil
+}
+
+// collision returns the refusal of a name another machine owns.
+func collision(hub, subject, name, file string) error {
+	return fmt.Errorf(
+		"hub %s records %s as owned by %q, so that name belongs to another machine; "+
+			"way forward: choose another name; for a lost former name, write {\"name\": \"%s\"} to %s by hand, "+
+			"and take back with `lym adopt` an owner left under another lost name",
+		hub, subject, name, name, file)
+}
+
+// sweepHub takes over, on the hub's board, the owners recorded under replace for name.
+// It reports `nothing to sweep` when nothing was recorded and nothing was kept by another owner;
+// the caller refines that to `pushed`.
+func sweepHub(d deps, hub, name string, replace []string) hubOutcome {
+	outcome := hubOutcome{Hub: hub, Outcome: outcomeNothing}
+	written, err := d.setOwners(fabricengine.BoardDir(hub), boardengine.OwnerRequest{Machine: name, Replace: replace})
+	if err != nil {
+		outcome.Outcome = outcomeFailed
+		outcome.Error = err.Error()
+		outcome.WayForward = rerun(name)
+		return outcome
+	}
+	for _, slug := range slices.Sorted(maps.Keys(written.Lost)) {
+		outcome.Lost = append(outcome.Lost, lostEntry{Slug: slug, Owner: written.Lost[slug], WayForward: rerun(name) + lostWayForwardSuffix})
+	}
+	switch {
+	case len(written.Recorded) > 0:
+		outcome.Outcome = outcomeSwept
+		outcome.Slugs = written.Recorded
+	case len(outcome.Lost) > 0:
+		outcome.Outcome = outcomeKept
+	}
+	return outcome
+}
+
+// setName writes name as this machine's name and sweeps the owners recorded under its former names.
+// It refuses, writing nothing, on an invalid name or an unresolvable or unreadable machine file.
+// It also refuses on an unreadable registry or board and on a name another machine owns.
+// A hub whose sweep fails is reported in the result and the other hubs go on.
+func setName(d deps, cwd, name string) (setResult, error) {
+	if err := machinename.CheckName(name); err != nil {
+		return setResult{}, err
+	}
+	cur := readCurrent(d)
+	switch {
+	case cur.locateErr != nil:
+		return setResult{}, cur.locateErr
+	case !cur.hasDirectory:
+		return setResult{}, errors.New(noDirectoryRefusal())
+	case cur.readErr != nil:
+		return setResult{}, fmt.Errorf("the machine file %s does not read: %w; way forward: remove the file or fix its permissions, then %s", cur.file, cur.readErr, rerun(name))
+	}
+	own := ownNames(cur)
+	hubs, err := hubsToSweep(d, cwd)
+	if err != nil {
+		return setResult{}, err
+	}
+	checks := make([]hubOutcome, len(hubs))
+	ahead := make([]bool, len(hubs))
+	for i, hub := range hubs {
+		if checks[i], ahead[i], err = checkHub(d, hub, name, own, cur.file); err != nil {
+			return setResult{}, err
+		}
+	}
+
+	file, dropped := nextFile(cur, name)
+	result := setResult{
+		Name: name, File: cur.file, Names: file.Names, DroppedEmptyEntries: dropped,
+		InvalidNameDropped: cur.nameErr != nil, NamesLost: cur.decodeErr != nil,
+		Hubs: []hubOutcome{}, Recoveries: recoveries,
+	}
+	if needsWrite(cur, file) {
+		if err := state.WriteJSON(cur.file, cur.lock, file); err != nil {
+			return setResult{}, fmt.Errorf("write the machine file %s: %w; way forward: fix the file's directory, then %s", cur.file, err, rerun(name))
+		}
+		result.Written = true
+	}
+
+	replace := slices.DeleteFunc(slices.Clone(file.Names), func(entry string) bool { return entry == name })
+	for i, hub := range hubs {
+		outcome := sweepHub(d, hub, name, replace)
+		outcome.CheckedLocally, outcome.UnpushedNote = checks[i].CheckedLocally, checks[i].UnpushedNote
+		if outcome.Outcome == outcomeNothing && ahead[i] {
+			outcome.Outcome = outcomePushed
+		}
+		result.Hubs = append(result.Hubs, outcome)
+	}
+	return result, nil
+}
+
+// runSet runs a set of name and prints its result under `machine`.
+// A hub that failed or kept an owner makes the exit non-zero, with the same fields.
+func runSet(out io.Writer, d deps, cwd, name string) int {
+	result, err := setName(d, cwd, name)
+	if err != nil {
+		return output.Err(out, err.Error())
+	}
+	fields := map[string]any{"machine": result}
+	unfinished := 0
+	for _, hub := range result.Hubs {
+		if hub.Outcome == outcomeFailed || len(hub.Lost) > 0 {
+			unfinished++
+		}
+	}
+	if unfinished > 0 {
+		return output.ErrFields(out, fmt.Sprintf("the owner sweep did not finish on %d hub(s), listed under machine.hubs; way forward: %s", unfinished, rerun(name)), fields)
+	}
+	return output.Ok(out, fields)
+}
