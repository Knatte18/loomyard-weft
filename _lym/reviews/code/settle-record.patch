+func mapSlotAsk(tiers map[int]gateslot.Tier) int {
+	ask := 0
+	for _, tier := range tiers {
+		if tier.Slots == 0 {
+			return 0
+		}
+		ask = max(ask, tier.Slots)
+	}
+	return ask
