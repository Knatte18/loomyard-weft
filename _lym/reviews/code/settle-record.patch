 func TestEnterSession_DrivesTheToldTmux(t *testing.T) {
 	tiergate.Require(t, 1)
 	t.Parallel()
@@ -40,16 +47,44 @@ func TestEnterSession_DrivesTheToldTmux(t *testing.T) {
 	}
 	hubforge.SeedConfig(t, h, map[string]string{"reed": string(seeded)})
 
