+				}
+			}
+
+			got, err := scopeClosedAt(target, tt.recipe, "Darn-Write")
+
+			if got != tt.want || (err != nil) != tt.wantErr {
+				t.Errorf("scopeClosedAt(%s, Darn-Write) = %v, %v; want %v, error %v", tt.recipe, got, err, tt.want, tt.wantErr)
+			}
+		})
+	}
