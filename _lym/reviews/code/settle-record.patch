-// mustStep runs the upkeep step at the harness's clock and fails the test on its error.
-func (h *testMapHarness) mustStep() {
-	h.t.Helper()
-	if err := h.d.testMapStep(h.now); err != nil {
-		h.t.Fatalf("testMapStep() = %v; want nil", err)
-	}
-}
