@@ -0,0 +1,125 @@
+// wiring_integration_test.go drives the seams resetDepsFor builds over a wired hub fixture.
+// It runs Reset through them against a task pair:
+// the state history, the plan read at a records commit, the code reset, the commit and the dirty tracked paths.
+
+package weavercli
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/testkit/plankit"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+)
+
+func TestResetDepsFor_SeamsResetATaskPairThroughTheHub(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+
+	const slug = "weaver-wiring"
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	hubforge.AddPair(t, h, slug)
+	taskTree := h.PairCodeWorktree(slug)
+	loc, err := lymcwd.ResolveWorktree(taskTree)
+	if err != nil {
+		t.Fatalf("ResolveWorktree(%s): %v", taskTree, err)
+	}
+	deps, err := resetDepsFor(loc)
+	if err != nil {
+		t.Fatalf("resetDepsFor() error = %v; want nil", err)
+	}
+	geom := deps.Geom
+
+	start := gitkit.CommitFile(t, taskTree, "own.txt", "base", "own base")
+	gitkit.CommitFile(t, taskTree, "later.txt", "later", "later commit")
+	gitkit.Git(t, taskTree, "push", "origin", "HEAD")
+
+	card := plankit.Card{Number: 1, Slug: "one", Groups: []plankit.Group{{Label: "Create", Targets: []string{"internal/x/one.go"}}}}
+	plankit.Write(t, geom.PlanDir, plankit.Plan{Approved: true, Language: "none", Framing: "A test plan.", Cards: []plankit.Card{card}})
+	cardPath := filepath.Join(geom.PlanDir, "01-one.md")
+	original, err := os.ReadFile(cardPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	planRel, err := filepath.Rel(geom.AnchorRoot, geom.PlanDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	planCommit, committed, err := fabricengine.CommitAnchoredPaths(fabricengine.NewMutations(""), loc, []string{filepath.ToSlash(planRel)}, "seed the plan", fabricengine.SyncOptions{})
+	if err != nil || !committed {
+		t.Fatalf("CommitAnchoredPaths(plan) committed = %v, err = %v", committed, err)
+	}
+
+	cards := []string{"01-one"}
+	st := &weaverengine.State{
+		RunGUID:           "guid",
+		PlanRecordsCommit: planCommit,
+		Attempts:          []*weaverengine.AttemptState{{Batch: 1, Number: 1, Outcome: "failed", Uncommitted: []string{"own.txt"}}},
+	}
+	st.Batches = map[int]*runplan.BatchState{1: {Slug: "one", Cards: cards, StartSHA: start, Kind: "strand"}}
+	st.Partition = []runplan.PartitionBatch{{Cards: cards}}
+	if err := os.MkdirAll(geom.RunDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := weaverengine.SaveState(geom.RunDir, geom.ScratchDir, st); err != nil {
+		t.Fatal(err)
+	}
+	if err := deps.Commit("seed the run state"); err != nil {
+		t.Fatalf("Commit() error = %v; want nil", err)
+	}
+
+	versions, err := deps.StateHistory()
+	if err != nil || len(versions) != 1 || !strings.Contains(string(versions[0].Data), `"runGuid": "guid"`) && !strings.Contains(string(versions[0].Data), `"runGuid":"guid"`) {
+		t.Fatalf("StateHistory() = %v, %v; want the committed state as its one version", versions, err)
+	}
+	if data, found, err := deps.ReadPlanAt(planCommit, filepath.Base(cardPath)); err != nil || !found || string(data) != string(original) {
+		t.Fatalf("ReadPlanAt() = %q, %v, %v; want the card as the records commit held it", data, found, err)
+	}
+
+	if err := os.WriteFile(cardPath, []byte("edited since the run began\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(taskTree, "own.txt"), []byte("dirty"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(taskTree, "untracked.txt"), []byte("keep"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if dirty, err := deps.DirtyTracked(); err != nil || !slices.Equal(dirty, []string{"own.txt"}) {
+		t.Fatalf("DirtyTracked() = %v, %v; want the tracked path alone", dirty, err)
+	}
+
+	result, err := weaverengine.Reset(deps, false)
+
+	if err != nil {
+		t.Fatalf("Reset() error = %v; want nil", err)
+	}
+	if got := gitkit.RevParse(t, taskTree, "HEAD"); got != start || result.StartSHA != start {
+		t.Errorf("HEAD = %q, result start = %q; want the run's start %q", got, result.StartSHA, start)
+	}
+	if _, err := os.Stat(filepath.Join(taskTree, "later.txt")); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("stat later.txt = %v; want the later commit discarded", err)
+	}
+	if got, err := os.ReadFile(filepath.Join(taskTree, "own.txt")); err != nil || string(got) != "base" {
+		t.Errorf("own.txt = %q, %v; want the run's own edit discarded", got, err)
+	}
+	if got, err := os.ReadFile(cardPath); err != nil || string(got) != string(original) {
+		t.Errorf("card = %q, %v; want the plan as the run began it", got, err)
+	}
+	if _, err := os.Stat(filepath.Join(geom.RunDir, "state.json")); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("stat state.json = %v; want it archived", err)
+	}
+	if subject := gitkit.Git(t, h.PairRecordsSibling(slug), "log", "-1", "--format=%s"); strings.TrimSpace(subject) != "weaver: reset" {
+		t.Errorf("records head subject = %q; want the reset's commit", subject)
+	}
+}
diff --git a/internal/weaverengine/active.go b/internal/weaverengine/active.go
new file mode 100644
index 00000000..912d8c18
--- /dev/null
+++ b/internal/weaverengine/active.go
@@ -0,0 +1,227 @@
+// active.go is the one seam every loom reader of implementer state goes through.
+// It tells which implementer, Webster or Weaver, the run belongs to by the begun batches in their state files,
+// and it refuses with the way forward when the two disagree or a state file cannot be read.
+
+package weaverengine
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/gatefixer"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/websterengine"
+)
+
+// Implementer names one of tapestry's implementers, by the value of `tapestry.implementer`.
+type Implementer string
+
+const (
+	// ImplementerWebster is the in-session implementer, and the setting's default.
+	ImplementerWebster Implementer = "webster"
+	// ImplementerWeaver is the cold-start implementer with model escalation.
+	ImplementerWeaver Implementer = "weaver"
+)
+
+// BatchStrandRole is the reed role of Weaver's batch strands.
+const BatchStrandRole = "weaver"
+
+// settingRefusal is the way forward of every refusal about the `tapestry.implementer` setting.
+const settingRefusal = "way forward: set the implementer with `lym config tapestry --set implementer=<webster|weaver>`"
+
+var (
+	// ErrImplementerConflict is wrapped by the refusal for a run whose two implementers both hold begun batches.
+	ErrImplementerConflict = errors.New("weaver: the run's implementers disagree")
+	// ErrActiveRefused is wrapped by every refusal to name the run's active implementer.
+	ErrActiveRefused = errors.New("weaver: the run's active implementer cannot be read")
+)
+
+// StateVersion is one committed version of Weaver's state file.
+type StateVersion struct {
+	// Commit is the records-repository commit the version was read from.
+	Commit string
+	// Data is the version's bytes.
+	Data []byte
+}
+
+// ActiveDeps carries what Active and ActiveOrSetting read.
+type ActiveDeps struct {
+	// AnchorRoot is the anchor both implementers' run directories hang off.
+	AnchorRoot string
+	// Setting reads `tapestry.implementer`.
+	// Nil answers webster, the setting's default.
+	Setting func() (string, error)
+	// StateHistory returns Weaver's state file's versions on the records branch's first-parent line, newest first.
+	StateHistory func() ([]StateVersion, error)
+	// TaskHead returns the task branch's HEAD.
+	TaskHead func() (string, error)
+	// LiveStrands returns the names of the strands `lym reed status` lists live.
+	// A nil StateHistory, TaskHead or LiveStrands makes the repair advice name `lym weaver reset` alone.
+	LiveStrands func() ([]string, error)
+}
+
+// RunDirs returns impl's run and scratch directories under anchorRoot,
+// so a reader names the active implementer's without a switch of its own.
+func RunDirs(impl Implementer, anchorRoot string) (runDir, scratchDir string) {
+	if impl == ImplementerWeaver {
+		return Dir(anchorRoot), ScratchDir(anchorRoot)
+	}
+	return websterengine.Dir(anchorRoot), websterengine.ScratchDir(anchorRoot)
+}
+
+// Active returns the run's active implementer and its run-plan state, nil when its state file is missing.
+// A state file counts as begun when it holds a batch record; a missing file counts as no begun batches.
+// With neither begun, the active implementer is the setting's value.
+//
+// It refuses with an error wrapping ErrActiveRefused when a state file fails to load.
+// It refuses the same way when both implementers hold begun batches, and that error also wraps ErrImplementerConflict.
+// It refuses the same way when the setting cannot be read or holds another value.
+// Each refusal ends in its way forward.
+// A corrupt file never counts as missing.
+func Active(deps ActiveDeps) (Implementer, *runplan.State, error) {
+	websterState, err := websterengine.LoadState(websterengine.Dir(deps.AnchorRoot), websterengine.ScratchDir(deps.AnchorRoot))
+	if err != nil {
+		return "", nil, fmt.Errorf("%w: %w; way forward: repair %s, or restore its committed version with git",
+			ErrActiveRefused, err, websterStateRel())
+	}
+	weaverState, err := LoadState(Dir(deps.AnchorRoot), ScratchDir(deps.AnchorRoot))
+	if err != nil {
+		return "", nil, fmt.Errorf("%w: %w; way forward: %s", ErrActiveRefused, err, weaverRepairAdvice(deps))
+	}
+
+	websterBegun := websterState != nil && len(websterState.Batches) > 0
+	weaverBegun := BegunBatches(weaverState)
+	switch {
+	case websterBegun && weaverBegun:
+		return "", nil, fmt.Errorf("%w: %w: both %s and %s hold begun batches; way forward: "+
+			"end the run you do not mean to keep, with `lym webster reset --to start` for Webster's run or `lym weaver reset` for Weaver's",
+			ErrActiveRefused, ErrImplementerConflict, websterStateRel(), StateRel())
+	case websterBegun:
+		return ImplementerWebster, &websterState.State, nil
+	case weaverBegun:
+		return ImplementerWeaver, &weaverState.State, nil
+	}
+
+	impl, err := settingImplementer(deps)
+	if err != nil {
+		return "", nil, err
+	}
+	switch {
+	case impl == ImplementerWeaver && weaverState != nil:
+		return impl, &weaverState.State, nil
+	case impl == ImplementerWebster && websterState != nil:
+		return impl, &websterState.State, nil
+	}
+	return impl, nil, nil
+}
+
+// ActiveOrSetting is the advisory readers' form of Active.
+// On a refusal it falls back to the setting's implementer, and to webster when the setting cannot be read.
+// It loads that implementer's state when it loads, and returns the refusal's text as the reason the caller logs.
+// The reason is empty when Active answered.
+func ActiveOrSetting(deps ActiveDeps) (Implementer, *runplan.State, string) {
+	impl, st, err := Active(deps)
+	if err == nil {
+		return impl, st, ""
+	}
+
+	impl, settingErr := settingImplementer(deps)
+	if settingErr != nil {
+		impl = ImplementerWebster
+	}
+	runDir, scratchDir := RunDirs(impl, deps.AnchorRoot)
+	if impl == ImplementerWeaver {
+		if weaverState, loadErr := LoadState(runDir, scratchDir); loadErr == nil && weaverState != nil {
+			return impl, &weaverState.State, err.Error()
+		}
+		return impl, nil, err.Error()
+	}
+	if websterState, loadErr := websterengine.LoadState(runDir, scratchDir); loadErr == nil && websterState != nil {
+		return impl, &websterState.State, err.Error()
+	}
+	return impl, nil, err.Error()
+}
+
+// settingImplementer reads the setting and refuses a failed read and a value that is not an implementer.
+func settingImplementer(deps ActiveDeps) (Implementer, error) {
+	if deps.Setting == nil {
+		return ImplementerWebster, nil
+	}
+	value, err := deps.Setting()
+	if err != nil {
+		return "", fmt.Errorf("%w: read the tapestry.implementer setting: %w; %s", ErrActiveRefused, err, settingRefusal)
+	}
+	switch Implementer(value) {
+	case ImplementerWebster, ImplementerWeaver:
+		return Implementer(value), nil
+	}
+	return "", fmt.Errorf("%w: tapestry.implementer is %q, neither webster nor weaver; %s", ErrActiveRefused, value, settingRefusal)
+}
+
+// websterStateRel returns Webster's state file's anchor-relative path.
+func websterStateRel() string {
+	return websterengine.DirRel() + "/" + stateFileName
+}
+
+// weaverRepairAdvice names how to repair a Weaver state file that fails to load.
+// It names the committed version restorableVersion picks, and `lym weaver reset` when it picks none.
+func weaverRepairAdvice(deps ActiveDeps) string {
+	version, ok := restorableVersion(deps)
+	if !ok {
+		return "start the run over with `lym weaver reset`"
+	}
+	return fmt.Sprintf("restore %s from records commit %s with git;"+
+		" that version holds because the next begin captures HEAD as the start, so no attempt may have committed since and none may be in flight,"+
+		" and neither has; or start the run over with `lym weaver reset`", StateRel(), version.Commit)
+}
+
+// restorableVersion picks the newest committed version of Weaver's state file that parses.
+// It picks it only when its LastEnd equals the task branch's HEAD and no strand of Weaver's roles is live.
+// A restored state then holds, because the next begin captures HEAD as the start.
+// So no attempt may have committed since, and none may be in flight.
+// A read that is not wired or that fails picks none.
+func restorableVersion(deps ActiveDeps) (StateVersion, bool) {
+	if deps.StateHistory == nil || deps.TaskHead == nil || deps.LiveStrands == nil {
+		return StateVersion{}, false
+	}
+	versions, err := deps.StateHistory()
+	if err != nil {
+		return StateVersion{}, false
+	}
+	head, err := deps.TaskHead()
+	if err != nil {
+		return StateVersion{}, false
+	}
+	live, err := deps.LiveStrands()
+	if err != nil {
+		return StateVersion{}, false
+	}
+
+	for _, version := range versions {
+		var parsed State
+		if json.Unmarshal(version.Data, &parsed) != nil {
+			continue
+		}
+		if parsed.LastEnd != head || weaverStrandLive(live) {
+			return StateVersion{}, false
+		}
+		return version, true
+	}
+	return StateVersion{}, false
+}
+
+// weaverStrandLive reports whether any of the named strands holds a batch strand or verify fixer role.
+func weaverStrandLive(names []string) bool {
+	for _, name := range names {
+		parsed, err := agentname.Parse(name)
+		if err != nil {
+			continue
+		}
+		if agentname.MatchesRole(parsed.Role, BatchStrandRole) || agentname.MatchesRole(parsed.Role, gatefixer.RoleVerifyFixer) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/weaverengine/active_test.go b/internal/weaverengine/active_test.go
new file mode 100644
index 00000000..9b7e229f
--- /dev/null
+++ b/internal/weaverengine/active_test.go
@@ -0,0 +1,220 @@
+// active_test.go covers the active-implementer seam over temp anchors with planted state files.
+
+package weaverengine_test
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/gatefixer"
+	"github.com/Knatte18/loomyard/internal/runplan"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+	"github.com/Knatte18/loomyard/internal/weaverengine"
+	"github.com/Knatte18/loomyard/internal/websterengine"
+)
+
+// stateKind is how a test plants one implementer's state file.
+type stateKind int
+
+const (
+	stateAbsent stateKind = iota
+	stateEmpty
+	stateBegun
+	stateCorrupt
+)
+
+// plantState writes one implementer's state file under anchor in the given kind.
+func plantState(t *testing.T, anchor string, impl weaverengine.Implementer, kind stateKind) {
+	t.Helper()
+	if kind == stateAbsent {
+		return
+	}
+	runDir, scratchDir := weaverengine.RunDirs(impl, anchor)
+	batches := map[int]*runplan.BatchState{}
+	if kind == stateBegun {
+		batches[1] = &runplan.BatchState{Slug: "one"}
+	}
+	switch {
+	case kind == stateCorrupt:
+		if err := os.MkdirAll(runDir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(runDir, "state.json"), []byte("{not json"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	case impl == weaverengine.ImplementerWeaver:
+		if err := weaverengine.SaveState(runDir, scratchDir, &weaverengine.State{State: runplan.State{Batches: batches}}); err != nil {
+			t.Fatal(err)
+		}
+	default:
+		if err := websterengine.SaveState(runDir, scratchDir, &websterengine.State{State: runplan.State{Batches: batches}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestActive(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+
+	setting := func(value string) func() (string, error) {
+		return func() (string, error) { return value, nil }
+	}
+	versionAt := func(commit, lastEnd string) weaverengine.StateVersion {
+		data, err := json.Marshal(weaverengine.State{LastEnd: lastEnd})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return weaverengine.StateVersion{Commit: commit, Data: data}
+	}
+	strand := func(role string) string {
+		name, err := agentname.Format("sn", "slug", role)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return name
+	}
+	history := func(versions ...weaverengine.StateVersion) func() ([]weaverengine.StateVersion, error) {
+		return func() ([]weaverengine.StateVersion, error) { return versions, nil }
+	}
+	head := func(sha string) func() (string, error) { return func() (string, error) { return sha, nil } }
+	live := func(names ...string) func() ([]string, error) { return func() ([]string, error) { return names, nil } }
+
+	tests := []struct {
+		name        string
+		webster     stateKind
+		weaver      stateKind
+		deps        weaverengine.ActiveDeps
+		want        weaverengine.Implementer
+		wantState   bool
+		wantRefused bool
+		wantInText  []string
+		wantNotText []string
+	}{
+		{name: "neither file with setting webster", deps: weaverengine.ActiveDeps{Setting: setting("webster")}, want: weaverengine.ImplementerWebster},
+		{name: "neither file with setting weaver", deps: weaverengine.ActiveDeps{Setting: setting("weaver")}, want: weaverengine.ImplementerWeaver},
+		{name: "neither file with a nil setting", want: weaverengine.ImplementerWebster},
+		{
+			name: "setting error", wantRefused: true, wantInText: []string{"lym config tapestry"},
+			deps: weaverengine.ActiveDeps{Setting: func() (string, error) { return "", errors.New("unreadable") }},
+		},
+		{name: "unknown setting value", deps: weaverengine.ActiveDeps{Setting: setting("other")}, wantRefused: true, wantInText: []string{"lym config tapestry"}},
+		{name: "begun Webster wins over setting weaver", webster: stateBegun, deps: weaverengine.ActiveDeps{Setting: setting("weaver")}, want: weaverengine.ImplementerWebster, wantState: true},
+		{name: "begun Weaver wins over setting webster", weaver: stateBegun, deps: weaverengine.ActiveDeps{Setting: setting("webster")}, want: weaverengine.ImplementerWeaver, wantState: true},
+		{name: "unbegun state follows the setting", webster: stateEmpty, weaver: stateEmpty, deps: weaverengine.ActiveDeps{Setting: setting("weaver")}, want: weaverengine.ImplementerWeaver, wantState: true},
+		{
+			name: "both begun", webster: stateBegun, weaver: stateBegun, deps: weaverengine.ActiveDeps{Setting: setting("weaver")},
+			wantRefused: true, wantInText: []string{"lym webster reset --to start", "lym weaver reset"}, wantNotText: []string{"lym config tapestry"},
+		},
+		{name: "corrupt Webster file", webster: stateCorrupt, wantRefused: true, wantInText: []string{"_lym/webster/state.json", "repair"}},
+		{
+			name: "corrupt Webster file with Weaver begun", webster: stateCorrupt, weaver: stateBegun,
+			wantRefused: true, wantInText: []string{"_lym/webster/state.json", "repair"},
+		},
+		{
+			name: "corrupt Weaver file restores the newest parsing version", weaver: stateCorrupt, wantRefused: true,
+			deps: weaverengine.ActiveDeps{
+				StateHistory: history(versionAt("c-new", "h1"), versionAt("c-old", "h0")), TaskHead: head("h1"), LiveStrands: live(strand("reviewer")),
+			},
+			wantInText: []string{"_lym/weaver/state.json", "c-new", "restore"}, wantNotText: []string{"c-old"},
+		},
+		{
+			name: "corrupt Weaver file with HEAD moved", weaver: stateCorrupt, wantRefused: true,
+			deps:       weaverengine.ActiveDeps{StateHistory: history(versionAt("c-new", "h1")), TaskHead: head("h2"), LiveStrands: live()},
+			wantInText: []string{"lym weaver reset"}, wantNotText: []string{"c-new"},
+		},
+		{
+			name: "corrupt Weaver file with a live batch strand", weaver: stateCorrupt, wantRefused: true,
+			deps:       weaverengine.ActiveDeps{StateHistory: history(versionAt("c-new", "h1")), TaskHead: head("h1"), LiveStrands: live(strand("weaver-2"))},
+			wantInText: []string{"lym weaver reset"}, wantNotText: []string{"c-new"},
+		},
+		{
+			name: "corrupt Weaver file with a live verify fixer", weaver: stateCorrupt, wantRefused: true,
+			deps:       weaverengine.ActiveDeps{StateHistory: history(versionAt("c-new", "h1")), TaskHead: head("h1"), LiveStrands: live(strand(gatefixer.RoleVerifyFixer))},
+			wantInText: []string{"lym weaver reset"}, wantNotText: []string{"c-new"},
+		},
+		{
+			name: "corrupt Weaver file with no parsing version", weaver: stateCorrupt, wantRefused: true,
+			deps: weaverengine.ActiveDeps{
+				StateHistory: history(weaverengine.StateVersion{Commit: "c-bad", Data: []byte("{")}), TaskHead: head("h1"), LiveStrands: live(),
+			},
+			wantInText: []string{"lym weaver reset"}, wantNotText: []string{"c-bad"},
+		},
+		{
+			name: "corrupt Weaver file with a failing history read", weaver: stateCorrupt, wantRefused: true,
+			deps: weaverengine.ActiveDeps{
+				StateHistory: func() ([]weaverengine.StateVersion, error) { return nil, errors.New("no history") }, TaskHead: head("h1"), LiveStrands: live(),
+			},
+			wantInText: []string{"lym weaver reset"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			anchor := t.TempDir()
+			plantState(t, anchor, weaverengine.ImplementerWebster, tt.webster)
+			plantState(t, anchor, weaverengine.ImplementerWeaver, tt.weaver)
+			deps := tt.deps
+			deps.AnchorRoot = anchor
+
+			got, st, err := weaverengine.Active(deps)
+			if tt.wantRefused {
+				if !errors.Is(err, weaverengine.ErrActiveRefused) {
+					t.Fatalf("Active() error = %v; want one wrapping ErrActiveRefused", err)
+				}
+				for _, text := range tt.wantInText {
+					if !strings.Contains(err.Error(), text) {
+						t.Errorf("Active() error = %q; want it to contain %q", err, text)
+					}
+				}
+				for _, text := range tt.wantNotText {
+					if strings.Contains(err.Error(), text) {
+						t.Errorf("Active() error = %q; want it free of %q", err, text)
+					}
+				}
+				if conflict := tt.webster == stateBegun && tt.weaver == stateBegun; conflict != errors.Is(err, weaverengine.ErrImplementerConflict) {
+					t.Errorf("Active() error = %v; ErrImplementerConflict match want %v", err, conflict)
+				}
+			} else {
+				if err != nil {
+					t.Fatalf("Active() error = %v; want none", err)
+				}
+				if got != tt.want || (st != nil) != tt.wantState {
+					t.Errorf("Active() = (%q, state %v); want (%q, state %v)", got, st != nil, tt.want, tt.wantState)
+				}
+			}
+
+			advisory, advisoryState, reason := weaverengine.ActiveOrSetting(deps)
+			if !tt.wantRefused {
+				if advisory != tt.want || (advisoryState != nil) != tt.wantState || reason != "" {
+					t.Errorf("ActiveOrSetting() = (%q, state %v, %q); want (%q, state %v, no reason)", advisory, advisoryState != nil, reason, tt.want, tt.wantState)
+				}
+				return
+			}
+			if reason != err.Error() {
+				t.Errorf("ActiveOrSetting() reason = %q; want the refusal %q", reason, err)
+			}
+			wantAdvisory := weaverengine.ImplementerWebster
+			if value, settingErr := callSetting(deps); settingErr == nil && value == "weaver" {
+				wantAdvisory = weaverengine.ImplementerWeaver
+			}
+			if advisory != wantAdvisory {
+				t.Errorf("ActiveOrSetting() implementer = %q; want the setting's %q", advisory, wantAdvisory)
+			}
+		})
+	}
+}
+
+// callSetting reads deps' setting, answering webster for a nil one.
+func callSetting(deps weaverengine.ActiveDeps) (string, error) {
+	if deps.Setting == nil {
+		return "webster", nil
+	}
+	return deps.Setting()
+}
