-			Name:     "python",
-			Patterns: []string{pythonCommandPattern},
-			Steer:    steerPythonDeny,
-			Notice:   noticePythonDeny,
-			Switch:   SwitchDenyPython,
-			Forms:    [][]string{{"python"}, {"python3"}},
+			Name:        "python",
+			Patterns:    []string{pythonCommandPattern},
