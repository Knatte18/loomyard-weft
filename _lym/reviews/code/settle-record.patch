diff --git a/docs/research/speed/task-runtime-before-after-2026-11-06/join-gate.sh b/docs/research/speed/task-runtime-before-after-2026-11-06/join-gate.sh
new file mode 100755
index 00000000..c4aa56c2
--- /dev/null
+++ b/docs/research/speed/task-runtime-before-after-2026-11-06/join-gate.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# Usage: join-gate.sh <gate.json> <runs.tsv>
+# Sums `lym gate report` per slug into gate-by-slug.tsv beside runs.tsv (gate wall seconds and slot-wait seconds, in total and for the darn writer's own gate),
+# then replaces runs.tsv with itself plus the columns gate_wall, gate_wait, writer_gate_wall and gate_runs.
+# gate_wall is the summed wall time of the slug's tier runs and gate_wait their summed slot wait, both in seconds; the build step and abandoned calls are not in either.
+# A run whose slug the gate report holds no row of gets "-" in all four columns.
+# Two runs sharing a slug each get the slug's whole sum.
+set -euo pipefail
+gate=$1 runs=$2
+dir=$(dirname "$runs")
+jq -r '.rows | map(select(.slug != "")) | group_by(.slug)[] | [
+    .[0].slug,
+    (map(.wall_seconds) | add | round),
+    (map(.wait_seconds) | add | round),
+    (map(select(.gate_key == "darn-write") | .wall_seconds) | add // 0 | round),
+    (map(.tier_runs) | add)
+  ] | @tsv' "$gate" | sort > "$dir/gate-by-slug.tsv"
+awk -F'\t' -v OFS='\t' '
+  FILENAME == ARGV[1] { wall[$1] = $2; wait[$1] = $3; writer[$1] = $4; runs[$1] = $5; next }
+  FNR == 1 { print $0, "gate_wall", "gate_wait", "writer_gate_wall", "gate_runs"; next }
+  { if ($1 in wall) print $0, wall[$1], wait[$1], writer[$1], runs[$1]; else print $0, "-", "-", "-", "-" }
+' "$dir/gate-by-slug.tsv" "$runs" > "$runs.joined"
+mv "$runs.joined" "$runs"
diff --git a/docs/research/speed/task-runtime-before-after-2026-11-06/producers.sh b/docs/research/speed/task-runtime-before-after-2026-11-06/producers.sh
new file mode 100755
index 00000000..1e402b9f
--- /dev/null
+++ b/docs/research/speed/task-runtime-before-after-2026-11-06/producers.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# Usage: producers.sh [runs.tsv] > producers.tsv
+# Prints, per landed run of runs.tsv, the producers (recipe rows) its shed status records at its archive tag, as "slug<TAB>tag<TAB>start<TAB>recipe<TAB>comma-joined producers in order, a repeat kept".
+# A run whose archive tag holds no status file gets "-" for its producers.
+# The recipe rows a run went through show which rows the recipe held when it ran, so a row added or dropped inside the window shows as a change in the share of runs holding it.
+# Needs bash, jq and git; reads only. WEFT names the weft repository (default: the prime's, with -weft appended).
+set -euo pipefail
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+root=$(git -C "$here" rev-parse --show-toplevel)
+runs=${1:-$here/runs.tsv}
+prime=${PRIME:-$(git -C "$root" worktree list --porcelain | awk 'NR == 1 { print $2 }')}
+weft=${WEFT:-$prime-weft}
+
+awk -F'\t' -v OFS='\t' 'NR > 1 { print $1, $2, $4, $3 }' "$runs" |
+  while IFS=$'\t' read -r slug tag start recipe; do
+    producers=$(git -C "$weft" show "$tag:_lym/shed/$slug/status.json" 2>/dev/null | jq -r '[.history[].producer] | join(",")' 2>/dev/null || true)
+    printf '%s\t%s\t%s\t%s\t%s\n' "$slug" "$tag" "$start" "$recipe" "${producers:--}"
+  done
