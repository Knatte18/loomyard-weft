+		originCommitFile(t, origin.CodeBare, origin.primeBranch, "moved.txt", "three")
+		hubResult, err := fabricengine.PullHub(prime, fabricengine.SyncOptions{}, func(*lymcwd.Location) (func(), error) { return func() {}, nil })
+		if err != nil {
