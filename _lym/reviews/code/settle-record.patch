+ // open_files holds one list per place: the prime, a beam and a task.
+ // Each entry is a path relative to the worktree's anchored directory, the folder its window shows.
+ // An entry may name the {beam} placeholder, which the opener resolves to the beam's slug.
+-// The template opens README.md for a beam and nothing for the prime or a task;
+-// a beam's own file, such as docs/{beam}.md, is named by adding an entry.
++// The template opens nothing for any place;
++// a file to open, such as a beam's own docs/{beam}.md, is named by adding an entry.
+ // render_markdown, on in the template, makes a markdown file open as VS Code's markdown preview rather than as source.
+ // Both keys only change what a window shows, so a worktree's local override may set them.
+ //
+diff --git a/internal/ideconfig/template.yaml b/internal/ideconfig/template.yaml
+index cb5cb259..b0b2a756 100644
+--- a/internal/ideconfig/template.yaml
++++ b/internal/ideconfig/template.yaml
+@@ -1,6 +1,5 @@
+ open_files:  # files `lym ide spawn` and `lym ide open` open beside the folder or workspace they launch, one list per place, in order; each a path relative to the worktree's anchored directory, the folder its window shows, where {beam} stands for the beam's slug: a beam's own, a task's parent's, or the prime's name for the prime and a task forked from it; an entry naming no existing file is skipped
+   prime: []
+-  beam:
+-    - README.md
++  beam: []
+   task: []
+ render_markdown: true  # whether a markdown file opens rendered, as VS Code's markdown preview, in a worktree `lym ide` seeds; lym then owns the "*.md" entry of workbench.editorAssociations in the worktree's settings.json, and off removes that entry while it names the preview; "Reopen Editor With..." switches one file either way
