+	}
+
+	if len(pulls) != 2 {
+		t.Fatalf("Bolt pulls = %d; want 2, the second bringing in the owner its own probe acts on", len(pulls))
+	}
+	if gap := pulls[1].Sub(pulls[0]); gap < boltPullInterval {
