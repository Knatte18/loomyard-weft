diff --git a/internal/fabricengine/remoteteardown.go b/internal/fabricengine/remoteteardown.go
new file mode 100644
index 00000000..67d97811
--- /dev/null
+++ b/internal/fabricengine/remoteteardown.go
@@ -0,0 +1,459 @@
+// remoteteardown.go implements the remote half of a teardown, which no command waits on.
+// A removal, a task-branch discard and a cleanup sweep finish their local steps, then hand a job of remote steps to a detached child.
+// The child takes the pair's teardown lock exclusive before the command's first mutation and holds it until the job's last remote step ends, so no push, Add or other teardown of the slug runs in between.
+// The file holds the job, the hold through which a command keeps the lock across the handover, the child's body and the notice of a failed remote step.
+
+package fabricengine
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/runproc"
+)
+
+// The hidden fabric verb and flags that start the teardown child.
+const (
+	// TeardownChildVerb is the hidden fabric subcommand that runs the remote half of a teardown.
+	TeardownChildVerb = "remote-teardown"
+	// TeardownChildSlugFlag names the slug whose teardown lock the child holds.
+	TeardownChildSlugFlag = "slug"
+	// TeardownChildTryFlag makes the child take the lock by one attempt instead of waiting for it.
+	TeardownChildTryFlag = "try"
+	// TeardownChildWaitFlag bounds the child's wait for the lock.
+	TeardownChildWaitFlag = "wait"
+)
+
+// The one line the teardown child answers on its signal stream once it has tried the lock.
+const (
+	teardownHeldSignal = "held"
+	teardownBusySignal = "busy"
+)
+
+// The kinds of remote teardown job, a closed set.
+const (
+	remoteTeardownRemove  = "remove"
+	remoteTeardownCleanup = "cleanup"
+	remoteTeardownDiscard = "discard"
+)
+
+// remoteTeardownJob is the remote half of one teardown, written by the command and run by the holder of the slug's teardown lock.
+type remoteTeardownJob struct {
+	// Kind is one of the remoteTeardown kinds.
+	Kind string `json:"kind"`
+	Slug string `json:"slug"`
+	// Worktree is the warp worktree the command ran from, the location every step runs from.
+	Worktree     string `json:"worktree"`
+	BranchPrefix string `json:"branch_prefix"`
+	WeftBranch   string `json:"weft_branch,omitempty"`
+	// WeftTip is the local weft tip the command tagged before it deleted the branch, empty when no local branch was left, so the child reads origin's.
+	WeftTip string `json:"weft_tip,omitempty"`
+	// DeleteWeftOnOrigin asks for the weft branch's delete on origin, leased on the origin tip the archive read.
+	DeleteWeftOnOrigin bool   `json:"delete_weft_on_origin,omitempty"`
+	WarpBranch         string `json:"warp_branch,omitempty"`
+	// ParentBranch is the pair's recorded parent, which gates the task branch's delete on origin.
+	ParentBranch       string `json:"parent_branch,omitempty"`
+	DeleteTaskOnOrigin bool   `json:"delete_task_on_origin,omitempty"`
+	// TaskTip is the local task tip a discard tagged and deleted, empty when no local task branch existed.
+	TaskTip string `json:"task_tip,omitempty"`
+	// ExemptPause is set when the command that wrote the job runs exempt from every pause, so the child's remote steps pass under a pause as the command's own did.
+	ExemptPause bool `json:"exempt_pause,omitempty"`
+}
+
+// remoteOutcome is what the remote steps of a job did.
+// Only an outcome whose steps ran in process carries anything; a handed-over job's outcome is the zero value with handedOff set.
+type remoteOutcome struct {
+	ran       bool
+	handedOff bool
+	// archive and archiveSkipped are the weft archive of a removal or a cleanup.
+	archive        weftArchive
+	archiveSkipped string
+	// weft carries the outcome of the weft branch's delete on origin.
+	weft CleanupBranchEntry
+	// weftKeptOnOrigin is set when the weft branch lives only on origin and the job did not ask for its delete.
+	weftKeptOnOrigin string
+	taskDeleted      bool
+	// taskKept is why the task branch on origin was left in place; taskFailed marks it as a failed lookup, fetch or delete, not a refusal or a moved tip.
+	taskKept   string
+	taskFailed bool
+	// discard carries the archive tags and the origin delete of a discard.
+	discard DiscardResult
+	// err is the failure that stopped the steps.
+	err error
+	// weftRootErr is the failure to find the records repository after the archive succeeded; it is also err, and tells the notice the archive itself did not fail.
+	weftRootErr error
+}
+
+// runRemoteTeardown runs job's remote steps from the location l of job.Worktree, recording on rec, with sleep between archive-tag push attempts.
+// A removal and a cleanup archive the weft tips and then delete the weft branch on origin when asked, a removal pushing the weft tip first;
+// a removal then deletes the landed task branch on origin when asked.
+// A discard archives the task branch's tips and deletes it on origin.
+func runRemoteTeardown(rec *Mutations, l *lymcwd.Location, job remoteTeardownJob, sleep func(time.Duration)) remoteOutcome {
+	out := remoteOutcome{ran: true, weft: CleanupBranchEntry{Branch: job.WeftBranch}}
+	if job.Kind == remoteTeardownDiscard {
+		out.discard, out.err = discardTaskBranchOnOrigin(rec, l, job, sleep)
+		return out
+	}
+
+	out.archive, out.archiveSkipped, out.err = archiveWeftTip(rec, l, job.Slug, job.WeftBranch, job.WeftTip, job.Kind == remoteTeardownRemove, sleep)
+	if out.err != nil {
+		return out
+	}
+	if out.archiveSkipped == "" && out.archive.leaseTip != "" {
+		if job.DeleteWeftOnOrigin {
+			weftRoot, err := RecordsRepoRoot(l)
+			if err != nil {
+				out.weftRootErr = fmt.Errorf("resolve weft repo root: %w", err)
+				out.err = out.weftRootErr
+				return out
+			}
+			deleteWeftBranchOnRemote(rec, l, job.WeftBranch, job.BranchPrefix, weftRoot, out.archive.leaseTip, &out.weft)
+		} else if job.WeftTip == "" {
+			out.weftKeptOnOrigin = fmt.Sprintf("the sibling branch %q exists only on %q and was kept; pass --remote to delete it", job.WeftBranch, originRemoteName)
+		}
+	}
+	if job.DeleteTaskOnOrigin {
+		out.taskDeleted, out.taskKept, out.taskFailed = deleteTaskBranchOnOrigin(rec, l, job.WarpBranch, job.ParentBranch)
+	}
+	return out
+}
+
+// remoteStepFailure is one failed remote step of a teardown job and the way forward that settles it.
+type remoteStepFailure struct {
+	operation  string
+	reason     string
+	wayForward string
+}
+
+// discardRerunWayForward is the way forward of a discard's failed remote step, whose command has no fixed spelling.
+const discardRerunWayForward = "run the command that discarded the task branch again"
+
+// unknownKindWayForward returns the way forward for a remote teardown of slug whose job kind is not known: the re-run of each command that starts one.
+func unknownKindWayForward(slug string) string {
+	return fmt.Sprintf("run `lym fabric remove %s --remote` again, `lym fabric cleanup --apply --remote` when a cleanup sweep started it, or the command that discarded the task branch when a discard started it", slug)
+}
+
+// rerunWayForward returns the re-run that retries the remote steps of job: the cleanup sweep for a cleanup job, else the removal of its slug.
+// It serves a step that leaves its branch on origin, which is what lets the re-run find the pair.
+func rerunWayForward(job remoteTeardownJob) string {
+	if job.Kind == remoteTeardownCleanup {
+		return "run `lym fabric cleanup --apply --remote` again"
+	}
+	return fmt.Sprintf("run `lym fabric remove %s --remote` again", job.Slug)
+}
+
+// failedRemoteSteps returns every failed remote step of job's outcome, in the order the steps ran.
+// A step that stopped the job leaves the later steps unrun, so their outcome fields are empty.
+// weftRoot is the records repository's root, empty when it could not be found, in which case no manual tag push is named for the records archive.
+func failedRemoteSteps(job remoteTeardownJob, out remoteOutcome, weftRoot string) []remoteStepFailure {
+	var failures []remoteStepFailure
+	switch {
+	case out.err != nil && job.Kind == remoteTeardownDiscard:
+		wayForward := discardRerunWayForward
+		if job.TaskTip != "" {
+			wayForward = fmt.Sprintf("push the archive tag with `git -C %s push %s refs/tags/%s`, then %s", job.Worktree, originRemoteName, ArchiveTagName(job.Slug, job.TaskTip), wayForward)
+		}
+		failures = append(failures, remoteStepFailure{"the archive and origin delete of its task branch", out.err.Error(), wayForward})
+	case out.weftRootErr != nil:
+		failures = append(failures, remoteStepFailure{"the lookup of its records repository", out.weftRootErr.Error(), rerunWayForward(job)})
+	case out.err != nil:
+		wayForward := rerunWayForward(job)
+		if job.WeftTip != "" {
+			if job.Kind == remoteTeardownRemove {
+				// A removal whose branches never reached origin leaves its re-run nothing to find.
+				wayForward = "when origin still holds a branch of the pair, " + wayForward
+			}
+			if weftRoot != "" {
+				wayForward = fmt.Sprintf("push the archive tag with `git -C %s push %s refs/tags/%s`, then %s", weftRoot, originRemoteName, ArchiveTagName(job.Slug, job.WeftTip), wayForward)
+			}
+		}
+		failures = append(failures, remoteStepFailure{"the archive of its records", out.err.Error(), wayForward})
+	}
+	if out.weft.RemoteError != "" {
+		failures = append(failures, remoteStepFailure{"the delete of its records branch on origin", out.weft.RemoteError, rerunWayForward(job)})
+	}
+	if out.taskFailed {
+		failures = append(failures, remoteStepFailure{"the delete of its task branch on origin", out.taskKept, rerunWayForward(job)})
+	}
+	return failures
+}
+
+// noticeRemoteTeardown logs every failed remote step of job and mails the hub's orch one line naming the slug and, for each failed step, the operation and the way forward.
+// A kept branch is no failure and mails nothing.
+// weftRoot is the records repository's root, empty when it could not be found.
+func noticeRemoteTeardown(hubPath string, job remoteTeardownJob, out remoteOutcome, weftRoot string) {
+	failures := failedRemoteSteps(job, out, weftRoot)
+	if len(failures) == 0 {
+		logger.Info("fabricengine: remote teardown done", "slug", job.Slug, "kind", job.Kind, "weft_kept", out.weft.RemoteKeptReason, "task_kept", out.taskKept)
+		return
+	}
+	clauses := make([]string, len(failures))
+	for i, failure := range failures {
+		clauses[i] = fmt.Sprintf("at %s: %s; way forward: %s", failure.operation, failure.reason, failure.wayForward)
+	}
+	postRemoteTeardownNotice(hubPath, job.Slug, fmt.Sprintf("the remote teardown of %s failed %s", job.Slug, strings.Join(clauses, "; and ")))
+}
+
+// noticeUnreadRemoteTeardown logs and mails that the remote steps of slug's teardown never ran, because their job could not be read.
+func noticeUnreadRemoteTeardown(hubPath, slug string, readErr error) {
+	postRemoteTeardownNotice(hubPath, slug, fmt.Sprintf("the remote teardown of %s failed at reading its job: %v; way forward: %s", slug, readErr, unknownKindWayForward(slug)))
+}
+
+// NoticeRemoteTeardownEnded logs and mails that the remote teardown of slug ended before its last step, for the reason given.
+// The job's kind is not known to a caller that was ended by a signal or could not write the job, so the way forward names each command that starts a remote teardown.
+func NoticeRemoteTeardownEnded(hubPath, slug, reason string) {
+	postRemoteTeardownNotice(hubPath, slug, fmt.Sprintf("the remote teardown of %s ended before its last step: %s; way forward: %s", slug, reason, unknownKindWayForward(slug)))
+}
+
+// postRemoteTeardownNotice logs line at Warn and mails it to the hub's orch through the installed notifier; with none installed it only logs.
+func postRemoteTeardownNotice(hubPath, slug, line string) {
+	logger.Warn("fabricengine: "+line, "slug", slug)
+	notifier := installedPushNotifier.Load()
+	if notifier == nil {
+		return
+	}
+	if _, err := (*notifier)(hubPath, line); err != nil {
+		logger.Warn("fabricengine: remote teardown notice not posted", "slug", slug, "error", err)
+	}
+}
+
+// teardownHold keeps a slug's teardown lock exclusive until the job handed to finish has run.
+type teardownHold interface {
+	// finish runs or hands over job and releases the lock once its last remote step ends; a nil job releases it at once.
+	finish(job *remoteTeardownJob) remoteOutcome
+}
+
+// holdTeardown takes slug's teardown lock exclusive for a teardown whose remote steps follow its local ones, waiting and refusing as lockPairTeardown does.
+// With handOff set, outside a test binary, a detached child takes the lock and holds it: finish hands the child the job and returns at once, and the child releases the lock after the job's last remote step.
+// Otherwise the lock is held in process and finish runs the job before it releases the lock, so the verb's result carries the remote outcome.
+// A lock file the call brings into being is recorded in lockRec, and an in-process job's steps in rec.
+func (t *Topology) holdTeardown(lockRec, rec *Mutations, l *lymcwd.Location, slug string, try bool, rerun string, handOff bool) (teardownHold, error) {
+	if !handOff || testing.Testing() {
+		release, err := t.lockPairTeardown(lockRec, l, slug, try, rerun)
+		if err != nil {
+			return nil, err
+		}
+		return &inProcessHold{rec: rec, location: l, release: release, sleep: t.archiveSleep}, nil
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return nil, fmt.Errorf("start the teardown child of %q: %w", slug, err)
+	}
+	return spawnTeardownHold(lockRec, l, slug, try, exe, teardownChildArgs(slug, try, t.teardownWait), rerun)
+}
+
+// inProcessHold is a teardown lock this process holds.
+type inProcessHold struct {
+	rec      *Mutations
+	location *lymcwd.Location
+	release  func()
+	sleep    func(time.Duration)
+}
+
+// finish runs job in process, then releases the lock.
+func (h *inProcessHold) finish(job *remoteTeardownJob) remoteOutcome {
+	defer h.release()
+	if job == nil {
+		return remoteOutcome{}
+	}
+	return runRemoteTeardown(h.rec, h.location, *job, h.sleep)
+}
+
+// childHold is a teardown lock a detached child holds for this process.
+type childHold struct {
+	hubPath string
+	slug    string
+	cmd     *exec.Cmd
+	stdin   io.WriteCloser
+}
+
+// finish writes job to the child, marked with whether this process runs exempt from every pause, and returns at once, leaving the child to run it; a nil job closes the child's input and waits for it to release the lock.
+// A job that cannot be written is logged and mailed with its way forward, and the child, reading no job, releases the lock.
+func (h *childHold) finish(job *remoteTeardownJob) remoteOutcome {
+	if job == nil {
+		_ = h.stdin.Close()
+		_ = h.cmd.Wait()
+		return remoteOutcome{}
+	}
+	handed := *job
+	handed.ExemptPause = pauserecord.GateExemptsAll()
+	if err := json.NewEncoder(h.stdin).Encode(handed); err != nil {
+		NoticeRemoteTeardownEnded(h.hubPath, h.slug, fmt.Sprintf("its job could not be handed to the child: %v", err))
+	}
+	_ = h.stdin.Close()
+	go func() { _ = h.cmd.Wait() }()
+	return remoteOutcome{handedOff: true}
+}
+
+// teardownChildArgs returns the arguments of the teardown child for slug.
+func teardownChildArgs(slug string, try bool, wait time.Duration) []string {
+	args := []string{"fabric", TeardownChildVerb, "--" + TeardownChildSlugFlag, slug, "--" + TeardownChildWaitFlag, wait.String()}
+	if try {
+		args = append(args, "--"+TeardownChildTryFlag)
+	}
+	return args
+}
+
+// spawnTeardownHold starts the detached teardown child of slug, running exe with args in the hub's Bolt checkout, and returns its hold once the child answers that it holds the lock.
+// A child that answers busy returns the refusal lockPairTeardown returns for a held lock, after the child has exited; any other answer is an error naming it.
+// The lock file the child brings into being is recorded in rec, and the child is registered under the slug in the hub's owner record with the teardown role, which a teardown of the slug's pair spares.
+func spawnTeardownHold(rec *Mutations, l *lymcwd.Location, slug string, try bool, exe string, args []string, rerun string) (teardownHold, error) {
+	lockPath := TeardownLockPath(l.HubPath, slug)
+	existed := pathPresent(lockPath)
+	cmd := exec.Command(exe, args...)
+	cmd.Dir = BoltDir(l.HubPath)
+	proc.Detach(cmd)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		return nil, fmt.Errorf("start the teardown child of %q: %w", slug, err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, fmt.Errorf("start the teardown child of %q: %w", slug, err)
+	}
+	if err := cmd.Start(); err != nil {
+		logger.Warn("fabricengine: spawn teardown child failed", "exe", exe, "args", args, "error", err)
+		return nil, fmt.Errorf("start the teardown child of %q: %w", slug, err)
+	}
+	pid := cmd.Process.Pid
+	logger.Info("fabricengine: spawned teardown child", "exe", exe, "args", args, "dir", cmd.Dir, "pid", pid)
+	if err := runproc.Register(RunProcDir(filepath.Dir(cmd.Dir)), slug, runproc.ChildRecord(pid, runproc.RoleTeardown, args)); err != nil {
+		logger.Warn("fabricengine: teardown child not registered", "slug", slug, "pid", pid, "error", err)
+	}
+
+	line, readErr := bufio.NewReader(stdout).ReadString('\n')
+	if !existed && pathPresent(lockPath) {
+		rec.Append(KindFileWritten, lockPath, "")
+	}
+	answer := strings.TrimSpace(line)
+	if answer == teardownHeldSignal {
+		return &childHold{hubPath: l.HubPath, slug: slug, cmd: cmd, stdin: stdin}, nil
+	}
+	_ = stdin.Close()
+	_ = cmd.Wait()
+	if answer == teardownBusySignal {
+		return nil, teardownLockRefusal(slug, try, rerun)
+	}
+	if answer == "" && readErr != nil {
+		answer = readErr.Error()
+	}
+	return nil, fmt.Errorf("the teardown child of %q did not take the teardown lock: %s", slug, answer)
+}
+
+// RunTeardownChild is the body of the detached teardown child of slug in the hub at hubPath.
+// It takes the slug's teardown lock exclusive, by one attempt with try set and otherwise waiting at most wait, and writes one line to signal: held, busy, or the error that kept it from the lock.
+// Holding the lock, it reads the job from jobIn until the parent closes it, runs the job's remote steps, exempt from every pause when the job says its command was, and releases the lock;
+// an empty input is a parent that ended its teardown without remote steps, and releases the lock at once.
+// A failed remote step, or a job it cannot read, is logged and mailed to the hub's orch as one line naming the slug, the operation and the way forward.
+func RunTeardownChild(hubPath, slug string, try bool, wait time.Duration, jobIn io.Reader, signal io.Writer) error {
+	lockPath := TeardownLockPath(hubPath, slug)
+	held, acquired, err := takeTeardownChildLock(hubPath, slug, lockPath, try, wait)
+	if err != nil {
+		fmt.Fprintf(signal, "error %v\n", err)
+		return err
+	}
+	if !acquired {
+		fmt.Fprintln(signal, teardownBusySignal)
+		return nil
+	}
+	defer func() { _ = held.Release() }()
+	if _, err := fmt.Fprintln(signal, teardownHeldSignal); err != nil {
+		err = fmt.Errorf("answer the teardown parent of %q: %w", slug, err)
+		NoticeRemoteTeardownEnded(hubPath, slug, err.Error())
+		return err
+	}
+
+	raw, err := io.ReadAll(jobIn)
+	if err != nil {
+		err = fmt.Errorf("read the remote teardown job of %q: %w", slug, err)
+		noticeUnreadRemoteTeardown(hubPath, slug, err)
+		return err
+	}
+	if len(bytes.TrimSpace(raw)) == 0 {
+		logger.Info("fabricengine: the teardown ended with no remote steps", "slug", slug)
+		return nil
+	}
+	var job remoteTeardownJob
+	if err := json.Unmarshal(raw, &job); err != nil {
+		err = fmt.Errorf("read the remote teardown job of %q: %w", slug, err)
+		noticeUnreadRemoteTeardown(hubPath, slug, err)
+		return err
+	}
+	if job.ExemptPause {
+		defer pauserecord.SetGateExemptAll()()
+	}
+	l, err := lymcwd.ResolveWorktree(job.Worktree)
+	if err != nil {
+		out := remoteOutcome{err: fmt.Errorf("resolve the worktree %s: %w", job.Worktree, err)}
+		noticeRemoteTeardown(hubPath, job, out, "")
+		return out.err
+	}
+	out := runRemoteTeardown(NewMutations(hubPath), l, job, nil)
+	weftRoot := ""
+	if out.err != nil {
+		if root, rootErr := RecordsRepoRoot(l); rootErr == nil {
+			weftRoot = root
+		}
+	}
+	noticeRemoteTeardown(hubPath, job, out, weftRoot)
+	return nil
+}
+
+// takeTeardownChildLock takes the teardown lock at lockPath for the child, creating its directory first.
+func takeTeardownChildLock(hubPath, slug, lockPath string, try bool, wait time.Duration) (*lock.FileLock, bool, error) {
+	if err := ensureTeardownLockDir(hubPath, slug); err != nil {
+		return nil, false, err
+	}
+	if try {
+		return lock.TryAcquireWriteLock(lockPath)
+	}
+	return lock.AcquireWriteLockWithin(lockPath, wait)
+}
+
+// discardTaskBranchOnOrigin is the remote half of a discard: it reads the task branch's origin tip, archives the tips the discard must keep and deletes the branch on origin, leased on that tip.
+// job.TaskTip, the local tip the discard tagged and deleted, is archived only when origin's tip does not contain it.
+func discardTaskBranchOnOrigin(rec *Mutations, l *lymcwd.Location, job remoteTeardownJob, sleep func(time.Duration)) (res DiscardResult, err error) {
+	repoDir := l.WorktreePath()
+	originTip := ""
+	if _, urlErr := gitrepo.New(repoDir).RemoteURL(originRemoteName); urlErr == nil {
+		originTip, err = remoteHeadTip(repoDir, job.WarpBranch)
+		if err != nil {
+			return DiscardResult{}, err
+		}
+	}
+	if originTip == "" && job.TaskTip == "" {
+		return DiscardResult{}, nil
+	}
+	if originTip != "" {
+		if _, err := gitrepo.New(repoDir).FetchWithArgs(originRemoteName, "refs/heads/"+job.WarpBranch); err != nil {
+			return DiscardResult{}, fmt.Errorf("fetch task branch %q from %q: %w", job.WarpBranch, originRemoteName, err)
+		}
+	}
+
+	localTag, originTag, err := archiveDiscardedTips(rec, repoDir, job.Slug, job.TaskTip, originTip, sleep)
+	if err != nil {
+		return DiscardResult{}, err
+	}
+	for _, tag := range []string{localTag, originTag} {
+		if tag != "" && (len(res.ArchiveTags) == 0 || res.ArchiveTags[0] != tag) {
+			res.ArchiveTags = append(res.ArchiveTags, tag)
+		}
+	}
+	_, res.OriginDeleted, err = deleteArchivedTaskBranch(rec, repoDir, job.WarpBranch, "", originTag, originTip)
+	return res, err
+}
diff --git a/internal/fabricengine/remoteteardown_childhold_integration_test.go b/internal/fabricengine/remoteteardown_childhold_integration_test.go
new file mode 100644
index 00000000..4170ca59
--- /dev/null
+++ b/internal/fabricengine/remoteteardown_childhold_integration_test.go
@@ -0,0 +1,264 @@
+// remoteteardown_childhold_integration_test.go covers the parent's side of the teardown handover over a started stand-in child process.
+// It pins how spawnTeardownHold reads the child's answer and registers the child.
+// It pins what childHold.finish writes to the child's input, how it closes it, and whether it waits for the child.
+
+package fabricengine
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lymcwd"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// teardownStandInArg is the first argument that makes the test binary play the teardown child, as TestMain handles it.
+const teardownStandInArg = "teardown-standin"
+
+// runTeardownStandIn plays the teardown child of slug in the way mode names and returns the process's exit code.
+// It runs from the hub's Bolt checkout, as the real child does.
+// held creates the lock file, answers held and reads its input until it closes; busy answers busy; error answers an error line and fails; closed ends with no answer.
+func runTeardownStandIn(mode, slug string) int {
+	switch mode {
+	case "held":
+		workDir, err := os.Getwd()
+		if err != nil {
+			return 2
+		}
+		lockPath := TeardownLockPath(filepath.Dir(workDir), slug)
+		if err := os.MkdirAll(filepath.Dir(lockPath), 0o755); err != nil {
+			return 2
+		}
+		if err := os.WriteFile(lockPath, nil, 0o644); err != nil {
+			return 2
+		}
+		fmt.Println(teardownHeldSignal)
+		_, _ = io.Copy(io.Discard, os.Stdin)
+	case "busy":
+		fmt.Println(teardownBusySignal)
+	case "error":
+		fmt.Println("error the stand-in refuses")
+		return 1
+	}
+	return 0
+}
+
+// TestSpawnTeardownHold covers the process boundary of the handover over a stand-in child:
+// a held answer returns a hold, records the lock file the child made and registers the child under the slug with the teardown role;
+// a busy answer returns the refusal of its mode; an error line or a closed output returns an error naming the answer, and records nothing.
+func TestSpawnTeardownHold(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+	const slug = "pair"
+	const rerun = "re-run the stand-in command"
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatalf("os.Executable() error = %v; want nil", err)
+	}
+	tests := []struct {
+		name     string
+		mode     string
+		try      bool
+		wantHeld bool
+		wantErr  error
+		// wantInErr are the texts the returned error holds.
+		wantInErr []string
+	}{
+		{"HeldReturnsAHoldAndRecordsTheLock", "held", false, true, nil, nil},
+		{"BusyWithTryIsBusy", "busy", true, false, ErrPairBusy, nil},
+		{"BusyWithoutTryIsPushRunningAndNamesTheRerun", "busy", false, false, ErrPairPushRunning, []string{rerun}},
+		{"ErrorLineNamesTheAnswer", "error", false, false, nil, []string{"error the stand-in refuses"}},
+		{"ClosedOutputNamesTheReadError", "closed", false, false, nil, []string{"EOF"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			hub := t.TempDir()
+			if err := os.MkdirAll(BoltDir(hub), 0o755); err != nil {
+				t.Fatalf("create the Bolt checkout: %v", err)
+			}
+			rec := NewMutations(hub)
+
+			hold, err := spawnTeardownHold(rec, &lymcwd.Location{HubPath: hub}, slug, tt.try, exe, []string{teardownStandInArg, tt.mode, slug}, rerun)
+
+			if hold != nil {
+				t.Cleanup(func() { hold.finish(nil) })
+			}
+			if !tt.wantHeld {
+				if hold != nil || err == nil {
+					t.Fatalf("spawnTeardownHold() = (%v, %v); want a nil hold and an error", hold, err)
+				}
+				if tt.wantErr != nil && !errors.Is(err, tt.wantErr) {
+					t.Errorf("spawnTeardownHold() error = %v; want it to wrap %v", err, tt.wantErr)
+				}
+				for _, want := range tt.wantInErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("spawnTeardownHold() error = %q; want it to hold %q", err, want)
+					}
+				}
+				if got := rec.Snapshot().Len(); got != 0 {
+					t.Errorf("spawnTeardownHold() recorded %d mutations; want none", got)
+				}
+				return
+			}
+
+			if err != nil || hold == nil {
+				t.Fatalf("spawnTeardownHold() = (%v, %v); want a hold and nil", hold, err)
+			}
+			lockPath := TeardownLockPath(hub, slug)
+			want := []Mutation{{Kind: KindFileWritten, Target: hubRelativeTarget(hub, lockPath)}}
+			if got := rec.Snapshot().Entries(); len(got) != 1 || got[0] != want[0] {
+				t.Errorf("recorded mutations = %+v; want %+v", got, want)
+			}
+			records, err := runproc.List(RunProcDir(hub), slug)
+			if err != nil || len(records) != 1 || records[0].Role != runproc.RoleTeardown {
+				t.Errorf("runproc.List(%s) = (%+v, %v); want one record with role %q", slug, records, err, runproc.RoleTeardown)
+			}
+		})
+	}
+}
+
+// TestChildHold_Finish_NoticesAnUnwritableJob covers a job the child never receives: the one creel notice names the slug and the reason.
+// It installs the process's push notifier, so it is not parallel.
+func TestChildHold_Finish_NoticesAnUnwritableJob(t *testing.T) {
+	tiergate.Require(t, 1)
+	notices := recordNotices(t)
+	cmd := exec.Command("git", "--version")
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("start the stand-in child: %v", err)
+	}
+	job := remoteTeardownJob{Kind: remoteTeardownRemove, Slug: "pair"}
+
+	(&childHold{hubPath: "hub", slug: "pair", cmd: cmd, stdin: &recordingStdin{writeErr: errors.New("broken pipe")}}).finish(&job)
+
+	got := notices()
+	if len(got) != 1 {
+		t.Fatalf("finish() posted %d notices %q; want exactly one", len(got), got)
+	}
+	for _, want := range []string{"pair", "broken pipe", "way forward"} {
+		if !strings.Contains(got[0], want) {
+			t.Errorf("notice = %q; want it to hold %q", got[0], want)
+		}
+	}
+}
+
+// recordingStdin is a child's input that records what is written to it and whether it was closed, and fails every write when writeErr is set.
+type recordingStdin struct {
+	bytes.Buffer
+	writeErr error
+	closed   bool
+}
+
+func (s *recordingStdin) Write(p []byte) (int, error) {
+	if s.writeErr != nil {
+		return 0, s.writeErr
+	}
+	return s.Buffer.Write(p)
+}
+
+func (s *recordingStdin) Close() error {
+	s.closed = true
+	return nil
+}
+
+// TestChildHold_Finish covers the parent's side of the handover:
+// a job is written to the child and handed over at once, a job that cannot be written still closes the input, and no job closes the input and waits for the child to exit.
+func TestChildHold_Finish(t *testing.T) {
+	tiergate.Require(t, 1)
+	t.Parallel()
+	job := remoteTeardownJob{Kind: remoteTeardownRemove, Slug: "pair", Worktree: "/w", WeftTip: "abc"}
+	tests := []struct {
+		name          string
+		job           *remoteTeardownJob
+		writeErr      error
+		wantHandedOff bool
+		wantWritten   bool
+	}{
+		{"NilJobWaitsForTheChild", nil, nil, false, false},
+		{"JobIsWrittenAndHandedOff", &job, nil, true, true},
+		{"UnwritableJobStillHandsOff", &job, errors.New("broken pipe"), true, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			cmd := exec.Command("git", "--version")
+			if err := cmd.Start(); err != nil {
+				t.Fatalf("start the stand-in child: %v", err)
+			}
+			stdin := &recordingStdin{writeErr: tt.writeErr}
+
+			out := (&childHold{slug: "pair", cmd: cmd, stdin: stdin}).finish(tt.job)
+
+			if !stdin.closed {
+				t.Errorf("finish() left the child's input open; want it closed")
+			}
+			if out.handedOff != tt.wantHandedOff || out.ran {
+				t.Errorf("finish() outcome = (handedOff %v, ran %v); want (%v, false)", out.handedOff, out.ran, tt.wantHandedOff)
+			}
+			if tt.job == nil && cmd.ProcessState == nil {
+				t.Errorf("finish(nil) returned before the child was waited for")
+			}
+			if !tt.wantWritten {
+				if stdin.Len() != 0 {
+					t.Errorf("finish() wrote %q; want nothing", stdin.String())
+				}
+				return
+			}
+			var written remoteTeardownJob
+			if err := json.Unmarshal(stdin.Bytes(), &written); err != nil || written != job {
+				t.Errorf("finish() wrote %q; want the JSON of %+v (decode error %v)", stdin.String(), job, err)
+			}
+		})
+	}
+}
+
+// TestChildHold_Finish_CarriesThePauseExemption covers the exemption the job carries to the child:
+// set while this process's gate exempts every pause, clear otherwise, and never set on the caller's own job.
+// It installs a process-wide gate, so neither the test nor its rows are parallel.
+func TestChildHold_Finish_CarriesThePauseExemption(t *testing.T) {
+	tiergate.Require(t, 1)
+	tests := []struct {
+		name   string
+		exempt bool
+	}{
+		{"ExemptGate", true},
+		{"PlainGate", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Cleanup(pauserecord.InstallGate(pauserecord.Gate{}))
+			if tt.exempt {
+				t.Cleanup(pauserecord.SetGateExemptAll())
+			}
+			cmd := exec.Command("git", "--version")
+			if err := cmd.Start(); err != nil {
+				t.Fatalf("start the stand-in child: %v", err)
+			}
+			stdin := &recordingStdin{}
+			job := remoteTeardownJob{Kind: remoteTeardownRemove, Slug: "pair"}
+
+			(&childHold{slug: "pair", cmd: cmd, stdin: stdin}).finish(&job)
+
+			var written remoteTeardownJob
+			if err := json.Unmarshal(stdin.Bytes(), &written); err != nil {
+				t.Fatalf("decode the handed job %q: %v", stdin.String(), err)
+			}
+			if written.ExemptPause != tt.exempt {
+				t.Errorf("handed job ExemptPause = %v; want %v", written.ExemptPause, tt.exempt)
+			}
+			if job.ExemptPause {
+				t.Errorf("finish() set ExemptPause on the caller's job; want it left alone")
+			}
+		})
+	}
+}
diff --git a/internal/fabricengine/remoteteardown_integration_test.go b/internal/fabricengine/remoteteardown_integration_test.go
new file mode 100644
index 00000000..9229feca
--- /dev/null
+++ b/internal/fabricengine/remoteteardown_integration_test.go
@@ -0,0 +1,133 @@
+// remoteteardown_integration_test.go covers RunTeardownChild running a removal's remote job against a real hub:
+// the weft branch's tip, then the archive tag, then the leased delete of the branch on origin, with the teardown lock held to the last step and released after it.
+//
+// Every hub is built through hubforge.CopyHub, with the hub's RecordsBare as the weft origin.
+// Package fabricengine_test; shares the single TestMain in testmain_test.go.
+
+package fabricengine_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitexec"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// TestRunTeardownChild_RunsTheRemoteStepsInOrderUnderTheLock covers the detached half of a removal over a weft tip origin lacks.
+// The child pushes the tip, tags it and then deletes the branch on origin, holding the teardown lock at each step and releasing it on return.
+// A failed archive tag stops the later steps, leaves the pushed branch in place, mails one notice and still releases the lock.
+// The rows set package-level hooks and install the process's push notifier, so neither the test nor its rows are parallel.
+func TestRunTeardownChild_RunsTheRemoteStepsInOrderUnderTheLock(t *testing.T) {
+	tiergate.Require(t, 1)
+
+	tests := []struct {
+		name                   string
+		tagPushError           error
+		wantEvents             []string
+		wantWeftBranchOnOrigin bool
+		wantNotices            int
+	}{
+		{"ArchiveThenLeasedDelete", nil, []string{"tag", "delete"}, false, 0},
+		{"FailedArchiveSkipsTheLaterSteps", errors.New("tag push refused"), []string{"tag"}, true, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			const slug = "child-order"
+			h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+			l := h.Location
+			hubforge.AddPairWith(t, h, slug, fabricengine.AddOptions{})
+			cfg, err := fabricengine.LoadConfig(fabricengine.ConfigDirs(l))
+			if err != nil {
+				t.Fatalf("LoadConfig() error = %v", err)
+			}
+			weftBranch := fabricengine.RecordsBranchName(cfg.BranchPrefix + slug)
+			tip := gitkit.CommitFile(t, h.PairRecordsSibling(slug), "_lym/record.txt", "run record\n", "record")
+			wantTag := wantArchiveTag(slug, tip)
+			// A removal hands the remote steps over after its local teardown, so the sibling worktree and the local branch are gone when the child runs.
+			weftRoot := mustRecordsRepoRoot(t, l)
+			gitkit.MustRun(t, weftRoot, "git", "worktree", "remove", "--force", h.PairRecordsSibling(slug))
+			gitkit.MustRun(t, weftRoot, "git", "branch", "-D", weftBranch)
+			lockPath := fabricengine.TeardownLockPath(l.HubPath, slug)
+
+			lockHeld := func() bool {
+				held, acquired, err := lock.TryAcquireReadLock(lockPath)
+				if err != nil {
+					t.Errorf("TryAcquireReadLock() error = %v", err)
+				}
+				if acquired {
+					_ = held.Release()
+				}
+				return !acquired
+			}
+			var notices []string
+			t.Cleanup(fabricengine.InstallPushNotifier(func(hubPath, line string) (bool, error) {
+				notices = append(notices, line)
+				return true, nil
+			}))
+			var events []string
+			fabricengine.SetArchiveTagPushHookForTest(t, func(tagRef string) error {
+				events = append(events, "tag")
+				if got := gitkit.RevParse(t, h.RecordsBare, weftBranch); got != tip {
+					t.Errorf("origin weft branch at the tag push = %s; want the tip %s pushed first", got, tip)
+				}
+				if !lockHeld() {
+					t.Errorf("teardown lock free at the tag push; want it held")
+				}
+				return tt.tagPushError
+			})
+			fabricengine.SetRemoveBeforeWeftDeleteHookForTest(t, func() {
+				events = append(events, "delete")
+				if got := tagTargetAt(t, h.RecordsBare, wantTag); got != tip {
+					t.Errorf("origin tag %s at the delete points at %q; want the tip %s pushed first", wantTag, got, tip)
+				}
+				if !lockHeld() {
+					t.Errorf("teardown lock free at the last remote step; want it held")
+				}
+			})
+
+			job, err := json.Marshal(map[string]any{
+				"kind":                  "remove",
+				"slug":                  slug,
+				"worktree":              l.WorktreePath(),
+				"branch_prefix":         cfg.BranchPrefix,
+				"weft_branch":           weftBranch,
+				"weft_tip":              tip,
+				"delete_weft_on_origin": true,
+			})
+			if err != nil {
+				t.Fatalf("marshal the job: %v", err)
+			}
+			var signal strings.Builder
+			if err := fabricengine.RunTeardownChild(l.HubPath, slug, false, time.Second, bytes.NewReader(job), &signal); err != nil {
+				t.Fatalf("RunTeardownChild() error = %v; want nil", err)
+			}
+
+			if !slices.Equal(events, tt.wantEvents) {
+				t.Errorf("remote steps = %v; want %v", events, tt.wantEvents)
+			}
+			onOrigin, err := gitexec.Run([]string{"for-each-ref", "--format=%(objectname)", "refs/heads/" + weftBranch}, h.RecordsBare)
+			if err != nil {
+				t.Fatalf("read the weft branch on origin: %v", err)
+			}
+			if got := strings.TrimSpace(onOrigin); (got != "") != tt.wantWeftBranchOnOrigin || (tt.wantWeftBranchOnOrigin && got != tip) {
+				t.Errorf("origin weft branch = %q; want present %v at %s", got, tt.wantWeftBranchOnOrigin, tip)
+			}
+			if lockHeld() {
+				t.Errorf("teardown lock still held after RunTeardownChild returned; want it released")
+			}
+			if len(notices) != tt.wantNotices || (tt.wantNotices > 0 && !strings.Contains(notices[0], slug)) {
+				t.Errorf("notices = %q; want %d, naming %q", notices, tt.wantNotices, slug)
+			}
+		})
+	}
+}
diff --git a/internal/fabricengine/remoteteardown_test.go b/internal/fabricengine/remoteteardown_test.go
new file mode 100644
index 00000000..e68a6329
--- /dev/null
+++ b/internal/fabricengine/remoteteardown_test.go
@@ -0,0 +1,271 @@
+// remoteteardown_test.go covers the teardown child's seams that need no real hub:
+// RunTeardownChild's hold of the teardown lock and its answer to the parent, and the notice of a failed remote step.
+
+package fabricengine
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/testkit/tiergate"
+)
+
+// recordNotices installs a push notifier that records every line it is given until the test ends, and returns a reader of those lines.
+// It changes process-global state, so the calling test must not be parallel.
+func recordNotices(t *testing.T) (lines func() []string) {
+	t.Helper()
+	var got []string
+	restore := InstallPushNotifier(func(hubPath, line string) (bool, error) {
+		got = append(got, line)
+		return true, nil
+	})
+	t.Cleanup(restore)
+	return func() []string { return slices.Clone(got) }
+}
+
+// TestNoticeRemoteTeardown covers the log line and the one creel notice of a failed remote step:
+// each carries the slug, the operation and the way forward, a job reports every failed step in one notice, and a kept branch or a clean outcome mails nothing.
+// The rows install the process's push notifier, so neither the test nor its rows are parallel.
+func TestNoticeRemoteTeardown(t *testing.T) {
+	tiergate.Require(t, 0)
+	const slug = "pair"
+	worktree := t.TempDir()
+	weftTip := strings.Repeat("a", 40)
+	taskTip := strings.Repeat("b", 40)
+	weftTagPush := "push " + originRemoteName + " refs/tags/" + ArchiveTagName(slug, weftTip)
+	taskTagPush := "push " + originRemoteName + " refs/tags/" + ArchiveTagName(slug, taskTip)
+	removeAgain := "`lym fabric remove " + slug + " --remote`"
+	cleanupAgain := "`lym fabric cleanup --apply --remote`"
+	discardAgain := "run the command that discarded the task branch again"
+	removeJob := remoteTeardownJob{Kind: remoteTeardownRemove, Slug: slug, Worktree: worktree}
+	cleanupJob := remoteTeardownJob{Kind: remoteTeardownCleanup, Slug: slug, Worktree: worktree}
+	discardJob := remoteTeardownJob{Kind: remoteTeardownDiscard, Slug: slug, Worktree: worktree}
+	withWeftTip := func(job remoteTeardownJob) remoteTeardownJob {
+		job.WeftTip = weftTip
+		return job
+	}
+	archiveFailure := remoteOutcome{err: errors.New("tag push refused")}
+	weftDeleteFailure := remoteOutcome{weft: CleanupBranchEntry{RemoteError: "lease lost"}}
+	taskDeleteFailure := remoteOutcome{taskKept: "ls-remote refused", taskFailed: true}
+
+	tests := []struct {
+		name string
+		job  remoteTeardownJob
+		out  remoteOutcome
+		// weftRoot is the records repository root the notice may name; empty means it could not be found.
+		weftRoot string
+		// wantInLine are the texts the one notice holds; none means no notice at all.
+		wantInLine []string
+		wantAbsent []string
+	}{
+		{"RemoveArchiveFailureWithWeftTip", withWeftTip(removeJob), archiveFailure, "/weft", []string{slug, "the archive of its records", "tag push refused", "git -C /weft " + weftTagPush, "when origin still holds a branch of the pair", removeAgain}, nil},
+		{"RemoveArchiveFailureWithWeftTipAndNoWeftRoot", withWeftTip(removeJob), archiveFailure, "", []string{slug, "the archive of its records", "tag push refused", "when origin still holds a branch of the pair", removeAgain}, []string{"refs/tags/", "git -C"}},
+		{"RemoveArchiveFailureWithoutWeftTip", removeJob, archiveFailure, "/weft", []string{slug, "the archive of its records", "tag push refused", removeAgain}, []string{"refs/tags/"}},
+		{"CleanupArchiveFailureWithWeftTip", withWeftTip(cleanupJob), archiveFailure, "/weft", []string{slug, weftTagPush, cleanupAgain}, []string{"lym fabric remove"}},
+		{"RecordsRepositoryLookupFailure", withWeftTip(removeJob), remoteOutcome{err: errors.New("resolve weft repo root: no records repository"), weftRootErr: errors.New("resolve weft repo root: no records repository")}, "", []string{slug, "the lookup of its records repository", "no records repository", removeAgain}, []string{"the archive of its records", "refs/tags/"}},
+		{"DiscardFailureWithTaskTip", func() remoteTeardownJob { job := discardJob; job.TaskTip = taskTip; return job }(), archiveFailure, "", []string{slug, "the archive and origin delete of its task branch", taskTagPush, discardAgain}, nil},
+		{"DiscardFailureWithoutTaskTip", discardJob, archiveFailure, "", []string{slug, "the archive and origin delete of its task branch", discardAgain}, []string{"refs/tags/"}},
+		{"WeftDeleteFailure", removeJob, weftDeleteFailure, "", []string{slug, "the delete of its records branch on origin", "lease lost", removeAgain}, nil},
+		{"CleanupWeftDeleteFailure", cleanupJob, weftDeleteFailure, "", []string{slug, "lease lost", cleanupAgain}, []string{"lym fabric remove"}},
+		{"TaskBranchDeleteFailure", removeJob, taskDeleteFailure, "", []string{slug, "the delete of its task branch on origin", "ls-remote refused", removeAgain}, nil},
+		{"WeftAndTaskDeleteFailuresShareOneNotice", removeJob, remoteOutcome{weft: weftDeleteFailure.weft, taskKept: taskDeleteFailure.taskKept, taskFailed: true}, "",
+			[]string{"the delete of its records branch on origin", "lease lost", "the delete of its task branch on origin", "ls-remote refused"}, nil},
+		{"TaskBranchKeptIsNoFailure", removeJob, remoteOutcome{taskKept: "3 commit(s) not landed"}, "", nil, nil},
+		{"WeftBranchKeptIsNoFailure", removeJob, remoteOutcome{weft: CleanupBranchEntry{RemoteKeptReason: "moved since the archive"}}, "", nil, nil},
+		{"CleanOutcome", removeJob, remoteOutcome{}, "", nil, nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			notices := recordNotices(t)
+
+			noticeRemoteTeardown("hub", tt.job, tt.out, tt.weftRoot)
+
+			got := notices()
+			if len(tt.wantInLine) == 0 {
+				if len(got) != 0 {
+					t.Errorf("noticeRemoteTeardown() posted %q; want no notice", got)
+				}
+				return
+			}
+			if len(got) != 1 {
+				t.Fatalf("noticeRemoteTeardown() posted %d notices %q; want exactly one", len(got), got)
+			}
+			for _, want := range tt.wantInLine {
+				if !strings.Contains(got[0], want) {
+					t.Errorf("notice = %q; want it to hold %q", got[0], want)
+				}
+			}
+			for _, absent := range tt.wantAbsent {
+				if strings.Contains(got[0], absent) {
+					t.Errorf("notice = %q; want it free of %q", got[0], absent)
+				}
+			}
+		})
+	}
+
+	t.Run("NoNotifierInstalled", func(t *testing.T) {
+		previous := installedPushNotifier.Swap(nil)
+		t.Cleanup(func() { installedPushNotifier.Store(previous) })
+
+		noticeRemoteTeardown("hub", removeJob, archiveFailure, "")
+	})
+}
+
+// TestNoticeRemoteTeardownEnded covers the notice of a teardown that ended before its last step:
+// it carries the slug, the reason and a way forward naming the command of every job kind.
+// The rows install the process's push notifier, so neither the test nor its rows are parallel.
+func TestNoticeRemoteTeardownEnded(t *testing.T) {
+	tiergate.Require(t, 0)
+	const slug = "pair"
+	tests := []struct {
+		name   string
+		reason string
+	}{
+		{"EndedBySignal", "the child was ended by the signal terminated"},
+		{"JobNotHandedOver", "its job could not be handed to the child: broken pipe"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			notices := recordNotices(t)
+
+			NoticeRemoteTeardownEnded("hub", slug, tt.reason)
+
+			got := notices()
+			if len(got) != 1 {
+				t.Fatalf("NoticeRemoteTeardownEnded() posted %d notices %q; want exactly one", len(got), got)
+			}
+			for _, want := range []string{slug, "ended before its last step", tt.reason, "`lym fabric remove " + slug + " --remote`", "`lym fabric cleanup --apply --remote`", "discarded the task branch"} {
+				if !strings.Contains(got[0], want) {
+					t.Errorf("notice = %q; want it to hold %q", got[0], want)
+				}
+			}
+		})
+	}
+}
+
+// TestRunTeardownChild_NoticesAnUnreadableJob covers a job the child cannot decode: the remote steps never run, the error is returned, and one notice names the slug and the way forward.
+// It installs the process's push notifier, so it is not parallel.
+func TestRunTeardownChild_NoticesAnUnreadableJob(t *testing.T) {
+	tiergate.Require(t, 0)
+	const slug = "pair"
+	notices := recordNotices(t)
+
+	var signal strings.Builder
+	if err := RunTeardownChild(t.TempDir(), slug, false, time.Second, strings.NewReader("{not json"), &signal); err == nil {
+		t.Fatalf("RunTeardownChild() error = nil; want the decode failure")
+	}
+
+	got := notices()
+	if len(got) != 1 {
+		t.Fatalf("notices = %q; want exactly one", got)
+	}
+	for _, want := range []string{slug, "reading its job", "way forward", "`lym fabric remove " + slug + " --remote`", "`lym fabric cleanup --apply --remote`", "discarded the task branch"} {
+		if !strings.Contains(got[0], want) {
+			t.Errorf("notice = %q; want it to hold %q", got[0], want)
+		}
+	}
+}
+
+// TestRunTeardownChild_HoldsTheLockUntilItsInputCloses covers the handover's lock.
+// The child answers held and keeps the lock exclusive while the parent still writes.
+// It releases the lock once the parent closes the input with no job.
+func TestRunTeardownChild_HoldsTheLockUntilItsInputCloses(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	const slug = "pair"
+	hub := t.TempDir()
+	jobReader, jobWriter := io.Pipe()
+	signalReader, signalWriter := io.Pipe()
+
+	done := make(chan error, 1)
+	go func() {
+		err := RunTeardownChild(hub, slug, false, time.Second, jobReader, signalWriter)
+		_ = signalWriter.Close()
+		done <- err
+	}()
+
+	answer, err := bufio.NewReader(signalReader).ReadString('\n')
+	if err != nil || answer != teardownHeldSignal+"\n" {
+		t.Fatalf("child answer = (%q, %v); want %q", answer, err, teardownHeldSignal)
+	}
+	if held, acquired, err := lock.TryAcquireReadLock(TeardownLockPath(hub, slug)); err != nil || acquired {
+		if acquired {
+			_ = held.Release()
+		}
+		t.Errorf("TryAcquireReadLock while the child holds the lock = (%v, %v); want (false, nil)", acquired, err)
+	}
+
+	_ = jobWriter.Close()
+	if err := <-done; err != nil {
+		t.Fatalf("RunTeardownChild() error = %v; want nil", err)
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(TeardownLockPath(hub, slug))
+	if err != nil || !acquired {
+		t.Fatalf("TryAcquireWriteLock after the child ended = (%v, %v); want (true, nil)", acquired, err)
+	}
+	_ = held.Release()
+}
+
+// TestRunTeardownChild_AnswersBusyOnAHeldLock covers a child that meets the lock held: it answers busy, reads no job and leaves the holder's lock alone.
+func TestRunTeardownChild_AnswersBusyOnAHeldLock(t *testing.T) {
+	tiergate.Require(t, 0)
+	t.Parallel()
+	tests := []struct {
+		name string
+		try  bool
+	}{
