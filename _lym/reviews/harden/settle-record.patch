+			if got := refLines(t, h.CodeBare, "%(objectname)", namespaceCodeTagsPrefix+tag); !slices.Equal(got, []string{tip}) {
+				t.Errorf("origin's archive tag under %s = %v; want one at %s", namespaceCodeTagsPrefix, got, tip)
