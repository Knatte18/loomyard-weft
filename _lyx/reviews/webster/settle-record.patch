+// runlog.go keeps one diagnostic record and log per tier run under the gate directory, and renders and finds the tier timeout and tier summary lines a site reads from a log.
+
+package gateslot
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
