new file mode 100644
index 00000000..019084e1
--- /dev/null
+++ b/internal/gatecli/tierrun.go
@@ -0,0 +1,203 @@
+// tierrun.go runs one tier whose gate slots are already held: its prebuild, its command per invocation, its counter, its timeout and the record of how it ended.
+
+package gatecli
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/verifyrun"
+)
+
+// tierResult is how one tier run ended.
+type tierResult struct {
+	// record holds what the tier run itself knows; the caller adds the worktree, slug, tier list and wait start before it writes the record.
+	record gateslot.RunRecord
+	// log is the run's whole output as the counter passed it on, with the timeout line when the tier timed out.
+	log []byte
+	// refusal is set instead of an outcome when the tier could not run at all: no process started, a prebuild failed or a command could not be rendered.
+	refusal string
+}
+
+// runTier runs the tier of run in ctx with its slots held: it prebuilds `lyx` when the tier asks, then runs each invocation's command through the platform shell as a tied child, stopping at the first non-zero exit.
+// The tier's timeout_min bounds the prebuild and every invocation together, counted from the call; a tier that outlives it has its process tree killed, exits 1 and prints and logs gateslot.TierTimeoutLine.
+// env is the environment every command gets, before the tier's own env is added.
+// A run with no invocation passes at once with nothing discovered.
+func runTier(ctx context.Context, out io.Writer, run tierRun, env []string, request testRequest) tierResult {
+	started := time.Now()
+	timeout := time.Duration(run.tier.TimeoutMin) * request.timeoutUnit
+	record := gateslot.RunRecord{Tier: run.number, ScopeForm: run.scopeForm, Slots: run.tier.Slots, GuardStep: run.guardStep, Start: started}
+
+	var logBuffer bytes.Buffer
+	counter, err := newCounter(run.tier.Counter, io.MultiWriter(out, &logBuffer))
+	if err != nil {
+		return tierResult{refusal: fmt.Sprintf("gate test: %v; way forward: fix the counter of %s with \"lyx config gate\" from the prime%s", err, tierName(run.number), roleClause)}
+	}
+
+	tierCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
+	exit, commands, refusal := runInvocations(tierCtx, run, counter, slices.Concat(env, renderTierEnv(run.tier)), request)
+	if refusal != "" {
+		return tierResult{refusal: refusal}
+	}
+	if err := counter.Flush(); err != nil {
+		logger.Warn("gate test: could not flush the tier's output", "tier", tierName(run.number), "cause", err)
+	}
+
+	timedOut := ctx.Err() == nil && errors.Is(tierCtx.Err(), context.DeadlineExceeded) && exit != 0
+	if timedOut {
+		exit = 1
+		line := gateslot.TierTimeoutLine(tierName(run.number), timeout)
+		logBuffer.WriteString(line + "\n")
+		printLine(request.stderr, line)
+	}
+
+	counts := counter.Counts()
+	end := time.Now()
+	record.Command = strings.Join(commands, "; ")
+	if len(run.invocations) > 0 {
+		record.RunDir = resolveRunDir(request.root, run.invocations[0].dir)
+	}
+	record.End = end
+	record.WallSec = end.Sub(started).Seconds()
+	record.ExitCode = exit
+	record.TimedOut = timedOut
+	record.Outcome = "passed"
+	if exit != 0 {
+		record.Outcome = "failed"
+	}
+	record.Discovered, record.Passed, record.Failed, record.Skipped = counts.discovered, counts.passed, counts.failed, counts.skipped
+	return tierResult{record: record, log: logBuffer.Bytes()}
+}
+
+// runInvocations prebuilds `lyx` when the tier asks, then runs each invocation of run in order under ctx, stopping at the first non-zero exit.
+// It returns that exit code, the commands it rendered and a refusal when a command could not be run at all.
+func runInvocations(ctx context.Context, run tierRun, counter counter, env []string, request testRequest) (exit int, commands []string, refusal string) {
+	if len(run.invocations) == 0 {
+		return 0, nil, ""
+	}
+	if run.tier.PrebuiltLyx {
+		bin, cleanup, err := prebuildLyx(ctx, request.goBinary, request.root, run.tier.Parallel, request.prebuiltStore)
+		if err != nil {
+			if ctx.Err() != nil {
+				return 1, nil, ""
+			}
+			return 0, nil, fmt.Sprintf("gate test: cannot build lyx for the tier: %v; way forward: fix the build, then re-run the same command", err)
+		}
+		defer cleanup()
+		if bin != "" {
+			env = append(slices.Clone(env), gateslot.PrebuiltLyxEnv+"="+bin)
+		}
+	}
+
+	shellName, shellFlag := verifyrun.ShellFor(runtime.GOOS)
+	for _, invocation := range run.invocations {
+		command, err := renderTierCommand(run.tier, invocation.targets, run.args)
+		if err != nil {
+			return 0, commands, err.Error()
+		}
+		commands = append(commands, command)
+		dir := resolveRunDir(request.root, invocation.dir)
+
+		cmd := exec.CommandContext(ctx, shellName, shellFlag, command)
+		cmd.Dir = dir
+		cmd.Env = env
+		cmd.Stdout = counter
+		cmd.Stderr = counter
+		logger.Info("gate test: spawning tier command", "tier", tierName(run.number), "dir", dir, "command", command)
+		watchCtx, stopWatching := context.WithCancel(ctx)
+		var watchdogDone sync.WaitGroup
+		runErr := runTiedChild(cmd, func(pid int) {
+			if !request.watching {
+				return
+			}
+			watchdogDone.Add(1)
+			go func() {
+				defer watchdogDone.Done()
+				newWatchdog(request.busyQuit, request.samplePeriod, request.stderr).run(watchCtx, pid)
+			}()
+		})
+		stopWatching()
+		watchdogDone.Wait()
+		exit = exitCodeOf(runErr)
+		logger.Info("gate test: tier command ended", "tier", tierName(run.number), "exit", exit, "error", runErr)
+		if cmd.Process == nil && ctx.Err() == nil {
+			return 0, commands, fmt.Sprintf("gate test: could not start the shell for %s in %s: %v; way forward: make the tier's dir an existing directory and put the platform shell on PATH, then re-run the same command", tierName(run.number), dir, runErr)
+		}
+		if exit != 0 || ctx.Err() != nil {
+			return exit, commands, ""
+		}
+	}
+	return 0, commands, ""
+}
+
+// runGuardStep runs the guard step of cfg over the guard tests guards names for the module at moduleDir, with its slots already held: one run of guard_tier's command with the guard packages as {targets}, and `-run '^(<names>)$'` after the call's own words as {args}.
+func runGuardStep(ctx context.Context, out io.Writer, cfg gateslot.Config, moduleDir string, guards map[string][]string, env []string, request testRequest) tierResult {
+	tier, err := cfg.Tier(cfg.GuardTier)
+	if err != nil {
+		return tierResult{refusal: fmt.Sprintf("gate test: guard_tier: %v", err)}
+	}
+	packages, names := guardPackages(guards)
+	run := tierRun{
+		number:      cfg.GuardTier,
+		tier:        tier,
+		scopeForm:   scopeGuard,
+		invocations: []invocation{{dir: moduleDir, targets: packages}},
+		args:        append(slices.Clone(request.args), "-run", "^("+strings.Join(names, "|")+")$"),
+		guardStep:   true,
+	}
+	return runTier(ctx, out, run, env, request)
+}
+
+// guardPackages returns the module-relative package arguments of the directories that hold a guard test, in directory order, and the sorted guard test names of them all.
+func guardPackages(guards map[string][]string) (packages, names []string) {
+	var dirs []string
+	for dir, dirNames := range guards {
+		if len(dirNames) > 0 {
+			dirs = append(dirs, dir)
+			names = append(names, dirNames...)
+		}
+	}
+	sort.Strings(dirs)
+	sort.Strings(names)
+	for _, dir := range dirs {
+		if dir == "." {
+			packages = append(packages, ".")
+			continue
+		}
+		packages = append(packages, "./"+dir)
+	}
+	return packages, slices.Compact(names)
+}
+
+// resolveRunDir returns dir as an absolute path: itself when absolute, else joined to root.
+func resolveRunDir(root, dir string) string {
+	if filepath.IsAbs(dir) {
+		return dir
+	}
+	return filepath.Join(root, dir)
+}
+
+// printLine writes line and a newline to w, doing nothing for a nil w.
+func printLine(w io.Writer, line string) {
+	if w == nil {
+		return
+	}
+	if _, err := io.WriteString(w, line+"\n"); err != nil {
+		logger.Warn("gate test: could not write a line to stderr", "cause", err)
+	}
+}
diff --git a/internal/gatecli/tiers.go b/internal/gatecli/tiers.go
new file mode 100644
index 00000000..6b1899ce
--- /dev/null
+++ b/internal/gatecli/tiers.go
@@ -0,0 +1,238 @@
+// tiers.go plans the tier runs of one `lyx gate test` call from the loaded gate config and the request, and renders a tier's command.
+
+package gatecli
+
+import (
+	"fmt"
+	"runtime"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/verifyrun"
+)
+
+// The scope forms a tier run is labelled with in its summary line and run record.
+const (
+	scopeTargets = "targets"
+	scopeAll     = "all"
+	scopeGuard   = "guard"
+)
+
+// roleClause closes every refusal that sends the caller to `lyx config gate`: the steps need the prime, so any other session reports and the orch takes them.
+const roleClause = "; a session that is not the prime takes none of these steps; it reports status: FAILED and the orch runs them"
+
+// invocation is one run of a tier's command: the directory it runs in and the words its {targets} takes.
+type invocation struct {
+	// dir is the run directory, relative to the worktree root unless absolute.
+	dir     string
+	targets []string
+}
+
+// tierRun is one tier a call runs: the tier, the label of its scope and the invocations of its command.
+// The guard step is the last tierRun of a plan, and its targets are filled when the guard scan has run.
+type tierRun struct {
+	number int
+	tier   gateslot.Tier
+	// scopeForm labels the run in its summary line and record.
+	scopeForm   string
+	invocations []invocation
+	// args are the words that fill the command's {args}.
+	args []string
+	// ignoresTargets is set when explicit targets were given and the command holds no {targets}, so it runs whole.
+	ignoresTargets bool
+	// guardStep marks the run of guard_tier over the guard tests.
+	guardStep bool
+}
+
+// tierName returns the gate.yaml key and the label of tier number.
+func tierName(number int) string {
+	return "tier" + strconv.Itoa(number)
+}
+
+// planTierRuns builds the run list of request over cfg and the scope sc without touching the disk:
+// the listed tiers ascending with the tiers another listed tier covers dropped, each over its share of the scope, then the guard step when --guards or the scope's form asks for one the listed tiers did not already run whole.
+// A covered tier is named on request.stderr when it has one.
+// It refuses, naming `lyx config gate`, a hub with no tier0, an undeclared tier, a dangling covers entry or guard_tier, words after `--` for a tier whose command lacks {args}, a guard tier whose command lacks {targets} or {args}, and --guards under the none scoper.
+func planTierRuns(cfg gateslot.Config, request testRequest, sc scope) ([]tierRun, error) {
+	if _, err := cfg.Tier(0); err != nil {
+		return nil, fmt.Errorf("gate test: %w", err)
+	}
+	numbers := listedTiers(request.tiers)
+	tiers := make(map[int]gateslot.Tier, len(numbers))
+	for _, number := range numbers {
+		tier, err := cfg.Tier(number)
+		if err != nil {
+			return nil, fmt.Errorf("gate test: %w", err)
+		}
+		tiers[number] = tier
+		for _, covered := range tier.Covers {
+			if _, err := cfg.Tier(covered); err != nil {
+				return nil, fmt.Errorf("gate test: %s covers %s: %w", tierName(number), tierName(covered), err)
+			}
+		}
+	}
+
+	kept := dropCovered(numbers, tiers, request)
+
+	runs := make([]tierRun, 0, len(kept)+1)
+	for _, number := range kept {
+		tier := tiers[number]
+		if len(request.args) > 0 && !strings.Contains(tier.Command, "{args}") {
+			return nil, configRefusal("words after \"--\" were given, but the command of %s holds no {args}", tierName(number))
+		}
+		invocations, ignoresTargets := scopeInvocations(tier, request, sc)
+		runs = append(runs, tierRun{
+			number:         number,
+			tier:           tier,
+			scopeForm:      sc.form,
+			invocations:    invocations,
+			args:           request.args,
+			ignoresTargets: ignoresTargets,
+		})
+	}
+
+	if !request.guards && !sc.guardStep {
+		return runs, nil
+	}
+	if cfg.Scoper != "go" {
+		return nil, configRefusal("--guards needs the go scoper to find the guard tests, but gate.yaml's scoper is %q; drop --guards, or set scoper to go", cfg.Scoper)
+	}
+	guardTier, err := cfg.Tier(cfg.GuardTier)
+	if err != nil {
+		return nil, fmt.Errorf("gate test: guard_tier: %w", err)
+	}
+	if sc.whole && ranWhole(runs, cfg.GuardTier) {
+		return runs, nil
+	}
+	if !strings.Contains(guardTier.Command, "{targets}") || !strings.Contains(guardTier.Command, "{args}") {
+		return nil, configRefusal("the guard step runs the command of %s, which must hold {targets} and {args}", tierName(cfg.GuardTier))
+	}
+	dir := guardTier.Dir
+	switch {
+	case sc.guardDir != "":
+		dir = sc.guardDir
+	case request.dir != "":
+		dir = request.dir
+	}
+	return append(runs, tierRun{
+		number:      cfg.GuardTier,
+		tier:        guardTier,
+		scopeForm:   scopeGuard,
+		invocations: []invocation{{dir: dir}},
+		guardStep:   true,
+	}), nil
+}
+
+// scopeInvocations returns the invocations one tier makes over sc, and whether its command ignores the scope's narrowing.
+// Explicit targets run in the -C directory, else the tier's dir; a whole scope runs the tier's all_targets, split at spaces, in the tier's dir.
+// A narrower scope runs the tier once per module in that module's directory, and the empty scope makes none.
+// A command without {targets} runs once, whole, under explicit targets and under a non-empty narrower scope.
+func scopeInvocations(tier gateslot.Tier, request testRequest, sc scope) (invocations []invocation, ignoresTargets bool) {
+	runsWhole := []invocation{{dir: tier.Dir, targets: strings.Fields(tier.AllTargets)}}
+	switch {
+	case sc.form == scopeTargets:
+		dir := tier.Dir
+		if request.dir != "" {
+			dir = request.dir
+		}
+		return []invocation{{dir: dir, targets: request.targets}}, !strings.Contains(tier.Command, "{targets}")
+	case sc.whole:
+		return runsWhole, false
+	case len(sc.modules) == 0:
+		return nil, false
+	case !strings.Contains(tier.Command, "{targets}"):
+		return runsWhole, true
+	}
+	for _, module := range sc.modules {
+		invocations = append(invocations, invocation{dir: module.dir, targets: module.targets})
+	}
+	return invocations, false
+}
+
+// configRefusal returns a refusal that sends the caller to `lyx config gate` and closes with the role clause.
+func configRefusal(format string, args ...any) error {
+	return fmt.Errorf("gate test: %s; way forward: fix it with \"lyx config gate\" from the prime%s", fmt.Sprintf(format, args...), roleClause)
+}
+
+// listedTiers returns the requested tier numbers ascending and without repeats, tier0 when none was requested.
+func listedTiers(requested []int) []int {
+	if len(requested) == 0 {
+		return []int{0}
+	}
+	numbers := slices.Clone(requested)
+	sort.Ints(numbers)
+	return slices.Compact(numbers)
+}
+
+// dropCovered returns the tier numbers of numbers that no higher kept tier covers, ascending, naming each dropped tier on request.stderr.
+func dropCovered(numbers []int, tiers map[int]gateslot.Tier, request testRequest) []int {
+	var kept []int
+	for i := len(numbers) - 1; i >= 0; i-- {
+		number := numbers[i]
+		coveredBy := slices.IndexFunc(kept, func(higher int) bool { return slices.Contains(tiers[higher].Covers, number) })
+		if coveredBy < 0 {
+			kept = append(kept, number)
+			continue
+		}
+		if request.stderr != nil {
+			fmt.Fprintf(request.stderr, "gate test: %s is covered by %s and not run separately\n", tierName(number), tierName(kept[coveredBy]))
+		}
+	}
+	slices.Reverse(kept)
+	return kept
+}
+
+// ranWhole reports whether a run of runs is the tier number or a tier that covers it.
+func ranWhole(runs []tierRun, number int) bool {
+	return slices.ContainsFunc(runs, func(run tierRun) bool {
+		return run.number == number || slices.Contains(run.tier.Covers, number)
+	})
+}
+
+// renderTierCommand fills {targets}, {args} and {parallel} in the tier's command, each target and each arg quoted for the platform shell.
+// A placeholder the command does not hold is not added.
+func renderTierCommand(tier gateslot.Tier, targets, args []string) (string, error) {
+	quotedTargets, err := quoteAll(targets)
+	if err != nil {
+		return "", err
+	}
+	quotedArgs, err := quoteAll(args)
+	if err != nil {
+		return "", err
+	}
+	return strings.NewReplacer(
+		"{targets}", strings.Join(quotedTargets, " "),
+		"{args}", strings.Join(quotedArgs, " "),
+		"{parallel}", strconv.Itoa(tier.Parallel),
+	).Replace(tier.Command), nil
+}
+
+// quoteAll quotes each word as one literal shell argument.
+func quoteAll(words []string) ([]string, error) {
+	quoted := make([]string, len(words))
+	for i, word := range words {
+		var err error
+		if quoted[i], err = verifyrun.QuoteArg(runtime.GOOS, word); err != nil {
+			return nil, fmt.Errorf("gate test: quote %q for the shell: %w; way forward: pass a value without a percent sign", word, err)
+		}
+	}
+	return quoted, nil
+}
+
+// renderTierEnv returns the tier's env as KEY=VALUE entries in key order, {parallel} filled.
+func renderTierEnv(tier gateslot.Tier) []string {
+	keys := make([]string, 0, len(tier.Env))
+	for key := range tier.Env {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	parallel := strconv.Itoa(tier.Parallel)
+	entries := make([]string, len(keys))
+	for i, key := range keys {
+		entries[i] = key + "=" + strings.ReplaceAll(tier.Env[key], "{parallel}", parallel)
+	}
+	return entries
+}
diff --git a/internal/gatecli/tiers_test.go b/internal/gatecli/tiers_test.go
