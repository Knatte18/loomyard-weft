+			},
+			wantChecks: 1, wantReleased: true, wantPauses: 1, wantNotices: 1,
+		},
+		{
+			name: "a blocked Finalize with the parent holding the work releases the record", status: finalize(shedengine.StateBlocked, ""), sleepFor: 2 * time.Minute,
