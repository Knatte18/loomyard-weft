diff --git a/internal/loomcli/darnclassify.go b/internal/loomcli/darnclassify.go
new file mode 100644
index 000000000..c31a22027
--- /dev/null
+++ b/internal/loomcli/darnclassify.go
@@ -0,0 +1,203 @@
+// darnclassify.go classifies a failed darn verify as owned or not owned by the task, against the impacted set of the task's diff.
+// It answers the route a not-owned failure takes: back to Merge-In rather than Darn-Write.
+
+package loomcli
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+
+	"golang.org/x/mod/modfile"
+
+	"github.com/Knatte18/loomyard/internal/impactset"
+	"github.com/Knatte18/loomyard/internal/landingshed"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/loomshed"
+	"github.com/Knatte18/loomyard/internal/verifytree"
+	"github.com/Knatte18/loomyard/internal/websterengine"
+)
+
+// darnFailedWayForward is the way-forward clause of a darn verify failure the task owns: the route back to Darn-Write.
+const darnFailedWayForward = `run "lyx loom goto --to Darn-Write", then "lyx loom resume", in the task worktree; the Darn-Write spawn renders the Publish failure record and its gate runs the failing tests`
+
+// notOwnedWayForward is the way-forward clause of a darn verify failure outside the task's impacted set.
+const notOwnedWayForward = `fix the failure on the parent branch if it fails there too, then run "lyx loom goto --to Merge-In", then "lyx loom resume", in the task worktree, which merges a moved parent and re-runs the failing gate; or, if the task did cause it, run "lyx loom goto --to Darn-Write", then "lyx loom resume", in the task worktree, where a moved parent is merged in first`
+
+// impactedSet is the impacted set of a diff spelled in import paths.
+type impactedSet struct {
+	// packages are the impacted packages.
+	packages map[string]bool
+	// guards maps each guard package to the names of its `//lyx:guard` tests.
+	guards map[string][]string
+	// binary are the packages whose tests import `internal/testkit/lyxbin`.
+	binary map[string]bool
+}
+
+// importPathSet maps targets onto import paths, reading each module's path from its go.mod under worktree.
+// Guards and BinaryTests are directories of the root module.
+// A go.mod that is missing, unreadable or names no module is the returned error.
+func importPathSet(worktree string, targets impactset.Targets) (impactedSet, error) {
+	set := impactedSet{packages: map[string]bool{}, guards: map[string][]string{}, binary: map[string]bool{}}
+	for _, module := range targets.Modules {
+		modulePath, err := readModulePath(worktree, module.Dir)
+		if err != nil {
+			return impactedSet{}, err
+		}
+		for _, pkg := range module.Packages {
+			set.packages[joinImportPath(modulePath, pkg)] = true
+		}
+	}
+	if len(targets.Guards) == 0 && len(targets.BinaryTests) == 0 {
+		return set, nil
+	}
+	rootPath, err := readModulePath(worktree, ".")
+	if err != nil {
+		return impactedSet{}, err
+	}
+	for dir, names := range targets.Guards {
+		set.guards[joinImportPath(rootPath, dir)] = names
+	}
+	for _, dir := range targets.BinaryTests {
+		set.binary[joinImportPath(rootPath, dir)] = true
+	}
+	return set, nil
+}
+
+// readModulePath returns the module path declared by the go.mod in moduleDir, relative to worktree.
+func readModulePath(worktree, moduleDir string) (string, error) {
+	goMod := filepath.Join(worktree, filepath.FromSlash(moduleDir), "go.mod")
+	data, err := os.ReadFile(goMod)
+	if err != nil {
+		return "", fmt.Errorf("read module path: %w", err)
+	}
+	modulePath := modfile.ModulePath(data)
+	if modulePath == "" {
+		return "", fmt.Errorf("read module path: %s declares no module", goMod)
+	}
+	return modulePath, nil
+}
+
+// joinImportPath spells the module-relative package argument or directory dir as an import path under modulePath.
+func joinImportPath(modulePath, dir string) string {
+	dir = strings.TrimPrefix(path.Clean(dir), "./")
+	if dir == "." {
+		return modulePath
+	}
+	return modulePath + "/" + dir
+}
+
+// ownedFailure reports whether the task owns a failed verify, over the identities the log yields and the tests the failure record names.
+// When it does not, it also returns the sorted distinct import paths of the failing packages, all outside the impacted set.
+// Any doubt counts as owned: no recorded test, an opaque identity, or a failure in an impacted package or in a guard test.
+func ownedFailure(failures []websterengine.VerifyFailure, tests []verifytree.FailedTest, set impactedSet) (bool, []string) {
+	outside := map[string]bool{}
+	for _, failure := range failures {
+		switch failure.Kind {
+		case websterengine.FailureKindOpaque:
+			return true, nil
+		case websterengine.FailureKindPackage:
+			if set.packages[failure.Package] {
+				return true, nil
+			}
+			outside[failure.Package] = true
+		default:
+			testName := strings.TrimPrefix(failure.ID, failure.Package+".")
+			if set.owns(failure.Package, testName) {
+				return true, nil
+			}
+			outside[failure.Package] = true
+		}
+	}
+	if len(tests) == 0 {
+		return true, nil
+	}
+	for _, test := range tests {
+		if set.owns(test.Package, test.Test) {
+			return true, nil
+		}
+		outside[test.Package] = true
+	}
+	packages := make([]string, 0, len(outside))
+	for pkg := range outside {
+		packages = append(packages, pkg)
+	}
+	sort.Strings(packages)
+	return false, packages
+}
+
+// owns reports whether a failing test of pkg lies in the impacted set or is a guard test of its package.
+// A guard matches by its top-level test name, the part of testPath before the first slash.
+func (s impactedSet) owns(pkg, testPath string) bool {
+	if s.packages[pkg] {
+		return true
+	}
+	topLevel, _, _ := strings.Cut(testPath, "/")
+	return slices.Contains(s.guards[pkg], topLevel)
+}
+
+// notOwnedRoute is the route of a failure whose failing packages, outside, lie outside the impacted set: back to Merge-In.
+// The lead names the packages before the merge clause, so a notice that keeps only the first characters of the reason still carries them.
+func notOwnedRoute(outside []string, set impactedSet) landingshed.FailureRoute {
+	wayForward := notOwnedWayForward
+	var driving []string
+	for _, pkg := range outside {
+		if set.binary[pkg] {
+			driving = append(driving, pkg)
+		}
+	}
+	if len(driving) > 0 {
+		wayForward += fmt.Sprintf("; %s drive the lyx binary in their tests and may reach the task's change, so when the test does not fail on the parent branch, the Darn-Write goto is the way forward", strings.Join(driving, ", "))
+	}
+	return landingshed.FailureRoute{
+		Target:     loomshed.NameMergeIn,
+		Lead:       fmt.Sprintf(" outside the task's impacted set, in %s,", strings.Join(outside, ", ")),
+		WayForward: wayForward,
+	}
+}
+
+// darnFailureRoute classifies the failed darn verify that failure records and answers its route.
+// The route is Darn-Write unless the log's failing packages all lie outside the impacted set of the diff from the merge base.
+// Only a failure the import graph shows unreachable from the diff skips a Darn-Write trip.
+// An unreadable log, a merge base or derivation error, a Whole answer and an unmappable set all count as owned, the first four logged at Warn.
+func darnFailureRoute(
+	ctx context.Context,
+	failure verifytree.PublishFailure,
+	worktree string,
+	mergeBase func() (string, error),
+	derive func(ctx context.Context, worktree, base string) (impactset.Targets, error),
+) landingshed.FailureRoute {
+	owned := landingshed.FailureRoute{Target: loomshed.NameDarnWrite, WayForward: darnFailedWayForward}
+	log, err := os.ReadFile(failure.LogPath)
+	if err != nil {
+		logger.Warn("loom: darn failure classified as owned: could not read the verify log", "path", failure.LogPath, "error", err)
+		return owned
+	}
+	base, err := mergeBase()
+	if err != nil {
+		logger.Warn("loom: darn failure classified as owned: could not read the merge base", "error", err)
+		return owned
+	}
+	targets, err := derive(ctx, worktree, base)
+	if err != nil {
+		logger.Warn("loom: darn failure classified as owned: could not derive the impacted set", "error", err)
+		return owned
+	}
+	if targets.Whole {
+		return owned
+	}
+	set, err := importPathSet(worktree, targets)
+	if err != nil {
+		logger.Warn("loom: darn failure classified as owned: could not map the impacted set to import paths", "error", err)
+		return owned
+	}
+	if isOwned, outside := ownedFailure(websterengine.ParseVerifyFailures(string(log)), failure.Tests, set); !isOwned {
+		return notOwnedRoute(outside, set)
+	}
+	return owned
+}
diff --git a/internal/loomcli/darnclassify_test.go b/internal/loomcli/darnclassify_test.go
new file mode 100644
index 000000000..c1f60465f
--- /dev/null
+++ b/internal/loomcli/darnclassify_test.go
@@ -0,0 +1,212 @@
+// darnclassify_test.go covers the darn failure classifier: which failed verifies the task owns and the route a not-owned one takes.
+
+package loomcli
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/impactset"
+	"github.com/Knatte18/loomyard/internal/landingshed"
+	"github.com/Knatte18/loomyard/internal/verifytree"
+)
+
+func TestDarnFailureRoute(t *testing.T) {
+	t.Parallel()
+
+	const (
+		rootModule  = "example.com/m"
+		toolsModule = "example.com/tools"
+		outsideZ    = rootModule + "/internal/z"
+		outsideY    = rootModule + "/internal/y"
+		guardPkg    = rootModule + "/internal/g"
+		driverPkg   = rootModule + "/internal/lyxdriver"
+	)
+	// failedTests renders go test output for pkg whose named tests failed.
+	failedTests := func(pkg string, names ...string) string {
+		var out strings.Builder
+		for _, name := range names {
+			out.WriteString("--- FAIL: " + name + " (0.00s)\n")
+		}
+		return out.String() + "FAIL\nFAIL\t" + pkg + "\t0.01s\n"
+	}
+	buildFailed := func(pkg string) string { return "FAIL\t" + pkg + " [build failed]\n" }
+	zFailure := failedTests(outsideZ, "TestZ")
+	zTest := verifytree.FailedTest{Package: outsideZ, Test: "TestZ"}
+
+	toldTargets := impactset.Targets{
+		Modules: []impactset.ModuleTargets{
+			{Dir: ".", Packages: []string{"./internal/a", "./internal/bin"}},
+			{Dir: "tools", Packages: []string{"./x"}},
+		},
+		Guards:      map[string][]string{"internal/g": {"TestGuard"}},
+		BinaryTests: []string{"internal/lyxdriver"},
+	}
+	toldDerive := func(context.Context, string, string) (impactset.Targets, error) { return toldTargets, nil }
+	owned := landingshed.FailureRoute{Target: "Darn-Write", WayForward: darnFailedWayForward}
+	notOwned := func(lead, wayForward string) landingshed.FailureRoute {
+		return landingshed.FailureRoute{Target: "Merge-In", Lead: lead, WayForward: wayForward}
+	}
+
+	tests := []struct {
+		name string
+		// log is the verify log's content.
+		log   string
+		tests []verifytree.FailedTest
+		// derive replaces the told derivation.
+		derive func(context.Context, string, string) (impactset.Targets, error)
+		// mergeBaseErr makes the merge base reader fail.
+		mergeBaseErr bool
+		// noLog points the record at a log file that does not exist.
+		noLog bool
+		// noToolsModule removes the nested module's go.mod.
+		noToolsModule bool
+		want          landingshed.FailureRoute
+	}{
+		{
+			name:  "a failing test in an impacted package, given by import path against a module-relative argument, is owned",
+			log:   failedTests(rootModule+"/internal/a", "TestA") + zFailure,
+			tests: []verifytree.FailedTest{{Package: rootModule + "/internal/a", Test: "TestA"}, zTest},
+			want:  owned,
+		},
+		{
+			name:  "a failing test in a nested module's package is owned",
+			log:   failedTests(toolsModule+"/x", "TestX") + zFailure,
+			tests: []verifytree.FailedTest{{Package: toolsModule + "/x", Test: "TestX"}, zTest},
+			want:  owned,
+		},
+		{
+			name:  "a failing guard test outside the set is owned",
+			log:   failedTests(guardPkg, "TestGuard", "TestGuard/sub") + zFailure,
+			tests: []verifytree.FailedTest{{Package: guardPkg, Test: "TestGuard/sub"}, zTest},
+			want:  owned,
+		},
+		{
+			name:  "a failing test of a guard package that is not the listed guard is not owned",
+			log:   failedTests(guardPkg, "TestOther"),
+			tests: []verifytree.FailedTest{{Package: guardPkg, Test: "TestOther"}},
+			want:  notOwned(" outside the task's impacted set, in "+guardPkg+",", notOwnedWayForward),
+		},
+		{
+			name:  "a Whole answer is owned",
+			log:   zFailure,
+			tests: []verifytree.FailedTest{zTest},
+			derive: func(context.Context, string, string) (impactset.Targets, error) {
+				return impactset.Targets{Whole: true}, nil
+			},
+			want: owned,
+		},
+		{
+			name:  "a build failure in an impacted package is owned",
+			log:   buildFailed(rootModule+"/internal/a") + zFailure,
+			tests: []verifytree.FailedTest{zTest},
+			want:  owned,
+		},
+		{
+			name:  "an opaque identity is owned",
+			log:   "go vet: something failed\n",
+			tests: []verifytree.FailedTest{zTest},
+			want:  owned,
+		},
+		{
+			name: "a record with no failing tests is owned",
+			log:  zFailure,
+			want: owned,
+		},
+		{
+			name:  "a derive error is owned",
+			log:   zFailure,
+			tests: []verifytree.FailedTest{zTest},
+			derive: func(context.Context, string, string) (impactset.Targets, error) {
+				return impactset.Targets{}, errors.New("go list failed")
+			},
+			want: owned,
+		},
+		{
+			name:         "a merge base error is owned",
+			log:          zFailure,
+			tests:        []verifytree.FailedTest{zTest},
+			mergeBaseErr: true,
+			want:         owned,
+		},
+		{
+			name:  "a log path that names no file is owned",
+			tests: []verifytree.FailedTest{zTest},
+			noLog: true,
+			want:  owned,
+		},
+		{
+			name:          "a nested module without a go.mod is owned",
+			log:           zFailure,
+			tests:         []verifytree.FailedTest{zTest},
+			noToolsModule: true,
+			want:          owned,
+		},
+		{
+			name:  "failures only outside the set route to Merge-In, naming the packages sorted, with only the parent fix conditional",
+			log:   buildFailed(outsideY) + zFailure,
+			tests: []verifytree.FailedTest{zTest},
+			want:  notOwned(" outside the task's impacted set, in "+outsideY+", "+outsideZ+",", notOwnedWayForward),
+		},
+		{
+			name:  "a failing test in a package that drives the lyx binary names the Darn-Write goto after the binary clause",
+			log:   failedTests(driverPkg, "TestDrive"),
+			tests: []verifytree.FailedTest{{Package: driverPkg, Test: "TestDrive"}},
+			want: notOwned(
+				" outside the task's impacted set, in "+driverPkg+",",
+				notOwnedWayForward+"; "+driverPkg+" drive the lyx binary in their tests and may reach the task's change, so when the test does not fail on the parent branch, the Darn-Write goto is the way forward",
+			),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			worktree := t.TempDir()
+			writeGoMod := func(dir, module string) {
+				t.Helper()
+				if err := os.MkdirAll(filepath.Join(worktree, dir), 0o755); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(worktree, dir, "go.mod"), []byte("module "+module+"\n\ngo 1.22\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			writeGoMod(".", rootModule)
+			if !tt.noToolsModule {
+				writeGoMod("tools", toolsModule)
+			}
+			logPath := filepath.Join(worktree, "verify.log")
+			if !tt.noLog {
+				if err := os.WriteFile(logPath, []byte(tt.log), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			derive := toldDerive
+			if tt.derive != nil {
+				derive = tt.derive
+			}
+			mergeBase := func() (string, error) {
+				if tt.mergeBaseErr {
+					return "", errors.New("no merge base")
+				}
+				return "base-sha", nil
+			}
+			failure := verifytree.PublishFailure{Kind: verifytree.FailureKindLanding, Row: "Merge-In", LogPath: logPath, Tests: tt.tests}
+
+			got := darnFailureRoute(context.Background(), failure, worktree, mergeBase, derive)
+
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("darnFailureRoute() = %+v; want %+v", got, tt.want)
+			}
+			if tt.want.Target == "Merge-In" && !strings.HasPrefix(got.WayForward, `fix the failure on the parent branch if it fails there too, then run "lyx loom goto --to Merge-In"`) {
+				t.Errorf("darnFailureRoute().WayForward = %q; want it to open with the conditional parent fix and the Merge-In goto", got.WayForward)
+			}
+		})
+	}
+}
