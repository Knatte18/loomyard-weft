+// pairFixture is a hub with a pair whose two sides have been pushed once, so each has an upstream.
+type pairFixture struct {
+	*recordsFixture
+	fake       *fakePushNotifier
+	location   *lyxcwd.Location
+	warpPath   string
+	weftPath   string
+	warpBranch string
+	weftBranch string
+}
