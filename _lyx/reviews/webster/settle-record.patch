+			}
+
+			if err := startDetachedPush(truePath, req); err != nil {
+				t.Fatalf("startDetachedPush() = %v; want nil", err)
+			}
+			records, err := filepath.Glob(filepath.Join(RunProcDir(hub), tt.wantOwner, "*.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(records) != 1 {
