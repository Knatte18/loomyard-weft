+			if n := lines(t, e.counter); n != 2 {
+				t.Errorf("command runs = %d; want 2", n)
+			}
+			if !fileExists(filepath.Join(e.p.Dir, "verify-1.log")) || !fileExists(filepath.Join(e.p.Dir, "verify-2.log")) {
+				t.Errorf("verify logs in %s: want the stopped run's and the rerun's", e.p.Dir)
+			}
+			e.assertNoMarker()
+		}},
+		{"a tree dirtied during the stop's pause returns dirty after the resume and runs no second command", false, func(t *testing.T, e *pauseEnv) {
+			out := stopAndWait(t, e)
+			if err := os.WriteFile(filepath.Join(e.p.Worktree, "stray.txt"), []byte("x"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			e.resume()
+			got := <-out
+			if got.err != nil || got.result.Status != StatusDirty {
+				t.Fatalf("Verify = (%+v, %v); want StatusDirty", got.result, got.err)
+			}
+			if n := lines(t, e.counter); n != 1 {
+				t.Errorf("command runs = %d; want 1, the stopped run", n)
+			}
+			e.assertNoMarker()
+		}},
+		{"a record naming HEAD's tree written during the stop's pause skips after the resume", false, func(t *testing.T, e *pauseEnv) {
+			out := stopAndWait(t, e)
+			tree, err := headTree(e.p.Worktree)
+			if err != nil {
+				t.Fatal(err)
+			}
+			commit, err := headCommit(e.p.Worktree)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rec := record{Entries: []entry{{Command: e.stoppableCommand(), Tree: tree, Commit: commit, VerifiedAt: time.Now()}}}
+			if err := writeRecord(e.p.Record, rec); err != nil {
+				t.Fatal(err)
+			}
+			e.resume()
+			got := <-out
+			if got.err != nil || got.result.Status != StatusSkipped {
+				t.Fatalf("Verify = (%+v, %v); want StatusSkipped", got.result, got.err)
+			}
+			if n := lines(t, e.counter); n != 1 {
+				t.Errorf("command runs = %d; want 1, the stopped run", n)
+			}
+			e.assertNoMarker()
+		}},
+		{"a pause resumed before its grace end lets the running command finish and record its result", false, func(t *testing.T, e *pauseEnv) {
+			out := e.verifyAsync(context.Background(), e.holdOpenCommand())
+			e.waitFor("the command to start", func() bool { return lines(t, e.counter) == 1 })
+			e.pause(pauserecord.ScopeHub, time.Now().Add(time.Hour))
+			e.pollsBeyond()
+			e.resume()
+			e.pollsBeyond()
+			if err := os.WriteFile(e.release, nil, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			got := <-out
+			if got.err != nil || got.result.Status != StatusPassed {
+				t.Fatalf("Verify = (%+v, %v); want a pass", got.result, got.err)
+			}
+			if n := lines(t, e.counter); n != 1 {
+				t.Errorf("command runs = %d; want 1", n)
+			}
+			if _, ok := LatestPass(e.p, e.holdOpenCommand()); !ok {
+				t.Errorf("no pass recorded for the finished command")
+			}
+		}},
+		{"a caller's cancel while held returns the cancel, runs no command and leaves no marker", false, func(t *testing.T, e *pauseEnv) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			e.pause(pauserecord.ScopeHub, time.Now().Add(time.Hour))
+			out := e.verifyAsync(ctx, e.quickCommand())
+			e.waitFor("the paused marker", func() bool { return e.markerState() == MarkerStatePaused })
+			cancel()
+			got := <-out
+			if !errors.Is(got.err, context.Canceled) {
+				t.Fatalf("Verify error = %v; want one wrapping context.Canceled", got.err)
+			}
+			if n := lines(t, e.counter); n != 0 {
+				t.Errorf("command runs = %d; want 0", n)
+			}
+			e.assertNoMarker()
+		}},
+		{"a slug entry under an exempt hold neither holds the command nor stops it past its grace end", false, func(t *testing.T, e *pauseEnv) {
+			e.useHold(NewPauseHold(pauserecord.Geometry{RecordPath: e.record, Slug: "alpha"}, func() bool { return true }))
+			e.pause("alpha", time.Now())
+			out := e.verifyAsync(context.Background(), e.holdOpenCommand())
+			e.waitFor("the command to start", func() bool { return lines(t, e.counter) == 1 })
+			if state := e.markerState(); state != MarkerStateRunning {
+				t.Errorf("marker state = %q; want %q", state, MarkerStateRunning)
+			}
+			e.pollsBeyond()
+			if err := os.WriteFile(e.release, nil, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			got := <-out
+			if got.err != nil || got.result.Status != StatusPassed {
+				t.Fatalf("Verify = (%+v, %v); want a pass", got.result, got.err)
+			}
+			if n := lines(t, e.counter); n != 1 {
+				t.Errorf("command runs = %d; want 1, never stopped", n)
+			}
+		}},
+		{"a hold over no pause geometry runs the command at once and never stops it", false, func(t *testing.T, e *pauseEnv) {
+			e.useHold(NewPauseHold(pauserecord.Geometry{}, nil))
+			out := e.verifyAsync(context.Background(), e.holdOpenCommand())
+			e.waitFor("the command to start", func() bool { return lines(t, e.counter) == 1 })
+			e.pollsBeyond()
+			if err := os.WriteFile(e.release, nil, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			got := <-out
+			if got.err != nil || got.result.Status != StatusPassed {
+				t.Fatalf("Verify = (%+v, %v); want a pass", got.result, got.err)
+			}
+		}},
+		{"an undecodable pause record runs the command at once with a running marker and logs one Warn across the polls", true, func(t *testing.T, e *pauseEnv) {
+			logs := logcapture.CaptureVerbose(t)
+			if err := os.WriteFile(e.record, []byte("{not json"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			out := e.verifyAsync(context.Background(), e.holdOpenCommand())
+			e.waitFor("the command to start", func() bool { return lines(t, e.counter) == 1 })
+			if state := e.markerState(); state != MarkerStateRunning {
+				t.Errorf("marker state = %q; want %q", state, MarkerStateRunning)
+			}
+			e.pollsBeyond()
+			if err := os.WriteFile(e.release, nil, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			got := <-out
+			if got.err != nil || got.result.Status != StatusPassed {
+				t.Fatalf("Verify = (%+v, %v); want a pass", got.result, got.err)
+			}
+			if n := strings.Count(logs.String(), "not stopping the verify"); n != 1 {
+				t.Errorf("PastGrace Warn lines = %d; want 1; logs: %s", n, logs.String())
+			}
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if !tt.serial {
+				t.Parallel()
+			}
+			tt.run(t, newPauseEnv(t, "", nil))
+		})
+	}
+}
diff --git a/internal/webstercli/batchpause.go b/internal/webstercli/batchpause.go
new file mode 100644
index 000000000..c636b11b6
--- /dev/null
+++ b/internal/webstercli/batchpause.go
@@ -0,0 +1,65 @@
+// batchpause.go holds the up-front refusal begin-batch and recover-batch make under a pause, and the lookup of Master's own strand that refusal claims into the pause.
+
+package webstercli
+
+import (
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+)
+
+// envMasterStrand returns the lookup of the calling strand's name and guid: the name is read from the strand-name environment variable and the guid is resolved from it through resolve.
+// An unset or empty variable is an error naming it, and a resolve error is returned as is.
+func envMasterStrand(resolve func(name string) (string, error)) func() (name, guid string, err error) {
+	return func() (string, string, error) {
+		name := os.Getenv(agentname.StrandNameEnv)
+		if name == "" {
+			return "", "", fmt.Errorf("%s is not set", agentname.StrandNameEnv)
+		}
+		guid, err := resolve(name)
+		if err != nil {
+			return name, "", err
+		}
+		return name, guid, nil
+	}
+}
+
+// refuseCoveredBatch returns the refusal message of a batch verb a pause holds, or the empty string when the verb goes on.
+// Under a covering entry it claims Master into the pause, so `lyx tender resume` gives Master its resume line;
+// a Master that cannot be claimed is refused with a way forward that needs no resume line.
+// A pair with no pause geometry, an unreadable record and an entry lifted before the claim all go on.
+func (c *websterCLI) refuseCoveredBatch(verb, batch string) string {
+	if c.pause == (pauserecord.Geometry{}) {
+		return ""
+	}
+	now := time.Now()
+	coverage, err := pauserecord.ReadCoverage(c.pause.RecordPath, c.pause.Slug, now)
+	if err != nil {
+		logger.Warn("webstercli: the pause record could not be read, so the batch verb goes on", "record", c.pause.RecordPath, "err", err)
+		return ""
+	}
+	if !coverage.Covered {
+		return ""
+	}
+	holder := "a hub-wide pause"
+	if coverage.Entry.Scope != pauserecord.ScopeHub {
+		holder = "the pause of " + coverage.Entry.Scope
+	}
+	name, guid, err := c.masterStrand()
+	if err == nil {
+		var covered bool
+		_, covered, err = pauserecord.ClaimSession(c.pause.RecordPath, c.pause.Slug, pauserecord.Session{Strand: name, GUID: guid, Slug: c.pause.Slug}, now)
+		if err == nil && !covered {
+			return ""
+		}
+		if err == nil {
+			return fmt.Sprintf("webster: %s holds this pair, so %s starts no new batch; way forward: end your turn now; a running batch finishes, and once the resume line arrives run \"lyx webster %s %s\" again", holder, verb, verb, batch)
+		}
+	}
+	logger.Warn("webstercli: Master could not be claimed into the pause", "strand", name, "err", err)
+	return fmt.Sprintf("webster: %s holds this pair, so %s starts no new batch, and no resume line will come; way forward: end your turn now, then run \"lyx webster %s %s\" again once \"lyx tender status\" shows no pause", holder, verb, verb, batch)
+}
diff --git a/internal/webstercli/batchpause_test.go b/internal/webstercli/batchpause_test.go
new file mode 100644
index 000000000..8639d7dd6
--- /dev/null
+++ b/internal/webstercli/batchpause_test.go
@@ -0,0 +1,251 @@
+//go:build integration
+
+// batchpause_test.go covers the pause refusal begin-batch and recover-batch make before they read or change any state, and the lookup of Master's strand it claims.
+
+package webstercli
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/clihelp"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/testkit/logcapture"
+)
+
+const undecodableRecord = "{not json"
+
+// TestBatchVerbs_RefuseUnderAPause drives the batch verbs under a live hub entry with Master's strand lookup stubbed.
+// It does not run in parallel: envMasterStrand's part sets an environment variable, and the logger is process-global.
+func TestBatchVerbs_RefuseUnderAPause(t *testing.T) {
+	const (
+		masterName = "ly:pair:master"
+		masterGUID = "guid-master"
+	)
+	claimedMaster := []pauserecord.Session{{Strand: masterName, GUID: masterGUID, Slug: "pair"}}
+	okStrand := func(string) func() (string, string, error) {
+		return func() (string, string, error) { return masterName, masterGUID, nil }
+	}
+	failingStrand := func(string) func() (string, string, error) {
+		return func() (string, string, error) { return masterName, "", errors.New("no such strand") }
+	}
+	rewriteRecord := func(t *testing.T, path string, mutate func(*pauserecord.Record)) {
+		t.Helper()
+		if _, err := pauserecord.Update(path, time.Now(), func(record *pauserecord.Record) error {
+			mutate(record)
+			return nil
+		}); err != nil {
+			t.Fatalf("Update() = %v", err)
+		}
+	}
+	refusedGoingOn := func(verb string) []string {
+		return []string{"a hub-wide pause holds this pair, so " + verb + " starts no new batch; way forward: end your turn now; a running batch finishes, and once the resume line arrives run \"lyx webster " + verb + " 1\" again"}
+	}
+	refusedNoLine := func(verb string) []string {
+		return []string{"a hub-wide pause holds this pair, so " + verb + " starts no new batch, and no resume line will come; way forward: end your turn now, then run \"lyx webster " + verb + " 1\" again once \"lyx tender status\" shows no pause"}
+	}
+
+	tests := []struct {
+		name         string
+		verb         string
+		undecodable  bool
+		masterStrand func(recordPath string) func() (string, string, error)
+		wantExit     int
+		wantText     []string
+		wantSessions []pauserecord.Session
+		wantWarn     string
+		wantRecord   string
+		stateKept    bool
+	}{
+		{name: "begin-batch claims Master and refuses", verb: "begin-batch", masterStrand: okStrand, wantExit: 1, wantText: refusedGoingOn("begin-batch"), wantSessions: claimedMaster, stateKept: true},
+		{name: "recover-batch claims Master and refuses", verb: "recover-batch", masterStrand: okStrand, wantExit: 1, wantText: refusedGoingOn("recover-batch"), wantSessions: claimedMaster, stateKept: true},
+		{name: "begin-batch refuses without a claim when Master's strand is unknown", verb: "begin-batch", masterStrand: failingStrand, wantExit: 1, wantText: refusedNoLine("begin-batch"), wantWarn: "Master could not be claimed", stateKept: true},
+		{name: "recover-batch refuses without a claim when Master's strand is unknown", verb: "recover-batch", masterStrand: failingStrand, wantExit: 1, wantText: refusedNoLine("recover-batch"), wantWarn: "Master could not be claimed", stateKept: true},
+		{
+			name: "begin-batch whose record turns undecodable before the claim refuses without a claim", verb: "begin-batch",
+			masterStrand: func(path string) func() (string, string, error) {
+				return func() (string, string, error) {
+					if err := os.WriteFile(path, []byte(undecodableRecord), 0o644); err != nil {
+						t.Errorf("WriteFile(%q) = %v", path, err)
+					}
+					return masterName, masterGUID, nil
+				}
+			},
+			wantExit: 1, wantText: refusedNoLine("begin-batch"), wantWarn: "Master could not be claimed", wantRecord: undecodableRecord, stateKept: true,
+		},
+		{
+			name: "begin-batch whose entry is lifted before the claim goes on", verb: "begin-batch",
+			masterStrand: func(path string) func() (string, string, error) {
+				return func() (string, string, error) {
+					rewriteRecord(t, path, func(record *pauserecord.Record) {
+						record.Resumed, record.Live = record.Live, nil
+					})
+					return masterName, masterGUID, nil
+				}
+			},
+			wantExit: 0, wantText: []string{`"batch":"01-only"`},
+		},
+		{
+			name: "begin-batch over an undecodable record goes on and warns once", verb: "begin-batch", undecodable: true,
+			masterStrand: func(string) func() (string, string, error) {
+				return func() (string, string, error) {
+					t.Error("masterStrand was called over a record that read as uncovered")
+					return "", "", errors.New("unreachable")
+				}
+			},
+			wantExit: 0, wantText: []string{`"batch":"01-only"`}, wantWarn: "the pause record could not be read", wantRecord: undecodableRecord,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("FABRIC_SKIP_GIT", "1")
+			logs := logcapture.Capture(t)
+			fx := newVerbsFixture(t)
+			fx.initState(t)
+			recordPath := filepath.Join(t.TempDir(), pauserecord.RecordFileName)
+			fx.CLI.pause = pauserecord.Geometry{RecordPath: recordPath, Slug: "pair"}
+			fx.Runner.SetPause(fx.CLI.pause)
+			fx.CLI.masterStrand = tt.masterStrand(recordPath)
+			if tt.undecodable {
+				if err := os.WriteFile(recordPath, []byte(undecodableRecord), 0o644); err != nil {
+					t.Fatalf("WriteFile(%q) = %v", recordPath, err)
+				}
+			} else {
+				rewriteRecord(t, recordPath, func(record *pauserecord.Record) {
+					record.Live = []pauserecord.Entry{{Scope: pauserecord.ScopeHub, PausedAt: time.Now().Add(-time.Minute)}}
+				})
+			}
+			statePath := filepath.Join(fx.CLI.geom.WebsterDir, "state.json")
+			stateBefore, err := os.ReadFile(statePath)
+			if err != nil {
+				t.Fatalf("ReadFile(%q) = %v", statePath, err)
+			}
+
+			cmd := fx.CLI.beginBatchCmd()
+			if tt.verb == "recover-batch" {
+				cmd = fx.CLI.recoverBatchCmd()
+			}
+			var out strings.Builder
+			exitCode := clihelp.Execute(cmd, &out, []string{"1"})
+
+			if exitCode != tt.wantExit {
+				t.Fatalf("%s 1 = %d; want %d, output: %s", tt.verb, exitCode, tt.wantExit, out.String())
+			}
+			body := out.String()
+			var envelope struct {
+				Error string `json:"error"`
+			}
+			if json.Unmarshal([]byte(body), &envelope) == nil && envelope.Error != "" {
+				body = envelope.Error
+			}
+			for _, want := range tt.wantText {
+				if !strings.Contains(body, want) {
+					t.Errorf("output missing %q; got %q", want, body)
+				}
+			}
+			if strings.Contains(body, "lyx resume") {
+				t.Errorf("output %q names `lyx resume`, which would lift the operator's pause", body)
+			}
+			if tt.wantRecord != "" {
+				if got, err := os.ReadFile(recordPath); err != nil || string(got) != tt.wantRecord {
+					t.Errorf("pause record = %q, %v; want it left as %q", got, err, tt.wantRecord)
+				}
+			} else if tt.wantExit != 0 {
+				record, err := pauserecord.Read(recordPath)
+				if err != nil {
+					t.Fatalf("Read() = %v", err)
+				}
+				var sessions []pauserecord.Session
+				for _, entry := range record.Live {
+					sessions = append(sessions, entry.Sessions...)
+				}
+				if diff := cmp.Diff(tt.wantSessions, sessions); diff != "" {
+					t.Errorf("recorded sessions mismatch (-want +got):\n%s", diff)
+				}
+			}
+			if tt.stateKept {
+				if stateAfter, err := os.ReadFile(statePath); err != nil || !bytes.Equal(stateBefore, stateAfter) {
+					t.Errorf("state.json changed by a refused %s: %v", tt.verb, err)
+				}
+			}
+			wantWarns := 0
+			if tt.wantWarn != "" {
+				wantWarns = 1
+			}
+			if got := strings.Count(logs.String(), "Master could not be claimed") + strings.Count(logs.String(), "the pause record could not be read"); got != wantWarns {
+				t.Errorf("%d warnings (want %d containing %q); logs: %s", got, wantWarns, tt.wantWarn, logs.String())
+			}
+			if tt.wantWarn != "" && !strings.Contains(logs.String(), tt.wantWarn) {
+				t.Errorf("logs lack %q; got %s", tt.wantWarn, logs.String())
+			}
+			if tt.wantWarn == "Master could not be claimed" && !strings.Contains(logs.String(), masterName) {
+				t.Errorf("the warning does not name the strand %s; got %s", masterName, logs.String())
+			}
+		})
+	}
+
+	t.Run("the other verbs are not refused by the pause", func(t *testing.T) {
+		t.Setenv("FABRIC_SKIP_GIT", "1")
+		fx := newVerbsFixture(t)
+		fx.initState(t)
+		recordPath := filepath.Join(t.TempDir(), pauserecord.RecordFileName)
+		fx.CLI.pause = pauserecord.Geometry{RecordPath: recordPath, Slug: "pair"}
+		fx.CLI.masterStrand = func() (string, string, error) {
+			t.Error("masterStrand was called by a verb that takes no pause check")
+			return "", "", errors.New("unreachable")
+		}
+		rewriteRecord(t, recordPath, func(record *pauserecord.Record) {
+			record.Live = []pauserecord.Entry{{Scope: pauserecord.ScopeHub, PausedAt: time.Now().Add(-time.Minute)}}
+		})
+		verbs := []struct {
+			name string
+			cmd  *cobra.Command
+			args []string
+		}{
+			{"record-batch", fx.CLI.recordBatchCmd(), []string{"1"}},
+			{"await-batch", fx.CLI.awaitBatchCmd(), []string{"1", "--wait", "1ms"}},
+			{"status", fx.CLI.statusCmd(), nil},
+		}
+		for _, verb := range verbs {
+			var out strings.Builder
+			clihelp.Execute(verb.cmd, &out, verb.args)
+			if strings.Contains(out.String(), "holds this pair") {
+				t.Errorf("%s was refused by the pause: %s", verb.name, out.String())
+			}
+		}
+	})
+
+	t.Run("envMasterStrand reads the strand-name variable and resolves its guid", func(t *testing.T) {
+		var resolved string
+		lookup := envMasterStrand(func(name string) (string, error) {
+			resolved = name
+			return "guid-for-" + name, nil
+		})
+
+		t.Setenv(agentname.StrandNameEnv, "")
+		if _, _, err := lookup(); err == nil || !strings.Contains(err.Error(), agentname.StrandNameEnv) {
+			t.Errorf("lookup() with the variable empty = %v; want an error naming %s", err, agentname.StrandNameEnv)
+		}
+
+		t.Setenv(agentname.StrandNameEnv, masterName)
+		name, guid, err := lookup()
+		if err != nil || name != masterName || guid != "guid-for-"+masterName || resolved != masterName {
+			t.Errorf("lookup() = (%q, %q, %v) after resolving %q; want (%q, %q, nil)", name, guid, err, resolved, masterName, "guid-for-"+masterName)
+		}
+
+		failing := errors.New("no such strand")
+		if _, _, err := envMasterStrand(func(string) (string, error) { return "", failing })(); !errors.Is(err, failing) {
+			t.Errorf("lookup() whose resolve fails = %v; want %v", err, failing)
+		}
+	})
+}
diff --git a/internal/webstercli/beginbatch.go b/internal/webstercli/beginbatch.go
index 04952e898..bb34f0549 100644
--- a/internal/webstercli/beginbatch.go
+++ b/internal/webstercli/beginbatch.go
@@ -86,6 +86,8 @@ A refusal because the plan's re-resolution against the tree found a blocking
 defect carries "plan_conflict" with its cause: "plan_defect" when no batch is
 begun, "tree_moved" when one is.
 
