+				t.Errorf("ProjectOverview changed its overview argument to %q", overview)
+			}
+		})
+	}
+}
+
+func TestEntryBullet(t *testing.T) {
+	t.Parallel()
+	overview := []byte("- `PATTERN-a` — a.\n- `PATTERN-b` — b,\n  continued.\n\n- `PATTERN-c` — c.\n")
