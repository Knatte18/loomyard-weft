+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+)
+
+// discardHub returns a hub holding slug's pair, pushed, with one unpushed commit on the task branch and the pair's worktrees removed by hand, so both branches survive.
+// It returns the hub and the task branch's local tip.
+func discardHub(t *testing.T, slug string) (*hubforge.Hub, string) {
+	t.Helper()
+
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	hubforge.AddPairWith(t, h, slug, fabricengine.AddOptions{})
+	warpBranchCommit(t, h.Location, slug, "local-work.txt")
+	removePairWorktreesByHand(t, h, slug)
+	return h, gitkit.RevParse(t, h.PrimeWorktree(), slug)
+}
+
+// advanceOrigin commits one file on top of branch's origin tip through a scratch clone, pushes it and returns the new origin tip.
+func advanceOrigin(t *testing.T, h *hubforge.Hub, branch string) string {
+	t.Helper()
+
+	scratch := t.TempDir()
+	gitkit.MustRun(t, scratch, "git", "clone", "--branch", branch, h.CodeBare, "clone")
+	clone := filepath.Join(scratch, "clone")
+	gitkit.CommitFile(t, clone, "origin-work.txt", "origin", "origin work")
+	gitkit.MustRun(t, clone, "git", "push", "origin", branch)
+	return gitkit.RevParse(t, h.CodeBare, branch)
+}
+
+// archiveTagsOnOrigin lists the archive tags of slug on h's warp origin.
+func archiveTagsOnOrigin(t *testing.T, h *hubforge.Hub, slug string) []string {
+	t.Helper()
+
+	return strings.Fields(gitkit.Git(t, h.CodeBare, "tag", "--list", fabricengine.ArchiveTagPrefix+slug+"/*"))
+}
+
+// TestDiscardTaskBranch pins which tips DiscardTaskBranch archives, that every branch is gone afterwards, that a missing branch is a zero result, and that a refused archive push deletes nothing.
+func TestDiscardTaskBranch(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		// setup returns the hub and the tips that must each hold an archive tag.
+		setup func(t *testing.T, slug string) (*hubforge.Hub, []string)
+	}{
+		{"DivergedTipsAreBothArchived", func(t *testing.T, slug string) (*hubforge.Hub, []string) {
+			h, localTip := discardHub(t, slug)
+			originTip := advanceOrigin(t, h, slug)
+			return h, []string{localTip, originTip}
+		}},
+		{"LocalTipContainedInOriginArchivesOriginTip", func(t *testing.T, slug string) (*hubforge.Hub, []string) {
+			h, _ := discardHub(t, slug)
+			gitkit.MustRun(t, h.PrimeWorktree(), "git", "push", "origin", slug)
+			return h, []string{advanceOrigin(t, h, slug)}
+		}},
+		{"OriginTipContainedInLocalArchivesLocalTip", func(t *testing.T, slug string) (*hubforge.Hub, []string) {
+			h, localTip := discardHub(t, slug)
+			return h, []string{localTip}
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			const slug = "discard"
+			h, wantTipped := tt.setup(t, slug)
+
+			res, err := h.Topology.DiscardTaskBranch(h.Location, slug)
+			if err != nil {
+				t.Fatalf("DiscardTaskBranch: %v", err)
+			}
+			if !res.LocalDeleted || !res.OriginDeleted {
+				t.Errorf("LocalDeleted = %v, OriginDeleted = %v; want both true", res.LocalDeleted, res.OriginDeleted)
+			}
+			if gitkit.BranchExists(t, h.PrimeWorktree(), slug) {
+				t.Errorf("task branch %q still local", slug)
+			}
+			if gitkit.BranchExists(t, h.CodeBare, slug) {
+				t.Errorf("task branch %q still on origin", slug)
+			}
+			var wantTags []string
+			for _, tip := range wantTipped {
+				wantTags = append(wantTags, fabricengine.ArchiveTagPrefix+slug+"/"+tip[:12])
+			}
+			slices.Sort(wantTags)
+			gotTags := slices.Clone(res.ArchiveTags)
+			slices.Sort(gotTags)
+			if !slices.Equal(gotTags, wantTags) {
+				t.Errorf("ArchiveTags = %v; want %v", gotTags, wantTags)
+			}
+			if onOrigin := archiveTagsOnOrigin(t, h, slug); !slices.Equal(onOrigin, wantTags) {
+				t.Errorf("archive tags on origin = %v; want %v", onOrigin, wantTags)
+			}
+		})
+	}
+
+	t.Run("NoBranchAnywhereIsAZeroResult", func(t *testing.T) {
+		t.Parallel()
+		h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+
+		res, err := h.Topology.DiscardTaskBranch(h.Location, "never-added")
+		if err != nil {
+			t.Fatalf("DiscardTaskBranch: %v", err)
+		}
+		if len(res.ArchiveTags) != 0 || res.LocalDeleted || res.OriginDeleted || res.Mutations.Len() != 0 {
+			t.Errorf("DiscardTaskBranch = %+v; want a zero result", res)
+		}
+	})
+
+	t.Run("RefusedArchivePushDeletesNothing", func(t *testing.T) {
+		t.Parallel()
+		const slug = "discard-hook"
+		h, _ := discardHub(t, slug)
+		hook := "#!/bin/sh\nwhile read old new ref; do\n  case \"$ref\" in refs/tags/archive/*) echo \"archive tags refused\" >&2; exit 1;; esac\ndone\n"
+		if err := os.WriteFile(filepath.Join(h.CodeBare, "hooks", "pre-receive"), []byte(hook), 0o755); err != nil {
+			t.Fatalf("install pre-receive hook: %v", err)
+		}
+
+		_, err := h.Topology.DiscardTaskBranch(h.Location, slug)
+		if !errors.Is(err, fabricengine.ErrArchiveFailed) {
+			t.Fatalf("DiscardTaskBranch error = %v; want one wrapping ErrArchiveFailed", err)
+		}
+		if !gitkit.BranchExists(t, h.PrimeWorktree(), slug) {
+			t.Errorf("task branch %q gone locally; want it kept", slug)
+		}
+		if !gitkit.BranchExists(t, h.CodeBare, slug) {
+			t.Errorf("task branch %q gone from origin; want it kept", slug)
+		}
+	})
+}
+
+// TestDeleteArchivedTaskBranch pins the gates of the deletion half: a local tag that does not hold the tip refuses the local delete, the remote gate refuses the local-only archived-tip kind, and a stale lease fails and keeps the origin tip.
+func TestDeleteArchivedTaskBranch(t *testing.T) {
+	t.Parallel()
+
+	t.Run("LocalTagNotHoldingTheTipRefusesTheLocalDelete", func(t *testing.T) {
+		t.Parallel()
+		const slug = "dat-local"
+		h, tip := discardHub(t, slug)
+		base := gitkit.RevParse(t, h.PrimeWorktree(), slug+"~1")
+		const tag = "archive/dat-local/base"
+		gitkit.MustRun(t, h.PrimeWorktree(), "git", "tag", tag, base)
+
+		localDeleted, _, err := fabricengine.DeleteArchivedTaskBranchForTest(h.PrimeWorktree(), slug, tag, "", "")
+		if !RefusedByGate(err, fabricengine.CheckDirtiness) {
+			t.Fatalf("error = %v; want a CheckDirtiness refusal", err)
+		}
+		if localDeleted {
+			t.Errorf("localDeleted = true; want false")
+		}
+		if got := gitkit.RevParse(t, h.PrimeWorktree(), slug); got != tip {
+			t.Errorf("task branch = %q; want it kept at %q", got, tip)
+		}
+	})
+
+	t.Run("RemoteGateRefusesTheArchivedTipKind", func(t *testing.T) {
+		t.Parallel()
+		const slug = "dat-kind"
+		h, _ := discardHub(t, slug)
+		originTip := gitkit.RevParse(t, h.CodeBare, slug)
+
+		err := fabricengine.DeleteRemoteWithArchivedTipForTest(h.PrimeWorktree(), slug, "archive/dat-kind/x", originTip)
+		if !RefusedByGate(err, fabricengine.CheckDirtiness) {
+			t.Fatalf("error = %v; want a CheckDirtiness refusal", err)
+		}
+		if got := gitkit.RevParse(t, h.CodeBare, slug); got != originTip {
+			t.Errorf("origin task branch = %q; want unchanged %q", got, originTip)
+		}
+	})
+
+	t.Run("StaleLeaseFailsAndKeepsTheOriginTip", func(t *testing.T) {
+		t.Parallel()
+		const slug = "dat-stale"
+		h, _ := discardHub(t, slug)
+		staleTip := gitkit.RevParse(t, h.CodeBare, slug)
+		advanced := advanceOrigin(t, h, slug)
+
+		_, originDeleted, err := fabricengine.DeleteArchivedTaskBranchForTest(h.PrimeWorktree(), slug, "", "archive/dat-stale/x", staleTip)
+		if err == nil {
+			t.Fatal("error = nil; want a stale-lease failure")
+		}
+		if !strings.Contains(err.Error(), slug) {
+			t.Errorf("error %q does not name the branch %q", err, slug)
+		}
+		if originDeleted {
+			t.Errorf("originDeleted = true; want false")
+		}
+		if got := gitkit.RevParse(t, h.CodeBare, slug); got != advanced {
+			t.Errorf("origin task branch = %q; want the advanced tip %q", got, advanced)
+		}
+	})
+}
diff --git a/internal/pairteardown/cancel.go b/internal/pairteardown/cancel.go
new file mode 100644
index 00000000..4e1cfdcc
--- /dev/null
+++ b/internal/pairteardown/cancel.go
@@ -0,0 +1,269 @@
+// cancel.go holds the cancel phase of the teardown: it ends a pair's owned processes and strands first and waits for the run lock after, for a caller that ends the run instead of waiting for it.
+
+package pairteardown
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/reedengine"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengines"
+)
+
+// CancelLockWait is the bound on every wait of the cancel phase, and the one a caller's own lock and marker waits share with it.
+const CancelLockWait = runLockWait
+
+// CancelRequest names the pair a cancel ends and the caller's part of the phase.
+type CancelRequest struct {
+	// Slug names the pair.
+	Slug string
+	// Keep says the pair stays, so the loop lock is released with the teardown's mark withdrawn.
+	Keep bool
+	// AfterEnd runs once the pair's owned processes are ended, and takes the caller's own locks.
+	// A non-empty busy names a lock path still held; a hook that reports busy holds nothing, having released whatever it took.
+	// The caller releases whatever the hook took on every return of the phase, a refusal included.
+	// A nil hook takes nothing.
+	AfterEnd func() (busy string, err error)
+}
+
+// CancelResult reports what the cancel phase ended.
+type CancelResult struct {
+	// Ended lists the registered processes of the pair, and the processes below them, that the owner-record end signalled and found gone.
+	Ended []runproc.Ended
+	// StrandsStopped names the live strands of the task worktree that were stopped.
+	StrandsStopped []string
+	// SessionEnded is true when the session end ran.
+	SessionEnded bool
+	// TaskWorktreeGone is true when the task worktree was already gone, so no strand was stopped through shuttle.
+	TaskWorktreeGone bool
+}
+
+// EndForCancel ends the pair's registered processes and strands, then its loop and session, for a caller that ends the run for good.
+// It skips the quiet wait, the removal refusal probe and the pre-end run-lock wait, and waits for the run lock after the processes are ended.
+// With the task worktree present the order is: the owned-process end under the prime's and the pair's records write locks, the driver-lock probe, req.AfterEnd, the strand stop, the loop end, the run-lock wait and the session end;
+// with it gone, only the owned-process end, req.AfterEnd and the session end by name run.
+// A hook that reports busy gets the owned-process end and the probe once more, then the hook again; a lock still busy then is refused.
+// Every refusal wraps ErrDriverBusy where a busy holder caused it and names `lyx batten cancel <slug>` as the way to run the phase again.
+func (t *Teardown) EndForCancel(ctx context.Context, req CancelRequest) (CancelResult, error) {
+	var res CancelResult
+	gone, err := t.gone(req.Slug)
+	if err != nil {
+		return res, err
+	}
+	res.TaskWorktreeGone = gone
+	retry := cancelRetry(req.Slug)
+
+	endOwnedAndProbe := func() error {
+		if err := t.endOwnedUnderWriteLocks(req.Slug, &res); err != nil {
+			return err
+		}
+		if gone {
+			return nil
+		}
+		held, err := t.driverLockHeld(req.Slug)
+		if err != nil {
+			return err
+		}
+		if held {
+			return t.driverLockBusyError(req.Slug, retry)
+		}
+		return nil
+	}
+
+	if err := endOwnedAndProbe(); err != nil {
+		return res, err
+	}
+	if req.AfterEnd != nil {
+		busy, err := req.AfterEnd()
+		if err != nil {
+			return res, err
+		}
+		if busy != "" {
+			if err := endOwnedAndProbe(); err != nil {
+				return res, err
+			}
+			busy, err = req.AfterEnd()
+			if err != nil {
+				return res, err
+			}
+			if busy != "" {
+				return res, fmt.Errorf("%w: %s is still held after the run's processes were ended: a batten of %s or \"lyx batten cleanup\" may hold it; see the holder with \"lyx tender status\" or \"ps\", or in Task Manager on Windows, and run \"lyx batten cancel %s\" again once it is free",
+					ErrDriverBusy, busy, req.Slug, req.Slug)
+			}
+		}
+	}
+
+	var releaseLoopLock func(sessionEnded bool) error
+	if !gone {
+		res.StrandsStopped, err = t.stopStrands(req.Slug)
+		if err != nil {
+			return res, fmt.Errorf("stop the pair's strands: %w; for this cancel, run %s again", err, retry)
+		}
+		releaseLoopLock, err = t.seizeLoop(ctx, req.Slug, func() (bool, error) { return t.killLoop(req.Slug) })
+		if err != nil {
+			return res, cancelAgain(err, req.Slug)
+		}
+		if err := t.awaitRunLock(ctx, req.Slug); err != nil {
+			return res, errors.Join(cancelAgain(err, req.Slug), releaseLoopLock(false))
+		}
+	}
+
+	ended, abandoned, err := t.endSession(req.Slug, gone)
+	res.SessionEnded = ended
+	if abandoned != "" {
+		logger.Warn("pairteardown: a foreign session was left alone by the cancel's session end", "slug", req.Slug, "session", abandoned)
+	}
+	if releaseLoopLock != nil {
+		err = errors.Join(err, releaseLoopLock(err == nil && !req.Keep))
+	}
+	if err != nil {
+		return res, err
+	}
+	logger.Info("pairteardown: cancel ended the pair", "slug", req.Slug, "ended_processes", len(res.Ended), "strands_stopped", len(res.StrandsStopped), "task_worktree_gone", gone)
+	return res, nil
+}
+
+// cancelRetry names the command that runs the cancel phase again, the way forward of every refusal the phase raises.
+func cancelRetry(slug string) string {
+	return fmt.Sprintf("`lyx batten cancel %s`", slug)
+}
+
+// cancelAgain wraps err, which names retrying the removal, with the cancel's own re-entry.
+func cancelAgain(err error, slug string) error {
+	return fmt.Errorf("%w; for this cancel, run \"lyx batten cancel %s\" again once the holder ends", err, slug)
+}
+
+// endOwnedUnderWriteLocks ends the pair's registered processes under the records write locks and releases the locks as soon as the end returns.
+// The ended processes are added to res.
+func (t *Teardown) endOwnedUnderWriteLocks(slug string, res *CancelResult) error {
+	release, err := t.holdWriteLocks(slug)
+	if err != nil {
+		return err
+	}
+	ended, endErr := t.endOwned(slug)
+	releaseErr := release()
+	res.Ended = append(res.Ended, ended...)
+
+	var survivors *runproc.SurvivorsError
+	switch {
+	case errors.As(endErr, &survivors):
+		return errors.Join(cancelSurvivorsError(slug, survivors.Survivors, t.goos), releaseErr)
+	case endErr != nil:
+		return errors.Join(fmt.Errorf("end the pair's registered processes: %w", endErr), releaseErr)
+	}
+	return releaseErr
+}
+
+// cancelSurvivorsError builds the ErrDriverBusy refusal for registered processes that survived the cancel's end.
+// It names each survivor and the way to find and end it on goos, then `lyx batten cancel <slug>` again.
+func cancelSurvivorsError(slug string, survivors []runproc.Ended, goos string) error {
+	find := "find and end them with `lyx tender status` and `ps`"
+	if goos == "windows" {
+		find = "find and end them in Task Manager"
+	}
+	return fmt.Errorf("%w: processes of pair %q survived the end: %s; %s, then run %s again", ErrDriverBusy, slug, survivorNames(survivors), find, cancelRetry(slug))
+}
+
+// holdRecordsWriteLocks takes the prime's records write lock and, while the pair's records worktree stands, the pair's, each bounded by t.writeLockWait.
+// The returned release drops what was taken.
+// A lock still held at the bound releases what was taken and refuses with an ErrDriverBusy that names the lock's path.
+func (t *Teardown) holdRecordsWriteLocks(slug string) (release func() error, err error) {
+	worktrees := []string{fabricengine.RecordsWorktree(t.prime)}
+	if pair := fabricengine.RecordsWorktreePath(t.prime, slug); fileExists(pair) {
+		worktrees = append(worktrees, pair)
+	}
+
+	var releases []func() error
+	releaseAll := func() error {
+		var errs []error
+		for i := len(releases) - 1; i >= 0; i-- {
+			errs = append(errs, releases[i]())
+		}
+		return errors.Join(errs...)
+	}
+	for _, worktree := range worktrees {
+		releaseOne, held, err := fabricengine.HoldRecordsWriteLock(worktree, t.writeLockWait)
+		if err != nil {
+			return nil, errors.Join(err, releaseAll())
+		}
+		if !held {
+			return nil, errors.Join(writeLockBusyError(slug, fabricengine.RecordsLockDirPath(worktree)), releaseAll())
+		}
+		releases = append(releases, releaseOne)
+	}
+	return releaseAll, nil
+}
+
+// writeLockBusyError builds the ErrDriverBusy refusal for a records write lock still held at the bound, naming its directory and the way forward.
+// The prime's lock is shared by the hub, so its holder is often another run's or the orch's healthy commit; ending it is the last resort.
+func writeLockBusyError(slug, lockDir string) error {
+	return fmt.Errorf("%w: the records write lock in %s is held; see the holder with `lyx tender status` or `ps`, or in Task Manager on Windows, and run %s again once it lets go, ending the holder only when the same process keeps the lock across re-runs",
+		ErrDriverBusy, lockDir, cancelRetry(slug))
+}
+
+// stopPairStrands stops every live strand of the present task worktree through shuttle's stop verb and returns their names.
+// A strand stopped before a failure stays in the returned names.
+func (t *Teardown) stopPairStrands(slug string) ([]string, error) {
+	task, err := t.taskLocation(slug)
+	if err != nil {
+		return nil, err
+	}
+	reed, err := t.reedEngine(task)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := reed.Directory()
+	if err != nil {
+		return nil, err
+	}
+	guids, names := liveStrandGUIDs(rows)
+	if len(guids) == 0 {
+		return nil, nil
+	}
+
+	configDirs := fabricengine.ConfigDirs(task)
+	shuttleCfg, err := shuttleengine.LoadConfig(configDirs, "shuttle")
+	if err != nil {
+		return nil, err
+	}
+	engines, err := shuttleengines.New(shuttleCfg, configDirs)
+	if err != nil {
+		return nil, err
+	}
+	geom, err := hubgeom.ReedGeometry(task)
+	if err != nil {
+		return nil, err
+	}
+	pauseGeom, err := hubgeom.PauseGeometry(task)
+	if err != nil {
+		return nil, err
+	}
+	runner := shuttleengine.NewRunner(reed, engines, geom.AnchorPath, geom.WorktreeRoot, shuttleCfg)
+	runner.SetPause(pauseGeom)
+
+	var stopped []string
+	for i, guid := range guids {
+		if err := runner.StopStrand(guid); err != nil {
+			return stopped, fmt.Errorf("stop strand %s: %w", names[i], err)
+		}
+		stopped = append(stopped, names[i])
+	}
+	return stopped, nil
+}
+
+// liveStrandGUIDs returns the guid and the name of every live row, in row order, whatever the row's name.
+func liveStrandGUIDs(rows []reedengine.DirectoryRow) (guids, names []string) {
+	for _, row := range rows {
+		if row.Live {
+			guids = append(guids, row.GUID)
+			names = append(names, row.Name)
+		}
+	}
+	return guids, names
+}
diff --git a/internal/pairteardown/cancel_test.go b/internal/pairteardown/cancel_test.go
new file mode 100644
index 00000000..785b365b
--- /dev/null
+++ b/internal/pairteardown/cancel_test.go
@@ -0,0 +1,336 @@
+// cancel_test.go pins the cancel phase: its call order over the fake substrates, the records write lock hold, and the live-strand pick.
+
+package pairteardown
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/reedengine"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/testkit/locationkit"
+)
+
+// hookAnswer is one call's answer of the cancel request's AfterEnd hook.
+type hookAnswer struct {
+	busy string
+	err  error
+}
+
+// TestEndForCancel drives the cancel phase through the fake substrates and pins which substrate calls it makes, in what order, and what it returns.
+// A refusal row's calls end at the refusing step, so nothing after it ran.
+func TestEndForCancel(t *testing.T) {
+	t.Parallel()
+
+	survivors := []runproc.Ended{{PID: 4242, Role: runproc.RoleLoop}}
+	const presentHead = "holdWriteLocks,endOwned,release,driverLock,afterEnd"
+	const refusalTail = "lyx batten cancel slug"
+	tests := []struct {
+		name string
+		gone bool
+		keep bool
+		// hooks answers each AfterEnd call in turn; a request with no hooks has a nil AfterEnd.
+		hooks                 []hookAnswer
+		writeLockBusy         bool
+		endOwnedErr           error
+		driverLockHeldByProbe []bool
+		driverLockHeld        bool
+		awaitErr              error
+		strands               []string
+		wantCalls             string
+		wantErrIs             error
+		wantAnyError          bool
+		wantErrContains       []string
+		wantResult            CancelResult
+	}{
+		{
+			name:       "PresentPairKeptWithdrawsTheTeardownMark",
+			keep:       true,
+			hooks:      []hookAnswer{{}},
+			strands:    []string{"tst:slug:driver"},
+			wantCalls:  presentHead + ",stopStrands,kill,seize,await,end,release(ended=false)",
+			wantResult: CancelResult{StrandsStopped: []string{"tst:slug:driver"}, SessionEnded: true},
+		},
+		{
+			name:       "PresentPairRemovedKeepsTheTeardownMark",
+			hooks:      []hookAnswer{{}},
+			wantCalls:  presentHead + ",stopStrands,kill,seize,await,end,release(ended=true)",
+			wantResult: CancelResult{SessionEnded: true},
+		},
+		{
