+						t.Errorf("attempt record halt = %q; want %q", rec.Halt, fixerHaltOverCap)
+					}
+				}
+				if want := []string{"t2..f1"}; strings.Join(fx.lineChangeCalls, ",") != strings.Join(want, ",") {
