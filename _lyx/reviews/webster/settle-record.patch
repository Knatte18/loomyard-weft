+			got[entry.Slug] = entry.State
+		}
+		want := map[string]fabricengine.EntryState{"stopped": fabricengine.EntryStopped, "active": fabricengine.EntryActive}
+		if len(got) != len(want) || got["stopped"] != want["stopped"] || got["active"] != want["active"] {
+			t.Errorf("entries = %v; want %v, with none for the pair without a run record", got, want)
+		}
+	})
+
+	t.Run("classifyEntry puts ended over every branch cause and a D3 stop over active", func(t *testing.T) {
+		for _, tt := range []struct {
+			name  string
+			facts fabricengine.EntryFactsForTest
+			want  fabricengine.EntryState
+		}{
+			{"ended over a stopping branch", fabricengine.EntryFactsForTest{Ended: true, Branches: []fabricengine.BranchState{fabricengine.BranchDirty}}, fabricengine.EntryEnded},
+			{"ended over a D3 stop", fabricengine.EntryFactsForTest{Ended: true, D3Stop: true}, fabricengine.EntryEnded},
+			{"a D3 stop over level branches", fabricengine.EntryFactsForTest{D3Stop: true, Branches: []fabricengine.BranchState{fabricengine.BranchLevel}}, fabricengine.EntryStopped},
+			{"a diverged branch", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchLevel, fabricengine.BranchDiverged}}, fabricengine.EntryStopped},
+			{"a rewound branch", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchRewound}}, fabricengine.EntryStopped},
+			{"a rewritten branch", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchRewritten}}, fabricengine.EntryStopped},
+			{"a gone branch", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchGone}}, fabricengine.EntryStopped},
+			{"a busy branch", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchBusy}}, fabricengine.EntryStopped},
+			{"a live pair's branch", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchLive}}, fabricengine.EntryStopped},
+			{"branches that never stop", fabricengine.EntryFactsForTest{Branches: []fabricengine.BranchState{fabricengine.BranchLevel, fabricengine.BranchFastForward, fabricengine.BranchAhead, fabricengine.BranchNeedsReplay}}, fabricengine.EntryActive},
+			{"no branch", fabricengine.EntryFactsForTest{}, fabricengine.EntryActive},
+		} {
+			if got := fabricengine.ClassifyEntryForTest(tt.facts); got != tt.want {
+				t.Errorf("%s: classifyEntry(%+v) = %q; want %q", tt.name, tt.facts, got, tt.want)
+			}
+		}
+	})
+}
+
+// rewoundBranch is a task branch whose origin was reset back to base past first and second, by another machine.
+type rewoundBranch struct {
+	hub           *originHub
+	worktree      string
+	branch        string
+	base          string
+	first, second string
+}
+
+// newRewoundBranch builds a hub with a pair whose branch carries two pushed commits that another machine's leased update then dropped from origin.
+// With withLocal the pair also holds one commit that was never pushed.
+func newRewoundBranch(t *testing.T, withLocal bool) rewoundBranch {
+	t.Helper()
+	hub := newOriginHub(t)
+	worktree, branch := originPair(t, hub, "task")
+	base := gitkit.RevParse(t, worktree, "HEAD")
+	first := gitkit.CommitFile(t, worktree, "one.txt", "one", "one")
+	second := gitkit.CommitFile(t, worktree, "two.txt", "two", "two")
+	gitkit.Git(t, worktree, "push", "origin", branch)
+	other := otherMachine(t, hub.CodeBare, branch)
+	gitkit.Git(t, other, "push", "--force-with-lease=refs/heads/"+branch+":"+second, "origin", base+":refs/heads/"+branch)
+	if withLocal {
+		gitkit.CommitFile(t, worktree, "local.txt", "local", "local only")
+	}
+	return rewoundBranch{hub: hub, worktree: worktree, branch: branch, base: base, first: first, second: second}
+}
diff --git a/internal/fabricengine/originreconcileended.go b/internal/fabricengine/originreconcileended.go
new file mode 100644
index 00000000..ecb182c3
--- /dev/null
+++ b/internal/fabricengine/originreconcileended.go
@@ -0,0 +1,206 @@
+// originreconcileended.go holds the origin reconcile's ended-entries half.
+// It tears down, through the injected seam, the local pair of each run origin has ended, and clears the failed-push records of branches that are no longer local.
+
+package fabricengine
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+)
+
+// resolvePrime returns the location of the hub's prime worktree.
+func resolvePrime(l *lyxcwd.Location) (*lyxcwd.Location, error) {
+	primeName, err := PrimeName(l)
+	if err != nil {
+		return nil, err
+	}
+	return lyxcwd.ResolveWorktree(filepath.Join(l.HubPath, primeName))
+}
+
+// recordedRuns returns the slugs of the runs this machine holds a batten run record of at the prime, in order.
+// The run scope reads only its own run.
+func recordedRuns(l *lyxcwd.Location, scope ReconcileScope) ([]string, error) {
+	prime, err := resolvePrime(l)
+	if err != nil {
+		return nil, err
+	}
+	candidates := []string{scope.Run}
+	if scope.Run == "" {
+		dirs, err := os.ReadDir(shedrun.RunsRoot(prime))
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		candidates = candidates[:0]
+		for _, dir := range dirs {
+			if dir.IsDir() && !shedrun.IsReserved(dir.Name()) {
+				candidates = append(candidates, dir.Name())
+			}
+		}
+	}
+
+	var runs []string
+	for _, slug := range candidates {
+		_, found, err := readRunStatusRows(shedrun.StatusFile(prime, slug))
+		if err != nil {
+			return nil, err
+		}
+		if found {
+			runs = append(runs, slug)
+		}
+	}
+	return runs, nil
+}
+
+// onlyRuns returns the part of ended whose slugs are among runs.
+// A run only a replayed commit touched has no batten run record on this machine and is never classified.
+func onlyRuns(ended EndedSet, runs []string) EndedSet {
+	kept := EndedSet{}
+	for slug, how := range ended {
+		if slices.Contains(runs, slug) {
+			kept[slug] = how
+		}
+	}
+	return kept
+}
+
+// pairHasLocalPart reports whether this machine holds any part of slug's pair: its task worktree path, its sibling worktree path, its launchers or either local branch.
+// A branch counts when it is named by the slug alone.
+func pairHasLocalPart(l *lyxcwd.Location, slug string) (bool, error) {
+	if pathPresent(WorktreePath(l, slug)) || pathPresent(RecordsWorktreePath(l, slug)) || pathPresent(LauncherDir(l, slug)) {
+		return true, nil
+	}
+	taskBranch, err := localBranchExists(l.WorktreePath(), slug)
+	if err != nil {
+		return false, err
+	}
+	return taskBranch || weftBranchExists(l, RecordsBranchName(slug)), nil
+}
+
+// busyWayForward names what lets a removal that found its pair busy go through at the next run.
+func busyWayForward(busyOn string) string {
+	if busyOn == BusyOnDriver {
+		return "wait for the pair's driver to end, which the run's next Merge-In or Finalize makes certain by stopping it with Halt, then re-run `lyx cleanup --apply`"
+	}
+	return "wait for the holder of the pair's teardown or weft write lock to release it, then re-run `lyx cleanup --apply`"
+}
+
+// reconcileEnded applies the removal of an ended run to each entry of ended, in slug order, and reports each one in res.Entries as ended.
+// ended holds only runs with a batten run record and none this machine's own landing has reached.
+// An entry with a local part of its pair is handed to seams.Teardown with the slug and whether an earlier run left a snapshot tag; one with none is reported with no teardown and no network call.
+// A busy teardown leaves the pair, and the entry is ended with the busy flag; any other teardown error is on the entry, and no other entry is stopped by it.
+// A judge-only scope, and the run scope's own run, whose driver is the caller, tear nothing down.
+// A nil Teardown seam tears nothing down either.
+// Each teardown's mutations are appended to res's record.
+func reconcileEnded(l *lyxcwd.Location, scope ReconcileScope, seams OriginSeams, ended EndedSet, res *OriginReport) error {
+	for _, slug := range sortedSlugs(ended) {
+		entry := EntryOutcome{Slug: slug, State: EntryEnded, How: ended[slug]}
+		local, err := pairHasLocalPart(l, slug)
+		if err != nil {
+			return fmt.Errorf("fabricengine: read whether this machine holds the pair %s: %w", slug, err)
+		}
+		entry.Local = local
+
+		if local && !scope.JudgeOnly && scope.Run != slug && seams.Teardown != nil {
+			earlier, err := SnapshotTagged(l, slug)
+			if err != nil {
+				return fmt.Errorf("fabricengine: read whether pair %s holds a snapshot tag: %w", slug, err)
+			}
+			report, err := seams.Teardown(EndedTeardown{Slug: slug, EarlierSnapshot: earlier})
+			res.Mutations.Extend(report.Mutations)
+			entry.Tags = report.Tags
+			entry.Kept = report.Kept
+			if err == nil {
+				err = report.Error
+			}
+			switch {
+			case report.Busy:
+				entry.Busy = true
+				entry.WayForward = busyWayForward(report.BusyOn)
+			case err != nil:
+				entry.Error = err.Error()
+			default:
+				entry.Removed = true
+			}
+		}
+		res.Entries = append(res.Entries, entry)
+	}
+	return nil
+}
+
+// endedLocalSlugs returns the slugs of the entries a teardown was applied to, other than run's own.
+func endedLocalSlugs(entries []EntryOutcome, run string) map[string]bool {
+	slugs := map[string]bool{}
+	for _, entry := range entries {
+		if entry.Local && entry.Slug != run {
+			slugs[entry.Slug] = true
+		}
+	}
+	return slugs
+}
+
+// withoutRemovedPairs returns branches without those of a pair an ended entry shows removed.
+func withoutRemovedPairs(branches []BranchOutcome, entries []EntryOutcome) []BranchOutcome {
+	removed := map[string]bool{}
+	for _, entry := range entries {
+		if entry.Removed {
+			removed[entry.Slug] = true
+		}
+	}
+	if len(removed) == 0 {
+		return branches
+	}
+	kept := make([]BranchOutcome, 0, len(branches))
+	for _, branch := range branches {
+		if !removed[branch.Slug] {
+			kept = append(kept, branch)
+		}
+	}
+	return kept
+}
+
+// mergeEndedEntries returns classified with each slug an ended entry covers taken from ended, and the ended entries of no classified slug after them.
+func mergeEndedEntries(classified, ended []EntryOutcome) []EntryOutcome {
+	merged := slices.Clone(classified)
+	for _, entry := range ended {
+		if i := slices.IndexFunc(merged, func(candidate EntryOutcome) bool { return candidate.Slug == entry.Slug }); i >= 0 {
+			merged[i] = entry
+			continue
+		}
+		merged = append(merged, entry)
+	}
+	sort.SliceStable(merged, func(i, j int) bool { return merged[i].Slug < merged[j].Slug })
+	return merged
+}
+
+// clearStalePushFailures removes every failed-push record of the hub whose branch is no longer local.
+func clearStalePushFailures(hubPath string) error {
+	failures, err := ListFailedPushes(hubPath)
+	if err != nil {
+		return err
+	}
+	for _, failure := range failures {
+		local := false
+		if _, statErr := os.Stat(failure.RepoPath); statErr == nil {
+			if local, err = gitrepo.New(failure.RepoPath).BranchExists(failure.Branch); err != nil {
+				return err
+			}
+		}
+		if local {
+			continue
+		}
+		if err := ClearPushFailure(hubPath, failure.Repo, failure.Branch); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/internal/fabricengine/originreconcileended_integration_test.go b/internal/fabricengine/originreconcileended_integration_test.go
new file mode 100644
index 00000000..3f38a888
--- /dev/null
+++ b/internal/fabricengine/originreconcileended_integration_test.go
@@ -0,0 +1,409 @@
+//go:build integration
+
+// originreconcileended_integration_test.go proves what the origin reconcile does with the runs origin has ended, on hubforge hubs.
+// The teardown seam is a recording fake, since the local removal's own effects belong to the removal.
+//
+// Package fabricengine_test; shares the single TestMain in testmain_test.go.
+
+package fabricengine_test
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/testkit/boardkit"
+)
+
+// teardownRecorder is a teardown seam that records each request and answers with reply.
+// A nil reply removes the pair without a word.
+type teardownRecorder struct {
+	calls []fabricengine.EndedTeardown
+	reply func(fabricengine.EndedTeardown) (fabricengine.TeardownReport, error)
+}
+
+func (r *teardownRecorder) seams() fabricengine.OriginSeams {
+	return fabricengine.OriginSeams{Teardown: func(request fabricengine.EndedTeardown) (fabricengine.TeardownReport, error) {
+		r.calls = append(r.calls, request)
+		if r.reply == nil {
+			return fabricengine.TeardownReport{}, nil
+		}
+		return r.reply(request)
+	}}
+}
+
+// slugsCalled returns the slug of each request, in order.
+func (r *teardownRecorder) slugsCalled() []string {
+	slugs := make([]string, 0, len(r.calls))
+	for _, call := range r.calls {
+		slugs = append(slugs, call.Slug)
+	}
+	return slugs
+}
+
+// tagMutation returns a record holding one created set-aside tag.
+func tagMutation(hub *originHub, tag string) fabricengine.MutationRecord {
+	rec := fabricengine.NewMutations(hub.Location.HubPath)
+	rec.AppendRef(fabricengine.KindTagCreated, tag, "")
+	return fabricengine.MutationRecord{Mutations: rec.Snapshot()}
+}
+
+// publishBoard commits a board holding entries at the board checkout, pushes it and returns the Bolt branch.
+func publishBoard(t *testing.T, hub *originHub, entries ...boardengine.Task) string {
+	t.Helper()
+	board := hub.BoardDir()
+	branch := gitkit.CurrentBranch(t, board)
+	gitkit.CommitFile(t, board, "board.json", boardFileOf(t, entries...), "base board")
+	gitkit.Git(t, board, "push", "origin", branch)
+	return branch
+}
+
+// originBoard has origin's Bolt hold entries.
+func originBoard(t *testing.T, hub *originHub, branch string, entries ...boardengine.Task) {
+	t.Helper()
+	originCommitFile(t, hub.RecordsBare, branch, "board.json", boardFileOf(t, entries...))
+}
+
+// writePairStatus gives the pair slug its own run status, with the current producer and the history rows named.
+func writePairStatus(t *testing.T, hub *originHub, slug, producer string, history ...string) {
+	t.Helper()
+	path := filepath.Join(hub.PairCodeWorktree(slug), "_lyx", "shed", slug, "status.json")
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("mkdir for %s: %v", path, err)
+	}
+	if err := os.WriteFile(path, []byte(statusJSON(producer, history...)), 0o644); err != nil {
+		t.Fatalf("write %s: %v", path, err)
+	}
+}
+
+// endedHub is a hub with the pairs slugs, each holding a batten run record at the prime before its Finalize, whose board origin has marked done.
+func endedHub(t *testing.T, slugs ...string) (*originHub, string) {
+	t.Helper()
+	hub := newOriginHub(t)
+	var live, done []boardengine.Task
+	for _, slug := range slugs {
+		originPair(t, hub, slug)
+		writeStatus(t, hub, slug, "Implementer")
+		live = append(live, boardEntry(slug))
+		done = append(done, boardEntry(slug, withBoardStatus("done")))
+	}
+	branch := publishBoard(t, hub, live...)
+	originBoard(t, hub, branch, done...)
+	return hub, branch
+}
+
+// TestReconcileOrigin_Ended covers the origin reconcile's handling of runs origin has ended: which entries it ends, what it hands the teardown seam and how it reports each outcome.
+// It runs without t.Parallel because it sets the process-global origin call hook.
+func TestReconcileOrigin_Ended(t *testing.T) {
+	boardkit.InstallReplay(t)
+
+	t.Run("An entry done on origin with a local pair is handed to the teardown seam once and reported ended as landed", func(t *testing.T) {
+		hub, _ := endedHub(t, "task")
+		recorder := &teardownRecorder{reply: func(fabricengine.EndedTeardown) (fabricengine.TeardownReport, error) {
+			return fabricengine.TeardownReport{MutationRecord: tagMutation(hub, "set-aside/task/abc"), Tags: []string{"set-aside/task/abc"}, Kept: []string{"branch task: unlanded"}}, nil
+		}}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if got := recorder.slugsCalled(); !slices.Equal(got, []string{"task"}) {
+			t.Fatalf("teardown calls = %v; want one call for task", got)
+		}
+		if recorder.calls[0].EarlierSnapshot || recorder.calls[0].Force {
+			t.Errorf("teardown request = %+v; want no earlier snapshot and no force", recorder.calls[0])
+		}
+		entry := requireEntry(t, report, "task", fabricengine.EntryEnded)
+		if entry.How != "done" || !entry.Local || !entry.Removed || entry.Busy || entry.Error != "" {
+			t.Errorf("entry = %+v; want ended as done, local and removed", entry)
+		}
+		if !slices.Equal(entry.Tags, []string{"set-aside/task/abc"}) || !slices.Equal(entry.Kept, []string{"branch task: unlanded"}) {
+			t.Errorf("entry Tags = %v, Kept = %v; want the seam report's", entry.Tags, entry.Kept)
+		}
+		if got := kindCount(report, fabricengine.KindTagCreated); got != 1 {
+			t.Errorf("tag_created entries = %d; want the seam's one in the report's record", got)
+		}
+		for _, branch := range report.Branches {
+			if branch.Slug == "task" {
+				t.Errorf("branch %q of the removed pair is still reported", branch.Branch)
+			}
+		}
+		if !strings.Contains(report.Summary(), "ended: ") {
+			t.Errorf("Summary = %q; want the ended entries listed", report.Summary())
+		}
+	})
+
+	t.Run("An ended entry with a run record and no local pair is ended with no seam call and no error", func(t *testing.T) {
+		hub := newOriginHub(t)
+		writeStatus(t, hub, "ghost", "Implementer")
+		branch := publishBoard(t, hub, boardEntry("ghost"))
+		originBoard(t, hub, branch, boardEntry("ghost", withBoardStatus("done")))
+		recorder := &teardownRecorder{}
+		var calls callLog
+		t.Cleanup(fabricengine.SetOriginCallHookForTest(calls.record))
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if len(recorder.calls) != 0 {
+			t.Errorf("teardown calls = %v; want none for a run with no local pair", recorder.slugsCalled())
+		}
+		entry := requireEntry(t, report, "ghost", fabricengine.EntryEnded)
+		if entry.Local || entry.Removed || entry.Busy || entry.Error != "" {
+			t.Errorf("entry = %+v; want ended with nothing local, nothing removed and no error", entry)
+		}
+		if got := len(calls.withVerb("ls-remote")); got != 2 {
+			t.Errorf("ls-remote calls = %d; want 2", got)
+		}
+		if strings.Contains(report.Summary(), "ghost") {
+			t.Errorf("Summary = %q; want an entry with no local pair left out", report.Summary())
+		}
+	})
+
+	t.Run("A hub reconcile ends a pair at Finalize before its parent merge although it fast-forwards the parent", func(t *testing.T) {
+		hub, _ := endedHub(t, "task")
+		writePairStatus(t, hub, "task", "Finalize")
+		gitkit.CommitFile(t, hub.PairCodeWorktree("task"), "feature.txt", "task work\n", "task work")
+		originCommitFile(t, hub.CodeBare, hub.primeBranch, "moved.txt", "moved")
+		recorder := &teardownRecorder{}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if got := recorder.slugsCalled(); !slices.Equal(got, []string{"task"}) {
+			t.Errorf("teardown calls = %v; want one call for task", got)
+		}
+		if prime := branchOf(t, report, "code", hub.primeBranch); !prime.Moved {
+			t.Errorf("prime code branch = %+v; want it fast-forwarded in the same reconcile", prime)
+		}
+	})
+
+	t.Run("A pair whose Finalize passed its parent merge is not ended", func(t *testing.T) {
+		hub, _ := endedHub(t, "task")
+		writePairStatus(t, hub, "task", "Land", "Finalize")
+		recorder := &teardownRecorder{}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if len(recorder.calls) != 0 {
+			t.Errorf("teardown calls = %v; want none for a landing on this machine", recorder.slugsCalled())
+		}
+		requireEntry(t, report, "task", fabricengine.EntryActive)
+	})
+
+	t.Run("An entry removed from origin's board is ended as removed", func(t *testing.T) {
+		hub := newOriginHub(t)
+		originPair(t, hub, "task")
+		writeStatus(t, hub, "task", "Implementer")
+		branch := publishBoard(t, hub, boardEntry("task"), boardEntry("keep"))
+		originBoard(t, hub, branch, boardEntry("keep"))
+		recorder := &teardownRecorder{}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		entry := requireEntry(t, report, "task", fabricengine.EntryEnded)
+		if entry.How != "removed" || !entry.Removed {
+			t.Errorf("entry = %+v; want ended as removed and torn down", entry)
+		}
+		if got := recorder.slugsCalled(); !slices.Equal(got, []string{"task"}) {
+			t.Errorf("teardown calls = %v; want one call for task", got)
+		}
+	})
+
+	t.Run("A busy teardown leaves the pair, the entry ended with the busy flag and the way forward the wait names", func(t *testing.T) {
+		for _, row := range []struct {
+			name, busyOn string
+			want         []string
+		}{
+			{"driver", fabricengine.BusyOnDriver, []string{"driver to end", "lyx cleanup --apply"}},
+			{"lock", fabricengine.BusyOnLock, []string{"lock", "lyx cleanup --apply"}},
+		} {
+			t.Run(row.name, func(t *testing.T) {
+				hub, _ := endedHub(t, "task")
+				recorder := &teardownRecorder{reply: func(fabricengine.EndedTeardown) (fabricengine.TeardownReport, error) {
+					return fabricengine.TeardownReport{Busy: true, BusyOn: row.busyOn}, nil
+				}}
+
+				report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+				entry := requireEntry(t, report, "task", fabricengine.EntryEnded)
+				if !entry.Busy || entry.Removed {
+					t.Errorf("entry = %+v; want ended, busy and not removed", entry)
+				}
+				for _, text := range row.want {
+					if !strings.Contains(entry.WayForward, text) || !strings.Contains(report.Summary(), text) {
+						t.Errorf("WayForward = %q, Summary = %q; want both to name %q", entry.WayForward, report.Summary(), text)
+					}
+				}
+			})
+		}
+	})
+
+	t.Run("A teardown failing with another error is ended with the error and a second entry is still handed to the seam", func(t *testing.T) {
+		hub, _ := endedHub(t, "task", "two")
+		recorder := &teardownRecorder{reply: func(request fabricengine.EndedTeardown) (fabricengine.TeardownReport, error) {
+			if request.Slug == "task" {
+				return fabricengine.TeardownReport{}, errors.New("boom")
+			}
+			return fabricengine.TeardownReport{}, nil
+		}}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if got := recorder.slugsCalled(); !slices.Equal(got, []string{"task", "two"}) {
+			t.Fatalf("teardown calls = %v; want both entries handed to the seam", got)
+		}
+		failed := requireEntry(t, report, "task", fabricengine.EntryEnded)
+		if failed.Error != "boom" || failed.Removed || failed.Busy {
+			t.Errorf("entry task = %+v; want ended with the error, not removed and not busy", failed)
+		}
+		if two := requireEntry(t, report, "two", fabricengine.EntryEnded); !two.Removed {
+			t.Errorf("entry two = %+v; want it removed", two)
+		}
+		if summary := report.Summary(); !strings.Contains(summary, "boom") || !strings.Contains(summary, "`lyx cleanup --apply` retries the removal") {
+			t.Errorf("Summary = %q; want the error and the retry named", summary)
+		}
+	})
+
+	t.Run("An entry only local Bolt holds is not ended and its pair is not torn down", func(t *testing.T) {
+		hub := newOriginHub(t)
+		originPair(t, hub, "mine")
+		writePairStatus(t, hub, "mine", "Implementer")
+		writeStatus(t, hub, "mine", "Implementer")
+		board := hub.BoardDir()
+		branch := publishBoard(t, hub, boardEntry("keep"))
+		gitkit.CommitFile(t, board, "board.json", boardFileOf(t, boardEntry("keep"), boardEntry("mine")), "mine, local only")
+		originBoard(t, hub, branch, boardEntry("keep", withBoardTitle("origin")))
+		recorder := &teardownRecorder{}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if len(recorder.calls) != 0 {
+			t.Errorf("teardown calls = %v; want none", recorder.slugsCalled())
+		}
+		if entry := entryOf(t, report, "mine"); entry.State == fabricengine.EntryEnded {
+			t.Errorf("entry mine = %+v; want it not ended", entry)
+		}
+	})
+
+	t.Run("A pair with no run record and no board entry is never torn down", func(t *testing.T) {
+		hub := newOriginHub(t)
+		originPair(t, hub, "plain")
+		branch := publishBoard(t, hub, boardEntry("keep"))
+		originBoard(t, hub, branch, boardEntry("keep", withBoardTitle("origin")))
+		recorder := &teardownRecorder{}
+
+		report := moveReconcile(t, hub, fabricengine.ReconcileScope{}, recorder.seams())
+
+		if len(recorder.calls) != 0 {
+			t.Errorf("teardown calls = %v; want none", recorder.slugsCalled())
+		}
+		if len(report.Entries) != 0 {
+			t.Errorf("entries = %+v; want none for a pair with no run record", report.Entries)
+		}
+	})
+
+	t.Run("The run scope ends its own run like any other and calls no teardown", func(t *testing.T) {
+		for _, row := range []struct {
+			name      string
+			merged    bool
+			wantEnded bool
+		}{
+			{"a parent lacking the task's work is the landing another machine made", false, true},
+			{"a parent the run's own Finalize merged into is the re-entry after its done mark", true, false},
+		} {
+			t.Run(row.name, func(t *testing.T) {
+				hub, _ := endedHub(t, "task")
+				writePairStatus(t, hub, "task", "Finalize")
