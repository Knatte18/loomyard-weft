+	runLogMaxAge  = 14 * 24 * time.Hour
+
+	tierTimeoutPrefix = "lyx gate test: tier timeout: "
+	tierTimeoutMid    = " exceeded timeout_min "
+)
+
+var tierSummaryPattern = regexp.MustCompile(`^gate test: tier(\d+) .* discovered \d+ passed \d+ failed \d+ skipped \d+ wall \S+s exit (-?\d+) log .*$`)
+
+// RunRecord is the diagnostic record of one tier run.
+// It is a domain log: no run reads it to proceed.
+type RunRecord struct {
+	Worktree string `json:"worktree"`
+	// Slug is the task slug of the worktree, empty when it has none.
+	Slug      string    `json:"slug"`
+	TierList  []int     `json:"tier_list"`
+	Tier      int       `json:"tier"`
+	Command   string    `json:"command"`
+	RunDir    string    `json:"run_dir"`
+	ScopeForm string    `json:"scope_form"`
+	Slots     int       `json:"slots"`
+	WaitStart time.Time `json:"wait_start"`
+	Start     time.Time `json:"start"`
+	End       time.Time `json:"end"`
+	WallSec   float64   `json:"wall_seconds"`
+	ExitCode  int       `json:"exit_code"`
+	TimedOut  bool      `json:"timed_out"`
+	// Outcome is "passed" or "failed".
+	Outcome    string `json:"outcome"`
+	GuardStep  bool   `json:"guard_step"`
+	Discovered int    `json:"discovered"`
+	Passed     int    `json:"passed"`
+	Failed     int    `json:"failed"`
+	Skipped    int    `json:"skipped"`
+}
+
+// RunLogDir returns the directory under gateDir that keeps the run records and logs.
+func RunLogDir(gateDir string) string {
+	return filepath.Join(gateDir, runLogDirName)
+}
+
+// WriteRunRecord writes record as `<stamp>-tier<N>-<pid>.json` in dir with the run's full output beside it as the same stem with `.log`, and returns the record's path.
+// Both files are written atomically, the log first, so a record always has its log.
+// It first removes every `.json` and `.log` file in dir last modified more than 14 days before now; a failed removal is logged and never returned.
+func WriteRunRecord(dir string, record RunRecord, output []byte, now time.Time) (string, error) {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", fmt.Errorf("create gate run log directory: %w", err)
+	}
+	pruneRunLog(dir, now)
+
+	stem := fmt.Sprintf("%s-tier%d-%d", now.UTC().Format("20060102T150405Z"), record.Tier, os.Getpid())
+	if err := fsx.AtomicWriteBytes(filepath.Join(dir, stem+".log"), output); err != nil {
+		return "", fmt.Errorf("write gate run log: %w", err)
+	}
+	data, err := json.MarshalIndent(record, "", "  ")
+	if err != nil {
+		return "", fmt.Errorf("encode gate run record: %w", err)
+	}
+	path := filepath.Join(dir, stem+".json")
+	if err := fsx.AtomicWriteBytes(path, data); err != nil {
+		return "", fmt.Errorf("write gate run record: %w", err)
+	}
+	return path, nil
+}
+
+func pruneRunLog(dir string, now time.Time) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if !errors.Is(err, os.ErrNotExist) {
+			logger.Warn("list gate run log for pruning", "dir", dir, "error", err.Error())
+		}
+		return
+	}
+	cutoff := now.Add(-runLogMaxAge)
+	for _, entry := range entries {
+		ext := filepath.Ext(entry.Name())
+		if entry.IsDir() || (ext != ".json" && ext != ".log") {
+			continue
+		}
+		info, err := entry.Info()
+		if err != nil || !info.ModTime().Before(cutoff) {
+			continue
+		}
+		if err := os.Remove(filepath.Join(dir, entry.Name())); err != nil && !errors.Is(err, os.ErrNotExist) {
+			logger.Warn("prune gate run log", "file", entry.Name(), "error", err.Error())
+		}
+	}
+}
+
+// TierTimeoutLine renders the line the gate prints to stderr and into the log when tier outlives timeout.
+// It names the tier, the timeout and the way forward.
+func TierTimeoutLine(tier string, timeout time.Duration) string {
+	return fmt.Sprintf("%s%s%s%s; find the hang in this log; when the tier is slow but healthy, rewrite the tier whole from the prime with \"lyx config gate --set 'tiers.%s={...}'\", carrying every key of the tier and the raised timeout_min, since a dotted key under the tier writes an entry the loader refuses; a session that is not the prime reports status: FAILED and the orch runs it",
+		tierTimeoutPrefix, tier, tierTimeoutMid, timeout, tier)
+}
+
+// FindTierTimeout returns the tier of the first tier timeout line anywhere in log, and false when the log holds none.
+func FindTierTimeout(log string) (tier string, ok bool) {
+	for _, line := range strings.Split(log, "\n") {
+		rest, found := strings.CutPrefix(line, tierTimeoutPrefix)
+		if !found {
+			continue
+		}
+		if tier, _, found := strings.Cut(rest, tierTimeoutMid); found {
+			return tier, true
+		}
+	}
+	return "", false
+}
+
+// TierSummaryLine renders the one stderr line the gate prints after each tier run.
+func TierSummaryLine(record RunRecord, logPath string) string {
+	return fmt.Sprintf("gate test: tier%d %s discovered %d passed %d failed %d skipped %d wall %.1fs exit %d log %s",
+		record.Tier, record.ScopeForm, record.Discovered, record.Passed, record.Failed, record.Skipped, record.WallSec, record.ExitCode, logPath)
+}
+
+// FailedTier returns the tier number of the last tier summary line in log whose exit code is not 0, and false when the log holds none.
+func FailedTier(log string) (tier int, ok bool) {
+	lines := strings.Split(log, "\n")
+	for i := len(lines) - 1; i >= 0; i-- {
+		match := tierSummaryPattern.FindStringSubmatch(strings.TrimRight(lines[i], "\r"))
+		if match == nil || match[2] == "0" {
+			continue
+		}
+		number, err := strconv.Atoi(match[1])
+		if err != nil {
+			continue
+		}
+		return number, true
+	}
+	return 0, false
+}
diff --git a/internal/gateslot/runlog_test.go b/internal/gateslot/runlog_test.go
new file mode 100644
index 00000000..1a6e32fc
--- /dev/null
+++ b/internal/gateslot/runlog_test.go
@@ -0,0 +1,124 @@
+// runlog_test.go covers the run record and log a tier run leaves behind, and the summary line a site reads back from a log.
+
+package gateslot
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWriteRunRecord(t *testing.T) {
+	t.Parallel()
+
+	now := time.Date(2026, 3, 20, 12, 0, 0, 0, time.UTC)
+
+	t.Run("RecordAndLogWrittenBesideEachOther", func(t *testing.T) {
+		t.Parallel()
+
+		dir := RunLogDir(t.TempDir())
+		want := RunRecord{
+			Worktree: "/hub/slug", Slug: "slug", TierList: []int{0, 1}, Tier: 1,
+			Command: "go test ./...", RunDir: "/hub/slug/internal/x", ScopeForm: "--all", Slots: 2,
+			WaitStart: now.Add(-time.Minute), Start: now.Add(-30 * time.Second), End: now, WallSec: 30,
+			ExitCode: 1, TimedOut: false, Outcome: "failed", GuardStep: true,
+			Discovered: 9, Passed: 7, Failed: 1, Skipped: 1,
+		}
+		path, err := WriteRunRecord(dir, want, []byte("FAIL\n"), now)
+		if err != nil {
+			t.Fatalf("WriteRunRecord() error = %v", err)
+		}
+		if filepath.Dir(path) != dir || !strings.HasSuffix(path, ".json") || !strings.Contains(filepath.Base(path), "-tier1-") {
+			t.Errorf("WriteRunRecord() path = %q; want a .json named for tier1 in %q", path, dir)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("read record: %v", err)
+		}
+		var got RunRecord
+		if err := json.Unmarshal(data, &got); err != nil {
+			t.Fatalf("decode record: %v", err)
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("record read back = %+v; want %+v", got, want)
+		}
+		logData, err := os.ReadFile(strings.TrimSuffix(path, ".json") + ".log")
+		if err != nil {
+			t.Fatalf("read log: %v", err)
+		}
+		if string(logData) != "FAIL\n" {
+			t.Errorf("log = %q; want %q", logData, "FAIL\n")
+		}
+	})
+
+	t.Run("PrunesOnlyFilesOlderThanFourteenDays", func(t *testing.T) {
+		t.Parallel()
+
+		dir := RunLogDir(t.TempDir())
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		files := map[string]time.Duration{
+			"old.json": 15 * 24 * time.Hour, "old.log": 15 * 24 * time.Hour,
+			"recent.json": 13 * 24 * time.Hour, "recent.log": 13 * 24 * time.Hour,
+		}
+		for name, age := range files {
+			path := filepath.Join(dir, name)
+			if err := os.WriteFile(path, []byte("x"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Chtimes(path, now.Add(-age), now.Add(-age)); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err := WriteRunRecord(dir, RunRecord{Tier: 0}, nil, now); err != nil {
+			t.Fatalf("WriteRunRecord() error = %v", err)
+		}
+		for name, age := range files {
+			_, err := os.Stat(filepath.Join(dir, name))
+			wantGone := age > 14*24*time.Hour
+			if gone := os.IsNotExist(err); gone != wantGone {
+				t.Errorf("%s removed = %v; want %v", name, gone, wantGone)
+			}
+		}
+	})
+
+	t.Run("SummaryLineRoundTripsThroughFailedTier", func(t *testing.T) {
+		t.Parallel()
+
+		testFailedTier(t)
+	})
+}
+
+func testFailedTier(t *testing.T) {
+	t.Helper()
+
+	line := func(tier, exit int) string {
+		return TierSummaryLine(RunRecord{Tier: tier, ScopeForm: "--base main", Discovered: 4, Passed: 4, WallSec: 1.5, ExitCode: exit}, "/runs/x.log")
+	}
+	tests := []struct {
+		name     string
+		log      string
+		wantTier int
+		wantOK   bool
+	}{
+		{"last failing line after a passing one", line(0, 0) + "\n" + line(2, 1) + "\n", 2, true},
+		{"failing line followed by a passing one", line(1, 2) + "\n" + line(2, 0) + "\n", 1, true},
+		{"no failing summary line", line(0, 0) + "\nok example.com/x\n", 0, false},
+		{"no summary line", "FAIL\n", 0, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			tier, ok := FailedTier(tt.log)
+			if tier != tt.wantTier || ok != tt.wantOK {
+				t.Errorf("FailedTier() = %d, %v; want %d, %v", tier, ok, tt.wantTier, tt.wantOK)
+			}
+		})
+	}
+}
diff --git a/internal/gateslot/template.yaml b/internal/gateslot/template.yaml
index 938a6df7..4038b0e6 100644
--- a/internal/gateslot/template.yaml
+++ b/internal/gateslot/template.yaml
@@ -1,3 +1,32 @@
 slots: 2  # how many gate builds and test runs the hub executes at once; a lowered count takes effect on the next acquire while a running holder finishes
-go_parallel: 4  # the -p cap every slotted run gets in its GOFLAGS, bounding the packages one go command builds and tests in parallel
 busy_quit_sec: 120  # seconds a Go test binary under lyx gate test may keep a CPU core at least 90 percent busy before it gets one SIGQUIT and dumps its goroutine stacks; 0 turns the watchdog off; raise it for a package that is CPU-bound but healthy
+
+# The hub's test tiers, keyed tier0, tier1, and so on; the template declares none.
+# A tier is written whole with one flow mapping: lyx config gate --set 'tiers.tier0={command: "go test -json {targets} {args}", all_targets: ./..., timeout_min: 60, counter: go-json}'
+# It holds command (with {targets}, {parallel} and {args} placeholders), timeout_min (at least 1) and counter (go-json or vstest), and all_targets when the command holds {targets}.
+# It may also hold about, dir (default .), env, parallel (at least 1, default 1), covers (lower tier numbers its command runs anyway), slots (a count of at least 1, or all; default 1) and prebuilt_lyx.
+# Inside the mapping a value holding a brace, comma or bracket is a double-quoted string.
+tiers: {}
+
+# Gate name to the list of tier numbers that site runs; card, batch, round, final, landing and publish are read by lyx.
+# Only publish may be empty; a tier a list names must be declared above when the gate runs.
+gates:
+  card: [0]
+  batch: [0]
+  round: [0]
+  final: [0]
+  landing: [0]
+  publish: []
+
+# How a computed, base or card scope maps to {targets}: go derives the impacted Go packages per module, none runs every tier whole.
+scoper: none
+
+# The tier whose command runs the //lyx:guard tests outside a narrowed scope; read only under the go scoper.
+guard_tier: 0
+
+# Command prefixes the shell guard refuses, each one or more words of letters, digits, dot, underscore and dash separated by single spaces, such as "go test".
+refuse_raw: []
+
+# This machine's parallel for a tier, tier name to a count of at least 1; it beats the tier's own parallel.
+# Set it inside a hub with lyx config gate --layer machine --set tier_parallel.tier0=2, and in a standalone worktree, which has no machine layer, with plain lyx config gate.
+tier_parallel: {}
