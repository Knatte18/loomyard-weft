diff --git a/internal/fabricengine/failedpush.go b/internal/fabricengine/failedpush.go
new file mode 100644
index 00000000..e5387aac
--- /dev/null
+++ b/internal/fabricengine/failedpush.go
@@ -0,0 +1,271 @@
+// failedpush.go holds the failed-push record, one machine-local file per repository side and branch.
+// It also holds the once-per-episode notice to the orch through the installed notifier, and the way-forward line per side and class.
+
+package fabricengine
+
+import (
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lyxdirs"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// PushFailureClass names why a push did not land.
+type PushFailureClass string
+
+const (
+	// PushFailureNotFastForward means origin holds commits the pushed branch lacks.
+	PushFailureNotFastForward PushFailureClass = "not_fast_forward"
+	// PushFailureTransport means origin could not be reached.
+	PushFailureTransport PushFailureClass = "transport"
+	// PushFailureAuth means origin refused this machine's credentials or permissions.
+	PushFailureAuth PushFailureClass = "auth"
+	// PushFailureGone means origin no longer has the branch.
+	PushFailureGone PushFailureClass = "gone"
+	// PushFailureOther means the push failed for a reason no other class names, so the record carries git's own error.
+	PushFailureOther PushFailureClass = "other"
+	// PushFailureDeferred means the push was held back, not refused, and is retried by the next push of the branch.
+	PushFailureDeferred PushFailureClass = "deferred"
+)
+
+// The repository sides a failed push is recorded against.
+const (
+	failedPushSideCode    = "code"
+	failedPushSideRecords = "records"
+	failedPushSideBolt    = "bolt"
+)
+
+// FailedPush is the record of a push origin refused, one per repository side and branch.
+// Repo is "code", "records" or "bolt", the last being the records repository's board branch.
+// CodeWorktree is set for a records record only: the pair's code worktree, where every fabric verb runs.
+// Prime marks a code record of the hub prime's own branch.
+// Paths, Commits and OriginHead are set where the failure has them, such as a replay stop or a rewind.
+type FailedPush struct {
+	Repo         string           `json:"repo"`
+	RepoPath     string           `json:"repo_path"`
+	CodeWorktree string           `json:"code_worktree,omitempty"`
+	Branch       string           `json:"branch"`
+	Prime        bool             `json:"prime,omitempty"`
+	Class        PushFailureClass `json:"class"`
+	Error        string           `json:"error,omitempty"`
+	Paths        []string         `json:"paths,omitempty"`
+	Commits      []string         `json:"commits,omitempty"`
+	OriginHead   string           `json:"origin_head,omitempty"`
+	FirstSeen    time.Time        `json:"first_seen"`
+	LastSeen     time.Time        `json:"last_seen"`
+	Count        int              `json:"count"`
+	Notified     bool             `json:"notified"`
+}
+
+// PushNotifier posts line to the orch of the hub at hubPath and reports whether the mail was posted.
+// A notifier reporting false, because no orch is recorded, leaves the failure to be mailed by a later one.
+type PushNotifier func(hubPath, line string) (posted bool, err error)
+
+var installedPushNotifier atomic.Pointer[PushNotifier]
+
+// InstallPushNotifier stores n as the process's push notifier and returns a function that reinstates the previous one.
+func InstallPushNotifier(n PushNotifier) (restore func()) {
+	previous := installedPushNotifier.Swap(&n)
+	return func() { installedPushNotifier.Store(previous) }
+}
+
+func failedPushDir(hubPath string) string {
+	return filepath.Join(HubScratchDir(hubPath), lyxdirs.FailedPushDirName)
+}
+
+// failedPushPath returns the record file for a repository side and branch.
+// The branch is path-escaped so a slash in it stays one file name.
+func failedPushPath(hubPath, repo, branch string) string {
+	return filepath.Join(failedPushDir(hubPath), repo+"__"+url.PathEscape(branch)+".json")
+}
+
+func failedPushLockPath(path string) string {
+	return path + ".lock"
+}
+
+// RecordPushFailure writes f as the failed-push record of its repository side and branch under the record's lock.
+// The first failure creates the record and later ones keep its first-seen time and notified flag, replace the rest and bump the count.
+// While the record is not notified and its class is not deferred, the installed notifier is called once with a line naming the branch, the class, the error and the way forward,
+// and the record is marked notified only when the notifier reports the mail posted.
+// A notifier error is logged and leaves the record unnotified, so the next failure mails again.
+func RecordPushFailure(hubPath string, f FailedPush, now time.Time) error {
+	path := failedPushPath(hubPath, f.Repo, f.Branch)
+	return state.UpdateJSON(path, failedPushLockPath(path), func(cur FailedPush, found bool) (FailedPush, error) {
+		f.FirstSeen = now
+		f.Count = 1
+		if found {
+			f.FirstSeen = cur.FirstSeen
+			f.Count = cur.Count + 1
+			f.Notified = cur.Notified
+		}
+		f.LastSeen = now
+		if f.Notified || f.Class == PushFailureDeferred {
+			return f, nil
+		}
+		notifier := installedPushNotifier.Load()
+		if notifier == nil {
+			return f, nil
+		}
+		line := fmt.Sprintf("a push of %s branch %s failed (%s): %s; way forward: %s", f.Repo, f.Branch, f.Class, f.Error, FailedPushWayForward(f))
+		posted, err := (*notifier)(hubPath, line)
+		if err != nil {
+			logger.Warn("fabricengine: failed-push notice not posted", "repo", f.Repo, "branch", f.Branch, "error", err)
+			return f, nil
+		}
+		f.Notified = posted
+		return f, nil
+	})
+}
+
+// ClearPushFailure removes the failed-push record of a repository side and branch, and does nothing when none exists.
+func ClearPushFailure(hubPath, repo, branch string) error {
+	path := failedPushPath(hubPath, repo, branch)
+	if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("clear failed-push record: %w", err)
+	}
+	return nil
+}
+
+// ListFailedPushes returns every failed-push record of the hub sorted by repository side and branch.
+// A hub with no records returns none.
+func ListFailedPushes(hubPath string) ([]FailedPush, error) {
+	dir := failedPushDir(hubPath)
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("list failed-push records: %w", err)
+	}
+	var records []FailedPush
+	for _, entry := range entries {
+		if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" {
+			continue
+		}
+		path := filepath.Join(dir, entry.Name())
+		record, found, err := state.ReadJSONNoMkdir[FailedPush](path, failedPushLockPath(path))
+		if err != nil {
+			return nil, fmt.Errorf("read failed-push record %s: %w", entry.Name(), err)
+		}
+		if found {
+			records = append(records, record)
+		}
+	}
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].Repo != records[j].Repo {
+			return records[i].Repo < records[j].Repo
+		}
+		return records[i].Branch < records[j].Branch
+	})
+	return records, nil
+}
+
+// FailedPushFields renders the hub's failed-push records as the envelope rows a verb prints:
+// repo side, branch, class, last error line, first and last seen, count, notified and the way forward for the record's class.
+// A hub with no records returns an empty list, never nil, so the field prints as [].
+func FailedPushFields(hubPath string) ([]map[string]any, error) {
+	records, err := ListFailedPushes(hubPath)
+	if err != nil {
+		return nil, err
+	}
+	rows := make([]map[string]any, 0, len(records))
+	for _, record := range records {
+		rows = append(rows, map[string]any{
+			"repo":        record.Repo,
+			"branch":      record.Branch,
+			"class":       string(record.Class),
+			"error":       record.Error,
+			"first_seen":  record.FirstSeen.Format(time.RFC3339),
+			"last_seen":   record.LastSeen.Format(time.RFC3339),
+			"count":       record.Count,
+			"notified":    record.Notified,
+			"way_forward": FailedPushWayForward(record),
+		})
+	}
+	return rows, nil
+}
+
+// pushStep names the push that retries f, with the directory it runs in.
+// A bolt record is pushed by the board sync, since the pair push never reaches Bolt.
+// A prime's code branch is pushed by a plain git push, since the prime's pair push is records-only.
+func pushStep(f FailedPush) string {
+	switch {
+	case f.Repo == failedPushSideBolt:
+		return "`lyx board sync` from the prime worktree"
+	case f.Repo == failedPushSideCode && f.Prime:
+		return fmt.Sprintf("`git push` in %s", f.RepoPath)
+	case f.Repo == failedPushSideRecords:
+		return fmt.Sprintf("`lyx fabric push` in %s", f.CodeWorktree)
+	default:
+		return fmt.Sprintf("`lyx fabric push` in %s", f.RepoPath)
+	}
+}
+
+// FailedPushWayForward returns the runnable way forward for a failed push, by repository side and class.
+func FailedPushWayForward(f FailedPush) string {
+	switch f.Class {
+	case PushFailureAuth:
+		return fmt.Sprintf("fix this machine's permission to push %s on origin, then run %s", f.Branch, pushStep(f))
+	case PushFailureNotFastForward:
+		if f.Repo == failedPushSideCode {
+			return codeDivergedWayForward(f.RepoPath, f.Branch, f.Prime)
+		}
+		return recordsConflictWayForward(f.RepoPath, f.Branch, f.Paths, f.Commits, pushStep(f))
+	case PushFailureRewound:
+		return rewoundWayForward(f.RepoPath, f.Branch, f.OriginHead, f.Commits)
+	case PushFailureGone:
+		pairWorktree := f.RepoPath
+		if f.Repo == failedPushSideRecords {
+			pairWorktree = f.CodeWorktree
+		}
+		return fmt.Sprintf("origin no longer has branch %s, and its board entry is neither done nor removed on origin, since an ended entry writes no record; "+
+			"decide whether the run ends: `lyx fabric remove` of the pair at %s, run from the prime, removes the pair and clears this record; "+
+			"once origin's board shows the entry done or removed, `lyx cleanup --apply` tears it down instead",
+			f.Branch, pairWorktree)
+	default:
+		return fmt.Sprintf("run %s to retry the push", pushStep(f))
+	}
+}
+
+// recordsConflictWayForward names a records replay stop: the conflicting paths and local commits,
+// and the two ways to settle it, each run in worktree, followed by pushVerb, the push step with its directory.
+func recordsConflictWayForward(worktree, branch string, paths, commits []string, pushVerb string) string {
+	return fmt.Sprintf("another machine wrote the same paths on origin/%s (paths: %s; local commits: %s); "+
+		"to keep origin's side, run `git reset --keep origin/%s` in %s, which drops the local commits; "+
+		"to keep this machine's, run `git merge origin/%s` in %s, settle the named paths and commit, then run %s, whose push is then a fast-forward and meets no replay",
+		branch, joinOrNone(paths), joinOrNone(commits), branch, worktree, branch, worktree, pushVerb)
+}
+
+// codeDivergedWayForward names the merge that settles a code branch origin moved past.
+// A prime's branch is pushed by a plain git push in the prime, since the pair push leaves the prime's code branch unpushed.
+func codeDivergedWayForward(worktree, branch string, prime bool) string {
+	push := fmt.Sprintf("`lyx fabric push` in %s", worktree)
+	if prime {
+		push = fmt.Sprintf("`git push` in %s", worktree)
+	}
+	return fmt.Sprintf("origin/%s holds commits this branch lacks; run `git merge origin/%s` in %s, settle any conflict and commit, then run %s",
+		branch, branch, worktree, push)
+}
+
+// rewoundWayForward names the two ways to settle a task branch origin rewound to originHead, dropping the commits in dropped.
+func rewoundWayForward(worktree, branch, originHead string, dropped []string) string {
+	return fmt.Sprintf("origin rewound %s to %s, dropping %s; "+
+		"to accept the rewind, run `git reset --keep %s` in %s, which drops the local commits past origin's head, then `lyx fabric push` there; "+
+		"to restore the dropped commits, run `git push origin %s` in %s, a plain fast-forward",
+		branch, originHead, joinOrNone(dropped), originHead, worktree, branch, worktree)
+}
+
+func joinOrNone(items []string) string {
+	if len(items) == 0 {
+		return "none"
+	}
+	return strings.Join(items, " ")
+}
diff --git a/internal/fabricengine/failedpush_test.go b/internal/fabricengine/failedpush_test.go
new file mode 100644
index 00000000..c1f64c72
--- /dev/null
+++ b/internal/fabricengine/failedpush_test.go
@@ -0,0 +1,355 @@
+// failedpush_test.go covers the failed-push record store, its once-per-episode notice and its way-forward lines.
+// It is an external test package, and the notifier is process-global, so every test here that installs one runs without t.Parallel.
+
+package fabricengine_test
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lyxdirs"
+)
+
+// fakePushNotifier counts the calls carrying its own hub path, so a parallel test recording a failure in another hub never reaches its counts.
+type fakePushNotifier struct {
+	hub    string
+	posted bool
+	err    error
+	lines  []string
+}
+
+func (n *fakePushNotifier) notify(hubPath, line string) (bool, error) {
+	if hubPath != n.hub {
+		return true, nil
+	}
+	n.lines = append(n.lines, line)
+	return n.posted, n.err
+}
+
+func installFakePushNotifier(t *testing.T, n *fakePushNotifier) {
+	t.Helper()
+	t.Cleanup(fabricengine.InstallPushNotifier(n.notify))
+}
+
+func composedPushLine(f fabricengine.FailedPush) string {
+	return fmt.Sprintf("a push of %s branch %s failed (%s): %s; way forward: %s", f.Repo, f.Branch, f.Class, f.Error, fabricengine.FailedPushWayForward(f))
+}
+
+func codePushFailure() fabricengine.FailedPush {
+	return fabricengine.FailedPush{
+		Repo:     "code",
+		RepoPath: "/hub/task",
+		Branch:   "task",
+		Class:    fabricengine.PushFailureTransport,
+		Error:    "connection refused",
+	}
+}
+
+// TestFailedPushRecord covers the record's lifecycle, its single notice per episode, and every side and class way-forward line a push writes.
+//
+// It runs without t.Parallel: the notifier it installs is process-global.
+func TestFailedPushRecord(t *testing.T) {
+	base := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+	t.Run("FirstFailureMailsOnceAndLaterOnesOnlyUpdate", func(t *testing.T) {
+		hub := t.TempDir()
+		fake := &fakePushNotifier{hub: hub, posted: true}
+		installFakePushNotifier(t, fake)
+		failure := codePushFailure()
+
+		if err := fabricengine.RecordPushFailure(hub, failure, base); err != nil {
+			t.Fatalf("RecordPushFailure: %v", err)
+		}
+		if err := fabricengine.RecordPushFailure(hub, failure, base.Add(time.Minute)); err != nil {
+			t.Fatalf("RecordPushFailure second: %v", err)
+		}
+
+		if len(fake.lines) != 1 || fake.lines[0] != composedPushLine(failure) {
+			t.Errorf("notifier lines = %q; want one line %q", fake.lines, composedPushLine(failure))
+		}
+		records, err := fabricengine.ListFailedPushes(hub)
+		if err != nil || len(records) != 1 {
+			t.Fatalf("ListFailedPushes() = %v, %v; want one record", records, err)
+		}
+		got := records[0]
+		if got.Count != 2 || !got.Notified || !got.FirstSeen.Equal(base) || !got.LastSeen.Equal(base.Add(time.Minute)) {
+			t.Errorf("record = count %d notified %v first %v last %v; want 2 true %v %v", got.Count, got.Notified, got.FirstSeen, got.LastSeen, base, base.Add(time.Minute))
+		}
+	})
+
+	t.Run("NotPostedLeavesNotifiedUnsetSoTheNextFailureMails", func(t *testing.T) {
+		hub := t.TempDir()
+		fake := &fakePushNotifier{hub: hub, posted: false}
+		installFakePushNotifier(t, fake)
+
+		for i := range 2 {
+			if err := fabricengine.RecordPushFailure(hub, codePushFailure(), base.Add(time.Duration(i)*time.Minute)); err != nil {
+				t.Fatalf("RecordPushFailure: %v", err)
+			}
+		}
+
+		if len(fake.lines) != 2 {
+			t.Errorf("notifier calls = %d; want 2", len(fake.lines))
+		}
+		records, _ := fabricengine.ListFailedPushes(hub)
+		if len(records) != 1 || records[0].Notified {
+			t.Errorf("records = %+v; want one unnotified record", records)
+		}
+	})
+
+	t.Run("NotifierErrorLeavesTheRecordWrittenAndUnnotified", func(t *testing.T) {
+		hub := t.TempDir()
+		fake := &fakePushNotifier{hub: hub, posted: true, err: errors.New("creel down")}
+		installFakePushNotifier(t, fake)
+
+		for i := range 2 {
+			if err := fabricengine.RecordPushFailure(hub, codePushFailure(), base.Add(time.Duration(i)*time.Minute)); err != nil {
+				t.Fatalf("RecordPushFailure: %v", err)
+			}
+		}
+
+		if len(fake.lines) != 2 {
+			t.Errorf("notifier calls = %d; want 2", len(fake.lines))
+		}
+		records, _ := fabricengine.ListFailedPushes(hub)
+		if len(records) != 1 || records[0].Notified || records[0].Count != 2 {
+			t.Errorf("records = %+v; want one unnotified record counted twice", records)
+		}
+	})
+
+	t.Run("DeferredWritesTheRecordAndNeverMails", func(t *testing.T) {
+		hub := t.TempDir()
+		fake := &fakePushNotifier{hub: hub, posted: true}
+		installFakePushNotifier(t, fake)
+		failure := codePushFailure()
+		failure.Class = fabricengine.PushFailureDeferred
+
+		if err := fabricengine.RecordPushFailure(hub, failure, base); err != nil {
+			t.Fatalf("RecordPushFailure: %v", err)
+		}
+
+		if len(fake.lines) != 0 {
+			t.Errorf("notifier lines = %q; want none", fake.lines)
+		}
+		records, _ := fabricengine.ListFailedPushes(hub)
+		if len(records) != 1 || records[0].Notified {
+			t.Errorf("records = %+v; want one unnotified record", records)
+		}
+	})
+
+	t.Run("ClearRemovesTheRecordAndASecondClearIsNil", func(t *testing.T) {
+		hub := t.TempDir()
+		failure := codePushFailure()
+		if err := fabricengine.RecordPushFailure(hub, failure, base); err != nil {
+			t.Fatalf("RecordPushFailure: %v", err)
+		}
+
+		for i := range 2 {
+			if err := fabricengine.ClearPushFailure(hub, failure.Repo, failure.Branch); err != nil {
+				t.Errorf("ClearPushFailure #%d = %v; want nil", i+1, err)
+			}
+		}
+
+		if records, _ := fabricengine.ListFailedPushes(hub); len(records) != 0 {
+			t.Errorf("ListFailedPushes() = %+v; want none", records)
+		}
+	})
+
+	t.Run("ListOverAnAbsentDirectoryIsEmptyAndSortsByRepoAndBranch", func(t *testing.T) {
+		hub := t.TempDir()
+		if records, err := fabricengine.ListFailedPushes(hub); err != nil || len(records) != 0 {
+			t.Errorf("ListFailedPushes(empty) = %v, %v; want none, nil", records, err)
+		}
+
+		for _, entry := range []struct{ repo, branch string }{{"records", "b"}, {"code", "feature/x"}, {"code", "a"}} {
+			failure := codePushFailure()
+			failure.Repo, failure.Branch = entry.repo, entry.branch
+			if err := fabricengine.RecordPushFailure(hub, failure, base); err != nil {
+				t.Fatalf("RecordPushFailure: %v", err)
+			}
+		}
+
+		records, err := fabricengine.ListFailedPushes(hub)
+		if err != nil {
+			t.Fatalf("ListFailedPushes: %v", err)
+		}
+		var got []string
+		for _, record := range records {
+			got = append(got, record.Repo+":"+record.Branch)
+		}
+		if want := "code:a code:feature/x records:b"; strings.Join(got, " ") != want {
+			t.Errorf("ListFailedPushes order = %q; want %q", strings.Join(got, " "), want)
+		}
+	})
+
+	t.Run("UnknownKeySurvivesAnUpdate", func(t *testing.T) {
+		hub := t.TempDir()
+		failure := codePushFailure()
+		if err := fabricengine.RecordPushFailure(hub, failure, base); err != nil {
+			t.Fatalf("RecordPushFailure: %v", err)
+		}
+		dir := filepath.Join(fabricengine.HubScratchDir(hub), lyxdirs.FailedPushDirName)
+		matches, _ := filepath.Glob(filepath.Join(dir, "*.json"))
+		if len(matches) != 1 {
+			t.Fatalf("record files = %v; want one", matches)
+		}
+		raw, err := os.ReadFile(matches[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		edited := strings.Replace(string(raw), "{", `{"future_key": "kept",`, 1)
+		if err := os.WriteFile(matches[0], []byte(edited), 0o644); err != nil {
+			t.Fatal(err)
+		}
+
+		if err := fabricengine.RecordPushFailure(hub, failure, base.Add(time.Minute)); err != nil {
+			t.Fatalf("RecordPushFailure second: %v", err)
+		}
+
+		after, err := os.ReadFile(matches[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(after), `"future_key"`) || !strings.Contains(string(after), `"kept"`) {
+			t.Errorf("record file after update = %s; want the unknown key kept", after)
+		}
+	})
+
+	wayForwardRows := []struct {
+		name    string
+		failure fabricengine.FailedPush
+		want    string
+	}{
+		{
+			"CodeDeferred",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/task", Branch: "task", Class: fabricengine.PushFailureDeferred},
+			"run `lyx fabric push` in /hub/task to retry the push",
+		},
+		{
+			"RecordsDeferred",
+			fabricengine.FailedPush{Repo: "records", RepoPath: "/hub/task-weft", CodeWorktree: "/hub/task", Branch: "task-weft", Class: fabricengine.PushFailureDeferred},
+			"run `lyx fabric push` in /hub/task to retry the push",
+		},
+		{
+			"BoltDeferred",
+			fabricengine.FailedPush{Repo: "bolt", RepoPath: "/hub/_board", Branch: "main", Class: fabricengine.PushFailureDeferred},
+			"run `lyx board sync` from the prime worktree to retry the push",
+		},
+		{
+			"CodeTransport",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/task", Branch: "task", Class: fabricengine.PushFailureTransport},
+			"run `lyx fabric push` in /hub/task to retry the push",
+		},
+		{
+			"RecordsTransport",
+			fabricengine.FailedPush{Repo: "records", RepoPath: "/hub/task-weft", CodeWorktree: "/hub/task", Branch: "task-weft", Class: fabricengine.PushFailureTransport},
+			"run `lyx fabric push` in /hub/task to retry the push",
+		},
+		{
+			"PrimeRecordsTransportPushesInThePrimeWorktree",
+			fabricengine.FailedPush{Repo: "records", RepoPath: "/hub/main-weft", CodeWorktree: "/hub/main", Branch: "main-weft", Class: fabricengine.PushFailureTransport},
+			"run `lyx fabric push` in /hub/main to retry the push",
+		},
+		{
+			"BoltTransport",
+			fabricengine.FailedPush{Repo: "bolt", RepoPath: "/hub/_board", Branch: "main", Class: fabricengine.PushFailureTransport},
+			"run `lyx board sync` from the prime worktree to retry the push",
+		},
+		{
+			"CodeAuth",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/task", Branch: "task", Class: fabricengine.PushFailureAuth},
+			"fix this machine's permission to push task on origin, then run `lyx fabric push` in /hub/task",
+		},
+		{
+			"RecordsAuth",
+			fabricengine.FailedPush{Repo: "records", RepoPath: "/hub/task-weft", CodeWorktree: "/hub/task", Branch: "task-weft", Class: fabricengine.PushFailureAuth},
+			"fix this machine's permission to push task-weft on origin, then run `lyx fabric push` in /hub/task",
+		},
+		{
+			"BoltAuth",
+			fabricengine.FailedPush{Repo: "bolt", RepoPath: "/hub/_board", Branch: "main", Class: fabricengine.PushFailureAuth},
+			"fix this machine's permission to push main on origin, then run `lyx board sync` from the prime worktree",
+		},
+		{
+			"CodeNotFastForward",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/task", Branch: "task", Class: fabricengine.PushFailureNotFastForward},
+			"origin/task holds commits this branch lacks; run `git merge origin/task` in /hub/task, settle any conflict and commit, then run `lyx fabric push` in /hub/task",
+		},
+		{
+			"RecordsNotFastForward",
+			fabricengine.FailedPush{
+				Repo: "records", RepoPath: "/hub/task-weft", CodeWorktree: "/hub/task", Branch: "task-weft", Class: fabricengine.PushFailureNotFastForward,
+				Paths: []string{"_lyx/a.md"}, Commits: []string{"abc123"},
+			},
+			"another machine wrote the same paths on origin/task-weft (paths: _lyx/a.md; local commits: abc123); " +
+				"to keep origin's side, run `git reset --keep origin/task-weft` in /hub/task-weft, which drops the local commits; " +
+				"to keep this machine's, run `git merge origin/task-weft` in /hub/task-weft, settle the named paths and commit, then run `lyx fabric push` in /hub/task, whose push is then a fast-forward and meets no replay",
+		},
+		{
+			"PrimeRecordsNotFastForwardPushesInThePrimeWorktree",
+			fabricengine.FailedPush{
+				Repo: "records", RepoPath: "/hub/main-weft", CodeWorktree: "/hub/main", Branch: "main-weft", Class: fabricengine.PushFailureNotFastForward,
+				Paths: []string{"_lyx/a.md"}, Commits: []string{"abc123"},
+			},
+			"another machine wrote the same paths on origin/main-weft (paths: _lyx/a.md; local commits: abc123); " +
+				"to keep origin's side, run `git reset --keep origin/main-weft` in /hub/main-weft, which drops the local commits; " +
+				"to keep this machine's, run `git merge origin/main-weft` in /hub/main-weft, settle the named paths and commit, then run `lyx fabric push` in /hub/main, whose push is then a fast-forward and meets no replay",
+		},
+		{
+			"BoltNotFastForward",
+			fabricengine.FailedPush{
+				Repo: "bolt", RepoPath: "/hub/_board", Branch: "main", Class: fabricengine.PushFailureNotFastForward,
+				Paths: []string{"board.json"}, Commits: []string{"def456"},
+			},
+			"another machine wrote the same paths on origin/main (paths: board.json; local commits: def456); " +
+				"to keep origin's side, run `git reset --keep origin/main` in /hub/_board, which drops the local commits; " +
+				"to keep this machine's, run `git merge origin/main` in /hub/_board, settle the named paths and commit, then run `lyx board sync` from the prime worktree, whose push is then a fast-forward and meets no replay",
+		},
+		{
+			"CodeGone",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/task", Branch: "task", Class: fabricengine.PushFailureGone},
+			"origin no longer has branch task, and its board entry is neither done nor removed on origin, since an ended entry writes no record; " +
+				"decide whether the run ends: `lyx fabric remove` of the pair at /hub/task, run from the prime, removes the pair and clears this record; " +
+				"once origin's board shows the entry done or removed, `lyx cleanup --apply` tears it down instead",
+		},
+		{
+			"RecordsGoneNamesTheCodeWorktree",
+			fabricengine.FailedPush{Repo: "records", RepoPath: "/hub/task-weft", CodeWorktree: "/hub/task", Branch: "task-weft", Class: fabricengine.PushFailureGone},
+			"origin no longer has branch task-weft, and its board entry is neither done nor removed on origin, since an ended entry writes no record; " +
+				"decide whether the run ends: `lyx fabric remove` of the pair at /hub/task, run from the prime, removes the pair and clears this record; " +
+				"once origin's board shows the entry done or removed, `lyx cleanup --apply` tears it down instead",
+		},
+		{
+			"PrimeCodeTransportNamesGitPush",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/main", Branch: "main", Prime: true, Class: fabricengine.PushFailureTransport},
+			"run `git push` in /hub/main to retry the push",
+		},
+		{
+			"PrimeCodeAuthNamesGitPush",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/main", Branch: "main", Prime: true, Class: fabricengine.PushFailureAuth},
+			"fix this machine's permission to push main on origin, then run `git push` in /hub/main",
+		},
+		{
+			"PrimeCodeNotFastForwardMergesAndPushesInThePrime",
+			fabricengine.FailedPush{Repo: "code", RepoPath: "/hub/main", Branch: "main", Prime: true, Class: fabricengine.PushFailureNotFastForward},
+			"origin/main holds commits this branch lacks; run `git merge origin/main` in /hub/main, settle any conflict and commit, then run `git push` in /hub/main",
+		},
+	}
+	for _, tt := range wayForwardRows {
+		t.Run("WayForward_"+tt.name, func(t *testing.T) {
+			got := fabricengine.FailedPushWayForward(tt.failure)
+			if got != tt.want {
+				t.Errorf("FailedPushWayForward(%s) =\n%s\nwant\n%s", tt.name, got, tt.want)
+			}
+			if tt.failure.Prime && strings.Contains(got, "lyx fabric push") {
+				t.Errorf("FailedPushWayForward(%s) = %q; a prime record never names `lyx fabric push`", tt.name, got)
+			}
+		})
+	}
+}
