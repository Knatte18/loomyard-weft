+// fixcap_test.go — untagged unit tests for FixCap.Exceeded.
+
+package landingshed
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+func TestFixCap_Exceeded(t *testing.T) {
+	t.Parallel()
+
+	goMatcher := func(p string) bool { return planparser.IsTestFile("go", p) }
+	csharpMatcher := func(p string) bool { return planparser.IsTestFile("csharp", p) }
+	noneMatcher := func(p string) bool { return planparser.IsTestFile("none", p) }
+
+	tests := []struct {
+		name       string
+		isTestFile func(string) bool
+		change     fabricengine.LineChange
+		want       string
+	}{
+		{"OverTheLineCap", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 41}, "41 lines, over the cap of 40"},
+		{"AtTheLineCap", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 40}, ""},
+		{"SmallSourceOnlyChange", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 3, AddedLines: []string{"x := 1"}}, ""},
+		{"GoTestFile", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x_test.go"}, Lines: 3}, "test file internal/x/x_test.go"},
+		{"CSharpTestFile", csharpMatcher, fabricengine.LineChange{Paths: []string{"src/FooTests.cs"}, Lines: 3}, "test file src/FooTests.cs"},
+		{"CSharpSourceFileUnderGoMatcher", goMatcher, fabricengine.LineChange{Paths: []string{"src/FooTests.cs"}, Lines: 3}, ""},
+		{"AnyFileUnderNoneMatcher", noneMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 1}, "test file internal/x/x.go"},
+		{"TestdataFile", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/testdata/in.txt"}, Lines: 1}, "testdata file internal/x/testdata/in.txt"},
+		{"GoMod", goMatcher, fabricengine.LineChange{Paths: []string{"go.mod"}, Lines: 1}, "configuration file go.mod"},
+		{"GoSum", goMatcher, fabricengine.LineChange{Paths: []string{"go.sum"}, Lines: 1}, "configuration file go.sum"},
+		{"GoWork", goMatcher, fabricengine.LineChange{Paths: []string{"go.work"}, Lines: 1}, "configuration file go.work"},
+		{"Makefile", goMatcher, fabricengine.LineChange{Paths: []string{"tools/Makefile"}, Lines: 1}, "configuration file tools/Makefile"},
+		{"Csproj", goMatcher, fabricengine.LineChange{Paths: []string{"src/App.csproj"}, Lines: 1}, "configuration file src/App.csproj"},
+		{"Sln", goMatcher, fabricengine.LineChange{Paths: []string{"App.sln"}, Lines: 1}, "configuration file App.sln"},
+		{"Props", goMatcher, fabricengine.LineChange{Paths: []string{"build/Common.props"}, Lines: 1}, "configuration file build/Common.props"},
+		{"Targets", goMatcher, fabricengine.LineChange{Paths: []string{"build/Common.targets"}, Lines: 1}, "configuration file build/Common.targets"},
+		{"DirectoryBuildProps", goMatcher, fabricengine.LineChange{Paths: []string{"Directory.Build.props"}, Lines: 1}, "configuration file Directory.Build.props"},
+		{"GithubPath", goMatcher, fabricengine.LineChange{Paths: []string{".github/workflows/ci.yml"}, Lines: 1}, "configuration file .github/workflows/ci.yml"},
+		{"GateYaml", goMatcher, fabricengine.LineChange{Paths: []string{"_lyx/config/gate.yaml"}, Lines: 1}, "configuration file _lyx/config/gate.yaml"},
+		{"AddedTSkip", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 1, AddedLines: []string{"\tt.Skip(\"flaky\")"}}, `skips a test: t.Skip("flaky")`},
+		{"AddedTSkipNow", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 1, AddedLines: []string{"\tt.SkipNow()"}}, "skips a test: t.SkipNow()"},
+		{"AddedIgnoreAttribute", goMatcher, fabricengine.LineChange{Paths: []string{"src/Foo.cs"}, Lines: 1, AddedLines: []string{"[Ignore]"}}, "skips a test: [Ignore]"},
+		{"AddedSkipAssignment", goMatcher, fabricengine.LineChange{Paths: []string{"src/Foo.cs"}, Lines: 1, AddedLines: []string{"[Fact(Skip = \"x\")]"}}, "skips a test: [Fact(Skip = \"x\")]"},
+		{"AddedGoBuildConstraint", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 1, AddedLines: []string{"//go:build linux"}}, "build constraint: //go:build linux"},
+		{"AddedPlusBuildConstraint", goMatcher, fabricengine.LineChange{Paths: []string{"internal/x/x.go"}, Lines: 1, AddedLines: []string{"// +build linux"}}, "build constraint: // +build linux"},
+		{"AddedPreprocessorConstraint", goMatcher, fabricengine.LineChange{Paths: []string{"src/Foo.cs"}, Lines: 1, AddedLines: []string{"#if DEBUG"}}, "build constraint: #if DEBUG"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			got := FixCap{MaxLines: 40, IsTestFile: tt.isTestFile}.Exceeded(tt.change)
+			if tt.want == "" {
+				if got != "" {
+					t.Errorf("Exceeded(%s) = %q; want within the caps", tt.name, got)
+				}
+				return
+			}
+			if !strings.Contains(got, tt.want) {
+				t.Errorf("Exceeded(%s) = %q; want a reason containing %q", tt.name, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/landingshed/fixer.go b/internal/landingshed/fixer.go
new file mode 100644
index 00000000..6780498a
--- /dev/null
+++ b/internal/landingshed/fixer.go
@@ -0,0 +1,132 @@
+// fixer.go builds the merge fixer's session table, the one cold session Merge-In and Finalize spawn to fix a merge or test failure inside their row.
+// FixerTable is the pure builder that turns the row's told values into a seatengine.Table; it derives no path of its own (Told-Geometry Invariant).
+
+package landingshed
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+)
+
+// FixerMode names which row the merge fixer serves and so what it may change.
+type FixerMode string
+
+const (
+	// FixerModeMergeIn is the fixer of Merge-In: it also judges what the parent brought in against the decision record.
+	FixerModeMergeIn FixerMode = "merge-in"
+	// FixerModeFinalize is the fixer of Finalize: it fixes failing tests only.
+	FixerModeFinalize FixerMode = "finalize"
+)
+
+// fixerStencilName is the registered name of the merge fixer's prompt.
+const fixerStencilName = "landing-template-fixer"
+
+// fixerRole is the agent-name role the merge fixer's spawn carries.
+const fixerRole = "fixer"
+
+// FixerInputs carries the told values one merge fixer session needs.
+// Every field is required except PlanDir, FailureRecordPath and LanguageSkills; AlignedTip is required in merge-in mode only.
+type FixerInputs struct {
+	// StencilsDir is the absolute directory the landing stencils are read from.
+	StencilsDir string
+	// Mode is the row the fixer serves.
+	Mode FixerMode
+	// DecisionRecordPath is the run's decision record, which the agent reads.
+	DecisionRecordPath string
+	// MergeRecordPath is the merge record the agent reads.
+	MergeRecordPath string
+	// PlanDir is the run's plan directory; empty for a darn run, which has none.
+	PlanDir string
+	// FailureRecordPath is the landing failure record of the gate that failed; empty before any gate has failed.
+	FailureRecordPath string
+	// AlignedTip is the tip the parent's changes are read from: the merge record's aligned tip or, when it holds none, the entry's fork point.
+	// Empty in finalize mode, where the fixer reads no parent change.
+	AlignedTip string
+	// MergedTip is the tip the merge left on the task branch.
+	MergedTip string
+	// ReportPath is the file the agent writes: its report.
+	ReportPath string
+	// TaskBranch is the branch the agent fixes and commits on.
+	TaskBranch string
+	// ParentBranch is the branch the task lands on.
+	ParentBranch string
+	// Slug is the task's slug.
+	Slug string
+	// LanguageSkills are the run's language skills the session loads before its prompt.
+	LanguageSkills []string
+}
+
+// FixerTable builds the seatengine.Table of the merge fixer session: one lead that fixes on the task branch and writes the report at in.ReportPath.
+// An empty required input field is an error naming the field, and so is an unknown mode and a stencil missing from in.StencilsDir, so a mis-wired closure fails before the row runs rather than rendering a blank path into the prompt.
+// PlanDir and FailureRecordPath are optional values in both modes, and AlignedTip is optional in finalize mode only, so an empty AlignedTip in merge-in mode is refused by name.
+// The table's timeout is one turn's, cfg.FixerTimeoutMin; the caller sets the gate and stretches the timeout over the turns it may spend.
+func FixerTable(in FixerInputs, cfg Config, reg modelspec.Registry) (seatengine.Table, error) {
+	required := []struct{ name, value string }{
+		{"StencilsDir", in.StencilsDir},
+		{"Mode", string(in.Mode)},
+		{"DecisionRecordPath", in.DecisionRecordPath},
+		{"MergeRecordPath", in.MergeRecordPath},
+		{"MergedTip", in.MergedTip},
+		{"ReportPath", in.ReportPath},
+		{"TaskBranch", in.TaskBranch},
+		{"ParentBranch", in.ParentBranch},
+		{"Slug", in.Slug},
+	}
+	for _, r := range required {
+		if r.value == "" {
+			return seatengine.Table{}, fmt.Errorf("landingshed: FixerTable: %s is empty", r.name)
+		}
+	}
+	optional := []string{"plan_dir", "failure_record_path"}
+	switch in.Mode {
+	case FixerModeMergeIn:
+	case FixerModeFinalize:
+		optional = append(optional, "aligned_tip")
+	default:
+		return seatengine.Table{}, fmt.Errorf("landingshed: FixerTable: unknown Mode %q", in.Mode)
+	}
+	if _, err := stencilstore.Read(in.StencilsDir, fixerStencilName); err != nil {
+		return seatengine.Table{}, fmt.Errorf("landingshed: FixerTable: %w", err)
+	}
+
+	parsed, err := modelspec.Parse(cfg.Fixer)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("landingshed: FixerTable: fixer model-spec: %w", err)
+	}
+	resolved, err := reg.Resolve(parsed)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("landingshed: FixerTable: fixer model-spec: %w", err)
+	}
+
+	return seatengine.Table{
+		RolePrefix: fixerRole,
+		Segment:    segmentcolor.Landing,
+		Timeout:    time.Duration(cfg.FixerTimeoutMin) * time.Minute,
+		Values: map[string]string{
+			"slug":                 in.Slug,
+			"mode":                 string(in.Mode),
+			"decision_record_path": in.DecisionRecordPath,
+			"merge_record_path":    in.MergeRecordPath,
+			"plan_dir":             in.PlanDir,
+			"failure_record_path":  in.FailureRecordPath,
+			"aligned_tip":          in.AlignedTip,
+			"merged_tip":           in.MergedTip,
+			"report_path":          in.ReportPath,
+			"task_branch":          in.TaskBranch,
+			"parent_branch":        in.ParentBranch,
+		},
+		Optional: optional,
+		Seats: []seatengine.Seat{{
+			Stencil:     fixerStencilName,
+			ModelChoice: shuttleengine.NewModelChoice(resolved),
+			Outputs:     []string{in.ReportPath},
+			Skills:      in.LanguageSkills,
+		}},
+	}, nil
+}
diff --git a/internal/landingshed/fixer_test.go b/internal/landingshed/fixer_test.go
new file mode 100644
index 00000000..fb59da61
--- /dev/null
+++ b/internal/landingshed/fixer_test.go
@@ -0,0 +1,174 @@
+// fixer_test.go — untagged unit tests for FixerTable.
+// The stencils are the shipped defaults seeded into a t.TempDir() stencils dir;
+// the lead's prompt is composed through seatengine.Prompts, which starts nothing.
+
+package landingshed
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/testkit/stencilkit"
+)
+
+func newFixerInputs(t *testing.T, mode FixerMode) FixerInputs {
+	t.Helper()
+	stencilsDir := t.TempDir()
+	stencilkit.SeedInto(t, stencilsDir)
+	return FixerInputs{
+		StencilsDir:        stencilsDir,
+		Mode:               mode,
+		DecisionRecordPath: "/x/decision-record.md",
+		MergeRecordPath:    "/x/merge-record.json",
+		PlanDir:            "/x/plan",
+		FailureRecordPath:  "/x/landing-failure.yaml",
+		AlignedTip:         "aligned123",
+		MergedTip:          "merged456",
+		ReportPath:         "/x/merge-in-fixer-report.md",
+		TaskBranch:         "task-branch",
+		ParentBranch:       "parent-branch",
+		Slug:               "my-slug",
+		LanguageSkills:     []string{"scribe:golang-build"},
+	}
+}
+
+func TestFixerTable(t *testing.T) {
+	t.Parallel()
+
+	cfg := Config{Fixer: "claude:opus[effort=high]", FixerTimeoutMin: 9}
+
+	for _, mode := range []FixerMode{FixerModeMergeIn, FixerModeFinalize} {
+		t.Run("Table_"+string(mode), func(t *testing.T) {
+			t.Parallel()
+			in := newFixerInputs(t, mode)
+
+			table, err := FixerTable(in, cfg, modelspec.Registry{})
+			if err != nil {
+				t.Fatalf("FixerTable(%s) = _, %v; want nil error", mode, err)
+			}
+			if err := table.Validate(in.StencilsDir); err != nil {
+				t.Fatalf("table.Validate() = %v; want nil", err)
+			}
+
+			lead := table.Chair()
+			if len(table.Seats) != 1 || lead.Name != "" {
+				t.Errorf("table has %d seats, lead name %q; want the lead alone with no name", len(table.Seats), lead.Name)
+			}
+			if table.RolePrefix != "fixer" || table.Segment != segmentcolor.Landing || table.Interactive {
+				t.Errorf("table role prefix/segment/interactive = %q/%q/%v; want fixer/%q/false", table.RolePrefix, table.Segment, table.Interactive, segmentcolor.Landing)
+			}
+			if lead.Engine != "claude" || lead.Model != "opus" || lead.Effort != "high" || table.Timeout != 9*time.Minute {
+				t.Errorf("lead engine/model/effort, table timeout = %q/%q/%q, %v; want claude/opus/high, 9m", lead.Engine, lead.Model, lead.Effort, table.Timeout)
+			}
+			if want := []string{in.ReportPath}; !slices.Equal(lead.Outputs, want) {
+				t.Errorf("lead outputs = %v; want %v", lead.Outputs, want)
+			}
+			if !slices.Equal(lead.Skills, in.LanguageSkills) {
+				t.Errorf("lead skills = %v; want %v", lead.Skills, in.LanguageSkills)
+			}
+			if table.Values["mode"] != string(mode) || table.Values["aligned_tip"] != "aligned123" || table.Values["merged_tip"] != "merged456" {
+				t.Errorf("table values mode/aligned_tip/merged_tip = %q/%q/%q; want %q/aligned123/merged456", table.Values["mode"], table.Values["aligned_tip"], table.Values["merged_tip"], mode)
+			}
+
+			prompt := describeLeadPrompt(t, in.StencilsDir, "ab:cd:webster", table)
+			for _, v := range []string{string(mode), in.DecisionRecordPath, in.MergeRecordPath, in.PlanDir, in.FailureRecordPath, in.AlignedTip, in.MergedTip, in.ReportPath, in.TaskBranch, in.ParentBranch, in.Slug} {
+				if !strings.Contains(prompt, v) {
+					t.Errorf("prompt does not contain input value %q", v)
+				}
+			}
+		})
+	}
+
+	t.Run("OptionalValuesRenderEmpty", func(t *testing.T) {
+		t.Parallel()
+		in := newFixerInputs(t, FixerModeFinalize)
+		in.PlanDir = ""
+		in.FailureRecordPath = ""
+		in.AlignedTip = ""
+
+		table, err := FixerTable(in, cfg, modelspec.Registry{})
+		if err != nil {
+			t.Fatalf("FixerTable(finalize, empty optionals) = _, %v; want nil error", err)
+		}
+		if err := table.Validate(in.StencilsDir); err != nil {
+			t.Fatalf("table.Validate() = %v; want nil", err)
+		}
+		for _, name := range []string{"plan_dir", "failure_record_path", "aligned_tip"} {
+			if !slices.Contains(table.Optional, name) {
+				t.Errorf("finalize table Optional = %v; want it to list %q", table.Optional, name)
+			}
+		}
+		prompt := describeLeadPrompt(t, in.StencilsDir, "ab:cd:webster", table)
+		if strings.Contains(prompt, "{{") {
+			t.Errorf("prompt carries an unrendered marker: %q", prompt)
+		}
+	})
+
+	t.Run("MergeInOptionals", func(t *testing.T) {
+		t.Parallel()
+		in := newFixerInputs(t, FixerModeMergeIn)
+		in.PlanDir = ""
+		in.FailureRecordPath = ""
+
+		table, err := FixerTable(in, cfg, modelspec.Registry{})
+		if err != nil {
+			t.Fatalf("FixerTable(merge-in, empty optionals) = _, %v; want nil error", err)
+		}
+		if want := []string{"plan_dir", "failure_record_path"}; !slices.Equal(table.Optional, want) {
+			t.Errorf("merge-in table Optional = %v; want %v", table.Optional, want)
+		}
+	})
+
+	t.Run("MissingStencil", func(t *testing.T) {
+		t.Parallel()
+		in := newFixerInputs(t, FixerModeMergeIn)
+		if err := os.Remove(filepath.Join(in.StencilsDir, "landing", "landing-template-fixer.md")); err != nil {
+			t.Fatalf("os.Remove(fixer stencil) = %v; want nil", err)
+		}
+
+		if _, err := FixerTable(in, cfg, modelspec.Registry{}); err == nil || !strings.Contains(err.Error(), "landing-template-fixer") {
+			t.Errorf("FixerTable(missing stencil) error = %v; want one naming the stencil", err)
+		}
+	})
+
+	errTests := []struct {
+		name    string
+		mutate  func(in *FixerInputs)
+		mode    FixerMode
+		wantErr string
+	}{
+		{"EmptyStencilsDir", func(in *FixerInputs) { in.StencilsDir = "" }, FixerModeMergeIn, "StencilsDir is empty"},
+		{"EmptyMode", func(in *FixerInputs) { in.Mode = "" }, FixerModeMergeIn, "Mode is empty"},
+		{"EmptyDecisionRecordPath", func(in *FixerInputs) { in.DecisionRecordPath = "" }, FixerModeMergeIn, "DecisionRecordPath is empty"},
+		{"EmptyMergeRecordPath", func(in *FixerInputs) { in.MergeRecordPath = "" }, FixerModeFinalize, "MergeRecordPath is empty"},
+		{"EmptyMergedTip", func(in *FixerInputs) { in.MergedTip = "" }, FixerModeFinalize, "MergedTip is empty"},
+		{"EmptyReportPath", func(in *FixerInputs) { in.ReportPath = "" }, FixerModeMergeIn, "ReportPath is empty"},
+		{"EmptyTaskBranch", func(in *FixerInputs) { in.TaskBranch = "" }, FixerModeMergeIn, "TaskBranch is empty"},
+		{"EmptyParentBranch", func(in *FixerInputs) { in.ParentBranch = "" }, FixerModeMergeIn, "ParentBranch is empty"},
+		{"EmptySlug", func(in *FixerInputs) { in.Slug = "" }, FixerModeMergeIn, "Slug is empty"},
+		{"UnknownMode", func(in *FixerInputs) { in.Mode = "other" }, FixerModeMergeIn, `unknown Mode "other"`},
+		{"MergeInEmptyAlignedTip", func(in *FixerInputs) { in.AlignedTip = "" }, FixerModeMergeIn, "aligned_tip"},
+	}
+	for _, tt := range errTests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			in := newFixerInputs(t, tt.mode)
+			tt.mutate(&in)
+
+			table, err := FixerTable(in, cfg, modelspec.Registry{})
+			if err == nil && in.StencilsDir != "" {
+				// An empty optional the seat engine judges is refused when the table is validated, not when it is built.
+				err = table.Validate(in.StencilsDir)
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+				t.Errorf("FixerTable(%s) error = %v; want one containing %q", tt.name, err, tt.wantErr)
+			}
+		})
+	}
+}
diff --git a/internal/landingshed/fixerattempts.go b/internal/landingshed/fixerattempts.go
new file mode 100644
index 00000000..e8dc3c42
--- /dev/null
+++ b/internal/landingshed/fixerattempts.go
@@ -0,0 +1,70 @@
+// fixerattempts.go implements FixerAttempts, the record of the fixer turns one landing row entry spent, kept in the run's scratch directory so a resume never grants a fresh cap.
+
+package landingshed
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+// FixerAttempts is the fixer turns one row entry spent.
+// An entry has no attempts left when Spent reaches its row's cap, whatever Halt notes.
+type FixerAttempts struct {
+	// Entry is the row entry the record belongs to.
+	Entry int `json:"entry"`
+	// Spent is the fixer turns spent.
+	Spent int `json:"spent"`
+	// Baseline is the HEAD a cap measures a fixer change from.
+	Baseline string `json:"baseline"`
+	// AlignFrom is the parent tip a Merge-In entry reads the parent's changes from when the merge record holds no aligned tip.
+	AlignFrom string `json:"align_from"`
+	// Halt notes the halt that last stopped the entry: "spent", "over-cap" or empty.
+	Halt string `json:"halt"`
+}
+
+// FixerAttemptsPath is the attempt record's path for row under scratchDir: one file per row.
+func FixerAttemptsPath(scratchDir, row string) string {
+	return filepath.Join(scratchDir, row+"-fixer-attempts.json")
+}
+
+// ReadFixerAttempts reads the record at path and returns it when it names entry.
+// A record naming another entry and an absent file both return a zero record for entry, which has spent no attempt.
+// An undecodable file is an error naming it, and an unknown key is tolerated.
+func ReadFixerAttempts(path string, entry int) (FixerAttempts, error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return FixerAttempts{Entry: entry}, nil
+	}
+	if err != nil {
+		return FixerAttempts{}, fmt.Errorf("landingshed: read fixer attempts %s: %w", path, err)
+	}
+	var rec FixerAttempts
+	if err := json.Unmarshal(data, &rec); err != nil {
+		return FixerAttempts{}, fmt.Errorf("landingshed: decode fixer attempts %s: %w", path, err)
+	}
+	if rec.Entry != entry {
+		return FixerAttempts{Entry: entry}, nil
+	}
+	return rec, nil
+}
+
+// WriteFixerAttempts writes rec to path atomically, creating the parent directory.
+func WriteFixerAttempts(path string, rec FixerAttempts) error {
+	data, err := json.Marshal(rec)
+	if err != nil {
+		return fmt.Errorf("landingshed: encode fixer attempts: %w", err)
+	}
+	return writeBytesAtomic(path, "fixer-attempts", data)
+}
+
+// RemoveFixerAttempts removes the record at path; an absent file is no error.
+func RemoveFixerAttempts(path string) error {
+	if err := os.Remove(path); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return fmt.Errorf("landingshed: remove fixer attempts %s: %w", path, err)
+	}
+	return nil
+}
diff --git a/internal/landingshed/fixerattempts_test.go b/internal/landingshed/fixerattempts_test.go
new file mode 100644
index 00000000..c2e824d5
--- /dev/null
+++ b/internal/landingshed/fixerattempts_test.go
@@ -0,0 +1,81 @@
+// fixerattempts_test.go — untagged unit tests for the fixer attempt record.
+
+package landingshed
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestFixerAttempts(t *testing.T) {
+	t.Parallel()
+
+	t.Run("RoundTripsUnderItsOwnEntry", func(t *testing.T) {
+		t.Parallel()
+		path := FixerAttemptsPath(filepath.Join(t.TempDir(), "scratch"), "merge-in")
+		want := FixerAttempts{Entry: 3, Spent: 2, Baseline: "abc123", AlignFrom: "def456", Halt: "over-cap"}
+
+		if err := WriteFixerAttempts(path, want); err != nil {
+			t.Fatalf("WriteFixerAttempts() = %v; want nil", err)
+		}
+		got, err := ReadFixerAttempts(path, 3)
+		if err != nil || got != want {
+			t.Errorf("ReadFixerAttempts(entry 3) = %+v, %v; want %+v, nil", got, err, want)
+		}
+	})
+
+	t.Run("OtherEntryAndAbsentFileReadZero", func(t *testing.T) {
+		t.Parallel()
+		path := FixerAttemptsPath(t.TempDir(), "finalize")
+		if got, err := ReadFixerAttempts(path, 5); err != nil || got != (FixerAttempts{Entry: 5}) {
+			t.Errorf("ReadFixerAttempts(absent) = %+v, %v; want a zero record for entry 5, nil", got, err)
+		}
+
+		if err := WriteFixerAttempts(path, FixerAttempts{Entry: 3, Spent: 2}); err != nil {
+			t.Fatalf("WriteFixerAttempts() = %v; want nil", err)
+		}
+		if got, err := ReadFixerAttempts(path, 4); err != nil || got != (FixerAttempts{Entry: 4}) {
+			t.Errorf("ReadFixerAttempts(other entry) = %+v, %v; want a zero record for entry 4, nil", got, err)
+		}
+	})
+
+	t.Run("ToleratesAnUnknownKey", func(t *testing.T) {
+		t.Parallel()
+		path := FixerAttemptsPath(t.TempDir(), "merge-in")
+		if err := os.WriteFile(path, []byte(`{"entry":1,"spent":2,"future_key":"x"}`), 0o644); err != nil {
+			t.Fatalf("WriteFile() = %v; want nil", err)
+		}
+		if got, err := ReadFixerAttempts(path, 1); err != nil || got.Spent != 2 {
+			t.Errorf("ReadFixerAttempts(unknown key) = %+v, %v; want Spent 2, nil", got, err)
+		}
+	})
+
+	t.Run("RefusesAnUndecodableFileNamingIt", func(t *testing.T) {
+		t.Parallel()
+		path := FixerAttemptsPath(t.TempDir(), "merge-in")
+		if err := os.WriteFile(path, []byte("not json"), 0o644); err != nil {
+			t.Fatalf("WriteFile() = %v; want nil", err)
+		}
+		if _, err := ReadFixerAttempts(path, 1); err == nil || !strings.Contains(err.Error(), path) {
+			t.Errorf("ReadFixerAttempts(undecodable) error = %v; want one naming %s", err, path)
+		}
+	})
+
+	t.Run("RemovesTheFileTwice", func(t *testing.T) {
+		t.Parallel()
+		path := FixerAttemptsPath(t.TempDir(), "merge-in")
+		if err := WriteFixerAttempts(path, FixerAttempts{Entry: 1}); err != nil {
+			t.Fatalf("WriteFixerAttempts() = %v; want nil", err)
+		}
+		for i := 0; i < 2; i++ {
+			if err := RemoveFixerAttempts(path); err != nil {
+				t.Errorf("RemoveFixerAttempts() call %d = %v; want nil", i+1, err)
+			}
+		}
+		if _, err := os.Stat(path); !os.IsNotExist(err) {
+			t.Errorf("os.Stat(%s) = %v; want not exist", path, err)
+		}
+	})
+}
diff --git a/internal/landingshed/fixerreport.go b/internal/landingshed/fixerreport.go
new file mode 100644
index 00000000..a9d097b6
--- /dev/null
+++ b/internal/landingshed/fixerreport.go
@@ -0,0 +1,87 @@
+// fixerreport.go declares the merge fixer's report model and ParseFixerReport, the one reader of the report format contracts/specs/landing-fixer-report-spec.md defines.
+
+package landingshed
+
+import (
+	"fmt"
+	"os"
+	"strings"
+)
+
+// FixerVerdict is the verdict on a merge fixer report's first line.
+type FixerVerdict string
+
+const (
+	// FixerFixed is the verdict of a fixer that made every change the failure needed.
+	FixerFixed FixerVerdict = "fixed"
+	// FixerEscalate is the verdict of a fixer that found a parent change conflicting with a decision of the record.
+	FixerEscalate FixerVerdict = "escalate"
+)
+
+// fixerReportSpecName is the spec every fixer report error points the reader to.
+const fixerReportSpecName = "landing-fixer-report-spec.md"
+
+// fixerVerdictPrefix opens a fixer report's first line.
+const fixerVerdictPrefix = "verdict: "
+
+// FixerReport is the parsed form of a merge fixer's end-of-turn report.
+// ParentChanges and Fixes hold one entry per bullet with the bullet marker removed.
+// Conflict is the trimmed `## Conflict` text, set on an escalate report only.
+type FixerReport struct {
+	Verdict       FixerVerdict
+	ParentChanges []string
+	Fixes         []string
+	Conflict      string
+}
+
+// ParseFixerReport reads the fixer report at path.
+// A missing file is an error wrapping fs.ErrNotExist.
+// A first line that is no known verdict, and an escalate report without a non-empty `## Conflict` section, are errors naming the line and the spec.
+func ParseFixerReport(path string) (FixerReport, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return FixerReport{}, fmt.Errorf("landingshed: read fixer report %s: %w", path, err)
+	}
+
+	lines := strings.Split(string(data), "\n")
+	first := strings.TrimSpace(lines[0])
+	verdict := FixerVerdict(strings.TrimPrefix(first, fixerVerdictPrefix))
+	if !strings.HasPrefix(first, fixerVerdictPrefix) || (verdict != FixerFixed && verdict != FixerEscalate) {
+		return FixerReport{}, fmt.Errorf("landingshed: fixer report %s: line 1 %q is no known verdict; the first line is %q or %q, per %s",
+			path, first, fixerVerdictPrefix+string(FixerFixed), fixerVerdictPrefix+string(FixerEscalate), fixerReportSpecName)
+	}
+
+	report := FixerReport{Verdict: verdict}
+	var conflictLines []string
+	hasConflictSection := false
+	section := ""
+	for _, line := range lines[1:] {
+		if heading, ok := strings.CutPrefix(line, "## "); ok {
+			section = strings.TrimSpace(heading)
+			if section == "Conflict" {
+				hasConflictSection = true
+			}
+			continue
+		}
+		switch section {
+		case "Parent changes":
+			if bullet, ok := strings.CutPrefix(strings.TrimSpace(line), "- "); ok {
+				report.ParentChanges = append(report.ParentChanges, bullet)
+			}
+		case "Fixes":
+			if bullet, ok := strings.CutPrefix(strings.TrimSpace(line), "- "); ok {
+				report.Fixes = append(report.Fixes, bullet)
+			}
+		case "Conflict":
+			conflictLines = append(conflictLines, line)
+		}
+	}
+
+	if verdict == FixerEscalate {
+		report.Conflict = strings.TrimSpace(strings.Join(conflictLines, "\n"))
+		if !hasConflictSection || report.Conflict == "" {
+			return FixerReport{}, fmt.Errorf("landingshed: fixer report %s: an escalate report needs a non-empty \"## Conflict\" section, per %s", path, fixerReportSpecName)
+		}
+	}
+	return report, nil
+}
diff --git a/internal/landingshed/fixerreport_test.go b/internal/landingshed/fixerreport_test.go
new file mode 100644
index 00000000..8da726aa
--- /dev/null
+++ b/internal/landingshed/fixerreport_test.go
@@ -0,0 +1,93 @@
+// fixerreport_test.go pins ParseFixerReport's verdicts, sections and refusals.
+
+package landingshed
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestParseFixerReport(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		content string
+		want    FixerReport
+		wantErr string
+	}{
+		{
+			name:    "fixed with parent changes and fixes",
+			content: "verdict: fixed\n\n## Parent changes\n\n- abc123: renames Foo; fits decision D2\n- def456: adds Bar; no conflict\n\n## Fixes\n\n- 0123abc: restored the call to Foo\n",
+			want: FixerReport{
+				Verdict:       FixerFixed,
+				ParentChanges: []string{"abc123: renames Foo; fits decision D2", "def456: adds Bar; no conflict"},
+				Fixes:         []string{"0123abc: restored the call to Foo"},
+			},
+		},
+		{
+			name:    "finalize mode fixed with an empty parent changes section",
+			content: "verdict: fixed\n\n## Parent changes\n\n## Fixes\n\n- 0123abc: fixed the failing test\n",
+			want: FixerReport{
+				Verdict: FixerFixed,
+				Fixes:   []string{"0123abc: fixed the failing test"},
+			},
+		},
+		{
+			name:    "escalate with its conflict",
+			content: "verdict: escalate\n\n## Parent changes\n\n- abc123: drops Foo\n\n## Fixes\n\n## Conflict\n\nabc123 drops Foo, which decision D2 keeps.\nNo change satisfies both.\n",
+			want: FixerReport{
+				Verdict:       FixerEscalate,
+				ParentChanges: []string{"abc123: drops Foo"},
+				Conflict:      "abc123 drops Foo, which decision D2 keeps.\nNo change satisfies both.",
+			},
+		},
+		{
+			name:    "unknown verdict",
+			content: "verdict: maybe\n\n## Fixes\n",
+			wantErr: "line 1",
+		},
+		{
+			name:    "escalate without its conflict",
+			content: "verdict: escalate\n\n## Parent changes\n\n- abc123: drops Foo\n",
+			wantErr: "## Conflict",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			path := filepath.Join(t.TempDir(), "report.md")
+			if err := os.WriteFile(path, []byte(tt.content), 0o644); err != nil {
+				t.Fatalf("write report: %v", err)
+			}
+			got, err := ParseFixerReport(path)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) || !strings.Contains(err.Error(), "landing-fixer-report-spec.md") {
+					t.Fatalf("ParseFixerReport() error = %v; want it to contain %q and name the spec", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("ParseFixerReport() error = %v; want nil", err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("ParseFixerReport() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+
+	t.Run("missing file", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ParseFixerReport(filepath.Join(t.TempDir(), "absent.md"))
+		if !errors.Is(err, fs.ErrNotExist) {
+			t.Errorf("ParseFixerReport() error = %v; want it to wrap fs.ErrNotExist", err)
+		}
+	})
+}
diff --git a/internal/landingshed/fixerrun.go b/internal/landingshed/fixerrun.go
new file mode 100644
index 00000000..25d97e91
--- /dev/null
+++ b/internal/landingshed/fixerrun.go
@@ -0,0 +1,321 @@
+// fixerrun.go implements the merge fixer loop Merge-In and Finalize share: one cold session per row entry, held to a turn budget kept in the attempt record, and judged by what the session's report and the landing gate say after each turn.
+
+package landingshed
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/verifytree"
+)
+
+// LandingStopPrefix opens the reason of every halt a landing row hands back to the orch, so the hand-back predicate finds it.
+const LandingStopPrefix = "landing stop: "
+
+// fixerGateName labels the fixer session's one gate entry.
+const fixerGateName = "landing"
+
+// fixerSeats is the seat runner the fixer session runs on, which *seatengine.Engine satisfies.
+type fixerSeats interface {
+	// Run starts table's seats fresh and returns once the chair has ended.
+	Run(table seatengine.Table) (seatengine.Result, error)
+}
+
+var _ fixerSeats = (*seatengine.Engine)(nil)
+
+// fixerEnd names how one fixer run ended.
+type fixerEnd string
+
+const (
+	// fixerEndFixed is a turn whose report says fixed and over which the landing gate passes.
+	fixerEndFixed fixerEnd = "fixed"
+	// fixerEndEscalate is a report that escalates a conflict between the parent's change and a decision of the record.
+	fixerEndEscalate fixerEnd = "escalate"
+	// fixerEndSpent is a landing gate that still fails after the last turn the entry had left.
+	fixerEndSpent fixerEnd = "spent"
+	// fixerEndTimeout is a turn that outran fixer_timeout_min, or a session that outran the bound of every turn the entry had left.
+	fixerEndTimeout fixerEnd = "timeout"
+	// fixerEndNoReport is a turn that left no report, or one that does not parse.
+	fixerEndNoReport fixerEnd = "no-report"
+	// fixerEndDirty is a turn that left the working tree dirty.
+	fixerEndDirty fixerEnd = "dirty"
+	// fixerEndPushed is a session during which the task branch's remote ref moved.
+	fixerEndPushed fixerEnd = "pushed"
+)
+
+// fixerOutcome is how a fixer run ended and what the halt that follows names.
+type fixerOutcome struct {
+	// end is how the run ended.
+	end fixerEnd
+	// reportPath is the report the session writes.
+	reportPath string
+	// sessionLog is the session's run directory, which holds its log.
+	sessionLog string
+	// failureLog is the log the landing failure record names; set for a spent end.
+	failureLog string
+	// conflict is the report's conflict text; set for an escalate end.
+	conflict string
+	// pushedRef is the remote ref that moved, with its new tip; set for a pushed end.
+	pushedRef string
+}
+
+// fixerRun runs the merge fixer for one row.
+type fixerRun struct {
+	deps  Deps
+	row   string
+	gate  verifyGate
+	seats fixerSeats
+}
+
+// newFixerRun returns the fixer loop of row over deps' seams, judging each turn through gate.
+func newFixerRun(deps Deps, row string, gate verifyGate) fixerRun {
+	return fixerRun{deps: deps, row: row, gate: gate, seats: deps.FixerSeats}
+}
+
+// run spends the turns rec has left on one fixer session in mode and returns how it ended with the attempt record as it stands then.
+// cap is the row's turn cap, and tips are the tip the parent's changes are read from and the merged tip.
+// It is never called with no turn left, since a row takes its exhausted-entry path first.
+// A turn is charged into the record when it starts, so a turn that never returns to the gate is still spent.
+// The first turn's charge is taken back when the session fails to start, an error marked transient, and an escalate report takes its own turn back.
+func (f fixerRun) run(ctx context.Context, mode FixerMode, rec FixerAttempts, cap int, tips [2]string) (fixerOutcome, FixerAttempts, error) {
+	reportPath := filepath.Join(f.deps.ScratchDir, f.row+"-fixer-report.md")
+	attemptsPath := FixerAttemptsPath(f.deps.ScratchDir, f.row)
+	turnsLeft := cap - rec.Spent
+	turnLimit := time.Duration(f.deps.Config.FixerTimeoutMin) * time.Minute
+
+	table, err := FixerTable(FixerInputs{
+		StencilsDir:        f.deps.StencilsDir,
+		Mode:               mode,
+		DecisionRecordPath: f.deps.DecisionRecordPath,
+		MergeRecordPath:    f.deps.MergeRecordPath,
+		PlanDir:            f.deps.PlanDir,
+		FailureRecordPath:  f.failureRecordPath(),
+		AlignedTip:         tips[0],
+		MergedTip:          tips[1],
+		ReportPath:         reportPath,
+		TaskBranch:         f.deps.TaskBranch,
+		ParentBranch:       f.deps.ParentBranch,
+		Slug:               f.deps.Slug,
+		LanguageSkills:     f.deps.LanguageSkills,
+	}, f.deps.Config, f.deps.Registry)
+	if err != nil {
+		return fixerOutcome{}, rec, fmt.Errorf("landingshed: %s: %w", f.row, err)
+	}
+	if err := f.archiveStaleReport(reportPath); err != nil {
+		return fixerOutcome{}, rec, err
+	}
+	remoteBefore, err := f.deps.TaskRemoteTip()
+	if err != nil {
+		return fixerOutcome{}, rec, fmt.Errorf("landingshed: %s: read the task branch's remote tip: %w", f.row, err)
+	}
+
+	original := rec
+	session := &fixerSession{run: f, ctx: ctx, rec: rec, cap: cap, attemptsPath: attemptsPath, turnLimit: turnLimit, outcome: fixerOutcome{reportPath: reportPath}}
+	if err := session.chargeTurn(); err != nil {
+		return fixerOutcome{}, rec, err
+	}
+	table.Timeout = turnLimit * time.Duration(turnsLeft)
+	table.Gate = shuttleengine.GateSpec{{Name: fixerGateName, Gate: session.check, Attempts: turnsLeft}}
+
+	result, runErr := f.seats.Run(table)
+	if session.err != nil {
+		return fixerOutcome{}, session.rec, session.err
+	}
+	if (runErr != nil && errors.Is(runErr, shuttleengine.ErrNotStarted)) || (runErr == nil && result.Chair.NotStarted) {
+		cause := runErr
+		if cause == nil {
+			cause = errors.New(result.Chair.StartError)
+		}
+		if err := WriteFixerAttempts(attemptsPath, original); err != nil {
+			return fixerOutcome{}, session.rec, err
+		}
+		return fixerOutcome{}, original, shedengine.MarkTransient(shedengine.TransientAgentStart, fmt.Errorf("landingshed: %s: the fixer session did not start: %w", f.row, cause))
+	}
+	if runErr != nil {
+		return fixerOutcome{}, session.rec, fmt.Errorf("landingshed: %s: run the fixer session: %w", f.row, runErr)
+	}
+
+	outcome := session.outcome
+	outcome.sessionLog = result.Chair.RunDir
+	switch {
+	case session.end != "":
+		outcome.end = session.end
+	case session.decided != nil && session.decided.Passed:
+		outcome.end = fixerEndFixed
+	case result.Chair.Outcome == shuttleengine.OutcomeTimeout:
+		outcome.end = fixerEndTimeout
+	default:
+		outcome.end = fixerEndNoReport
+	}
+
+	remoteAfter, err := f.deps.TaskRemoteTip()
+	if err != nil {
+		return fixerOutcome{}, session.rec, fmt.Errorf("landingshed: %s: read the task branch's remote tip: %w", f.row, err)
+	}
+	if remoteAfter != remoteBefore {
+		outcome.end = fixerEndPushed
+		outcome.pushedRef = fmt.Sprintf("origin/%s at %s", f.deps.TaskBranch, remoteAfter)
+	}
+	logger.Info("landingshed: fixer run ended", "row", f.row, "mode", string(mode), "end", string(outcome.end), "spent", session.rec.Spent, "cap", cap)
+	return outcome, session.rec, nil
+}
+
+// failureRecordPath returns the landing failure record's path when a failed gate left one, and "" before any gate has failed.
+func (f fixerRun) failureRecordPath() string {
+	if _, err := os.Stat(f.gate.paths.LandingFailure); err != nil {
+		return ""
+	}
+	return f.gate.paths.LandingFailure
+}
+
+// archiveStaleReport renames a report an earlier fixer run left at reportPath, so a new session never starts beside a finished report.
+func (f fixerRun) archiveStaleReport(reportPath string) error {
+	stamp := f.gate.now().UTC().Format("20060102T150405Z")
+	archived := strings.TrimSuffix(reportPath, ".md") + "-" + stamp + ".md"
+	if err := os.Rename(reportPath, archived); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return fmt.Errorf("landingshed: %s: archive the stale fixer report: %w", f.row, err)
+	}
+	return nil
+}
+
+// fixerSession is the state one fixer run shares with the gate closure the seat run calls after each turn.
+type fixerSession struct {
+	run          fixerRun
+	ctx          context.Context
+	rec          FixerAttempts
+	cap          int
+	attemptsPath string
+	turnLimit    time.Duration
+	turnStart    time.Time
+	outcome      fixerOutcome
+
+	// end is the halting end the closure decided, "" while the run is fixed or undecided.
+	end fixerEnd
+	// decided holds the closure's last terminal answer, so a second evaluation of a finished run answers the same without charging again.
+	// A passed answer is what makes the run fixed; nil means no turn has ended the run yet.
+	decided *shuttleengine.GateResult
+	// err is an infrastructure error the closure met, which the run returns after the seat run ends.
+	err error
+}
+
+// chargeTurn counts the turn that starts now into the record and writes it.
+func (s *fixerSession) chargeTurn() error {
+	s.rec.Spent++
+	s.turnStart = s.run.gate.now()
+	return WriteFixerAttempts(s.attemptsPath, s.rec)
+}
+
+// halt records end as the run's end and answers the terminal gate result that finalizes the seat run at once.
+func (s *fixerSession) halt(end fixerEnd, findings string) (shuttleengine.GateResult, error) {
+	s.end = end
+	result := shuttleengine.GateResult{Findings: findings, Terminal: true}
+	s.decided = &result
+	return result, nil
+}
+
+// check is the gate closure run after every turn.
+// It judges the turn's duration, then the tree, then the report, and on a fixed verdict the landing gate.
+// A failing gate with a turn left charges it and re-prompts; one with none left is the spent end.
+func (s *fixerSession) check() (shuttleengine.GateResult, error) {
+	result, err := s.judge()
+	if err != nil {
+		s.err = err
+		return shuttleengine.GateResult{}, err
+	}
+	return result, nil
+}
+
+func (s *fixerSession) judge() (shuttleengine.GateResult, error) {
+	if s.decided != nil {
+		return *s.decided, nil
+	}
+	gate := s.run.gate
+	if gate.now().Sub(s.turnStart) > s.turnLimit {
+		return s.halt(fixerEndTimeout, "the fixer's turn ran past fixer_timeout_min")
+	}
+	reason, err := gate.clean(s.run.row, "after the fixer's turn")
+	if err != nil {
+		return shuttleengine.GateResult{}, err
+	}
+	if reason != "" {
+		return s.halt(fixerEndDirty, reason)
+	}
+	report, err := ParseFixerReport(s.outcome.reportPath)
+	if err != nil {
+		return s.halt(fixerEndNoReport, err.Error())
+	}
+	if report.Verdict == FixerEscalate {
+		s.rec.Spent--
+		if err := WriteFixerAttempts(s.attemptsPath, s.rec); err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		s.outcome.conflict = report.Conflict
+		return s.halt(fixerEndEscalate, report.Conflict)
+	}
+
+	reason, err = gate.check(s.ctx, s.run.row, s.run.deps.ParentBranch)
+	if err != nil {
+		return shuttleengine.GateResult{}, err
+	}
+	if reason == "" {
+		passed := shuttleengine.GateResult{Passed: true}
+		s.decided = &passed
+		return passed, nil
+	}
+	if s.rec.Spent >= s.cap {
+		failure, found, err := verifytree.ReadLandingFailure(gate.paths)
+		if err != nil {
+			return shuttleengine.GateResult{}, err
+		}
+		if found {
+			s.outcome.failureLog = failure.LogPath
+		}
+		return s.halt(fixerEndSpent, reason)
+	}
+	if err := s.chargeTurn(); err != nil {
+		return shuttleengine.GateResult{}, err
+	}
+	findings := reason
+	if path := s.run.failureRecordPath(); path != "" {
+		findings += "\nlanding failure record: " + path
+	}
+	return shuttleengine.GateResult{Findings: findings}, nil
+}
+
+// haltReason words the halt a run that did not end fixed ends the row with.
+// Each reason opens with LandingStopPrefix and ends with a way forward, and is one line.
+func (o fixerOutcome) haltReason(row string) string {
+	var cause, wayForward string
+	switch o.end {
+	case fixerEndSpent:
+		cause = fmt.Sprintf("the fixer spent every attempt of %s and the landing gate still fails; log: %s", row, o.failureLog)
+		wayForward = "fix the failure on the task branch, then `lyx loom resume`"
+	case fixerEndEscalate:
+		cause = fmt.Sprintf("the fixer of %s found a parent change that conflicts with a decision of the record; report: %s; conflict: %s", row, o.reportPath, singleLine(o.conflict))
+		wayForward = "add the deciding decision with `lyx loom decision add` in the task worktree, then `lyx loom resume`"
+	case fixerEndTimeout, fixerEndNoReport, fixerEndDirty:
+		cause = fmt.Sprintf("the fixer session of %s ended without a usable turn (%s); session log: %s; report: %s", row, o.end, o.sessionLog, o.reportPath)
+		wayForward = "fix or clean the task branch, then `lyx loom resume`"
+	case fixerEndPushed:
+		cause = fmt.Sprintf("the fixer session of %s pushed %s; session log: %s", row, o.pushedRef, o.sessionLog)
+		wayForward = "check the pushed commits are the task's, then `lyx loom resume`"
+	default:
+		return ""
+	}
+	return LandingStopPrefix + cause + "; way forward: " + wayForward
+}
+
+// singleLine collapses every run of whitespace in text, line breaks included, to one space.
+func singleLine(text string) string {
+	return strings.Join(strings.Fields(text), " ")
+}
