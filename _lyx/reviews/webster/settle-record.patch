+++ b/internal/cardverify/runner.go
@@ -0,0 +1,168 @@
+// runner.go — the runner of a card's `**Verify:**` lines: one line through the platform shell, and every card's line in card order.
+
+package cardverify
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/planparser"
+	"github.com/Knatte18/loomyard/internal/verifyrun"
+)
+
+// DefaultTimeout bounds a slot-held line when a Runner's Timeout is zero.
+const DefaultTimeout = 10 * time.Minute
+
+// gateCallPrefix starts every line IsGateCall accepts.
+var gateCallPrefix = []string{"lyx", "gate", "test"}
+
+// waitFlag is the gate flag a line must hold to run outside the runner's timeout.
+const waitFlag = "--wait"
+
+// controlOperators are the shell constructs that make a line more than one `lyx gate test` call.
+var controlOperators = []string{";", "&", "|", "\n", "`", "$(", "<", ">"}
+
+// Runner runs a card's `**Verify:**` lines in a worktree.
+type Runner struct {
+	// Worktree is the directory every line runs in.
+	Worktree string
+	// Slots is the told gate-slot pool a slot-held line takes one slot of; nil runs every line unslotted with the parent's environment.
+	Slots *gateslot.Pool
+	// WaitDir is the directory a slot-held line writes its wait record into while it waits; empty writes none.
+	WaitDir string
+	// Timeout bounds a slot-held line from the moment its slot is held; zero means DefaultTimeout.
+	Timeout time.Duration
+}
+
+// RunLine runs one `**Verify:**` line through verifyrun.Run in the worktree, its output to out, and returns how it failed, empty when it passed.
+// A failure reads `exited <code>`, `failed to start: <err>`, `could not acquire a gate slot: <err>` or `timed out after <timeout>`.
+// A line IsGateCall accepts runs unslotted and outside the timeout, since the gate's own pre-tier ceiling and tier timeouts bound it.
+// Any other line takes one slot of the pool without a cap on the wait, and runs under the timeout counted from the moment the slot is held, with the environment gateslot.HolderEnv returns.
+// Neither sees gateslot.PrebuiltLyxEnv: a line's own go test builds lyx once per test binary.
+func (r Runner) RunLine(line string, out io.Writer) string {
+	return r.runLine(strings.TrimSpace(line), "card verify", out)
+}
+
+// runLine is RunLine with site as the label of the slot holder and wait record.
+func (r Runner) runLine(line, site string, out io.Writer) string {
+	env := gateslot.StripPrebuilt(os.Environ())
+	if IsGateCall(line) {
+		return r.execute(context.Background(), line, env, out, 0)
+	}
+	if r.Slots == nil {
+		return r.execute(context.Background(), line, env, out, r.timeout())
+	}
+	lease, err := r.acquire(site)
+	if err != nil {
+		return fmt.Sprintf("could not acquire a gate slot: %v", err)
+	}
+	defer func() {
+		if err := lease.Release(); err != nil {
+			logger.Warn("cardverify: release gate slot", "site", site, "cause", err)
+		}
+	}()
+	limits, err := r.Slots.Limits()
+	if err != nil {
+		return fmt.Sprintf("could not acquire a gate slot: read gate limits: %v", err)
+	}
+	return r.execute(context.Background(), line, gateslot.HolderEnv(env, lease, limits.Tier0Parallel), out, r.timeout())
+}
+
+// RunCards runs each card's `**Verify:**` value in card order, its output to out, and returns one line per failing card, `card NN-<slug> verify <command> <how>`, where <how> is RunLine's failure.
+// A card with no `**Verify:**` passes, and stopAtFirst ends the run at the first failing card.
+// It returns no error: a line that cannot start is a failed line.
+func (r Runner) RunCards(cards []planparser.Card, out io.Writer, stopAtFirst bool) []string {
+	var failures []string
+	for _, card := range cards {
+		command := strings.TrimSpace(card.Verify)
+		if !card.HasVerify || command == "" {
+			continue
+		}
+		label := fmt.Sprintf("%02d-%s", card.Number, card.Slug)
+		how := r.runLine(command, "card verify "+label, out)
+		if how == "" {
+			continue
+		}
+		failures = append(failures, fmt.Sprintf("card %s verify %s %s", label, command, how))
+		if stopAtFirst {
+			break
+		}
+	}
+	return failures
+}
+
+// IsGateCall reports whether line is exactly one `lyx gate test` call that holds `--wait` before any `--` and no shell control operator.
+// Such a line blocks for its slots itself, so a runner leaves it unslotted and unbounded.
+func IsGateCall(line string) bool {
+	for _, operator := range controlOperators {
+		if strings.Contains(line, operator) {
+			return false
+		}
+	}
+	words := strings.Fields(line)
+	if len(words) < len(gateCallPrefix) {
+		return false
+	}
+	for i, word := range gateCallPrefix {
+		if words[i] != word {
+			return false
+		}
+	}
+	for _, word := range words[len(gateCallPrefix):] {
+		switch word {
+		case "--":
+			return false
+		case waitFlag:
+			return true
+		}
+	}
+	return false
+}
+
+// timeout returns the slot-held bound.
+func (r Runner) timeout() time.Duration {
+	if r.Timeout <= 0 {
+		return DefaultTimeout
+	}
+	return r.Timeout
+}
+
+// execute runs line under env and returns how it failed, empty when it passed; a zero bound runs without one.
+func (r Runner) execute(ctx context.Context, line string, env []string, out io.Writer, bound time.Duration) string {
+	if bound > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, bound)
+		defer cancel()
+	}
+	code, err := verifyrun.Run(ctx, line, r.Worktree, env, out)
+	switch {
+	case errors.Is(err, context.DeadlineExceeded):
+		return fmt.Sprintf("timed out after %s", bound)
+	case err != nil:
+		return fmt.Sprintf("failed to start: %v", err)
+	case code != 0:
+		return fmt.Sprintf("exited %d", code)
+	}
+	return ""
+}
+
+// acquire takes one slot for site, keeping a wait record in the wait directory until the acquire returns.
+// A wait record that cannot be written is logged and skipped, since it only feeds the status display.
+func (r Runner) acquire(site string) (*gateslot.Lease, error) {
+	if r.WaitDir != "" {
+		waitPath, err := gateslot.WriteWait(r.WaitDir, gateslot.Wait{Site: site, PID: os.Getpid(), Started: time.Now()})
+		if err != nil {
+			logger.Warn("cardverify: write gate wait record", "site", site, "cause", err)
+		} else {
+			defer os.Remove(waitPath)
+		}
+	}
+	return r.Slots.Acquire(context.Background(), gateslot.Holder{Worktree: r.Worktree, Site: site})
+}
diff --git a/internal/cardverify/runner_test.go b/internal/cardverify/runner_test.go
new file mode 100644
index 00000000..f05f1b60
--- /dev/null
+++ b/internal/cardverify/runner_test.go
@@ -0,0 +1,179 @@
+//go:build integration
+
+// runner_test.go exercises Runner against real shell lines and a temp gate-slot pool.
+
+package cardverify
+
+import (
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/planparser"
+)
+
+func verifyCard(n int, slug, command string) planparser.Card {
+	return planparser.Card{Number: n, Slug: slug, Verify: command, HasVerify: command != ""}
+}
+
+func newPool(t *testing.T, limits func() (gateslot.Limits, error)) *gateslot.Pool {
+	t.Helper()
+	return &gateslot.Pool{Dir: filepath.Join(t.TempDir(), "gate"), Limits: limits, Poll: 10 * time.Millisecond}
+}
+
+// TestRunner does not call t.Parallel: two subtests set the process environment through t.Setenv, which forbids it in the test and its ancestors.
+// Those subtests run first, in order, and the parallel ones resume after.
+func TestRunner(t *testing.T) {
+	t.Run("a stale prebuilt-lyx variable never reaches a line", func(t *testing.T) {
+		t.Setenv(gateslot.PrebuiltLyxEnv, "/stale/lyx")
+		runner := Runner{Worktree: t.TempDir()}
+		cards := []planparser.Card{verifyCard(1, "a", "true"), verifyCard(2, "b", ""), verifyCard(3, "c", `test -z "$`+gateslot.PrebuiltLyxEnv+`"`)}
+		if got := runner.RunCards(cards, io.Discard, false); len(got) != 0 {
+			t.Fatalf("RunCards() = %v; want no failures", got)
+		}
+	})
+
+	t.Run("a gate call takes no slot and no runner timeout bounds it", func(t *testing.T) {
+		stubDir := t.TempDir()
+		stub := "#!/bin/sh\nsleep 1\nexit 0\n"
+		if err := os.WriteFile(filepath.Join(stubDir, "lyx"), []byte(stub), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		t.Setenv("PATH", stubDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+		pool := newPool(t, func() (gateslot.Limits, error) { return gateslot.Limits{}, errors.New("a gate call reads no limits") })
+		runner := Runner{Worktree: t.TempDir(), Slots: pool, Timeout: 200 * time.Millisecond}
+
+		if got := runner.RunLine("lyx gate test --wait ./x", io.Discard); got != "" {
+			t.Errorf("RunLine(gate call) = %q; want a pass", got)
+		}
+		if got := runner.RunLine("lyx gate test ./x", io.Discard); !strings.Contains(got, "could not acquire a gate slot") {
+			t.Errorf("RunLine(gate call without --wait) = %q; want it slot-held", got)
+		}
+	})
+
+	t.Run("unslotted lines", func(t *testing.T) {
+		t.Parallel()
+		missing := filepath.Join(t.TempDir(), "nope")
+		tests := []struct {
+			name     string
+			worktree string
+			timeout  time.Duration
+			cards    []planparser.Card
+			stop     bool
+			want     func(got []string) bool
+			wantDesc string
+		}{
+			{
+				name:     "a passing and a non-zero line give the record-batch failure line",
+				cards:    []planparser.Card{verifyCard(1, "a", "true"), verifyCard(2, "b", "exit 3")},
+				want:     func(got []string) bool { return slices.Equal(got, []string{"card 02-b verify exit 3 exited 3"}) },
+				wantDesc: `["card 02-b verify exit 3 exited 3"]`,
+			},
+			{
+				name:     "stopAtFirst ends the run at the first failing card",
+				cards:    []planparser.Card{verifyCard(1, "a", "exit 1"), verifyCard(2, "b", "exit 2")},
+				stop:     true,
+				want:     func(got []string) bool { return slices.Equal(got, []string{"card 01-a verify exit 1 exited 1"}) },
+				wantDesc: `["card 01-a verify exit 1 exited 1"]`,
+			},
+			{
+				name:  "without stopAtFirst every failing card is named",
+				cards: []planparser.Card{verifyCard(1, "a", "exit 1"), verifyCard(2, "b", "exit 2")},
+				want: func(got []string) bool {
+					return slices.Equal(got, []string{"card 01-a verify exit 1 exited 1", "card 02-b verify exit 2 exited 2"})
+				},
+				wantDesc: "both failing cards",
+			},
+			{
+				name:     "a line past the timeout is named",
+				timeout:  200 * time.Millisecond,
+				cards:    []planparser.Card{verifyCard(4, "slow", "sleep 5")},
+				want:     func(got []string) bool { return len(got) == 1 && strings.Contains(got[0], "timed out after 200ms") },
+				wantDesc: "a timed out after 200ms line",
+			},
+			{
+				name:     "a missing worktree fails the line",
+				worktree: missing,
+				cards:    []planparser.Card{verifyCard(5, "gone", "true")},
+				want: func(got []string) bool {
+					return len(got) == 1 && strings.HasPrefix(got[0], "card 05-gone verify true ")
+				},
+				wantDesc: "a failing card 05-gone line",
+			},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				worktree := tt.worktree
+				if worktree == "" {
+					worktree = t.TempDir()
+				}
+				runner := Runner{Worktree: worktree, Timeout: tt.timeout}
+				if got := runner.RunCards(tt.cards, io.Discard, tt.stop); !tt.want(got) {
+					t.Errorf("RunCards() = %v; want %s", got, tt.wantDesc)
+				}
+			})
+		}
+	})
+
+	t.Run("slot-held lines", func(t *testing.T) {
+		t.Parallel()
+
+		const requireFlags = `case "$GOFLAGS" in *"-p=6 -trimpath"*) true;; *) exit 9;; esac`
+		tests := []struct {
+			name        string
+			limits      func() (gateslot.Limits, error)
+			command     string
+			timeout     time.Duration
+			wantFailure string
+		}{
+			{
+				name:    "the line sees the pool's tier0 parallel and -trimpath through HolderEnv",
+				limits:  func() (gateslot.Limits, error) { return gateslot.Limits{Slots: 1, Tier0Parallel: 6}, nil },
+				command: requireFlags,
+			},
+			{
+				name:        "a line past the timeout once its slot is held is named",
+				limits:      func() (gateslot.Limits, error) { return gateslot.Limits{Slots: 1}, nil },
+				command:     "sleep 5",
+				timeout:     200 * time.Millisecond,
+				wantFailure: "card 07-slotted verify sleep 5 timed out after 200ms",
+			},
+			{
+				name:        "unusable limits are a failing line naming the cause",
+				limits:      func() (gateslot.Limits, error) { return gateslot.Limits{}, errors.New("gate.yaml is unreadable") },
+				command:     "true",
+				wantFailure: "card 07-slotted verify true could not acquire a gate slot: read gate limits: gate.yaml is unreadable",
+			},
+		}
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				pool := newPool(t, tt.limits)
+				waitDir := filepath.Join(t.TempDir(), "wait")
+				runner := Runner{Worktree: t.TempDir(), Slots: pool, WaitDir: waitDir, Timeout: tt.timeout}
+
+				got := runner.RunCards([]planparser.Card{verifyCard(7, "slotted", tt.command)}, io.Discard, false)
+
+				switch {
+				case tt.wantFailure == "" && len(got) != 0:
+					t.Errorf("RunCards() = %v; want no failures", got)
+				case tt.wantFailure != "" && !slices.Equal(got, []string{tt.wantFailure}):
+					t.Errorf("RunCards() = %v; want [%q]", got, tt.wantFailure)
+				}
+				if entries, err := os.ReadDir(waitDir); err != nil || len(entries) != 0 {
+					t.Errorf("wait directory = (%v, %v); want it to hold no record once the run returns", entries, err)
+				}
+				if holders, err := pool.Holders(); err != nil || len(holders) != 0 {
+					t.Errorf("Holders() = (%v, %v); want the slot released", holders, err)
+				}
+			})
+		}
+	})
+}
