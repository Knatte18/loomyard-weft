+// owners_test.go — ParseOwners, Owners.Effective and OwnedElsewhere.
+
+package boardengine
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestOwnersEffective(t *testing.T) {
+	t.Parallel()
+
+	errParent := errors.New("parent unreadable")
+	parents := map[string]string{"child": "", "grand": "pair", "pair": ""}
+	parentOf := func(slug string) (string, error) { return parents[slug], nil }
+	failingParentOf := func(string) (string, error) { return "", errParent }
+
+	entries := `"entries":[` +
+		`{"id":0,"slug":"child","title":"c","kind":"task","labels":["bug"],"status":"idle"},` +
+		`{"id":1,"slug":"pair","title":"p","kind":"task","labels":["bug"],"owner_machine":"box"},` +
+		`{"id":2,"slug":"grand","title":"g","kind":"task","labels":["bug"]},` +
+		`{"id":3,"slug":"running","title":"r","kind":"task","labels":["bug"],"status":"` + RunStatus("running", "Implementer") + `"}]`
+	board := func(prime string) []byte {
+		if prime == "" {
+			return []byte(`{"version":1,` + entries + `}`)
+		}
+		return []byte(`{"version":1,"prime_owner":"` + prime + `",` + entries + `}`)
+	}
+
+	tests := []struct {
+		name     string
+		board    []byte
+		slug     string
+		parentOf func(string) (string, error)
+		want     string
+		wantErr  error
+		parseErr bool
+	}{
+		{name: "EmptyBytesHoldNoEntry", board: nil, slug: "child", parentOf: parentOf, want: ""},
+		{name: "UndecodableBytesReturnTheError", board: []byte(`{`), slug: "child", parentOf: parentOf, parseErr: true},
+		{name: "NoPrimeOwnerReadsAsNoOwner", board: board(""), slug: "pair", parentOf: parentOf, want: ""},
+		{name: "RecordedOwnerStands", board: board("neve"), slug: "pair", parentOf: parentOf, want: "box"},
+		{name: "RunHeldWithoutOwnerReadsAsNoOwner", board: board("neve"), slug: "running", parentOf: parentOf, want: ""},
+		{name: "UnownedTaskFollowsThePrime", board: board("neve"), slug: "child", parentOf: parentOf, want: "neve"},
+		{name: "UnownedTaskFollowsAPairParentsOwner", board: board("neve"), slug: "grand", parentOf: parentOf, want: "box"},
+		{name: "AbsentSlugReadsAsNoOwner", board: board("neve"), slug: "ghost", parentOf: parentOf, want: ""},
+		{name: "ParentErrorIsReturned", board: board("neve"), slug: "child", parentOf: failingParentOf, wantErr: errParent},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			owners, err := ParseOwners(tt.board)
+			if tt.parseErr {
+				if err == nil {
+					t.Fatalf("ParseOwners(%q) error = nil; want an error", tt.board)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("ParseOwners(%q) error = %v; want nil", tt.board, err)
+			}
+			got, err := owners.Effective(tt.slug, tt.parentOf)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Effective(%q) error = %v; want %v", tt.slug, err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("Effective(%q) = %q; want %q", tt.slug, got, tt.want)
+			}
+		})
+	}
+
+	elsewhere := []struct {
+		name        string
+		owner, here string
+		want        bool
+	}{
+		{"EmptyOwnerIsOwnedByNoOther", "", "neve", false},
+		{"SameOwnerIsNotElsewhere", "neve", "neve", false},
+		{"OtherOwnerIsElsewhere", "box", "neve", true},
+	}
+	for _, tt := range elsewhere {
+		t.Run("OwnedElsewhere_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := OwnedElsewhere(tt.owner, tt.here); got != tt.want {
+				t.Errorf("OwnedElsewhere(%q, %q) = %v; want %v", tt.owner, tt.here, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/boardengine/ownerset.go b/internal/boardengine/ownerset.go
new file mode 100644
index 000000000..a82bc942e
--- /dev/null
+++ b/internal/boardengine/ownerset.go
@@ -0,0 +1,265 @@
+// ownerset.go — the owner setter, the only writer of an entry's owner machine and of the hub's prime owner, and the local owner read.
+//
+// SetOwners records a machine as the owner of named entries in one pull-first Bolt commit and pushes it;
+// ReadOwners reads the owners a board directory's local board.json records.
+
+package boardengine
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// OwnerWritePrime is the key under which OwnerWrite names the hub's prime owner in Recorded and Lost.
+const OwnerWritePrime = "prime"
+
+// ownerPushRetryWait is how long SetOwners waits before it pushes again after a held lock deferred the first push.
+const ownerPushRetryWait = time.Second
+
+// ErrOwnerOriginUnreachable matches, through errors.Is, an owner write that needs origin and found it unreachable.
+var ErrOwnerOriginUnreachable = errors.New("board: origin is unreachable, so the owner write was not pushed")
+
+// OwnerRequest asks SetOwners to record Machine as the owner of entries.
+type OwnerRequest struct {
+	// Machine is the owner to record, this machine's name; empty is refused.
+	Machine string
+	// Slugs names the entries to own; an absent, done or note entry is left alone.
+	Slugs []string
+	// Prime records Machine as the hub's prime owner as well.
+	Prime bool
+	// Takeover writes over an owner that reads as another machine; without it such an entry is left alone and reported in OwnerWrite.Lost.
+	Takeover bool
+	// Claim is a run status written on the request's one slug in the same commit; it needs exactly one slug.
+	Claim string
+	// ParentOf names the slug of an entry's parent pair, "" for the prime, so the effective owner is judged as a read judges it; nil reads every parent as the prime.
+	ParentOf func(slug string) (string, error)
+	// Sleep waits out the retry delay after a held lock deferred the push; nil sleeps.
+	Sleep func(time.Duration)
+	// BeforePush runs once between the commit and the first push; nil in production.
+	BeforePush func()
+}
+
+// OwnerWrite reports what SetOwners recorded.
+type OwnerWrite struct {
+	// Recorded lists the slugs, and OwnerWritePrime when asked, whose owner reads as the request's Machine after the push.
+	Recorded []string
+	// Lost maps a slug, or OwnerWritePrime, to the owner that stands instead of the request's Machine.
+	Lost map[string]string
+}
+
+// SetOwners records req.Machine as the owner of req.Slugs, and of the prime when req.Prime is set, in one commit of the board at boardDir, then pushes it.
+// The commit is made after the board is brought up to date with its upstream, so a stale copy is never written over.
+// Without req.Takeover an entry whose effective owner is another machine is neither written nor claimed and is reported in Lost.
+// A competing write origin already holds wins the replay of this one, and the re-read after the push reports what stands.
+// An unreachable origin returns ErrOwnerOriginUnreachable, wrapped with its detail, and a pull that cannot bring the board up to date, or a push that stays deferred, is refused with its way forward.
+// BOARD_SKIP_GIT writes board.json with no pull, commit or push, and BOARD_SKIP_PUSH commits with no pull or push.
+func SetOwners(boardDir string, req OwnerRequest) (OwnerWrite, error) {
+	if req.Machine == "" {
+		return OwnerWrite{}, errors.New("board: the owner write names no machine: take this machine's name from internal/machinename.Name, which fails when the hostname cannot be read")
+	}
+	if req.Claim != "" && len(req.Slugs) != 1 {
+		return OwnerWrite{}, fmt.Errorf("board: a claim status goes with exactly one slug, and the owner write names %d", len(req.Slugs))
+	}
+
+	cfg := ApplySkipEnv(Config{Path: boardDir})
+	opts := fabricengine.SyncOptions{SkipGit: cfg.SkipGit, SkipPush: cfg.SkipPush}
+	bolt := fabricengine.NewBolt(boardDir)
+
+	var written []string
+	lost := map[string]string{}
+	write := func() ([]string, error) {
+		var paths []string
+		var err error
+		written, paths, err = writeOwners(boardDir, req, lost)
+		return paths, err
+	}
+
+	subjects := slices.Clone(req.Slugs)
+	if req.Prime {
+		subjects = append(subjects, OwnerWritePrime)
+	}
+	message := fmt.Sprintf("board: owner %s for %s", req.Machine, strings.Join(subjects, ", "))
+
+	if cfg.SkipGit || cfg.SkipPush {
+		if _, _, err := bolt.CommitWritten(message, write, opts); err != nil {
+			return OwnerWrite{}, err
+		}
+	} else {
+		rec := fabricengine.NewMutations(filepath.Dir(boardDir))
+		result, err := bolt.PullThenCommitWritten([]fabricengine.BoltWrite{{Message: message, Write: write}}, rec)
+		if err != nil {
+			return OwnerWrite{}, err
+		}
+		switch result.Skipped {
+		case "":
+		case fabricengine.BoltSkipFetchFailed:
+			return OwnerWrite{}, fmt.Errorf("%w: %s", ErrOwnerOriginUnreachable, result.SkipDetail)
+		default:
+			return OwnerWrite{}, fmt.Errorf("board: the owner write was refused, since the board could not be brought up to date: %s", result.SkipDetail)
+		}
+		if req.BeforePush != nil {
+			req.BeforePush()
+		}
+		sleep := req.Sleep
+		if sleep == nil {
+			sleep = time.Sleep
+		}
+		if err := pushOwnerCommit(bolt, opts, rec, sleep); err != nil {
+			return OwnerWrite{}, err
+		}
+	}
+
+	owners, err := ReadOwners(boardDir)
+	if err != nil {
+		return OwnerWrite{}, err
+	}
+	var recorded []string
+	for _, slug := range written {
+		standing := owners.Entries[slug].Owner
+		if slug == OwnerWritePrime {
+			standing = owners.Prime
+		}
+		if standing == req.Machine {
+			recorded = append(recorded, slug)
+			continue
+		}
+		lost[slug] = standing
+	}
+	if len(lost) == 0 {
+		lost = nil
+	}
+	return OwnerWrite{Recorded: recorded, Lost: lost}, nil
+}
+
+// writeOwners loads the board at boardDir, sets the owners req asks for, saves and renders it, and returns the names it wrote, OwnerWritePrime among them, with the board-relative paths changed.
+// An entry left alone for an owner elsewhere is added to lost with that owner.
+// The caller holds the board write lock.
+func writeOwners(boardDir string, req OwnerRequest, lost map[string]string) (written, paths []string, err error) {
+	store := NewStore(boardDir)
+	store.parentOf = req.ParentOf
+	if err := store.Load(); err != nil {
+		return nil, nil, err
+	}
+
+	if req.Prime {
+		if !req.Takeover && OwnedElsewhere(store.primeOwner, req.Machine) {
+			lost[OwnerWritePrime] = store.primeOwner
+		} else {
+			store.primeOwner = req.Machine
+			written = append(written, OwnerWritePrime)
+		}
+	}
+	for _, slug := range req.Slugs {
+		index := slices.IndexFunc(store.tasks, func(task Task) bool { return task.Slug == slug })
+		if index < 0 || isDone(store.tasks[index]) || store.tasks[index].Kind != KindTask {
+			continue
+		}
+		effective, err := store.effectiveOwner(slug)
+		if err != nil {
+			return nil, nil, fmt.Errorf("entry %q: resolve its owner: %w", slug, err)
+		}
+		if !req.Takeover && OwnedElsewhere(effective, req.Machine) {
+			lost[slug] = effective
+			continue
+		}
+		store.tasks[index].OwnerMachine = req.Machine
+		if req.Claim != "" {
+			claim := req.Claim
+			store.tasks[index].Status = &claim
+		}
+		written = append(written, slug)
+	}
+	if len(written) == 0 {
+		return nil, nil, nil
+	}
+
+	if err := store.Save(); err != nil {
+		return nil, nil, fmt.Errorf("save store: %w", err)
+	}
+	rendered, err := renderOwnerWrite(boardDir, store.Tasks())
+	if err != nil {
+		return nil, nil, err
+	}
+	return written, append([]string{boardFile}, rendered...), nil
+}
+
+// renderOwnerWrite renders the board's output files when its config loads, and returns the paths the render wrote or removed.
+// A board whose config does not load is left unrendered, and the next write renders it.
+func renderOwnerWrite(boardDir string, tasks []Task) ([]string, error) {
+	cfg, err := LoadConfig(configengine.Dirs{Board: boardDir}, "board")
+	if err != nil {
+		logger.Warn("boardengine: the owner write is not rendered, since the board config did not load", "path", boardDir, "error", err)
+		return nil, nil
+	}
+	now := time.Now()
+	files, err := Render(tasks, cfg.Outputs(), now)
+	if err != nil {
+		return nil, fmt.Errorf("render: %w", err)
+	}
+	previous := readRenderManifest(boardDir)
+	if err := RenderToDisk(boardDir, tasks, cfg.Outputs(), now); err != nil {
+		return nil, fmt.Errorf("render: %w", err)
+	}
+	var paths []string
+	for name := range files {
+		paths = append(paths, name)
+	}
+	for _, name := range previous {
+		if _, kept := files[name]; !kept {
+			paths = append(paths, name)
+		}
+	}
+	slices.Sort(paths)
+	return paths, nil
+}
+
+// pushOwnerCommit pushes the committed owner write, and pushes once more after sleep when a held lock deferred the first push.
+// An unreachable origin is ErrOwnerOriginUnreachable wrapped with the push's error, and any other failed push is returned wrapped with its way forward.
+func pushOwnerCommit(bolt *fabricengine.Bolt, opts fabricengine.SyncOptions, rec *fabricengine.Mutations, sleep func(time.Duration)) error {
+	for attempt := 1; ; attempt++ {
+		if err := bolt.PushRecorded(opts, rec); err != nil {
+			var failed *fabricengine.PushFailedError
+			if errors.As(err, &failed) && failed.Record.Class == fabricengine.PushFailureTransport {
+				return fmt.Errorf("%w: %w", ErrOwnerOriginUnreachable, err)
+			}
+			return fmt.Errorf("board: the owner commit was kept locally and not pushed: %w", err)
+		}
+		ahead, err := bolt.HasUnpushed()
+		if err != nil {
+			return fmt.Errorf("board: read whether the owner commit was pushed: %w", err)
+		}
+		if !ahead {
+			return nil
+		}
+		if attempt == 2 {
+			return errors.New("board: a held board lock deferred the push of the owner commit, and the board is still ahead of origin: run `lyx board sync`, then re-run the verb")
+		}
+		sleep(ownerPushRetryWait)
+	}
+}
+
+// ReadOwners reads the owners the local board.json at boardDir records, and an empty Owners when the board has none.
+func ReadOwners(boardDir string) (Owners, error) {
+	path := filepath.Join(boardDir, boardFile)
+	if !fileExists(path) {
+		return Owners{}, nil
+	}
+	raw, found, err := state.ReadJSON[json.RawMessage](path, path+swapLockSuffix)
+	if err != nil {
+		return Owners{}, fmt.Errorf("read owners: %w", err)
+	}
+	if !found {
+		return Owners{}, nil
+	}
+	return ParseOwners(raw)
+}
diff --git a/internal/boardengine/ownerset_integration_test.go b/internal/boardengine/ownerset_integration_test.go
new file mode 100644
index 000000000..ff5859e3c
--- /dev/null
+++ b/internal/boardengine/ownerset_integration_test.go
@@ -0,0 +1,459 @@
+//go:build integration
+
+// ownerset_integration_test.go covers SetOwners against a real board repository, a bare origin and a second clone of it:
+// the outcomes of an owner write, the ways it refuses, a competing write that wins at origin, a deferred push and the BOARD_SKIP_GIT bypass.
+
+package boardengine
+
+import (
+	"errors"
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// unreachableOrigin is an origin URL nothing answers.
+const unreachableOrigin = "http://127.0.0.1:1/board.git"
+
+// ownerFixture is a board seeded with a few entries and pushed to a bare origin, beside a second clone of that origin.
+// The board is the hub's _board worktree of a weft repository, the shape a rejected push's replay requires.
+// The seed holds alpha and beta, unowned; away, owned by box; and held, run-held and owned by box.
+type ownerFixture struct {
+	bare     string
+	boardDir string
+	otherDir string
+	seedHead string
+}
+
+// newOwnerFixture builds the fixture, with primeOwner as the prime owner the seed records, empty for none.
+func newOwnerFixture(t *testing.T, primeOwner string) *ownerFixture {
+	t.Helper()
+	hub := t.TempDir()
+	side := t.TempDir()
+	bare := newBareRemote(t, side)
+	// The hub's records repository sits beside _board under a name that pairs with a warp branch; fabric alone composes that name.
+	weftDir := newBoardRepo(t, hub, fabricengine.RecordsBranchName("hub"), bare)
+
+	store := NewStore(weftDir)
+	for _, fields := range []map[string]any{
+		{"slug": "alpha", "title": "Alpha", "kind": "task", "labels": []string{"bug"}},
+		{"slug": "beta", "title": "Beta", "kind": "task", "labels": []string{"bug"}},
+		{"slug": "away", "title": "Away", "kind": "task", "labels": []string{"bug"}},
+		{"slug": "held", "title": "Held", "kind": "task", "labels": []string{"bug"}, "status": RunStatus("running", "Webster")},
+	} {
+		if _, err := store.UpsertTask(fields); err != nil {
+			t.Fatalf("seed %v: %v", fields["slug"], err)
+		}
+	}
+	for i := range store.tasks {
+		if store.tasks[i].Slug == "away" || store.tasks[i].Slug == "held" {
+			store.tasks[i].OwnerMachine = "box"
+		}
+	}
+	store.primeOwner = primeOwner
+	if err := store.Save(); err != nil {
+		t.Fatalf("save seed board: %v", err)
+	}
+	writeBoardFile(t, weftDir, ".gitignore", "*.lock\n*.swaplock\n"+renderManifestFile+"\n")
+	// The board config is tracked, since a replay of a rejected push validates the entries against it.
+	configFile := configengine.ConfigFile(weftDir, "board")
+	if err := os.MkdirAll(filepath.Dir(configFile), 0o755); err != nil {
+		t.Fatalf("mkdir board config dir: %v", err)
+	}
+	if err := os.WriteFile(configFile, []byte(ConfigTemplate()), 0o644); err != nil {
+		t.Fatalf("write board config: %v", err)
+	}
+	if err := os.Mkdir(filepath.Join(weftDir, "notes"), 0o755); err != nil {
+		t.Fatalf("mkdir notes: %v", err)
+	}
+	writeBoardFile(t, weftDir, "notes/x.md", "one\n")
+	gitkit.Git(t, weftDir, "add", "-A")
+	gitkit.Git(t, weftDir, "commit", "-m", "seed board")
+	gitkit.Git(t, weftDir, "push", "-u", "origin", "main")
+
+	// The weft repository's own checkout moves off main, which the hub's _board worktree then holds.
+	boardDir := filepath.Join(hub, fabricengine.BoardDirName)
+	gitkit.Git(t, weftDir, "checkout", "-b", "home")
+	gitkit.Git(t, weftDir, "worktree", "add", boardDir, "main")
+	gitkit.MustRun(t, side, "git", "clone", bare, "other")
+
+	return &ownerFixture{bare: bare, boardDir: boardDir, otherDir: filepath.Join(side, "other"), seedHead: gitkit.RevParse(t, boardDir, "HEAD")}
+}
+
+// originOwners returns the owners the bare origin's board.json records.
+func (f *ownerFixture) originOwners(t *testing.T) Owners {
+	t.Helper()
+	owners, err := ParseOwners([]byte(gitkit.Git(t, f.bare, "show", "main:board.json")))
+	if err != nil {
+		t.Fatalf("parse origin board.json: %v", err)
+	}
+	return owners
+}
+
+// pushFromOther changes the second clone's board through mutate and pushes the result to origin.
+func (f *ownerFixture) pushFromOther(t *testing.T, mutate func(store *Store)) {
+	t.Helper()
+	store := NewStore(f.otherDir)
+	if err := store.Load(); err != nil {
+		t.Fatalf("load second clone: %v", err)
+	}
+	mutate(store)
+	if err := store.Save(); err != nil {
+		t.Fatalf("save second clone: %v", err)
+	}
+	gitkit.Git(t, f.otherDir, "add", "board.json")
+	gitkit.Git(t, f.otherDir, "commit", "-m", "other machine writes")
+	gitkit.Git(t, f.otherDir, "push", "origin", "main")
+}
+
+// setOwnerOnOther returns a mutation of the second clone's store that records owner as slug's owner.
+func setOwnerOnOther(slug, owner string) func(store *Store) {
+	return func(store *Store) {
+		for i := range store.tasks {
+			if store.tasks[i].Slug == slug {
+				store.tasks[i].OwnerMachine = owner
+			}
+		}
+	}
+}
+
+// failOnSleep is a Sleep that fails the test, for a row that must not wait.
+func failOnSleep(t *testing.T) func(time.Duration) {
+	return func(d time.Duration) { t.Errorf("SetOwners slept %v; want no wait", d) }
+}
+
+func TestSetOwners(t *testing.T) {
+	// Not parallel: the SkipGit row sets the environment, which a parallel ancestor forbids; the rows that can run in parallel say so themselves.
+
+	// A test binary never runs the lyx root pre-run that installs the board replay a rejected push is retried through.
+	fabricengine.InstallBoardReplay(FabricReplay{})
+
+	outcomes := []struct {
+		name         string
+		primeOwner   string
+		req          OwnerRequest
+		wantRecorded []string
+		wantLost     map[string]string
+		// wantOwners maps a slug to the owner origin records for it afterwards.
+		wantOwners map[string]string
+		// wantPrime is the prime owner origin records afterwards.
+		wantPrime string
+		wantClaim string
+		// wantSubject is the subject of origin's newest commit; empty requires origin's head to stay at the seed.
+		wantSubject string
+	}{
+		{
+			name: "RecordedAndPushed", primeOwner: "neve",
+			req:          OwnerRequest{Machine: "neve", Slugs: []string{"alpha"}},
+			wantRecorded: []string{"alpha"}, wantOwners: map[string]string{"alpha": "neve"}, wantPrime: "neve",
+			wantSubject: "board: owner neve for alpha",
+		},
+		{
+			name: "TakeoverChangesTheOwnerOfARunHeldEntry", primeOwner: "neve",
+			req:          OwnerRequest{Machine: "neve", Slugs: []string{"held"}, Takeover: true},
+			wantRecorded: []string{"held"}, wantOwners: map[string]string{"held": "neve"}, wantPrime: "neve",
+			wantSubject: "board: owner neve for held",
+		},
+		{
+			name: "OwnedElsewhereIsSkippedWithoutTakeover", primeOwner: "neve",
+			req:          OwnerRequest{Machine: "neve", Slugs: []string{"away", "alpha"}},
+			wantRecorded: []string{"alpha"}, wantLost: map[string]string{"away": "box"}, wantOwners: map[string]string{"away": "box", "alpha": "neve"}, wantPrime: "neve",
+			wantSubject: "board: owner neve for away, alpha",
+		},
+		{
+			name: "AbsentEntryWritesNothing", primeOwner: "neve",
+			req:       OwnerRequest{Machine: "neve", Slugs: []string{"ghost"}},
+			wantPrime: "neve",
+		},
+		{
+			name: "PrimeIsClaimedWhenNoneIsRecorded", primeOwner: "",
+			req:          OwnerRequest{Machine: "neve", Prime: true},
+			wantRecorded: []string{OwnerWritePrime}, wantPrime: "neve",
+			wantSubject: "board: owner neve for prime",
+		},
+		{
+			name: "PrimeOwnedElsewhereIsSkippedWithoutTakeover", primeOwner: "box",
+			req:      OwnerRequest{Machine: "neve", Prime: true},
+			wantLost: map[string]string{OwnerWritePrime: "box"}, wantPrime: "box",
+		},
+		{
+			name: "ClaimStatusLandsInTheSameCommit", primeOwner: "neve",
+			req:          OwnerRequest{Machine: "neve", Slugs: []string{"alpha"}, Claim: RunStatus("running", "Worktree-Create")},
+			wantRecorded: []string{"alpha"}, wantOwners: map[string]string{"alpha": "neve"}, wantPrime: "neve", wantClaim: RunStatus("running", "Worktree-Create"),
+			wantSubject: "board: owner neve for alpha",
+		},
+	}
+	for _, tt := range outcomes {
+		t.Run("Outcome_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newOwnerFixture(t, tt.primeOwner)
+			tt.req.Sleep = failOnSleep(t)
+
+			got, err := SetOwners(f.boardDir, tt.req)
+			if err != nil {
+				t.Fatalf("SetOwners() error = %v; want nil", err)
+			}
+			if !slices.Equal(got.Recorded, tt.wantRecorded) {
+				t.Errorf("SetOwners() Recorded = %v; want %v", got.Recorded, tt.wantRecorded)
+			}
+			if !maps.Equal(got.Lost, tt.wantLost) {
+				t.Errorf("SetOwners() Lost = %v; want %v", got.Lost, tt.wantLost)
+			}
+
+			origin := f.originOwners(t)
+			for slug, want := range tt.wantOwners {
+				if origin.Entries[slug].Owner != want {
+					t.Errorf("origin owner of %q = %q; want %q", slug, origin.Entries[slug].Owner, want)
+				}
+			}
+			if origin.Prime != tt.wantPrime {
+				t.Errorf("origin prime owner = %q; want %q", origin.Prime, tt.wantPrime)
+			}
+			if tt.wantClaim != "" {
+				tasks, err := ParseBoardTasks([]byte(gitkit.Git(t, f.bare, "show", "main:board.json")))
+				if err != nil {
+					t.Fatalf("parse origin tasks: %v", err)
+				}
+				i := slices.IndexFunc(tasks, func(task Task) bool { return task.Slug == "alpha" })
+				if i < 0 {
+					t.Fatalf("origin board.json holds no entry alpha")
+				}
+				if tasks[i].Status == nil || *tasks[i].Status != tt.wantClaim {
+					t.Errorf("origin status of alpha = %v; want %q", tasks[i].Status, tt.wantClaim)
+				}
+			}
+			head := gitkit.RevParse(t, f.bare, "main")
+			if tt.wantSubject == "" {
+				if head != f.seedHead {
+					t.Errorf("origin head = %s; want the seed %s, since nothing was written", head, f.seedHead)
+				}
+				return
+			}
+			if subject := gitkit.Git(t, f.bare, "log", "-1", "--format=%s", "main"); subject != tt.wantSubject {
+				t.Errorf("origin head subject = %q; want %q", subject, tt.wantSubject)
+			}
+		})
+	}
+
+	refusals := []struct {
+		name string
+		// setup runs after the fixture is built and before SetOwners, and may return a BeforePush.
+		setup      func(t *testing.T, f *ownerFixture) (beforePush func())
+		machine    string
+		wantIs     error
+		wantSubstr string
+		// wantKept requires the owner commit to stay in the local board, ahead of origin.
+		wantKept bool
+	}{
+		{
+			name:       "EmptyMachineIsRefused",
+			setup:      func(t *testing.T, f *ownerFixture) func() { return nil },
+			machine:    "",
+			wantSubstr: "internal/machinename",
+		},
+		{
+			name: "UnreachableOriginAtPull",
+			setup: func(t *testing.T, f *ownerFixture) func() {
+				gitkit.Git(t, f.boardDir, "remote", "set-url", "origin", unreachableOrigin)
+				return nil
+			},
+			machine: "neve",
+			wantIs:  ErrOwnerOriginUnreachable,
+		},
+		{
+			name: "TransportFailureAtPush",
+			setup: func(t *testing.T, f *ownerFixture) func() {
+				return func() { gitkit.Git(t, f.boardDir, "remote", "set-url", "origin", unreachableOrigin) }
+			},
+			machine:  "neve",
+			wantIs:   ErrOwnerOriginUnreachable,
+			wantKept: true,
+		},
+		{
+			name: "DivergedPull",
+			setup: func(t *testing.T, f *ownerFixture) func() {
+				gitkit.CommitFile(t, f.boardDir, "notes/c.md", "mine\n", "local note")
+				gitkit.CommitFile(t, f.otherDir, "notes/c.md", "theirs\n", "other note")
+				gitkit.Git(t, f.otherDir, "push", "origin", "main")
+				return nil
+			},
+			machine:    "neve",
+			wantSubstr: "holds commits its upstream lacks",
+		},
+		{
+			name: "DirtyPull",
+			setup: func(t *testing.T, f *ownerFixture) func() {
+				writeBoardFile(t, f.boardDir, "notes/x.md", "mine\n")
+				gitkit.CommitFile(t, f.otherDir, "notes/x.md", "theirs\n", "other edit")
+				gitkit.Git(t, f.otherDir, "push", "origin", "main")
+				return nil
+			},
+			machine:    "neve",
+			wantSubstr: "lyx board sync",
+		},
+	}
+	for _, tt := range refusals {
+		t.Run("Refusal_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newOwnerFixture(t, "neve")
+			beforePush := tt.setup(t, f)
+			headBefore := gitkit.RevParse(t, f.boardDir, "HEAD")
+			boardBefore, err := os.ReadFile(filepath.Join(f.boardDir, boardFile))
+			if err != nil {
+				t.Fatalf("read board.json: %v", err)
+			}
+
+			got, err := SetOwners(f.boardDir, OwnerRequest{Machine: tt.machine, Slugs: []string{"alpha"}, BeforePush: beforePush, Sleep: failOnSleep(t)})
+			if err == nil {
+				t.Fatalf("SetOwners() error = nil; want a refusal")
+			}
+			if tt.wantIs != nil && !errors.Is(err, tt.wantIs) {
+				t.Errorf("SetOwners() error = %v; want it to match %v", err, tt.wantIs)
+			}
+			if tt.wantSubstr != "" && !strings.Contains(err.Error(), tt.wantSubstr) {
+				t.Errorf("SetOwners() error = %v; want it to name %q", err, tt.wantSubstr)
+			}
+			if len(got.Recorded) != 0 {
+				t.Errorf("SetOwners() Recorded = %v; want none", got.Recorded)
+			}
+
+			headAfter := gitkit.RevParse(t, f.boardDir, "HEAD")
+			boardAfter, err := os.ReadFile(filepath.Join(f.boardDir, boardFile))
+			if err != nil {
+				t.Fatalf("read board.json: %v", err)
+			}
+			if tt.wantKept {
+				if headAfter == headBefore {
+					t.Errorf("local head = %s; want the owner commit kept on top of it", headAfter)
+				}
+				if origin := gitkit.RevParse(t, f.bare, "main"); origin != f.seedHead {
+					t.Errorf("origin head = %s; want the seed %s, since the push failed", origin, f.seedHead)
+				}
+				return
+			}
+			if headAfter != headBefore || string(boardAfter) != string(boardBefore) {
+				t.Errorf("a refused write changed the local board: head %s -> %s", headBefore, headAfter)
+			}
+		})
+	}
+
+	t.Run("CompetingWriteLosesToOrigins", func(t *testing.T) {
+		t.Parallel()
+		f := newOwnerFixture(t, "neve")
+
+		got, err := SetOwners(f.boardDir, OwnerRequest{
+			Machine: "neve", Slugs: []string{"alpha"}, Sleep: failOnSleep(t),
+			BeforePush: func() { f.pushFromOther(t, setOwnerOnOther("alpha", "box")) },
+		})
+		if err != nil {
+			t.Fatalf("SetOwners() error = %v; want nil", err)
+		}
+		if len(got.Recorded) != 0 || !maps.Equal(got.Lost, map[string]string{"alpha": "box"}) {
+			t.Errorf("SetOwners() = Recorded %v, Lost %v; want none recorded and alpha lost to box", got.Recorded, got.Lost)
+		}
+		if owner := f.originOwners(t).Entries["alpha"].Owner; owner != "box" {
+			t.Errorf("origin owner of alpha = %q; want origin's own value box to stand", owner)
+		}
+	})
+
+	deferrals := []struct {
+		name string
+		// releaseOnSleep releases the held board lock on the first wait, so the retried push lands.
+		releaseOnSleep bool
+	}{
+		{name: "RetriedPushLands", releaseOnSleep: true},
+		{name: "PushStillAheadIsRefused", releaseOnSleep: false},
+	}
+	for _, tt := range deferrals {
+		t.Run("DeferredPush_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newOwnerFixture(t, "neve")
+
+			var held *lock.FileLock
+			release := func() {
+				if held != nil {
+					_ = held.Release()
+					held = nil
+				}
+			}
+			t.Cleanup(release)
+			var waits []time.Duration
+			req := OwnerRequest{
+				Machine: "neve", Slugs: []string{"alpha"},
+				// The other clone moves origin by a change to another entry, so the first push is rejected, and the held board lock defers the replay that would retry it.
+				BeforePush: func() {
+					f.pushFromOther(t, func(store *Store) {
+						for i := range store.tasks {
+							if store.tasks[i].Slug == "beta" {
+								store.tasks[i].Brief = "changed elsewhere"
+							}
+						}
+					})
+					lockHeld, acquired, err := lock.TryAcquireWriteLock(filepath.Join(f.boardDir, fabricengine.BoardWriteLockFile))
+					if err != nil || !acquired {
+						t.Fatalf("take the board write lock: acquired %v, error %v", acquired, err)
+					}
+					held = lockHeld
+				},
+				Sleep: func(d time.Duration) {
+					waits = append(waits, d)
+					if tt.releaseOnSleep {
+						release()
+					}
+				},
+			}
+
+			got, err := SetOwners(f.boardDir, req)
+			if len(waits) != 1 || waits[0] != time.Second {
+				t.Errorf("SetOwners() waited %v; want one wait of %v", waits, time.Second)
+			}
+			if !tt.releaseOnSleep {
+				if err == nil || !strings.Contains(err.Error(), "lyx board sync") {
+					t.Fatalf("SetOwners() error = %v; want a refusal naming `lyx board sync`", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("SetOwners() error = %v; want nil", err)
+			}
+			if !slices.Equal(got.Recorded, []string{"alpha"}) {
+				t.Errorf("SetOwners() Recorded = %v; want [alpha]", got.Recorded)
+			}
+			if owner := f.originOwners(t).Entries["alpha"].Owner; owner != "neve" {
+				t.Errorf("origin owner of alpha = %q; want neve", owner)
+			}
+		})
+	}
+
+	t.Run("SkipGitWritesTheOwnerWithNoCommit", func(t *testing.T) {
+		t.Setenv("BOARD_SKIP_GIT", "1")
+		f := newOwnerFixture(t, "neve")
+
+		got, err := SetOwners(f.boardDir, OwnerRequest{Machine: "neve", Slugs: []string{"alpha"}, Sleep: failOnSleep(t)})
+		if err != nil {
+			t.Fatalf("SetOwners() error = %v; want nil", err)
+		}
+		if !slices.Equal(got.Recorded, []string{"alpha"}) {
+			t.Errorf("SetOwners() Recorded = %v; want [alpha]", got.Recorded)
+		}
+		owners, err := ReadOwners(f.boardDir)
+		if err != nil {
+			t.Fatalf("ReadOwners() error = %v", err)
+		}
+		if owners.Entries["alpha"].Owner != "neve" {
+			t.Errorf("local owner of alpha = %q; want neve", owners.Entries["alpha"].Owner)
+		}
+		if head := gitkit.RevParse(t, f.boardDir, "HEAD"); head != f.seedHead {
+			t.Errorf("local head = %s; want the seed %s, since BOARD_SKIP_GIT commits nothing", head, f.seedHead)
+		}
+	})
+}
