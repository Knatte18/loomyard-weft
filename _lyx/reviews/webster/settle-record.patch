@@ -0,0 +1,23 @@
+// Package failuretrace traces a failed Merge-In or Publish verify log to the plan cards whose targets hold the failing code.
+// The result is the Publish failure record's `cards`, `later_range` and `untraced`, so a reviewer starts a fix from the commits that wrote the failing members.
+//
+// The package lives apart from the landing and loom producer packages, which link no tree-sitter grammar, because it reaches quarry through internal/planglyph.
+// It is told the worktree root and the anchor path, takes the plan, Webster and scratch directories from the owning packages' own path functions, joins `go.mod` and its existence checks onto the worktree root, and reads plan refs only through internal/planparser.
+//
+// Locations extracts `path:line` locations from the failure identities of a verify log, Go test and build output only, and places each relative to the repository root.
+// A location is placed as written when it exists at the head, with the worktree root stripped when it is absolute, with the module path stripped when it is a `-trimpath` frame, or joined onto its identity's package directory when it is a bare or `./`-relative name.
+// An opaque identity carries no package, so its bare and `./`-relative locations are untraced as written.
+// Any other location, such as a standard-library or dependency frame, is dropped, and at most twenty placed locations are kept.
+//
+// Trace answers the placed locations through quarry's EncloseAt at the record's head and matches each answer to the live plan's cards:
+//
+//   - A found answer matches every card with a target that holds one of its member glyphs or its file.
+//   - A not_found answer, a location inside no member such as an unused import, matches every card with a target that holds the file or its self glyph, or a member target that resolves into that file at the head.
+//     A member target that does not resolve there, such as one its card deletes, renames or moves out, is looked up in the delta from its batch's start to the head, and one found in neither matches only by the file rule.
+//   - A rejected location, a not_found location no card matches and a found location no card's targets hold are untraced.
+//
+// Each matched card carries its Webster batch and that batch's commit range, from the batch's start to its last card commit, and the later range runs from the last card commit of the highest-numbered matched batch to the head.
+// A card Webster holds no record of reads as batch 0 with an empty range.
+//
+// The trace often names no card: a failure in code no card touched, or in a location the log does not print, lands in untraced, and the failure record is then as it was without a trace.
+package failuretrace
diff --git a/internal/failuretrace/locations.go b/internal/failuretrace/locations.go
new file mode 100644
index 00000000..bf56bbc5
--- /dev/null
+++ b/internal/failuretrace/locations.go
@@ -0,0 +1,110 @@
+// locations.go extracts the `path:line` locations a failed verify log names and places each relative to the repository root.
+
+package failuretrace
+
+import (
+	"path"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/websterengine"
+)
+
+// maxPlacedLocations caps the placed locations one trace answers.
+const maxPlacedLocations = 20
+
+// goLocation matches one `<path>.go:<line>` token of Go test or build output, with an optional `:<col>` that the match leaves out.
+var goLocation = regexp.MustCompile(`((?:[A-Za-z]:)?[^\s:()"'\[\]]+\.go):(\d+)`)
+
+// Placement tells Locations where the verified tree sits and what it holds.
+type Placement struct {
+	// WorktreeRoot is the absolute root of the verified worktree.
+	WorktreeRoot string
+	// ModulePath is the module path from the worktree's go.mod, empty when unknown.
+	ModulePath string
+	// ExistsAtHead reports whether the slash-separated, root-relative path rel names a file at the verified head.
+	// Nil reads as a tree holding no file.
+	ExistsAtHead func(rel string) bool
+}
+
+// Locations extracts the `path:line` locations of every failure's Tail and places each relative to the repository root.
+// placed holds the placed locations, deduplicated in first-seen order and capped at twenty.
+// untraced holds the bare and `./`-relative locations of an opaque identity, as written, which no package directory places.
+// A location that places nowhere, such as a standard-library or dependency frame, is dropped.
+func Locations(failures []websterengine.VerifyFailure, p Placement) (placed, untraced []string) {
+	seenPlaced := map[string]bool{}
+	seenUntraced := map[string]bool{}
+	for _, failure := range failures {
+		for _, match := range goLocation.FindAllStringSubmatch(failure.Tail, -1) {
+			rel, outcome := p.place(match[1], failure.Package)
+			switch outcome {
+			case placedOutcome:
+				location := rel + ":" + match[2]
+				if !seenPlaced[location] && len(placed) < maxPlacedLocations {
+					seenPlaced[location] = true
+					placed = append(placed, location)
+				}
+			case untracedOutcome:
+				location := match[1] + ":" + match[2]
+				if !seenUntraced[location] {
+					seenUntraced[location] = true
+					untraced = append(untraced, location)
+				}
+			}
+		}
+	}
+	return placed, untraced
+}
+
+// placeOutcome is what placing one location comes to.
+type placeOutcome int
+
+const (
+	droppedOutcome placeOutcome = iota
+	placedOutcome
+	untracedOutcome
+)
+
+// place maps raw, a path as a log wrote it, to a repository-relative path.
+// pkg is the import path of the failure identity the path came from, empty for an opaque identity.
+func (p Placement) place(raw, pkg string) (string, placeOutcome) {
+	slashed := filepath.ToSlash(raw)
+	absolute := path.IsAbs(slashed) || filepath.IsAbs(raw) || (len(slashed) > 1 && slashed[1] == ':')
+	relativeToPackage := !strings.Contains(slashed, "/") || strings.HasPrefix(slashed, "./")
+
+	if !absolute && !relativeToPackage && p.ExistsAtHead != nil && p.ExistsAtHead(slashed) {
+		return slashed, placedOutcome
+	}
+	if root := strings.TrimSuffix(filepath.ToSlash(p.WorktreeRoot), "/"); root != "" {
+		if rel, ok := strings.CutPrefix(slashed, root+"/"); ok {
+			return rel, placedOutcome
+		}
+	}
+	if p.ModulePath != "" {
+		if rel, ok := strings.CutPrefix(slashed, p.ModulePath+"/"); ok {
+			return rel, placedOutcome
+		}
+	}
+	if !relativeToPackage {
+		return "", droppedOutcome
+	}
+	dir, ok := p.packageDir(pkg)
+	if !ok {
+		return "", untracedOutcome
+	}
+	return path.Join(dir, strings.TrimPrefix(slashed, "./")), placedOutcome
+}
+
+// packageDir maps the import path pkg to its directory relative to the module root, "." for the module's root package.
+// It reports false for an empty pkg, an unknown module path, or a pkg outside the module.
+func (p Placement) packageDir(pkg string) (string, bool) {
+	if p.ModulePath == "" || pkg == "" {
+		return "", false
+	}
+	if pkg == p.ModulePath {
+		return ".", true
+	}
+	rel, ok := strings.CutPrefix(pkg, p.ModulePath+"/")
+	return rel, ok && rel != ""
+}
