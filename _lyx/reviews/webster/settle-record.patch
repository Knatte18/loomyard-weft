+func (fx *finalizeGateFixture) call(t *testing.T) (shedengine.Outcome, shedengine.OutputPointer) {
+	t.Helper()
+	outcome, ptr, err := fx.fz.Call(context.Background())
+	if err != nil {
+		t.Fatalf("Call() error = %v", err)
+	}
+	return outcome, ptr
+}
