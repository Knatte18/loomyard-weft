@@ -0,0 +1,27 @@
+// Package runproc owns the owner record of a run's processes and the one sequence that ends them.
+//
+// Every detached or long-lived process lyx starts for a run registers a Record under its owner: the run's slug, or HubOwner for the hub's own processes.
+// A record holds the pid, the process group when the process leads it, the start time, the role (`RoleDriver`, `RoleLoop`, `RoleBatten`, `RolePush` or `RoleSync`), the command line and the registration time.
+// Register writes `<dir>/<owner>/<pid>-<start time>.json` through `internal/state`, so a key the record does not declare survives a rewrite by an older binary.
+// The package is told its directory and derives no path.
+// `HubOwner` is `_board`, a name the fabric slug check refuses as reserved hub geometry, so no slug can take it.
+//
+// No process removes its own record.
+// List prunes on read: it drops every record whose pid is dead or now carries another start time, with its lock file, and skips a file that does not decode.
+// Where no start time can be read, as on Windows, a record with an empty start time lives while its pid does.
+// Owners lists every owner directory the same way.
+//
+// End is the only way a run's processes are ended.
+// For an owner's live records, leaving out the caller and its ancestors, it reads every process once, then sends SIGTERM to each recorded leader's group, to each recorded non-leader by pid, and to every process below a record: through its own group when it leads one, by pid otherwise, and not at all when a group already signalled holds it.
+// A signalled group's other live processes are watched like its leader, so each is awaited, sent SIGKILL and reported; a signal call that fails still counts as sent, so its processes are reported while they live.
+// It waits up to `endGrace` for the signalled processes to disappear, then sends SIGKILL to what is left, and waits `killBound`.
+// Every signal follows a comparison with the last reading: a pid is signalled only while its start time matches, and a group only while a live process still reports it with a start time at or after the recorded one.
+// A pid that is a zombie, absent or carries another start time counts as gone.
+// End re-lists the owner up to `endPasses` times, so a process registered during the end is reached.
+// It returns each process it ended and, for processes that survive SIGKILL, a SurvivorsError that names them.
+// EndProcess runs the same sequence on one unregistered pid, for the orphans `lyx tender reap` ends.
+//
+// On Windows no start time can be read and no group can be signalled, so End and EndProcess signal nothing.
+//
+// The package imports the standard library, `internal/proc`, `internal/state` and `internal/logger` only.
+package runproc
diff --git a/internal/runproc/end.go b/internal/runproc/end.go
new file mode 100644
index 000000000..741603a0b
--- /dev/null
+++ b/internal/runproc/end.go
@@ -0,0 +1,395 @@
+// end.go implements the one end sequence of a run's processes: End for an owner's registered processes and EndProcess for one unregistered pid.
+
+package runproc
+
+import (
+	"errors"
+	"fmt"
+	"runtime"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/proc"
+)
+
+const (
+	// endGrace is the time in all that processes get to exit after SIGTERM before SIGKILL.
+	endGrace = 5 * time.Second
+	// killBound is the time processes get to disappear after SIGKILL before they count as survivors.
+	killBound = 2 * time.Second
+	// endPasses is how many times End re-lists an owner, so a process registered during the end is reached.
+	endPasses = 3
+	// pollInterval is the pause between the readings that wait for processes to disappear.
+	pollInterval = 100 * time.Millisecond
+)
+
+// Ended is one process an end sequence signalled and found gone, or, inside a SurvivorsError, one process still alive.
+type Ended struct {
+	// PID is the process id.
+	PID int
+	// Role is the record's role, with a "descendant of " prefix for a process found below a record.
+	Role string
+}
+
+// SurvivorsError reports processes that were still alive after SIGKILL and its bound.
+type SurvivorsError struct {
+	// Survivors lists each process still alive.
+	Survivors []Ended
+}
+
+// Error names each survivor's pid and role.
+func (e *SurvivorsError) Error() string {
+	names := make([]string, len(e.Survivors))
+	for i, survivor := range e.Survivors {
+		names[i] = fmt.Sprintf("%d (%s)", survivor.PID, survivor.Role)
+	}
+	return "runproc: processes survived the end: " + strings.Join(names, ", ")
+}
+
+// End ends every live process registered under owner in dir, and the processes below them, except callerPID and its ancestors.
+// Each is sent SIGTERM and, once the grace is spent, SIGKILL; a signal reaches a pid only while its start time matches the last reading, and a process group only while a live process still reports it.
+// It returns each process it ended and, when some survive SIGKILL, a *SurvivorsError.
+// On Windows, where no process or group can be told apart or signalled, it signals nothing.
+func End(dir, owner string, callerPID int) ([]Ended, error) {
+	return productionEnder().end(dir, owner, callerPID)
+}
+
+// EndProcess ends one process that is registered nowhere, by the same SIGTERM, grace, SIGKILL and bound as End, once its start time still matches startTime.
+// It returns a *SurvivorsError when the process is alive after the bound.
+func EndProcess(pid int, startTime, role string) ([]Ended, error) {
+	return productionEnder().endProcess(pid, startTime, role)
+}
+
+// ender carries the seams of the end sequence, so a test drives it over a scripted process table and a fake clock.
+type ender struct {
+	stats         func() ([]proc.StatEntry, error)
+	startTime     func(pid int) (string, bool)
+	isAlive       func(pid int) bool
+	isAncestor    func(pid int) bool
+	signalProcess func(pid int, kill bool) error
+	signalGroup   func(pgid int, kill bool) error
+	sleep         func(time.Duration)
+	now           func() time.Time
+	goos          string
+}
+
+func productionEnder() ender {
+	return ender{
+		stats:         proc.ListStats,
+		startTime:     proc.StartTime,
+		isAlive:       proc.IsAlive,
+		isAncestor:    proc.IsAncestor,
+		signalProcess: proc.SignalProcess,
+		signalGroup:   proc.SignalGroup,
+		sleep:         time.Sleep,
+		now:           time.Now,
+		goos:          runtime.GOOS,
+	}
+}
+
+// watched is a process an end sequence waits for, identified by pid and the start time read with it.
+type watched struct {
+	pid       int
+	startTime string
+	role      string
+}
+
+// unit is one signal an end sequence sends: to a pid, or to a group when group is set.
+// members are the processes the signal is meant to end.
+type unit struct {
+	pid       int
+	startTime string
+	group     int
+	members   []watched
+}
+
+func (e ender) end(dir, owner string, callerPID int) ([]Ended, error) {
+	if e.goos == "windows" {
+		return nil, nil
+	}
+	list := lister{startTime: e.startTime, isAlive: e.isAlive}
+	attempted := map[string]bool{}
+	var ended, survivors []Ended
+	for pass := 0; pass < endPasses; pass++ {
+		records, err := list.list(dir, owner)
+		if err != nil {
+			return ended, err
+		}
+		var todo []Record
+		for _, record := range records {
+			key := strconv.Itoa(record.PID) + "-" + record.StartTime
+			if record.PID == callerPID || e.isAncestor(record.PID) || attempted[key] {
+				continue
+			}
+			attempted[key] = true
+			todo = append(todo, record)
+		}
+		if len(todo) == 0 {
+			break
+		}
+		stats, err := e.stats()
+		if errors.Is(err, errors.ErrUnsupported) {
+			return ended, nil
+		}
+		if err != nil {
+			return ended, fmt.Errorf("runproc: read processes: %w", err)
+		}
+		skip := func(pid int) bool { return pid == callerPID || e.isAncestor(pid) }
+		passEnded, passSurvivors, err := e.runUnits(planRecords(todo, stats, skip), stats)
+		ended = append(ended, passEnded...)
+		for _, survivor := range passSurvivors {
+			if !slices.Contains(survivors, survivor) {
+				survivors = append(survivors, survivor)
+			}
+		}
+		if err != nil {
+			return ended, err
+		}
+	}
+	logger.Info("runproc: ended the processes of an owner", "owner", owner, "ended", len(ended), "survivors", len(survivors))
+	if len(survivors) > 0 {
+		return ended, &SurvivorsError{Survivors: survivors}
+	}
+	return ended, nil
+}
+
+func (e ender) endProcess(pid int, startTime, role string) ([]Ended, error) {
+	if e.goos == "windows" {
+		return nil, nil
+	}
+	stats, err := e.stats()
+	if errors.Is(err, errors.ErrUnsupported) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("runproc: read processes: %w", err)
+	}
+	target := watched{pid: pid, startTime: startTime, role: role}
+	if !hasRunning(target, stats) {
+		return nil, nil
+	}
+	ended, survivors, err := e.runUnits([]unit{{pid: pid, startTime: startTime, members: []watched{target}}}, stats)
+	if err != nil {
+		return ended, err
+	}
+	if len(survivors) > 0 {
+		return ended, &SurvivorsError{Survivors: survivors}
+	}
+	return ended, nil
+}
+
+// runUnits sends SIGTERM to every unit that still holds against first and waits endGrace for the signalled members to go.
+// It then sends SIGKILL to the units of those left, against a fresh reading, and waits killBound.
+func (e ender) runUnits(units []unit, first []proc.StatEntry) (ended, survivors []Ended, err error) {
+	var signalled []watched
+	for _, u := range units {
+		if e.signal(u, false, first) {
+			signalled = append(signalled, u.members...)
+		}
+	}
+	if len(signalled) == 0 {
+		return nil, nil, nil
+	}
+	remaining, latest, err := e.await(signalled, endGrace)
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(remaining) > 0 {
+		for _, u := range units {
+			if overlaps(u.members, remaining) {
+				e.signal(u, true, latest)
+			}
+		}
+		if remaining, _, err = e.await(remaining, killBound); err != nil {
+			return nil, nil, err
+		}
+	}
+	for _, member := range signalled {
+		target := Ended{PID: member.pid, Role: member.role}
+		if contains(remaining, member) {
+			survivors = append(survivors, target)
+		} else {
+			ended = append(ended, target)
+		}
+	}
+	return ended, survivors, nil
+}
+
+// signal sends SIGTERM, or SIGKILL when kill is set, to the unit when it still holds against stats, and reports whether a signal was attempted.
+// A failed call still counts as attempted, so the unit's members are awaited and a member still running is reported.
+func (e ender) signal(u unit, kill bool, stats []proc.StatEntry) bool {
+	signalName := "SIGTERM"
+	if kill {
+		signalName = "SIGKILL"
+	}
+	var err error
+	switch {
+	case u.group != 0 && groupHolds(u, stats):
+		err = e.signalGroup(u.group, kill)
+		logger.Info("runproc: signalled a process group", "signal", signalName, "pgid", u.group, "err", err)
+	case u.group == 0 && hasRunning(watched{pid: u.pid, startTime: u.startTime}, stats):
+		err = e.signalProcess(u.pid, kill)
+		logger.Info("runproc: signalled a process", "signal", signalName, "pid", u.pid, "err", err)
+	default:
+		return false
+	}
+	return true
+}
+
+// await polls stats until none of members is running or bound is spent, and returns the members still running with the last reading.
+// A member is gone when its pid is absent, a zombie, or carries another start time.
+func (e ender) await(members []watched, bound time.Duration) ([]watched, []proc.StatEntry, error) {
+	deadline := e.now().Add(bound)
+	for {
+		stats, err := e.stats()
+		if err != nil {
+			return nil, nil, fmt.Errorf("runproc: read processes: %w", err)
+		}
+		var remaining []watched
+		for _, member := range members {
+			if hasRunning(member, stats) {
+				remaining = append(remaining, member)
+			}
+		}
+		if len(remaining) == 0 || !e.now().Before(deadline) {
+			return remaining, stats, nil
+		}
+		e.sleep(pollInterval)
+	}
+}
+
+// planRecords builds the signals that end records and everything below them in one reading.
+// A leader's group is signalled as a whole, a process outside a group already signalled is signalled by pid, and one that leads its own group through that group.
+// A group unit's members are its leader and every other live process of the group, so each is awaited and escalated; skip names the processes never watched.
+func planRecords(records []Record, stats []proc.StatEntry, skip func(pid int) bool) []unit {
+	byPID := map[int]proc.StatEntry{}
+	children := map[int][]proc.StatEntry{}
+	for _, entry := range stats {
+		byPID[entry.PID] = entry
+		children[entry.PPID] = append(children[entry.PPID], entry)
+	}
+
+	var units []unit
+	groups := map[int]bool{}
+	claimed := map[int]bool{}
+	running := map[int]bool{}
+	recorded := map[int]bool{}
+	for _, record := range records {
+		recorded[record.PID] = true
+	}
+	for _, record := range records {
+		member := watched{pid: record.PID, startTime: record.StartTime, role: record.Role}
+		running[record.PID] = hasRunning(member, stats)
+		var members []watched
+		if running[record.PID] {
+			claimed[record.PID] = true
+			members = []watched{member}
+		}
+		switch {
+		case record.PGID > 1:
+			if !groups[record.PGID] {
+				members = append(members, groupMembers(record.PGID, "descendant of "+record.Role, stats, claimed, recorded, skip)...)
+			}
+			groups[record.PGID] = true
+			units = append(units, unit{pid: record.PID, startTime: record.StartTime, group: record.PGID, members: members})
+		case running[record.PID]:
+			units = append(units, unit{pid: record.PID, startTime: record.StartTime, members: members})
+		}
+	}
+
+	visited := map[int]bool{}
+	for _, record := range records {
+		if !running[record.PID] {
+			continue
+		}
+		role := "descendant of " + record.Role
+		pending := []int{record.PID}
+		for len(pending) > 0 {
+			parent := pending[0]
+			pending = pending[1:]
+			for _, child := range children[parent] {
+				if visited[child.PID] {
+					continue
+				}
+				visited[child.PID] = true
+				pending = append(pending, child.PID)
+				if child.Zombie || claimed[child.PID] || groups[child.PGID] {
+					continue
+				}
+				claimed[child.PID] = true
+				member := watched{pid: child.PID, startTime: child.StartTime, role: role}
+				next := unit{pid: child.PID, startTime: child.StartTime, members: []watched{member}}
+				if child.PGID == child.PID && child.PGID > 1 {
+					next.group = child.PGID
+					groups[child.PGID] = true
+					next.members = append(next.members, groupMembers(child.PGID, role, stats, claimed, recorded, skip)...)
+				}
+				units = append(units, next)
+			}
+		}
+	}
+	return units
+}
+
+// groupMembers returns the live processes of group that no unit claims yet, bar recorded pids, which each form their own unit, and skipped pids.
+// It marks the returned processes claimed.
+func groupMembers(group int, role string, stats []proc.StatEntry, claimed, recorded map[int]bool, skip func(pid int) bool) []watched {
+	var members []watched
+	for _, entry := range stats {
+		if entry.PGID != group || entry.Zombie || claimed[entry.PID] || recorded[entry.PID] || skip(entry.PID) {
+			continue
+		}
+		claimed[entry.PID] = true
+		members = append(members, watched{pid: entry.PID, startTime: entry.StartTime, role: role})
+	}
+	return members
+}
+
+// hasRunning reports whether stats holds member's pid, with its start time, and not as a zombie.
+func hasRunning(member watched, stats []proc.StatEntry) bool {
+	for _, entry := range stats {
+		if entry.PID == member.pid && entry.StartTime == member.startTime && !entry.Zombie {
+			return true
+		}
+	}
+	return false
+}
+
+// groupHolds reports whether a live process other than a reused pid still reports the unit's group with a start time at or after the unit's.
+// Linux keeps a group id unassigned while any member lives, so a match is the recorded group.
+func groupHolds(u unit, stats []proc.StatEntry) bool {
+	unitStart, err := strconv.ParseUint(u.startTime, 10, 64)
+	if err != nil {
+		return false
+	}
+	for _, entry := range stats {
+		if entry.PGID != u.group || entry.Zombie || (entry.PID == u.pid && entry.StartTime != u.startTime) {
+			continue
+		}
+		if start, err := strconv.ParseUint(entry.StartTime, 10, 64); err == nil && start >= unitStart {
+			return true
+		}
+	}
+	return false
+}
+
+func overlaps(members, remaining []watched) bool {
+	for _, member := range members {
+		if contains(remaining, member) {
+			return true
+		}
+	}
+	return false
+}
+
+func contains(members []watched, member watched) bool {
+	for _, candidate := range members {
+		if candidate.pid == member.pid && candidate.startTime == member.startTime {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/runproc/end_test.go b/internal/runproc/end_test.go
new file mode 100644
index 000000000..75d3d2edd
--- /dev/null
+++ b/internal/runproc/end_test.go
@@ -0,0 +1,428 @@
+// end_test.go tests the end sequence over a scripted process table and a fake clock, so no row spawns a process or waits.
+
+package runproc
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/proc"
+)
+
+// world is a scripted process table with a fake clock and a recorder of the signals sent to it.
+// A signalled process leaves the table unless a row makes it ignore SIGTERM, ignore both signals, or turn zombie on SIGTERM.
+type world struct {
+	start         time.Time
+	clock         time.Time
+	table         map[int]proc.StatEntry
+	signals       []string
+	ignoreTerm    map[int]bool
+	immortal      map[int]bool
+	zombieOnTerm  map[int]bool
+	failSignal    map[int]bool
+	afterTerm     func(w *world)
+	onFirstSignal func(w *world)
+	slept         bool
+	statsErr      error
+}
+
+func entry(pid, ppid, pgid int, startTime string) proc.StatEntry {
+	return proc.StatEntry{PID: pid, PPID: ppid, PGID: pgid, StartTime: startTime}
+}
+
+func pidSet(pids []int) map[int]bool {
+	set := map[int]bool{}
+	for _, pid := range pids {
+		set[pid] = true
+	}
+	return set
+}
+
+func (w *world) react(pid int, kill bool) {
+	current, found := w.table[pid]
+	if !found || w.immortal[pid] || (!kill && w.ignoreTerm[pid]) {
+		return
+	}
+	if !kill && w.zombieOnTerm[pid] {
+		current.Zombie = true
+		w.table[pid] = current
+		return
+	}
+	delete(w.table, pid)
+}
+
+func (w *world) record(kind string, kill bool, id int) {
+	signalName := "term"
+	if kill {
+		signalName = "kill"
+	}
+	if len(w.signals) == 0 && w.onFirstSignal != nil {
+		defer w.onFirstSignal(w)
+	}
+	w.signals = append(w.signals, fmt.Sprintf("%s %s %d", signalName, kind, id))
+}
+
+func (w *world) ender(goos string, ancestors []int) ender {
+	return ender{
+		stats: func() ([]proc.StatEntry, error) {
+			if w.statsErr != nil {
+				return nil, w.statsErr
+			}
+			var entries []proc.StatEntry
+			for _, current := range w.table {
+				entries = append(entries, current)
+			}
+			slices.SortFunc(entries, func(a, b proc.StatEntry) int { return a.PID - b.PID })
+			return entries, nil
+		},
+		startTime: func(pid int) (string, bool) {
+			current, found := w.table[pid]
+			return current.StartTime, found
+		},
+		isAlive: func(pid int) bool {
+			_, found := w.table[pid]
+			return found
+		},
+		isAncestor: func(pid int) bool { return slices.Contains(ancestors, pid) },
+		signalProcess: func(pid int, kill bool) error {
+			if _, found := w.table[pid]; !found {
+				return syscall.ESRCH
+			}
+			if w.failSignal[pid] {
+				return syscall.EPERM
+			}
+			w.record("pid", kill, pid)
+			w.react(pid, kill)
+			return nil
+		},
+		signalGroup: func(pgid int, kill bool) error {
+			var members []int
+			for pid, current := range w.table {
+				if current.PGID == pgid {
+					members = append(members, pid)
+				}
+			}
+			if len(members) == 0 {
+				return syscall.ESRCH
+			}
+			w.record("group", kill, pgid)
+			for _, pid := range members {
+				w.react(pid, kill)
+			}
+			return nil
+		},
+		sleep: func(d time.Duration) {
+			w.clock = w.clock.Add(d)
+			if !w.slept && len(w.signals) > 0 {
+				w.slept = true
+				if w.afterTerm != nil {
+					w.afterTerm(w)
+				}
+			}
+		},
+		now:  func() time.Time { return w.clock },
+		goos: goos,
+	}
+}
+
+func TestEnd(t *testing.T) {
+	t.Parallel()
+
+	setStart := func(pid int, startTime string) func(w *world) {
+		return func(w *world) {
+			current := w.table[pid]
+			current.StartTime = startTime
+			w.table[pid] = current
+		}
+	}
+	setGroup := func(pid, pgid int) func(w *world) {
+		return func(w *world) {
+			current := w.table[pid]
+			current.PGID = pgid
+			w.table[pid] = current
+		}
+	}
+
+	tests := []struct {
+		name          string
+		table         []proc.StatEntry
+		records       []Record
+		process       *Record
+		ancestors     []int
+		caller        int
+		ignoreTerm    []int
+		immortal      []int
+		zombieOnTerm  []int
+		failSignal    []int
+		afterTerm     func(w *world)
+		onFirstSignal func(w *world, dir string)
+		goos          string
+		statsErr      error
+		wantSignals   []string
+		wantEnded     []Ended
+		wantSurvivors []Ended
+		wantSpent     time.Duration
+	}{
+		{
+			name:        "a recorded leader ends with one group signal",
+			table:       []proc.StatEntry{entry(10, 1, 10, "100"), entry(11, 10, 10, "110")},
+			records:     []Record{{PID: 10, PGID: 10, StartTime: "100", Role: RoleLoop}},
+			wantSignals: []string{"term group 10"},
+			wantEnded:   []Ended{{10, RoleLoop}, {11, "descendant of loop"}},
+		},
+		{
+			name:        "a group member that ignores SIGTERM after its leader exits gets the group SIGKILL",
+			table:       []proc.StatEntry{entry(12, 1, 12, "120"), entry(13, 12, 12, "130")},
+			records:     []Record{{PID: 12, PGID: 12, StartTime: "120", Role: RoleLoop}},
+			ignoreTerm:  []int{13},
+			wantSignals: []string{"term group 12", "kill group 12"},
+			wantEnded:   []Ended{{12, RoleLoop}, {13, "descendant of loop"}},
+			wantSpent:   endGrace,
+		},
+		{
+			name:          "a group whose leader is gone still reports a member that survives SIGKILL",
+			table:         []proc.StatEntry{{PID: 12, PPID: 1, PGID: 12, StartTime: "120", Zombie: true}, entry(14, 1, 12, "140")},
+			records:       []Record{{PID: 12, PGID: 12, StartTime: "120", Role: RoleLoop}},
+			immortal:      []int{14},
+			wantSignals:   []string{"term group 12", "kill group 12"},
+			wantSurvivors: []Ended{{14, "descendant of loop"}},
+			wantSpent:     endGrace + killBound,
+		},
+		{
+			name:          "a process whose signal call fails is reported when it stays alive",
+			table:         []proc.StatEntry{entry(15, 1, 5, "150")},
+			records:       []Record{{PID: 15, StartTime: "150", Role: RoleLoop}},
+			failSignal:    []int{15},
+			wantSurvivors: []Ended{{15, RoleLoop}},
+			wantSpent:     endGrace + killBound,
+		},
+		{
+			name:        "a non-leader ends with its descendants signalled by pid",
+			table:       []proc.StatEntry{entry(20, 1, 5, "200"), entry(21, 20, 5, "210"), entry(22, 21, 5, "220")},
+			records:     []Record{{PID: 20, StartTime: "200", Role: RoleLoop}},
+			wantSignals: []string{"term pid 20", "term pid 21", "term pid 22"},
+			wantEnded:   []Ended{{20, RoleLoop}, {21, "descendant of loop"}, {22, "descendant of loop"}},
+		},
+		{
+			name:        "a descendant leading its own group gets a group signal",
+			table:       []proc.StatEntry{entry(30, 1, 5, "300"), entry(31, 30, 31, "310"), entry(32, 31, 31, "320")},
+			records:     []Record{{PID: 30, StartTime: "300", Role: RolePush}},
+			wantSignals: []string{"term pid 30", "term group 31"},
+			wantEnded:   []Ended{{30, RolePush}, {31, "descendant of push"}, {32, "descendant of push"}},
+		},
+		{
+			name:        "the caller and an ancestor of it are not signalled",
+			table:       []proc.StatEntry{entry(40, 1, 5, "400"), entry(41, 40, 5, "410"), entry(42, 1, 5, "420")},
+			records:     []Record{{PID: 40, StartTime: "400", Role: RoleBatten}, {PID: 41, StartTime: "410", Role: RoleDriver}, {PID: 42, StartTime: "420", Role: RoleLoop}},
+			ancestors:   []int{40},
+			caller:      41,
+			wantSignals: []string{"term pid 42"},
+			wantEnded:   []Ended{{42, RoleLoop}},
+		},
+		{
+			name:    "a recorded pid whose start time differs is left alone",
+			table:   []proc.StatEntry{entry(50, 1, 5, "999")},
+			records: []Record{{PID: 50, StartTime: "500", Role: RoleLoop}},
+		},
+		{
+			name:    "a record that appears during the first pass is ended by the second",
+			table:   []proc.StatEntry{entry(60, 1, 5, "600")},
+			records: []Record{{PID: 60, StartTime: "600", Role: RoleLoop}},
+			onFirstSignal: func(w *world, dir string) {
+				w.table[61] = entry(61, 1, 5, "610")
+				if err := Register(dir, "slug", Record{PID: 61, StartTime: "610", Role: RoleSync}); err != nil {
+					panic(err)
+				}
+			},
+			wantSignals: []string{"term pid 60", "term pid 61"},
+			wantEnded:   []Ended{{60, RoleLoop}, {61, RoleSync}},
+		},
+		{
+			name:        "a process that ignores SIGTERM is killed after the grace",
+			table:       []proc.StatEntry{entry(70, 1, 5, "700")},
+			records:     []Record{{PID: 70, StartTime: "700", Role: RoleLoop}},
+			ignoreTerm:  []int{70},
+			wantSignals: []string{"term pid 70", "kill pid 70"},
+			wantEnded:   []Ended{{70, RoleLoop}},
+			wantSpent:   endGrace,
+		},
+		{
+			name:          "a process that survives SIGKILL is named in a survivors error",
+			table:         []proc.StatEntry{entry(80, 1, 5, "800")},
+			records:       []Record{{PID: 80, StartTime: "800", Role: RoleDriver}},
+			immortal:      []int{80},
+			wantSignals:   []string{"term pid 80", "kill pid 80"},
+			wantSurvivors: []Ended{{80, RoleDriver}},
+			wantSpent:     endGrace + killBound,
+		},
+		{
+			name:         "a process that reads zombie after SIGTERM counts as ended",
+			table:        []proc.StatEntry{entry(90, 1, 5, "900")},
+			records:      []Record{{PID: 90, StartTime: "900", Role: RoleLoop}},
+			zombieOnTerm: []int{90},
+			wantSignals:  []string{"term pid 90"},
+			wantEnded:    []Ended{{90, RoleLoop}},
+		},
+		{
+			name:        "a descendant whose pid is reused between SIGTERM and SIGKILL gets no SIGKILL",
+			table:       []proc.StatEntry{entry(100, 1, 5, "1000"), entry(101, 100, 5, "1010")},
+			records:     []Record{{PID: 100, StartTime: "1000", Role: RoleLoop}},
+			ignoreTerm:  []int{101},
+			afterTerm:   setStart(101, "9999"),
+			wantSignals: []string{"term pid 100", "term pid 101"},
+			wantEnded:   []Ended{{100, RoleLoop}, {101, "descendant of loop"}},
+		},
+		{
+			name:        "a recorded non-leader whose pid is reused between SIGTERM and SIGKILL gets no SIGKILL",
+			table:       []proc.StatEntry{entry(110, 1, 5, "1100")},
+			records:     []Record{{PID: 110, StartTime: "1100", Role: RoleLoop}},
+			ignoreTerm:  []int{110},
+			afterTerm:   setStart(110, "9999"),
+			wantSignals: []string{"term pid 110"},
+			wantEnded:   []Ended{{110, RoleLoop}},
+		},
+		{
+			name:    "a recorded leader whose group no live process reports gets no group signal",
+			table:   []proc.StatEntry{entry(120, 1, 7, "1200")},
+			records: []Record{{PID: 120, PGID: 120, StartTime: "1200", Role: RoleLoop}},
+		},
+		{
+			name:    "a recorded leader whose group only an older process reports gets no group signal",
+			table:   []proc.StatEntry{entry(130, 1, 7, "1300"), entry(131, 1, 130, "50")},
+			records: []Record{{PID: 130, PGID: 130, StartTime: "1300", Role: RoleLoop}},
+		},
+		{
+			name:          "a leader whose group empties between SIGTERM and SIGKILL gets no group SIGKILL",
+			table:         []proc.StatEntry{entry(140, 1, 140, "1400")},
+			records:       []Record{{PID: 140, PGID: 140, StartTime: "1400", Role: RoleLoop}},
+			ignoreTerm:    []int{140},
+			afterTerm:     setGroup(140, 7),
+			wantSignals:   []string{"term group 140"},
+			wantSurvivors: []Ended{{140, RoleLoop}},
+			wantSpent:     endGrace + killBound,
+		},
+		{
+			name:          "a descendant leader whose group empties between SIGTERM and SIGKILL gets no group SIGKILL",
+			table:         []proc.StatEntry{entry(150, 1, 5, "1500"), entry(151, 150, 151, "1510")},
+			records:       []Record{{PID: 150, StartTime: "1500", Role: RoleLoop}},
+			ignoreTerm:    []int{151},
+			afterTerm:     setGroup(151, 7),
+			wantSignals:   []string{"term pid 150", "term group 151"},
+			wantEnded:     []Ended{{150, RoleLoop}},
+			wantSurvivors: []Ended{{151, "descendant of loop"}},
+			wantSpent:     endGrace + killBound,
+		},
+		{
+			name:    "Windows signals nothing",
+			table:   []proc.StatEntry{entry(160, 1, 160, "1600")},
+			records: []Record{{PID: 160, PGID: 160, StartTime: "1600", Role: RoleLoop}},
+			goos:    "windows",
+		},
+		{
+			name:     "an unsupported process listing signals nothing",
+			table:    []proc.StatEntry{entry(165, 1, 5, "1650")},
+			records:  []Record{{PID: 165, StartTime: "1650", Role: RoleLoop}},
+			statsErr: errors.ErrUnsupported,
+		},
+		{
+			name:    "EndProcess leaves a pid whose start time differs alone",
+			table:   []proc.StatEntry{entry(170, 1, 5, "999")},
+			process: &Record{PID: 170, StartTime: "1700", Role: "orphan"},
+		},
+		{
+			name:        "EndProcess ends a matching pid by SIGTERM",
+			table:       []proc.StatEntry{entry(171, 1, 5, "1710")},
+			process:     &Record{PID: 171, StartTime: "1710", Role: "orphan"},
+			wantSignals: []string{"term pid 171"},
+			wantEnded:   []Ended{{171, "orphan"}},
+		},
+		{
+			name:        "EndProcess kills a pid that ignores SIGTERM after the grace",
+			table:       []proc.StatEntry{entry(172, 1, 5, "1720")},
+			process:     &Record{PID: 172, StartTime: "1720", Role: "orphan"},
+			ignoreTerm:  []int{172},
+			wantSignals: []string{"term pid 172", "kill pid 172"},
+			wantEnded:   []Ended{{172, "orphan"}},
+			wantSpent:   endGrace,
+		},
+		{
+			name:        "EndProcess sends no SIGKILL to a pid reused between the signals",
+			table:       []proc.StatEntry{entry(173, 1, 5, "1730")},
+			process:     &Record{PID: 173, StartTime: "1730", Role: "orphan"},
+			ignoreTerm:  []int{173},
+			afterTerm:   setStart(173, "9999"),
+			wantSignals: []string{"term pid 173"},
+			wantEnded:   []Ended{{173, "orphan"}},
+		},
+		{
+			name:          "EndProcess returns a survivors error for a pid that survives SIGKILL",
+			table:         []proc.StatEntry{entry(174, 1, 5, "1740")},
+			process:       &Record{PID: 174, StartTime: "1740", Role: "orphan"},
+			immortal:      []int{174},
+			wantSignals:   []string{"term pid 174", "kill pid 174"},
+			wantSurvivors: []Ended{{174, "orphan"}},
+			wantSpent:     endGrace + killBound,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			dir := t.TempDir()
+			begin := time.Unix(1_000_000, 0)
+			w := &world{
+				start:        begin,
+				clock:        begin,
+				table:        map[int]proc.StatEntry{},
+				ignoreTerm:   pidSet(tt.ignoreTerm),
+				immortal:     pidSet(tt.immortal),
+				zombieOnTerm: pidSet(tt.zombieOnTerm),
+				failSignal:   pidSet(tt.failSignal),
+				afterTerm:    tt.afterTerm,
+				statsErr:     tt.statsErr,
+			}
+			for _, current := range tt.table {
+				w.table[current.PID] = current
+			}
+			if tt.onFirstSignal != nil {
+				w.onFirstSignal = func(w *world) { tt.onFirstSignal(w, dir) }
+			}
+			for _, record := range tt.records {
+				if err := Register(dir, "slug", record); err != nil {
+					t.Fatalf("Register(%+v): %v", record, err)
+				}
+			}
+
+			e := w.ender(tt.goos, tt.ancestors)
+			var ended []Ended
+			var err error
+			if tt.process != nil {
+				ended, err = e.endProcess(tt.process.PID, tt.process.StartTime, tt.process.Role)
+			} else {
+				ended, err = e.end(dir, "slug", tt.caller)
+			}
+
+			var survivors *SurvivorsError
+			switch {
+			case len(tt.wantSurvivors) > 0:
+				if !errors.As(err, &survivors) || !slices.Equal(survivors.Survivors, tt.wantSurvivors) {
+					t.Errorf("end error = %v; want a SurvivorsError of %v", err, tt.wantSurvivors)
+				}
+			case err != nil:
+				t.Errorf("end error = %v; want none", err)
+			}
+			if !slices.Equal(ended, tt.wantEnded) {
+				t.Errorf("ended = %v; want %v", ended, tt.wantEnded)
+			}
+			if !slices.Equal(w.signals, tt.wantSignals) {
+				t.Errorf("signals = %v; want %v", w.signals, tt.wantSignals)
+			}
+			if spent := w.clock.Sub(w.start); spent < tt.wantSpent {
+				t.Errorf("clock advanced %v; want at least %v", spent, tt.wantSpent)
+			}
+		})
+	}
+}
