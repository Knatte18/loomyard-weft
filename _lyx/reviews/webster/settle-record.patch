+			if err != nil || len(entries) != 0 {
+				t.Errorf("the working directory holds %v, %v after the refusal; want it untouched", entries, err)
+			}
+		})
+	}
+}
diff --git a/internal/battencli/cancelmarker.go b/internal/battencli/cancelmarker.go
new file mode 100644
index 00000000..d21156c6
--- /dev/null
+++ b/internal/battencli/cancelmarker.go
@@ -0,0 +1,173 @@
+// cancelmarker.go implements the cancel marker of "lyx batten cancel": a record that a cancel of a slug is under way, whose writer's liveness is a lock it holds, never its pid.
+//
+// A driving verb and a second cancel read the marker to refuse while a cancel runs, and to point at the cancel that finishes an interrupted one.
+// The lock is held exclusively from the marker's write to its release, so a marker whose lock is free belongs to a writer that died.
+
+package battencli
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// cancelMarker is the JSON record at shedrun.CancelMarker.
+type cancelMarker struct {
+	// PID is the writer's process id.
+	PID int `json:"pid"`
+	// StartTime is the writer's process start time, empty where the platform cannot read it.
+	StartTime string `json:"start_time"`
+	// StartedAt is when the marker was written, in RFC 3339.
+	StartedAt string `json:"started_at"`
+}
+
+// cancelMarkerReading is what a read of the cancel marker found.
+type cancelMarkerReading struct {
+	// Present is true when a cancel of the slug is under way or was interrupted.
+	Present bool
+	// WriterAlive is true when the marker's writer still holds the marker's lock; it is meaningful only with Present.
+	WriterAlive bool
+	// Marker is the decoded record, empty when the marker does not decode or is absent.
+	Marker cancelMarker
+}
+
+// cancelMarkerStateLock returns the lock that guards the marker file's own reads and writes, distinct from the writer's liveness lock.
+func cancelMarkerStateLock(markerPath string) string {
+	return markerPath + ".lock"
+}
+
+// judgeCancelMarker decides what the cancel marker's three readings make of it.
+// presentBefore is a stat of the marker, lockFree is whether the writer's lock was free to a shared try, and presentUnderLock is a second stat taken while holding that shared lock.
+// An absent marker is not present; a present marker whose lock is held elsewhere has a live writer;
+// a present marker whose lock was free has a dead writer, unless the writer removed it between the first stat and the lock, which reads not present.
+func judgeCancelMarker(presentBefore, lockFree, presentUnderLock bool) (present, writerAlive bool) {
+	if !presentBefore {
+		return false, false
+	}
+	if !lockFree {
+		return true, true
+	}
+	return presentUnderLock, false
+}
+
+// readCancelMarker reads the cancel marker of slug and the liveness of its writer.
+// A marker that does not decode reads present with its fields empty, so a torn write never hides a cancel.
+func readCancelMarker(location *lyxcwd.Location, slug string) (cancelMarkerReading, error) {
+	markerPath := shedrun.CancelMarker(location, slug)
+	presentBefore, err := markerExists(markerPath)
+	if err != nil || !presentBefore {
+		return cancelMarkerReading{}, err
+	}
+
+	shared, lockFree, err := lock.TryAcquireReadLock(shedrun.CancelMarkerLock(location, slug))
+	if err != nil {
+		return cancelMarkerReading{}, err
+	}
+	var presentUnderLock bool
+	if lockFree {
+		presentUnderLock, err = markerExists(markerPath)
+		if releaseErr := shared.Release(); err == nil {
+			err = releaseErr
+		}
+		if err != nil {
+			return cancelMarkerReading{}, err
+		}
+	}
+
+	present, writerAlive := judgeCancelMarker(presentBefore, lockFree, presentUnderLock)
+	reading := cancelMarkerReading{Present: present, WriterAlive: writerAlive}
+	if !present {
+		return reading, nil
+	}
+	marker, _, err := state.ReadJSONNoMkdir[cancelMarker](markerPath, cancelMarkerStateLock(markerPath))
+	if err != nil && !errors.Is(err, state.ErrDecode) {
+		return cancelMarkerReading{}, err
+	}
+	reading.Marker = marker
+	return reading, nil
+}
+
+// markerExists reports whether the file at path exists.
+func markerExists(path string) (bool, error) {
+	_, err := os.Stat(path)
+	switch {
+	case err == nil:
+		return true, nil
+	case errors.Is(err, fs.ErrNotExist):
+		return false, nil
+	}
+	return false, err
+}
+
+// heldCancelMarker is a cancel marker its writer holds the lock of.
+type heldCancelMarker struct {
+	markerPath string
+	held       *lock.FileLock
+	// fresh is false when the marker was already there, left by a writer that died.
+	fresh bool
+}
+
+// takeCancelMarker takes the marker's lock exclusively, waiting at most wait, and writes the marker with this process's pid, start time and the time now.
+// A shared probe of a reader holds the lock briefly, which the wait outlasts.
+// A lock not taken within the wait refuses as a live cancel.
+func takeCancelMarker(location *lyxcwd.Location, slug string, wait time.Duration) (heldCancelMarker, error) {
+	markerPath := shedrun.CancelMarker(location, slug)
+	lockPath := shedrun.CancelMarkerLock(location, slug)
+	if err := os.MkdirAll(shedrun.ScratchRoot(location), 0o755); err != nil {
+		return heldCancelMarker{}, fmt.Errorf("battencli: create the scratch root for the cancel marker: %w", err)
+	}
+
+	held, acquired, err := lock.AcquireWriteLockWithin(lockPath, wait)
+	if err != nil {
+		return heldCancelMarker{}, err
+	}
+	if !acquired {
+		// The reading is best effort: a marker that cannot be read still refuses, with no pid to name.
+		reading, _ := readCancelMarker(location, slug)
+		reading.Present, reading.WriterAlive = true, true
+		return heldCancelMarker{}, cancelMarkerRefusal(slug, reading)
+	}
+
+	existed, err := markerExists(markerPath)
+	if err != nil {
+		return heldCancelMarker{}, errors.Join(err, held.Release())
+	}
+	marker := cancelMarker{PID: os.Getpid(), StartedAt: time.Now().UTC().Format(time.RFC3339)}
+	if start, ok := proc.StartTime(marker.PID); ok {
+		marker.StartTime = start
+	}
+	if err := state.WriteJSON(markerPath, cancelMarkerStateLock(markerPath), marker); err != nil {
+		return heldCancelMarker{}, errors.Join(fmt.Errorf("battencli: write the cancel marker: %w", err), held.Release())
+	}
+	return heldCancelMarker{markerPath: markerPath, held: held, fresh: !existed}, nil
+}
+
+// release removes the marker when remove is true, then releases the lock, so the marker never outlives its lock while being removed.
+func (h heldCancelMarker) release(remove bool) error {
+	var removeErr error
+	if remove {
+		if err := os.Remove(h.markerPath); err != nil && !errors.Is(err, fs.ErrNotExist) {
+			removeErr = fmt.Errorf("battencli: remove the cancel marker: %w", err)
+		}
+	}
+	return errors.Join(removeErr, h.held.Release())
+}
+
+// cancelMarkerRefusal words the refusal a driving verb or a second cancel gets for the marker reading.
+// A live writer is waited for; a dead one is finished by running the cancel again.
+func cancelMarkerRefusal(slug string, reading cancelMarkerReading) error {
+	if reading.WriterAlive {
+		pid := reading.Marker.PID
+		return fmt.Errorf("a cancel of %s is under way (pid %d, since %s); way forward: wait for the cancel (pid %d) to end, seeing it with \"ps -p %d\" or in Task Manager on Windows, then run the verb again",
+			slug, pid, reading.Marker.StartedAt, pid, pid)
+	}
+	return fmt.Errorf("a cancel of %s was interrupted; way forward: run \"lyx batten cancel %s\" from the prime to finish it", slug, slug)
+}
diff --git a/internal/battencli/cancelmarker_test.go b/internal/battencli/cancelmarker_test.go
new file mode 100644
index 00000000..d84087ad
--- /dev/null
+++ b/internal/battencli/cancelmarker_test.go
@@ -0,0 +1,116 @@
+// cancelmarker_test.go pins the cancel marker's record, its writer-liveness reading and the refusal words a reading earns.
+
+package battencli
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/locationkit"
+)
+
+// TestCancelMarker walks one marker through its life over a temporary location: absent, taken, contended, left by a dead writer, taken over, removed and torn.
+func TestCancelMarker(t *testing.T) {
+	t.Parallel()
+
+	location := locationkit.Location(t.TempDir(), "prime", ".")
+	const slug = "slug"
+	const takeWait = 200 * time.Millisecond
+
+	reading, err := readCancelMarker(location, slug)
+	if err != nil || reading.Present {
+		t.Fatalf("readCancelMarker(no marker) = %+v, %v; want not present", reading, err)
+	}
+
+	held, err := takeCancelMarker(location, slug, takeWait)
+	if err != nil {
+		t.Fatalf("takeCancelMarker(no marker) error = %v, want nil", err)
+	}
+	if !held.fresh {
+		t.Error("takeCancelMarker(no marker).fresh = false, want true")
+	}
+
+	reading, err = readCancelMarker(location, slug)
+	if err != nil || !reading.Present || !reading.WriterAlive {
+		t.Fatalf("readCancelMarker(taken) = %+v, %v; want present with the writer alive", reading, err)
+	}
+	if reading.Marker.PID != os.Getpid() || reading.Marker.StartedAt == "" {
+		t.Errorf("readCancelMarker(taken).Marker = %+v, want this process's pid and a start time", reading.Marker)
+	}
+	wantAlive := fmt.Sprintf("way forward: wait for the cancel (pid %d) to end, seeing it with \"ps -p %d\"", os.Getpid(), os.Getpid())
+	if got := cancelMarkerRefusal(slug, reading).Error(); !strings.Contains(got, wantAlive) || !strings.HasSuffix(got, "then run the verb again") {
+		t.Errorf("cancelMarkerRefusal(writer alive) = %q, want it to end with the clause containing %q", got, wantAlive)
+	}
+
+	if _, err := takeCancelMarker(location, slug, 0); err == nil || !strings.Contains(err.Error(), "way forward: wait for the cancel") {
+		t.Errorf("takeCancelMarker(held, no wait) error = %v, want the live-cancel refusal", err)
+	}
+
+	if err := held.release(false); err != nil {
+		t.Fatalf("release(false): %v", err)
+	}
+	reading, err = readCancelMarker(location, slug)
+	if err != nil || !reading.Present || reading.WriterAlive {
+		t.Fatalf("readCancelMarker(writer gone) = %+v, %v; want present with the writer gone", reading, err)
+	}
+	wantGone := `way forward: run "lyx batten cancel slug" from the prime to finish it`
+	if got := cancelMarkerRefusal(slug, reading).Error(); !strings.HasSuffix(got, wantGone) {
+		t.Errorf("cancelMarkerRefusal(writer gone) = %q, want it to end with %q", got, wantGone)
+	}
+
+	held, err = takeCancelMarker(location, slug, takeWait)
+	if err != nil {
+		t.Fatalf("takeCancelMarker(dead writer's marker) error = %v, want nil", err)
+	}
+	if held.fresh {
+		t.Error("takeCancelMarker(dead writer's marker).fresh = true, want false")
+	}
+	if err := held.release(true); err != nil {
+		t.Fatalf("release(true): %v", err)
+	}
+	if _, statErr := os.Stat(shedrun.CancelMarker(location, slug)); !os.IsNotExist(statErr) {
+		t.Errorf("stat of the marker after release(true) = %v, want not exist", statErr)
+	}
+	if reading, err = readCancelMarker(location, slug); err != nil || reading.Present {
+		t.Errorf("readCancelMarker(removed) = %+v, %v; want not present", reading, err)
+	}
+
+	if err := os.WriteFile(shedrun.CancelMarker(location, slug), []byte(`{"pid":`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	reading, err = readCancelMarker(location, slug)
+	if err != nil || !reading.Present || reading.WriterAlive || reading.Marker != (cancelMarker{}) {
+		t.Errorf("readCancelMarker(undecodable) = %+v, %v; want present with empty fields", reading, err)
+	}
+}
+
+// TestJudgeCancelMarker pins each reading of the marker's three probes, the writer removing the marker between the first stat and the shared lock included.
+func TestJudgeCancelMarker(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name                                      string
+		presentBefore, lockFree, presentUnderLock bool
+		wantPresent, wantWriterAlive              bool
+	}{
+		{"AbsentBeforeReadsNotPresent", false, true, false, false, false},
+		{"PresentWithTheLockHeldElsewhereReadsWriterAlive", true, false, false, true, true},
+		{"PresentWithTheLockFreeAndStillThereReadsWriterGone", true, true, true, true, false},
+		{"RemovedBetweenTheStatAndTheSharedLockReadsNotPresent", true, true, false, false, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			present, writerAlive := judgeCancelMarker(tt.presentBefore, tt.lockFree, tt.presentUnderLock)
+			if present != tt.wantPresent || writerAlive != tt.wantWriterAlive {
+				t.Errorf("judgeCancelMarker(%v, %v, %v) = %v, %v; want %v, %v",
+					tt.presentBefore, tt.lockFree, tt.presentUnderLock, present, writerAlive, tt.wantPresent, tt.wantWriterAlive)
+			}
+		})
+	}
+}
