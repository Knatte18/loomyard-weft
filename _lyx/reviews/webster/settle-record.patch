@@ -62,3 +65,50 @@ func effectiveLanguage(plan *Plan) string {
 	}
 	return plan.Language
 }
+
+// PlanLanguage returns plan's language: value, with an absent key read as "go".
+func PlanLanguage(plan *Plan) string {
+	return effectiveLanguage(plan)
+}
+
+// testFileMatchers is the per-language predicate over a slash-separated, repository-relative path that marks a test file, keyed by the plan's language: value.
+// A language absent from the map, including "none", has no matcher, and IsTestFile reads every path of it as a test file.
+var testFileMatchers = map[string]func(path string) bool{
+	"go": func(p string) bool {
+		return strings.HasSuffix(p, "_test.go")
+	},
+	"csharp": func(p string) bool {
+		if path.Ext(p) != ".cs" {
+			return false
+		}
+		if strings.HasSuffix(p, "Tests.cs") || strings.HasSuffix(p, "Test.cs") {
+			return true
+		}
+		for _, dir := range strings.Split(path.Dir(p), "/") {
+			if strings.HasSuffix(dir, "Tests") {
+				return true
+			}
+		}
+		return false
+	},
+}
+
+// IsTestFile reports whether p, a slash-separated repository-relative path, is a test file of language.
+// A language with no declared matcher, "none" included, answers true for every path, so a cap built on it over-covers rather than lets a test edit through.
+func IsTestFile(language, p string) bool {
+	match, ok := testFileMatchers[language]
+	if !ok {
+		return true
+	}
+	return match(p)
+}
+
+// IsAnyLanguageTestFile reports whether p is a test file of any language with a declared matcher.
+func IsAnyLanguageTestFile(p string) bool {
+	for _, match := range testFileMatchers {
+		if match(p) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/planparser/testfile_test.go b/internal/planparser/testfile_test.go
new file mode 100644
index 00000000..629c24e7
--- /dev/null
+++ b/internal/planparser/testfile_test.go
@@ -0,0 +1,60 @@
+// testfile_test.go table-tests the per-language test-file matchers, their union and the plan's effective language.
+
+package planparser
+
+import "testing"
+
+func TestIsTestFile(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name     string
+		language string
+		path     string
+		want     bool
+	}{
+		{"go test file", "go", "internal/x/foo_test.go", true},
+		{"go source file", "go", "internal/x/foo.go", false},
+		{"csharp Tests suffix", "csharp", "src/FooTests.cs", true},
+		{"csharp Test suffix", "csharp", "src/FooTest.cs", true},
+		{"csharp file under a Tests directory", "csharp", "src/BarTests/Baz.cs", true},
+		{"csharp source file", "csharp", "src/Bar/Baz.cs", false},
+		{"none reads every path as a test file", "none", "src/Bar/Baz.cs", true},
+		{"unknown language reads every path as a test file", "rust", "src/lib.rs", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := IsTestFile(tt.language, tt.path); got != tt.want {
+				t.Errorf("IsTestFile(%q, %q) = %v; want %v", tt.language, tt.path, got, tt.want)
+			}
+		})
+	}
+
+	union := []struct {
+		path string
+		want bool
+	}{
+		{"internal/x/foo_test.go", true},
+		{"src/FooTests.cs", true},
+		{"internal/x/foo.go", false},
+	}
+	for _, tt := range union {
+		if got := IsAnyLanguageTestFile(tt.path); got != tt.want {
+			t.Errorf("IsAnyLanguageTestFile(%q) = %v; want %v", tt.path, got, tt.want)
+		}
+	}
+
+	languages := []struct {
+		plan Plan
+		want string
+	}{
+		{Plan{}, "go"},
+		{Plan{Language: "go"}, "go"},
+		{Plan{Language: "csharp"}, "csharp"},
+	}
+	for _, tt := range languages {
+		if got := PlanLanguage(&tt.plan); got != tt.want {
+			t.Errorf("PlanLanguage(language %q) = %q; want %q", tt.plan.Language, got, tt.want)
+		}
+	}
+}
