+		{name: "UnwritableRecordDirStillStartsTheChild", req: PushSpawn{WeftPath: "/weft", TeardownSlug: "task"}, blocked: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			hub := t.TempDir()
