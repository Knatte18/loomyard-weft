diff --git a/internal/battencli/startguard.go b/internal/battencli/startguard.go
new file mode 100644
index 00000000..2cb23e29
--- /dev/null
+++ b/internal/battencli/startguard.go
@@ -0,0 +1,153 @@
+// startguard.go holds batten's pre-run guard: the refusals of a run a cancel is ending, of a start over a dirty source and of a start over the left parts of an earlier pair, all raised before the pre-run writes anything.
+
+package battencli
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/battenrecipe"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// startGuard carries the local reads the pre-run's guard refuses on, as function values.
+// A nil seam checks nothing, which only a hand-populated receiver has.
+type startGuard struct {
+	// Marker reads the slug's cancel marker and the liveness of its writer.
+	Marker func() (cancelMarkerReading, error)
+	// SourceDirty lists the tracked uncommitted paths of the source worktree.
+	SourceDirty func() ([]string, error)
+	// PairParts reads which parts of the slug's pair are present locally.
+	PairParts func() (fabricengine.PairParts, error)
+}
+
+// hubStartGuard builds the startGuard over the hub of location: the cancel marker, the prime's tracked dirty paths and the slug's pair parts, all local reads with no network call.
+func hubStartGuard(location *lyxcwd.Location, slug string) startGuard {
+	return startGuard{
+		Marker:      func() (cancelMarkerReading, error) { return readCancelMarker(location, slug) },
+		SourceDirty: func() ([]string, error) { return fabricengine.SourceDirtyPaths(location) },
+		PairParts: func() (fabricengine.PairParts, error) {
+			cfg, err := fabricengine.LoadConfig(fabricengine.ConfigDirs(location))
+			if err != nil {
+				return fabricengine.PairParts{}, err
+			}
+			return fabricengine.NewTopology(cfg).PairParts(location, slug)
+		},
+	}
+}
+
+// refuse judges verb's start or resume of slug, in order.
+// A present cancel marker refuses run, step and goto.
+// A run or step with no status file, or one whose status is at Worktree-Create while the task worktree is absent, refuses on tracked dirty paths of the source worktree.
+// A run or step with no status file refuses when a task worktree, records worktree or local records branch is left from an earlier run.
+// A probe error refuses naming the probe and the verb's re-run.
+// found and status describe the run's status file, and taskWorktreePresent whether the task worktree is there, which only a status at Worktree-Create reads.
+func (g startGuard) refuse(slug, verb string, status shedengine.Status, found, taskWorktreePresent bool) error {
+	rerun := fmt.Sprintf(`"lyx batten %s %s"`, verb, slug)
+
+	if (verb == "run" || verb == "step" || verb == "goto") && g.Marker != nil {
+		reading, err := g.Marker()
+		if err != nil {
+			return probeRefusal("the cancel marker", slug, rerun, err)
+		}
+		if reading.Present {
+			return cancelMarkerRefusal(slug, reading)
+		}
+	}
+	if verb != "run" && verb != "step" {
+		return nil
+	}
+
+	atWorktreeCreate := found && status.CurrentProducer == battenrecipe.NameWorktreeCreate && !taskWorktreePresent
+	if (!found || atWorktreeCreate) && g.SourceDirty != nil {
+		paths, err := g.SourceDirty()
+		if err != nil {
+			return probeRefusal("the source worktree's tracked changes", slug, rerun, err)
+		}
+		if len(paths) > 0 {
+			return fmt.Errorf("the source worktree has uncommitted tracked changes: %s; commit or revert them in the source worktree, then run %s again", strings.Join(paths, ", "), rerun)
+		}
+	}
+
+	if !found && g.PairParts != nil {
+		parts, err := g.PairParts()
+		if err != nil {
+			return probeRefusal("the pair's parts", slug, rerun, err)
+		}
+		if left := leftPartNames(parts); len(left) > 0 {
+			return fmt.Errorf("%s left a pair from an earlier run (%s); run \"lyx batten cancel %s --remove\" from the prime, which removes it, then %s",
+				slug, strings.Join(left, ", "), slug, rerun)
+		}
+	}
+	return nil
+}
+
+// leftPartNames names the parts of a pair that make a start refuse: the task worktree, the records worktree and the local records branch.
+// A task branch left alone is not named, since the add refuses it and Worktree-Create halts on it.
+func leftPartNames(parts fabricengine.PairParts) []string {
+	var names []string
+	if parts.TaskWorktree {
+		names = append(names, "task worktree")
+	}
+	if parts.RecordsWorktree {
+		names = append(names, "records worktree")
+	}
+	if parts.RecordsBranch {
+		names = append(names, "records branch")
+	}
+	return names
+}
+
+// probeRefusal words the refusal of a guard probe that failed with err, naming the probe and the step to run again.
+func probeRefusal(probe, slug, rerun string, err error) error {
+	return fmt.Errorf("battencli: could not read %s of %s: %w; way forward: fix the cause, then run %s again", probe, slug, err, rerun)
+}
+
+// refuseCancelMarker refuses when a cancel of the slug is under way or was interrupted.
+// A receiver with no guard seam checks nothing.
+func (c *battenCLI) refuseCancelMarker() error {
+	if c.guard.Marker == nil {
+		return nil
+	}
+	reading, err := c.guard.Marker()
+	if err != nil {
+		return probeRefusal("the cancel marker", c.slug, "the verb", err)
+	}
+	if reading.Present {
+		return cancelMarkerRefusal(c.slug, reading)
+	}
+	return nil
+}
+
+// refuseAtStart reads the run's status file and applies the guard to verb's start or resume.
+// Verbs other than run, step and goto are not guarded.
+// Its reads create nothing but the status lock's ephemeral directory, which checkRunStatus creates the same way.
+func (c *battenCLI) refuseAtStart(verb string) error {
+	if verb != "run" && verb != "step" && verb != "goto" {
+		return nil
+	}
+	statusPath := StatusFile(c.location, c.slug)
+	statusLockPath := shedrun.StatusLock(c.location, c.slug)
+	if err := os.MkdirAll(filepath.Dir(statusLockPath), 0o755); err != nil {
+		return err
+	}
+	status, found, err := state.ReadJSONNoMkdir[shedengine.Status](statusPath, statusLockPath)
+	if err != nil {
+		return fmt.Errorf("battencli: read status file %s: %w", statusPath, err)
+	}
+
+	var taskPresent bool
+	if found && status.CurrentProducer == battenrecipe.NameWorktreeCreate {
+		taskPresent, err = taskWorktreePresent(c.location, c.slug)
+		if err != nil {
+			return err
+		}
+	}
+	return c.guard.refuse(c.slug, verb, status, found, taskPresent)
+}
diff --git a/internal/battencli/startguard_integration_test.go b/internal/battencli/startguard_integration_test.go
new file mode 100644
index 00000000..f78c9621
--- /dev/null
+++ b/internal/battencli/startguard_integration_test.go
@@ -0,0 +1,101 @@
+//go:build integration
+
+// startguard_integration_test.go drives armAt and "lyx batten run" over a hubforge hub to pin that the pre-run guard refuses before any write: no seed, no status file, no board pull or claim and no window.
+
+package battencli
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/envelope"
+)
+
+// TestArmAt_StartGuardRefusesBeforeAnyWrite asserts the guard refuses a start before armAt pulls the board, claims the prime or writes a seed:
+// a dirty source refuses naming the path, a cancel marker refuses a step, and "run --window" on the dirty source refuses on the envelope with no seed, so no window was opened.
+func TestArmAt_StartGuardRefusesBeforeAnyWrite(t *testing.T) {
+	t.Parallel()
+
+	const slug = "guarded-task"
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	readme := filepath.Join(h.PrimeWorktree(), "README")
+	clean, err := os.ReadFile(readme)
+	if err != nil {
+		t.Fatal(err)
+	}
+	owners := boardengine.Owners{Prime: "here", Entries: map[string]boardengine.OwnerEntry{}}
+	assertNothingWritten := func(t *testing.T, fake *fakeOwners) {
+		t.Helper()
+		if fake.pulls != 0 || len(fake.sets) != 0 {
+			t.Errorf("owner seams saw %d pulls and writes %v; want none", fake.pulls, fake.sets)
+		}
+		assertNoRunWritten(t, h.Location, slug)
+	}
+
+	t.Run("DirtyTrackedFileRefusesTheRun", func(t *testing.T) {
+		if err := os.WriteFile(readme, append(clean, "changed\n"...), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		fake := &fakeOwners{machine: "here", owners: owners}
+		c := &battenCLI{owner: fake.seams()}
+
+		_, err := c.armAt(h.Location, slug, true, "run")
+
+		if err == nil {
+			t.Fatal("armAt(run) over a dirty source = nil; want a refusal")
+		}
+		for _, want := range []string{"README", "commit or revert"} {
+			if !strings.Contains(err.Error(), want) {
+				t.Errorf("armAt(run) error = %q; want it to carry %q", err.Error(), want)
+			}
+		}
+		assertNothingWritten(t, fake)
+	})
+
+	t.Run("RunWindowOnTheDirtySourceRefusesOnTheEnvelopeWithNoSeed", func(t *testing.T) {
+		var out bytes.Buffer
+		RunCLIIn(h.PrimeWorktree(), &out, []string{"run", slug, "--window"})
+
+		envelope.RequireErr(t, out.String(), "README")
+		assertNoRunWritten(t, h.Location, slug)
+	})
+
+	t.Run("CancelMarkerRefusesTheStep", func(t *testing.T) {
+		if err := os.WriteFile(readme, clean, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		held, err := takeCancelMarker(h.Location, slug, time.Second)
+		if err != nil {
+			t.Fatalf("takeCancelMarker: %v", err)
+		}
+		t.Cleanup(func() { _ = held.release(true) })
+		fake := &fakeOwners{machine: "here", owners: owners}
+		c := &battenCLI{owner: fake.seams()}
+
+		_, err = c.armAt(h.Location, slug, true, "step")
+
+		if err == nil || !strings.Contains(err.Error(), "a cancel of "+slug+" is under way") {
+			t.Fatalf("armAt(step) with a cancel marker = %v; want the cancel refusal", err)
+		}
+		assertNothingWritten(t, fake)
+	})
+}
+
+// assertNoRunWritten fails the test when slug has a seed or a status file under location.
+func assertNoRunWritten(t *testing.T, location *lyxcwd.Location, slug string) {
+	t.Helper()
+	if _, found, err := shedrun.ReadSeed(location, slug); err != nil || found {
+		t.Errorf("ReadSeed(%q) = (found %v, err %v); want no seed", slug, found, err)
+	}
+	if pathExists(shedrun.StatusFile(location, slug)) {
+		t.Errorf("a status file exists for %q; want none", slug)
+	}
+}
diff --git a/internal/battencli/startguard_test.go b/internal/battencli/startguard_test.go
new file mode 100644
index 00000000..b6ac93a6
--- /dev/null
+++ b/internal/battencli/startguard_test.go
@@ -0,0 +1,243 @@
+// startguard_test.go pins the pre-run guard's refusals over fake seams, and the seed write's re-read of the cancel marker.
+
+package battencli
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/battenrecipe"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/runproc"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+)
+
+// TestStartGuard_Refuse drives startGuard.refuse over fake seams: which verbs the cancel marker refuses, when a dirty source refuses, which left pair parts refuse a start, and that a failing probe refuses naming the re-run.
+func TestStartGuard_Refuse(t *testing.T) {
+	t.Parallel()
+
+	const slug = "some-slug"
+	markerAlive := &cancelMarkerReading{Present: true, WriterAlive: true, Marker: cancelMarker{PID: 4242, StartedAt: "2026-10-23T08:00:00Z"}}
+	markerGone := &cancelMarkerReading{Present: true}
+	tests := []struct {
+		name  string
+		verbs []string
+		// marker is what the Marker seam reads; nil reads absent.
+		marker *cancelMarkerReading
+		dirty  []string
+		parts  fabricengine.PairParts
+		// found, producer and taskPresent describe the run's status file and task worktree.
+		found       bool
+		producer    string
+		taskPresent bool
+		markerErr   error
+		dirtyErr    error
+		partsErr    error
+		// noSeams leaves every seam nil.
+		noSeams bool
+		// wantErrors are substrings the refusal carries; "{verb}" stands for the verb under test.
+		wantErrors []string
+	}{
+		{
+			name:       "MarkerWithTheWriterAliveRefusesTheDrivingVerbs",
+			verbs:      []string{"run", "step", "goto"},
+			marker:     markerAlive,
+			found:      true,
+			producer:   battenrecipe.NameRunShed,
+			wantErrors: []string{"a cancel of some-slug is under way", "way forward: wait for the cancel (pid 4242)", `"ps -p 4242"`},
+		},
+		{
+			name:       "MarkerWithTheWriterGoneRefusesTheDrivingVerbs",
+			verbs:      []string{"run", "step", "goto"},
+			marker:     markerGone,
+			found:      true,
+			producer:   battenrecipe.NameRunShed,
+			wantErrors: []string{"a cancel of some-slug was interrupted", `way forward: run "lyx batten cancel some-slug"`},
+		},
+		{
+			name:     "MarkerPassesTheVerbsThatDoNotDrive",
+			verbs:    []string{"status", "pause"},
+			marker:   markerAlive,
+			dirty:    []string{"a.txt"},
+			parts:    fabricengine.PairParts{TaskWorktree: true},
+			found:    false,
+			producer: "",
+		},
+		{
+			name:       "DirtyStartRefusesNamingEachPathAndTheRerun",
+			verbs:      []string{"run", "step"},
+			dirty:      []string{"a.txt", "dir/b.txt"},
+			wantErrors: []string{"a.txt, dir/b.txt", "commit or revert", `run "lyx batten {verb} some-slug" again`},
+		},
+		{
+			name:  "CleanStartPasses",
+			verbs: []string{"run", "step"},
+		},
+		{
+			name:       "ResumeAtWorktreeCreateWithNoTaskWorktreeRefusesWhenDirty",
+			verbs:      []string{"run", "step"},
+			dirty:      []string{"a.txt"},
+			found:      true,
+			producer:   battenrecipe.NameWorktreeCreate,
+			wantErrors: []string{"a.txt", "commit or revert"},
+		},
+		{
+			name:        "ResumeAtWorktreeCreateWithTheTaskWorktreePresentPassesWhileDirty",
+			verbs:       []string{"run", "step"},
+			dirty:       []string{"a.txt"},
+			found:       true,
+			producer:    battenrecipe.NameWorktreeCreate,
+			taskPresent: true,
+		},
+		{
+			name:     "ResumePastWorktreeCreatePassesWhileDirty",
+			verbs:    []string{"run", "step"},
+			dirty:    []string{"a.txt"},
+			found:    true,
+			producer: battenrecipe.NameRunShed,
+		},
+		{
+			name:  "GotoRunsNoDirtyCheck",
+			verbs: []string{"goto"},
+			dirty: []string{"a.txt"},
+		},
+		{
+			name:       "LeftTaskWorktreeRefusesAStart",
+			verbs:      []string{"run", "step"},
+			parts:      fabricengine.PairParts{TaskWorktree: true},
+			wantErrors: []string{"some-slug left a pair from an earlier run (task worktree)", `run "lyx batten cancel some-slug --remove" from the prime`, `then "lyx batten {verb} some-slug"`},
+		},
+		{
+			name:       "LeftRecordsWorktreeRefusesAStart",
+			verbs:      []string{"run", "step"},
+			parts:      fabricengine.PairParts{RecordsWorktree: true},
+			wantErrors: []string{"(records worktree)", "lyx batten cancel some-slug --remove"},
+		},
+		{
+			name:       "LeftRecordsBranchRefusesAStart",
+			verbs:      []string{"run", "step"},
+			parts:      fabricengine.PairParts{RecordsBranch: true},
+			wantErrors: []string{"(records branch)", "lyx batten cancel some-slug --remove"},
+		},
+		{
+			name:  "LeftTaskBranchAlonePasses",
+			verbs: []string{"run", "step"},
+			parts: fabricengine.PairParts{TaskBranch: true, Launchers: true},
+		},
+		{
+			name:     "LeftPartsDoNotRefuseAResume",
+			verbs:    []string{"run", "step"},
+			parts:    fabricengine.PairParts{TaskWorktree: true, RecordsWorktree: true, RecordsBranch: true},
+			found:    true,
+			producer: battenrecipe.NameRunShed,
+		},
+		{
+			name:       "MarkerProbeErrorRefusesNamingTheProbeAndTheRerun",
+			verbs:      []string{"run", "step", "goto"},
+			markerErr:  errors.New("marker unreadable"),
+			wantErrors: []string{"the cancel marker", "marker unreadable", `run "lyx batten {verb} some-slug" again`},
+		},
+		{
+			name:       "DirtyProbeErrorRefusesNamingTheProbeAndTheRerun",
+			verbs:      []string{"run", "step"},
+			dirtyErr:   errors.New("git status failed"),
+			wantErrors: []string{"the source worktree's tracked changes", "git status failed", `run "lyx batten {verb} some-slug" again`},
+		},
+		{
+			name:       "PartsProbeErrorRefusesNamingTheProbeAndTheRerun",
+			verbs:      []string{"run", "step"},
+			partsErr:   errors.New("worktree list failed"),
+			wantErrors: []string{"the pair's parts", "worktree list failed", `run "lyx batten {verb} some-slug" again`},
+		},
+		{
+			name:    "NilSeamsCheckNothing",
+			verbs:   []string{"run", "step", "goto"},
+			noSeams: true,
+		},
+	}
+	for _, tt := range tests {
+		for _, verb := range tt.verbs {
+			t.Run(verb+"/"+tt.name, func(t *testing.T) {
+				t.Parallel()
+
+				var guard startGuard
+				if !tt.noSeams {
+					guard = startGuard{
+						Marker: func() (cancelMarkerReading, error) {
+							if tt.marker == nil {
+								return cancelMarkerReading{}, tt.markerErr
+							}
+							return *tt.marker, tt.markerErr
+						},
+						SourceDirty: func() ([]string, error) { return tt.dirty, tt.dirtyErr },
+						PairParts:   func() (fabricengine.PairParts, error) { return tt.parts, tt.partsErr },
+					}
+				}
+
+				err := guard.refuse(slug, verb, shedengine.Status{CurrentProducer: tt.producer}, tt.found, tt.taskPresent)
+
+				if len(tt.wantErrors) == 0 {
+					if err != nil {
+						t.Fatalf("refuse(%s) = %v; want nil", verb, err)
+					}
+					return
+				}
+				if err == nil {
+					t.Fatalf("refuse(%s) = nil; want a refusal carrying %q", verb, tt.wantErrors)
+				}
+				for _, want := range tt.wantErrors {
+					want = strings.ReplaceAll(want, "{verb}", verb)
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("refuse(%s) = %q; want it to carry %q", verb, err.Error(), want)
+					}
+				}
+			})
+		}
+	}
+}
+
+// TestArmSeed_CancelMarkerRefusesTheWrite asserts a cancel marker read at the seed write refuses it with the cancel refusal, writes no seed and registers no process, and that an absent marker seeds as before.
+func TestArmSeed_CancelMarkerRefusesTheWrite(t *testing.T) {
+	t.Parallel()
+
+	const slug = "some-slug"
+	tests := []struct {
+		name       string
+		marker     cancelMarkerReading
+		wantErr    string
+		wantSeeded bool
+	}{
+		{name: "PresentMarkerRefusesAndWritesNoSeed", marker: cancelMarkerReading{Present: true, WriterAlive: true, Marker: cancelMarker{PID: 4242}}, wantErr: "a cancel of some-slug is under way"},
+		{name: "AbsentMarkerSeedsAsBefore", wantSeeded: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			location := &lyxcwd.Location{HubPath: t.TempDir(), WorktreeName: "code", AnchorRel: "."}
+			c := &battenCLI{slug: slug, guard: startGuard{Marker: func() (cancelMarkerReading, error) { return tt.marker, nil }}}
+
+			err := c.armSeed(location, slug, "run")
+
+			if tt.wantErr != "" && (err == nil || !strings.Contains(err.Error(), tt.wantErr)) {
+				t.Fatalf("armSeed(run) = %v; want a refusal carrying %q", err, tt.wantErr)
+			}
+			if tt.wantErr == "" && err != nil {
+				t.Fatalf("armSeed(run) = %v; want nil", err)
+			}
+			if _, found, readErr := shedrun.ReadSeed(location, slug); readErr != nil || found != tt.wantSeeded {
+				t.Errorf("ReadSeed = (found %v, err %v); want found %v", found, readErr, tt.wantSeeded)
+			}
+			records := listRunRecords(t, location, slug)
+			if tt.wantSeeded && (len(records) != 1 || records[0].Role != runproc.RoleBatten) {
+				t.Errorf("run records = %+v; want one batten record", records)
+			}
+			if !tt.wantSeeded && len(records) != 0 {
+				t.Errorf("run records = %+v; want none after the refusal", records)
+			}
+		})
+	}
+}
