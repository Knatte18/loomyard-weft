-						return shedengine.Status{}, false, err
-					}
-					return state.ReadJSONNoMkdir[shedengine.Status](c.shedPaths.StatusPath, c.shedPaths.StatusLockPath)
-				},
-				branches: func() (string, string, string, error) {
-					f, err := open()
