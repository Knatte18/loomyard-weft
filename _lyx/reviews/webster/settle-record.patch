+			}
 			const held = "row notice held back; no orch strand is recorded"
 			if got := countLogLines(buf.String(), "WARN", held); got != tt.wantHeldWarns {
 				t.Errorf("WARN lines %q = %d; want %d\n%s", held, got, tt.wantHeldWarns, buf.String())
