+	if _, err := fabricengine.PushPairAnchored(location, fabricengine.SyncOptions{}, fabricengine.LockWaitUnbounded); err != nil {
+		t.Fatalf("PushPairAnchored() priming push error = %v; want nil", err)
+	}
+	return p
+}
