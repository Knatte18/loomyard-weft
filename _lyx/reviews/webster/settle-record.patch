diff --git a/internal/gatecli/counters.go b/internal/gatecli/counters.go
new file mode 100644
index 00000000..1f7b40aa
--- /dev/null
+++ b/internal/gatecli/counters.go
@@ -0,0 +1,183 @@
+// counters.go declares the counters a tier names: writers a tier command's output goes through, which pass it on as text and count its tests.
+
+package gatecli
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"regexp"
+	"strconv"
+	"sync"
+)
+
+const (
+	counterGoJSON = "go-json"
+	counterVSTest = "vstest"
+)
+
+// vstestSummary matches a VSTest summary line, whose `Passed!` and `Failed!` forms carry the same four counts.
+var vstestSummary = regexp.MustCompile(`(?:Passed|Failed)!\s+-\s+Failed:\s*(\d+),\s*Passed:\s*(\d+),\s*Skipped:\s*(\d+),\s*Total:\s*(\d+)`)
+
+// tierCounts is the number of tests a tier run discovered and how each ended.
+type tierCounts struct {
+	discovered int
+	passed     int
+	failed     int
+	skipped    int
+}
+
+// counter is the writer a tier command's stdout and stderr go through.
+// It passes the output on as text and counts the tests it reports; the counts decide nothing about the run's outcome.
+type counter interface {
+	io.Writer
+	// Flush emits a trailing partial line that no newline ended.
+	Flush() error
+	// Counts returns the counts so far.
+	Counts() tierCounts
+}
+
+// newCounter returns the counter kind names, writing the tier's text output to out.
+// Any kind but `go-json` and `vstest` is an error.
+func newCounter(kind string, out io.Writer) (counter, error) {
+	switch kind {
+	case counterGoJSON:
+		c := &goJSONCounter{}
+		c.lines = lineReader{out: out, handle: c.handle}
+		return c, nil
+	case counterVSTest:
+		c := &vstestCounter{}
+		c.lines = lineReader{out: out, handle: c.handle}
+		return c, nil
+	}
+	return nil, fmt.Errorf("gate counter %q is neither %q nor %q", kind, counterGoJSON, counterVSTest)
+}
+
+// lineReader splits written bytes into lines and hands each to handle, serialising concurrent writers.
+// A line is handed over without its newline, and terminated says whether a newline ended it.
+type lineReader struct {
+	mu      sync.Mutex
+	out     io.Writer
+	pending []byte
+	handle  func(line []byte, terminated bool) error
+}
+
+func (r *lineReader) Write(p []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.pending = append(r.pending, p...)
+	for {
+		end := bytes.IndexByte(r.pending, '\n')
+		if end < 0 {
+			return len(p), nil
+		}
+		line := r.pending[:end]
+		err := r.handle(line, true)
+		r.pending = r.pending[end+1:]
+		if err != nil {
+			return len(p), err
+		}
+	}
+}
+
+func (r *lineReader) Flush() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if len(r.pending) == 0 {
+		return nil
+	}
+	line := r.pending
+	r.pending = nil
+	return r.handle(line, false)
+}
+
+// passThrough writes line to out, with its newline when terminated.
+func (r *lineReader) passThrough(line []byte, terminated bool) error {
+	if terminated {
+		line = append(line[:len(line):len(line)], '\n')
+	}
+	_, err := r.out.Write(line)
+	return err
+}
+
+// goJSONCounter reads `go test -json` events and writes their output text, so failures, panics and build errors read as plain `go test` prints them.
+// A line that is no JSON event, such as a `go build` or `go vet` step's output, passes through verbatim.
+type goJSONCounter struct {
+	lines  lineReader
+	counts tierCounts
+}
+
+// goTestEvent is the part of a `go test -json` event the counter reads.
+type goTestEvent struct {
+	Action string
+	Test   string
+	Output string
+}
+
+func (c *goJSONCounter) Write(p []byte) (int, error) { return c.lines.Write(p) }
+
+func (c *goJSONCounter) Flush() error { return c.lines.Flush() }
+
+func (c *goJSONCounter) Counts() tierCounts {
+	c.lines.mu.Lock()
+	defer c.lines.mu.Unlock()
+	return c.counts
+}
+
+// handle runs under the line reader's lock.
+func (c *goJSONCounter) handle(line []byte, terminated bool) error {
+	var event goTestEvent
+	if len(line) == 0 || line[0] != '{' || json.Unmarshal(line, &event) != nil || event.Action == "" {
+		return c.lines.passThrough(line, terminated)
+	}
+	if event.Test != "" {
+		switch event.Action {
+		case "run":
+			c.counts.discovered++
+		case "pass":
+			c.counts.passed++
+		case "fail":
+			c.counts.failed++
+		case "skip":
+			c.counts.skipped++
+		}
+	}
+	if event.Output == "" {
+		return nil
+	}
+	_, err := io.WriteString(c.lines.out, event.Output)
+	return err
+}
+
+// vstestCounter passes every line through and sums the counts of every VSTest summary line.
+type vstestCounter struct {
+	lines  lineReader
+	counts tierCounts
+}
+
+func (c *vstestCounter) Write(p []byte) (int, error) { return c.lines.Write(p) }
+
+func (c *vstestCounter) Flush() error { return c.lines.Flush() }
+
+func (c *vstestCounter) Counts() tierCounts {
+	c.lines.mu.Lock()
+	defer c.lines.mu.Unlock()
+	return c.counts
+}
+
+// handle runs under the line reader's lock.
+func (c *vstestCounter) handle(line []byte, terminated bool) error {
+	if match := vstestSummary.FindSubmatch(line); match != nil {
+		// The pattern holds only digit groups, so the conversions cannot fail.
+		failed, _ := strconv.Atoi(string(match[1]))
+		passed, _ := strconv.Atoi(string(match[2]))
+		skipped, _ := strconv.Atoi(string(match[3]))
+		total, _ := strconv.Atoi(string(match[4]))
+		c.counts.failed += failed
+		c.counts.passed += passed
+		c.counts.skipped += skipped
+		c.counts.discovered += total
+	}
+	return c.lines.passThrough(line, terminated)
+}
diff --git a/internal/gatecli/counters_test.go b/internal/gatecli/counters_test.go
new file mode 100644
index 00000000..4d67c5f4
--- /dev/null
+++ b/internal/gatecli/counters_test.go
@@ -0,0 +1,150 @@
+// counters_test.go covers the counters a tier names: the text they pass through and the test counts they report.
+
+package gatecli
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// goEvent renders one `go test -json` event line, without its newline.
+func goEvent(action, test, output string) string {
+	line := fmt.Sprintf(`{"Action":%q,"Package":"example.com/p"`, action)
+	if test != "" {
+		line += fmt.Sprintf(`,"Test":%q`, test)
+	}
+	if output != "" {
+		line += fmt.Sprintf(`,"Output":%q`, output)
+	}
+	return line + "}"
+}
+
+func TestCounters(t *testing.T) {
+	t.Parallel()
+
+	splitEvent := goEvent("output", "TestA", "=== RUN   TestA\n") + "\n"
+	vstestPassed := "Passed!  - Failed:     0, Passed:    12, Skipped:     0, Total:    12, Duration: 1 s - x.dll (net8.0)\n"
+	vstestFailed := "Failed!  - Failed:     2, Passed:     3, Skipped:     1, Total:     6, Duration: 2 s - y.dll (net8.0)\n"
+
+	tests := []struct {
+		name string
+		kind string
+		// writes are the chunks written in order.
+		writes []string
+		// held is the suffix of wantOut that only Flush emits.
+		held       string
+		wantOut    string
+		wantCounts tierCounts
+	}{
+		{
+			name: "a passing and a failing test",
+			kind: "go-json",
+			writes: []string{strings.Join([]string{
+				goEvent("run", "TestA", ""), goEvent("output", "TestA", "=== RUN   TestA\n"), goEvent("pass", "TestA", ""),
+				goEvent("run", "TestB", ""), goEvent("output", "TestB", "--- FAIL: TestB (0.00s)\n"), goEvent("fail", "TestB", ""),
+				goEvent("output", "", "FAIL\n"), goEvent("fail", "", ""),
+			}, "\n") + "\n"},
+			wantOut:    "=== RUN   TestA\n--- FAIL: TestB (0.00s)\nFAIL\n",
+			wantCounts: tierCounts{discovered: 2, passed: 1, failed: 1},
+		},
+		{
+			name:       "a skipped test",
+			kind:       "go-json",
+			writes:     []string{goEvent("run", "TestA", "") + "\n" + goEvent("skip", "TestA", "") + "\n"},
+			wantCounts: tierCounts{discovered: 1, skipped: 1},
+		},
+		{
+			name: "subtests count each",
+			kind: "go-json",
+			writes: []string{strings.Join([]string{
+				goEvent("run", "TestA", ""), goEvent("run", "TestA/sub", ""), goEvent("pass", "TestA/sub", ""), goEvent("pass", "TestA", ""),
+			}, "\n") + "\n"},
+			wantCounts: tierCounts{discovered: 2, passed: 2},
+		},
+		{
+			name: "a panic's output and a build error's non-JSON lines read as text",
+			kind: "go-json",
+			writes: []string{
+				"# example.com/p\nx.go:1:1: undefined: y\n" + goEvent("output", "TestA", "panic: boom\n") + "\n" + goEvent("fail", "TestA", "") + "\nFAIL\texample.com/p [build failed]\n",
+			},
+			wantOut:    "# example.com/p\nx.go:1:1: undefined: y\npanic: boom\nFAIL\texample.com/p [build failed]\n",
+			wantCounts: tierCounts{failed: 1},
+		},
+		{
+			name:       "a line split across two writes",
+			kind:       "go-json",
+			writes:     []string{splitEvent[:20], splitEvent[20:]},
+			wantOut:    "=== RUN   TestA\n",
+			wantCounts: tierCounts{},
+		},
+		{
+			name:       "a trailing line with no newline comes out on Flush",
+			kind:       "go-json",
+			writes:     []string{"ok\n", "tail"},
+			held:       "tail",
+			wantOut:    "ok\ntail",
+			wantCounts: tierCounts{},
+		},
+		{
+			name: "package-level events alone discover zero",
+			kind: "go-json",
+			writes: []string{strings.Join([]string{
+				goEvent("start", "", ""), goEvent("output", "", "ok  \texample.com/p\t0.01s [no tests to run]\n"), goEvent("pass", "", ""),
+			}, "\n") + "\n"},
+			wantOut:    "ok  \texample.com/p\t0.01s [no tests to run]\n",
+			wantCounts: tierCounts{},
+		},
+		{
+			name:       "two VSTest summary lines are summed and passed through",
+			kind:       "vstest",
+			writes:     []string{"Starting test run\n" + vstestPassed + vstestPassed},
+			wantOut:    "Starting test run\n" + vstestPassed + vstestPassed,
+			wantCounts: tierCounts{discovered: 24, passed: 24},
+		},
+		{
+			name:       "a VSTest Failed! summary",
+			kind:       "vstest",
+			writes:     []string{vstestFailed},
+			wantOut:    vstestFailed,
+			wantCounts: tierCounts{discovered: 6, passed: 3, failed: 2, skipped: 1},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			var out bytes.Buffer
+			c, err := newCounter(tt.kind, &out)
+			if err != nil {
+				t.Fatalf("newCounter(%q) error = %v; want nil", tt.kind, err)
+			}
+			for _, chunk := range tt.writes {
+				if n, err := c.Write([]byte(chunk)); n != len(chunk) || err != nil {
+					t.Fatalf("Write(%q) = %d, %v; want %d, nil", chunk, n, err, len(chunk))
+				}
+			}
+			if want := strings.TrimSuffix(tt.wantOut, tt.held); out.String() != want {
+				t.Errorf("output before Flush = %q; want %q", out.String(), want)
+			}
+			if err := c.Flush(); err != nil {
+				t.Fatalf("Flush() error = %v; want nil", err)
+			}
+			if out.String() != tt.wantOut {
+				t.Errorf("output = %q; want %q", out.String(), tt.wantOut)
+			}
+			if got := c.Counts(); got != tt.wantCounts {
+				t.Errorf("Counts() = %+v; want %+v", got, tt.wantCounts)
+			}
+		})
+	}
+
+	t.Run("an unknown kind is an error", func(t *testing.T) {
+		t.Parallel()
+
+		if _, err := newCounter("tap", &bytes.Buffer{}); err == nil {
+			t.Error("newCounter(\"tap\") error = nil; want an error")
+		}
+	})
+}
diff --git a/internal/gatecli/doc.go b/internal/gatecli/doc.go
index 674f67f2..897604e6 100644
--- a/internal/gatecli/doc.go
+++ b/internal/gatecli/doc.go
@@ -1,89 +1,181 @@
-// Package gatecli provides the cobra command tree for `lyx gate`, whose one verb, `test`, is the sanctioned route for an agent's slotted `go test`.
+// Package gatecli provides the cobra command tree for `lyx gate`, whose verb `test` is the sanctioned route for running the hub's test tiers and whose verb `card-verify` runs a plan card's `**Verify:**` line.
 //
 // The module is not standalone-capable and does not go through internal/cliwire: it has no target directory, state, plan or stencils to wire, and it resolves hub membership itself.
 //
 // # Verb
 //
-// `lyx gate test [-C <dir>] [--tags <tags>] [--guards] <packages...> [-- <go test flags>]` runs `go test -C <dir> -p <cap>`, then `-tags <tags>` when given, then the packages, then the flags after `--`.
-// The -C directory is made absolute against the seam cwd, never the process cwd when -C is given, and must exist.
-// At least one package is required; a module-wide pattern is accepted and slotted.
-// A package argument spelled relative (`.`, `..`, `./…` or `../…`), not ending in `.go` and with a trailing `/...` removed must name a directory under the -C directory, or the verb refuses before hub resolution, any slot and the prebuild; for an external test package it names the package directory to pass instead.
-// Import paths, absolute paths, module-wide patterns whose stem exists and `.go` file arguments are not read and reach go test unchanged.
-// The output streams through and the exit code is go test's own.
-// With `--tags` non-empty the verb first builds `lyx` once, inside the held slot: `go build -C <root> -p <cap> -trimpath -o <tmp>/lyx ./cmd/lyx`, where <root> is the worktree root inside a hub and the -C directory outside one, and <tmp> is a per-invocation directory in the process run directory of `internal/lyxtemp`, removed after go test ends outside a hub.
-// go test's environment then carries `gateslot.PrebuiltLyxEnv` naming that binary, so every package of the run shares it instead of building its own.
-// Inside a hub the binary is first copied into the pool's store (`gateslot.Pool.PrebuiltDir`) as `lyx-` and the first 16 hex digits of its SHA-256, the build directory is removed, and the variable names the stored copy.
-// Go keys a cached test result on the variable's value, so a path named by the binary's content keeps a re-run on an unchanged tree cached, the `-trimpath` build being reproducible, and changes whenever `lyx` does, so no cached result outlives a changed `lyx`.
-// A stored binary already present is reused and its modification time set, marking its last use, and each store prunes the other entries unused for two hours.
-// Bound: a run whose binary is pruned while it runs fails its later lyxbin tests with the stale-prebuilt error; the retention is far past any gate run.
-// A root without `cmd/lyx` builds nothing, and a nested module inside a hub still builds the worktree's `lyx`, which that module's tests may leave unused.
-// A build failure is a JSON error with the build's output and exit code 1, before go test runs.
-//
-// With `--guards` the verb also runs every top-level test marked `//lyx:guard` in the module at the -C directory, by name in its own package, inside the same slot.
-// The package list may then be empty.
-// A tag list without `integration` is refused first, before the package-directory check and hub resolution, since every guard compiles under that tag; the way forward is to add it to `--tags`.
-// After the package-directory check and before hub resolution and any slot, `impactset.ModuleGuardTests` scans the -C directory, and a scan error refuses the verb with its file and line and a way forward for its kind:
+// `lyx gate test [-C <dir>] [--tier N]... [--card <id>]... [--base <rev>] [--all] [--guards] [--wait] [<targets>...] [-- <args>]` runs the tiers the hub declares in gate.yaml, in ascending tier number, and stops at the first tier that fails.
+// `--tier` names a tier and may repeat; the default is tier0, and a tier another listed tier covers is dropped and named as covered on stderr.
+// `--tags` stays a registered flag only to be refused before any slot, naming `--tier`: a tier's own command sets its build tags.
+// The words after `--` fill each tier's `{args}`.
+//
+// A tier is one shell command with the placeholders `{targets}`, `{parallel}` and `{args}`, which `renderTierCommand` fills with each target and each arg quoted for the platform shell by `verifyrun.QuoteArg`.
+// The command runs through the shell `verifyrun.ShellFor` names, as a tied child in the run directory, with this process's environment less the strand-name and trace-id variables, less an inherited `gateslot.PrebuiltLyxEnv`, plus the tier's `env` with `{parallel}` filled, plus the lease's `gateslot.InheritEnv` and the enclosing-gate pid.
+// The tier's `dir`, relative to the worktree root, is the run directory.
+// A tier with `prebuilt_lyx` first builds `lyx` at the tier's `parallel`, inside its slots and timeout, only where the worktree root holds `cmd/lyx`, and exports `gateslot.PrebuiltLyxEnv`.
+// Inside a hub the binary is copied into the pool's store (`gateslot.Pool.PrebuiltDir`) as `lyx-` and the first 16 hex digits of its SHA-256, the build directory is removed, and the variable names the stored copy;
+// outside a hub the variable names the build directory's binary, which is removed after the tier.
+// Go keys a cached test result on the variable's value, so a path named by the binary's content keeps a re-run on an unchanged tree cached, and a stored binary already present is reused with its modification time set, marking its last use.
+// Each store prunes the other entries unused for two hours.
+//
+// # Scope
+//
+// There are five scope forms, and a call takes one: explicit `<targets>`, `--all`, `--card <id>`, `--base <rev>` and, with none of them, the computed form.
+// Explicit targets replace each run's `{targets}` verbatim and run in the `-C` directory, else in the tier's `dir`.
+// `--all` sets `{targets}` to the tier's `all_targets`, split at spaces, and runs in the tier's `dir`.
+// A command without `{targets}` runs once, whole, under explicit targets and under a non-empty narrower scope, and says so on stderr.
+// Flag-shape refusals need no config and run first, before hub resolution: `--tags`, naming `--tier`; `-C` without explicit targets, naming them; and more than one scope form.
+//
+// # Scoper
+//
+// `computeScope` resolves the computed, `--base` and `--card` forms inside the pre-tier ceiling, and `gate.yaml`'s `scoper` decides what they mean.
+// The computed form's base is the merge base of HEAD with the parent branch the pair's fabric origin record names, read through `parentMergeBase`; a worktree with no origin record or no parent, such as the prime on `main` or a standalone run, runs whole.
+// `--base` names that base itself.
+// `--card`, repeatable, reads the plan at the anchor's plan directory through `planparser.ParsePlan` and takes `planparser.CardPackages` of the named cards; an id is a card's number or its `N-slug`, an unknown id is refused before any slot naming the plan's ids, and a worktree with no plan is refused naming `--all` and explicit targets.
+// The plan read and its two refusals run first under either scoper.
+//
+// Under the `none` scoper each of the three forms is whole, so a tier takes its `all_targets`, and no guard step is planned.
+// Under the `go` scoper a computed or `--base` scope is `impactset.DeriveTargets` of the diff from its base to the working tree, and falls back to whole wherever it does, naming the reason on stderr;
+// a `--card` scope is the cards' packages.
+// A narrower scope runs each listed tier once per module, in that module's directory with its module-relative targets, under one slot hold and one `timeout_min` covering every invocation.
+// An empty scope, such as a diff of Markdown files only, runs no listed tier's command: each listed tier passes with zero discovered, is logged so, takes no slot, and only the guard step runs.
+// The import graph cannot see everything a narrower run skips, such as `go build ./...`, so that is left to the whole runs at `final` and `landing`.
+// Once the config is loaded, `planTierRuns` refuses, before any slot and naming `lyx config gate`: words after `--` for a tier whose command lacks `{args}`, an undeclared tier, a hub with no `tier0`, and a `covers` entry or a `guard_tier` naming a tier the hub does not declare.
+// Every such refusal closes with the clause that a session that is not the prime takes none of the steps, reports status: FAILED and leaves them to the orch.
+//
+// # Guard step
+//
+// With `--guards`, and under the `go` scoper after any computed, `--base` or `--card` scope, the verb runs, after the listed tiers pass, `runGuardStep` over the module's `//lyx:guard` tests outside the scope.
+// `impactset.DeriveTargets` names those packages for a narrower computed or `--base` scope, and an `impactset.ModuleGuardTests` scan of the module at the run directory names them for a `--card` scope, a scope fallen back to whole, and `--guards` over explicit targets.
+// So the round and darn writer gates, which run `--base`, keep the guard coverage they have had, where every guard package counts as outside a tier that does not compile it.
+// The step is one run of `guard_tier`'s command with the guard packages as `{targets}` and `-run '^(<names>)$'` after any words from `--` as `{args}`, so the guard's own pattern is the last `-run` and wins over one among those words.
+// It acquires `guard_tier`'s slots after the last listed tier released its own, runs under `guard_tier`'s `timeout_min` and `prebuilt_lyx`, and is logged as the guard step.
+// It is skipped when the call ran `guard_tier`, or a tier covering it, whole.
+// A step that is not skipped refuses a `guard_tier` command lacking `{targets}` or `{args}`, naming `lyx config gate`.
+// A scan error refuses the call before any slot with the file, the line when there is one and a way forward for its kind:
 // move a misplaced marker directly above its `func Test…` line, compile the marked test's file under `integration`, or make an unparsable or unreadable file readable and parseable.
 // Any other scan error, such as an unreadable package directory, names the module directory and the way forward to make `go list ./...` succeed there.
-// Inside the held slot, after the prebuild, the verb runs `go test` over the named packages when there are any, then one `go test` per guard package in directory order, its arguments the package's own, the flags after `--` and then `-run '^(<names>)$'`, so the guard's own pattern is the last `-run` and wins over one among those flags.
