index c003cd7c..06d40d9e 100644
--- a/internal/pairteardown/doc.go
+++ b/internal/pairteardown/doc.go
@@ -46,6 +46,31 @@
 // A board or status read failure warns and writes nothing, and a failed removal settles nothing.
 // A run whose Finalize merged but failed its done mark and stopped on its push holds no Finalize Done, so its entry ends cleared, for the operator to mark done with `lyx board set-status`.
 //
+// # Local mode
+//
+// Request.Local removes the pair through Topology.RemoveLocal: no origin step, and no board read or write, so the claim settlement is skipped whole.
+// A busy teardown lock or records write lock surfaces from RemovePair as fabricengine.ErrPairBusy.
+// A local-mode caller passes RefuseWhenBusy with a zero QuietWait, so a busy driver is ErrDriverBusy at once with nothing ended.
+//
+// Request.Snapshot, the force case, keeps the pair's task and records worktrees' uncommitted paths under a local snapshot tag before the removal.
+// RemovePair takes it first, after EndSession ended the driver and before the teardown lock is tried, logs its tag and paths, sets them on the result's SnapshotTag and SnapshotPaths, and puts its record ahead of the removal's.
+// Request.AfterSnapshot then runs, and the removal follows.
+// A snapshot refused busy returns that error with nothing removed and AfterSnapshot not run, so a re-run still qualifies;
+// an AfterSnapshot error returns with nothing removed and the snapshot tag kept, so a re-run takes the earlier-snapshot path.
+// The force case passes Force and no RefuseWhenBusy, as batten's own teardown does.
+//
+// Every refusal and both EndSession waits stay in local mode: the loop lock's seizure and the run lock's release are each bounded by runLockWait.
+//
+// # Origin seams
+//
+// `Teardown.OriginSeams` builds the seams the origin reconcile takes by injection, so every call site's CLI package reads a live pair and removes an ended entry's pair the same way.
+// `LivePair` is the negation of the quiet rule's probe, except that a slug a live hub pause entry covers reads not live, its driver being interrupted.
+// `SeamOptions.HubPaused` is asked at each `LivePair` call, so a pause lifted while the reconcile waited at the network gate reads lifted and the resumed driver reads live.
+// `Teardown` runs the local mode with a zero quiet wait and RefuseWhenBusy, and a busy driver or a held lock comes back as the report's busy flag, never as an error, with nothing removed.
+// The force case, a live wake-written pair pause entry (`SeamOptions.WakeHeld`) or an earlier snapshot tag, passes Force and Snapshot and no RefuseWhenBusy, so a busy driver is ended;
+// `SeamOptions.LiftWakeHold` runs as AfterSnapshot, lifting the hold only once the snapshot is kept.
+// `HubSeamOptions` fills `HubPaused` from a read of the pause record at each call and `PrimeParentLockFree` from one listing of the parent lock store for the prime's branch, and leaves the two wake-hold fields nil, which read as no wake hold.
+//
 // # Quiet rule
 //
 // A pair is quiet when its run lock and its loop lock are free and its driver strand is absent, dead, retiring or parked.
diff --git a/internal/pairteardown/originseams.go b/internal/pairteardown/originseams.go
new file mode 100644
index 00000000..60b047dd
--- /dev/null
+++ b/internal/pairteardown/originseams.go
@@ -0,0 +1,137 @@
+// originseams.go builds the seams the origin reconcile takes by injection: whether a pair is live, whether the prime branch's parent lock is free, and how an ended entry's pair is torn down.
+// Every call site's CLI package builds them here, so the reconcile sees one reading of a live pair and one local removal.
+
+package pairteardown
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/parentlock"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+)
+
+// SeamOptions carries what the origin reconcile's call site knows and Teardown does not.
+// HubPaused reports whether a live hub pause entry covers slug, whose driver is then interrupted; LivePair calls it each time it is called, so a pause lifted meanwhile reads lifted.
+// PrimeParentLockFree reads once whether the prime branch's parent lock record is free; nil reads as free.
+// WakeHeld reports whether a live wake-written pair pause entry of slug exists, and LiftWakeHold lifts it; both nil read as no wake hold.
+type SeamOptions struct {
+	HubPaused           func(slug string) (bool, error)
+	PrimeParentLockFree func() (bool, error)
+	WakeHeld            func(slug string) (bool, error)
+	LiftWakeHold        func(slug string) error
+}
+
+// HubSeamOptions returns the options a call site with only the prime's location needs.
+// HubPaused reads the hub's pause record at each call, and PrimeParentLockFree lists the parent lock store once for the prime's branch.
+// WakeHeld and LiftWakeHold are left nil, which read as no wake hold, for the call site that knows one to fill.
+func HubSeamOptions(prime *lyxcwd.Location) SeamOptions {
+	return SeamOptions{
+		HubPaused: func(slug string) (bool, error) {
+			geometry, err := hubgeom.PauseGeometry(prime)
+			if err != nil {
+				return false, err
+			}
+			record, err := pauserecord.Read(geometry.RecordPath)
+			if err != nil {
+				return false, err
+			}
+			_, covered := record.Covering(slug)
+			return covered, nil
+		},
+		PrimeParentLockFree: func() (bool, error) {
+			branch, err := gitrepo.New(prime.WorktreePath()).CurrentBranch()
+			if err != nil {
+				return false, fmt.Errorf("read the prime's branch: %w", err)
+			}
+			store := &parentlock.Store{Dir: parentlock.Dir(fabricengine.BoardDir(prime.HubPath))}
+			entries, err := store.List()
+			if err != nil {
+				return false, err
+			}
+			for _, entry := range entries {
+				if entry.Record.Branch == branch && (entry.Alive || entry.Err != "") {
+					return false, nil
+				}
+			}
+			return true, nil
+		},
+	}
+}
+
+// OriginSeams returns the seams the origin reconcile reaches by injection.
+// LivePair is the negation of the quiet rule's probe, except that a slug a live hub pause entry covers reads not live.
+// Teardown removes an ended entry's pair in local mode with a zero quiet wait, refusing a busy driver, and reports a busy driver or a busy lock as the report's busy flag.
+// The force case, a pair with a wake-written pause entry or an earlier snapshot tag, instead ends the driver, snapshots the pair's uncommitted paths and, once they are kept, lifts the wake hold.
+func (t *Teardown) OriginSeams(opts SeamOptions) fabricengine.OriginSeams {
+	return fabricengine.OriginSeams{
+		LivePair: func(slug string) (bool, error) {
+			if opts.HubPaused != nil {
+				paused, err := opts.HubPaused(slug)
+				if err != nil {
+					return false, err
+				}
+				if paused {
+					return false, nil
+				}
+			}
+			state, err := t.quiet(slug)
+			if err != nil {
+				return false, err
+			}
+			return !state.quiet, nil
+		},
+		PrimeParentLockFree: opts.PrimeParentLockFree,
+		Teardown: func(request fabricengine.EndedTeardown) (fabricengine.TeardownReport, error) {
+			return t.teardownEnded(opts, request)
+		},
+	}
+}
+
+// teardownEnded runs the local removal of one ended entry's pair.
+func (t *Teardown) teardownEnded(opts SeamOptions, ended fabricengine.EndedTeardown) (fabricengine.TeardownReport, error) {
+	wakeHeld := false
+	if opts.WakeHeld != nil {
+		var err error
+		if wakeHeld, err = opts.WakeHeld(ended.Slug); err != nil {
+			return fabricengine.TeardownReport{}, err
+		}
+	}
+
+	request := Request{Slug: ended.Slug, Local: true, RefuseWhenBusy: true}
+	if wakeHeld || ended.EarlierSnapshot {
+		request.RefuseWhenBusy = false
+		request.Force = true
+		request.Snapshot = true
+	}
+	if wakeHeld && opts.LiftWakeHold != nil {
+		request.AfterSnapshot = func() error { return opts.LiftWakeHold(ended.Slug) }
+	}
+
+	result, err := t.Run(context.Background(), request)
+	report := fabricengine.TeardownReport{MutationRecord: result.Removal.MutationRecord}
+	if result.Removal.SnapshotTag != "" {
+		report.Tags = append(report.Tags, result.Removal.SnapshotTag)
+	}
+	if result.Removal.SetAsideTag != "" {
+		report.Tags = append(report.Tags, result.Removal.SetAsideTag)
+	}
+	if reason := result.Removal.CodeBranchKeptReason; reason != "" {
+		report.Kept = append(report.Kept, reason)
+	}
+
+	switch {
+	case errors.Is(err, ErrDriverBusy):
+		report.Busy, report.BusyOn = true, fabricengine.BusyOnDriver
+		return report, nil
+	case errors.Is(err, fabricengine.ErrPairBusy):
+		report.Busy, report.BusyOn = true, fabricengine.BusyOnLock
+		return report, nil
+	}
+	return report, err
+}
