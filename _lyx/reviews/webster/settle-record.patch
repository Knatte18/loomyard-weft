+// cancel_test.go pins cancelRun's decisions and order over fake substrates, and the pure readings it builds on.
+
+package battencli
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/battenrecipe"
