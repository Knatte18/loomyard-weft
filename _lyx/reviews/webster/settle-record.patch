+		return planparser.TargetGroup{Type: planparser.CardTypeEdit, Refs: refs}
+	}
+	deleted := func(refs ...string) planparser.TargetGroup {
+		return planparser.TargetGroup{Type: planparser.CardTypeDelete, Refs: refs}
+	}
+
+	tests := []struct {
