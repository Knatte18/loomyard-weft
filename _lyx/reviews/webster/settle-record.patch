+// projection_test.go covers ProjectOverview and EntryBullet, one row per replace, append and delete outcome.
+
+package pattern
+
+import "testing"
+
+func TestProjectOverview(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name       string
+		overview   string
+		prescribed []string
+		removes    []string
