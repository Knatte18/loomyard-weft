+func TmuxHasAllowSetTitle(versionLine string) (parsed, has bool) {
+	match := tmuxVersionLine.FindStringSubmatch(strings.TrimSpace(versionLine))
+	if match == nil {
+		return false, false
+	}
+	return true, compareVersions(match[1], TmuxAllowSetTitle) >= 0
+}
