+func ArbiterLimits(cfg Config, o Override) (timeout time.Duration, maxSpawns int) {
+	timeout = arbiterDefaultTimeout
+	if o.ArbiterTimeoutMin > 0 {
+		timeout = time.Duration(o.ArbiterTimeoutMin) * time.Minute
