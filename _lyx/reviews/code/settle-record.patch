 // The refusal is a *RunLockedError that matches ErrRunLocked through errors.Is.
 // Its message names the entry, its status and both ways forward: a finding goes to a note of its own, and an abandoned run is ended with `lyx batten cancel <slug>` from the prime, which clears the status.
 //
+// # Run agents file notes, never tasks
+//
+// Only the operator decides what becomes a task, so a run's agent may file a follow-up as a note and never as a task.
+// Config.StrandName names the writing session, and a name carrying a task slug under any role but the orch's is a run agent's;
+// an empty name, the hub orch's slug-free name and an orch thread's name write as before.
+// For a run agent, the write critical section refuses, before the save, a net change that leaves a task whose slug held no task in the loaded entries:
+// a new task, a promote, a note upserted to kind task and a merge upserting a new task, while a rename is judged with the loaded slug renamed and creates none.
+// The refusal names the session, the entry and the way forward, a note with "kind":"note".
+// The guard trusts the name its caller passes, so it stops a mistaken write, not a determined one, and the replay of a local commit never runs it.
+//
 // # Rename
 //
 // Rename changes one entry's slug in one write: the entry keeps its id, its handle, its position in board.json and every other field, kept keys included, and every other entry's depends_on names the new slug in place of the old one.
diff --git a/internal/boardengine/taskguard.go b/internal/boardengine/taskguard.go
new file mode 100644
index 000000000..f565a7d7f
--- /dev/null
+++ b/internal/boardengine/taskguard.go
@@ -0,0 +1,39 @@
+// taskguard.go — the refusal of a board write that creates or promotes a task from a run's agent session.
+
+package boardengine
+
+import (
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+)
+
+// isRunAgentSession reports whether strandName is a session of a run's agent: a name that carries a task slug, under any role but the orch's.
+// An empty name, a slug-free name and an orch thread's name are not.
+func isRunAgentSession(strandName string) bool {
+	name, err := agentname.Parse(strandName)
+	return err == nil && name.Slug != "" && !agentname.MatchesRole(name.Role, agentname.RoleOrch)
+}
+
+// checkTaskCreation refuses, for a run agent's strandName, a net change that leaves a task in after whose slug held no task in loaded.
+// A new task, a promote, a note upserted to kind task and a merge upserting a new task all count; a note write and an edit of an existing task do not.
+// It returns the first refusal in after's order.
+func checkTaskCreation(strandName string, loaded, after []Task) error {
+	if !isRunAgentSession(strandName) {
+		return nil
+	}
+	wasTask := make(map[string]bool, len(loaded))
+	for _, task := range loaded {
+		if task.Kind == KindTask {
+			wasTask[task.Slug] = true
+		}
+	}
+	for _, task := range after {
+		if task.Kind == KindTask && !wasTask[task.Slug] {
+			return fmt.Errorf("the run session %s cannot make %q a task: only the operator decides what becomes a task; "+
+				"way forward: file the follow-up as a note with `lyx board upsert` and \"kind\":\"note\", which the operator may promote",
+				strandName, task.Slug)
+		}
+	}
+	return nil
+}
diff --git a/internal/boardengine/taskguard_test.go b/internal/boardengine/taskguard_test.go
new file mode 100644
index 000000000..9a0cf1169
--- /dev/null
+++ b/internal/boardengine/taskguard_test.go
@@ -0,0 +1,130 @@
+//go:build tier0
+
+// taskguard_test.go — the refusal of a write that creates or promotes a task from a run agent's session (taskguard.go), driven through the Board facade.
+
+package boardengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+)
+
+// TestTaskCreationGuard pins which writes a run agent's session may make, and that the operator, the hub orch and an orch thread may create a task.
+// A refused row leaves board.json byte-identical.
+func TestTaskCreationGuard(t *testing.T) {
+	t.Parallel()
+
+	const runAgent = "ly:some-task:webster"
+	existingTask := map[string]any{"slug": "existing", "title": "Existing", "kind": "task", "labels": []string{"bug"}}
+	existingNote := map[string]any{"slug": "idea", "title": "Idea", "kind": "note", "labels": []string{"bug"}}
+	newTask := map[string]any{"slug": "follow-up", "title": "Follow-up", "kind": "task", "labels": []string{"bug"}}
+
+	tests := []struct {
+		name       string
+		strandName string
+		act        func(b *boardengine.Board) error
+		// refused names the slug the refusal must name; empty means the write passes.
+		refused string
+	}{
+		{name: "upsert a new task", strandName: runAgent, refused: "follow-up", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(newTask)
+			return err
+		}},
+		{name: "upsert a note to kind task", strandName: runAgent, refused: "idea", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(map[string]any{"slug": "idea", "kind": "task"})
+			return err
+		}},
+		{name: "promote a note", strandName: runAgent, refused: "idea", act: func(b *boardengine.Board) error {
+			_, err := b.Promote("idea")
+			return err
+		}},
+		{name: "batch carrying a new task", strandName: runAgent, refused: "follow-up", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTasksBatch([]map[string]any{{"slug": "existing", "body": "new"}, newTask})
+			return err
+		}},
+		{name: "merge upserting a new task", strandName: runAgent, refused: "follow-up", act: func(b *boardengine.Board) error {
+			_, _, err := b.MergeTasks([]string{"existing"}, newTask, nil)
+			return err
+		}},
+
+		{name: "a run agent files a note", strandName: runAgent, act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(map[string]any{"slug": "finding", "title": "Finding", "kind": "note", "labels": []string{"bug"}})
+			return err
+		}},
+		{name: "a run agent edits an existing task", strandName: runAgent, act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(map[string]any{"slug": "existing", "body": "new"})
+			return err
+		}},
+		{name: "a run agent renames a task", strandName: runAgent, act: func(b *boardengine.Board) error {
+			_, err := b.Rename("existing", "renamed")
+			return err
+		}},
+		{name: "the operator creates a task", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(newTask)
+			return err
+		}},
+		{name: "the hub orch promotes a note", strandName: "ly:orch", act: func(b *boardengine.Board) error {
+			_, err := b.Promote("idea")
+			return err
+		}},
+		{name: "an orch thread creates a task", strandName: "ly:some-task:orch", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(newTask)
+			return err
+		}},
+		{name: "a numbered orch thread creates a task", strandName: "ly:some-task:orch-2", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(newTask)
+			return err
+		}},
+		{name: "a slug-free non-orch session creates a task", strandName: "ly:webster", act: func(b *boardengine.Board) error {
+			_, err := b.UpsertTask(newTask)
+			return err
+		}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			boardPath := t.TempDir()
+			config := boardengine.Config{Path: boardPath, Readme: "Home.md", DesignPrefix: "proposal-", Types: testTypes, Labels: testLabels, SkipGit: true}
+			seeder := boardengine.New(config)
+			for _, seed := range []map[string]any{existingTask, existingNote} {
+				if _, err := seeder.UpsertTask(seed); err != nil {
+					t.Fatalf("seed %v: %v", seed["slug"], err)
+				}
+			}
+			before, err := os.ReadFile(filepath.Join(boardPath, "board.json"))
+			if err != nil {
+				t.Fatalf("read board.json: %v", err)
+			}
+			config.StrandName = tt.strandName
+
+			err = tt.act(boardengine.New(config))
+
+			if tt.refused == "" {
+				if err != nil {
+					t.Fatalf("write refused: %v", err)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatal("write passed; want it refused")
+			}
+			for _, want := range []string{tt.strandName, `"` + tt.refused + `"`, `"kind":"note"`} {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("message %q lacks %q", err.Error(), want)
+				}
+			}
+			after, err := os.ReadFile(filepath.Join(boardPath, "board.json"))
+			if err != nil {
+				t.Fatalf("read board.json: %v", err)
+			}
+			if string(after) != string(before) {
+				t.Error("board.json changed on a refused write")
+			}
+		})
+	}
+}
