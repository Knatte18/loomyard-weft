+				}
+				if _, err := os.Lstat(filepath.Join(fabricengine.WorktreePath(h.Location, slug), lyxdirs.LyxDirName)); err != nil {
+					t.Errorf("adopted pair is not wired at its own anchor: %v", err)
+				}
+			})
+		}
+	})
+}
