diff --git a/contracts/recipes/beam-recipe.yaml b/contracts/recipes/beam-recipe.yaml
new file mode 100644
index 000000000..d663203cf
--- /dev/null
+++ b/contracts/recipes/beam-recipe.yaml
@@ -0,0 +1,30 @@
+# beam-recipe.yaml is the landing recipe of a beam: its change description is written from its board
+# entry and the commits it adds, then Finalize merges the beam's parent into the beam, runs the
+# landing gate and fast-forwards the parent. It is embedded into the binary by the sibling
+# recipes.go rather than read from disk. The row names below are the durable on-disk identities
+# that resume depends on.
+#
+# The recipe has no review segment: a beam's members were each reviewed when they landed into it.
+#
+# Finalize never reroutes, so it declares no on_reroute: a conflict or a merge too large to land has
+# no earlier row to return to, because Beam-Describe writes from the entry and the commits and
+# reviews nothing. A merge conflict goes to Finalize's merge fixer, a large merge runs the landing
+# gate, and a failure the fixer cannot fix halts the run for the orch.
+#
+# Beam-Describe carries no on_stuck either: a description that fails validation halts the run for
+# the orch, which ends the landing and fixes the entry.
+
+version: 1
+entry: Beam-Describe
+terminals:
+  - Finalize
+
+producers:
+  - name: Beam-Describe
+    engine: BeamDescribe
+    on_done: Finalize
+
+  # Finalize's empty on_done is load-bearing and is what ends the run quietly.
+  - name: Finalize
+    engine: Finalize
+    on_done: ""
