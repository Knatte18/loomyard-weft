+		h := newPassHarness(t, runningRun("task"))
+		failing := PassExit{Code: 1, Error: "pre-run refused"}
+		h.fake.exits = []PassExit{failing, failing, failing, failing, failing}
+		for range 3 {
+			h.tick(true)
+		}
+		if len(h.fake.notices) != 0 {
+			t.Fatalf("notices after two failures = %d; want 0", len(h.fake.notices))
+		}
+		h.tick(true)
+		if len(h.fake.notices) != 1 || !strings.Contains(h.fake.notices[0], "task: batten pass keeps failing: pre-run refused; way forward:") {
+			t.Fatalf("notices after three failures = %q; want one naming the run and the text", h.fake.notices)
+		}
+		h.tick(true)
+		h.tick(true)
+		if len(h.fake.notices) != 1 {
+			t.Errorf("notices after a fourth failure = %d; want still 1", len(h.fake.notices))
+		}
+
+		h.fake.exits = nil
+		h.tick(true)
+		h.tick(true)
+		if rs := h.state(); rs.FailingPassCount != 0 || rs.FailingPassError != "" || len(rs.Noticed) != 0 {
+			t.Errorf("state after an exit 0 = %+v; want the count and the noticed texts cleared", rs)
+		}
+	})
+
+	t.Run("a run dropped from the listing is no longer passed", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("kept"), runningRun("dropped"))
+		h.d.owesAll = true
+		h.tick(true)
+		h.fake.runs = h.fake.runs[:1]
+		h.tick(true)
+		h.tick(true)
+		if got := len(h.fake.spawnsOf("dropped")); got != 1 {
+			t.Errorf("passes of the dropped run = %d; want only the one before it was dropped", got)
+		}
+		if record, _, err := ReadState(h.d.geom.StatePath); err != nil {
+			t.Fatalf("ReadState() = %v; want nil", err)
+		} else if _, found := record.Runs["dropped"]; found {
+			t.Errorf("state still holds the dropped run: %+v", record.Runs)
+		}
+	})
+
+	t.Run("a dobby whose runs are all halted is idle for the backoff and one with a passable run is busy", func(t *testing.T) {
+		t.Parallel()
+		halted := runningRun("task")
+		halted.State = "blocked"
+		idle := newPassHarness(t, halted)
+		idle.tick(true)
+		if idle.d.inFlight {
+			t.Errorf("inFlight = true with every run halted; want false")
+		}
+
+		busy := newPassHarness(t, runningRun("task"))
+		busy.fake.hold = true
+		busy.tick(true)
+		if !busy.d.inFlight {
+			t.Errorf("inFlight = false with a pass in flight; want true")
+		}
+	})
+
+	t.Run("a lift while a pass is in flight gives the run its pass once that pass exits", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.fake.hold = true
+		h.tick(true)
+		h.fake.runs[0].Covered = true
+		h.tick(false)
+		h.fake.runs[0].Covered = false
+		h.tick(false)
+		if got := len(h.fake.spawned); got != 1 {
+			t.Fatalf("passes with one in flight across a lift = %d; want 1", got)
+		}
+
+		h.fake.open["task"] <- PassExit{}
+		h.fake.hold = false
+		h.tick(false)
+		if got := len(h.fake.spawned); got != 2 {
+			t.Errorf("passes after the in-flight pass exited = %d; want the lift's pass, 2", got)
+		}
+		if got := h.fake.spawned[1]; got.continuePass {
+			t.Errorf("the lift's pass = %+v; want a full pass", got)
+		}
+	})
+
+	t.Run("a lift seen while the run is not running gives no pass once it runs again", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.tick(true)
+		h.fake.runs[0].Covered = true
+		h.tick(false)
+		h.fake.runs[0].Covered = false
+		h.fake.runs[0].State = "blocked"
+		h.tick(false)
+		h.fake.runs[0].State = runStateRunning
+		h.tick(true)
+		spawned := h.fake.spawnsOf("task")
+		if len(spawned) != 2 || !spawned[1].continuePass {
+			t.Errorf("passes = %+v; want a continue pass at the first probe tick and a continue pass after the run runs again", spawned)
+		}
+	})
+}
diff --git a/internal/dobbyengine/seam_enforcement_test.go b/internal/dobbyengine/seam_enforcement_test.go
new file mode 100644
index 000000000..bdd067ad9
--- /dev/null
+++ b/internal/dobbyengine/seam_enforcement_test.go
@@ -0,0 +1,55 @@
+//go:build tier0
+
+// seam_enforcement_test.go enforces this package's Told-Geometry Invariant membership: production code in internal/dobbyengine takes every absolute path it operates on from its caller, and imports neither internal/lyxcwd nor a CLI package.
+//
+// The allowlist is a membership list rather than a bare denylist, so it catches the excluded imports and anything else that would drag geometry resolution in.
+
+package dobbyengine
+
+import (
+	"go/parser"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/testkit/scankit"
+)
+
+// dobbyengineAllowedImports are the only non-stdlib import paths production code in this package may use.
+var dobbyengineAllowedImports = []string{
+	"github.com/Knatte18/loomyard/internal/boardengine",
+	"github.com/Knatte18/loomyard/internal/configengine",
+	"github.com/Knatte18/loomyard/internal/editdirective",
+	"github.com/Knatte18/loomyard/internal/lock",
+	"github.com/Knatte18/loomyard/internal/logger",
+	"github.com/Knatte18/loomyard/internal/parentdirective",
+	"github.com/Knatte18/loomyard/internal/pauserecord",
+	"github.com/Knatte18/loomyard/internal/proc",
+	"github.com/Knatte18/loomyard/internal/segmentcolor",
+	"github.com/Knatte18/loomyard/internal/shuttleengine",
+	"github.com/Knatte18/loomyard/internal/state",
+	"github.com/Knatte18/loomyard/internal/stencil",
+	"github.com/Knatte18/loomyard/internal/stencilstore",
+	"gopkg.in/yaml.v3",
+}
+
+// dobbyengineDeniedLyxcwdImport is the import path the Told-Geometry Invariant excludes, named so a violation is reported by name.
+const dobbyengineDeniedLyxcwdImport = "github.com/Knatte18/loomyard/internal/lyxcwd"
+
+// TestToldGeometryInvariant_AllowlistOnly verifies the import allowlist, and separately asserts that no production import is internal/lyxcwd or an internal CLI package.
+func TestToldGeometryInvariant_AllowlistOnly(t *testing.T) {
+	scankit.AssertImportAllowlistNoStale(t, "internal/dobbyengine", dobbyengineAllowedImports...)
+
+	var deniedFound []string
+	scanned := scankit.Walk(t, scankit.Options{Roots: []string{"internal/dobbyengine"}, Shallow: true}, func(f *scankit.File) {
+		for _, imp := range f.AST(t, parser.ImportsOnly).Imports {
+			path := strings.Trim(imp.Path.Value, `"`)
+			if path == dobbyengineDeniedLyxcwdImport || (strings.Contains(path, "/internal/") && strings.HasSuffix(path, "cli")) {
+				deniedFound = append(deniedFound, f.Rel+" imports "+path)
+			}
+		}
+	})
+	scankit.RequireFloor(t, scanned, 1, "dobbyengine denied-import scan")
+	if len(deniedFound) > 0 {
+		t.Errorf("Told-Geometry Invariant violated: %v", deniedFound)
+	}
+}
diff --git a/internal/dobbyengine/start.go b/internal/dobbyengine/start.go
new file mode 100644
index 000000000..a1027fe4b
--- /dev/null
+++ b/internal/dobbyengine/start.go
@@ -0,0 +1,212 @@
+// start.go starts the dobby of every worktree this machine owns: the claim of the prime's owner, the liveness read of a dobby's lock, and the detached spawn of one dobby process.
+
+package dobbyengine
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/proc"
+)
+
+const (
+	// LogFileName is the dobby log file in the marker directory, which a spawned dobby appends its output to.
+	LogFileName = "dobby.log"
+	// PrimeLabel is the worktree label a StartReport gives the prime's dobby.
+	PrimeLabel = "prime"
+	// OutcomeStarted is the outcome of a dobby EnsureLive spawned.
+	OutcomeStarted = "started"
+	// OutcomeLive is the outcome of a dobby that was live already.
+	OutcomeLive = "live"
+	// OutcomeRefused is the outcome of a dobby EnsureLive did not start, with the reason in the entry's detail.
+	OutcomeRefused = "refused"
+	// OutcomeFailed is the outcome of a dobby whose start failed, with the cause in the entry's detail.
+	OutcomeFailed = "failed"
+)
+
+// ErrSpawnUnderTest is returned by SpawnDetached in a test binary, where forking the running binary would re-run the test suite.
+var ErrSpawnUnderTest = errors.New("dobbyengine: dobby not spawned under test")
+
+// BeamPair is a local beam pair and the owner it reads as.
+type BeamPair struct {
+	// Slug is the beam's slug, the name of its worktree.
+	Slug string
+	// Owner is the machine the pair reads as owned by; empty means no other machine owns it.
+	Owner string
+}
+
+// StartDeps is every seam EnsureLive reads and writes through.
+type StartDeps struct {
+	// Machine returns this machine's name.
+	Machine func() (string, error)
+	// PrimeOwner returns the machine recorded as the prime's owner, empty when none is recorded.
+	PrimeOwner func() (string, error)
+	// ClaimPrime records machine as the prime's owner and returns the machine that owns it instead when that claim lost, empty otherwise.
+	ClaimPrime func(machine string) (lostTo string, err error)
+	// PrimeName is the prime worktree's directory name.
+	PrimeName string
+	// Beams lists the local beam pairs with the owner each reads as.
+	Beams func() ([]BeamPair, error)
+	// Geometry tells the paths of the dobby of the worktree named worktree.
+	Geometry func(worktree string) (Geometry, error)
+	// Live reports whether the dobby described by geom is running.
+	Live func(geom Geometry) (bool, error)
+	// Spawn starts the dobby described by geom as a detached process.
+	Spawn func(geom Geometry) error
+}
+
+// StartEntry is the outcome of EnsureLive for one worktree.
+type StartEntry struct {
+	// Worktree is PrimeLabel for the prime, else the beam's slug.
+	Worktree string
+	// Outcome is one of the Outcome constants.
+	Outcome string
+	// Detail says why a dobby was refused or failed, and what to do next; empty for started and live.
+	Detail string
+}
+
+// StartReport is the outcome of one EnsureLive call, one entry per worktree it considered, the prime first.
+type StartReport struct {
+	Entries []StartEntry
+}
+
+// EnsureLive starts the dobby of the prime and of every local beam pair this machine owns, each only when it is not live already.
+// A prime with no recorded owner is claimed for this machine first; a claim that fails is reported for the prime with its cause and the `lyx beam start` re-run, the prime's dobby is not started, and the beams go on.
+// A prime another machine owns is reported with its owner and starts no prime dobby, and a beam another machine owns is left out of the report.
+// A failed spawn is reported for its worktree and the others still start; the returned error lists every failure.
+// A second call reports every dobby live and changes nothing.
+func EnsureLive(deps StartDeps) (StartReport, error) {
+	machine, err := deps.Machine()
+	if err != nil {
+		return StartReport{}, fmt.Errorf("dobbyengine: this machine's name is unknown: %w", err)
+	}
+	primeOwner, err := deps.PrimeOwner()
+	if err != nil {
+		return StartReport{}, fmt.Errorf("dobbyengine: read the prime owner: %w", err)
+	}
+	beams, err := deps.Beams()
+	if err != nil {
+		return StartReport{}, fmt.Errorf("dobbyengine: list the local beams: %w", err)
+	}
+
+	var report StartReport
+	var failures []error
+	// A start's failure joins the returned error; a prime claim that did not land is only reported, as a batten resume warns and goes on.
+	startOne := func(label, worktree string) {
+		entry := ensureOne(deps, label, worktree)
+		report.Entries = append(report.Entries, entry)
+		if entry.Outcome == OutcomeFailed {
+			failures = append(failures, fmt.Errorf("%s: %s", entry.Worktree, entry.Detail))
+		}
+	}
+
+	primeClaimFailed := false
+	if primeOwner == "" {
+		lostTo, claimErr := deps.ClaimPrime(machine)
+		switch {
+		case claimErr != nil:
+			primeClaimFailed = true
+			report.Entries = append(report.Entries, StartEntry{
+				Worktree: PrimeLabel,
+				Outcome:  OutcomeFailed,
+				Detail:   fmt.Sprintf("this machine was not recorded as the prime owner: %v; re-run `lyx beam start` once that works", claimErr),
+			})
+		case lostTo != "":
+			primeOwner = lostTo
+		default:
+			primeOwner = machine
+		}
+	}
+	switch {
+	case primeClaimFailed:
+	case primeOwner == machine:
+		startOne(PrimeLabel, deps.PrimeName)
+	default:
+		report.Entries = append(report.Entries, StartEntry{
+			Worktree: PrimeLabel,
+			Outcome:  OutcomeRefused,
+			Detail:   fmt.Sprintf("owned by %s; lyx adopt --prime takes it over here", primeOwner),
+		})
+	}
+
+	for _, beam := range beams {
+		if beam.Owner != "" && beam.Owner != machine {
+			continue
+		}
+		startOne(beam.Slug, beam.Slug)
+	}
+	return report, errors.Join(failures...)
+}
+
+// ensureOne starts the dobby of the worktree named worktree unless it is live, and reports it under label.
+func ensureOne(deps StartDeps, label, worktree string) StartEntry {
+	geom, err := deps.Geometry(worktree)
+	if err != nil {
+		return StartEntry{Worktree: label, Outcome: OutcomeFailed, Detail: err.Error()}
+	}
+	live, err := deps.Live(geom)
+	if err != nil {
+		return StartEntry{Worktree: label, Outcome: OutcomeFailed, Detail: fmt.Sprintf("read whether the dobby is live: %v", err)}
+	}
+	if live {
+		return StartEntry{Worktree: label, Outcome: OutcomeLive}
+	}
+	if err := deps.Spawn(geom); err != nil {
+		return StartEntry{Worktree: label, Outcome: OutcomeFailed, Detail: fmt.Sprintf("start the dobby: %v", err)}
+	}
+	return StartEntry{Worktree: label, Outcome: OutcomeStarted}
+}
+
+// Live reports whether the dobby of geom is running: its lock is held.
+// The lock is tried without blocking and released at once when it was free, so a free lock reads not live.
+// A worktree whose marker directory does not exist yet has never run a dobby.
+func Live(geom Geometry) (bool, error) {
+	if _, err := os.Stat(filepath.Dir(geom.LockPath)); errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(geom.LockPath)
+	if err != nil {
+		return false, err
+	}
+	if !acquired {
+		return true, nil
+	}
+	return false, held.Release()
+}
+
+// SpawnDetached starts `<lyx> beam dobby <worktree root>` for geom as a detached process with the hub root as its working directory.
+// The child's output is appended to the marker directory's log, and the child is started but never waited for.
+// It returns ErrSpawnUnderTest, starting nothing, in a test binary.
+func SpawnDetached(geom Geometry) error {
+	if testing.Testing() {
+		return ErrSpawnUnderTest
+	}
+	if err := os.MkdirAll(geom.MarkerDir, 0o755); err != nil {
+		return err
+	}
+	logPath := filepath.Join(geom.MarkerDir, LogFileName)
+	logFile, err := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return err
+	}
+	defer logFile.Close()
+
+	args := []string{"beam", "dobby", geom.WorktreeRoot}
+	cmd := exec.Command(geom.LyxExecutable, args...)
+	cmd.Dir = geom.HubRoot
+	cmd.Stdout = logFile
+	cmd.Stderr = logFile
+	proc.Detach(cmd)
+	if err := cmd.Start(); err != nil {
+		logger.Warn("dobbyengine: spawn dobby failed", "exe", geom.LyxExecutable, "args", args, "dir", geom.HubRoot, "error", err)
+		return err
+	}
+	logger.Info("dobbyengine: spawned dobby", "exe", geom.LyxExecutable, "args", args, "dir", geom.HubRoot, "pid", cmd.Process.Pid, "log", logPath)
+	return nil
+}
diff --git a/internal/dobbyengine/start_test.go b/internal/dobbyengine/start_test.go
new file mode 100644
index 000000000..a3dfeb1ed
--- /dev/null
+++ b/internal/dobbyengine/start_test.go
@@ -0,0 +1,207 @@
+//go:build tier0
+
+// start_test.go covers EnsureLive over fake seams and Live over a real lock file in a temp directory.
+
+package dobbyengine
+
+import (
+	"errors"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// fakeStart is an in-memory stand-in for the hub: it serves the owners it holds, records the claims and spawns, and reads a spawned worktree as live afterwards.
+type fakeStart struct {
+	primeOwner string
+	claimErr   error
+	claimLost  string
+	beams      []BeamPair
+	failSpawn  map[string]bool
+
+	claims  []string
+	spawned []string
+	live    map[string]bool
+}
+
+func (f *fakeStart) deps() StartDeps {
+	f.live = map[string]bool{}
+	return StartDeps{
+		Machine:    func() (string, error) { return "here", nil },
+		PrimeOwner: func() (string, error) { return f.primeOwner, nil },
+		ClaimPrime: func(machine string) (string, error) {
+			f.claims = append(f.claims, machine)
+			if f.claimErr == nil && f.claimLost == "" {
+				f.primeOwner = machine
+			}
+			return f.claimLost, f.claimErr
+		},
+		PrimeName: "hub-prime",
+		Beams:     func() ([]BeamPair, error) { return f.beams, nil },
+		Geometry:  func(worktree string) (Geometry, error) { return Geometry{WorktreeName: worktree}, nil },
+		Live:      func(geom Geometry) (bool, error) { return f.live[geom.WorktreeName], nil },
+		Spawn: func(geom Geometry) error {
+			if f.failSpawn[geom.WorktreeName] {
+				return errors.New("exec failed")
+			}
+			f.spawned = append(f.spawned, geom.WorktreeName)
+			f.live[geom.WorktreeName] = true
+			return nil
+		},
+	}
+}
+
+func TestEnsureLive(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		fake        fakeStart
+		calls       int
+		wantEntries []StartEntry
+		wantClaims  []string
+		wantSpawned []string
+		// wantErr is a text the returned error carries; empty wants none.
+		wantErr string
+		// wantDetails are the texts the prime's entry detail carries.
+		wantDetails []string
+	}{
+		{
+			name:        "NoPrimeOwnerRecordsThisMachineAndStartsThePrimeAndAnOwnedBeam",
+			fake:        fakeStart{beams: []BeamPair{{Slug: "b1"}}},
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeStarted}, {Worktree: "b1", Outcome: OutcomeStarted}},
+			wantClaims:  []string{"here"},
+			wantSpawned: []string{"hub-prime", "b1"},
+		},
+		{
+			name:        "FailedPrimeClaimIsReportedAndStartsNoPrimeButTheBeam",
+			fake:        fakeStart{claimErr: errors.New("origin unreachable"), beams: []BeamPair{{Slug: "b1", Owner: "here"}}},
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeFailed}, {Worktree: "b1", Outcome: OutcomeStarted}},
+			wantClaims:  []string{"here"},
+			wantSpawned: []string{"b1"},
+			wantDetails: []string{"origin unreachable", "lyx beam start"},
+		},
+		{
+			name:        "ASecondCallReportsEveryDobbyLiveAndSpawnsNothing",
+			fake:        fakeStart{primeOwner: "here", beams: []BeamPair{{Slug: "b1"}}},
+			calls:       2,
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeLive}, {Worktree: "b1", Outcome: OutcomeLive}},
+			wantSpawned: []string{"hub-prime", "b1"},
+		},
+		{
+			name:        "APrimeAnotherMachineOwnsStartsNoPrimeAndNamesItsOwner",
+			fake:        fakeStart{primeOwner: "there", beams: []BeamPair{{Slug: "b1", Owner: "here"}}},
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeRefused}, {Worktree: "b1", Outcome: OutcomeStarted}},
+			wantSpawned: []string{"b1"},
+			wantDetails: []string{"owned by there; lyx adopt --prime takes it over here"},
+		},
+		{
+			name:        "ALostPrimeClaimReadsTheOtherMachinesClaim",
+			fake:        fakeStart{claimLost: "there"},
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeRefused}},
+			wantClaims:  []string{"here"},
+			wantDetails: []string{"owned by there"},
+		},
+		{
+			name:        "ABeamOwnedElsewhereIsSkipped",
+			fake:        fakeStart{primeOwner: "here", beams: []BeamPair{{Slug: "b1", Owner: "there"}, {Slug: "b2", Owner: "here"}}},
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeStarted}, {Worktree: "b2", Outcome: OutcomeStarted}},
+			wantSpawned: []string{"hub-prime", "b2"},
+		},
+		{
+			name:        "OneFailedSpawnStillStartsTheRestAndNamesItInTheError",
+			fake:        fakeStart{primeOwner: "here", beams: []BeamPair{{Slug: "b1"}, {Slug: "b2"}}, failSpawn: map[string]bool{"b1": true}},
+			wantEntries: []StartEntry{{Worktree: PrimeLabel, Outcome: OutcomeStarted}, {Worktree: "b1", Outcome: OutcomeFailed}, {Worktree: "b2", Outcome: OutcomeStarted}},
+			wantSpawned: []string{"hub-prime", "b2"},
+			wantErr:     "b1: start the dobby: exec failed",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			fake := tt.fake
+			deps := fake.deps()
+			calls := max(tt.calls, 1)
+			var report StartReport
+			var err error
+			for range calls {
+				report, err = EnsureLive(deps)
+			}
+
+			if tt.wantErr == "" && err != nil {
+				t.Fatalf("EnsureLive() error = %v; want nil", err)
+			}
+			if tt.wantErr != "" && (err == nil || !strings.Contains(err.Error(), tt.wantErr)) {
+				t.Fatalf("EnsureLive() error = %v; want it to carry %q", err, tt.wantErr)
+			}
+			if len(report.Entries) != len(tt.wantEntries) {
+				t.Fatalf("EnsureLive() entries = %+v; want %d entries %+v", report.Entries, len(tt.wantEntries), tt.wantEntries)
+			}
+			for i, want := range tt.wantEntries {
+				got := report.Entries[i]
+				if got.Worktree != want.Worktree || got.Outcome != want.Outcome {
+					t.Errorf("EnsureLive() entry %d = %s %s; want %s %s", i, got.Worktree, got.Outcome, want.Worktree, want.Outcome)
+				}
+			}
+			for _, want := range tt.wantDetails {
+				if !strings.Contains(report.Entries[0].Detail, want) {
+					t.Errorf("EnsureLive() prime detail = %q; want it to carry %q", report.Entries[0].Detail, want)
+				}
+			}
+			if !slices.Equal(fake.claims, tt.wantClaims) {
+				t.Errorf("EnsureLive() claims = %v; want %v", fake.claims, tt.wantClaims)
+			}
+			if !slices.Equal(fake.spawned, tt.wantSpawned) {
+				t.Errorf("EnsureLive() spawned = %v; want %v", fake.spawned, tt.wantSpawned)
+			}
+		})
+	}
+}
+
+// TestLive asserts a dobby reads live exactly while its lock is held, and a worktree with no marker directory reads not live.
+func TestLive(t *testing.T) {
+	t.Parallel()
+
+	t.Run("NoMarkerDirectoryReadsNotLive", func(t *testing.T) {
+		t.Parallel()
+
+		geom := Geometry{LockPath: filepath.Join(t.TempDir(), "beam", "dobby.lock")}
+		if live, err := Live(geom); live || err != nil {
+			t.Errorf("Live() = (%v, %v); want (false, nil)", live, err)
+		}
+	})
+
+	t.Run("AFreeLockReadsNotLiveAndStaysFree", func(t *testing.T) {
+		t.Parallel()
+
+		geom := Geometry{LockPath: filepath.Join(t.TempDir(), "dobby.lock")}
+		if live, err := Live(geom); live || err != nil {
+			t.Fatalf("Live() = (%v, %v); want (false, nil)", live, err)
+		}
+		held, acquired, err := lock.TryAcquireWriteLock(geom.LockPath)
+		if err != nil || !acquired {
+			t.Fatalf("TryAcquireWriteLock() = (%v, %v); want the lock free after Live", acquired, err)
+		}
+		if err := held.Release(); err != nil {
+			t.Fatalf("Release() = %v; want nil", err)
+		}
+	})
+
+	t.Run("AHeldLockReadsLive", func(t *testing.T) {
+		t.Parallel()
+
+		geom := Geometry{LockPath: filepath.Join(t.TempDir(), "dobby.lock")}
+		held, acquired, err := lock.TryAcquireWriteLock(geom.LockPath)
+		if err != nil || !acquired {
+			t.Fatalf("TryAcquireWriteLock() = (%v, %v); want the lock", acquired, err)
+		}
+		t.Cleanup(func() { _ = held.Release() })
+		if live, err := Live(geom); !live || err != nil {
+			t.Errorf("Live() = (%v, %v); want (true, nil)", live, err)
+		}
+	})
+}
diff --git a/internal/dobbyengine/starts.go b/internal/dobbyengine/starts.go
new file mode 100644
index 000000000..0ce28af17
--- /dev/null
+++ b/internal/dobbyengine/starts.go
@@ -0,0 +1,214 @@
+// starts.go starts the beam's ready tasks from the board: the start condition, the cap on runs in flight, and the notice and backoff of a refused first pass.
+
+package dobbyengine
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// startBackoffCeiling is the longest wait between two attempts to start a refused task.
+const startBackoffCeiling = time.Hour
+
+// TaskView is what dobby reads of one board entry.
+type TaskView struct {
+	// Slug and Kind identify the entry; only a task starts.
+	Slug string
+	Kind string
+	// Status is the entry's status, nil or empty when the task is released and not yet started, and draft until then.
+	Status *string
+	// DependenciesDone reports whether every entry the task depends on is done.
+	DependenciesDone bool
+	// Parent is the name of the task's parent worktree, the prime's name for the prime.
+	Parent string
+	// OwnedElsewhere reports whether the entry's effective owner is another machine.
+	OwnedElsewhere bool
+	// Fingerprint changes whenever the entry does.
+	Fingerprint string
+}
+
+// readyToStart reports whether dobby of the worktree named here starts task:
+// the entry is a task with an empty status and every dependency done, its parent is here, no other machine owns it, and no pause entry covers the hub or the slug.
+func readyToStart(task TaskView, here string, covered bool) bool {
+	return task.Kind == boardengine.KindTask &&
+		boardengine.IsEmptyStatus(task.Status) &&
+		task.DependenciesDone &&
+		task.Parent == here &&
+		!task.OwnedElsewhere &&
+		!covered
+}
+
+// startReady starts each ready task of the local board while fewer than max_runs runs it drives are in flight.
+// Starting is the run's first pass, a full pass, which claims the task as batten does; a slug with a pass in flight is never started twice.
+// The runs counted are the ones listed for this tick, halted ones included and ones recorded owned elsewhere not, plus first passes that have not yet left a status file.
+// A task whose backoff has not run out waits, unless its entry changed since the refusal.
+func (d *daemon) startReady(ctx context.Context, now time.Time) error {
+	cfg, err := d.deps.LoadConfig()
+	if err != nil {
+		return fmt.Errorf("load beam.yaml: %w", err)
+	}
+	if cfg.MaxRuns == 0 {
+		return nil
+	}
+	tasks, err := d.deps.Tasks()
+	if err != nil {
+		return fmt.Errorf("read the board: %w", err)
+	}
+	current, _, err := ReadState(d.geom.StatePath)
+	if err != nil {
+		return err
+	}
+	running := d.runsInFlight(current)
+
+	for _, task := range tasks {
+		if running >= cfg.MaxRuns {
+			break
+		}
+		if _, flying := d.flights[task.Slug]; flying {
+			continue
+		}
+		covered, err := d.deps.PauseCovers(task.Slug)
+		if err != nil {
+			return fmt.Errorf("read the pause record: %w", err)
+		}
+		if !readyToStart(task, d.geom.WorktreeName, covered) {
+			continue
+		}
+		attempt := current.Starts[task.Slug]
+		if attempt.EntryFingerprint != "" && attempt.EntryFingerprint != task.Fingerprint {
+			attempt = StartState{}
+			if err := d.updateStart(task.Slug, func(s *StartState) { *s = StartState{} }); err != nil {
+				return err
+			}
+		}
+		if now.Before(attempt.NextTry) {
+			continue
+		}
+		running++
+		d.startFirstPass(task, now)
+	}
+	if len(d.flights) > 0 {
+		d.busy = true
+	}
+	return nil
+}
+
+// runsInFlight counts the runs this dobby drives that take a slot: the listed ones not recorded owned elsewhere, and first passes that left no run yet.
+func (d *daemon) runsInFlight(current State) int {
+	listed := make(map[string]bool, len(d.runs))
+	count := 0
+	for _, run := range d.runs {
+		listed[run.Slug] = true
+		if !current.Runs[run.Slug].OwnedElsewhere {
+			count++
+		}
+	}
+	for slug, f := range d.flights {
+		if f.first && !listed[slug] {
+			count++
+		}
+	}
+	return count
+}
+
+// startFirstPass spawns the first pass of task, a full pass, and keeps it as a flight.
+// A spawn that fails is a refused start with the spawn error as its text.
+func (d *daemon) startFirstPass(task TaskView, now time.Time) {
+	exit, err := d.deps.SpawnPass(task.Slug, false, false)
+	if err != nil {
+		d.refusedStart(task.Slug, task.Fingerprint, err.Error(), now)
+		return
+	}
+	d.flights[task.Slug] = flight{exit: exit, full: true, first: true, fingerprint: task.Fingerprint}
+}
+
+// firstPassExited reads how a first pass exited.
+// A pass that left a status file claimed the task, so its backoff and noticed texts are cleared and the exit is read as any pass's.
+// A covered pass is no refusal, and any other exit that left no status file is a refused start.
+func (d *daemon) firstPassExited(slug string, f flight, exit PassExit, now time.Time) {
+	claimed, err := d.deps.StatusExists(slug)
+	if err != nil {
+		logger.Warn("dobbyengine: whether the first pass left a status file is unreadable; the exit is read as a pass's", "slug", slug, "error", err)
+		claimed = true
+	}
+	switch {
+	case claimed:
+		if err := d.updateStart(slug, func(s *StartState) { *s = StartState{} }); err != nil {
+			logger.Warn("dobbyengine: the start record could not be cleared", "slug", slug, "error", err)
+		}
+		d.passExited(slug, f.full, exit.Code, exit.Error, now)
+	case exit.Code == PassExitCovered:
+	case exit.Code == 0:
+		if err := d.updateStart(slug, func(s *StartState) { *s = StartState{} }); err != nil {
+			logger.Warn("dobbyengine: the start record could not be cleared", "slug", slug, "error", err)
+		}
+	default:
+		text := exit.Error
+		if text == "" {
+			text = fmt.Sprintf("the pass exited %d", exit.Code)
+		}
+		d.refusedStart(slug, f.fingerprint, text, now)
+	}
+}
+
+// refusedStart records a refused start of slug: the retry backoff, and one notice per refusal text to the nearest live orch.
+func (d *daemon) refusedStart(slug, fingerprint, text string, now time.Time) {
+	noticeDue := false
+	err := d.updateStart(slug, func(s *StartState) {
+		if s.EntryFingerprint != fingerprint {
+			*s = StartState{}
+		}
+		*s = nextStartTry(*s, now, d.probe)
+		s.EntryFingerprint = fingerprint
+		noticeDue = !slices.Contains(s.Noticed, text)
+	})
+	if err != nil {
+		logger.Warn("dobbyengine: the refused start could not be recorded", "slug", slug, "error", err)
+		return
+	}
+	if !noticeDue {
+		return
+	}
+	if err := d.deps.Notice(d.tickCtx, fmt.Sprintf("%s: dobby could not start the task: %s", slug, text)); err != nil {
+		logger.Warn("dobbyengine: the refused-start notice did not go out", "slug", slug, "error", err)
+		return
+	}
+	err = d.updateStart(slug, func(s *StartState) { s.Noticed = append(s.Noticed, text) })
+	if err != nil {
+		logger.Warn("dobbyengine: the noticed refusal text could not be recorded", "slug", slug, "error", err)
+	}
+}
+
+// nextStartTry returns st with the next attempt scheduled from now: one probe interval after the first refusal, then doubling up to an hour.
+func nextStartTry(st StartState, now time.Time, probe time.Duration) StartState {
+	interval := probe
+	if st.Interval > 0 {
+		interval = min(st.Interval*2, startBackoffCeiling)
+	}
+	st.Interval = interval
+	st.NextTry = now.Add(interval)
+	return st
+}
+
+// updateStart applies mutate to slug's start record, and removes the record once it is empty.
+func (d *daemon) updateStart(slug string, mutate func(*StartState)) error {
+	return UpdateState(d.geom.StatePath, func(s *State) error {
+		st := s.Starts[slug]
+		mutate(&st)
+		switch {
+		case st.NextTry.IsZero() && st.Interval == 0 && len(st.Noticed) == 0 && st.EntryFingerprint == "":
+			delete(s.Starts, slug)
+		default:
+			if s.Starts == nil {
+				s.Starts = map[string]StartState{}
+			}
+			s.Starts[slug] = st
+		}
+		return nil
+	})
+}
diff --git a/internal/dobbyengine/starts_test.go b/internal/dobbyengine/starts_test.go
