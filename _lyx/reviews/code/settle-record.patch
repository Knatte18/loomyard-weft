+	if isPair {
+		parent, err := hubgeom.ResolveParent(site)
+		if err != nil {
+			return false, err
+		}
+		start = prime
+		if parent.Worktree != "" {
+			location, found, err := presentWorktree(prime, parent.Worktree)
+			if err != nil {
+				return false, err
+			}
+			if found {
+				start = location
+			}
+		}
+	}
+	destination, err := hubgeom.NearestLiveOrch(start, orchcli.OrchLive)
+	if err != nil {
+		return false, err
+	}
+	return destination.Worktree == "", nil
