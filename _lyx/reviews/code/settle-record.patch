-entry: Beam-Describe
-terminals:
-  - Finalize
-
-producers:
-  - name: Beam-Describe
-    engine: BeamDescribe
-    on_done: Finalize
-
-  # Finalize's empty on_done is load-bearing and is what ends the run quietly.
-  - name: Finalize
-    engine: Finalize
-    on_done: ""
diff --git a/contracts/recipes/pawl-recipe.yaml b/contracts/recipes/pawl-recipe.yaml
