+
+// replaceRecordsContent replaces the tracked content of the records worktree at weftPath with the tree of parentTip, leaving out the run-records root, and removes the tracked files that tree lacks.
+// It stages the replacement in the index and writes it to disk, and commits nothing.
+func replaceRecordsContent(l *lyxcwd.Location, weftPath, parentTip string) error {
+	before, err := trackedPaths(weftPath)
+	if err != nil {
+		return err
+	}
+	if _, err := gitexec.Run([]string{"read-tree", parentTip}, weftPath); err != nil {
+		return fmt.Errorf("stage the parent's records in %q: %w", weftPath, err)
+	}
+	runsRoot := filepath.ToSlash(ScopedPathspec(l.AnchorRel, []string{shedrun.RunsRootRel()})[0])
+	runsTracked, err := PathTracked(weftPath, runsRoot)
+	if err != nil {
+		return err
+	}
+	if runsTracked {
+		if _, err := gitexec.Run([]string{"rm", "-r", "--cached", "-q", "--", runsRoot}, weftPath); err != nil {
+			return fmt.Errorf("drop run records from the index of %q: %w", weftPath, err)
+		}
+	}
+	if _, err := gitexec.Run([]string{"checkout-index", "-a", "-f"}, weftPath); err != nil {
+		return fmt.Errorf("write the parent's records to %q: %w", weftPath, err)
+	}
+	after, err := trackedPaths(weftPath)
+	if err != nil {
+		return err
+	}
+	for path := range before {
+		if after[path] {
+			continue
+		}
+		target := filepath.Join(weftPath, filepath.FromSlash(path))
+		if _, _, err := removeContainedPath(weftPath, target, false); err != nil {
+			return fmt.Errorf("remove %s, which the parent's records lack: %w", target, err)
+		}
+		// A directory the removal emptied goes too; a non-empty one stops the walk.
+		for dir := filepath.Dir(target); dir != filepath.Clean(weftPath); dir = filepath.Dir(dir) {
+			if removed, _, err := removeContainedPath(weftPath, dir, false); err != nil || !removed {
+				break
+			}
+		}
+	}
+	return nil
+}
+
+// trackedPaths returns the set of paths the index of the checkout at dir tracks, slash-separated.
+func trackedPaths(dir string) (map[string]bool, error) {
+	stdout, err := gitexec.Run([]string{"ls-files", "-z"}, dir)
+	if err != nil {
+		return nil, fmt.Errorf("list the tracked files of %q: %w", dir, err)
+	}
+	paths := map[string]bool{}
+	for _, path := range strings.Split(stdout, "\x00") {
+		if path != "" {
+			paths[path] = true
+		}
+	}
+	return paths, nil
+}
