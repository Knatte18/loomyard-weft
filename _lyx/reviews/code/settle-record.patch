+//go:build tier0
+
+// promote_test.go pins the two entry points of "lyx beam promote" over the cancel's fake substrates: the end of the run with its marker removed, the end-only stop, and the clear of the records and the claim.
+
+package battencli
+
+import (
+	"context"
