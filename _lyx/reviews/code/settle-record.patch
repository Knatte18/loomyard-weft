new file mode 100644
index 00000000..2138eaf6
--- /dev/null
+++ b/internal/pawlengine/beamup.go
@@ -0,0 +1,66 @@
+// beamup.go implements BeamUp, the pawl recipe's Beam-Up row: the Go producer that brings a beam's pair up as a beam, with no agent.
+
+package pawlengine
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// NameBeamUp is the pawl recipe's Beam-Up row name.
+const NameBeamUp = "Beam-Up"
+
+// BeamUp is the Beam-Up producer.
+type BeamUp struct {
+	name string
+	deps Deps
+}
+
+var _ shedengine.ShedProducer = (*BeamUp)(nil)
+
+// NewBeamUp returns the Beam-Up producer for the row called name.
+// It refuses a Deps with an unset seam it uses, or a step with no name or no function.
+func NewBeamUp(name string, deps Deps) (*BeamUp, error) {
+	seams := append(deps.pathsSeams(),
+		seam{"MarkBeam", deps.MarkBeam != nil},
+		seam{"SpawnPush", deps.SpawnPush != nil},
+		seam{"RegenerateWorkspace", deps.RegenerateWorkspace != nil},
+	)
+	for i, step := range deps.Steps {
+		seams = append(seams, seam{fmt.Sprintf("Steps[%d]", i), step.Name != "" && step.Run != nil})
+	}
+	if err := requireSeams(name, seams...); err != nil {
+		return nil, err
+	}
+	return &BeamUp{name: name, deps: deps}, nil
+}
+
+// Call marks the pair a beam, spawns its push, regenerates the hub workspace, removes a land request and the await marker a run before left, and runs the beam steps in order.
+// Every step is idempotent, so a resumed row runs them all again.
+// A failing step is a halting Stuck naming its cause and `lyx loom resume`; a cancelled context is an error.
+func (p *BeamUp) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if err := entryErr(ctx, p.name); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	steps := append([]Step{
+		{"mark the pair a beam", p.deps.MarkBeam},
+		{"spawn the beam's push", p.deps.SpawnPush},
+		{"regenerate the hub workspace", p.deps.RegenerateWorkspace},
+		{"remove a land request an earlier run left", func() error { return RemoveLandRequest(p.deps.Paths) }},
+		{"remove the await marker an earlier run left", func() error { return removeFile(p.deps.Paths.AwaitMarker) }},
+	}, p.deps.Steps...)
+	for _, step := range steps {
+		if err := step.Run(); err != nil {
+			if cerr := cancelErr(ctx, p.name); cerr != nil {
+				return "", shedengine.OutputPointer{}, cerr
+			}
+			reason := fmt.Sprintf("%s: %s: %v; way forward: fix the cause, then run \"lyx loom resume\" in the beam's worktree", p.name, step.Name, err)
+			logger.Warn("pawlengine: producer stuck", "producer", p.name, "reason", reason)
+			return shedengine.Stuck, shedengine.OutputPointer{Reason: reason, Halt: true}, nil
+		}
+	}
+	return shedengine.Done, shedengine.OutputPointer{}, nil
+}
diff --git a/internal/pawlengine/beamup_test.go b/internal/pawlengine/beamup_test.go
new file mode 100644
index 00000000..c582f938
--- /dev/null
+++ b/internal/pawlengine/beamup_test.go
@@ -0,0 +1,212 @@
+//go:build tier0
+
+// beamup_test.go covers the Beam-Up and Beam-Down rows and the constructors' refusal of an unset seam.
+
+package pawlengine_test
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/Knatte18/loomyard/internal/pawlengine"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// beamUpDeps returns the world's deps with two beam steps that log their calls.
+func beamUpDeps(w *world, stepErr error) pawlengine.Deps {
+	deps := w.deps()
+	deps.Steps = []pawlengine.Step{
+		{Name: "start the dobby", Run: func() error { w.record("step:dobby"); return stepErr }},
+		{Name: "start the orch", Run: func() error { w.record("step:orch"); return nil }},
+	}
+	return deps
+}
+
+// TestBeamUp asserts a fresh pair runs every step in order and clears what an earlier run left, and that a failing step halts the row naming its cause and `lyx loom resume`.
+func TestBeamUp(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name       string
+		tweak      func(w *world)
+		stepErr    error
+		wantStuck  bool
+		wantEvents []string
+		wantReason []string
+	}{
+		{
+			name:       "FreshPairRunsEveryStepInOrder",
+			wantEvents: []string{"mark", "push", "workspace", "step:dobby", "step:orch"},
+		},
+		{
+			name:       "FailingMarkHaltsBeforeAnyLaterStep",
+			tweak:      func(w *world) { w.markErr = errors.New("origin refused") },
+			wantStuck:  true,
+			wantEvents: []string{"mark"},
+			wantReason: []string{"origin refused", "lyx loom resume"},
+		},
+		{
+			name:       "FailingPushSpawnHaltsBeforeTheWorkspace",
+			tweak:      func(w *world) { w.pushErr = errors.New("no spawn") },
+			wantStuck:  true,
+			wantEvents: []string{"mark", "push"},
+			wantReason: []string{"no spawn", "lyx loom resume"},
+		},
+		{
+			name:       "FailingWorkspaceHalts",
+			tweak:      func(w *world) { w.workspaceErr = errors.New("workspace unwritable") },
+			wantStuck:  true,
+			wantEvents: []string{"mark", "push", "workspace"},
+			wantReason: []string{"workspace unwritable", "lyx loom resume"},
+		},
+		{
+			name:       "FailingStepHaltsBeforeTheNextStep",
+			stepErr:    errors.New("dobby will not start"),
+			wantStuck:  true,
+			wantEvents: []string{"mark", "push", "workspace", "step:dobby"},
+			wantReason: []string{"start the dobby", "dobby will not start", "lyx loom resume"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newWorld(t)
+			w.request(t, "an-earlier-run")
+			touch(t, w.paths.AwaitMarker)
+			if tt.tweak != nil {
+				tt.tweak(w)
+			}
+			producer, err := pawlengine.NewBeamUp(pawlengine.NameBeamUp, beamUpDeps(w, tt.stepErr))
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			outcome, output, err := producer.Call(context.Background())
+			if err != nil {
+				t.Fatalf("Call() error = %v", err)
+			}
+			if diff := cmp.Diff(tt.wantEvents, w.snapshotEvents()); diff != "" {
+				t.Errorf("events mismatch (-want +got):\n%s", diff)
+			}
+			if !tt.wantStuck {
+				if outcome != shedengine.Done {
+					t.Errorf("Call() outcome = %q; want %q", outcome, shedengine.Done)
+				}
+				if exists(w.paths.LandRequest) || exists(w.paths.AwaitMarker) {
+					t.Errorf("a land request or await marker of an earlier run still stands")
+				}
+				return
+			}
+			if outcome != shedengine.Stuck || !output.Halt {
+				t.Errorf("Call() = %q halt %t; want a halting %q", outcome, output.Halt, shedengine.Stuck)
+			}
+			for _, part := range tt.wantReason {
+				if !strings.Contains(output.Reason, part) {
+					t.Errorf("reason = %q; want it to contain %q", output.Reason, part)
+				}
+			}
+		})
+	}
+}
+
+// TestBeamUp_RerunIsIdempotent asserts a second call over the same beam, as a resume makes, runs every step again and is Done.
+func TestBeamUp_RerunIsIdempotent(t *testing.T) {
+	t.Parallel()
+	w := newWorld(t)
+	producer, err := pawlengine.NewBeamUp(pawlengine.NameBeamUp, beamUpDeps(w, nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for call := 1; call <= 2; call++ {
+		if outcome, _, err := producer.Call(context.Background()); err != nil || outcome != shedengine.Done {
+			t.Fatalf("call %d = %q, error %v; want Done", call, outcome, err)
+		}
+	}
+	if got := len(w.snapshotEvents()); got != 10 {
+		t.Errorf("recorded %d events over two calls; want every step twice", got)
+	}
+}
+
+// TestBeamDown asserts a stop is called once and the row is Done, also when the stop fails.
+func TestBeamDown(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		downErr error
+	}{
+		{"StopSucceeds", nil},
+		{"FailingStopIsStillDone", errors.New("strand already gone")},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newWorld(t)
+			deps := w.deps()
+			deps.Down = func() error { w.record("down"); return tt.downErr }
+			producer, err := pawlengine.NewBeamDown(pawlengine.NameBeamDown, deps)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			outcome, _, err := producer.Call(context.Background())
+			if err != nil || outcome != shedengine.Done {
+				t.Errorf("Call() = %q, error %v; want Done", outcome, err)
+			}
+			if diff := cmp.Diff([]string{"down"}, w.snapshotEvents()); diff != "" {
+				t.Errorf("events mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+// TestNewProducers_RefuseAnUnsetSeam asserts each constructor refuses a Deps with a nil seam it uses, naming the field.
+func TestNewProducers_RefuseAnUnsetSeam(t *testing.T) {
+	t.Parallel()
+	build := map[string]func(pawlengine.Deps) error{
+		"BeamUp":    func(d pawlengine.Deps) error { _, err := pawlengine.NewBeamUp("Beam-Up", d); return err },
+		"BeamAwait": func(d pawlengine.Deps) error { _, err := pawlengine.NewBeamAwait("Beam-Await", d); return err },
+		"BeamDown":  func(d pawlengine.Deps) error { _, err := pawlengine.NewBeamDown("Beam-Down", d); return err },
+	}
+	tests := []struct {
+		producer string
+		field    string
+		unset    func(d *pawlengine.Deps)
+	}{
+		{"BeamUp", "MarkBeam", func(d *pawlengine.Deps) { d.MarkBeam = nil }},
+		{"BeamUp", "SpawnPush", func(d *pawlengine.Deps) { d.SpawnPush = nil }},
+		{"BeamUp", "RegenerateWorkspace", func(d *pawlengine.Deps) { d.RegenerateWorkspace = nil }},
+		{"BeamUp", "Steps[0]", func(d *pawlengine.Deps) { d.Steps = []pawlengine.Step{{Name: "a step with no function"}} }},
+		{"BeamUp", "Paths.LandRequest", func(d *pawlengine.Deps) { d.Paths.LandRequest = "" }},
+		{"BeamAwait", "SetStatus", func(d *pawlengine.Deps) { d.SetStatus = nil }},
+		{"BeamAwait", "EntryProducer", func(d *pawlengine.Deps) { d.EntryProducer = nil }},
+		{"BeamAwait", "OwnedElsewhere", func(d *pawlengine.Deps) { d.OwnedElsewhere = nil }},
+		{"BeamAwait", "StopDobby", func(d *pawlengine.Deps) { d.StopDobby = nil }},
+		{"BeamAwait", "StartDobby", func(d *pawlengine.Deps) { d.StartDobby = nil }},
+		{"BeamAwait", "DobbyLive", func(d *pawlengine.Deps) { d.DobbyLive = nil }},
+		{"BeamAwait", "Recheck", func(d *pawlengine.Deps) { d.Recheck = nil }},
+		{"BeamAwait", "WriteSnapshot", func(d *pawlengine.Deps) { d.WriteSnapshot = nil }},
+		{"BeamAwait", "Notify", func(d *pawlengine.Deps) { d.Notify = nil }},
+		{"BeamAwait", "Now", func(d *pawlengine.Deps) { d.Now = nil }},
+		{"BeamAwait", "Sleep", func(d *pawlengine.Deps) { d.Sleep = nil }},
+		{"BeamAwait", "Slug", func(d *pawlengine.Deps) { d.Slug = "" }},
+		{"BeamAwait", "RunID", func(d *pawlengine.Deps) { d.RunID = "" }},
+		{"BeamDown", "Down", func(d *pawlengine.Deps) { d.Down = nil }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.producer+"_"+tt.field, func(t *testing.T) {
+			t.Parallel()
+			deps := newWorld(t).deps()
+			if err := build[tt.producer](deps); err != nil {
+				t.Fatalf("constructor over complete deps = %v; want nil", err)
+			}
+			tt.unset(&deps)
+			err := build[tt.producer](deps)
+			if err == nil || !strings.Contains(err.Error(), "Deps."+tt.field) {
+				t.Errorf("constructor with %s unset = %v; want an error naming Deps.%s", tt.field, err, tt.field)
+			}
+		})
+	}
+}
diff --git a/internal/pawlengine/deps.go b/internal/pawlengine/deps.go
new file mode 100644
index 00000000..74f49b15
--- /dev/null
+++ b/internal/pawlengine/deps.go
@@ -0,0 +1,104 @@
+// deps.go declares Deps, the seams every pawl producer is told, the fail-loud check that each one a producer uses is set, and the context checks the producers share.
+
+package pawlengine
+
+import (
+	"context"
+	"fmt"
+	"time"
+)
+
+// Step is one named, idempotent step of Beam-Up.
+type Step struct {
+	// Name names the step in a failure.
+	Name string
+	// Run does the step.
+	Run func() error
+}
+
+// Deps carries every told value and seam of the pawl producers.
+// A producer refuses a nil seam it uses when it is built, naming the field; Watch alone may be nil.
+type Deps struct {
+	// Slug is the beam's slug, which names its landing and start in a notice.
+	Slug string
+	// Paths holds the run's land request, dobby-stop marker and await marker.
+	Paths Paths
+	// RunID is the pawl run's seed id, which a land request names.
+	RunID string
+	// SetStatus writes the beam project entry's run status naming producer as the row the run is at.
+	SetStatus func(producer string) error
+	// EntryProducer reads the producer the entry's run status names.
+	EntryProducer func() (string, error)
+	// OwnedElsewhere reports whether another machine owns the beam.
+	OwnedElsewhere func() (bool, error)
+	// MarkBeam marks the pair a beam; it is a no-op on a marked pair.
+	MarkBeam func() error
+	// SpawnPush starts the beam's push.
+	SpawnPush func() error
+	// RegenerateWorkspace regenerates the hub's workspace file.
+	RegenerateWorkspace func() error
+	// Steps are the beam steps Beam-Up runs, in order, with no config reconcile.
+	Steps []Step
+	// StopDobby stops the beam's dobby so it starts no new member.
+	StopDobby func() error
+	// StartDobby starts the beam's dobby again.
+	StartDobby func() error
+	// DobbyLive reports whether the beam's dobby runs.
+	DobbyLive func() (bool, error)
+	// Recheck returns the blockers the landing re-check finds, empty when it passes.
+	Recheck func() ([]string, error)
+	// WriteSnapshot writes the snapshot the perch compares against.
+	WriteSnapshot func() error
+	// Notify posts one line to the beam's own orch.
+	Notify func(line string) error
+	// Down takes the beam's dobby and orch down.
+	Down func() error
+	// Watch delivers a value whenever the land request's directory changes; nil leaves the timer alone.
+	Watch <-chan struct{}
+	// Now reads the clock.
+	Now func() time.Time
+	// Sleep waits d, returning the context's error when ctx ends first.
+	Sleep func(ctx context.Context, d time.Duration) error
+}
+
+// seam names one field of Deps a producer uses and whether it is set.
+type seam struct {
+	field string
+	set   bool
+}
+
+// requireSeams returns an error naming the first of seams that is unset, on behalf of producer.
+func requireSeams(producer string, seams ...seam) error {
+	for _, s := range seams {
+		if !s.set {
+			return fmt.Errorf("pawlengine: %s: Deps.%s is unset", producer, s.field)
+		}
+	}
+	return nil
+}
+
+// pathsSeams are the Paths fields every producer that reads or writes the run's files needs.
+func (d Deps) pathsSeams() []seam {
+	return []seam{
+		{"Paths.LandRequest", d.Paths.LandRequest != ""},
+		{"Paths.DobbyStopMarker", d.Paths.DobbyStopMarker != ""},
+		{"Paths.AwaitMarker", d.Paths.AwaitMarker != ""},
+	}
+}
+
+// entryErr returns nil when ctx is not yet cancelled, and otherwise an error naming the producer that never started.
+func entryErr(ctx context.Context, name string) error {
+	if ctx.Err() == nil {
+		return nil
+	}
+	return fmt.Errorf("pawlengine: %s: context cancelled before run started: %w", name, ctx.Err())
+}
+
+// cancelErr returns nil when ctx is not cancelled, and otherwise an error naming the producer a cancellation ended.
+// Every non-Done exit consults it first, so a cancellation is never read as a verdict.
+func cancelErr(ctx context.Context, name string) error {
+	if ctx.Err() == nil {
+		return nil
+	}
+	return fmt.Errorf("pawlengine: %s: context cancelled during run: %w", name, ctx.Err())
+}
diff --git a/internal/pawlengine/doc.go b/internal/pawlengine/doc.go
new file mode 100644
index 00000000..dd1b3d7a
--- /dev/null
+++ b/internal/pawlengine/doc.go
@@ -0,0 +1,21 @@
+// Package pawlengine owns the producers of a pawl run that no other recipe shares: Beam-Up, Beam-Await and Beam-Down, and the land request Beam-Await consumes.
+// A pawl run is the one batten run over a beam's project entry; these rows bring the beam up, hold it until its landing is requested and passing, and bring it down.
+//
+// The package is told its geometry and every seam by its caller through Deps; it imports no cwd resolver and no CLI package.
+// A producer refuses a nil seam it uses when built, naming the field.
+// Its records go through internal/state, so a key an older or newer binary wrote survives a rewrite and a request naming another run is read, never refused.
+//
+// Beam-Up marks the pair a beam, spawns its push, regenerates the hub workspace, removes a land request and the await marker a run before left, and runs the beam steps, each idempotent.
+// A failing step is a halting Stuck naming its cause and `lyx loom resume`.
+//
+// Beam-Await spawns no agent.
+// It holds the run until a land request naming this run passes the re-check, waking on a change in the request's directory and on a timer that starts at one second and doubles to one minute while idle.
+// An accepted request writes the status naming Parent-Align, so the landing hold stands, then writes the dobby-stop marker, stops the dobby and re-checks the beam's members and pairs.
+// A passing re-check writes the snapshot and ends the row; a failing one lifts the hold again, restarts the dobby the marker says was stopped, removes the request and posts the blockers to the beam's orch.
+// An await marker tells a re-entry from the first entry: a re-entry whose dobby is down (once until a re-entry sees it live, recorded in the marker), and a re-entry that finds the hold standing after a crash, post one notice naming `lyx beam start` and `lyx beam land`.
+// A beam another machine owns removes any request and yields, deciding nothing.
+//
+// Beam-Down stops the beam's dobby and orch through the told Down seam; a failure is logged and the row is Done, since Worktree-Teardown ends what is left.
+//
+// The land request, the dobby-stop marker and the await marker are files under the beam worktree's `.lyx/beam/`, whose paths the hub wiring composes and tells through Paths.
+package pawlengine
