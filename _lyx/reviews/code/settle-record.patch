@@ -0,0 +1,103 @@
+//go:build tier1
+
+// parentof_integration_test.go drives ParentOf over one real hub from hubforge:
+// pairs forked from the prime and from another pair, a record naming a parent pair that is gone, a record the prime's own branch or worktree name reads through, and the board's beam chain for a slug with no pair.
+
+package hubgeom_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+)
+
+// TestParentOf pins that the origin record decides the parent whenever a pair has one and the local board decides only for a slug with no pair.
+// A pair forked from the prime reads the prime, and one forked from pair b reads b, also when b's pair is gone from this machine.
+// A record with no parent worktree reads the prime though its board entry is a beam's member, and so does a record naming the prime's branch under another worktree name.
+// A slug with no pair reads the beam its board entry's project chain reaches, and a pair forked from the prime reads the prime though its board entry is a member of a beam.
+func TestParentOf(t *testing.T) {
+	t.Parallel()
+
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	l := h.Location
+
+	const (
+		fromPrime  = "po-from-prime"
+		beamPair   = "po-b"
+		fromBeam   = "po-from-b"
+		goneParent = "po-gone-parent"
+		noParent   = "po-no-parent"
+		otherName  = "po-other-name"
+		member     = "po-member"
+		unspawned  = "po-unspawned"
+	)
+	hubforge.AddPairWith(t, h, fromPrime, fabricengine.AddOptions{SkipPush: true})
+	hubforge.AddPairWith(t, h, beamPair, fabricengine.AddOptions{SkipPush: true})
+	beamLocation, err := lyxcwd.Resolve(fabricengine.WorktreePath(l, beamPair))
+	if err != nil {
+		t.Fatalf("lyxcwd.Resolve(beam pair): %v", err)
+	}
+	if _, err := h.Topology.Add(beamLocation, fromBeam, fabricengine.AddOptions{SkipPush: true}); err != nil {
+		t.Fatalf("Add(%q) from the beam pair: %v", fromBeam, err)
+	}
+	hubforge.AddPairWith(t, h, goneParent, fabricengine.AddOptions{SkipPush: true})
+	hubforge.AddPairWith(t, h, noParent, fabricengine.AddOptions{SkipPush: true})
+	hubforge.AddPairWith(t, h, otherName, fabricengine.AddOptions{SkipPush: true})
+	hubforge.AddPairWith(t, h, member, fabricengine.AddOptions{SkipPush: true})
+
+	primeRecord, found, err := fabricengine.ReadOriginFor(l, fromPrime)
+	if err != nil || !found {
+		t.Fatalf("ReadOriginFor(%q) = found %v, error %v; want a record", fromPrime, found, err)
+	}
+	rewrites := map[string]fabricengine.Origin{
+		goneParent: {ParentBranch: "gone-branch", ParentWorktree: "po-removed"},
+		noParent:   {ParentBranch: "gone-branch"},
+		otherName:  {ParentBranch: primeRecord.ParentBranch, ParentWorktree: "po-renamed-prime"},
+	}
+	for slug, origin := range rewrites {
+		if err := fabricengine.WriteOrigin(nil, l, slug, origin); err != nil {
+			t.Fatalf("WriteOrigin(%q): %v", slug, err)
+		}
+	}
+
+	board := `{"version":1,"entries":[` +
+		`{"id":0,"slug":"po-beam","title":"Beam","kind":"project","labels":["bug"],"beam":true},` +
+		`{"id":1,"slug":"` + unspawned + `","title":"Unspawned","kind":"task","labels":["bug"],"project":"po-beam"},` +
+		`{"id":2,"slug":"` + member + `","title":"Member","kind":"task","labels":["bug"],"project":"po-beam"},` +
+		`{"id":3,"slug":"` + noParent + `","title":"No parent","kind":"task","labels":["bug"],"project":"po-beam"}]}`
+	if err := os.WriteFile(filepath.Join(h.BoardDir(), "board.json"), []byte(board), 0o644); err != nil {
+		t.Fatalf("write board.json: %v", err)
+	}
+
+	tests := []struct {
+		name string
+		slug string
+		want string
+	}{
+		{"PairForkedFromThePrime", fromPrime, ""},
+		{"PairForkedFromAnotherPair", fromBeam, beamPair},
+		{"RecordNamingARemovedParentPair", goneParent, "po-removed"},
+		{"RecordWithNoParentWorktree", noParent, ""},
+		{"RecordNamingThePrimesBranchUnderAnotherWorktreeName", otherName, ""},
+		{"SlugWithNoPairReadsTheBoardsBeam", unspawned, "po-beam"},
+		{"PairForkedFromThePrimeReadsTheRecordOverTheBoard", member, ""},
+		{"SlugWithNoPairAndNoEntry", "po-ghost", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := hubgeom.ParentOf(l, tt.slug)
+			if err != nil {
+				t.Fatalf("ParentOf(%q) error = %v; want nil", tt.slug, err)
+			}
+			if got != tt.want {
+				t.Errorf("ParentOf(%q) = %q; want %q", tt.slug, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/landingshed/beamdescribe.go b/internal/landingshed/beamdescribe.go
new file mode 100644
index 000000000..49ab68469
--- /dev/null
+++ b/internal/landingshed/beamdescribe.go
@@ -0,0 +1,134 @@
+// beamdescribe.go implements NewBeamDescribe, the beam recipe's Describe row: a Go producer that writes a beam's change description from its board entry and the commits it adds, with no agent.
+
+package landingshed
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/summaryparser"
+)
+
+// beamDescriptionTitleMax is the longest title the description carries, in characters, which is the limit summaryparser.ValidateDescription enforces.
+const beamDescriptionTitleMax = 72
+
+// BeamDescribeDeps carries the told values NewBeamDescribe needs.
+// Every field is required.
+type BeamDescribeDeps struct {
+	// Slug is the run's slug, which names the landing in a refusal's way forward.
+	Slug string
+	// DescriptionPath is the absolute path of the change description the producer writes.
+	DescriptionPath string
+	// Entry reads the title and brief of the board entry of the run's slug, on every call.
+	Entry func() (title, brief string, err error)
+	// CommitSubjects lists the subjects of the commits the beam adds over its merge base with the parent, oldest first, merge commits left out.
+	CommitSubjects func() ([]string, error)
+	// Commit commits the description's directory; a repeat commit over unchanged content is a no-op.
+	Commit func() error
+}
+
+// beamDescribeProducer writes a beam's change description.
+type beamDescribeProducer struct {
+	name string
+	deps BeamDescribeDeps
+}
+
+var _ shedengine.ShedProducer = (*beamDescribeProducer)(nil)
+
+// NewBeamDescribe returns the ShedProducer that writes and commits the change description of a beam.
+// The description is the entry's title cut to 72 characters as a heading, its brief and one bullet per commit subject.
+// It is validated like the Describe row's, and a finding is an error naming the finding and the way to end the landing and fix the entry.
+// An empty brief with no commit subjects leaves the body empty, which that validation refuses.
+// A re-run rewrites the same bytes.
+func NewBeamDescribe(name string, deps BeamDescribeDeps) (shedengine.ShedProducer, error) {
+	required := []struct {
+		field string
+		set   bool
+	}{
+		{"Slug", deps.Slug != ""},
+		{"DescriptionPath", deps.DescriptionPath != ""},
+		{"Entry", deps.Entry != nil},
+		{"CommitSubjects", deps.CommitSubjects != nil},
+		{"Commit", deps.Commit != nil},
+	}
+	for _, r := range required {
+		if !r.set {
+			return nil, fmt.Errorf("landingshed: NewBeamDescribe: %s is empty", r.field)
+		}
+	}
+	return &beamDescribeProducer{name: name, deps: deps}, nil
+}
+
+// Call implements shedengine.ShedProducer.
+// It reads the entry and the commit subjects, writes the description, validates it and commits it.
+// A read, write or commit failure and a finding are errors; only a cancelled context is reported as the cancellation.
+func (p *beamDescribeProducer) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if err := entryErr(ctx, p.name); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	fail := func(action string, err error) (shedengine.Outcome, shedengine.OutputPointer, error) {
+		if cerr := cancelErr(ctx, p.name); cerr != nil {
+			return "", shedengine.OutputPointer{}, cerr
+		}
+		return "", shedengine.OutputPointer{}, fmt.Errorf("landingshed: %s: %s: %w", p.name, action, err)
+	}
+
+	title, brief, err := p.deps.Entry()
+	if err != nil {
+		return fail("read the board entry", err)
+	}
+	subjects, err := p.deps.CommitSubjects()
+	if err != nil {
+		return fail("read the beam's commit subjects", err)
+	}
+	if err := os.MkdirAll(filepath.Dir(p.deps.DescriptionPath), 0o755); err != nil {
+		return fail("create the description directory", err)
+	}
+	if err := os.WriteFile(p.deps.DescriptionPath, []byte(beamDescription(title, brief, subjects)), 0o644); err != nil {
+		return fail("write the description", err)
+	}
+	findings, err := summaryparser.ValidateDescription(p.deps.DescriptionPath)
+	if err != nil {
+		return fail("validate the description", err)
+	}
+	if len(findings) > 0 {
+		parts := make([]string, len(findings))
+		for i, finding := range findings {
+			parts[i] = finding.Error()
+		}
+		// The landing's claim holds the entry under the run lock, so the entry is fixed only after the landing is ended.
+		return fail("validate the description", fmt.Errorf("%s; way forward: run \"lyx batten cancel %s\" to end the landing, fix the title or brief with \"lyx board upsert\", then run \"lyx beam land %s\" again", strings.Join(parts, "; "), p.deps.Slug, p.deps.Slug))
+	}
+	if err := p.deps.Commit(); err != nil {
+		return fail("commit the description", err)
+	}
+	return shedengine.Done, shedengine.OutputPointer{}, nil
+}
+
+// beamDescription renders the description file: the title cut to beamDescriptionTitleMax characters as a heading, then the brief and one bullet per subject, each part set off by a blank line.
+func beamDescription(title, brief string, subjects []string) string {
+	title = strings.TrimSpace(title)
+	if runes := []rune(title); len(runes) > beamDescriptionTitleMax {
+		title = strings.TrimSpace(string(runes[:beamDescriptionTitleMax]))
+	}
+	var sections []string
+	if brief = strings.TrimSpace(brief); brief != "" {
+		sections = append(sections, brief)
+	}
+	if len(subjects) > 0 {
+		bullets := make([]string, len(subjects))
+		for i, subject := range subjects {
+			bullets[i] = "- " + subject
+		}
+		sections = append(sections, strings.Join(bullets, "\n"))
+	}
+	description := "# " + title
+	if len(sections) > 0 {
+		description += "\n\n" + strings.Join(sections, "\n\n")
+	}
+	return description + "\n"
+}
diff --git a/internal/landingshed/beamdescribe_test.go b/internal/landingshed/beamdescribe_test.go
new file mode 100644
index 000000000..a353bbd1c
--- /dev/null
+++ b/internal/landingshed/beamdescribe_test.go
@@ -0,0 +1,116 @@
+//go:build tier0
+
+// beamdescribe_test.go covers NewBeamDescribe over told seams and a temp description path.
+
+package landingshed
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// TestBeamDescribe asserts the beam description carries the entry's title, brief and one bullet per commit subject, cuts an over-long title, refuses an empty body naming the way out, returns a failed seam, and rewrites the same bytes on a re-run.
+func TestBeamDescribe(t *testing.T) {
+	t.Parallel()
+
+	const slug = "my-beam"
+	readErr := errors.New("board unreadable")
+	tests := []struct {
+		name     string
+		title    string
+		brief    string
+		subjects []string
+		entryErr error
+		subjErr  error
+		// wantFile is the exact description written; empty wants the call to fail.
+		wantFile string
+		// wantErr are the substrings the failure carries; a seam failure wants wantIs as well.
+		wantErr []string
+		wantIs  error
+	}{
+		{
+			name: "TitleBriefAndTwoSubjects", title: "Ship the beam", brief: "Groups the work.", subjects: []string{"first change", "second change"},
+			wantFile: "# Ship the beam\n\nGroups the work.\n\n- first change\n- second change\n",
+		},
+		{
+			name: "OverLongTitleIsCut", title: strings.Repeat("a", 80), brief: "Groups the work.",
+			wantFile: "# " + strings.Repeat("a", 72) + "\n\nGroups the work.\n",
+		},
+		{
+			name: "SubjectsAloneFillTheBody", title: "Ship the beam", subjects: []string{"only change"},
+			wantFile: "# Ship the beam\n\n- only change\n",
+		},
+		{
+			name: "EmptyBriefAndNoSubjectsAreRefusedNamingTheWayOut", title: "Ship the beam",
+			wantErr: []string{"body is empty", `"lyx batten cancel my-beam"`, `"lyx board upsert"`, `"lyx beam land my-beam"`},
+		},
+		{
+			name: "EntrySeamErrorIsReturned", entryErr: readErr,
+			wantErr: []string{"read the board entry"}, wantIs: readErr,
+		},
+		{
+			name: "SubjectsSeamErrorIsReturned", title: "Ship the beam", brief: "Groups the work.", subjErr: readErr,
+			wantErr: []string{"commit subjects"}, wantIs: readErr,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			path := filepath.Join(t.TempDir(), "landing", "summary.md")
+			commits := 0
+			producer, err := NewBeamDescribe("Beam-Describe", BeamDescribeDeps{
+				Slug:            slug,
+				DescriptionPath: path,
+				Entry:           func() (string, string, error) { return tt.title, tt.brief, tt.entryErr },
+				CommitSubjects:  func() ([]string, error) { return tt.subjects, tt.subjErr },
+				Commit:          func() error { commits++; return nil },
+			})
+			if err != nil {
+				t.Fatalf("NewBeamDescribe() error = %v; want nil", err)
+			}
+
+			outcome, _, err := producer.Call(context.Background())
+
+			if tt.wantFile == "" {
+				if err == nil {
+					t.Fatalf("Call() = %q, nil; want an error carrying %q", outcome, tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("Call() error = %q; want it to carry %q", err.Error(), want)
+					}
+				}
+				if tt.wantIs != nil && !errors.Is(err, tt.wantIs) {
+					t.Errorf("Call() error = %v; want it to wrap %v", err, tt.wantIs)
+				}
+				if commits != 0 {
+					t.Errorf("commits = %d; want none for a refused description", commits)
+				}
+				return
+			}
+			if err != nil || outcome != shedengine.Done {
+				t.Fatalf("Call() = %q, %v; want Done, nil", outcome, err)
+			}
+			if got, readErr := os.ReadFile(path); readErr != nil || string(got) != tt.wantFile {
+				t.Errorf("description = %q, %v; want %q", got, readErr, tt.wantFile)
+			}
+			if commits != 1 {
+				t.Errorf("commits = %d; want 1", commits)
+			}
+
+			if outcome, _, err := producer.Call(context.Background()); err != nil || outcome != shedengine.Done {
+				t.Fatalf("re-run Call() = %q, %v; want Done, nil", outcome, err)
+			}
+			if got, readErr := os.ReadFile(path); readErr != nil || string(got) != tt.wantFile {
+				t.Errorf("description after a re-run = %q, %v; want the same bytes", got, readErr)
+			}
+		})
+	}
+}
