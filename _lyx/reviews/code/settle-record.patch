-	"RemoveAll(",
-	"os.Remove(",
-	`"worktree", "remove"`,
-	`"branch", "-D"`,
-	"code.ResetHard(",
-	"records.ResetHard(",
-	"fslink.Remove(",
-	"createdToken{",
-	"createdBranchToken{",
