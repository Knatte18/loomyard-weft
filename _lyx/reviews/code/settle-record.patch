+			}
+			if len(f.commits) != 1 || !slices.Equal(f.commits[0], tt.wantCommit) {
+				t.Errorf("commits = %v; want one commit of %v", f.commits, tt.wantCommit)
+			}
+			if tt.check != nil {
+				tt.check(t, f)
+			}
+		})
+	}
+}
diff --git a/internal/driftengine/capture.go b/internal/driftengine/capture.go
new file mode 100644
index 000000000..0ba792c0a
--- /dev/null
+++ b/internal/driftengine/capture.go
@@ -0,0 +1,246 @@
+// capture.go — the main capture and the side capture: the body of the detached capture child and the one an agent runs for a spare baseline.
+//
+// Both render the declared capture command through the shared runner; only the main capture holds the capture lock and writes the capture record.
+
+package driftengine
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// CaptureHaltPrefix opens every Drift-Baseline Stuck reason on a failed or refused capture.
+const CaptureHaltPrefix = "drift capture halt: "
+
+// CaptureRequest is the told input of a main or side capture.
+type CaptureRequest struct {
+	// Paths are the drift paths of the task's anchor root.
+	Paths Paths
+	// WorktreeRoot is the task worktree the command's relative dir is joined onto.
+	WorktreeRoot string
+	// Step is the declared capture command.
+	Step CommandStep
+	// Pool is the gate-slot pool the capture takes one slot of.
+	Pool *gateslot.Pool
+	// WaitDir is where the capture's wait record is written while it waits for a slot.
+	WaitDir string
+	// Skip is the scope's skipped tests, written to the skip file.
+	Skip []string
+	// Check is the precondition a main capture runs under its lock; its error is returned untouched.
+	// It returns the commit the capture runs on, which the capture record names.
+	Check func() (head string, err error)
+	// Timeout bounds the command from its start; production passes the step's timeout_min.
+	Timeout time.Duration
+	// Now is the clock the records' times come from.
+	Now func() time.Time
+	// LockRetry bounds how long a main capture retries a held capture lock before it refuses.
+	LockRetry time.Duration
+}
+
+// lockHeldRefusal is the refusal of a capture or a spawn that finds the capture lock held.
+func lockHeldRefusal(lockPath string) error {
+	return fmt.Errorf("drift: a capture already holds %s; way forward: wait for it to end (lyx drift status shows it), then lyx loom resume", lockPath)
+}
+
+// RunCapture runs the main capture under the capture lock and returns its final record.
+// A refusal of the lock or of Check is returned with no record written.
+// A command that fails, times out or writes no file under the baseline directory is a record in state failed with its reason and no error.
+// An existing non-empty baseline directory is first moved to the first free numbered backup beside it, so no baseline is deleted or overwritten.
+func RunCapture(ctx context.Context, req CaptureRequest) (CaptureRecord, error) {
+	p := req.Paths
+	if err := os.MkdirAll(filepath.Dir(p.CaptureLock), 0o755); err != nil {
+		return CaptureRecord{}, fmt.Errorf("drift: create %s: %w", filepath.Dir(p.CaptureLock), err)
+	}
+	held, taken, err := lock.AcquireWriteLockWithin(p.CaptureLock, req.LockRetry)
+	if err != nil {
+		return CaptureRecord{}, err
+	}
+	if !taken {
+		return CaptureRecord{}, lockHeldRefusal(p.CaptureLock)
+	}
+	defer held.Release()
+
+	head, err := req.Check()
+	if err != nil {
+		return CaptureRecord{}, err
+	}
+
+	rec := CaptureRecord{State: CaptureRunning, Pid: os.Getpid(), Head: head}
+	if err := WriteCapture(p, rec); err != nil {
+		return CaptureRecord{}, err
+	}
+	if err := backUpBaseline(p.BaselineDir); err != nil {
+		return failCapture(p, rec, req.Now, err)
+	}
+	if err := writeSkipFile(p.SkipFile, req.Skip); err != nil {
+		return failCapture(p, rec, req.Now, err)
+	}
+
+	rec.Log = logPathFor(p.LogsDir, "capture", req.Now())
+	outcome, err := runStep(ctx, stepRun{
+		WorktreeRoot: req.WorktreeRoot,
+		Step:         req.Step,
+		Pool:         req.Pool,
+		WaitDir:      req.WaitDir,
+		Site:         "drift capture",
+		BaselineDir:  p.BaselineDir,
+		SkipFile:     p.SkipFile,
+		LogPath:      rec.Log,
+		Timeout:      req.Timeout,
+		Now:          req.Now,
+		OnSlot: func(at time.Time) {
+			rec.SlotAcquiredAt = stamp(at)
+			_ = WriteCapture(p, rec)
+		},
+		OnStart: func(_ int, at time.Time) {
+			rec.CommandStartedAt = stamp(at)
+			_ = WriteCapture(p, rec)
+		},
+	})
+	if err != nil {
+		return failCapture(p, rec, req.Now, err)
+	}
+	defer outcome.release()
+
+	rec.ExitCode = outcome.ExitCode
+	rec.EndedAt = stamp(req.Now())
+	switch {
+	case outcome.TimedOut:
+		rec.State, rec.Reason = CaptureFailed, "timed out after "+timeoutMinutes(req.Timeout)+"m"
+	case outcome.ExitCode != 0:
+		rec.State, rec.Reason = CaptureFailed, "exit "+strconv.Itoa(outcome.ExitCode)
+	default:
+		wrote, err := holdsFile(p.BaselineDir)
+		if err != nil {
+			return failCapture(p, rec, req.Now, err)
+		}
+		if wrote {
+			rec.State = CapturePassed
+		} else {
+			rec.State, rec.Reason = CaptureFailed, "exit 0 but wrote no file to "+p.BaselineDir
+		}
+	}
+	return rec, WriteCapture(p, rec)
+}
+
+// failCapture records rec as failed because err stopped the capture, and returns both.
+func failCapture(p Paths, rec CaptureRecord, now func() time.Time, cause error) (CaptureRecord, error) {
+	rec.State, rec.Reason, rec.EndedAt = CaptureFailed, cause.Error(), stamp(now())
+	return rec, errors.Join(cause, WriteCapture(p, rec))
+}
+
+// stamp formats t as the RFC 3339 UTC text the records hold.
+func stamp(t time.Time) string {
+	return t.UTC().Format(time.RFC3339)
+}
+
+// timeoutMinutes renders a timeout as minutes, with a decimal for a fraction of one.
+func timeoutMinutes(timeout time.Duration) string {
+	return strconv.FormatFloat(timeout.Minutes(), 'f', -1, 64)
+}
+
+// backUpBaseline moves a non-empty baseline directory to the first free numbered backup beside it and leaves an empty baseline directory.
+func backUpBaseline(baselineDir string) error {
+	entries, err := os.ReadDir(baselineDir)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("drift: read the baseline directory: %w", err)
+	}
+	if len(entries) > 0 {
+		backup := nextFree(filepath.Dir(baselineDir), filepath.Base(baselineDir)+".")
+		if err := os.Rename(baselineDir, backup); err != nil {
+			return fmt.Errorf("drift: move the existing baseline to %s: %w", backup, err)
+		}
+	}
+	if err := os.MkdirAll(baselineDir, 0o755); err != nil {
+		return fmt.Errorf("drift: create the baseline directory: %w", err)
+	}
+	return nil
+}
+
+// nextFree returns the path in dir named prefix and the lowest positive number that does not exist yet.
+func nextFree(dir, prefix string) string {
+	for n := 1; ; n++ {
+		candidate := filepath.Join(dir, prefix+strconv.Itoa(n))
+		if _, err := os.Lstat(candidate); errors.Is(err, os.ErrNotExist) {
+			return candidate
+		}
+	}
+}
+
+// holdsFile reports whether dir holds at least one file at any depth.
+func holdsFile(dir string) (bool, error) {
+	found := false
+	err := filepath.WalkDir(dir, func(_ string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !entry.IsDir() {
+			found = true
+			return fs.SkipAll
+		}
+		return nil
+	})
+	if err != nil {
+		return false, fmt.Errorf("drift: scan the baseline directory: %w", err)
+	}
+	return found, nil
+}
+
+// SideResult is how a side capture ended.
+type SideResult struct {
+	// Dir is the numbered directory under the side directory that the command wrote to.
+	Dir string
+	// Log is the command's log file.
+	Log string
+	// ExitCode is the command's exit code, -1 when a signal ended it.
+	ExitCode int
+	// TimedOut is true when the timeout killed the command.
+	TimedOut bool
+}
+
+// RunSideCapture runs the capture command into the next free numbered directory under the side directory.
+// It takes no capture lock, writes no capture record and needs no clean tree or branch point, so an agent can take a second profile beside the baseline.
+func RunSideCapture(ctx context.Context, req CaptureRequest) (SideResult, error) {
+	p := req.Paths
+	if err := os.MkdirAll(p.SideDir, 0o755); err != nil {
+		return SideResult{}, fmt.Errorf("drift: create the side capture directory: %w", err)
+	}
+	dir := nextFree(p.SideDir, "")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return SideResult{}, fmt.Errorf("drift: create %s: %w", dir, err)
+	}
+	if err := writeSkipFile(p.SkipFile, req.Skip); err != nil {
+		return SideResult{}, err
+	}
+
+	result := SideResult{Dir: dir, Log: logPathFor(p.LogsDir, "side-capture", req.Now())}
+	outcome, err := runStep(ctx, stepRun{
+		WorktreeRoot: req.WorktreeRoot,
+		Step:         req.Step,
+		Pool:         req.Pool,
+		WaitDir:      req.WaitDir,
+		Site:         "drift side capture",
+		BaselineDir:  dir,
+		SkipFile:     p.SkipFile,
+		LogPath:      result.Log,
+		Timeout:      req.Timeout,
+		Now:          req.Now,
+		OnSlot:       func(time.Time) {},
+		OnStart:      func(int, time.Time) {},
+	})
+	if err != nil {
+		return result, err
+	}
+	outcome.release()
+	result.ExitCode, result.TimedOut = outcome.ExitCode, outcome.TimedOut
+	return result, nil
+}
diff --git a/internal/driftengine/capture_test.go b/internal/driftengine/capture_test.go
new file mode 100644
index 000000000..e75998a3e
--- /dev/null
+++ b/internal/driftengine/capture_test.go
@@ -0,0 +1,282 @@
+//go:build tier1 && !windows
+
+// capture_test.go — tier 1 tests for RunCapture and RunSideCapture, driven by fake sh commands against a temp gate-slot pool.
+
+package driftengine
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/proc"
+)
+
+// captureFixture is a CaptureRequest over a temp worktree and a one-slot pool.
+type captureFixture struct {
+	req  CaptureRequest
+	pool *gateslot.Pool
+}
+
+// newCaptureFixture returns a fixture whose capture runs command in the temp worktree.
+func newCaptureFixture(t *testing.T, command string) *captureFixture {
+	t.Helper()
+	root := t.TempDir()
+	pool := &gateslot.Pool{
+		Dir:    t.TempDir(),
+		Limits: func() (gateslot.Limits, error) { return gateslot.Limits{Slots: 1}, nil },
+		Poll:   5 * time.Millisecond,
+	}
+	return &captureFixture{
+		pool: pool,
+		req: CaptureRequest{
+			Paths:        NewPaths(root),
+			WorktreeRoot: root,
+			Step:         CommandStep{Command: command, Dir: ".", TimeoutMin: 1},
+			Pool:         pool,
+			WaitDir:      t.TempDir(),
+			Check:        func() (string, error) { return "head1", nil },
+			Timeout:      time.Minute,
+			Now:          time.Now,
+			LockRetry:    time.Second,
+		},
+	}
+}
+
+// eventually polls cond until it holds or the deadline passes.
+func eventually(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// readFile returns a file's text, failing the test when it cannot be read.
+func readFile(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("ReadFile(%q) = %v; want nil", path, err)
+	}
+	return string(data)
+}
+
+// slotFree reports whether the pool has no holder.
+func slotFree(t *testing.T, pool *gateslot.Pool) bool {
+	t.Helper()
+	holders, err := pool.Holders()
+	if err != nil {
+		t.Fatalf("Holders() = %v; want nil", err)
+	}
+	return len(holders) == 0
+}
+
+// TestRunCapture covers the command's outcome rows, the skip file, the timeout tree kill, the kept backup, the capture lock, the slot wait, Check's refusal and the side capture.
+func TestRunCapture(t *testing.T) {
+	t.Parallel()
+
+	outcomes := []struct {
+		name       string
+		command    string
+		skip       []string
+		wantState  string
+		wantReason string
+		wantFile   string
+		wantText   string
+	}{
+		{name: "a command writing a file passes", command: "echo profile > {baseline_dir}/p.json", wantState: CapturePassed, wantFile: "p.json", wantText: "profile\n"},
+		{name: "the command sees the skip file with one test per line", command: "cat {skip_file} > {baseline_dir}/seen", skip: []string{"TestA", "TestB"}, wantState: CapturePassed, wantFile: "seen", wantText: "TestA\nTestB\n"},
+		{name: "the command sees an empty skip file when nothing is skipped", command: "cat {skip_file} > {baseline_dir}/seen", wantState: CapturePassed, wantFile: "seen", wantText: ""},
+		{name: "exit 0 with no file fails", command: "true", wantState: CaptureFailed, wantReason: "exit 0 but wrote no file to "},
+		{name: "a non-zero exit fails", command: "exit 3", wantState: CaptureFailed, wantReason: "exit 3"},
+	}
+	for _, tt := range outcomes {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newCaptureFixture(t, tt.command)
+			f.req.Skip = tt.skip
+
+			rec, err := RunCapture(context.Background(), f.req)
+			if err != nil {
+				t.Fatalf("RunCapture() = _, %v; want nil", err)
+			}
+			if rec.State != tt.wantState || !strings.HasPrefix(rec.Reason, tt.wantReason) {
+				t.Errorf("RunCapture() record = %+v; want state %q and a reason opening %q", rec, tt.wantState, tt.wantReason)
+			}
+			if tt.wantFile != "" {
+				if got := readFile(t, filepath.Join(f.req.Paths.BaselineDir, tt.wantFile)); got != tt.wantText {
+					t.Errorf("baseline file %s = %q; want %q", tt.wantFile, got, tt.wantText)
+				}
+			}
+			stored, found, err := ReadCapture(f.req.Paths)
+			if err != nil || !found || stored != rec {
+				t.Errorf("ReadCapture() = %+v, %v, %v; want the returned record", stored, found, err)
+			}
+			if rec.Pid != os.Getpid() || rec.Head != "head1" || rec.SlotAcquiredAt == "" || rec.CommandStartedAt == "" || rec.EndedAt == "" {
+				t.Errorf("record = %+v; want the pid, head and the slot, start and end times", rec)
+			}
+			if _, err := os.Stat(rec.Log); err != nil {
+				t.Errorf("record log %q: %v; want the log file", rec.Log, err)
+			}
+			if !slotFree(t, f.pool) {
+				t.Errorf("the slot is still held after the capture")
+			}
+			if held, _ := ProbeLock(f.req.Paths.CaptureLock); held {
+				t.Errorf("the capture lock is still held after the capture")
+			}
+		})
+	}
+
+	t.Run("a command past the timeout has its tree killed and fails", func(t *testing.T) {
+		t.Parallel()
+		f := newCaptureFixture(t, "sleep 60 & echo $! > {baseline_dir}/child.pid; wait")
+		f.req.Timeout = 500 * time.Millisecond
+
+		rec, err := RunCapture(context.Background(), f.req)
+		if err != nil || rec.State != CaptureFailed || !strings.HasPrefix(rec.Reason, "timed out after ") {
+			t.Fatalf("RunCapture() = %+v, %v; want a failed record that timed out", rec, err)
+		}
+		pid, err := strconv.Atoi(strings.TrimSpace(readFile(t, filepath.Join(f.req.Paths.BaselineDir, "child.pid"))))
+		if err != nil {
+			t.Fatalf("child.pid is no pid: %v", err)
+		}
+		eventually(t, "the sleeping grandchild to die", func() bool { return !proc.IsAlive(pid) })
+		if !slotFree(t, f.pool) {
+			t.Errorf("the slot is still held after the timeout")
+		}
+		if held, _ := ProbeLock(f.req.Paths.CaptureLock); held {
+			t.Errorf("the capture lock is still held after the timeout")
+		}
+	})
+
+	t.Run("an existing non-empty baseline is moved to a numbered backup and kept", func(t *testing.T) {
+		t.Parallel()
+		f := newCaptureFixture(t, "echo new > {baseline_dir}/p.json")
+		if err := os.MkdirAll(f.req.Paths.BaselineDir, 0o755); err != nil {
+			t.Fatalf("MkdirAll() = %v; want nil", err)
+		}
+		if err := os.WriteFile(filepath.Join(f.req.Paths.BaselineDir, "old.json"), []byte("old"), 0o644); err != nil {
+			t.Fatalf("WriteFile() = %v; want nil", err)
+		}
+
+		if rec, err := RunCapture(context.Background(), f.req); err != nil || rec.State != CapturePassed {
+			t.Fatalf("RunCapture() = %+v, %v; want a passed record", rec, err)
+		}
+		if got := readFile(t, f.req.Paths.BaselineDir+".1/old.json"); got != "old" {
+			t.Errorf("baseline.1/old.json = %q; want the kept old baseline", got)
+		}
+		if _, err := os.Stat(filepath.Join(f.req.Paths.BaselineDir, "old.json")); !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("the old file is still in the new baseline directory")
+		}
+	})
+
+	t.Run("a capture lock held past LockRetry refuses, and one held briefly inside it does not", func(t *testing.T) {
+		t.Parallel()
+		f := newCaptureFixture(t, "echo x > {baseline_dir}/p.json")
+		if err := os.MkdirAll(filepath.Dir(f.req.Paths.CaptureLock), 0o755); err != nil {
+			t.Fatalf("MkdirAll() = %v; want nil", err)
+		}
+		held, err := lock.AcquireWriteLock(f.req.Paths.CaptureLock)
+		if err != nil {
+			t.Fatalf("AcquireWriteLock() = %v; want nil", err)
+		}
+		f.req.LockRetry = 30 * time.Millisecond
+		if _, err := RunCapture(context.Background(), f.req); err == nil || !strings.Contains(err.Error(), "a capture already holds") {
+			t.Errorf("RunCapture() with the lock held = %v; want the held-lock refusal", err)
+		}
+
+		f.req.LockRetry = 10 * time.Second
+		time.AfterFunc(50*time.Millisecond, func() { _ = held.Release() })
+		if rec, err := RunCapture(context.Background(), f.req); err != nil || rec.State != CapturePassed {
+			t.Errorf("RunCapture() with a brief hold = %+v, %v; want a passed record", rec, err)
+		}
+	})
+
+	t.Run("with the only slot held the record stays running without a slot time", func(t *testing.T) {
+		t.Parallel()
+		f := newCaptureFixture(t, "echo x > {baseline_dir}/p.json")
+		lease, err := f.pool.Acquire(context.Background(), gateslot.Holder{Worktree: f.req.WorktreeRoot, Site: "test"})
+		if err != nil {
+			t.Fatalf("Acquire() = %v; want nil", err)
+		}
+
+		done := make(chan CaptureRecord, 1)
+		go func() {
+			rec, err := RunCapture(context.Background(), f.req)
+			if err != nil {
+				t.Errorf("RunCapture() = _, %v; want nil", err)
+			}
+			done <- rec
+		}()
+		eventually(t, "the capture's wait record", func() bool {
+			waits, _ := gateslot.ReadWaits(f.req.WaitDir)
+			return len(waits) == 1
+		})
+		rec, found, err := ReadCapture(f.req.Paths)
+		if err != nil || !found || rec.State != CaptureRunning || rec.SlotAcquiredAt != "" {
+			t.Errorf("ReadCapture() while waiting = %+v, %v, %v; want running with no slot_acquired_at", rec, found, err)
+		}
+
+		if err := lease.Release(); err != nil {
+			t.Fatalf("Release() = %v; want nil", err)
+		}
+		if final := <-done; final.State != CapturePassed || final.SlotAcquiredAt == "" {
+			t.Errorf("final record = %+v; want passed with a slot time", final)
+		}
+		if waits, _ := gateslot.ReadWaits(f.req.WaitDir); len(waits) != 0 {
+			t.Errorf("wait records after the capture = %+v; want none", waits)
+		}
+	})
+
+	t.Run("Check's refusal is returned untouched and writes no record", func(t *testing.T) {
+		t.Parallel()
+		f := newCaptureFixture(t, "echo x > {baseline_dir}/p.json")
+		refusal := errors.New("drift capture refused: test")
+		f.req.Check = func() (string, error) { return "", refusal }
+
+		if _, err := RunCapture(context.Background(), f.req); err != refusal {
+			t.Errorf("RunCapture() = %v; want Check's error untouched", err)
+		}
+		if _, found, _ := ReadCapture(f.req.Paths); found {
+			t.Errorf("a capture record was written for a refused capture")
+		}
+	})
+
+	t.Run("a side capture writes the next numbered directory and leaves the main capture's files", func(t *testing.T) {
+		t.Parallel()
+		f := newCaptureFixture(t, "echo side > {baseline_dir}/p.json")
+
+		for _, dir := range []string{"1", "2"} {
+			got, err := RunSideCapture(context.Background(), f.req)
+			if err != nil || got.ExitCode != 0 || got.Dir != filepath.Join(f.req.Paths.SideDir, dir) {
+				t.Fatalf("RunSideCapture() = %+v, %v; want exit 0 into side/%s", got, err, dir)
+			}
+			if text := readFile(t, filepath.Join(got.Dir, "p.json")); text != "side\n" {
+				t.Errorf("side/%s/p.json = %q; want the command's output", dir, text)
+			}
+			if _, err := os.Stat(got.Log); err != nil {
+				t.Errorf("side log %q: %v; want the log file", got.Log, err)
+			}
+		}
+		if _, found, _ := ReadCapture(f.req.Paths); found {
+			t.Errorf("a side capture wrote a capture record")
+		}
+		if _, err := os.Stat(f.req.Paths.BaselineDir); !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("a side capture touched the baseline directory")
+		}
+		if !slotFree(t, f.pool) {
+			t.Errorf("the slot is still held after the side capture")
+		}
+	})
+}
