@@ -0,0 +1,36 @@
+// fixture_test.go holds the C# tree and expectations the derivation tests of every tier share.
+// It carries no build tag, so it compiles into every tag set.
+
+package dotnetimpact
+
+import "strings"
+
+// treeDir is the tier directory the shared tree sits under.
+const treeDir = "cs"
+
+// csTree is a small C# tree: a library, a test project with a fixture naming the library's type and one naming nothing, and files outside the tier directory.
+func csTree() map[string]string {
+	return map[string]string{
+		"cs/Lib/Lib.csproj":             "<Project />",
+		"cs/Lib/Circle.cs":              "namespace Lib; public class Circle { }",
+		"cs/Lib.Tests/Lib.Tests.csproj": "<Project />",
+		"cs/Lib.Tests/CircleTests.cs":   "namespace Lib.Tests; [TestFixture] public class CircleTests { [Test] public void M() { new Circle(); } }",
+		"cs/Lib.Tests/OtherTests.cs":    "namespace Lib.Tests; [TestFixture] public class OtherTests { [Test] public void M() { } }",
+		"cs/appsettings.json":           "{}",
+		"docs/readme.md":                "docs",
+		"notes.txt":                     "class Notes { }",
+	}
+}
+
+// circleScope is the Scope of a change to Circle in csTree.
+func circleScope() Scope {
+	return Scope{Projects: []Project{{
+		Path:  "Lib.Tests/Lib.Tests.csproj",
+		Terms: []string{"FullyQualifiedName~Lib.Tests.CircleTests"},
+	}}}
+}
+
+// isMarkdown is the inert predicate of the tests: a Markdown file is inert.
+func isMarkdown(rel string) bool {
+	return strings.HasSuffix(rel, ".md")
+}
diff --git a/internal/dotnetimpact/lex.go b/internal/dotnetimpact/lex.go
new file mode 100644
index 000000000..10b686dad
--- /dev/null
+++ b/internal/dotnetimpact/lex.go
@@ -0,0 +1,246 @@
+// lex.go turns C# source into identifier and punctuation tokens, dropping comments, preprocessor lines, character literals and the literal text of every string.
+
+package dotnetimpact
+
+import (
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// token is one identifier or one punctuation character of a C# source file.
+type token struct {
+	// text is the identifier without a verbatim `@` prefix, or the one punctuation character.
+	text string
+	// ident reports whether the token is an identifier, keywords included.
+	ident bool
+	// pos is the byte offset of the token in the source.
+	pos int
+}
+
+// lexer holds the scan position over one source string.
+type lexer struct {
+	src    string
+	pos    int
+	tokens []token
+}
+
+// lex returns the identifier and punctuation tokens of data.
+// Comments, `#` preprocessor lines, character literals and the literal text of regular, verbatim and raw strings are dropped.
+// The code of every interpolation hole is kept as tokens, nested strings and braces included, without the hole's own braces.
+func lex(data []byte) []token {
+	l := &lexer{src: string(data)}
+	l.code(false)
+	return l.tokens
+}
+
+// code scans tokens until the end of the source, or, when inHole is set, until the brace that closes the hole, which it leaves unconsumed.
+func (l *lexer) code(inHole bool) {
+	depth := 0
+	for l.pos < len(l.src) {
+		c := l.src[l.pos]
+		switch {
+		case c == ' ' || c == '\t' || c == '\r' || c == '\n':
+			l.pos++
+		case c == '/' && l.peek(1) == '/':
+			l.skipTo("\n")
+		case c == '/' && l.peek(1) == '*':
+			l.skipPast("*/")
+		case c == '#' && l.atLineStart():
+			l.skipTo("\n")
+		case c == '\'':
+			l.skipCharLiteral()
+		case c == '"' || c == '$' || c == '@':
+			l.stringOrOther()
+		case c == '{':
+			depth++
+			l.emitPunct()
+		case c == '}':
+			if inHole && depth == 0 {
+				return
+			}
+			depth--
+			l.emitPunct()
+		case c >= '0' && c <= '9':
+			l.skipWord()
+		default:
+			r, _ := utf8.DecodeRuneInString(l.src[l.pos:])
+			if r == '_' || unicode.IsLetter(r) {
+				start := l.pos
+				l.skipWord()
+				l.tokens = append(l.tokens, token{text: l.src[start:l.pos], ident: true, pos: start})
+			} else {
+				l.emitPunct()
+			}
+		}
+	}
+}
+
+// peek returns the byte offset ahead of the scan position, or 0 past the end.
+func (l *lexer) peek(offset int) byte {
+	if l.pos+offset < len(l.src) {
+		return l.src[l.pos+offset]
+	}
+	return 0
+}
+
+// atLineStart reports whether only blanks precede the scan position on its line.
+func (l *lexer) atLineStart() bool {
+	for i := l.pos - 1; i >= 0; i-- {
+		switch l.src[i] {
+		case '\n':
+			return true
+		case ' ', '\t', '\r':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// emitPunct emits the character at the scan position as a punctuation token.
+func (l *lexer) emitPunct() {
+	_, size := utf8.DecodeRuneInString(l.src[l.pos:])
+	l.tokens = append(l.tokens, token{text: l.src[l.pos : l.pos+size], pos: l.pos})
+	l.pos += size
+}
+
+// skipWord advances past a run of letters, digits and underscores.
+func (l *lexer) skipWord() {
+	for l.pos < len(l.src) {
+		r, size := utf8.DecodeRuneInString(l.src[l.pos:])
+		if r != '_' && !unicode.IsLetter(r) && !unicode.IsDigit(r) {
+			return
+		}
+		l.pos += size
+	}
+}
+
+// skipTo advances to the next occurrence of marker, or the end of the source.
+func (l *lexer) skipTo(marker string) {
+	if index := strings.Index(l.src[l.pos:], marker); index >= 0 {
+		l.pos += index
+		return
+	}
+	l.pos = len(l.src)
+}
+
+// skipPast advances past the next occurrence of marker, or to the end of the source.
+func (l *lexer) skipPast(marker string) {
+	l.skipTo(marker)
+	l.pos = min(l.pos+len(marker), len(l.src))
+}
+
+// skipCharLiteral advances past a character literal, honouring a backslash escape.
+func (l *lexer) skipCharLiteral() {
+	i := l.pos + 1
+	for i < len(l.src) && l.src[i] != '\'' && l.src[i] != '\n' {
+		if l.src[i] == '\\' {
+			i++
+		}
+		i++
+	}
+	l.pos = min(i+1, len(l.src))
+}
+
+// stringOrOther handles a `"`, `$` or `@` at the scan position:
+// a string literal of any form is consumed, a verbatim identifier is emitted without its `@`, and any other use is punctuation.
+func (l *lexer) stringOrOther() {
+	i := l.pos
+	dollars, verbatim := 0, false
+	for i < len(l.src) && (l.src[i] == '$' || l.src[i] == '@') {
+		if l.src[i] == '$' {
+			dollars++
+		} else {
+			verbatim = true
+		}
+		i++
+	}
+	if i < len(l.src) && l.src[i] == '"' {
+		l.pos = i
+		l.stringBody(dollars, verbatim)
+		return
+	}
+	if l.src[l.pos] == '@' && i == l.pos+1 {
+		r, _ := utf8.DecodeRuneInString(l.src[i:])
+		if r == '_' || unicode.IsLetter(r) {
+			l.pos = i
+			start := l.pos
+			l.skipWord()
+			l.tokens = append(l.tokens, token{text: l.src[start:l.pos], ident: true, pos: start})
+			return
+		}
+	}
+	l.emitPunct()
+}
+
+// stringBody consumes the string whose opening quote is at the scan position.
+// dollars is the count of `$` prefixes, which is the brace count that opens a hole, and verbatim reports an `@` prefix.
+func (l *lexer) stringBody(dollars int, verbatim bool) {
+	quotes := 0
+	for l.pos+quotes < len(l.src) && l.src[l.pos+quotes] == '"' {
+		quotes++
+	}
+	if quotes == 2 {
+		l.pos += 2
+		return
+	}
+	if quotes >= 3 && !verbatim {
+		l.pos += quotes
+		l.rawBody(quotes, dollars)
+		return
+	}
+	l.pos++
+	for l.pos < len(l.src) {
+		c := l.src[l.pos]
+		switch {
+		case c == '"' && verbatim && l.peek(1) == '"':
+			l.pos += 2
+		case c == '"':
+			l.pos++
+			return
+		case c == '\\' && !verbatim:
+			l.pos += 2
+		case c == '{' && dollars > 0 && l.peek(1) == '{':
+			l.pos += 2
+		case c == '{' && dollars > 0:
+			l.pos++
+			l.hole(1)
+		default:
+			l.pos++
+		}
+	}
+}
+
+// rawBody consumes a raw string's text up to its closing run of quotes.
+// dollars is the brace count that opens a hole in an interpolated raw string, 0 when it is not interpolated.
+func (l *lexer) rawBody(quotes, dollars int) {
+	closing := strings.Repeat("\"", quotes)
+	for l.pos < len(l.src) {
+		switch {
+		case strings.HasPrefix(l.src[l.pos:], closing):
+			l.pos += quotes
+			return
+		case l.src[l.pos] == '{' && dollars > 0:
+			run := 0
+			for l.pos+run < len(l.src) && l.src[l.pos+run] == '{' {
+				run++
+			}
+			l.pos += run
+			if run >= dollars {
+				l.hole(dollars)
+			}
+		default:
+			l.pos++
+		}
+	}
+}
+
+// hole scans the code of one interpolation hole, whose opening braces are consumed, and consumes the closing braces.
+// closing is the brace count that ends the hole.
+func (l *lexer) hole(closing int) {
+	l.code(true)
+	for ; closing > 0 && l.pos < len(l.src) && l.src[l.pos] == '}'; closing-- {
+		l.pos++
+	}
+}
diff --git a/internal/dotnetimpact/narrow.go b/internal/dotnetimpact/narrow.go
new file mode 100644
index 000000000..f5769f4d1
--- /dev/null
+++ b/internal/dotnetimpact/narrow.go
@@ -0,0 +1,257 @@
+// narrow.go declares the pure core of the derivation: from scanned sources, project files and a seed, the test projects and filter terms a narrowed run takes.
+
+package dotnetimpact
+
+import (
+	"fmt"
+	"path"
+	"slices"
+	"sort"
+	"strings"
+)
+
+// Scope is the answer of a derivation.
+type Scope struct {
+	// Whole is set when the derivation cannot narrow the run, and Fallback says why.
+	Whole    bool
+	Fallback string
+	// Projects are the test projects holding a selected class, in path order.
+	Projects []Project
+	// NoTestClass is set when a non-empty seed selected no test class.
+	NoTestClass bool
+}
+
+// Project is one test project of a narrowed run.
+type Project struct {
+	// Path is the `.csproj` path relative to the tier's `dir`.
+	Path string
+	// Terms are the class filter terms of the project's selected classes, sorted and without repeats.
+	Terms []string
+}
+
+// seed is what a derivation starts from.
+type seed struct {
+	// Files are the changed or targeted `.cs` paths relative to the tier's `dir`.
+	Files map[string]bool
+	// Types are the seeded type names.
+	Types map[string]bool
+}
+
+// classRef points at one type declaration of the scanned sources.
+type classRef struct {
+	// index is the position among all declarations of all sources.
+	index int
+	// file indexes the sources.
+	file int
+	decl typeDecl
+}
+
+// narrow derives the Scope of seed over the scanned sources.
+// projects lists every `.csproj` path the scan found, relative to the tier's `dir`.
+// An empty seed is the empty scope, and a non-empty seed that selects no test class sets NoTestClass.
+func narrow(sources []sourceFile, projects []string, s seed) Scope {
+	if len(s.Files) == 0 && len(s.Types) == 0 {
+		return Scope{}
+	}
+	index := newProjectIndex(projects)
+	for _, file := range sortedKeys(s.Files) {
+		if len(index.nearest(file)) == 0 {
+			return wholeScope(fmt.Sprintf("no .csproj holds %s", file))
+		}
+	}
+
+	var classes []classRef
+	byName := map[string][]classRef{}
+	for i, source := range sources {
+		for _, decl := range source.Types {
+			ref := classRef{index: len(classes), file: i, decl: decl}
+			classes = append(classes, ref)
+			byName[decl.Name] = append(byName[decl.Name], ref)
+		}
+	}
+
+	closure := typeClosure(sources, s)
+	selected := selectClasses(sources, classes, byName, closure, s)
+
+	terms := map[string][]string{}
+	for _, ref := range classes {
+		if !selected[ref.index] || ref.decl.Abstract {
+			continue
+		}
+		file := sources[ref.file].Rel
+		owners := index.nearest(file)
+		switch {
+		case len(owners) == 0:
+			return wholeScope(fmt.Sprintf("no .csproj holds %s", file))
+		case len(owners) > 1:
+			return wholeScope(fmt.Sprintf("%s holds more than one .csproj", index.nearestDir(file)))
+		}
+		terms[owners[0]] = append(terms[owners[0]], filterTerm(ref.decl))
+	}
+	if len(terms) == 0 {
+		return Scope{NoTestClass: true}
+	}
+	scope := Scope{}
+	for _, projectPath := range sortedKeys(terms) {
+		list := terms[projectPath]
+		sort.Strings(list)
+		scope.Projects = append(scope.Projects, Project{Path: projectPath, Terms: slices.Compact(list)})
+	}
+	return scope
+}
+
+// wholeScope is the Scope of a run that cannot be narrowed.
+func wholeScope(reason string) Scope {
+	return Scope{Whole: true, Fallback: reason}
+}
+
+// typeClosure returns the seeded type names, the types declared in the seed files, and every type declared in a file whose identifiers name a type already in the set, until nothing changes.
+func typeClosure(sources []sourceFile, s seed) map[string]bool {
+	closure := map[string]bool{}
+	for name := range s.Types {
+		closure[name] = true
+	}
+	for _, source := range sources {
+		if s.Files[source.Rel] {
+			for _, decl := range source.Types {
+				closure[decl.Name] = true
+			}
+		}
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, source := range sources {
+			if !namesAny(source, closure) {
+				continue
+			}
+			for _, decl := range source.Types {
+				if !closure[decl.Name] {
+					closure[decl.Name] = true
+					changed = true
+				}
+			}
+		}
+	}
+	return closure
+}
+
+// namesAny reports whether the file's identifiers name any type of the set.
+func namesAny(source sourceFile, names map[string]bool) bool {
+	for name := range names {
+		if source.Identifiers[name] {
+			return true
+		}
+	}
+	return false
+}
+
+// selectClasses returns the test classes the seed selects: a test class whose file is a seed file or names a type of the closure, and every class deriving, transitively, from a selected abstract one.
+func selectClasses(sources []sourceFile, classes []classRef, byName map[string][]classRef, closure map[string]bool, s seed) []bool {
+	selected := make([]bool, len(classes))
+	for _, ref := range classes {
+		source := sources[ref.file]
+		if isTestClass(ref.decl, byName, map[string]bool{}) && (s.Files[source.Rel] || namesAny(source, closure)) {
+			selected[ref.index] = true
+		}
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, ref := range classes {
+			if selected[ref.index] || ref.decl.Base == "" {
+				continue
+			}
+			for _, base := range byName[ref.decl.Base] {
+				if selected[base.index] && base.decl.Abstract {
+					selected[ref.index] = true
+					changed = true
+					break
+				}
+			}
+		}
+	}
+	return selected
+}
+
+// isTestClass reports whether decl is a class carrying a test attribute, or a non-abstract class whose base, followed through the scanned sources by name, reaches one.
+// visited guards a cyclic base chain.
+func isTestClass(decl typeDecl, byName map[string][]classRef, visited map[string]bool) bool {
+	if decl.Kind != "class" {
+		return false
+	}
+	if decl.TestAttributed || decl.HasTestMethod {
+		return true
+	}
+	return !decl.Abstract && baseReachesTest(decl.Base, byName, visited)
+}
+
+// baseReachesTest reports whether a class named name, or any base of one, carries a test attribute.
+func baseReachesTest(name string, byName map[string][]classRef, visited map[string]bool) bool {
+	if name == "" || visited[name] {
+		return false
+	}
+	visited[name] = true
+	for _, ref := range byName[name] {
+		if ref.decl.TestAttributed || ref.decl.HasTestMethod || baseReachesTest(ref.decl.Base, byName, visited) {
+			return true
+		}
+	}
+	return false
+}
+
+// filterTerm returns the `dotnet test` filter term selecting the class: `FullyQualifiedName~` and the fully qualified name, a nested class joined to its outer class by `+`.
+// An abstract class has no term.
+func filterTerm(t typeDecl) string {
+	if t.Abstract {
+		return ""
+	}
+	name := strings.Join(append(slices.Clone(t.Outer), t.Name), "+")
+	if t.Namespace != "" {
+		name = t.Namespace + "." + name
+	}
+	return "FullyQualifiedName~" + name
+}
+
+// projectIndex answers which `.csproj` files sit in which directory.
+type projectIndex struct {
+	byDir map[string][]string
+}
+
+func newProjectIndex(projects []string) projectIndex {
+	index := projectIndex{byDir: map[string][]string{}}
+	for _, project := range projects {
+		dir := path.Dir(project)
+		index.byDir[dir] = append(index.byDir[dir], project)
+	}
+	return index
+}
+
+// nearestDir returns the nearest ancestor directory of file, up to the tier's `dir`, that holds a `.csproj`, or "" when none does.
+func (index projectIndex) nearestDir(file string) string {
+	for dir := path.Dir(file); ; dir = path.Dir(dir) {
+		if len(index.byDir[dir]) > 0 {
+			return dir
+		}
+		if dir == "." || dir == "/" {
+			return ""
+		}
+	}
+}
+
+// nearest returns the `.csproj` paths of the directory nearestDir finds.
+func (index projectIndex) nearest(file string) []string {
+	dir := index.nearestDir(file)
+	if dir == "" {
+		return nil
+	}
+	return index.byDir[dir]
+}
+
+// sortedKeys returns the keys of m in order.
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for key := range m {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
diff --git a/internal/dotnetimpact/narrow_test.go b/internal/dotnetimpact/narrow_test.go
new file mode 100644
index 000000000..f902554a2
--- /dev/null
+++ b/internal/dotnetimpact/narrow_test.go
@@ -0,0 +1,153 @@
+//go:build tier0
+
+// narrow_test.go covers the type-name closure, test class selection, project grouping and filter terms of narrow.
+
+package dotnetimpact
+
+import (
+	"sort"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// baseCorpus is a production library with two types and a test project of three fixtures: one naming Circle, one naming Shape, and one naming neither.
+var baseCorpus = map[string]string{
+	"Lib/Circle.cs":            "namespace Lib; class Circle { }",
+	"Lib/Shape.cs":             "namespace Lib; class Shape { Circle c; }",
+	"Lib/Unused.cs":            "namespace Lib; class Unused { }",
+	"Lib.Tests/CircleTests.cs": "[TestFixture] class CircleTests { [Test] void M() { new Circle(); } }",
+	"Lib.Tests/ShapeTests.cs":  "namespace Lib.Tests; [TestFixture] class ShapeTests { [Test] void M() { new Shape(); } }",
+	"Lib.Tests/OtherTests.cs":  "[TestFixture] class OtherTests { [Test] void M() { } }",
+}
+
+var baseProjects = []string{"Lib/Lib.csproj", "Lib.Tests/Lib.Tests.csproj"}
+
+func TestNarrow(t *testing.T) {
+	t.Parallel()
+	circleProject := Scope{Projects: []Project{{
+		Path:  "Lib.Tests/Lib.Tests.csproj",
+		Terms: []string{"FullyQualifiedName~CircleTests", "FullyQualifiedName~Lib.Tests.ShapeTests"},
+	}}}
+	tests := []struct {
+		name     string
+		extra    map[string]string
+		projects []string
+		files    []string
+		types    []string
+		want     Scope
+	}{
+		{
+			name:  "ChangedProductionType_SelectsTransitiveNamers",
+			files: []string{"Lib/Circle.cs"},
+			want:  circleProject,
+		},
+		{
+			name:  "SeededTypeWithoutFile_SelectsSameClasses",
+			types: []string{"Circle"},
+			want:  circleProject,
+		},
+		{
+			name:  "ChangedTestFile_SelectedWithoutNamingChangedType",
+			files: []string{"Lib.Tests/OtherTests.cs"},
+			want:  Scope{Projects: []Project{{Path: "Lib.Tests/Lib.Tests.csproj", Terms: []string{"FullyQualifiedName~OtherTests"}}}},
+		},
+		{
+			name: "AbstractBase_SelectsDerivedFixtureWithItsOwnTerm",
+			extra: map[string]string{
+				"Lib.Tests/BaseTests.cs":    "abstract class BaseTests { [Test] void M() { new Circle(); } }",
+				"Lib.Tests/DerivedTests.cs": "namespace Derived; class DerivedTests : Common.BaseTests<int> { }",
+			},
+			files: []string{"Lib/Circle.cs"},
+			want: Scope{Projects: []Project{{
+				Path: "Lib.Tests/Lib.Tests.csproj",
+				Terms: []string{
+					"FullyQualifiedName~CircleTests",
+					"FullyQualifiedName~Derived.DerivedTests",
+					"FullyQualifiedName~Lib.Tests.ShapeTests",
+				},
+			}}},
+		},
+		{
+			name: "NestedTestClass_JoinsOuterWithPlus",
+			extra: map[string]string{
+				"Lib.Tests/NestedTests.cs": "namespace N; class Outer { class Middle { [TestFixture] class Inner { [Test] void M() { new Unused(); } } } }",
+			},
+			files: []string{"Lib/Unused.cs"},
+			want:  Scope{Projects: []Project{{Path: "Lib.Tests/Lib.Tests.csproj", Terms: []string{"FullyQualifiedName~N.Outer+Middle+Inner"}}}},
+		},
+		{
+			name: "TwoTestProjects_EachGetsItsOwn",
+			extra: map[string]string{
+				"A.Tests/ATests.cs": "[TestFixture] class ATests { [Test] void M() { new Circle(); } }",
+				"B.Tests/BTests.cs": "[TestFixture] class BTests { [Test] void M() { new Circle(); } }",
+			},
+			projects: []string{"B.Tests/B.csproj", "A.Tests/A.csproj", "Lib/Lib.csproj", "Lib.Tests/Lib.Tests.csproj"},
+			files:    []string{"Lib/Circle.cs"},
+			want: Scope{Projects: []Project{
+				{Path: "A.Tests/A.csproj", Terms: []string{"FullyQualifiedName~ATests"}},
+				{Path: "B.Tests/B.csproj", Terms: []string{"FullyQualifiedName~BTests"}},
+				circleProject.Projects[0],
+			}},
+		},
+		{
+			name:  "SeedFileWithoutProject_Whole",
+			files: []string{"Loose/Thing.cs"},
+			want:  Scope{Whole: true, Fallback: "no .csproj holds Loose/Thing.cs"},
+		},
+		{
+			name: "SelectedClassWithoutProject_Whole",
+			extra: map[string]string{
+				"Orphan/OrphanTests.cs": "[TestFixture] class OrphanTests { [Test] void M() { new Circle(); } }",
+			},
+			files: []string{"Lib/Circle.cs"},
+			want:  Scope{Whole: true, Fallback: "no .csproj holds Orphan/OrphanTests.cs"},
+		},
+		{
+			name:     "NearestDirectoryWithTwoProjects_Whole",
+			projects: []string{"Lib/Lib.csproj", "Lib.Tests/A.csproj", "Lib.Tests/B.csproj"},
+			files:    []string{"Lib/Circle.cs"},
+			want:     Scope{Whole: true, Fallback: "Lib.Tests holds more than one .csproj"},
+		},
+		{
+			name:  "SeedSelectingNothing_NoTestClass",
+			files: []string{"Lib/Unused.cs"},
+			want:  Scope{NoTestClass: true},
+		},
+		{
+			name: "EmptySeed_EmptyScope",
+			want: Scope{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			files := map[string]string{}
+			for rel, content := range baseCorpus {
+				files[rel] = content
+			}
+			for rel, content := range tt.extra {
+				files[rel] = content
+			}
+			var sources []sourceFile
+			for rel, content := range files {
+				sources = append(sources, parseSource(rel, []byte(content)))
+			}
+			sort.Slice(sources, func(i, j int) bool { return sources[i].Rel < sources[j].Rel })
+			projects := tt.projects
+			if projects == nil {
+				projects = baseProjects
+			}
+			s := seed{Files: map[string]bool{}, Types: map[string]bool{}}
+			for _, file := range tt.files {
+				s.Files[file] = true
+			}
+			for _, name := range tt.types {
+				s.Types[name] = true
+			}
+			if diff := cmp.Diff(tt.want, narrow(sources, projects, s)); diff != "" {
+				t.Errorf("narrow() mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
diff --git a/internal/dotnetimpact/source.go b/internal/dotnetimpact/source.go
new file mode 100644
index 000000000..0d2969ac8
--- /dev/null
+++ b/internal/dotnetimpact/source.go
@@ -0,0 +1,383 @@
+// source.go reads one C# source file into its identifier set and its type declarations, with the test attributes each carries.
+
+package dotnetimpact
+
+import (
+	"slices"
+	"strings"
+)
+
+// typeDecl is one type a C# source file declares.
+type typeDecl struct {
+	// Name is the type's name without its type parameters.
+	Name string
+	// Namespace is the enclosing namespaces joined by `.`, empty when there are none.
+	Namespace string
+	// Outer are the names of the enclosing types, outermost first.
+	Outer []string
+	// Kind is `class`, `struct`, `interface`, `record`, `record struct` or `enum`.
+	Kind string
+	// Abstract reports an `abstract` modifier.
+	Abstract bool
+	// Base is the first name of the base list, without generic arguments or namespace qualifier; empty when there is none, and for an enum.
+	Base string
+	// TestAttributed reports a `TestFixture` or `TestClass` attribute on the type.
+	TestAttributed bool
+	// HasTestMethod reports a member carrying a test-method attribute.
+	HasTestMethod bool
+}
+
+// sourceFile is the read of one C# source file.
+type sourceFile struct {
+	// Rel is the file's slash path relative to the tier's `dir`.
+	Rel string
+	// Identifiers is the set of every identifier token in the file, keywords included.
+	Identifiers map[string]bool
+	// Types are the file's type declarations in source order.
+	Types []typeDecl
+}
+
+var (
+	typeAttributes   = []string{"TestFixture", "TestClass"}
+	methodAttributes = []string{"Test", "TestCase", "TestCaseSource", "Theory", "Fact", "TestMethod", "DataTestMethod"}
+	typeKeywords     = []string{"class", "struct", "interface", "enum", "record"}
+)
+
+type frameKind int
+
+const (
+	frameBlock frameKind = iota
+	frameNamespace
+	frameType
+)
+
+// frame is one open brace of the file: a namespace body, a type body or any other block.
+type frame struct {
+	kind frameKind
+	name string
+	// decl indexes sourceFile.Types for a type frame.
+	decl int
+}
+
+// sourceParser walks the tokens of one file.
+type sourceParser struct {
+	tokens []token
+	i      int
+	file   sourceFile
+	frames []frame
+	// fileNamespace is the file-scoped `namespace X;`, which applies to the rest of the file.
+	fileNamespace string
+	// pending are the attribute names collected since the last member boundary.
+	pending map[string]bool
+	// attributeEnd is the token index just past the last attribute list, where a following list is still an attribute list.
+	attributeEnd int
+}
+
+// parseSource reads the C# source data of the file rel into its identifier set and type declarations.
+func parseSource(rel string, data []byte) sourceFile {
+	p := &sourceParser{
+		tokens:       lex(data),
+		file:         sourceFile{Rel: rel, Identifiers: map[string]bool{}},
+		pending:      map[string]bool{},
+		attributeEnd: -1,
+	}
+	for _, t := range p.tokens {
+		if t.ident {
+			p.file.Identifiers[t.text] = true
+		}
+	}
+	for p.i < len(p.tokens) {
+		p.step()
+	}
+	return p.file
+}
+
+// step handles the token at the cursor and advances past what it consumed.
+func (p *sourceParser) step() {
+	t := p.tokens[p.i]
+	switch {
+	case p.isPunct(p.i, "{"):
+		p.frames = append(p.frames, frame{kind: frameBlock})
+		clear(p.pending)
+		p.i++
+	case p.isPunct(p.i, "}"):
+		if len(p.frames) > 0 {
+			p.frames = p.frames[:len(p.frames)-1]
+		}
+		clear(p.pending)
+		p.i++
+	case p.isPunct(p.i, ";"):
+		clear(p.pending)
+		p.i++
+	case p.isPunct(p.i, "[") && p.startsAttributeList():
+		p.attributeList()
+	case t.ident && t.text == "namespace" && !p.after("."):
+		p.namespaceDecl()
+	case t.ident && slices.Contains(typeKeywords, t.text) && p.startsTypeDecl():
+		p.typeDecl()
+	default:
+		p.i++
+	}
+}
+
+// after reports whether the token before the cursor is the punctuation text.
+func (p *sourceParser) after(text string) bool {
+	return p.i > 0 && !p.tokens[p.i-1].ident && p.tokens[p.i-1].text == text
+}
+
+// startsAttributeList reports whether a `[` at the cursor opens an attribute list: it sits where a member starts.
+func (p *sourceParser) startsAttributeList() bool {
+	if p.i == 0 || p.i == p.attributeEnd {
+		return true
+	}
+	previous := p.tokens[p.i-1]
+	return !previous.ident && (previous.text == "{" || previous.text == "}" || previous.text == ";")
+}
+
+// attributeList reads the attribute list at the cursor.
+// The names land in the pending set, and a test-method attribute marks the enclosing type.
+// A list with a target prefix, such as `[assembly: X]`, sets nothing.
+func (p *sourceParser) attributeList() {
+	end := p.matching(p.i, "[", "]")
+	p.attributeEnd = end + 1
+	defer func() { p.i = end + 1 }()
+
+	if p.isPunct(p.i+2, ":") && p.tokens[p.i+1].ident && !p.isPunct(p.i+3, ":") {
+		return
+	}
+	var names []string
+	for start := p.i + 1; start < end; {
+		names = append(names, p.lastQualifiedName(start))
+		start = p.nextComma(start, end) + 1
+	}
+	for _, name := range names {
+		name = strings.TrimSuffix(name, "Attribute")
+		p.pending[name] = true
+		if slices.Contains(methodAttributes, name) {
+			p.markTestMethod()
+		}
+	}
+}
+
+// lastQualifiedName returns the last segment of the possibly namespace-qualified name starting at start, generic arguments and call arguments excluded.
+func (p *sourceParser) lastQualifiedName(start int) string {
+	name := ""
+	for i := start; i < len(p.tokens) && p.tokens[i].ident; {
+		name = p.tokens[i].text
+		switch {
+		case p.isPunct(i+1, "."):
+			i += 2
+		case p.isPunct(i+1, ":") && p.isPunct(i+2, ":"):
+			i += 3
+		default:
+			return name
+		}
+	}
+	return name
+}
+
+// nextComma returns the index of the first comma at nesting depth zero between start and end, or end when there is none.
+func (p *sourceParser) nextComma(start, end int) int {
+	depth := 0
+	for i := start; i < end; i++ {
+		t := p.tokens[i]
+		if t.ident {
+			continue
+		}
+		switch t.text {
+		case "(", "[", "{":
+			depth++
+		case ")", "]", "}":
+			depth--
+		case ",":
+			if depth == 0 {
+				return i
+			}
+		}
+	}
+	return end
+}
+
+// markTestMethod records a test-method attribute on the type whose body the cursor is in.
+func (p *sourceParser) markTestMethod() {
+	if len(p.frames) > 0 && p.frames[len(p.frames)-1].kind == frameType {
+		p.file.Types[p.frames[len(p.frames)-1].decl].HasTestMethod = true
+	}
+}
+
+// namespaceDecl reads a `namespace` declaration at the cursor.
+func (p *sourceParser) namespaceDecl() {
+	name, next := p.qualifiedName(p.i + 1)
+	switch {
+	case name == "":
+		p.i++
+	case p.isPunct(next, "{"):
+		p.frames = append(p.frames, frame{kind: frameNamespace, name: name})
+		p.i = next + 1
+	case p.isPunct(next, ";"):
+		p.fileNamespace = name
+		p.i = next + 1
+	default:
+		p.i++
+	}
+}
+
+// qualifiedName reads the dot-joined name starting at start and returns it with the index after it.
+func (p *sourceParser) qualifiedName(start int) (string, int) {
+	var segments []string
+	i := start
+	for i < len(p.tokens) && p.tokens[i].ident {
+		segments = append(segments, p.tokens[i].text)
+		if !p.isPunct(i+1, ".") {
+			return strings.Join(segments, "."), i + 1
+		}
+		i += 2
+	}
+	return strings.Join(segments, "."), i
+}
+
+// startsTypeDecl reports whether the keyword at the cursor declares a type rather than constrains a type parameter or names a variable.
+func (p *sourceParser) startsTypeDecl() bool {
+	if p.after(":") || p.after(",") || p.after(".") {
+		return false
+	}
+	name, next := p.declaredName()
+	if name == "" {
+		return false
+	}
+	if p.tokens[p.i].text != "record" {
+		return true
+	}
+	// `record` is also an ordinary identifier, as in `foreach (var record in rs)` or `record is { X: 1 }`;
+	// a record declaration's name is no operator keyword and is followed by one of these.
+	switch name {
+	case "in", "is", "as", "when":
+		return false
+	}
+	for _, follower := range []string{"(", "<", ":", "{", ";"} {
+		if p.isPunct(next, follower) {
+			return true
+		}
+	}
+	return false
+}
+
+// declaredName returns the declared type's name and the index of the token after it, for the type keyword at the cursor.
+// It returns an empty name when no identifier follows.
+func (p *sourceParser) declaredName() (string, int) {
+	i := p.i + 1
+	if p.tokens[p.i].text == "record" && i < len(p.tokens) && p.tokens[i].ident && (p.tokens[i].text == "struct" || p.tokens[i].text == "class") {
+		i++
+	}
+	if i < len(p.tokens) && p.tokens[i].ident {
+		return p.tokens[i].text, i + 1
+	}
+	return "", i
+}
+
+// typeDecl reads the type declaration whose keyword is at the cursor, then moves into its body.
+func (p *sourceParser) typeDecl() {
+	keyword := p.tokens[p.i].text
+	kind := keyword
+	if keyword == "record" && p.tokens[p.i+1].text == "struct" {
+		kind = "record struct"
+	}
+	name, next := p.declaredName()
+	decl := typeDecl{
+		Name:           name,
+		Namespace:      p.namespace(),
+		Outer:          p.outerTypes(),
+		Kind:           kind,
+		Abstract:       p.hasModifier("abstract"),
+		TestAttributed: p.hasPending(typeAttributes),
+	}
+	next = p.skipTypeParameters(next)
+	if p.isPunct(next, "(") {
+		next = p.matching(next, "(", ")") + 1
+	}
+	if p.isPunct(next, ":") && kind != "enum" {
+		decl.Base = p.lastQualifiedName(next + 1)
+	}
+	for next < len(p.tokens) && !p.isPunct(next, "{") && !p.isPunct(next, ";") {
+		next++
+	}
+	p.file.Types = append(p.file.Types, decl)
+	clear(p.pending)
+	if p.isPunct(next, "{") {
+		p.frames = append(p.frames, frame{kind: frameType, name: name, decl: len(p.file.Types) - 1})
+	}
+	p.i = next + 1
+}
+
+// skipTypeParameters returns the index after the `<...>` at start, or start when there is none.
+func (p *sourceParser) skipTypeParameters(start int) int {
+	if !p.isPunct(start, "<") {
+		return start
+	}
+	return p.matching(start, "<", ">") + 1
+}
+
+// hasModifier reports whether the identifiers directly before the cursor include modifier.
+func (p *sourceParser) hasModifier(modifier string) bool {
+	for i := p.i - 1; i >= 0 && p.tokens[i].ident; i-- {
+		if p.tokens[i].text == modifier {
+			return true
+		}
+	}
+	return false
+}
+
+// hasPending reports whether any of names is a pending attribute.
+func (p *sourceParser) hasPending(names []string) bool {
+	return slices.ContainsFunc(names, func(name string) bool { return p.pending[name] })
+}
+
+// namespace returns the file's current namespace: the file-scoped one followed by every open namespace block.
+func (p *sourceParser) namespace() string {
+	var segments []string
+	if p.fileNamespace != "" {
+		segments = append(segments, p.fileNamespace)
+	}
+	for _, f := range p.frames {
+		if f.kind == frameNamespace {
+			segments = append(segments, f.name)
+		}
+	}
+	return strings.Join(segments, ".")
+}
+
+// outerTypes returns the names of the open type frames, outermost first.
+func (p *sourceParser) outerTypes() []string {
+	var names []string
+	for _, f := range p.frames {
+		if f.kind == frameType {
+			names = append(names, f.name)
+		}
+	}
+	return names
+}
+
+// isPunct reports whether the token at index is the punctuation text.
+func (p *sourceParser) isPunct(index int, text string) bool {
+	return index >= 0 && index < len(p.tokens) && !p.tokens[index].ident && p.tokens[index].text == text
+}
+
+// matching returns the index of the token closing the open at index, or the last token index when it never closes.
+func (p *sourceParser) matching(index int, open, closing string) int {
+	depth := 0
+	for i := index; i < len(p.tokens); i++ {
+		if p.tokens[i].ident {
+			continue
+		}
+		switch p.tokens[i].text {
+		case open:
+			depth++
+		case closing:
+			depth--
+			if depth == 0 {
+				return i
+			}
+		}
+	}
+	return len(p.tokens) - 1
+}
diff --git a/internal/dotnetimpact/source_test.go b/internal/dotnetimpact/source_test.go
new file mode 100644
index 000000000..fab96fdc3
--- /dev/null
+++ b/internal/dotnetimpact/source_test.go
@@ -0,0 +1,188 @@
+//go:build tier0
+
+// source_test.go covers the lexer and the per-file source model through parseSource.
+
+package dotnetimpact
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+func TestParseSource(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name string
+		src  string
+		// present and absent are identifiers that must and must not be in the set.
+		present, absent []string
+		want            []typeDecl
+	}{
+		{
+			name:    "Comments_DropNames",
+			src:     "// Hidden1\n/* Hidden2\n class Hidden3 */\nclass Real { }",
+			present: []string{"Real"},
+			absent:  []string{"Hidden1", "Hidden2", "Hidden3"},
+			want:    []typeDecl{{Name: "Real", Kind: "class"}},
+		},
+		{
+			name:    "Strings_DropLiteralText",
+			src:     "class C { string a = \"Hidden1\"; string b = @\"Hidden2 \"\"Hidden3\"\" \"; string c = \"\"\"Hidden4 \"\" Hidden5\"\"\"; string d = \"\\\"Hidden6\"; char e = 'x'; char f = '\\''; }",
+			present: []string{"C", "a", "b", "c", "d"},
+			absent:  []string{"Hidden1", "Hidden2", "Hidden3", "Hidden4", "Hidden5", "Hidden6"},
+			want:    []typeDecl{{Name: "C", Kind: "class"}},
+		},
+		{
+			name:    "VerbatimOpeningWithEscapedQuote_DoesNotSwallowCode",
+			src:     "class C { string a = @\"\"\"\"; string b = @\"\"\"Hidden1 \"\"x\"\" \"; Visible1 c; }",
+			present: []string{"C", "a", "b", "Visible1", "c"},
+			absent:  []string{"Hidden1", "x"},
+			want:    []typeDecl{{Name: "C", Kind: "class"}},
+		},
+		{
+			name:    "RecordAsIdentifier_DeclaresNoType",
+			src:     "class C { void M() { foreach (var record in rs) { } if (record is Foo) { } if (record is { X: 1 }) { } } }",
+			present: []string{"record", "rs", "Foo"},
+			want:    []typeDecl{{Name: "C", Kind: "class"}},
+		},
+		{
+			name:    "Interpolated_KeepHoles",
+			src:     "class C { string a = $\"Hidden1 {Formatter.Format(v)} {{Hidden2}}\"; string b = $@\"Hidden3 {Verbatim.Call(\"Hidden4\")}\"; string c = @$\"{Swapped}\"; string d = $\"{(flag ? \"Hidden5\" : Fallback.Text)}\"; }",
+			present: []string{"Formatter", "Format", "v", "Verbatim", "Call", "Swapped", "Fallback", "Text"},
+			absent:  []string{"Hidden1", "Hidden2", "Hidden3", "Hidden4", "Hidden5"},
+			want:    []typeDecl{{Name: "C", Kind: "class"}},
+		},
+		{
+			name:    "InterpolatedRaw_KeepHoles",
+			src:     "class C { string a = $\"\"\"Hidden1 {Hidden2} {RawOne.Go}\"\"\"; string b = $$\"\"\"Hidden3 {Hidden4} {{RawTwo.Go}} {{{RawThree}}}\"\"\"; }",
+			present: []string{"RawOne", "RawTwo", "RawThree", "Go"},
+			absent:  []string{"Hidden1", "Hidden3", "Hidden4"},
+			want:    []typeDecl{{Name: "C", Kind: "class"}},
+		},
+		{
+			name:    "Preprocessor_DropsLine",
+			src:     "#if HiddenSymbol\nclass C { }\n#endif",
+			present: []string{"C"},
+			absent:  []string{"HiddenSymbol", "endif"},
+			want:    []typeDecl{{Name: "C", Kind: "class"}},
+		},
+		{
+			name: "Namespaces_BlockAndNested",
+			src:  "namespace A.B { namespace C { class X { } } class Y { } }",
+			want: []typeDecl{
+				{Name: "X", Namespace: "A.B.C", Kind: "class"},
+				{Name: "Y", Namespace: "A.B", Kind: "class"},
+			},
+		},
+		{
+			name: "Namespaces_FileScoped",
+			src:  "namespace Ns.Inner;\nclass X { }\nstruct Y { }",
+			want: []typeDecl{
+				{Name: "X", Namespace: "Ns.Inner", Kind: "class"},
+				{Name: "Y", Namespace: "Ns.Inner", Kind: "struct"},
+			},
+		},
+		{
+			name: "Nested_OuterChain",
+			src:  "namespace N { class Outer { class Middle { class Inner { } } class Sibling { } } }",
+			want: []typeDecl{
+				{Name: "Outer", Namespace: "N", Kind: "class"},
+				{Name: "Middle", Namespace: "N", Outer: []string{"Outer"}, Kind: "class"},
+				{Name: "Inner", Namespace: "N", Outer: []string{"Outer", "Middle"}, Kind: "class"},
+				{Name: "Sibling", Namespace: "N", Outer: []string{"Outer"}, Kind: "class"},
+			},
+		},
+		{
+			name: "Generic_NameWithoutParameters",
+			src:  "class Box<T> where T : class, new() { }",
+			want: []typeDecl{{Name: "Box", Kind: "class"}},
+		},
+		{
+			name: "Abstract_GenericQualifiedBase",
+			src:  "public abstract partial class Shape : Geometry.Core.Base<int>, IFoo { }",
+			want: []typeDecl{{Name: "Shape", Kind: "class", Abstract: true, Base: "Base"}},
+		},
+		{
+			name: "Kinds_RecordStructInterfaceEnum",
+			src:  "record R(int X) : Parent(X); record struct S(int Y); record class C { } interface I : IBase { } enum E : byte { A, B }",
+			want: []typeDecl{
+				{Name: "R", Kind: "record", Base: "Parent"},
+				{Name: "S", Kind: "record struct"},
+				{Name: "C", Kind: "record"},
+				{Name: "I", Kind: "interface", Base: "IBase"},
+				{Name: "E", Kind: "enum"},
+			},
+		},
+		{
+			name: "Attributes_ClassSpellings",
+			src: "[TestFixture] class A { }\n" +
+				"[TestClassAttribute] class B { }\n" +
+				"[NUnit.Framework.TestFixtureAttribute] class C { }\n" +
+				"[TestFixture(typeof(int), Category = \"x\")] class D { }\n" +
+				"[Category(\"x\"), TestClass] class E { }\n" +
+				"[Category(\"x\")]\n[TestFixture]\nclass F { }\n" +
+				"[Category(\"x\")] class G { }",
+			want: []typeDecl{
+				{Name: "A", Kind: "class", TestAttributed: true},
+				{Name: "B", Kind: "class", TestAttributed: true},
+				{Name: "C", Kind: "class", TestAttributed: true},
+				{Name: "D", Kind: "class", TestAttributed: true},
+				{Name: "E", Kind: "class", TestAttributed: true},
+				{Name: "F", Kind: "class", TestAttributed: true},
+				{Name: "G", Kind: "class"},
+			},
+		},
+		{
+			name: "Attributes_MethodSpellings",
+			src: "class A { [Test] void M() { } }\n" +
+				"class B { [TestMethod] public void M() { } }\n" +
+				"class C { [NUnit.Framework.TestAttribute] void M() { } }\n" +
+				"class D { [Category(\"x\"), Theory] void M() { } }\n" +
+				"class E { [TestCase(1, 2)] void M() { } }\n" +
+				"class F { [Fact(Skip = \"x\")] void M() { } }\n" +
+				"class G { [Obsolete] void M() { } }",
+			want: []typeDecl{
+				{Name: "A", Kind: "class", HasTestMethod: true},
+				{Name: "B", Kind: "class", HasTestMethod: true},
+				{Name: "C", Kind: "class", HasTestMethod: true},
+				{Name: "D", Kind: "class", HasTestMethod: true},
+				{Name: "E", Kind: "class", HasTestMethod: true},
+				{Name: "F", Kind: "class", HasTestMethod: true},
+				{Name: "G", Kind: "class"},
+			},
+		},
+		{
+			name: "Attributes_AssemblyTargetSetsNothing",
+			src:  "[assembly: TestFixture]\n[assembly: Test, Parallelizable]\nclass A { }",
+			want: []typeDecl{{Name: "A", Kind: "class"}},
+		},
+		{
+			name: "Attributes_IndexerIsNotAList",
+			src:  "class A { void M() { var x = grid[0][Test]; } }",
+			want: []typeDecl{{Name: "A", Kind: "class"}},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got := parseSource("a/File.cs", []byte(tt.src))
+			if got.Rel != "a/File.cs" {
+				t.Errorf("parseSource Rel = %q; want %q", got.Rel, "a/File.cs")
+			}
+			for _, name := range tt.present {
+				if !got.Identifiers[name] {
+					t.Errorf("parseSource Identifiers lacks %q", name)
+				}
+			}
+			for _, name := range tt.absent {
+				if got.Identifiers[name] {
+					t.Errorf("parseSource Identifiers holds %q", name)
+				}
+			}
+			if diff := cmp.Diff(tt.want, got.Types); diff != "" {
+				t.Errorf("parseSource Types mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
