@@ -33,6 +33,22 @@
 // A missing or unreadable .git entry is the one error of ReedGeometry and of BurlerGeometry, and an unresolvable parent leaves ParentName empty with a warning in all three.
 // hubgeom is still the only reader — no engine resolves a parent, per the Told-Geometry Invariant.
 //
+// ParentOf is the one parent resolver every owner reader is handed: it returns the slug of the pair an entry was forked from, "" for the prime.
+// It reads the slug's origin record over the prime's location, and only when no record is found reads the nearest open beam above the entry on the local board.
+// A found record with no parent worktree reads as the prime and never falls through to the board.
+// A found record's parent is its ParentWorktree, read as the prime when the record names the prime's checked-out branch or the prime's worktree, and never derived by matching the recorded branch against the pairs present here.
+// So a member whose beam pair is absent on this machine still reads the beam as its parent, and the beam's owner as its own.
+// ResolveParent keeps answering the parent pair's orch name for a reader that needs the pair itself:
+// the parent names the driver's prompts carry, and the Discussion-Write parent review, whose reviewer is the recorded parent's own orch and is absent when that orch is not live.
+// The `lyx loom decision add --by parent` guard admits the destination of notices instead, so the orch that receives them can record the call.
+//
+// NearestLiveOrch is the destination of a notice to an orch.
+// It tries the worktree it is told, then walks upward through the origin records' parent worktrees.
+// It answers the nearest worktree whose orch a told predicate reports live, or the prime whatever its state when none is.
+// The predicate is told because the orch's state paths and reed belong to a package that imports hubgeom.
+// The answer's Name is that worktree's orch agent name, formed as ResolveParent forms it, and its Worktree names the worktree, empty for the prime.
+// A worktree with no origin record, an empty parent worktree or a parent worktree that is gone ends the walk at the prime, and so does a cycle; an error from the predicate is returned.
+//
 // Standalone CLIs do not call hubgeom — they have no Location to convert, resolving their own
 // geometry from CLI flags and local paths instead.
 package hubgeom
diff --git a/internal/hubgeom/nearestlive.go b/internal/hubgeom/nearestlive.go
new file mode 100644
index 000000000..ae95e116e
--- /dev/null
+++ b/internal/hubgeom/nearestlive.go
@@ -0,0 +1,111 @@
+// nearestlive.go implements NearestLiveOrch, the walk up the beam chain to the nearest worktree whose orch is live.
+
+package hubgeom
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/agentname"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+)
+
+// NearestLiveOrch returns the orch to notify for a run acting from the worktree from names.
+// It tries that worktree, then walks upward through the origin records, each worktree's ParentWorktree.
+// It returns the nearest worktree whose orch strand live reports live, and the prime whatever its state when none is.
+// The answer's Name is that worktree's orch agent name and its Worktree the worktree's name, empty for the prime.
+// A worktree with no origin record, an empty parent worktree or a parent worktree that is gone ends the walk at the prime.
+// A cycle in the records ends it there too.
+// A hub with no recorded shortname yields no parent and a warning, since no name can be formed.
+// A read error, and an error from live, are returned.
+func NearestLiveOrch(from *lyxcwd.Location, live func(worktree *lyxcwd.Location) (bool, error)) (Parent, error) {
+	shortname, found := fabricengine.ReadShortname(fabricengine.BoardDir(from.HubPath))
+	if !found {
+		logger.Warn("hubgeom: hub has no recorded shortname; the notice gets no orch", "worktree", from.WorktreeName)
+		return Parent{}, nil
+	}
+	start := from.WorktreeName
+	fromPrime, err := isPrimeWorktree(from.WorktreePath())
+	if err != nil {
+		return Parent{}, err
+	}
+	if fromPrime {
+		start = ""
+	}
+	worktree, err := nearestLive(start,
+		func(worktree string) (string, bool, error) { return recordedParentWorktree(from, worktree) },
+		func(worktree string) (bool, error) {
+			location, err := lyxcwd.ResolveWorktree(filepath.Join(from.HubPath, worktree))
+			if err != nil {
+				return false, fmt.Errorf("hubgeom: resolve worktree %q: %w", worktree, err)
+			}
+			return live(location)
+		})
+	if err != nil {
+		return Parent{}, err
+	}
+	name, err := agentname.Format(shortname, worktree, agentname.RoleOrch)
+	if err != nil {
+		return Parent{}, fmt.Errorf("hubgeom: form orch agent name for worktree %q: %w", worktree, err)
+	}
+	return Parent{Name: name, Worktree: worktree}, nil
+}
+
+// recordedParentWorktree reads the parent worktree of the worktree named worktree from its origin record, "" meaning the prime.
+// It reports false when the worktree has no record, the record names no parent worktree or the parent worktree is gone.
+func recordedParentWorktree(from *lyxcwd.Location, worktree string) (string, bool, error) {
+	origin, found, err := fabricengine.ReadOriginFor(from, worktree)
+	if err != nil {
+		return "", false, fmt.Errorf("hubgeom: read origin record for %q: %w", worktree, err)
+	}
+	if !found || origin.ParentWorktree == "" {
+		return "", false, nil
+	}
+	parentRoot := filepath.Join(from.HubPath, origin.ParentWorktree)
+	if _, err := os.Stat(filepath.Join(parentRoot, gitEntryName)); errors.Is(err, fs.ErrNotExist) {
+		return "", false, nil
+	}
+	parentIsPrime, err := isPrimeWorktree(parentRoot)
+	if err != nil {
+		return "", false, err
+	}
+	if parentIsPrime {
+		return "", true, nil
+	}
+	return origin.ParentWorktree, true, nil
+}
+
+// nearestLive is NearestLiveOrch's walk over told reads, so its table needs no filesystem.
+// It returns start when live reports it live, else its parent's answer, and "" for the prime.
+// parentOf reports a worktree's parent worktree, "" for the prime, and false when the walk ends there; start "" is the prime.
+// The prime is never asked of live, and a worktree seen twice ends the walk at the prime.
+func nearestLive(start string, parentOf func(worktree string) (string, bool, error), live func(worktree string) (bool, error)) (string, error) {
+	visited := map[string]bool{}
+	for current := start; current != ""; {
+		if visited[current] {
+			return "", nil
+		}
+		visited[current] = true
+		isLive, err := live(current)
+		if err != nil {
+			return "", err
+		}
+		if isLive {
+			return current, nil
+		}
+		parent, found, err := parentOf(current)
+		if err != nil {
+			return "", err
+		}
+		if !found {
+			return "", nil
+		}
+		current = parent
+	}
+	return "", nil
+}
diff --git a/internal/hubgeom/nearestlive_test.go b/internal/hubgeom/nearestlive_test.go
new file mode 100644
index 000000000..75bfad3f6
--- /dev/null
+++ b/internal/hubgeom/nearestlive_test.go
@@ -0,0 +1,96 @@
+//go:build tier0
+
+// nearestlive_test.go covers the walk behind NearestLiveOrch over told reads, so no filesystem is touched.
+
+package hubgeom
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestNearestLive(t *testing.T) {
+	t.Parallel()
+
+	errLive := errors.New("probe failed")
+	type parentRead struct {
+		parent string
+		found  bool
+	}
+	tests := []struct {
+		name    string
+		start   string
+		parents map[string]parentRead
+		live    map[string]bool
+		liveErr map[string]error
+		want    string
+		wantErr error
+	}{
+		{
+			name:    "live start answers itself",
+			start:   "b",
+			parents: map[string]parentRead{"b": {"a", true}},
+			live:    map[string]bool{"b": true, "a": true},
+			want:    "b",
+		},
+		{
+			name:    "stopped beam answers the live beam above it",
+			start:   "b",
+			parents: map[string]parentRead{"b": {"a", true}, "a": {"", true}},
+			live:    map[string]bool{"a": true},
+			want:    "a",
+		},
+		{
+			name:    "no live orch answers the prime",
+			start:   "b",
+			parents: map[string]parentRead{"b": {"a", true}, "a": {"", true}},
+			want:    "",
+		},
+		{
+			name:    "gone parent worktree answers the prime",
+			start:   "b",
+			parents: map[string]parentRead{"b": {"", false}},
+			live:    map[string]bool{"a": true},
+			want:    "",
+		},
+		{
+			name:    "cycle answers the prime",
+			start:   "a",
+			parents: map[string]parentRead{"a": {"b", true}, "b": {"a", true}},
+			want:    "",
+		},
+		{
+			name:  "prime start is never probed",
+			start: "",
+			liveErr: map[string]error{
+				"": errLive,
+			},
+			want: "",
+		},
+		{
+			name:    "predicate error is returned",
+			start:   "b",
+			parents: map[string]parentRead{"b": {"a", true}},
+			liveErr: map[string]error{"b": errLive},
+			wantErr: errLive,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := nearestLive(tt.start,
+				func(worktree string) (string, bool, error) {
+					read := tt.parents[worktree]
+					return read.parent, read.found, nil
+				},
+				func(worktree string) (bool, error) { return tt.live[worktree], tt.liveErr[worktree] },
+			)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("nearestLive(%q) error = %v; want %v", tt.start, err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("nearestLive(%q) = %q; want %q", tt.start, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/hubgeom/parentof.go b/internal/hubgeom/parentof.go
new file mode 100644
index 000000000..a783f19fb
--- /dev/null
+++ b/internal/hubgeom/parentof.go
@@ -0,0 +1,49 @@
+// parentof.go implements ParentOf, the one resolver of the parent every owner reader is handed.
+
+package hubgeom
+
+import (
+	"fmt"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+)
+
+// ParentOf returns the slug of the pair that is the parent of the entry slug, "" meaning the prime.
+// A pair's origin record decides, read over the prime's location, and its recorded parent worktree is the answer.
+// It reads as the prime when the record names no parent worktree, names the prime's worktree or names the prime's checked-out branch.
+// The parent is never derived by matching the recorded branch against the pairs present here,
+// so a member whose beam pair is absent on this machine still reads the beam as its parent.
+// Only when the slug has no origin record does the local board decide, through the nearest open beam above the entry.
+// A read error from the record, the worktree listing or the board is returned.
+func ParentOf(prime *lyxcwd.Location, slug string) (string, error) {
+	origin, found, err := fabricengine.ReadOriginFor(prime, slug)
+	if err != nil {
+		return "", fmt.Errorf("hubgeom: read origin record for %q: %w", slug, err)
+	}
+	if !found {
+		tasks, err := boardengine.ReadTasks(fabricengine.BoardDir(prime.HubPath))
+		if err != nil {
+			return "", fmt.Errorf("hubgeom: read the board for the parent of %q: %w", slug, err)
+		}
+		return boardengine.ParentBeam(tasks, slug), nil
+	}
+	if origin.ParentWorktree == "" {
+		return "", nil
+	}
+	entries, err := fabricengine.List(prime.AnchorPath())
+	if err != nil {
+		return "", fmt.Errorf("hubgeom: list the worktrees for the parent of %q: %w", slug, err)
+	}
+	for _, entry := range entries {
+		if !entry.Main {
+			continue
+		}
+		if origin.ParentBranch == entry.Branch || origin.ParentWorktree == filepath.Base(filepath.Clean(filepath.FromSlash(entry.Path))) {
+			return "", nil
+		}
+	}
+	return origin.ParentWorktree, nil
+}
