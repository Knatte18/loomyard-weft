+// spawn.go — the detached capture child's spawn, and the lock probe every reader of capture activity uses.
+
+package driftengine
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/proc"
+	"github.com/Knatte18/loomyard/internal/runproc"
+)
+
+// ErrBreakawayRefused marks a capture start Windows refused for breakaway when the caller admits no detached fallback.
+var ErrBreakawayRefused = errors.New("drift: the capture start was refused breakaway")
+
+// childSpawn describes one start of the capture child, told to the spawn seam.
+type childSpawn struct {
+	argv []string
+	dir  string
+	log  *os.File
+	// breakaway is true for a start that leaves the caller's job object, false for a plain detached start.
+	breakaway bool
+}
+
+// spawnedChild is a started capture child.
+type spawnedChild struct {
+	pid int
+	// exited is closed when the child process has ended.
+	exited <-chan struct{}
+}
+
+// SpawnRequest is the told input of StartCapture.
+type SpawnRequest struct {
+	// Executable is the lyx binary the child runs.
+	Executable string
+	// WorktreeRoot is the directory the child runs in.
+	WorktreeRoot string
+	// Paths are the drift paths of the task's anchor root.
+	Paths Paths
+	// RunProcDir and Owner locate the run's process records, where the child is registered.
+	RunProcDir string
+	Owner      string
+	// FallbackDetach retries a start Windows refused for breakaway as a plain detached start; the caller then lives as long as its shell's job.
+	// Unset, a refused start returns ErrBreakawayRefused.
+	FallbackDetach bool
+	// RecordWait bounds how long StartCapture waits for the child's running record.
+	RecordWait time.Duration
+	// Poll is the interval at which StartCapture reads the capture record.
+	Poll time.Duration
+
+	// spawn starts the child; nil starts the real command.
+	spawn func(childSpawn) (spawnedChild, error)
+	// breakawayRefused classifies a start error; nil is proc.IsBreakawayRefused.
+	breakawayRefused func(error) bool
+}
+
+// StartCapture starts `<executable> drift capture-child` detached in the worktree root and returns its pid once the capture record carries that pid, in any state.
+// The child writes that record after its precondition held under the capture lock, so the caller moves the run on only after the precondition held.
+// It refuses while the capture lock reads held, and returns an error naming the child's log when the child ends, or the bound runs out, before the record.
+func StartCapture(req SpawnRequest) (int, error) {
+	held, err := ProbeLock(req.Paths.CaptureLock)
+	if err != nil {
+		return 0, err
+	}
+	if held {
+		return 0, lockHeldRefusal(req.Paths.CaptureLock)
+	}
+
+	if err := os.MkdirAll(req.Paths.LogsDir, 0o755); err != nil {
+		return 0, fmt.Errorf("drift: create the log directory: %w", err)
+	}
+	childLog := logPathFor(req.Paths.LogsDir, "capture-child", time.Now())
+	logFile, err := os.OpenFile(childLog, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		return 0, fmt.Errorf("drift: open the capture child log: %w", err)
+	}
+	defer logFile.Close()
+
+	argv := []string{req.Executable, "drift", "capture-child"}
+	child, err := req.startChild(childSpawn{argv: argv, dir: req.WorktreeRoot, log: logFile, breakaway: true})
+	if err != nil && req.refusedBreakaway(err) {
+		if !req.FallbackDetach {
+			return 0, fmt.Errorf("%w: %v", ErrBreakawayRefused, err)
+		}
+		logger.Warn("drift: the capture child was refused breakaway, so it lives only as long as the shell's job", "error", err.Error())
+		child, err = req.startChild(childSpawn{argv: argv, dir: req.WorktreeRoot, log: logFile})
+	}
+	if err != nil {
+		return 0, fmt.Errorf("drift: start the capture child: %w", err)
+	}
+	logger.Info("drift: capture child spawned", "pid", child.pid, "executable", req.Executable, "log", childLog)
+	if err := runproc.Register(req.RunProcDir, req.Owner, runproc.ChildRecord(child.pid, runproc.RoleCapture, argv)); err != nil {
+		logger.Warn("drift: registering the capture child failed", "pid", child.pid, "error", err.Error())
+	}
+
+	return child.pid, awaitRunningRecord(req, child, childLog)
+}
+
+// awaitRunningRecord polls the capture record until it carries the child's pid.
+// A capture that failed between two polls still carries it, so any state counts as the start.
+// It fails when the child ends first or RecordWait runs out, naming the child's log and the caller's way forward.
+func awaitRunningRecord(req SpawnRequest, child spawnedChild, childLog string) error {
+	reads := func() bool {
+		rec, found, err := ReadCapture(req.Paths)
+		return err == nil && found && rec.Pid == child.pid
+	}
+	deadline := time.NewTimer(req.RecordWait)
+	defer deadline.Stop()
+
+	for {
+		if reads() {
+			return nil
+		}
+		select {
+		case <-time.After(req.Poll):
+		case <-child.exited:
+			if reads() {
+				return nil
+			}
+			return startFailure(req, childLog, "ended before it recorded its start")
+		case <-deadline.C:
+			if reads() {
+				return nil
+			}
+			return startFailure(req, childLog, "did not record its start within "+req.RecordWait.String())
+		}
+	}
+}
+
+// startFailure builds the error of a capture child that did not record its start, with its caller's way forward.
+func startFailure(req SpawnRequest, childLog, what string) error {
+	wayForward := "read " + childLog + ", then lyx loom resume, whose entry captures again"
+	if req.FallbackDetach {
+		wayForward = "read " + childLog + ", then, once lyx drift status shows the capture lock free, run lyx drift capture again, or lyx drift defer followed by lyx loom resume"
+	}
+	return fmt.Errorf("drift: the capture child %s; way forward: %s", what, wayForward)
+}
+
+// startChild starts the child through the spawn seam, or as the real command when none is set.
+func (r SpawnRequest) startChild(spec childSpawn) (spawnedChild, error) {
+	if r.spawn != nil {
+		return r.spawn(spec)
+	}
+	cmd := exec.Command(spec.argv[0], spec.argv[1:]...)
+	cmd.Dir = spec.dir
+	cmd.Stdout, cmd.Stderr = spec.log, spec.log
+	if spec.breakaway {
+		proc.DetachBreakaway(cmd)
+	} else {
+		proc.Detach(cmd)
+	}
+	if err := cmd.Start(); err != nil {
+		return spawnedChild{}, err
+	}
+	pid := cmd.Process.Pid
+	exited := make(chan struct{})
+	go func() {
+		waitErr := cmd.Wait()
+		logger.Info("drift: capture child exited", "pid", pid, "error", errorText(waitErr))
+		close(exited)
+	}()
+	return spawnedChild{pid: pid, exited: exited}, nil
+}
+
+// refusedBreakaway reports whether err is a start refused for breakaway.
+func (r SpawnRequest) refusedBreakaway(err error) bool {
+	if r.breakawayRefused != nil {
+		return r.breakawayRefused(err)
+	}
+	return proc.IsBreakawayRefused(err)
+}
+
+// CaptureJobName returns the Windows job-object name of a worktree's capture: "lyx-drift-capture-" followed by a hex hash of the worktree root.
+func CaptureJobName(worktreeRoot string) string {
+	sum := sha256.Sum256([]byte(worktreeRoot))
+	return "lyx-drift-capture-" + hex.EncodeToString(sum[:8])
+}
+
+// ProbeLock reports whether the OS lock at path is held, by taking it without blocking and releasing it at once.
+// A missing lock file or directory reads as not held and creates nothing.
+func ProbeLock(path string) (bool, error) {
+	if _, err := os.Stat(path); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return false, nil
+		}
+		return false, fmt.Errorf("drift: probe %s: %w", filepath.Base(path), err)
+	}
+	probe, taken, err := lock.TryAcquireWriteLock(path)
+	if err != nil {
+		return false, err
+	}
+	if !taken {
+		return true, nil
+	}
+	return false, probe.Release()
+}
+
+// Active reports whether a capture or a compare is running or queued for a slot.
+func Active(p Paths) (bool, error) {
+	for _, path := range []string{p.CaptureLock, p.CompareMarker} {
+		held, err := ProbeLock(path)
+		if err != nil || held {
+			return held, err
+		}
+	}
+	return false, nil
+}
diff --git a/internal/driftengine/spawn_test.go b/internal/driftengine/spawn_test.go
new file mode 100644
index 000000000..1fcced637
--- /dev/null
+++ b/internal/driftengine/spawn_test.go
@@ -0,0 +1,194 @@
+//go:build tier0
+
+// spawn_test.go — tier 0 tests for StartCapture, driven through its spawn and breakaway seams, and for ProbeLock.
+
+package driftengine
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/runproc"
+)
+
+// spawnFixture is a StartCapture request over temp directories with a recording fake child.
+type spawnFixture struct {
+	req    SpawnRequest
+	spawns []childSpawn
+}
+
+// newSpawnFixture returns a fixture whose fake child is the test process, so its runproc record stays alive.
+// onSpawn runs inside the seam and returns the child's exit channel.
+func newSpawnFixture(t *testing.T, onSpawn func(f *spawnFixture, spec childSpawn) (<-chan struct{}, error)) *spawnFixture {
+	t.Helper()
+	f := &spawnFixture{}
+	root := t.TempDir()
+	f.req = SpawnRequest{
+		Executable:       "lyx",
+		WorktreeRoot:     root,
+		Paths:            NewPaths(root),
+		RunProcDir:       t.TempDir(),
+		Owner:            "slug",
+		RecordWait:       5 * time.Second,
+		Poll:             time.Millisecond,
+		breakawayRefused: func(err error) bool { return strings.Contains(err.Error(), "refused") },
+		spawn: func(spec childSpawn) (spawnedChild, error) {
+			f.spawns = append(f.spawns, spec)
+			exited, err := onSpawn(f, spec)
+			return spawnedChild{pid: os.Getpid(), exited: exited}, err
+		},
+	}
+	return f
+}
+
+// writeRunning writes the capture record a child writes after its precondition held.
+func writeRunning(t *testing.T, p Paths, pid int) {
+	t.Helper()
+	if err := WriteCapture(p, CaptureRecord{State: CaptureRunning, Pid: pid}); err != nil {
+		t.Errorf("WriteCapture() = %v; want nil", err)
+	}
+}
+
+// TestStartCapture covers the child's argv and run-process record, the wait for the child's own running record, a child that ends or stalls before it, a lock held before the start, and both breakaway branches.
+func TestStartCapture(t *testing.T) {
+	t.Parallel()
+
+	t.Run("it returns the pid once the child writes running with its pid", func(t *testing.T) {
+		t.Parallel()
+		release := make(chan struct{})
+		spawned := make(chan struct{})
+		f := newSpawnFixture(t, func(f *spawnFixture, _ childSpawn) (<-chan struct{}, error) {
+			writeRunning(t, f.req.Paths, os.Getpid()+1)
+			go func() {
+				<-release
+				writeRunning(t, f.req.Paths, os.Getpid())
+			}()
+			close(spawned)
+			return make(chan struct{}), nil
+		})
+
+		type result struct {
+			pid int
+			err error
+		}
+		done := make(chan result, 1)
+		go func() {
+			pid, err := StartCapture(f.req)
+			done <- result{pid, err}
+		}()
+		<-spawned
+		select {
+		case got := <-done:
+			t.Fatalf("StartCapture() returned %+v before the child wrote its record; want it to wait", got)
+		case <-time.After(50 * time.Millisecond):
+		}
+		close(release)
+
+		got := <-done
+		if got.err != nil || got.pid != os.Getpid() {
+			t.Fatalf("StartCapture() = %d, %v; want %d, nil", got.pid, got.err, os.Getpid())
+		}
+		if want := []string{"lyx", "drift", "capture-child"}; len(f.spawns) != 1 || strings.Join(f.spawns[0].argv, " ") != strings.Join(want, " ") || !f.spawns[0].breakaway {
+			t.Errorf("spawns = %+v; want one breakaway start of %v", f.spawns, want)
+		}
+		records, err := runproc.List(f.req.RunProcDir, f.req.Owner)
+		if err != nil || len(records) != 1 || records[0].Role != runproc.RoleCapture || records[0].PID != os.Getpid() {
+			t.Errorf("runproc.List() = %+v, %v; want one %q record of the child", records, err, runproc.RoleCapture)
+		}
+	})
+
+	failures := []struct {
+		name     string
+		fallback bool
+		exits    bool
+		want     []string
+	}{
+		{"a child that exits without its record, no fallback", false, true, []string{"ended before it recorded its start", "capture-child-", "lyx loom resume, whose entry captures again"}},
+		{"a child that exits without its record, with fallback", true, true, []string{"ended before it recorded its start", "capture-child-", "lyx drift capture again", "lyx drift defer followed by lyx loom resume"}},
+		{"a child that stalls past the record bound, no fallback", false, false, []string{"did not record its start within", "lyx loom resume, whose entry captures again"}},
+		{"a child that stalls past the record bound, with fallback", true, false, []string{"did not record its start within", "lyx drift capture again"}},
+	}
+	for _, tt := range failures {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newSpawnFixture(t, func(*spawnFixture, childSpawn) (<-chan struct{}, error) {
+				exited := make(chan struct{})
+				if tt.exits {
+					close(exited)
+				}
+				return exited, nil
+			})
+			f.req.FallbackDetach = tt.fallback
+			f.req.RecordWait = 30 * time.Millisecond
+
+			_, err := StartCapture(f.req)
+			if err == nil {
+				t.Fatalf("StartCapture() = nil; want an error")
+			}
+			for _, want := range tt.want {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("StartCapture() error = %q; want it to contain %q", err.Error(), want)
+				}
+			}
+		})
+	}
+
+	t.Run("a lock held before the start refuses with nothing spawned", func(t *testing.T) {
+		t.Parallel()
+		f := newSpawnFixture(t, func(*spawnFixture, childSpawn) (<-chan struct{}, error) { return nil, nil })
+		if err := os.MkdirAll(filepath.Dir(f.req.Paths.CaptureLock), 0o755); err != nil {
+			t.Fatalf("MkdirAll() = %v; want nil", err)
+		}
+		held, err := lock.AcquireWriteLock(f.req.Paths.CaptureLock)
+		if err != nil {
+			t.Fatalf("AcquireWriteLock() = %v; want nil", err)
+		}
+		defer held.Release()
+
+		_, err = StartCapture(f.req)
+		if err == nil || !strings.Contains(err.Error(), "a capture already holds") {
+			t.Errorf("StartCapture() error = %v; want the held-lock refusal", err)
+		}
+		if len(f.spawns) != 0 {
+			t.Errorf("spawns = %+v; want none", f.spawns)
+		}
+	})
+
+	t.Run("a breakaway refusal is ErrBreakawayRefused, or retries detached with a fallback", func(t *testing.T) {
+		t.Parallel()
+		refuseBreakaway := func(f *spawnFixture, spec childSpawn) (<-chan struct{}, error) {
+			if spec.breakaway {
+				return nil, errors.New("access refused")
+			}
+			writeRunning(t, f.req.Paths, os.Getpid())
+			return make(chan struct{}), nil
+		}
+
+		f := newSpawnFixture(t, refuseBreakaway)
+		if _, err := StartCapture(f.req); !errors.Is(err, ErrBreakawayRefused) || len(f.spawns) != 1 {
+			t.Errorf("StartCapture() without fallback = %v after %d spawns; want ErrBreakawayRefused after 1", err, len(f.spawns))
+		}
+
+		f = newSpawnFixture(t, refuseBreakaway)
+		f.req.FallbackDetach = true
+		if pid, err := StartCapture(f.req); err != nil || pid != os.Getpid() || len(f.spawns) != 2 || f.spawns[1].breakaway {
+			t.Errorf("StartCapture() with fallback = %d, %v after %+v; want a plain detached second start", pid, err, f.spawns)
+		}
+	})
+
+	t.Run("ProbeLock reads a missing directory as free and creates nothing", func(t *testing.T) {
+		t.Parallel()
+		missing := filepath.Join(t.TempDir(), "absent", "capture.lock")
+		if held, err := ProbeLock(missing); held || err != nil {
+			t.Errorf("ProbeLock() = %v, %v; want false, nil", held, err)
+		}
+		if _, err := os.Stat(filepath.Dir(missing)); !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("ProbeLock() created %s; want nothing created", filepath.Dir(missing))
+		}
+	})
+}
