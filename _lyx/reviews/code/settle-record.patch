diff --git a/internal/lymtemp/lymtemp.go b/internal/lymtemp/lymtemp.go
new file mode 100644
index 000000000..d274ae47a
--- /dev/null
+++ b/internal/lymtemp/lymtemp.go
@@ -0,0 +1,70 @@
+// lymtemp.go — the process-wide run directory: Dir, MkdirTemp, CreateTemp and Remove.
+
+package lymtemp
+
+import (
+	"fmt"
+	"os"
+	"sync"
+)
+
+var (
+	// processMu guards processRun.
+	processMu sync.Mutex
+	// processRun is the process's run directory, nil until Dir first creates it.
+	processRun *run
+)
+
+// Dir returns the process's run directory, creating it, and the temp root above it, on first use.
+// Later calls return the same path until Remove clears it.
+func Dir() (string, error) {
+	processMu.Lock()
+	defer processMu.Unlock()
+	if processRun != nil {
+		return processRun.dir, nil
+	}
+	root, err := ProcessRoot()
+	if err != nil {
+		return "", err
+	}
+	created, err := root.newRun()
+	if err != nil {
+		return "", err
+	}
+	processRun = created
+	return created.dir, nil
+}
+
+// MkdirTemp creates a new directory under the process's run directory, as os.MkdirTemp does for pattern.
+func MkdirTemp(pattern string) (string, error) {
+	dir, err := Dir()
+	if err != nil {
+		return "", err
+	}
+	return os.MkdirTemp(dir, pattern)
+}
+
+// CreateTemp creates a new file under the process's run directory, as os.CreateTemp does for pattern.
+func CreateTemp(pattern string) (*os.File, error) {
+	dir, err := Dir()
+	if err != nil {
+		return nil, err
+	}
+	return os.CreateTemp(dir, pattern)
+}
+
+// Remove releases and deletes the process's run directory and forgets it, so a later Dir makes a fresh one.
+// It returns nil when no run directory was created.
+func Remove() error {
+	processMu.Lock()
+	defer processMu.Unlock()
+	if processRun == nil {
+		return nil
+	}
+	current := processRun
+	processRun = nil
+	if err := current.remove(); err != nil {
+		return fmt.Errorf("remove run directory: %w", err)
+	}
+	return nil
+}
diff --git a/internal/lymtemp/root.go b/internal/lymtemp/root.go
new file mode 100644
index 000000000..98e224086
--- /dev/null
+++ b/internal/lymtemp/root.go
@@ -0,0 +1,73 @@
+// root.go — the per-user temp root: where it lives, how it is created and the checks it must pass.
+
+package lymtemp
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Root is a lym temp root directory that run directories live under.
+type Root struct {
+	path string
+	now  func() time.Time
+	// remove, retryNow and sleep are the sweep's removal, retry-budget clock and retry pause, replaceable so a test retries without waiting.
+	remove   func(string) error
+	retryNow func() time.Time
+	sleep    func(time.Duration)
+	// runName draws a candidate run directory name, replaceable so a test forces a taken one.
+	runName func() string
+}
+
+// Path returns the root's absolute path.
+func (r *Root) Path() string {
+	return r.path
+}
+
+// ProcessRoot opens the temp root for the current user under the system temp directory, creating it when absent.
+// It fails, creating nothing, when the root exists but is not a private directory of the user.
+func ProcessRoot() (*Root, error) {
+	uid := os.Getuid()
+	return openRoot(resolveRootPath(os.TempDir(), uid), uid, time.Now)
+}
+
+// openRoot creates the root at path with mode 0700 when absent, then checks it, whatever created it.
+// now is the clock the root's sweep reads.
+func openRoot(path string, uid int, now func() time.Time) (*Root, error) {
+	if err := os.Mkdir(path, 0o700); err != nil && !errors.Is(err, fs.ErrExist) {
+		return nil, fmt.Errorf("create lym temp root %q: %w", path, err)
+	}
+	if err := checkRoot(path, uid); err != nil {
+		return nil, err
+	}
+	return &Root{path: path, now: now, remove: os.RemoveAll, retryNow: time.Now, sleep: time.Sleep, runName: randomRunName}, nil
+}
+
+// resolveRootPath returns the root path under tempDir.
+// When tempDir is itself a run directory under a lym root, it returns that root, so a child that inherited a run directory as its system temp directory works beside its parent.
+func resolveRootPath(tempDir string, uid int) string {
+	if strings.HasPrefix(filepath.Base(tempDir), runPrefix) {
+		parent := filepath.Dir(tempDir)
+		if filepath.Base(parent) == rootName(uid) {
+			return parent
+		}
+	}
+	return filepath.Join(tempDir, rootName(uid))
+}
+
+// checkRealDirectory fails unless path is a directory that is neither a link nor an irregular file.
+func checkRealDirectory(path string) (fs.FileInfo, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, fmt.Errorf("lym temp root %q: %w", path, err)
+	}
+	if info.Mode()&(os.ModeSymlink|os.ModeIrregular) != 0 || !info.IsDir() {
+		return nil, fmt.Errorf("lym temp root %q is not a real directory", path)
+	}
+	return info, nil
+}
