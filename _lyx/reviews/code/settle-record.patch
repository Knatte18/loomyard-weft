+		a := fixedOutcomeProducer(Done, "")
+		shed.Producers = []ProducerDef{{Name: "A", Producer: a, EntryGate: broken.evaluate}}
+		seedStatus(t, statusPath, statusLockPath, commonSeed("A"))
