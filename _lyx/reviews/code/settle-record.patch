+	if len(targets) > 0 {
+		if geometry, inHub := hubgeom.ReconcileGeometry(targets[0].Location); inHub {
+			if err := hubreconcile.Ensure(geometry, hubreconcile.Options{}); err != nil {
+				return nil, fmt.Errorf("lyx beam start: %w", err)
+			}
+		}
+	}
