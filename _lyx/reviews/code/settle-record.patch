@@ -0,0 +1,207 @@
+//go:build tier0
+
+// starts_test.go pins the start condition of a board task and the start step's cap, refusal notices and backoff.
+
+package dobbyengine
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestReadyToStart(t *testing.T) {
+	t.Parallel()
+	draft := "draft"
+	empty := ""
+	ready := TaskView{Slug: "task", Kind: "task", Status: &empty, DependenciesDone: true, Parent: "prime"}
+
+	tests := []struct {
+		name    string
+		mutate  func(*TaskView)
+		covered bool
+		want    bool
+	}{
+		{"EmptyStatusWithDoneDependenciesStarts", nil, false, true},
+		{"AbsentStatusStarts", func(task *TaskView) { task.Status = nil }, false, true},
+		{"DraftDoesNotStart", func(task *TaskView) { task.Status = &draft }, false, false},
+		{"OpenDependencyDoesNotStart", func(task *TaskView) { task.DependenciesDone = false }, false, false},
+		{"CoveringPauseDoesNotStart", nil, true, false},
+		{"OwnedElsewhereDoesNotStart", func(task *TaskView) { task.OwnedElsewhere = true }, false, false},
+		{"AnotherBeamsTaskDoesNotStart", func(task *TaskView) { task.Parent = "other-beam" }, false, false},
+		{"AProjectDoesNotStart", func(task *TaskView) { task.Kind = "project" }, false, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			task := ready
+			if tt.mutate != nil {
+				tt.mutate(&task)
+			}
+			if got := readyToStart(task, "prime", tt.covered); got != tt.want {
+				t.Errorf("readyToStart() = %v; want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNextStartTry(t *testing.T) {
+	t.Parallel()
+	now := time.Date(2026, 10, 25, 12, 0, 0, 0, time.UTC)
+	probe := 10 * time.Second
+
+	first := nextStartTry(StartState{}, now, probe)
+	second := nextStartTry(first, now, probe)
+	capped := nextStartTry(StartState{Interval: 40 * time.Minute}, now, probe)
+	if first.Interval != probe || !first.NextTry.Equal(now.Add(probe)) {
+		t.Errorf("first retry = %+v; want one probe interval", first)
+	}
+	if second.Interval != 2*probe {
+		t.Errorf("second retry interval = %v; want twice the probe interval", second.Interval)
+	}
+	if capped.Interval != time.Hour {
+		t.Errorf("capped retry interval = %v; want an hour", capped.Interval)
+	}
+}
+
+// readyTask is a board entry that is ready to start under the prime's dobby.
+func readyTask(slug string) TaskView {
+	empty := ""
+	return TaskView{Slug: slug, Kind: "task", Status: &empty, DependenciesDone: true, Parent: "prime", Fingerprint: slug + "-v1"}
+}
+
+func TestStartReady_RefusalsAndBackoff(t *testing.T) {
+	t.Parallel()
+	refused := func(text string) PassExit { return PassExit{Code: 1, Error: text} }
+
+	t.Run("a fourth ready task past max_runs waits", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t)
+		h.fake.tasks = []TaskView{readyTask("a"), readyTask("b"), readyTask("c"), readyTask("d")}
+		h.tick(true)
+		if got := len(h.fake.spawned); got != 3 || len(h.fake.spawnsOf("d")) != 0 {
+			t.Errorf("first passes = %+v; want the first three tasks only", h.fake.spawned)
+		}
+	})
+
+	t.Run("max_runs 0 starts nothing", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t)
+		h.fake.maxRuns = 0
+		h.fake.tasks = []TaskView{readyTask("a")}
+		h.tick(true)
+		if len(h.fake.spawned) != 0 {
+			t.Errorf("first passes = %+v; want none", h.fake.spawned)
+		}
+	})
+
+	t.Run("a refused first pass notices once and retries after the probe interval, then after twice it, and at once after an entry change", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t)
+		h.fake.tasks = []TaskView{readyTask("a")}
+		h.fake.exits = []PassExit{refused("pre-run refused"), refused("pre-run refused"), refused("pre-run refused")}
+
+		h.tick(true)
+		h.tick(true)
+		if len(h.fake.spawned) != 1 || len(h.fake.notices) != 1 || h.fake.notices[0] != "a: dobby could not start the task: pre-run refused" {
+			t.Fatalf("passes, notices after the first refusal = %d, %q; want 1 pass and the one notice", len(h.fake.spawned), h.fake.notices)
+		}
+		h.tick(true)
+		if len(h.fake.spawned) != 2 {
+			t.Fatalf("passes one probe interval after the refusal = %d; want the retry, 2", len(h.fake.spawned))
+		}
+		h.tick(true)
+		h.tick(true)
+		if len(h.fake.spawned) != 2 {
+			t.Fatalf("passes inside the doubled wait = %d; want still 2", len(h.fake.spawned))
+		}
+		h.tick(true)
+		if len(h.fake.spawned) != 3 {
+			t.Fatalf("passes after the doubled wait = %d; want the third", len(h.fake.spawned))
+		}
+		if len(h.fake.notices) != 1 {
+			t.Errorf("notices = %d; want the one text noticed once", len(h.fake.notices))
+		}
+
+		h.tick(true)
+		h.fake.tasks[0].Fingerprint = "a-v2"
+		h.tick(true)
+		if len(h.fake.spawned) != 4 {
+			t.Errorf("passes after the entry changed = %d; want one at once, 4", len(h.fake.spawned))
+		}
+	})
+
+	t.Run("a covered first pass notices nothing and sets no backoff", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t)
+		h.fake.tasks = []TaskView{readyTask("a")}
+		h.fake.exits = []PassExit{{Code: PassExitCovered}}
+		h.tick(true)
+		h.tick(true)
+		if len(h.fake.notices) != 0 || len(h.fake.spawned) != 2 {
+			t.Errorf("notices, passes = %d, %d; want no notice and an immediate second start", len(h.fake.notices), len(h.fake.spawned))
+		}
+	})
+
+	t.Run("an owned-elsewhere first pass with no status file is a refused start with one notice and no pause", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t)
+		h.fake.tasks = []TaskView{readyTask("a")}
+		h.fake.exits = []PassExit{{Code: PassExitOwnedElsewhere, Error: "owned by m2"}}
+		h.tick(true)
+		h.tick(true)
+		if len(h.fake.notices) != 1 || h.fake.pauses != 0 {
+			t.Errorf("notices, pauses = %d, %d; want 1, 0", len(h.fake.notices), h.fake.pauses)
+		}
+	})
+
+	t.Run("a run marked owned elsewhere leaves a slot under max_runs free", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("held"))
+		h.fake.maxRuns = 1
+		h.fake.tasks = []TaskView{readyTask("a")}
+		h.tick(false)
+		if len(h.fake.spawnsOf("a")) != 0 {
+			t.Fatalf("a task started past max_runs with one run in flight")
+		}
+
+		err := UpdateState(h.d.geom.StatePath, func(s *State) error {
+			s.Runs = map[string]RunState{"held": {OwnedElsewhere: true}}
+			return nil
+		})
+		if err != nil {
+			t.Fatalf("UpdateState() = %v; want nil", err)
+		}
+		h.tick(false)
+		if len(h.fake.spawnsOf("a")) != 1 {
+			t.Errorf("passes of the ready task = %d; want it started in the freed slot", len(h.fake.spawnsOf("a")))
+		}
+	})
+
+	t.Run("two refusals with different texts send two notices, and a claim clears the noticed texts", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t)
+		h.fake.tasks = []TaskView{readyTask("a")}
+		h.fake.exits = []PassExit{refused("first text"), refused("second text"), {}, refused("first text")}
+		later := func() { h.clock.sleep(context.Background(), time.Hour) }
+
+		h.tick(true)
+		h.tick(true)
+		later()
+		h.tick(true)
+		h.tick(true)
+		if len(h.fake.notices) != 2 {
+			t.Fatalf("notices after two different texts = %d; want 2", len(h.fake.notices))
+		}
+
+		later()
+		h.fake.statuses["a"] = true
+		h.tick(true)
+		h.tick(true)
+		h.fake.statuses["a"] = false
+		h.tick(true)
+		if len(h.fake.notices) != 3 {
+			t.Errorf("notices after the claim and the same text again = %d; want it noticed again, 3", len(h.fake.notices))
+		}
+	})
+}
diff --git a/internal/dobbyengine/state.go b/internal/dobbyengine/state.go
new file mode 100644
index 000000000..e67ef535e
--- /dev/null
+++ b/internal/dobbyengine/state.go
@@ -0,0 +1,105 @@
+// state.go declares dobby's tolerant JSON state record and its locked read and read-modify-write.
+
+package dobbyengine
+
+import (
+	"errors"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// State is dobby's record of one beam worktree.
+// It is written only through UpdateState, which keeps the keys a newer binary wrote that this type does not declare.
+type State struct {
+	// PID and StartTime identify the dobby process that last recorded itself.
+	PID       int    `json:"pid"`
+	StartTime string `json:"start_time"`
+	// Sleeps are the sleep intervals dobby saw, for the idle clocks of the runs it drives.
+	Sleeps []pauserecord.Interval `json:"sleeps,omitempty"`
+	// Runs is the per-run record, keyed by slug.
+	Runs map[string]RunState `json:"runs,omitempty"`
+	// Starts is the per-task start record, keyed by slug.
+	Starts map[string]StartState `json:"starts,omitempty"`
+	// CountedLandings holds the slugs of the runs whose landing the tidy count has seen.
+	CountedLandings map[string]bool `json:"counted_landings,omitempty"`
+	// LandingsBaselined reports whether the landings already in the run records when the record was created were marked seen.
+	LandingsBaselined bool `json:"landings_baselined,omitempty"`
+	// LandedSinceTidy holds the slugs landed since the last board tidy.
+	LandedSinceTidy []string `json:"landed_since_tidy,omitempty"`
+	// Tidy is the board-tidy agent in flight, nil when none is.
+	Tidy *TidyState `json:"tidy,omitempty"`
+}
+
+// RunState is dobby's record of one run it drives.
+type RunState struct {
+	// FullPassOwed reports whether the next pass of the run must be a full pass.
+	FullPassOwed bool `json:"full_pass_owed,omitempty"`
+	// OwnedElsewhere reports whether the run reads as owned by another machine.
+	OwnedElsewhere bool `json:"owned_elsewhere,omitempty"`
+	// OwnerNoticeSent reports whether the owned-elsewhere notice went out.
+	OwnerNoticeSent bool `json:"owner_notice_sent,omitempty"`
+	// OwnerPauseFailed reports whether the pause for an owned-elsewhere run failed.
+	OwnerPauseFailed bool `json:"owner_pause_failed,omitempty"`
+	// LastPassExit is when the last pass of the run exited.
+	LastPassExit time.Time `json:"last_pass_exit,omitzero"`
+	// FailingPassError is the error text of the failing pass and FailingPassCount the passes that failed in a row with it.
+	FailingPassError string `json:"failing_pass_error,omitempty"`
+	FailingPassCount int    `json:"failing_pass_count,omitempty"`
+	// Noticed holds the failing-pass texts already noticed.
+	Noticed []string `json:"noticed,omitempty"`
+}
+
+// StartState is dobby's record of one task it tries to start.
+type StartState struct {
+	// NextTry is the earliest time of the next start attempt.
+	NextTry time.Time `json:"next_try,omitzero"`
+	// Interval is the backoff between attempts.
+	Interval time.Duration `json:"interval,omitempty"`
+	// Noticed holds the refusal texts already noticed.
+	Noticed []string `json:"noticed,omitempty"`
+	// EntryFingerprint is the fingerprint of the board entry the last attempt read.
+	EntryFingerprint string `json:"entry_fingerprint,omitempty"`
+}
+
+// TidyState is the board-tidy agent in flight.
+type TidyState struct {
+	StrandGUID string    `json:"strand_guid"`
+	ReportPath string    `json:"report_path"`
+	Deadline   time.Time `json:"deadline"`
+}
+
+// ReadState reads the record at path under its lock and reports whether it was found.
+// An absent file and a file that does not decode both read as not found; the latter logs one Warn.
+func ReadState(path string) (State, bool, error) {
+	current, found, err := state.ReadJSON[State](path, lockPath(path))
+	if errors.Is(err, state.ErrDecode) {
+		logger.Warn("dobbyengine: the state record does not decode and reads as absent", "path", path, "error", err)
+		return State{}, false, nil
+	}
+	return current, found, err
+}
+
+// UpdateState applies mutate to the record at path under the record's lock and writes the result, keeping the keys the State type does not declare.
+// A record that does not decode logs one Warn and is replaced by mutate's result over a fresh State.
+func UpdateState(path string, mutate func(*State) error) error {
+	err := state.UpdateJSON(path, lockPath(path), func(current State, _ bool) (State, error) {
+		if err := mutate(&current); err != nil {
+			return State{}, err
+		}
+		return current, nil
+	})
+	if !errors.Is(err, state.ErrDecode) {
+		return err
+	}
+	logger.Warn("dobbyengine: the state record does not decode and is rewritten fresh", "path", path, "error", err)
+	var fresh State
+	if err := mutate(&fresh); err != nil {
+		return err
+	}
+	return state.WriteJSON(path, lockPath(path), fresh)
+}
+
+func lockPath(path string) string { return path + ".lock" }
