+//go:build tier1
+
+// anchor_integration_test.go drives `lyx fabric anchor` through RunCLIIn over hubforge hubs:
+// the print and the move of a pair, a child forked before its parent's move, and the integration of a prime's move on a second clone.
+// A hub's prime warp tracks sub/ and is pushed before any second clone is made, so sub is a directory git tracks in every checkout.
+// Package fabriccli_test, sharing the single TestMain in testmain_test.go.
+
+package fabriccli_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/fslink"
+	"github.com/Knatte18/loomyard/internal/gitkit"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/lyxdirs"
+	"github.com/Knatte18/loomyard/internal/testkit/envelope"
+)
+
+// newAnchorCLIHub builds a "." hub whose prime warp tracks sub/, with the prime's warp and records branches pushed to the hub's remotes.
+func newAnchorCLIHub(t *testing.T) *hubforge.Hub {
+	t.Helper()
+
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	gitkit.CommitFile(t, h.PrimeWorktree(), "sub/.keep", "", "track sub")
+	if _, err := fabricengine.CoalescePushBothAt(h.PrimeWorktree(), h.PrimeRecords(), fabricengine.SyncOptions{}); err != nil {
+		t.Fatalf("push the prime: %v", err)
+	}
+	return h
+}
+
+// requireAnchorOK runs the verb from cwd, requires exit 0 and returns the decoded envelope.
+func requireAnchorOK(t *testing.T, cwd string, args ...string) envelope.Envelope {
+	t.Helper()
+
+	code, output := runFabric(t, cwd, append([]string{"anchor"}, args...)...)
+	if code != 0 {
+		t.Fatalf("RunCLI(anchor %s) = %d; want 0\noutput: %s", strings.Join(args, " "), code, output)
+	}
+	return envelope.RequireOK(t, output)
+}
+
+func TestRunCLI_Anchor(t *testing.T) {
+	t.Parallel()
+
+	t.Run("The verb prints the anchor and moves a pair to sub", func(t *testing.T) {
+		t.Parallel()
+		h := newAnchorCLIHub(t)
+		hubforge.AddPair(t, h, "mover")
+		primeName := h.Location.WorktreeName
+
+		printed := requireAnchorOK(t, h.PrimeWorktree())
+		if printed.Raw["slug"] != primeName || printed.Raw["anchor"] != "." {
+			t.Errorf("anchor printed = %v; want the acting prime's anchor .", printed.Raw)
+		}
+		if named := requireAnchorOK(t, h.PrimeWorktree(), "mover"); named.Raw["anchor"] != "." {
+			t.Errorf("anchor mover printed = %v; want .", named.Raw)
+		}
+
+		moved := requireAnchorOK(t, h.PrimeWorktree(), "mover", "--set", "sub")
+
+		if moved.Raw["changed"] != true || moved.Raw["anchor"] != "sub" || moved.Raw["from"] != "." {
+			t.Errorf("anchor --set sub envelope = %v; want a change from . to sub", moved.Raw)
+		}
+		weft := h.PairRecordsSibling("mover")
+		if marker := gitkit.Git(t, weft, "show", "HEAD:"+lyxcwd.AnchorFileName); marker != "sub" {
+			t.Errorf("committed marker = %q; want sub", marker)
+		}
+		for _, name := range []string{lyxdirs.LyxDirName, lyxdirs.DotLyxDirName} {
+			if isLink, err := fslink.IsLink(filepath.Join(h.PairCodeWorktree("mover"), "sub", name)); err != nil || !isLink {
+				t.Errorf("%s at sub is no link (%v); want the pair wired there", name, err)
+			}
+			if _, err := os.Lstat(filepath.Join(h.PairCodeWorktree("mover"), name)); !os.IsNotExist(err) {
+				t.Errorf("%s at the old anchor: %v; want it gone", name, err)
+			}
+		}
+		if _, err := os.Stat(filepath.Join(h.Path, "_launchers", "sub", "mover")); err != nil {
+			t.Errorf("launcher directory at sub: %v; want it", err)
+		}
+		if again := requireAnchorOK(t, h.PrimeWorktree(), "mover"); again.Raw["anchor"] != "sub" {
+			t.Errorf("anchor mover printed after the move = %v; want sub", again.Raw)
+		}
+		if noop := requireAnchorOK(t, h.PrimeWorktree(), "mover", "--set", "sub"); noop.Raw["noop"] != true || noop.Raw["changed"] != false {
+			t.Errorf("anchor --set sub again = %v; want a no-op", noop.Raw)
+		}
+	})
+
+	t.Run("A child forked before its parent's move keeps its anchor, and merging it into the parent leaves the parent's", func(t *testing.T) {
+		t.Parallel()
+		h := newAnchorCLIHub(t)
+		hubforge.AddPair(t, h, "parent")
+		hubforge.AddPairWith(t, h, "child", fabricengine.AddOptions{Parent: "parent"})
+		requireAnchorOK(t, h.PrimeWorktree(), "parent", "--set", "sub")
+
+		child, err := lyxcwd.NamedWorktree(h.Path, "child")
+		if err != nil || child.AnchorRel != "." {
+			t.Fatalf("anchor of the child = (%v, %v); want . kept", child, err)
+		}
+		if marker := gitkit.Git(t, h.PairRecordsSibling("child"), "show", "HEAD:"+lyxcwd.AnchorFileName); marker != "." {
+			t.Errorf("committed marker of the child = %q; want .", marker)
+		}
+		noteDir := filepath.Join(h.PairCodeWorktree("child"), lyxdirs.LyxDirName)
+		if err := os.WriteFile(filepath.Join(noteDir, "child-note.txt"), []byte("note\n"), 0o644); err != nil {
+			t.Fatalf("write the child's record: %v", err)
+		}
+		if code, output := runFabric(t, h.PairCodeWorktree("child"), "commit"); code != 0 {
+			t.Fatalf("RunCLI(commit) in the child = %d; want 0\noutput: %s", code, output)
+		}
+		if got := gitkit.Git(t, h.PairRecordsSibling("child"), "show", "HEAD:"+lyxdirs.LyxDirName+"/child-note.txt"); got != "note" {
+			t.Errorf("child-note.txt in the child's weft at its anchor = %q; want the record committed there", got)
+		}
+
+		gitkit.CommitFile(t, h.PairCodeWorktree("child"), "child-only.txt", "child\n", "child work")
+		childBranch := gitkit.CurrentBranch(t, h.PairCodeWorktree("child"))
+		parentAnchor := filepath.Join(h.PairCodeWorktree("parent"), "sub")
+		if code, output := runFabric(t, parentAnchor, "merge", childBranch); code != 0 {
+			t.Fatalf("RunCLI(merge %s) in the parent = %d; want 0\noutput: %s", childBranch, code, output)
+		}
+
+		if marker := gitkit.Git(t, h.PairRecordsSibling("parent"), "show", "HEAD:"+lyxcwd.AnchorFileName); marker != "sub" {
+			t.Errorf("committed marker of the parent after the merge = %q; want sub, the weft being no merge participant", marker)
+		}
+		if parent, err := lyxcwd.NamedWorktree(h.Path, "parent"); err != nil || parent.AnchorRel != "sub" {
+			t.Errorf("anchor of the parent after the merge = (%v, %v); want sub", parent, err)
+		}
+		if _, err := os.Stat(filepath.Join(h.PairCodeWorktree("parent"), "child-only.txt")); err != nil {
+			t.Errorf("the child's warp commit is not in the parent: %v", err)
+		}
+	})
+
+	t.Run("A second clone stops at the prime's move and integrates it with its own records commits", func(t *testing.T) {
+		t.Parallel()
+		h := newAnchorCLIHub(t)
+		second := hubforge.CloneSecond(t, h)
+		secondRecords := second.PrimeRecords()
+		gitkit.CommitFile(t, secondRecords, lyxdirs.LyxDirName+"/second.txt", "second\n", "records of the second machine")
+		kept := filepath.Join(secondRecords, lyxdirs.DotLyxDirName, "kept.txt")
+		if err := os.WriteFile(kept, []byte("kept\n"), 0o644); err != nil {
+			t.Fatalf("write the untracked file in the second clone's .lyx: %v", err)
+		}
+
+		requireAnchorOK(t, h.PrimeWorktree(), "--set", "sub")
+		if _, err := fabricengine.CoalescePushBothAt(h.PrimeWorktree(), h.PrimeRecords(), fabricengine.SyncOptions{}); err != nil {
+			t.Fatalf("push the moved prime: %v", err)
+		}
+
+		recordsHead, codeHead := gitkit.RevParse(t, secondRecords, "HEAD"), gitkit.RevParse(t, second.PrimeWorktree(), "HEAD")
+		for _, verb := range []string{"pull", "push"} {
+			code, output := runFabric(t, second.PrimeWorktree(), verb)
+			if code == 0 {
+				t.Errorf("RunCLI(%s) in the second clone = 0; want the stop at the marker change\noutput: %s", verb, output)
+			}
+			if !strings.Contains(output, "lyx fabric anchor") {
+				t.Errorf("RunCLI(%s) output = %s; want the stop to name `lyx fabric anchor`", verb, output)
+			}
+		}
+		if got := gitkit.RevParse(t, secondRecords, "HEAD"); got != recordsHead {
+			t.Errorf("second clone's records HEAD = %s; want %s unchanged", got, recordsHead)
+		}
+		if got := gitkit.RevParse(t, second.PrimeWorktree(), "HEAD"); got != codeHead {
+			t.Errorf("second clone's code HEAD = %s; want %s unchanged", got, codeHead)
+		}
+
+		report, err := fabricengine.ReconcileOrigin(second.Location, fabricengine.ReconcileScope{}, fabricengine.OriginSeams{}, fabricengine.ReconcileOptions{})
+		if err != nil {
+			t.Fatalf("ReconcileOrigin() error = %v; want nil", err)
+		}
+		stopped := false
+		for _, branch := range report.Branches {
+			if branch.Prime && branch.Repo == "records" && branch.State == fabricengine.BranchAnchorStopped {
+				stopped = true
+			}
+		}
+		if !stopped {
+			t.Errorf("ReconcileOrigin() branches = %+v; want the prime's records branch anchor_stopped", report.Branches)
+		}
+		if got, err := os.ReadFile(kept); err != nil || string(got) != "kept\n" {
+			t.Errorf(".lyx file after the reconcile = (%q, %v); want it unchanged", got, err)
+		}
+
+		integrated := requireAnchorOK(t, second.PrimeWorktree(), "--set", "sub")
+
+		if integrated.Raw["changed"] != true || integrated.Raw["anchor"] != "sub" {
+			t.Errorf("anchor --set sub envelope = %v; want the integration to have changed the anchor to sub", integrated.Raw)
+		}
+		if message, _ := integrated.Raw["dobby_start_error"].(string); message == "" || integrated.Raw["way_forward"] != "lyx beam start" {
+			t.Errorf("anchor --set sub envelope = %v; want the dobby start the test binary refuses reported with `lyx beam start`", integrated.Raw)
+		}
+		if marker := gitkit.Git(t, secondRecords, "show", "HEAD:"+lyxcwd.AnchorFileName); marker != "sub" {
+			t.Errorf("committed marker after the integration = %q; want sub", marker)
+		}
+		if got := gitkit.Git(t, secondRecords, "show", "HEAD:sub/"+lyxdirs.LyxDirName+"/second.txt"); got != "second" {
+			t.Errorf("sub/_lyx/second.txt at HEAD = %q; want the second machine's commit carried to sub", got)
+		}
+		if upstream := gitkit.RevParse(t, secondRecords, "@{upstream}"); !gitkit.IsAncestor(t, secondRecords, upstream, "HEAD") {
+			t.Errorf("upstream tip %s is no ancestor of HEAD; want the commits replayed on it", upstream)
+		}
+		if got, err := os.ReadFile(filepath.Join(secondRecords, "sub", lyxdirs.DotLyxDirName, "kept.txt")); err != nil || string(got) != "kept\n" {
+			t.Errorf("sub/.lyx/kept.txt = (%q, %v); want the file moved with .lyx", got, err)
+		}
+		for _, name := range []string{lyxdirs.LyxDirName, lyxdirs.DotLyxDirName} {
+			if isLink, err := fslink.IsLink(filepath.Join(second.PrimeWorktree(), "sub", name)); err != nil || !isLink {
+				t.Errorf("%s at sub is no link (%v); want the prime wired there", name, err)
+			}
+		}
+	})
+}
diff --git a/internal/fabriccli/anchor_test.go b/internal/fabriccli/anchor_test.go
new file mode 100644
index 000000000..d92914e1c
--- /dev/null
+++ b/internal/fabriccli/anchor_test.go
@@ -0,0 +1,781 @@
+//go:build tier0
+
+// anchor_test.go covers the sequence of `lyx fabric anchor` over a fake anchorDeps: the print path, every refusal, the order of the move's steps and the restart or the re-run each failure calls for.
+
+package fabriccli
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/runproc"
+)
+
+// anchorFake is an in-memory hub for changeAnchor: it answers every seam from its fields, logs the actions in order and models the engine's move record.
+type anchorFake struct {
+	calls []string
+
+	acting, prime string
+	// anchors holds the anchor of each worktree this machine holds, "." for one it lists with none.
+	anchors map[string]string
+	beams   map[string]bool
+	goos    string
+
+	owners       map[string]string
+	upstream     string
+	hasUpstream  bool
+	recordFound  bool
+	reed         map[string]bool
+	driverLocked bool
+	battenLive   bool
+	runOpen      bool
+	upstreamOpen bool
+	primeRunOpen bool
+	dobbyPIDs    map[string]int
+	dobbyLive    map[string]bool
+	hubReed      []string
+	hubBatten    []string
+	gates        []string
+	hibernating  bool
+
+	// passPolls is how many readings report a pass in flight before one reports none.
+	passPolls int
+	passErr   error
+	lockErr   error
+	endErr    error
+	// endedBeforeErr are the dobbies the end reports as ended beside endErr.
+	endedBeforeErr []string
+	// reopenFails is the 1-based count of the ReopenLog call that fails.
+	reopenFails int
+	reopenErr   error
+
+	noop        bool
+	beginErr    error
+	applyErr    error
+	applyLanded bool
+	// applyKeepsRecord leaves the record standing after a failed Apply.
+	applyKeepsRecord bool
+	finishErr        error
+	// finishRemovesRecord removes the record before Finish fails.
+	finishRemovesRecord bool
+	startErr            error
+	ensureErr           error
+
+	reopens int
+	polls   int
+}
+
+func newAnchorFake() *anchorFake {
+	return &anchorFake{
+		acting:    "beam1",
+		prime:     "prime",
+		anchors:   map[string]string{"prime": ".", "beam1": ".", "beam2": ".", "pair1": "."},
+		beams:     map[string]bool{"beam1": true, "beam2": true},
+		goos:      "linux",
+		owners:    map[string]string{},
+		reed:      map[string]bool{},
+		dobbyPIDs: map[string]int{},
+		dobbyLive: map[string]bool{},
+	}
+}
+
+func (f *anchorFake) log(format string, args ...any) {
+	f.calls = append(f.calls, fmt.Sprintf(format, args...))
+}
+
+// fakeChange is the engine's AnchorChange as the fake models it.
+type fakeChange struct {
+	f       *anchorFake
+	from    string
+	to      string
+	fresh   bool
+	applied bool
+}
+
+func (c *fakeChange) NoOp() bool   { return c.f.noop }
+func (c *fakeChange) From() string { return c.from }
+func (c *fakeChange) To() string   { return c.to }
+
+func (c *fakeChange) Apply(rec *fabricengine.Mutations) (bool, error) {
+	c.f.log("apply")
+	c.applied = true
+	if c.f.applyErr != nil {
+		if !c.f.applyKeepsRecord {
+			c.f.recordFound = false
+		}
+		return c.f.applyLanded, c.f.applyErr
+	}
+	return true, nil
+}
+
+func (c *fakeChange) Finish(rec *fabricengine.Mutations) error {
+	c.f.log("finish")
+	if c.f.finishErr != nil {
+		if c.f.finishRemovesRecord {
+			c.f.recordFound = false
+		}
+		return c.f.finishErr
+	}
+	c.f.recordFound = false
+	return nil
+}
+
+func (c *fakeChange) Close() {
+	c.f.log("close")
+	if c.fresh && !c.applied {
+		c.f.recordFound = false
+	}
+}
+
+func (f *anchorFake) location(slug string) *lyxcwd.Location {
+	return &lyxcwd.Location{RepoName: "repo", HubPath: "/hub", WorktreeName: slug, AnchorRel: f.anchors[slug]}
+}
+
+func (f *anchorFake) deps() anchorDeps {
+	return anchorDeps{
+		GOOS:   f.goos,
+		Acting: f.acting,
+		Prime:  f.prime,
+		Worktree: func(slug string) (*lyxcwd.Location, bool, error) {
+			if _, held := f.anchors[slug]; !held {
+				return nil, false, nil
+			}
+			return f.location(slug), true, nil
+		},
+		IsBeam: func(slug string) (bool, error) { return f.beams[slug], nil },
+		LocalBeams: func() ([]string, error) {
+			var beams []string
+			for slug := range f.beams {
+				beams = append(beams, slug)
+			}
+			slices.Sort(beams)
+			return beams, nil
+		},
+		ForeignOwner: func(slug string) (string, error) { return f.owners[slug], nil },
+		UpstreamAnchor: func(*lyxcwd.Location) (string, bool, error) {
+			return f.upstream, f.hasUpstream, nil
+		},
+		MoveRecord: func(*lyxcwd.Location) (fabricengine.MoveRecord, bool, error) {
+			return fabricengine.MoveRecord{A: ".", B: "sub", Kind: fabricengine.MoveKindMove}, f.recordFound, nil
+		},
+		ReedHeld:              func(l *lyxcwd.Location) (bool, error) { return f.reed[l.WorktreeName], nil },
+		DriverLockHeld:        func(*lyxcwd.Location) (bool, error) { return f.driverLocked, nil },
+		BattenLive:            func(*lyxcwd.Location) (bool, error) { return f.battenLive, nil },
+		RunUnfinished:         func(*lyxcwd.Location) (bool, error) { return f.runOpen, nil },
+		UpstreamRunUnfinished: func(*lyxcwd.Location) (bool, error) { return f.upstreamOpen, nil },
+		PrimeRunUnfinished:    func(string) (bool, error) { return f.primeRunOpen, nil },
+		DobbyPID: func(worktree string) (int, bool, error) {
+			pid, live := f.dobbyPIDs[worktree]
+			return pid, live, nil
+		},
+		DobbyLive:     func(worktree string) (bool, error) { return f.dobbyLive[worktree], nil },
+		HubReedHeld:   func() ([]string, error) { return f.hubReed, nil },
+		HubBattenLive: func() ([]string, error) { return f.hubBatten, nil },
+		GateHolders:   func() ([]string, error) { return f.gates, nil },
+		HibernateLive: func() (bool, error) { return f.hibernating, nil },
+		PassInFlight: func(worktree string) (string, error) {
+			if f.passErr != nil {
+				return "", f.passErr
+			}
+			if f.polls < f.passPolls && worktree == f.acting {
+				return "a pass of the dobby of " + worktree, nil
+			}
+			return "", nil
+		},
+		Sleep: func(ctx context.Context, d time.Duration) error {
+			f.polls++
+			f.log("wait")
+			return ctx.Err()
+		},
+		Note: func(line string) { f.log("note %s", line) },
+		AcquireParentLock: func(_ context.Context, l *lyxcwd.Location) (func(), error) {
+			if f.lockErr != nil {
+				return nil, f.lockErr
+			}
+			f.log("parent-lock")
+			return func() { f.log("release-parent-lock") }, nil
+		},
+		EndDobbies: func(worktrees []string, spare ...string) ([]string, error) {
+			f.log("end-dobbies %s spare %s", strings.Join(worktrees, ","), strings.Join(spare, ","))
+			if f.endErr != nil {
+				return f.endedBeforeErr, f.endErr
+			}
+			return worktrees, nil
+		},
+		StartDobby: func(slug string) error {
+			f.log("start-dobby %s", slug)
+			return f.startErr
+		},
+		EnsureDobbies: func() error {
+			f.log("ensure-dobbies")
+			return f.ensureErr
+		},
+		Begin: func(l *lyxcwd.Location, target string) (anchorChange, error) {
+			f.log("begin %s", target)
+			if f.beginErr != nil {
+				return nil, f.beginErr
+			}
+			change := &fakeChange{f: f, from: l.AnchorRel, to: target, fresh: !f.recordFound}
+			if f.noop {
+				change.to = l.AnchorRel
+			} else {
+				f.recordFound = true
+			}
+			return change, nil
+		},
+		ReopenLog: func(dir string) error {
+			f.reopens++
+			f.log("reopen-log %s", dir)
+			if f.reopens == f.reopenFails {
+				return f.reopenErr
+			}
+			return nil
+		},
+	}
+}
+
+func (f *anchorFake) lockDir(slug string) string {
+	l := f.location(slug)
+	return fabricengine.RecordsLockDirPath(fabricengine.RecordsWorktreePath(l, slug))
+}
+
+func (f *anchorFake) logsDir(slug, anchor string) string {
+	return logger.LogsDirAt(filepath.Join(fabricengine.WorktreePath(f.location(slug), slug), anchor))
+}
+
+func (f *anchorFake) did(call string) bool {
+	return slices.ContainsFunc(f.calls, func(got string) bool { return strings.HasPrefix(got, call) })
+}
+
+func runAnchorFake(t *testing.T, f *anchorFake, req anchorRequest) (anchorResult, error) {
+	t.Helper()
+
+	return changeAnchor(context.Background(), f.deps(), req)
+}
+
+func TestChangeAnchor(t *testing.T) {
+	t.Parallel()
+
+	t.Run("Without --set it prints the anchor of the named or the acting worktree and changes nothing", func(t *testing.T) {
+		t.Parallel()
+		f := newAnchorFake()
+		f.anchors["pair1"] = "backend"
+
+		acting, err := runAnchorFake(t, f, anchorRequest{})
+		if err != nil || acting.Slug != "beam1" || acting.Anchor != "." || acting.Changed {
+			t.Errorf("changeAnchor() = (%+v, %v); want the acting worktree's anchor . and no change", acting, err)
+		}
+		named, err := runAnchorFake(t, f, anchorRequest{Slug: "pair1"})
+		if err != nil || named.Slug != "pair1" || named.Anchor != "backend" {
+			t.Errorf("changeAnchor(pair1) = (%+v, %v); want the anchor backend", named, err)
+		}
+		if len(f.calls) != 0 {
+			t.Errorf("calls = %v; want none, since a print touches nothing", f.calls)
+		}
+	})
+
+	t.Run("A slug this machine does not hold is refused naming lyx fabric pairs", func(t *testing.T) {
+		t.Parallel()
+		f := newAnchorFake()
+
+		_, err := runAnchorFake(t, f, anchorRequest{Slug: "nobody", Set: "sub"})
+
+		if err == nil || !strings.Contains(err.Error(), "lyx fabric pairs") {
+			t.Errorf("changeAnchor() error = %v; want a refusal naming `lyx fabric pairs`", err)
+		}
+		if len(f.calls) != 0 {
+			t.Errorf("calls = %v; want none", f.calls)
+		}
+	})
+
+	t.Run("Each refusal names its way forward and calls no engine step, ends no dobby and takes no lock", func(t *testing.T) {
+		t.Parallel()
+		tests := []struct {
+			name   string
+			slug   string
+			mutate func(f *anchorFake)
+			want   []string
+			absent []string
+		}{
+			{
+				name: "AnotherMachineOwnsIt",
+				slug: "pair1",
+				mutate: func(f *anchorFake) {
+					f.owners["pair1"] = "elsewhere"
+				},
+				want:   []string{"elsewhere", "lyx adopt pair1", "--keep-local", "lyx fabric anchor pair1 --set sub` on elsewhere"},
+				absent: []string{"the marker at the fetched upstream tip"},
+			},
+			{
+				name: "AnotherMachineOwnsItAndItsUpstreamTipRecordsAnotherAnchor",
+				slug: "pair1",
+				mutate: func(f *anchorFake) {
+					f.owners["pair1"] = "elsewhere"
+					f.upstream, f.hasUpstream = "backend", true
+				},
+				want: []string{"lyx fabric anchor pair1 --set backend`, the marker at the fetched upstream tip"},
+			},
+			{
+				name: "AnotherMachineOwnsItAndItsUpstreamTipRecordsTheCheckedOutAnchor",
+				slug: "pair1",
+				mutate: func(f *anchorFake) {
+					f.owners["pair1"] = "elsewhere"
+					f.upstream, f.hasUpstream = ".", true
+				},
+				want:   []string{"elsewhere"},
+				absent: []string{"the marker at the fetched upstream tip"},
+			},
+			{
+				name: "AnotherMachineOwnsThePrime",
+				slug: "prime",
+				mutate: func(f *anchorFake) {
+					f.owners["prime"] = "elsewhere"
+				},
+				want: []string{"lyx adopt --prime", "elsewhere"},
+			},
+			{
+				name:   "ReedHoldsAStrand",
+				slug:   "pair1",
+				mutate: func(f *anchorFake) { f.reed["pair1"] = true },
+				want:   []string{"lyx reed down", "pair1"},
+			},
+			{
+				name:   "TheDriverLockIsHeld",
+				slug:   "pair1",
+				mutate: func(f *anchorFake) { f.driverLocked = true },
+				want:   []string{"driver lock", "lyx batten cancel pair1"},
+			},
+			{
+				name:   "ABattenRunIsLive",
+				slug:   "pair1",
+				mutate: func(f *anchorFake) { f.battenLive = true },
+				want:   []string{"batten run", "lyx batten cancel pair1"},
+			},
+			{
+				name:   "TheRunStatusIsUnfinished",
+				slug:   "pair1",
+				mutate: func(f *anchorFake) { f.runOpen = true },
+				want:   []string{"unfinished run", "lyx batten cancel pair1", "an entry stopped only by this change"},
+			},
+			{
+				name:   "ThePrimesBattenStatusOfThePairIsUnfinished",
+				slug:   "pair1",
+				mutate: func(f *anchorFake) { f.primeRunOpen = true },
+				want:   []string{"unfinished in the prime", "lyx batten cancel pair1"},
+			},
+			{
+				name: "ARunThatReadsUnfinishedAtTheFetchedUpstreamTipOfAWorktreeAnotherMachineOwns",
+				slug: "pair1",
+				mutate: func(f *anchorFake) {
+					f.owners["pair1"] = "elsewhere"
+					f.upstream, f.hasUpstream = "sub", true
+					f.upstreamOpen = true
