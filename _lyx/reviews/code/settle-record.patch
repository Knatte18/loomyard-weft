+// geometry.go declares the absolute paths and names the hub wiring tells dobby, and the pass exit codes dobby reads from a batten run.
+
+package dobbyengine
+
+const (
+	// PassExitOwnedElsewhere is the exit code of a `lyx batten run` pass that refused because another machine owns the run.
+	PassExitOwnedElsewhere = 77
+	// PassExitCovered is the exit code of a `lyx batten run` pass that refused because a pause covers the run.
+	PassExitCovered = 78
+	// PassExitContinueRefused is the exit code of a continue pass that refused because the run is not one dobby may continue.
+	PassExitContinueRefused = 79
+)
+
+const (
+	// LockFileName is the daemon's lock file in the worktree's `.lyx/beam/` directory.
+	LockFileName = "dobby.lock"
+	// StateFileName is the State record's file in the worktree's `.lyx/beam/` directory.
+	StateFileName = "state.json"
+	// MarkerDirName is the directory of dobby's marker files in the worktree's `.lyx/beam/` directory.
+	MarkerDirName = "markers"
+)
+
+// Geometry is every path and name dobby needs, absolute and told by the hub wiring.
+// The package derives none of them.
+type Geometry struct {
+	// HubRoot is the hub directory.
+	HubRoot string
+	// BoardDir is the hub's board directory.
+	BoardDir string
+	// PrimeAnchor is the prime worktree's anchor.
+	PrimeAnchor string
+	// WorktreeRoot is the root of the beam's worktree.
+	WorktreeRoot string
+	// WorktreeName is the beam worktree's directory name.
+	WorktreeName string
+	// Slug is the beam's slug, empty for the prime, the root beam.
+	Slug string
+	// LockPath is the daemon's lock file under the worktree's `.lyx/beam/` directory.
+	LockPath string
+	// StatePath is the State record under the worktree's `.lyx/beam/` directory.
+	StatePath string
+	// MarkerDir is the directory of dobby's marker files under the worktree's `.lyx/beam/` directory.
+	MarkerDir string
+	// PrimeRunsDir is the prime's batten runs directory.
+	PrimeRunsDir string
+	// LyxExecutable is the absolute path of the lyx binary dobby re-executes and spawns passes with.
+	LyxExecutable string
+}
diff --git a/internal/dobbyengine/loop.go b/internal/dobbyengine/loop.go
new file mode 100644
index 000000000..bc2346ff0
--- /dev/null
+++ b/internal/dobbyengine/loop.go
@@ -0,0 +1,341 @@
+// loop.go implements dobby's daemon loop: the lock that keeps one dobby per beam worktree, the owner exit, the sleep watch, the coalesced wakeups and the binary check between ticks.
+
+package dobbyengine
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+	"github.com/Knatte18/loomyard/internal/pauserecord"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+const (
+	// wakeFloor is the shortest gap between two wakes of the loop, ticks coalescing events and timers alike to it.
+	wakeFloor = time.Second
+	// idleCeiling is the longest the timer waits while no run is in flight.
+	idleCeiling = time.Minute
+)
+
+// ErrDobbyRunning is returned by Run when another dobby holds this worktree's lock.
+var ErrDobbyRunning = errors.New("dobby: another dobby holds this worktree's lock")
+
+// TickInput is what one tick tells the per-tick work.
+type TickInput struct {
+	// Now is the tick's wall time.
+	Now time.Time
+	// ProbeDue reports whether a probe interval has passed since the last probe tick, so this tick is a probe tick.
+	ProbeDue bool
+	// OwesAll reports whether every run dobby drives is owed a full pass: the dobby started, saw a machine sleep, or found its state record without a pid.
+	// It stays set until a tick returns nil.
+	OwesAll bool
+}
+
+// Deps is every seam Run reads, told by the hub wiring.
+type Deps struct {
+	// Now is the wall clock.
+	Now func() time.Time
+	// Awake is a clock that stops while the machine sleeps, `pauserecord.MonotonicAwake()` in production.
+	Awake func() time.Duration
+	// Sleep waits d, or returns early when ctx is cancelled.
+	Sleep func(ctx context.Context, d time.Duration)
+	// Watch opens the file watch over the prime's batten runs directory, each run's child status directory, the board's `board.json` and the hub's pause record directory.
+	// Its channel delivers one value per change; closeWatch releases it.
+	// A nil Watch, or one that returns an error, leaves the timer alone to drive the loop.
+	Watch func() (events <-chan struct{}, closeWatch func(), err error)
+	// Machine returns this machine's name.
+	Machine func() (string, error)
+	// Owner returns the machine that owns this dobby's beam, the prime owner for the prime; empty means no other machine owns it.
+	Owner func() (string, error)
+	// CheckBinary re-execs onto a changed lyx binary and returns when the binary is unchanged.
+	CheckBinary func()
+	// ProbeInterval is batten's `notice_probe_s`; a value below one second is floored to it with one Warn.
+	ProbeInterval time.Duration
+	// Tick is an extra per-tick hook that runs after the scheduling steps: it reports whether anything it drives is in flight for the loop's backoff.
+	// A nil Tick does nothing.
+	Tick func(ctx context.Context, in TickInput) (inFlight bool, err error)
+	// Runs lists the batten runs whose parent worktree is this dobby's own, read from the prime's local batten status files and never from the board.
+	// A run's parent is the one its pair's origin record names, the prime for none, so a run whose task Land already pruned from the board is still listed.
+	Runs func() ([]RunView, error)
+	// SpawnPass starts `<lyx> batten run <slug>` with the hidden continue and no-reopen flags as asked, in its own process group with the prime's anchor as its working directory, logged at Info.
+	// The pass registers itself in `internal/runproc` as the run's batten, so dobby registers nothing.
+	// The channel delivers the pass's exit once.
+	SpawnPass func(slug string, continuePass, noReopen bool) (<-chan PassExit, error)
+	// Notice posts one line to the nearest live orch.
+	Notice func(ctx context.Context, line string) error
+	// PauseOwned pauses the run slug under the owner caller, because another machine owns it (`tendercli.PauseOwnedElsewhere` in production).
+	PauseOwned func(ctx context.Context, slug string) error
+	// ReleaseParentLock releases the parent lock record naming the run's child, the release a run's own owned-elsewhere pause makes.
+	ReleaseParentLock func(ctx context.Context, slug string) error
+	// SlugOwner returns the effective owner of slug on the local Bolt, with no pull; empty means no other machine owns it.
+	SlugOwner func(slug string) (string, error)
+	// LiftOwnerPause lifts the pause entry of the slug's own scope that carries the owner caller.
+	LiftOwnerPause func(ctx context.Context, slug string) error
+	// Tasks reads the local board, each entry as a TaskView, with its parent worktree through `hubgeom.ParentOf` and its effective owner.
+	Tasks func() ([]TaskView, error)
+	// LoadConfig loads beam.yaml over the dobby's worktree layer stack.
+	LoadConfig func() (Config, error)
+	// StatusExists reports whether a first pass left batten's status file for slug.
+	StatusExists func(slug string) (bool, error)
+	// PauseCovers reports whether a live pause entry covers the hub or slug.
+	PauseCovers func(slug string) (bool, error)
+	// Landings returns the slugs of the runs whose parent worktree is this dobby's own and whose batten history holds a Land Done, whatever the run's state.
+	// A nil Landings, or a nil TidyShuttle, leaves the board tidy off.
+	Landings func() ([]string, error)
+	// TidyShuttle starts and stops the board-tidy agent.
+	TidyShuttle TidyShuttle
+	// TidyModel is the model the board-tidy agent runs on, resolved by the hub wiring.
+	TidyModel shuttleengine.ModelChoice
+	// StencilsDir is the hub's stencils directory, where the board-tidy stencil is read at call time.
+	StencilsDir string
+	// NearestOrch returns the name of the nearest live orch the tidy agent's parent directive names; empty means there is none.
+	NearestOrch func() (string, error)
+}
+
+// Run drives one dobby for geom until ctx ends or another machine owns the beam.
+// It takes geom.LockPath without blocking and returns ErrDobbyRunning at once when another dobby holds it.
+// It reads the beam's owner at start and on every probe tick, and returns nil, logging why, when another machine owns it.
+// A state record holding this process's pid is a re-exec, which owes no new full pass; any other pid, or no record, is a start.
+// A tick that fails is logged once per episode and the loop goes on; a cancelled context ends it after the tick in flight.
+func Run(ctx context.Context, geom Geometry, deps Deps) error {
+	if err := os.MkdirAll(filepath.Dir(geom.LockPath), 0o755); err != nil {
+		return err
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(geom.LockPath)
+	if err != nil {
+		return err
+	}
+	if !acquired {
+		return ErrDobbyRunning
+	}
+	defer func() { _ = held.Release() }()
+
+	d := &daemon{
+		geom: geom, deps: deps, probe: deps.ProbeInterval,
+		flights: map[string]flight{}, childSeen: map[string]time.Time{}, wasCovered: map[string]bool{}, liftPending: map[string]bool{},
+	}
+	if d.probe < wakeFloor {
+		logger.Warn("dobbyengine: the probe interval is below the floor and is floored", "key", "notice_probe_s", "floor", wakeFloor, "configured", d.probe)
+		d.probe = wakeFloor
+	}
+	if err := d.recordStart(); err != nil {
+		return err
+	}
+
+	var events <-chan struct{}
+	if deps.Watch != nil {
+		watched, closeWatch, err := deps.Watch()
+		if err != nil {
+			logger.Warn("dobbyengine: the file watch did not open; the timer alone drives the loop", "error", err)
+		} else {
+			events = watched
+			defer closeWatch()
+		}
+	}
+	return d.loop(ctx, events)
+}
+
+// daemon is one running dobby: the told geometry and seams, and what the loop remembers between ticks.
+type daemon struct {
+	geom Geometry
+	deps Deps
+	// probe is the floored probe interval.
+	probe time.Duration
+
+	sleepWatch pauserecord.SleepWatch
+	owesAll    bool
+	inFlight   bool
+	probeDue   bool
+	lastProbe  time.Time
+	lastTick   time.Time
+	failures   logger.Episode
+	ownerRead  logger.Episode
+
+	// tickCtx is the context of the tick in flight, for the seams a pass exit reaches.
+	tickCtx context.Context
+	// busy reports whether any run is in flight or could be given a pass on the next probe tick.
+	busy bool
+	// flights holds the passes spawned that have not exited, by slug.
+	flights map[string]flight
+	// childSeen holds the last child status modification time read, by slug.
+	childSeen map[string]time.Time
+	// wasCovered holds whether a pause covered the run at the last tick, by slug.
+	wasCovered map[string]bool
+	// liftPending holds the runs whose covering pause lifted and which have not been given a pass since.
+	liftPending map[string]bool
+	// ownerPauses tracks, by slug, the episodes of a failing owner pause.
+	ownerPauses logger.EpisodeSet
+	// runs is the listing of the tick in flight.
+	runs []RunView
+}
+
+// recordStart reads the state record and decides whether this run of the loop is a start or a re-exec, recording the pid and start time on a start.
+func (d *daemon) recordStart() error {
+	record, found, err := ReadState(d.geom.StatePath)
+	if err != nil {
+		return err
+	}
+	if found && record.PID == os.Getpid() {
+		return nil
+	}
+	d.owesAll = true
+	now := d.deps.Now()
+	return UpdateState(d.geom.StatePath, func(s *State) error {
+		s.PID, s.StartTime = os.Getpid(), now.UTC().Format(time.RFC3339)
+		return nil
+	})
+}
+
+// loop ticks and waits until ctx ends or another machine owns the beam.
+func (d *daemon) loop(ctx context.Context, events <-chan struct{}) error {
+	var wait time.Duration
+	event := true
+	for ctx.Err() == nil {
+		now := d.deps.Now()
+		d.probeDue = d.lastProbe.IsZero() || now.Sub(d.lastProbe) >= d.probe
+		if d.probeDue {
+			d.lastProbe = now
+			if elsewhere, owner := d.beamOwnedElsewhere(); elsewhere {
+				logger.Info("dobbyengine: another machine owns this beam; the dobby exits", "worktree", d.geom.WorktreeName, "owner", owner)
+				return nil
+			}
+		}
+
+		if err := d.tick(ctx, now); err != nil {
+			d.failures.Fail("dobbyengine: a tick failed; the loop goes on", "worktree", d.geom.WorktreeName, "error", err)
+		} else {
+			d.failures.Recover("dobbyengine: ticks succeed again", "worktree", d.geom.WorktreeName)
+		}
+		d.lastTick = now
+		if ctx.Err() != nil {
+			return nil
+		}
+
+		d.deps.CheckBinary()
+
+		wait = nextWait(wait, d.inFlight, event)
+		if wait == 0 {
+			wait = d.probe
+		}
+		wait = max(wait, d.probe, wakeFloor)
+		event = d.sleep(ctx, wait, events)
+	}
+	return nil
+}
+
+// beamOwnedElsewhere reads the beam's owner and reports the other machine that owns it.
+// A failed read is logged once per episode and reads as not owned elsewhere.
+func (d *daemon) beamOwnedElsewhere() (bool, string) {
+	machine, err := d.deps.Machine()
+	if err == nil {
+		var owner string
+		if owner, err = d.deps.Owner(); err == nil {
+			d.ownerRead.Recover("dobbyengine: the beam's owner reads again", "worktree", d.geom.WorktreeName)
+			return owner != "" && owner != machine, owner
+		}
+	}
+	d.ownerRead.Fail("dobbyengine: the beam's owner is unreadable; the dobby goes on", "worktree", d.geom.WorktreeName, "error", err)
+	return false, ""
+}
+
+// tick folds one awake reading into the sleep watch, keeps the state record's pid and sleeps, and runs the per-tick work.
+// A sleep the watch sees, and a record found without a pid, owe every run a full pass until a tick returns nil.
+func (d *daemon) tick(ctx context.Context, now time.Time) error {
+	d.sleepWatch.Observe(now, d.deps.Awake())
+	seen := d.sleepWatch.Sleeps()
+	err := UpdateState(d.geom.StatePath, func(s *State) error {
+		if s.PID == 0 {
+			s.PID, s.StartTime = os.Getpid(), now.UTC().Format(time.RFC3339)
+			d.owesAll = true
+		}
+		for _, sleep := range seen {
+			// Compared by instant: a record read back from JSON carries no time zone pointer of the one it was written with.
+			if !slices.ContainsFunc(s.Sleeps, func(known pauserecord.Interval) bool {
+				return known.Start.Equal(sleep.Start) && known.End.Equal(sleep.End)
+			}) {
+				s.Sleeps = append(s.Sleeps, sleep)
+				d.owesAll = true
+			}
+		}
+		cutoff := now.Add(-pauserecord.Retention)
+		s.Sleeps = slices.DeleteFunc(s.Sleeps, func(sleep pauserecord.Interval) bool { return sleep.End.Before(cutoff) })
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if err := d.drivePasses(ctx, now); err != nil {
+		return err
+	}
+	if err := d.startReady(ctx, now); err != nil {
+		return err
+	}
+	if err := d.countLandings(now); err != nil {
+		return err
+	}
+	if err := d.tidyStep(ctx, now); err != nil {
+		return err
+	}
+	d.inFlight = d.busy
+	if d.deps.Tick != nil {
+		hookInFlight, err := d.deps.Tick(ctx, TickInput{Now: now, ProbeDue: d.probeDue, OwesAll: d.owesAll})
+		d.inFlight = d.inFlight || hookInFlight
+		if err != nil {
+			return err
+		}
+	}
+	d.owesAll = false
+	return nil
+}
+
+// sleep waits for the next tick: wait, or a watch event, whichever comes first, and reports whether an event woke it.
+// Events are coalesced to at most one tick a second: an event arriving sooner than that after the last tick waits out the rest of the second, and every event that came meanwhile is dropped.
+func (d *daemon) sleep(ctx context.Context, wait time.Duration, events <-chan struct{}) bool {
+	woke := false
+	select {
+	case <-events:
+		woke = true
+	default:
+		timerCtx, stopTimer := context.WithCancel(ctx)
+		timerDone := make(chan struct{})
+		go func() {
+			defer close(timerDone)
+			d.deps.Sleep(timerCtx, wait)
+		}()
+		select {
+		case <-events:
+			woke = true
+		case <-timerDone:
+		}
+		stopTimer()
+		<-timerDone
+	}
+	if woke {
+		if rest := wakeFloor - d.deps.Now().Sub(d.lastTick); rest > 0 {
+			d.deps.Sleep(ctx, rest)
+		}
+		for drained := false; !drained; {
+			select {
+			case <-events:
+			default:
+				drained = true
+			}
+		}
+	}
+	return woke
+}
+
+// nextWait returns the timer's next wait given the current one.
+// It doubles the current wait up to a minute while no run is in flight and no event came, and returns the zero duration, meaning the probe interval, on any event or while a run is in flight.
+func nextWait(current time.Duration, inFlight, event bool) time.Duration {
+	if inFlight || event {
+		return 0
+	}
+	return min(current*2, idleCeiling)
+}
diff --git a/internal/dobbyengine/loop_test.go b/internal/dobbyengine/loop_test.go
new file mode 100644
index 000000000..bf36412cc
--- /dev/null
+++ b/internal/dobbyengine/loop_test.go
@@ -0,0 +1,324 @@
+//go:build tier0
+
+// loop_test.go pins dobby's daemon loop over a fake clock, a fake watch and a temp state record: the lock, the owner exit, the wakeups, the sleep record and the start-or-re-exec reading.
+
+package dobbyengine
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// loopClock is a fake wall clock and awake clock: Sleep advances both, and suspend advances only the wall clock, as a machine sleep does.
+type loopClock struct {
+	mu        sync.Mutex
+	wall      time.Time
+	suspended time.Duration
+	waits     []time.Duration
+}
+
+func newLoopClock() *loopClock {
+	return &loopClock{wall: time.Date(2026, 10, 25, 12, 0, 0, 0, time.UTC)}
+}
+
+func (c *loopClock) now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.wall
+}
+
+func (c *loopClock) awake() time.Duration {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.wall.Sub(time.Date(2026, 10, 25, 12, 0, 0, 0, time.UTC)) - c.suspended
+}
+
+func (c *loopClock) sleep(_ context.Context, d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.wall = c.wall.Add(d)
+	c.waits = append(c.waits, d)
+}
+
+func (c *loopClock) suspend(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.wall = c.wall.Add(d)
+	c.suspended += d
+}
+
+// loopHarness runs the loop and stops it on the tick named by stopAt.
+type loopHarness struct {
+	clock  *loopClock
+	geom   Geometry
+	deps   Deps
+	ticks  []TickInput
+	cancel context.CancelFunc
+	stopAt int
+	// perTick runs inside the tick seam with the 1-based tick count, and its error is the tick's.
+	perTick func(n int) error
+}
+
+func newLoopHarness(t *testing.T, stopAt int) *loopHarness {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), "beam")
+	h := &loopHarness{
+		clock:  newLoopClock(),
+		geom:   Geometry{WorktreeName: "prime", LockPath: filepath.Join(dir, LockFileName), StatePath: filepath.Join(dir, StateFileName)},
+		stopAt: stopAt,
+	}
+	h.deps = Deps{
+		Now:           h.clock.now,
+		Awake:         h.clock.awake,
+		Sleep:         h.clock.sleep,
+		Machine:       func() (string, error) { return "m1", nil },
+		Owner:         func() (string, error) { return "", nil },
+		CheckBinary:   func() {},
+		ProbeInterval: 10 * time.Second,
+		Runs:          func() ([]RunView, error) { return nil, nil },
+		LoadConfig:    func() (Config, error) { return Config{}, nil },
+		Tick: func(_ context.Context, in TickInput) (bool, error) {
+			h.ticks = append(h.ticks, in)
+			var err error
+			if h.perTick != nil {
+				err = h.perTick(len(h.ticks))
+			}
+			if len(h.ticks) >= h.stopAt {
+				h.cancel()
+			}
+			return false, err
+		},
+	}
+	return h
+}
+
+func (h *loopHarness) run(t *testing.T) error {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	ctx, h.cancel = context.WithCancel(ctx)
+	return Run(ctx, h.geom, h.deps)
+}
+
+func TestRun_LockOwnerAndWakeups(t *testing.T) {
+	t.Parallel()
+
+	t.Run("a held lock returns ErrDobbyRunning and writes no state", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 1)
+		if err := os.MkdirAll(filepath.Dir(h.geom.LockPath), 0o755); err != nil {
+			t.Fatalf("MkdirAll() = %v; want nil", err)
+		}
+		held, acquired, err := lock.TryAcquireWriteLock(h.geom.LockPath)
+		if err != nil || !acquired {
+			t.Fatalf("TryAcquireWriteLock() = %v, %v; want it acquired", acquired, err)
+		}
+		defer func() { _ = held.Release() }()
+
+		if err := h.run(t); !errors.Is(err, ErrDobbyRunning) {
+			t.Errorf("Run() = %v; want ErrDobbyRunning", err)
+		}
+		if _, err := os.Stat(h.geom.StatePath); !os.IsNotExist(err) {
+			t.Errorf("Stat(state) = %v; want it absent", err)
+		}
+		if len(h.ticks) != 0 {
+			t.Errorf("ticks = %d; want 0", len(h.ticks))
+		}
+	})
+
+	t.Run("an owner read naming another machine exits at start", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 5)
+		h.deps.Owner = func() (string, error) { return "m2", nil }
+		if err := h.run(t); err != nil {
+			t.Errorf("Run() = %v; want nil", err)
+		}
+		if len(h.ticks) != 0 {
+			t.Errorf("ticks = %d; want 0", len(h.ticks))
+		}
+	})
+
+	t.Run("an owner that moves to another machine on a probe tick exits then", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 5)
+		reads := 0
+		h.deps.Owner = func() (string, error) {
+			reads++
+			if reads == 1 {
+				return "m1", nil
+			}
+			return "m2", nil
+		}
+		if err := h.run(t); err != nil {
+			t.Errorf("Run() = %v; want nil", err)
+		}
+		if len(h.ticks) != 1 || reads != 2 {
+			t.Errorf("ticks, owner reads = %d, %d; want 1, 2", len(h.ticks), reads)
+		}
+	})
+
+	t.Run("a burst of five events in one second runs one tick", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 2)
+		events := make(chan struct{}, 5)
+		for range 5 {
+			events <- struct{}{}
+		}
+		h.deps.Watch = func() (<-chan struct{}, func(), error) { return events, func() {}, nil }
+		if err := h.run(t); err != nil {
+			t.Fatalf("Run() = %v; want nil", err)
+		}
+		if len(h.ticks) != 2 || len(events) != 0 {
+			t.Errorf("ticks, undrained events = %d, %d; want 2, 0", len(h.ticks), len(events))
+		}
+		if len(h.clock.waits) != 1 || h.clock.waits[0] != time.Second {
+			t.Errorf("waits = %v; want the one second the coalescing holds", h.clock.waits)
+		}
+	})
+
+	t.Run("a sleep longer than a minute between ticks is recorded in the state and owes every run a full pass", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 3)
+		h.perTick = func(n int) error {
+			if n == 1 {
+				h.clock.suspend(5 * time.Minute)
+			}
+			return nil
+		}
+		if err := h.run(t); err != nil {
+			t.Fatalf("Run() = %v; want nil", err)
+		}
+		record, found, err := ReadState(h.geom.StatePath)
+		if err != nil || !found || len(record.Sleeps) != 1 {
+			t.Fatalf("ReadState() = %+v, %v, %v; want one recorded sleep", record, found, err)
+		}
+		if got := record.Sleeps[0].End.Sub(record.Sleeps[0].Start); got < 4*time.Minute || got > 5*time.Minute {
+			t.Errorf("recorded sleep = %v; want about five minutes", got)
+		}
+		if owes := []bool{h.ticks[0].OwesAll, h.ticks[1].OwesAll, h.ticks[2].OwesAll}; !owes[0] || !owes[1] || owes[2] {
+			t.Errorf("OwesAll over three ticks = %v; want true (start), true (the sleep), false", owes)
+		}
+	})
+
+	t.Run("a watch that fails to open still ticks on the timer", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 3)
+		h.deps.Watch = func() (<-chan struct{}, func(), error) { return nil, nil, errors.New("no inotify") }
+		if err := h.run(t); err != nil {
+			t.Fatalf("Run() = %v; want nil", err)
+		}
+		if len(h.ticks) != 3 || h.clock.waits[0] != h.deps.ProbeInterval {
+			t.Errorf("ticks, first wait = %d, %v; want 3, the probe interval", len(h.ticks), h.clock.waits[0])
+		}
+	})
+
+	t.Run("a state record holding the dobby's own pid reads as a re-exec and another pid as a start", func(t *testing.T) {
+		t.Parallel()
+		for _, tt := range []struct {
+			name    string
+			pid     int
+			wantOwe bool
+		}{
+			{"OwnPid", os.Getpid(), false},
+			{"OtherPid", os.Getpid() + 1, true},
+		} {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				h := newLoopHarness(t, 1)
+				if err := UpdateState(h.geom.StatePath, func(s *State) error { s.PID = tt.pid; return nil }); err != nil {
+					t.Fatalf("UpdateState() = %v; want nil", err)
+				}
+				if err := h.run(t); err != nil {
+					t.Fatalf("Run() = %v; want nil", err)
+				}
+				if h.ticks[0].OwesAll != tt.wantOwe {
+					t.Errorf("first tick OwesAll = %v; want %v", h.ticks[0].OwesAll, tt.wantOwe)
+				}
+			})
+		}
+	})
+
+	t.Run("a record made undecodable between two ticks is rewritten fresh and owes every run a full pass", func(t *testing.T) {
+		t.Parallel()
+		h := newLoopHarness(t, 3)
+		h.perTick = func(n int) error {
+			if n == 2 {
+				return os.WriteFile(h.geom.StatePath, []byte("{not json"), 0o644)
+			}
+			return nil
+		}
+		if err := h.run(t); err != nil {
+			t.Fatalf("Run() = %v; want nil", err)
+		}
+		record, found, err := ReadState(h.geom.StatePath)
+		if err != nil || !found || record.PID != os.Getpid() {
+			t.Errorf("ReadState() = %+v, %v, %v; want the pid recorded again", record, found, err)
+		}
+		if h.ticks[1].OwesAll || !h.ticks[2].OwesAll {
+			t.Errorf("OwesAll on ticks two and three = %v, %v; want false, true", h.ticks[1].OwesAll, h.ticks[2].OwesAll)
+		}
+	})
+}
+
+// TestRun_TickFailuresLogOncePerEpisode captures the process-global logger output, so it does not run in parallel.
+func TestRun_TickFailuresLogOncePerEpisode(t *testing.T) {
+	var captured bytes.Buffer
+	logger.SetVerbosity(1)
+	logger.SetOutput(&captured)
+	t.Cleanup(func() {
+		logger.SetVerbosity(0)
+		logger.SetOutput(logger.DefaultOutput())
+	})
+
+	h := newLoopHarness(t, 5)
+	h.perTick = func(n int) error {
+		if n <= 3 {
+			return errors.New("board unreadable")
+		}
+		return nil
+	}
+	if err := h.run(t); err != nil {
+		t.Fatalf("Run() = %v; want nil", err)
+	}
+	out := captured.String()
+	for _, line := range []string{"a tick failed", "ticks succeed again"} {
+		if got := strings.Count(out, line); got != 1 {
+			t.Errorf("log lines %q = %d; want 1\n%s", line, got, out)
+		}
+	}
+}
+
+func TestNextWait(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name     string
+		current  time.Duration
+		inFlight bool
+		event    bool
+		want     time.Duration
+	}{
+		{"IdleDoubles", 10 * time.Second, false, false, 20 * time.Second},
+		{"IdleStopsAtTheCeiling", 40 * time.Second, false, false, time.Minute},
+		{"IdleStaysAtTheCeiling", time.Minute, false, false, time.Minute},
+		{"AnEventResetsToTheProbeInterval", 40 * time.Second, false, true, 0},
+		{"InFlightKeepsTheProbeInterval", 40 * time.Second, true, false, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := nextWait(tt.current, tt.inFlight, tt.event); got != tt.want {
+				t.Errorf("nextWait(%v, %v, %v) = %v; want %v", tt.current, tt.inFlight, tt.event, got, tt.want)
+			}
+		})
+	}
+}
diff --git a/internal/dobbyengine/owned.go b/internal/dobbyengine/owned.go
new file mode 100644
index 000000000..171c7301e
--- /dev/null
+++ b/internal/dobbyengine/owned.go
@@ -0,0 +1,97 @@
+// owned.go handles a run a full pass found owned by another machine: the owner pause, the parent lock release, the one notice, and the re-read of the owner that lifts the pause.
+
+package dobbyengine
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+// ownedElsewhere handles the owned-elsewhere exit of a pass of slug, which has a status file.
+// It keeps the run's full pass owed, records it owned elsewhere, pauses it under the owner, releases the parent lock record naming the run's child, and posts one notice naming `lyx adopt` per owner episode.
+// A failed owner pause warns once per episode and is recorded as failed; it is never retried blind, since the marker gives the run a full pass on each probe tick while no pause covers it.
+// It posts no failing-pass notice.
+func (d *daemon) ownedElsewhere(ctx context.Context, slug string, _ time.Time) {
+	var noticeSent bool
+	err := UpdateState(d.geom.StatePath, func(s *State) error {
+		rs := s.Runs[slug]
+		rs.FullPassOwed, rs.OwnedElsewhere = true, true
+		noticeSent = rs.OwnerNoticeSent
+		if s.Runs == nil {
+			s.Runs = map[string]RunState{}
+		}
+		s.Runs[slug] = rs
+		return nil
+	})
+	if err != nil {
+		logger.Warn("dobbyengine: the owned-elsewhere mark could not be recorded", "slug", slug, "error", err)
+		return
+	}
+
+	pauseFailed := false
+	if err := d.deps.PauseOwned(ctx, slug); err != nil {
+		pauseFailed = true
+		d.ownerPauses.Fail(slug, "dobbyengine: pausing a run owned by another machine failed; the next probe tick runs it a full pass", "slug", slug, "error", err)
+	} else {
+		d.ownerPauses.Recover(slug, "dobbyengine: the owner pause stands again", "slug", slug)
+	}
+	if err := d.deps.ReleaseParentLock(ctx, slug); err != nil {
+		logger.Warn("dobbyengine: releasing the parent lock record of a run owned by another machine failed", "slug", slug, "error", err)
+	}
+
+	if !noticeSent {
+		noticeSent = d.noticeOwnedElsewhere(ctx, slug)
+	}
+	err = UpdateState(d.geom.StatePath, func(s *State) error {
+		rs := s.Runs[slug]
+		rs.OwnerPauseFailed, rs.OwnerNoticeSent = pauseFailed, noticeSent
+		s.Runs[slug] = rs
+		return nil
+	})
+	if err != nil {
+		logger.Warn("dobbyengine: the owner pause outcome could not be recorded", "slug", slug, "error", err)
+	}
+}
+
+// noticeOwnedElsewhere posts the owner notice for slug and reports whether it went out.
+func (d *daemon) noticeOwnedElsewhere(ctx context.Context, slug string) bool {
+	owner, err := d.deps.SlugOwner(slug)
+	if err != nil || owner == "" {
+		owner = "another machine"
+	}
+	line := fmt.Sprintf("%s: owned by %s, so it is paused here; way forward: run lyx adopt %s on this machine to take it over, or on the owner's machine to continue it there", slug, owner, slug)
+	if err := d.deps.Notice(ctx, line); err != nil {
+		logger.Warn("dobbyengine: the owned-elsewhere notice did not go out", "slug", slug, "error", err)
+		return false
+	}
+	return true
+}
+
+// recheckOwnerPause reads the effective owner of slug from the local Bolt, with no pull, once its owner pause stands.
+// When it no longer reads another machine it lifts the dobby's own owner pause entry and owes the run a full pass at once.
+// An adopt landing in that window runs on this machine and writes the local Bolt first, so it strands no run on a manual step.
+func (d *daemon) recheckOwnerPause(ctx context.Context, slug string) {
+	machine, err := d.deps.Machine()
+	if err != nil {
+		logger.Warn("dobbyengine: this machine's name is unreadable; the owner pause stays", "slug", slug, "error", err)
+		return
+	}
+	owner, err := d.deps.SlugOwner(slug)
+	if err != nil {
+		logger.Warn("dobbyengine: the run's owner is unreadable; the owner pause stays", "slug", slug, "error", err)
+		return
+	}
+	if owner != "" && owner != machine {
+		return
+	}
+	if err := d.deps.LiftOwnerPause(ctx, slug); err != nil {
+		logger.Warn("dobbyengine: lifting the owner pause failed; the next probe tick tries again", "slug", slug, "error", err)
+		return
+	}
+	d.liftPending[slug] = true
+	// The lift is handled here, so the view that reads the pause gone next tick registers no second one.
+	d.wasCovered[slug] = false
+}
diff --git a/internal/dobbyengine/owned_test.go b/internal/dobbyengine/owned_test.go
new file mode 100644
index 000000000..4d3fb9433
--- /dev/null
+++ b/internal/dobbyengine/owned_test.go
@@ -0,0 +1,116 @@
+//go:build tier0
+
+// owned_test.go pins the handling of a run a full pass found owned by another machine: the pause, the single notice, the full pass at the lift and the owner re-read.
+
+package dobbyengine
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestOwnedElsewhere(t *testing.T) {
+	t.Parallel()
+	owned := PassExit{Code: PassExitOwnedElsewhere}
+
+	t.Run("an owned refusal pauses, releases the lock and notices once across two refusals", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.fake.pauseErr = errors.New("pause refused")
+		h.fake.exits = []PassExit{owned, owned}
+		for range 3 {
+			h.tick(true)
+		}
+		if h.fake.pauses < 2 || h.fake.releases != h.fake.pauses || len(h.fake.notices) != 1 {
+			t.Errorf("pauses, releases, notices = %d, %d, %d; want the handling run for each refusal, with one notice", h.fake.pauses, h.fake.releases, len(h.fake.notices))
+		}
+		if rs := h.state(); !rs.OwnedElsewhere || !rs.OwnerNoticeSent || rs.FailingPassCount != 0 {
+			t.Errorf("state = %+v; want it marked owned elsewhere, noticed, and no failing pass", rs)
+		}
+	})
+
+	t.Run("a failed pause gets a full pass on the next probe tick with no second notice", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.fake.pauseErr = errors.New("pause refused")
+		h.fake.exits = []PassExit{owned}
+		h.tick(true)
+		h.tick(true)
+		if rs := h.state(); !rs.OwnerPauseFailed {
+			t.Errorf("OwnerPauseFailed = false after a failed pause; want true")
+		}
+		spawned := h.fake.spawnsOf("task")
+		if len(spawned) != 2 || spawned[1].continuePass {
+			t.Errorf("passes = %+v; want the next probe tick to run a full pass", spawned)
+		}
+		if len(h.fake.notices) != 1 {
+			t.Errorf("notices = %d; want the one", len(h.fake.notices))
+		}
+	})
+
+	t.Run("a covering owner pause stops every pass, a restart's included, until its lift, which runs a full pass whose exit 0 clears the mark", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.fake.owner = "m2"
+		h.fake.exits = []PassExit{owned}
+		h.tick(true)
+		h.tick(true)
+		h.d.owesAll = true
+		h.tick(true)
+		h.tick(true)
+		if got := len(h.fake.spawnsOf("task")); got != 1 {
+			t.Fatalf("passes under a covering owner pause = %d; want only the one that was refused", got)
+		}
+
+		h.fake.runs[0].Covered = false
+		h.tick(true)
+		spawned := h.fake.spawnsOf("task")
+		if len(spawned) != 2 || spawned[1].continuePass {
+			t.Fatalf("passes at the lift = %+v; want a full pass", spawned)
+		}
+		h.tick(false)
+		if rs := h.state(); rs.OwnedElsewhere || rs.OwnerNoticeSent || rs.OwnerPauseFailed {
+			t.Errorf("state after the full pass exited 0 = %+v; want the mark cleared", rs)
+		}
+	})
+
+	t.Run("a local Bolt that reads this machine again lifts the owner pause and runs a full pass, and one still reading the other machine lifts nothing", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.fake.owner = "m2"
+		h.fake.exits = []PassExit{owned}
+		h.tick(true)
+		h.tick(true)
+
+		h.tick(true)
+		if h.fake.lifts != 0 || len(h.fake.spawnsOf("task")) != 1 {
+			t.Fatalf("lifts, passes with the other machine still owning = %d, %d; want 0, 1", h.fake.lifts, len(h.fake.spawnsOf("task")))
+		}
+
+		h.fake.owner = "m1"
+		h.tick(true)
+		spawned := h.fake.spawnsOf("task")
+		if h.fake.lifts != 1 || len(spawned) != 2 || spawned[1].continuePass {
+			t.Errorf("lifts, passes once this machine owns it = %d, %+v; want 1 lift and a full pass", h.fake.lifts, spawned)
+		}
+	})
+
+	t.Run("a dobby whose only run is marked owned elsewhere under a covering pause is idle, and that run uncovered counts as in flight", func(t *testing.T) {
+		t.Parallel()
+		h := newPassHarness(t, runningRun("task"))
+		h.fake.owner = "m2"
+		h.fake.exits = []PassExit{owned}
+		h.tick(true)
+		h.tick(true)
+		if h.d.inFlight {
+			t.Errorf("inFlight = true with the only run marked and covered; want false")
+		}
+
+		h.fake.runs[0].Covered = false
+		h.d.wasCovered["task"] = false
+		h.tick(true)
+		if !h.d.inFlight {
+			t.Errorf("inFlight = false with the marked run uncovered; want true")
+		}
+	})
+}
diff --git a/internal/dobbyengine/passes.go b/internal/dobbyengine/passes.go
new file mode 100644
index 000000000..0e8d1752f
--- /dev/null
+++ b/internal/dobbyengine/passes.go
@@ -0,0 +1,334 @@
+// passes.go decides which batten passes dobby runs for the runs of its worktree, spawns them, and reads how each one exited.
+
+package dobbyengine
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/logger"
+)
+
+const (
+	// runStateRunning is the batten status state of a run that has not halted, paused, failed or finished.
+	runStateRunning = "running"
+	// producerRunShed is the batten producer that waits on the child run, the only row a continue pass may re-enter.
+	producerRunShed = "Run-Shed"
+	// failingPassNoticeAfter is how many failures in a row with one text post the notice.
+	failingPassNoticeAfter = 3
+)
+
+// RunView is what dobby reads of one batten run it drives.
+type RunView struct {
+	// Slug is the run's slug.
+	Slug string
+	// State is batten's status state and Producer its current producer.
+	State    string
+	Producer string
+	// StatusModified is the modification time of batten's own status file and ChildStatusModified that of the child's status file.
+	StatusModified      time.Time
+	ChildStatusModified time.Time
+	// CancelMarker reports whether the slug's cancel marker exists.
+	CancelMarker bool
+	// DriverLockHeld reports whether the run's driver lock is held, which a pass in flight does.
+	DriverLockHeld bool
+	// OriginOwed reports whether the run's origin-owed marker stands.
+	OriginOwed bool
+	// Covered reports whether a pause entry covers the hub or the slug.
+	Covered bool
+}
+
+// PassExit is how a `lyx batten run` pass ended: its exit code and its last error text.
+type PassExit struct {
+	Code  int
+	Error string
+}
+
+// passKind is the pass planPass decides on.
+type passKind int
+
+const (
+	// passNone is no pass.
+	passNone passKind = iota
+	// passContinue is a continue pass, which re-enters the run at Run-Shed.
+	passContinue
+	// passFull is a full pass.
+	passFull
+	// passFullNoReopen is a full pass that leaves the origin reconcile owed.
+	passFullNoReopen
+)
+
+// passTrigger is what woke the planner for one run.
+type passTrigger struct {
+	// ProbeTick is a probe tick, once per probe interval.
+	ProbeTick bool
+	// ChildWrite is a write of the child's status file.
+	ChildWrite bool
+	// Start is the dobby's start, or a machine sleep.
+	Start bool
+	// Lift is the lift of a pause entry that covered the run.
+	Lift bool
+	// InFlight reports a pass of the run this dobby spawned that has not exited.
+	InFlight bool
+}
+
+// planPass decides, for one run and trigger, none, a continue pass or a full pass.
+// There is none unless batten's state is running, none while the cancel marker exists or a pass is in flight, and a held driver lock reads as in flight.
+// A write of batten's own status file triggers only when it is later than the run's last pass exit, so a pass's own writes never trigger the next.
+// While a pause covers the run, only a continue pass runs, and the full pass at the lift; an owed full pass waits for the lift.
+// A continue pass needs the run at Run-Shed with no full pass owed and no lift to answer, and every other pass is full, with no reopen while the origin-owed marker stands.
+// A run recorded owned elsewhere gets a full pass at the lift of its covering pause, and while no pause covers it a full pass on each probe tick; no other trigger gives it one.
+func planPass(run RunView, rs RunState, trigger passTrigger, covered bool) passKind {
+	if run.State != runStateRunning || run.CancelMarker || trigger.InFlight || run.DriverLockHeld {
+		return passNone
+	}
+	full := passFull
+	if run.OriginOwed {
+		full = passFullNoReopen
+	}
+	if rs.OwnedElsewhere {
+		if trigger.Lift || (trigger.ProbeTick && !covered) {
+			return full
+		}
+		return passNone
+	}
+	battenWrite := run.StatusModified.After(rs.LastPassExit)
+	if !(trigger.ProbeTick || trigger.ChildWrite || trigger.Start || trigger.Lift || battenWrite) {
+		return passNone
+	}
+	if covered {
+		switch {
+		case trigger.Lift:
+			return full
+		case rs.FullPassOwed || run.Producer != producerRunShed:
+			return passNone
+		}
+		return passContinue
+	}
+	if rs.FullPassOwed || run.Producer != producerRunShed || run.OriginOwed || trigger.Lift {
+		return full
+	}
+	return passContinue
+}
+
+// flight is a pass dobby spawned that has not exited.
+type flight struct {
+	exit <-chan PassExit
+	full bool
+	// first marks the first pass of a task dobby started from the board, which has no run yet, and fingerprint is the board entry it read.
+	first       bool
+	fingerprint string
+}
+
+// drivePasses reads exited passes, owes full passes, and spawns the pass each listed run's trigger calls for.
+// It leaves d.busy set while any run is in flight or could be given a pass on the next probe tick.
+func (d *daemon) drivePasses(ctx context.Context, now time.Time) error {
+	d.tickCtx = ctx
+	d.collectExits(now)
+	runs, err := d.deps.Runs()
+	if err != nil {
+		return fmt.Errorf("list the runs: %w", err)
+	}
+	d.runs = runs
+	if err := d.recordOwed(runs); err != nil {
+		return err
+	}
+	current, _, err := ReadState(d.geom.StatePath)
+	if err != nil {
+		return err
+	}
+
+	d.busy = false
+	for _, run := range runs {
+		rs := current.Runs[run.Slug]
+		if d.probeDue && rs.OwnedElsewhere && !rs.OwnerPauseFailed {
+			d.recheckOwnerPause(ctx, run.Slug)
+		}
+		trigger := d.triggerFor(run)
+		kind := planPass(run, rs, trigger, run.Covered)
+		if !trigger.InFlight && (run.State != runStateRunning || run.CancelMarker) {
+			// No pass answers the lift while the run cannot be given one, and a later pass must not inherit it.
+			delete(d.liftPending, run.Slug)
+		}
+		switch {
+		case trigger.InFlight:
+			d.busy = true
+		case kind != passNone:
+			d.busy = true
+			d.spawn(run.Slug, kind, now)
+		case planPass(run, rs, passTrigger{ProbeTick: true}, run.Covered) != passNone:
+			d.busy = true
+		}
+	}
+	listed := make(map[string]bool, len(runs))
+	for _, run := range runs {
+		listed[run.Slug] = true
+	}
+	for slug := range d.liftPending {
+		if !listed[slug] {
+			delete(d.liftPending, slug)
+		}
+	}
+	return nil
+}
+
+// recordOwed owes every listed run a full pass while the dobby owes all, and drops the records of runs no longer listed.
+func (d *daemon) recordOwed(runs []RunView) error {
+	return UpdateState(d.geom.StatePath, func(s *State) error {
+		listed := make(map[string]bool, len(runs))
+		for _, run := range runs {
+			listed[run.Slug] = true
+			if d.owesAll {
+				rs := s.Runs[run.Slug]
+				rs.FullPassOwed = true
+				if s.Runs == nil {
+					s.Runs = map[string]RunState{}
+				}
+				s.Runs[run.Slug] = rs
+			}
+		}
+		for slug := range s.Runs {
+			if !listed[slug] {
+				delete(s.Runs, slug)
+			}
+		}
+		return nil
+	})
+}
+
+// triggerFor reads what woke the planner for run and updates the memory the next tick compares against.
+// A child write that arrives while a pass is in flight is kept for the tick after the pass exits.
+func (d *daemon) triggerFor(run RunView) passTrigger {
+	_, inFlight := d.flights[run.Slug]
+	trigger := passTrigger{ProbeTick: d.probeDue, Start: d.owesAll, InFlight: inFlight}
+	if !inFlight {
+		seen, known := d.childSeen[run.Slug]
+		trigger.ChildWrite = known && run.ChildStatusModified.After(seen)
+		d.childSeen[run.Slug] = run.ChildStatusModified
+	}
+	if d.wasCovered[run.Slug] && !run.Covered {
+		d.liftPending[run.Slug] = true
+	}
+	d.wasCovered[run.Slug] = run.Covered
+	trigger.Lift = d.liftPending[run.Slug]
+	return trigger
+}
+
+// spawn starts the pass kind names for slug.
+// A spawn that fails is a failed pass with the spawn error as its text.
+func (d *daemon) spawn(slug string, kind passKind, now time.Time) {
+	full := kind != passContinue
+	exit, err := d.deps.SpawnPass(slug, !full, kind == passFullNoReopen)
+	delete(d.liftPending, slug)
+	if err != nil {
+		d.passExited(slug, full, 1, err.Error(), now)
+		return
+	}
+	d.flights[slug] = flight{exit: exit, full: full}
+}
+
+// collectExits reads the exit of every pass that has ended, without waiting for one that has not.
+func (d *daemon) collectExits(now time.Time) {
+	for slug, f := range d.flights {
+		select {
+		case exit, ok := <-f.exit:
+			delete(d.flights, slug)
+			if !ok {
+				exit = PassExit{Code: 1, Error: "the pass ended without reporting an exit"}
+			}
+			if f.first {
+				d.firstPassExited(slug, f, exit, now)
+				continue
+			}
+			d.passExited(slug, f.full, exit.Code, exit.Error, now)
+		default:
+		}
+	}
+}
+
+// passExited reads how a pass of slug exited.
+// Exit 0 clears the run's failing-pass count and noticed texts, and its owed full pass when the pass was full and no origin-owed marker stands.
+// A refused continue pass owes a full pass, and a covered pass counts as no failure.
+// The owned-elsewhere exit is never a failing pass.
+// Any other exit counts a failure by its error text, and the third in a row with one text posts one notice to the nearest live orch.
+func (d *daemon) passExited(slug string, full bool, code int, errText string, at time.Time) {
+	originOwed := false
+	if code == 0 && full {
+		originOwed = d.originOwed(slug)
+	}
+	noticeDue := false
+	err := UpdateState(d.geom.StatePath, func(s *State) error {
+		rs := s.Runs[slug]
+		rs.LastPassExit = at
+		switch code {
+		case 0:
+			rs.FailingPassError, rs.FailingPassCount, rs.Noticed = "", 0, nil
+			if full && !originOwed {
+				rs.FullPassOwed = false
+			}
+			if full {
+				rs.OwnedElsewhere, rs.OwnerNoticeSent, rs.OwnerPauseFailed = false, false, false
+			}
+		case PassExitContinueRefused:
+			rs.FullPassOwed = true
+		case PassExitCovered, PassExitOwnedElsewhere:
+		default:
+			if errText == rs.FailingPassError {
+				rs.FailingPassCount++
+			} else {
+				rs.FailingPassError, rs.FailingPassCount = errText, 1
+			}
+			noticeDue = rs.FailingPassCount >= failingPassNoticeAfter && !slices.Contains(rs.Noticed, errText)
+		}
+		if s.Runs == nil {
+			s.Runs = map[string]RunState{}
+		}
+		s.Runs[slug] = rs
+		return nil
+	})
+	if err != nil {
+		logger.Warn("dobbyengine: the pass exit could not be recorded", "slug", slug, "error", err)
+		return
+	}
+	if noticeDue {
+		d.noticeFailingPass(slug, errText)
+	}
+	if code == PassExitOwnedElsewhere {
+		d.ownedElsewhere(d.tickCtx, slug, at)
+	}
+}
+
+// originOwed reads whether slug's origin-owed marker stands now, the pass having just exited.
+// A run no longer listed has none.
+func (d *daemon) originOwed(slug string) bool {
+	runs, err := d.deps.Runs()
+	if err != nil {
+		return true
+	}
+	for _, run := range runs {
+		if run.Slug == slug {
+			return run.OriginOwed
+		}
+	}
+	return false
+}
+
+// noticeFailingPass posts the failing-pass notice for slug and records the text as noticed once it went out.
+func (d *daemon) noticeFailingPass(slug, errText string) {
+	line := fmt.Sprintf("%s: batten pass keeps failing: %s; way forward: fix the cause the text names, then run lyx batten run %s; lyx batten status %s shows the run", slug, errText, slug, slug)
+	if err := d.deps.Notice(d.tickCtx, line); err != nil {
+		logger.Warn("dobbyengine: the failing-pass notice did not go out", "slug", slug, "error", err)
+		return
+	}
+	err := UpdateState(d.geom.StatePath, func(s *State) error {
+		rs := s.Runs[slug]
+		rs.Noticed = append(rs.Noticed, errText)
+		s.Runs[slug] = rs
+		return nil
+	})
+	if err != nil {
+		logger.Warn("dobbyengine: the noticed failing-pass text could not be recorded", "slug", slug, "error", err)
+	}
+}
