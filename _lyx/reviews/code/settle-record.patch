index 000000000..f049e31d2
--- /dev/null
+++ b/internal/driftengine/checkmain.go
@@ -0,0 +1,54 @@
+// checkmain.go — the precondition of a main capture, checked by the capture child under its lock and by the baseline row before it starts one.
+
+package driftengine
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// The rows a main capture is admitted at.
+const (
+	captureRowBaseline = "Drift-Baseline"
+	captureRowAwait    = "Drift-Await"
+)
+
+// CheckMainCapture checks that a main capture may run.
+// The status's current row must be Drift-Baseline, or Drift-Await while the status is blocked, HEAD must equal the branch point and the tracked tree must be clean.
+// A blocked status at Drift-Baseline is admitted only when its error opens with CaptureHaltPrefix.
+// Each refusal opens "drift capture refused:" and names its way forward.
+func CheckMainCapture(status shedengine.Status, head, branchPoint string, dirty []string) error {
+	atBaseline := status.CurrentProducer == captureRowBaseline
+	atAwaitHalt := status.CurrentProducer == captureRowAwait && status.State == shedengine.StateBlocked
+	atBaselineHalt := atBaseline && status.State == shedengine.StateBlocked
+
+	switch {
+	case atBaselineHalt && !strings.HasPrefix(status.Error, CaptureHaltPrefix):
+		return fmt.Errorf("drift capture refused: %s is blocked on something other than a capture halt; way forward: resolve the halt lyx loom status shows, then lyx loom resume", captureRowBaseline)
+	case !atBaseline && !atAwaitHalt:
+		return fmt.Errorf("drift capture refused: the run is at %s (%s), and a main capture runs only at %s or at a %s halt; way forward: run lyx drift capture at a %s halt or at a %s capture halt, which lyx loom status shows", orNone(status.CurrentProducer), status.State, captureRowBaseline, captureRowAwait, captureRowAwait, captureRowBaseline)
+	}
+
+	if head != branchPoint {
+		return fmt.Errorf("drift capture refused: HEAD %s is not the branch point %s, so the capture would not record the task's start; way forward: lyx drift defer, then lyx loom resume", head, branchPoint)
+	}
+
+	if len(dirty) > 0 {
+		next := "lyx loom resume, which captures again"
+		if atAwaitHalt {
+			next = "lyx drift capture again, then lyx loom resume, since the resumed " + captureRowAwait + " only reads the records"
+		}
+		return fmt.Errorf("drift capture refused: the tracked tree is dirty (%s); way forward: restore those paths to HEAD or stash them (committing them would move HEAD off the branch point), then %s; or lyx drift defer, then lyx loom resume", strings.Join(dirty, ", "), next)
+	}
+	return nil
+}
+
+// orNone returns row, or "no row" when it is empty.
+func orNone(row string) string {
+	if row == "" {
+		return "no row"
+	}
+	return row
+}
diff --git a/internal/driftengine/checkmain_test.go b/internal/driftengine/checkmain_test.go
new file mode 100644
index 000000000..dfeb1f4e4
--- /dev/null
+++ b/internal/driftengine/checkmain_test.go
@@ -0,0 +1,84 @@
+//go:build tier0
+
+// checkmain_test.go — tier 0 tests for CheckMainCapture's admitted rows and each refusal's way forward.
+
+package driftengine
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// TestCheckMainCapture covers each admitted row and state, a blocked status at another row, a moved HEAD, and a dirty tree at Drift-Baseline and at a Drift-Await halt.
+func TestCheckMainCapture(t *testing.T) {
+	t.Parallel()
+
+	status := func(row string, state shedengine.State, reason string) shedengine.Status {
+		return shedengine.Status{CurrentProducer: row, State: state, Error: reason}
+	}
+	tests := []struct {
+		name    string
+		status  shedengine.Status
+		head    string
+		dirty   []string
+		want    []string
+		wantNot []string
+	}{
+		{name: "running at Drift-Baseline", status: status("Drift-Baseline", shedengine.StateRunning, ""), head: "bp"},
+		{name: "a capture halt at Drift-Baseline", status: status("Drift-Baseline", shedengine.StateBlocked, CaptureHaltPrefix+"exit 2"), head: "bp"},
+		{name: "a halt at Drift-Await", status: status("Drift-Await", shedengine.StateBlocked, "waiting"), head: "bp"},
+		{
+			name: "a blocked status at Drift-Baseline that is no capture halt", status: status("Drift-Baseline", shedengine.StateBlocked, "decision needed"), head: "bp",
+			want: []string{"drift capture refused:", "other than a capture halt", "lyx loom resume"},
+		},
+		{
+			name: "running at Drift-Await", status: status("Drift-Await", shedengine.StateRunning, ""), head: "bp",
+			want: []string{"drift capture refused:", "Drift-Await (running)", "run lyx drift capture at a Drift-Await halt or at a Drift-Baseline capture halt"},
+		},
+		{
+			name: "blocked at another row", status: status("Code-Review", shedengine.StateBlocked, "x"), head: "bp",
+			want: []string{"drift capture refused:", "Code-Review (blocked)"},
+		},
+		{
+			name: "a moved HEAD", status: status("Drift-Baseline", shedengine.StateRunning, ""), head: "later",
+			want: []string{"drift capture refused:", "HEAD later", "branch point bp", "lyx drift defer, then lyx loom resume"},
+		},
+		{
+			name: "a dirty tree at Drift-Baseline", status: status("Drift-Baseline", shedengine.StateRunning, ""), head: "bp", dirty: []string{"a.go", "b.go"},
+			want:    []string{"drift capture refused:", "a.go, b.go", "restore those paths to HEAD or stash them", "lyx loom resume, which captures again", "lyx drift defer, then lyx loom resume"},
+			wantNot: []string{"lyx drift capture again", "remove"},
+		},
+		{
+			name: "a dirty tree at a Drift-Await halt", status: status("Drift-Await", shedengine.StateBlocked, "waiting"), head: "bp", dirty: []string{"a.go"},
+			want:    []string{"drift capture refused:", "restore those paths to HEAD or stash them", "lyx drift capture again, then lyx loom resume", "lyx drift defer, then lyx loom resume"},
+			wantNot: []string{"captures again", "remove"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			err := CheckMainCapture(tt.status, tt.head, "bp", tt.dirty)
+			if tt.want == nil {
+				if err != nil {
+					t.Fatalf("CheckMainCapture() = %v; want nil", err)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatalf("CheckMainCapture() = nil; want an error containing %q", tt.want)
+			}
+			for _, want := range tt.want {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("CheckMainCapture() error = %q; want it to contain %q", err.Error(), want)
+				}
+			}
+			for _, not := range tt.wantNot {
+				if strings.Contains(err.Error(), not) {
+					t.Errorf("CheckMainCapture() error = %q; want it not to contain %q", err.Error(), not)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/driftengine/compare.go b/internal/driftengine/compare.go
new file mode 100644
index 000000000..1fd8ad390
--- /dev/null
+++ b/internal/driftengine/compare.go
@@ -0,0 +1,124 @@
+// compare.go — the compare run and the skip list it is told: the mechanical comparison Drift-Verify runs itself and the one an agent asks for.
+//
+// RunCompare shares the capture's runner and writes no record; counting a run against the agent session's budget is the caller's.
+
+package driftengine
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// CompareRequest is the told input of a compare run.
+type CompareRequest struct {
+	// Paths are the drift paths of the task's anchor root.
+	Paths Paths
+	// WorktreeRoot is the task worktree the command's relative dir is joined onto.
+	WorktreeRoot string
+	// Step is the declared compare command.
+	Step CommandStep
+	// Pool is the gate-slot pool the compare takes one slot of.
+	Pool *gateslot.Pool
+	// WaitDir is where the compare's wait record is written while it waits for a slot.
+	WaitDir string
+	// Skip is the tests the compare leaves out, written to the skip file.
+	Skip []string
+	// Timeout bounds the command from its start; production passes the step's timeout_min.
+	Timeout time.Duration
+	// Now is the clock the log's name comes from.
+	Now func() time.Time
+	// LockRetry bounds how long a compare retries a compare marker a reader's probe holds before it refuses.
+	// It must be positive: a zero bound refuses even a free marker.
+	LockRetry time.Duration
+}
+
+// CompareResult is how a compare run ended.
+type CompareResult struct {
+	// ExitCode is the command's exit code, -1 when a signal ended it.
+	ExitCode int
+	// Log is the command's log file.
+	Log string
+	// Passed is true when the command exited 0 within its timeout.
+	Passed bool
+	// Reason says why a compare did not pass and names its log; empty when it passed.
+	Reason string
+}
+
+// RunCompare runs the declared compare command against the baseline directory and returns how it ended.
+// It takes the compare marker, an OS lock, before it waits for its gate slot and holds it until it ends, so a compare queued for a slot reads as activity and one a dead compare left reads as none.
+// A marker still held once LockRetry runs out is refused.
+// A non-zero exit and a timeout are results that did not pass, not errors.
+func RunCompare(ctx context.Context, req CompareRequest) (CompareResult, error) {
+	p := req.Paths
+	if err := os.MkdirAll(filepath.Dir(p.CompareMarker), 0o755); err != nil {
+		return CompareResult{}, fmt.Errorf("drift: create %s: %w", filepath.Dir(p.CompareMarker), err)
+	}
+	marker, taken, err := lock.AcquireWriteLockWithin(p.CompareMarker, req.LockRetry)
+	if err != nil {
+		return CompareResult{}, err
+	}
+	if !taken {
+		return CompareResult{}, fmt.Errorf("drift: a compare is already running; way forward: wait for it, then run it again")
+	}
+	defer marker.Release()
+
+	if err := writeSkipFile(p.SkipFile, req.Skip); err != nil {
+		return CompareResult{}, err
+	}
+	result := CompareResult{Log: logPathFor(p.LogsDir, "compare", req.Now())}
+	outcome, err := runStep(ctx, stepRun{
+		WorktreeRoot: req.WorktreeRoot,
+		Step:         req.Step,
+		Pool:         req.Pool,
+		WaitDir:      req.WaitDir,
+		Site:         "drift compare",
+		BaselineDir:  p.BaselineDir,
+		SkipFile:     p.SkipFile,
+		LogPath:      result.Log,
+		Timeout:      req.Timeout,
+		Now:          req.Now,
+		OnSlot:       func(time.Time) {},
+		OnStart:      func(int, time.Time) {},
+	})
+	if err != nil {
+		return result, err
+	}
+	outcome.release()
+
+	result.ExitCode = outcome.ExitCode
+	switch {
+	case outcome.TimedOut:
+		result.Reason = "timed out after " + timeoutMinutes(req.Timeout) + "m; log " + result.Log
+	case outcome.ExitCode != 0:
+		result.Reason = "exit " + strconv.Itoa(outcome.ExitCode) + "; log " + result.Log
+	default:
+		result.Passed = true
+	}
+	return result, nil
+}
+
+// SkipList returns the tests a compare leaves out: the scope's skipped tests, then every accepted test, without duplicates.
+// A withdrawn test is off the accepted list, so it is run again.
+func SkipList(scope ScopeRecord) []string {
+	var skip []string
+	add := func(test string) {
+		if !slices.Contains(skip, test) {
+			skip = append(skip, test)
+		}
+	}
+	for _, test := range scope.Skip {
+		add(test)
+	}
+	for _, acceptance := range scope.Accepted {
+		add(acceptance.Test)
+	}
+	return skip
+}
diff --git a/internal/driftengine/compare_test.go b/internal/driftengine/compare_test.go
new file mode 100644
index 000000000..f02562fa0
--- /dev/null
+++ b/internal/driftengine/compare_test.go
@@ -0,0 +1,152 @@
+//go:build tier1 && !windows
+
+// compare_test.go — tier 1 tests for RunCompare, driven by fake sh commands against a temp gate-slot pool.
+
+package driftengine
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// newCompareFixture returns a compare request, and the pool it takes a slot of, that runs command in a temp worktree.
+func newCompareFixture(t *testing.T, command string) (CompareRequest, *gateslot.Pool) {
+	t.Helper()
+	f := newCaptureFixture(t, command)
+	return CompareRequest{
+		Paths:        f.req.Paths,
+		WorktreeRoot: f.req.WorktreeRoot,
+		Step:         f.req.Step,
+		Pool:         f.pool,
+		WaitDir:      f.req.WaitDir,
+		Timeout:      time.Minute,
+		Now:          time.Now,
+		LockRetry:    time.Second,
+	}, f.pool
+}
+
+// TestRunCompare covers a pass, a failure naming its log, the rendered placeholders, the marker read as held while the run waits for a slot, the timeout tree kill and a held marker.
+func TestRunCompare(t *testing.T) {
+	t.Parallel()
+
+	t.Run("exit 0 passes", func(t *testing.T) {
+		t.Parallel()
+		req, pool := newCompareFixture(t, "true")
+		got, err := RunCompare(context.Background(), req)
+		if err != nil || !got.Passed || got.ExitCode != 0 || got.Reason != "" {
+			t.Errorf("RunCompare() = %+v, %v; want a pass", got, err)
+		}
+		if !slotFree(t, pool) {
+			t.Errorf("the slot is still held after the compare")
+		}
+	})
+
+	t.Run("a non-zero exit fails and names the log", func(t *testing.T) {
+		t.Parallel()
+		req, _ := newCompareFixture(t, "echo drifted; exit 4")
+		got, err := RunCompare(context.Background(), req)
+		if err != nil || got.Passed || got.ExitCode != 4 || !strings.Contains(got.Reason, "exit 4") || !strings.Contains(got.Reason, got.Log) {
+			t.Fatalf("RunCompare() = %+v, %v; want a failure with exit 4 naming its log", got, err)
+		}
+		if text := readFile(t, got.Log); text != "drifted\n" {
+			t.Errorf("log = %q; want the command's output", text)
+		}
+	})
+
+	t.Run("the command sees the skip list and the baseline directory", func(t *testing.T) {
+		t.Parallel()
+		req, _ := newCompareFixture(t, "cat {skip_file} > seen.txt; echo {baseline_dir} >> seen.txt")
+		req.Skip = []string{"TestA", "TestB"}
+		if got, err := RunCompare(context.Background(), req); err != nil || !got.Passed {
+			t.Fatalf("RunCompare() = %+v, %v; want a pass", got, err)
+		}
+		want := "TestA\nTestB\n" + req.Paths.BaselineDir + "\n"
+		if text := readFile(t, filepath.Join(req.WorktreeRoot, "seen.txt")); text != want {
+			t.Errorf("seen.txt = %q; want %q", text, want)
+		}
+	})
+
+	t.Run("the marker reads held while the run waits for a slot and free once it ends", func(t *testing.T) {
+		t.Parallel()
+		req, pool := newCompareFixture(t, "true")
+		lease, err := pool.Acquire(context.Background(), gateslot.Holder{Worktree: req.WorktreeRoot, Site: "test"})
+		if err != nil {
+			t.Fatalf("Acquire() = %v; want nil", err)
+		}
+
+		done := make(chan CompareResult, 1)
+		go func() {
+			got, err := RunCompare(context.Background(), req)
+			if err != nil {
+				t.Errorf("RunCompare() = _, %v; want nil", err)
+			}
+			done <- got
+		}()
+		eventually(t, "the compare's wait record", func() bool {
+			waits, _ := gateslot.ReadWaits(req.WaitDir)
+			return len(waits) == 1
+		})
+		if held, err := ProbeLock(req.Paths.CompareMarker); !held || err != nil {
+			t.Errorf("ProbeLock(CompareMarker) while queued = %v, %v; want held", held, err)
+		}
+
+		if err := lease.Release(); err != nil {
+			t.Fatalf("Release() = %v; want nil", err)
+		}
+		if got := <-done; !got.Passed {
+			t.Errorf("RunCompare() = %+v; want a pass once the slot is free", got)
+		}
+		if held, err := ProbeLock(req.Paths.CompareMarker); held || err != nil {
+			t.Errorf("ProbeLock(CompareMarker) after the run = %v, %v; want free", held, err)
+		}
+	})
+
+	t.Run("a shortened timeout kills the tree and fails", func(t *testing.T) {
+		t.Parallel()
+		req, pool := newCompareFixture(t, "sleep 60")
+		req.Timeout = 300 * time.Millisecond
+		got, err := RunCompare(context.Background(), req)
+		if err != nil || got.Passed || !strings.HasPrefix(got.Reason, "timed out after ") {
+			t.Errorf("RunCompare() = %+v, %v; want a failure naming the timeout", got, err)
+		}
+		if !slotFree(t, pool) {
+			t.Errorf("the slot is still held after the timeout")
+		}
+	})
+
+	t.Run("a marker held past LockRetry refuses, and one held briefly inside it does not", func(t *testing.T) {
+		t.Parallel()
+		req, _ := newCompareFixture(t, "true")
+		held := holdLock(t, req.Paths.CompareMarker)
+		req.LockRetry = 30 * time.Millisecond
+		if _, err := RunCompare(context.Background(), req); err == nil || !strings.Contains(err.Error(), "a compare is already running") {
+			t.Errorf("RunCompare() with the marker held = %v; want the refusal", err)
+		}
+
+		req.LockRetry = 10 * time.Second
+		time.AfterFunc(50*time.Millisecond, func() { _ = held.Release() })
+		if got, err := RunCompare(context.Background(), req); err != nil || !got.Passed {
+			t.Errorf("RunCompare() with a brief hold = %+v, %v; want a pass", got, err)
+		}
+	})
+}
+
+// holdLock takes the lock at path, creating its directory.
+func holdLock(t *testing.T, path string) *lock.FileLock {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("MkdirAll() = %v; want nil", err)
+	}
+	held, err := lock.AcquireWriteLock(path)
+	if err != nil {
+		t.Fatalf("AcquireWriteLock() = %v; want nil", err)
+	}
+	return held
+}
diff --git a/internal/driftengine/config.go b/internal/driftengine/config.go
new file mode 100644
index 000000000..600a67844
--- /dev/null
+++ b/internal/driftengine/config.go
@@ -0,0 +1,198 @@
+// config.go — configuration for the drift module.
+//
+// It defines the Config and CommandStep types mirroring drift.yaml's keys, the ConfigTemplate and ConfigSpec accessors, and LoadConfig, which loads the file strictly.
+// The module is hub-wide, so every path here is told by the caller.
+
+package driftengine
+
+import (
+	_ "embed"
+	"fmt"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed template.yaml
+var configTemplate string
+
+// ConfigTemplate returns the default YAML template for the drift config module.
+func ConfigTemplate() string {
+	return configTemplate
+}
+
+// configModule is the config module name drift.yaml is loaded under.
+const configModule = "drift"
+
+// baselineDirPlaceholder is the placeholder a declared command holds for the directory a capture writes to and a compare reads from.
+const baselineDirPlaceholder = "{baseline_dir}"
+
+// Step names of the two command steps.
+const (
+	stepCapture = "capture"
+	stepCompare = "compare"
+)
+
+// CommandStep is one declared drift command: the shell command, its run directory and the environment it runs with.
+// The zero CommandStep is an undeclared step.
+type CommandStep struct {
+	// Command is the shell command the step runs, holding the {baseline_dir} placeholder.
+	Command string `yaml:"command"`
+	// Dir is the run directory, absolute or relative to the worktree root.
+	Dir string `yaml:"dir"`
+	// Env is the environment the command runs with, over the process environment.
+	Env map[string]string `yaml:"env"`
+	// TimeoutMin is the minutes the command may run.
+	TimeoutMin int `yaml:"timeout_min"`
+}
+
+// Config represents the resolved drift.yaml configuration.
+type Config struct {
+	// Enabled switches the Drift rows on through their entry gate.
+	Enabled bool
+	// Capture is the declared capture step, or the zero CommandStep.
+	Capture CommandStep
+	// Compare is the declared compare step, or the zero CommandStep.
+	Compare CommandStep
+	// BaselineModel is the model-spec of the Drift-Baseline agent.
+	BaselineModel string
+	// VerifyModel is the model-spec of the Drift-Verify agent.
+	VerifyModel string
+	// VerifyMaxRuns is how many compare or side-capture runs one Drift-Verify agent session may take.
+	VerifyMaxRuns int
+}
+
+// configFile is drift.yaml as it is spelled, before defaults and validation.
+type configFile struct {
+	Enabled       bool     `yaml:"enabled"`
+	Capture       stepFile `yaml:"capture"`
+	Compare       stepFile `yaml:"compare"`
+	BaselineModel string   `yaml:"baseline_model"`
+	VerifyModel   string   `yaml:"verify_model"`
+	VerifyMaxRuns int      `yaml:"verify_max_runs"`
+}
+
+// stepFile is a command step as drift.yaml spells it; TimeoutMin is a pointer so a missing key reads apart from a zero.
+type stepFile struct {
+	Command    string            `yaml:"command"`
+	Dir        string            `yaml:"dir"`
+	Env        map[string]string `yaml:"env"`
+	TimeoutMin *int              `yaml:"timeout_min"`
+}
+
+// ConfigOpenMaps returns the drift.yaml keys whose value is the operator's own mapping, which configengine carries whole through reconcile and --set.
+func ConfigOpenMaps() []string {
+	return []string{stepCapture, stepCompare}
+}
+
+// ConfigSpec returns drift's layered-load spec.
+// capture and compare run commands, so they are executable keys and closed to the local layer.
+func ConfigSpec() configengine.Spec {
+	return configengine.Spec{
+		Name:     configModule,
+		Template: []byte(ConfigTemplate()),
+		HubWide:  true,
+		OpenMaps: ConfigOpenMaps(),
+		Categories: map[string]configengine.Category{
+			"enabled":         configengine.CategoryNone,
+			stepCapture:       configengine.CategoryExecutable,
+			stepCompare:       configengine.CategoryExecutable,
+			"baseline_model":  configengine.CategoryNone,
+			"verify_model":    configengine.CategoryNone,
+			"verify_max_runs": configengine.CategoryNone,
+		},
+	}
+}
+
+// LoadConfig loads and validates the drift module's configuration strictly through the hub-wide layer stack under dirs.
+// A declared step needs a command holding {baseline_dir} and a timeout_min of at least 1, and its dir defaults to ".";
+// an all-empty step is undeclared and loads as the zero CommandStep.
+// Every refusal names the key and lyx config drift as the way forward.
+func LoadConfig(dirs configengine.Dirs) (Config, error) {
+	resolved, err := configengine.Load(dirs, ConfigSpec())
+	if err != nil {
+		if strings.Contains(err.Error(), "not initialized") {
+			return Config{}, fmt.Errorf("not initialized here; run \"lyx fabric reconcile\"")
+		}
+		return Config{}, err
+	}
+
+	var file configFile
+	if err := yaml.Unmarshal(resolved, &file); err != nil {
+		return Config{}, fmt.Errorf("unmarshal drift config: %w", err)
+	}
+
+	capture, err := decodeStep(stepCapture, file.Capture)
+	if err != nil {
+		return Config{}, err
+	}
+	compare, err := decodeStep(stepCompare, file.Compare)
+	if err != nil {
+		return Config{}, err
+	}
+	if file.VerifyMaxRuns < 1 {
+		return Config{}, refuseKey("verify_max_runs", fmt.Sprintf("%d; want at least 1", file.VerifyMaxRuns))
+	}
+	for key, spec := range map[string]string{"baseline_model": file.BaselineModel, "verify_model": file.VerifyModel} {
+		if _, err := modelspec.Parse(spec); err != nil {
+			return Config{}, refuseKey(key, err.Error())
+		}
+	}
+	return Config{
+		Enabled:       file.Enabled,
+		Capture:       capture,
+		Compare:       compare,
+		BaselineModel: file.BaselineModel,
+		VerifyModel:   file.VerifyModel,
+		VerifyMaxRuns: file.VerifyMaxRuns,
+	}, nil
+}
+
+// refuseKey builds the refusal of a drift config key, naming the key and its way forward.
+func refuseKey(key, want string) error {
+	return fmt.Errorf("drift config key %q: %s; way forward: fix it with lyx config drift", key, want)
+}
+
+// decodeStep validates one declared command step and fills its defaults; a step with no key set is undeclared and decodes to the zero CommandStep.
+func decodeStep(name string, file stepFile) (CommandStep, error) {
+	if file.Command == "" && file.Dir == "" && len(file.Env) == 0 && file.TimeoutMin == nil {
+		return CommandStep{}, nil
+	}
+	if strings.TrimSpace(file.Command) == "" {
+		return CommandStep{}, refuseKey(name+".command", "missing; want the shell command the step runs")
+	}
+	if !strings.Contains(file.Command, baselineDirPlaceholder) {
+		return CommandStep{}, refuseKey(name+".command", "holds no "+baselineDirPlaceholder+"; want the placeholder where the command reads or writes the baseline")
+	}
+	if file.TimeoutMin == nil {
+		return CommandStep{}, refuseKey(name+".timeout_min", "missing; want at least 1")
+	}
+	if *file.TimeoutMin < 1 {
+		return CommandStep{}, refuseKey(name+".timeout_min", fmt.Sprintf("%d; want at least 1", *file.TimeoutMin))
+	}
+	step := CommandStep{Command: file.Command, Dir: file.Dir, Env: file.Env, TimeoutMin: *file.TimeoutMin}
+	if step.Dir == "" {
+		step.Dir = "."
+	}
+	return step, nil
+}
+
+// Step returns the declared capture or compare step.
+// An undeclared step is refused with the way to declare it, so no row or verb runs an empty command.
+func (c Config) Step(name string) (CommandStep, error) {
+	var step CommandStep
+	switch name {
+	case stepCapture:
+		step = c.Capture
+	case stepCompare:
+		step = c.Compare
+	default:
+		return CommandStep{}, fmt.Errorf("drift: %q is not a command step; want %s or %s", name, stepCapture, stepCompare)
+	}
+	if step.Command == "" {
+		return CommandStep{}, fmt.Errorf("drift: %s is not declared; way forward: declare it with lyx config drift --set '%s={command: ..., timeout_min: N}'", name, name)
+	}
+	return step, nil
+}
diff --git a/internal/driftengine/config_test.go b/internal/driftengine/config_test.go
new file mode 100644
index 000000000..d239e6d9b
--- /dev/null
+++ b/internal/driftengine/config_test.go
@@ -0,0 +1,214 @@
+//go:build tier0
+
+// config_test.go — tier 0 unit tests for driftengine.LoadConfig, Config.Step and the drift paths.
+//
+// Seeds a bare t.TempDir() with just a _lyx/config/drift.yaml file (no real hub, no git spawn).
+
+package driftengine
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configengine"
+)
+
+// seedDriftConfig creates <baseDir>/_lyx/config/drift.yaml with the given contents.
+func seedDriftConfig(t *testing.T, baseDir, contents string) {
+	t.Helper()
+	configDir := filepath.Join(baseDir, "_lyx", "config")
+	if err := os.MkdirAll(configDir, 0o755); err != nil {
+		t.Fatalf("MkdirAll(%q) = %v; want nil", configDir, err)
+	}
+	if err := os.WriteFile(filepath.Join(configDir, "drift.yaml"), []byte(contents), 0o644); err != nil {
+		t.Fatalf("WriteFile drift.yaml = %v; want nil", err)
+	}
+}
+
+// withKey returns the template with the line of key replaced by line.
+func withKey(t *testing.T, key, line string) string {
+	t.Helper()
+	var out []string
+	replaced := false
+	for _, templateLine := range strings.Split(ConfigTemplate(), "\n") {
+		if strings.HasPrefix(templateLine, key+":") {
+			out = append(out, line)
+			replaced = true
+			continue
+		}
+		out = append(out, templateLine)
+	}
+	if !replaced {
+		t.Fatalf("template holds no key %q", key)
+	}
+	return strings.Join(out, "\n")
+}
+
+// templateConfig returns the Config the embedded template loads as, changed by mutate.
+func templateConfig(mutate func(*Config)) Config {
+	cfg := Config{BaselineModel: "sonnet[medium]", VerifyModel: "opus[high]", VerifyMaxRuns: 8}
+	mutate(&cfg)
+	return cfg
+}
+
+// TestLoadConfig covers the template's defaults, a declared step and its defaults, every refusal, the local layer closing both executable keys, a base directory with no drift.yaml, Step, and the drift paths.
+func TestLoadConfig(t *testing.T) {
+	t.Parallel()
+
+	capture := "capture: {command: \"profile --out {baseline_dir}\", timeout_min: 30}"
+	tests := []struct {
+		name     string
+		contents string
+		seed     bool
+		want     Config
+		wantErr  []string
+	}{
+		{name: "template defaults", seed: true, contents: ConfigTemplate(), want: templateConfig(func(*Config) {})},
+		{
+			name: "a declared capture loads with dir defaulted", seed: true,
+			contents: withKey(t, "capture", capture),
+			want: templateConfig(func(c *Config) {
+				c.Capture = CommandStep{Command: "profile --out {baseline_dir}", Dir: ".", TimeoutMin: 30}
+			}),
+		},
+		{
+			name: "a declared compare keeps its dir and env", seed: true,
+			contents: withKey(t, "compare", "compare: {command: \"cmp {baseline_dir} {skip_file}\", dir: tools, env: {A: b}, timeout_min: 5}"),
+			want: templateConfig(func(c *Config) {
+				c.Compare = CommandStep{Command: "cmp {baseline_dir} {skip_file}", Dir: "tools", Env: map[string]string{"A": "b"}, TimeoutMin: 5}
+			}),
+		},
+		{
+			name: "enabled loads", seed: true,
+			contents: withKey(t, "enabled", "enabled: true"),
+			want:     templateConfig(func(c *Config) { c.Enabled = true }),
+		},
+		{
+			name: "a capture without the baseline placeholder", seed: true,
+			contents: withKey(t, "capture", "capture: {command: profile, timeout_min: 30}"),
+			wantErr:  []string{"capture.command", "{baseline_dir}", "lyx config drift"},
+		},
+		{
+			name: "a compare without a command", seed: true,
+			contents: withKey(t, "compare", "compare: {timeout_min: 30}"),
+			wantErr:  []string{"compare.command", "lyx config drift"},
+		},
+		{
+			name: "a capture without a timeout", seed: true,
+			contents: withKey(t, "capture", "capture: {command: \"p {baseline_dir}\"}"),
+			wantErr:  []string{"capture.timeout_min", "lyx config drift"},
+		},
+		{
+			name: "a capture timeout below 1", seed: true,
+			contents: withKey(t, "capture", "capture: {command: \"p {baseline_dir}\", timeout_min: 0}"),
+			wantErr:  []string{"capture.timeout_min", "lyx config drift"},
+		},
+		{
+			name: "verify_max_runs below 1", seed: true,
+			contents: withKey(t, "verify_max_runs", "verify_max_runs: 0"),
+			wantErr:  []string{"verify_max_runs", "lyx config drift"},
+		},
+		{
+			name: "an invalid baseline model", seed: true,
+			contents: withKey(t, "baseline_model", "baseline_model: \"sonnet[medium\""),
+			wantErr:  []string{"baseline_model", "lyx config drift"},
+		},
+		{
+			name: "an invalid verify model", seed: true,
+			contents: withKey(t, "verify_model", "verify_model: \"opus[high\""),
+			wantErr:  []string{"verify_model", "lyx config drift"},
+		},
+		{name: "not initialized", wantErr: []string{`not initialized here; run "lyx fabric reconcile"`}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			baseDir := t.TempDir()
+			if tt.seed {
+				seedDriftConfig(t, baseDir, tt.contents)
+			}
+			got, err := LoadConfig(configengine.Dirs{Board: baseDir})
+			if tt.wantErr != nil {
+				if err == nil {
+					t.Fatalf("LoadConfig() = _, nil; want an error containing %q", tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("LoadConfig() error = %q; want it to contain %q", err.Error(), want)
+					}
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig() = _, %v; want nil error", err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("LoadConfig() = %+v; want %+v", got, tt.want)
+			}
+		})
+	}
+
+	for key, local := range map[string]string{
+		"capture": "capture: {command: \"p {baseline_dir}\", timeout_min: 1}\n",
+		"compare": "compare: {command: \"c {baseline_dir}\", timeout_min: 1}\n",
+	} {
+		t.Run("a local "+key+" is refused naming the key", func(t *testing.T) {
+			t.Parallel()
+			board, anchor := t.TempDir(), t.TempDir()
+			seedDriftConfig(t, board, ConfigTemplate())
+			for _, dir := range []string{configengine.ConfigDir(anchor), configengine.ScratchDir(anchor)} {
+				if err := os.MkdirAll(dir, 0o755); err != nil {
+					t.Fatalf("MkdirAll(%q) = %v; want nil", dir, err)
+				}
+			}
+			localPath := configengine.LocalFile(anchor, "drift")
+			if err := os.WriteFile(localPath, []byte(local), 0o644); err != nil {
+				t.Fatalf("WriteFile(%q) = %v; want nil", localPath, err)
+			}
+
+			_, err := LoadConfig(configengine.Dirs{Anchor: anchor, Board: board})
+			if !errors.Is(err, configengine.ErrInvalid) || !strings.Contains(err.Error(), key) {
+				t.Errorf("LoadConfig() error = %v; want ErrInvalid naming %q", err, key)
+			}
+		})
+	}
+
+	t.Run("Step returns a declared step and refuses an undeclared one", func(t *testing.T) {
+		t.Parallel()
+		cfg := templateConfig(func(c *Config) { c.Capture = CommandStep{Command: "p {baseline_dir}", Dir: ".", TimeoutMin: 3} })
+
+		got, err := cfg.Step("capture")
+		if err != nil || !reflect.DeepEqual(got, CommandStep{Command: "p {baseline_dir}", Dir: ".", TimeoutMin: 3}) {
+			t.Errorf("Step(capture) = %+v, %v; want the declared step", got, err)
+		}
+		if _, err := cfg.Step("compare"); err == nil || !strings.Contains(err.Error(), "lyx config drift --set 'compare=") {
+			t.Errorf("Step(compare) error = %v; want a refusal naming lyx config drift --set", err)
+		}
+	})
+
+	t.Run("the durable paths lie under DirRel", func(t *testing.T) {
+		t.Parallel()
+		root := t.TempDir()
+		p := NewPaths(root)
+		if got := DirRel(); got != "_lyx/drift" {
+			t.Errorf("DirRel() = %q; want _lyx/drift", got)
+		}
+		durable := filepath.Join(root, filepath.FromSlash(DirRel())) + string(filepath.Separator)
+		for name, file := range map[string]string{"Scope": p.Scope, "BaselineReport": p.BaselineReport, "VerifyReport": p.VerifyReport, "LogsDir": p.LogsDir} {
+			if !strings.HasPrefix(file, durable) {
+				t.Errorf("NewPaths().%s = %q; want it under %q", name, file, durable)
+			}
+		}
+		ephemeral := filepath.Join(root, ".lyx", "drift") + string(filepath.Separator)
+		for name, file := range map[string]string{"Capture": p.Capture, "CaptureLock": p.CaptureLock, "CompareMarker": p.CompareMarker, "BaselineDir": p.BaselineDir, "SideDir": p.SideDir, "SkipFile": p.SkipFile, "Runs": p.Runs} {
+			if !strings.HasPrefix(file, ephemeral) {
+				t.Errorf("NewPaths().%s = %q; want it under %q", name, file, ephemeral)
+			}
+		}
+	})
+}
diff --git a/internal/driftengine/deps.go b/internal/driftengine/deps.go
new file mode 100644
index 000000000..50563a22d
--- /dev/null
+++ b/internal/driftengine/deps.go
@@ -0,0 +1,90 @@
+// deps.go — the told seams the Drift producers share, and the portable config of one Drift row.
+
+package driftengine
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shedadapters"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// Deps holds the seams the Drift producers read, so a test substitutes each one.
+// A producer fails loudly, naming the field, when a seam it reads is nil.
+type Deps struct {
+	// Paths are the drift paths of the task's anchor root.
+	Paths Paths
+	// WorktreeRoot is the task worktree.
+	WorktreeRoot string
+	// Config loads the hub's drift config.
+	Config func() (Config, error)
+	// Status reads the run's status.
+	Status func() (shedengine.Status, error)
+	// AwaitRow is true for the loom recipe, which has a Drift-Await row.
+	AwaitRow bool
+	// Head, BranchPoint and DirtyPaths read the code checkout's HEAD, its branch point and its tracked dirty paths.
+	Head        func() (string, error)
+	BranchPoint func() (string, error)
+	DirtyPaths  func() ([]string, error)
+	// Commit commits the told anchor-relative paths under the durable drift directory with the run's records.
+	Commit func(relPaths []string) error
+	// Seats and Now are the seat runner and the clock the registry entry fills from the recipe's environment.
+	Seats shedadapters.SeatRunner
+	Now   func() time.Time
+	// BaselineTable builds the Drift-Baseline agent's table; scopeNote is non-empty when the scope is already recorded.
+	BaselineTable func(scopeNote string) (seatengine.Table, error)
+	// StartCapture starts the detached capture and returns once its record exists.
+	StartCapture func() error
+	// RunCapture runs the capture in the calling process and returns its final record.
+	RunCapture func(ctx context.Context) (CaptureRecord, error)
+	// Sleep waits d or until ctx ends; it is the clock of the capture wait.
+	Sleep func(ctx context.Context, d time.Duration) error
+	// VerifyTable builds the Drift-Verify agent's table for the failing compare's log and the baseline's commit.
+	VerifyTable func(told VerifyTold) (seatengine.Table, error)
+	// Compare runs the mechanical compare over the scope's skip list and returns how it ended.
+	Compare func(ctx context.Context) (CompareResult, error)
+	// GateFindingsFile is the file an exhausted gate entry's findings are kept in; empty keeps none.
+	GateFindingsFile string
+}
+
+// Row is the portable config of one Drift row.
+type Row struct {
+	// Subject is SubjectDecisionRecord or SubjectBoardEntry.
+	Subject string
+	// WaitCapture makes Drift-Baseline run the capture in its own process and wait for it, which darn's `capture: wait` asks for.
+	WaitCapture bool
+}
+
+// commitOnExit commits relPaths through commit after a producer pass and returns the pass's result.
+// A failed commit is returned beside the pass's own error and replaces the outcome, since the drift records must reach git.
+func commitOnExit(name string, commit func([]string) error, relPaths []string, outcome shedengine.Outcome, pointer shedengine.OutputPointer, err error) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	if commitErr := commit(relPaths); commitErr != nil {
+		return "", shedengine.OutputPointer{}, errors.Join(err, fmt.Errorf("drift: %s: commit the drift records: %w", name, commitErr))
+	}
+	return outcome, pointer, err
+}
+
+// seam names one Deps field and whether the producer was told it.
+type seam struct {
+	name string
+	set  bool
+}
+
+// requireSeams returns the wiring error naming every seam that is not set, or nil.
+func requireSeams(producer string, seams ...seam) error {
+	var missing []string
+	for _, s := range seams {
+		if !s.set {
+			missing = append(missing, s.name)
+		}
+	}
+	if len(missing) == 0 {
+		return nil
+	}
+	return fmt.Errorf("drift: %s is wired without Deps.%s", producer, strings.Join(missing, ", Deps."))
+}
diff --git a/internal/driftengine/doc.go b/internal/driftengine/doc.go
new file mode 100644
index 000000000..d819d3451
--- /dev/null
+++ b/internal/driftengine/doc.go
@@ -0,0 +1,106 @@
+// Package driftengine owns regression around a task: the hub-wide `drift` config module, the drift paths, and the records and runs the Drift rows read and write.
+// Regression is no test tier: it records a profile of the suite's behavior on the task's branch point and compares the task's code against it, and `lyx gate test` never runs it.
+//
+// `drift.yaml` is a hub-wide config module with these keys: `enabled`, which switches the Drift rows on through their entry gate; `capture` and `compare`, each a command step written whole as `{command, dir, env, timeout_min}`; `baseline_model` and `verify_model`, the model-specs of the two agents; and `verify_max_runs`, the run budget of one Drift-Verify agent session.
+// A declared command holds the placeholder `{baseline_dir}`, the directory the capture writes its profile files to and the compare reads them from, and may hold `{skip_file}`, a file naming one skipped test per line.
+// `capture` and `compare` are executable keys, so only the template and the hub's board default layer set them, with `lyx config drift --set 'capture={command: ..., timeout_min: N}'`.
+// LoadConfig loads the file strictly and refuses a declared step without `{baseline_dir}` or with a `timeout_min` below 1, a `verify_max_runs` below 1 and a model-spec that fails its grammar, each naming the key.
+// Config.Step returns a declared step and refuses an undeclared one, so every row and verb that runs a command goes through it.
+//
+// Paths is the one declarer of every drift path.
+// The durable directory `_lyx/drift/` holds the scope record, the two agents' reports and the logs of every run; the ephemeral directory `.lyx/drift/` holds the capture record, the capture lock, the compare marker, the baseline and side-capture directories, the skip file and the run counter.
+//
+// Every record is JSON written through `internal/state`, so an unknown key survives a rewrite.
+// The scope record (`scope.json`) holds the recorded scope (`off`, `partial` or `full`) and its skipped tests, when the baseline was awaited or deferred, a waiver, the accepted and withdrawn tests, the unruled tests the last decision halt named and the time of the last gate halt.
+// The capture record (`capture.json`) holds the state of the latest main capture (`running`, `passed` or `failed`) with its pid, HEAD, times, exit code, reason and log.
+// CountedCapture decides whether a capture counts as the baseline: a passed record, and under a recipe with an await row also an `awaited_at` in the scope record.
+// The run counter (`runs.json`) holds how many compare or side-capture runs the current Drift-Verify agent session took, the commit its attempt started at and whether the agent-session mark is open.
+// TakeRun refuses once the budget is spent, ResetRuns starts a fresh attempt with the whole budget, and CloseAgentSession closes the mark while keeping the count and the attempt's head.
+// A verb reads the mark with AgentSessionOpen to tell the agent session from the row's own mechanical work.
+//
+// # Capture
+//
+// RunCapture is the main capture: it takes the capture lock with a bounded non-blocking retry, so a reader's probe never makes it refuse, runs the caller's precondition under the lock and writes a `running` capture record naming the HEAD that precondition checked.
+// It moves a non-empty baseline directory to the first free numbered backup beside it, writes the skip file, waits for one gate slot as a non-tier holder with no deadline, and runs the declared command in its shell with `{baseline_dir}` and `{skip_file}` rendered as quoted paths and the command's stdout and stderr the open log file.
+// A timeout, counted from the command's start, kills the command's whole tree.
+// The record ends `passed` for exit 0 with at least one file under the baseline directory, else `failed` with the reason, and then the slot and the lock are released.
+// RunCapture holds no job object of its own, since it also runs in a row's step process; the detached child holds the capture's named job (CaptureJobName) around it.
+// RunSideCapture takes no lock and writes no record: it runs the same command into the next free numbered directory under the side directory.
+// CheckMainCapture is the main capture's precondition: the run is at Drift-Baseline, or blocked at Drift-Await, HEAD equals the branch point and the tracked tree is clean; each refusal names its way forward.
+// StartCapture spawns `drift capture-child` detached with breakaway, registers it under the run's processes with role `capture` and returns its pid only once the capture record carries that pid, in any state, since a capture can fail between two reads.
+// A start Windows refuses for breakaway is retried plain-detached when the caller sets FallbackDetach, and is ErrBreakawayRefused otherwise.
+// ProbeLock reads whether an OS lock is held without creating a directory, and Active reads the capture lock and the compare marker.
+//
+// # Compare
+//
+// RunCompare is the mechanical compare, on the runner the capture uses.
+// It takes the compare marker, an OS lock, before it waits for its gate slot and holds it until it ends, so a compare queued for a slot reads as activity and one a dead compare left reads as none; a marker still held after a bounded retry, which rides out a reader's probe, is refused.
+// It writes the skip file, holds one slot as a non-tier holder, renders `{baseline_dir}` as the baseline directory and `{skip_file}` as the skip file, and kills the command's tree at its timeout.
+// The result carries the exit code, the log and whether the compare passed, which is exit 0 within the timeout; the compare writes no record and counts no run, since TakeRun is the caller's.
+// SkipList is the scope's skipped tests followed by every accepted test, without duplicates; a withdrawn test is off the accepted list and so is compared again.
+//
+// # Verbs
+//
+// The `lyx drift` verbs' rules are functions over a VerbStatus: the run status's row, state and error, whether the recipe has a Drift-Await row, whether the capture lock is held and whether the agent-session mark is open.
+// The agent session is a running status at Drift-Verify with the mark open; a caller at a halt is a blocked status, and a decision halt is one whose error opens with shedadapters.DecisionHaltPrefix.
+// A verb run at a row it does not admit refuses naming that row and `lyx loom status`, and a refused verb writes nothing.
+// RecordScope writes the scope record once, at Drift-Baseline, and refuses a skip list outside scope partial and a partial scope without one.
+// Accept admits the agent session and a caller at a halt; a running status with the mark closed is the row's own work and refuses, and any other state refuses naming `lyx loom resume`.
+// Under scope full the agent's acceptances are unruled and a caller's are ruled; a withdrawn test, and under scope full any test, is accepted by a caller only at a decision halt, and never by the agent session.
+// Withdraw moves an accepted test to the withdrawn list, and RunCount reads the agent session's run count.
+// Defer sets awaited_at with deferred while blocked at Drift-Await or at a Drift-Baseline capture halt, and refuses while the capture lock is held.
+// Waive records a waiver at a blocked Drift-Verify only when no counted capture exists.
+// CheckVerifyRow is the row check `lyx drift compare` and `lyx drift capture --side` run first, before they take a run of the agent session's budget.
+//
+// # Agents
+//
+// The Drift-Baseline and Drift-Verify agents are each one non-interactive lead seat, built by BaselineTable and VerifyTable over the stencils `drift-template-baseline` and `drift-template-verify`, which the seat engine reads at call time and renders with the parent and edit directives.
+// The baseline seat's only output is `baseline.md` and the verify seat's `verify-report.md`: the scope record is Go-written, and a fresh spawn archives its outputs.
+// The task's subject is read from the decision record in a loom run (SubjectDecisionRecord) and from the board entry in a darn run (SubjectBoardEntry), the record's `Added after Discussion` entries winning in both.
+// The seats take the `plan` and `review` segment colors, their models from `baseline_model` and `verify_model`, and session timeouts that are package constants, since drift.yaml declares no timeout key.
+// The verify seat also carries the hub's language skills and the PATTERN implementer directive, since its agent changes code.
+// Neither table carries a gate; the Drift-Verify row sets it.
+//
+// # Drift-Baseline
+//
+// Deps holds the seams the three Drift producers share, and a producer fails loudly naming the field when a seam it reads is nil.
+// Row holds a row's portable config: the subject its agent reads the task from and WaitCapture, darn's `capture: wait`.
+// DriftBaseline has the baseline agent record the scope and write baseline.md when either is missing, the agent spawned with a note that the scope is already recorded when it is, and a Done agent with no scope record is a Stuck.
+// Scope off, a set awaited_at and a passed capture take no capture; a capture holding the lock is waited on under WaitCapture, by awaitCaptureEnd from one second doubling to thirty, and left running otherwise.
+// Otherwise it captures again: an undeclared capture command is a Stuck naming `lyx config drift`, and a refusal of the capture's precondition is a Stuck whose reason opens with CaptureHaltPrefix and names `lyx drift defer` with `lyx loom resume`, and on a dirty tree restoring or stashing the listed paths.
+// Without WaitCapture the capture is the detached child, and the pass returns Done once the child's record exists, so the plan is written meanwhile;
+// with WaitCapture, and when Windows refuses the detached start breakaway, the capture runs in the step's own process, so its command dies with the step.
+// A failed capture is a Stuck opening with CaptureHaltPrefix and naming the log, `lyx drift capture` with `lyx loom resume`, and `lyx drift defer` with `lyx loom resume`; the row carries no on_stuck, so each Stuck halts the run.
+// Every pass commits through Deps.Commit on its way out: the scope record and baseline.md while a detached capture may still write its logs, and all of the durable drift directory once a capture has ended in this process.
+//
+// # Drift-Await
+//
+// DriftAwait is the mechanical row that holds the run until the baseline exists; it spawns nothing and commits all of the durable drift directory, the capture log included, on every way out.
+// It is Done with no scope record, with scope off, and with awaited_at set whatever HEAD is, so a later entry after the code changed passes.
+// A capture holding the lock is waited on by awaitCaptureEnd with no bound of its own, and the capture record is read only after the lock reads free, so a capture that just ended is read as ended.
+// A passed capture taken at HEAD is Done after the row writes awaited_at into the scope record, which makes the capture the counted one.
+// A missing record, a failed one, and a running one whose lock is free are Stuck, naming the log when there is one, as is a passed record taken at another commit than HEAD.
+// While HEAD is the branch point a Stuck names `lyx drift capture` followed by `lyx loom resume`, which captures again and re-enters the row, and `lyx drift defer` followed by `lyx loom resume`;
+// once HEAD moved it names only `lyx drift defer` followed by `lyx loom resume`, since no capture may run on changed code.
+// No Stuck of the row carries the decision halt prefix, so the arbiter may settle one with the way forward it names.
+// An adopting machine has no `.lyx/drift/`, so before awaited_at the row halts on the missing record and `lyx drift capture` captures there.
+//
+// # Drift-Verify
+//
+// DriftVerify runs the mechanical compare and, when it shows drift, one strong agent that accepts the intended drift and fixes the rest.
+// It commits all of the durable drift directory on every way out, and runs these steps in order:
+// no scope record, scope off and a waived scope are Done with no compare;
+// an open agent-session mark means an interrupted entry may have left a live agent, which a probe of the agent's table decides, and a live chair goes straight to the agent step to be resumed while a closed mark or an empty probe closes the mark;
+// under scope full the acceptances the parent stood by are ruled, an unruled acceptance is a decision halt, and a missing counted capture is a decision halt under every scope that names `lyx drift waive`;
+// an undeclared compare is a Stuck naming `lyx config drift`;
+// a dirty tracked tree is a Stuck, and a resume from a gate halt runs the told verify entry once over the agent's commits;
+// then the compare runs, and a pass is Done.
+// A failing compare resets the run counter at the current HEAD and spawns one agent whose table gates, in order, on a clean tree, on the verify entry, which runs only once the session committed code, and on a final compare that ends the session when drift remains.
+// The agent's end closes the mark; a Done under scope full is checked again for unruled acceptances.
+//
+// A Stuck opens with shedadapters.DecisionHaltPrefix, so the stop chain hands it to the parent, under scope full, for the missing counted capture, and under scope partial for a failing final compare while a test is withdrawn.
+// Under scope full a decision halt names the unruled acceptances and the parent's ways forward for them, `lyx loom resume` to stand by them or `lyx drift withdraw <test>` to reject one, and records the names and the time in the scope record; the parent's resume then rules them.
+// The entry that follows a halt it recorded recognizes it from the run's history: the last entry is a Stuck of this row whose latest time is at or after the recorded time, compared at second precision.
+// gate_halt_at is written by each dirty-tree and test-gate halt, only when unset, and survives the halts before the compare, so a resume that halts at one of them runs the verify gate once more; an entry that is no resume from it clears the mark first.
+// The row carries no on_stuck, the agent is no perch, and no review follows its fixes.
+package driftengine
diff --git a/internal/driftengine/paths.go b/internal/driftengine/paths.go
new file mode 100644
index 000000000..2f3c000e3
--- /dev/null
+++ b/internal/driftengine/paths.go
@@ -0,0 +1,64 @@
+// paths.go — the drift module's durable and ephemeral paths, declared once.
+
+package driftengine
+
+import (
+	"path"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/lyxdirs"
+)
+
+// driftDirName is the directory segment both the durable and the ephemeral drift directory carry.
+const driftDirName = "drift"
+
+// Paths holds every path the drift module reads or writes, joined onto one anchor root.
+// The durable files lie under _lyx/drift and are fabric-synced; the ephemeral files lie under .lyx/drift and are never tracked.
+type Paths struct {
+	// Scope is the durable scope record.
+	Scope string
+	// BaselineReport is the Drift-Baseline agent's report.
+	BaselineReport string
+	// VerifyReport is the Drift-Verify agent's report.
+	VerifyReport string
+	// LogsDir holds the log of every capture, compare and child run.
+	LogsDir string
+	// Capture is the ephemeral capture record.
+	Capture string
+	// CaptureLock is the lock a running capture holds.
+	CaptureLock string
+	// CompareMarker is the lock a running compare holds.
+	CompareMarker string
+	// BaselineDir is the directory the capture writes its profile files to.
+	BaselineDir string
+	// SideDir holds the numbered directories of side captures.
+	SideDir string
+	// SkipFile is the file naming one skipped test per line.
+	SkipFile string
+	// Runs is the run counter of the Drift-Verify agent session.
+	Runs string
+}
+
+// NewPaths returns the drift paths joined onto the told anchor root.
+func NewPaths(anchorRoot string) Paths {
+	durable := filepath.Join(anchorRoot, lyxdirs.LyxDirName, driftDirName)
+	ephemeral := filepath.Join(anchorRoot, lyxdirs.DotLyxDirName, driftDirName)
+	return Paths{
+		Scope:          filepath.Join(durable, "scope.json"),
+		BaselineReport: filepath.Join(durable, "baseline.md"),
+		VerifyReport:   filepath.Join(durable, "verify-report.md"),
+		LogsDir:        filepath.Join(durable, "logs"),
+		Capture:        filepath.Join(ephemeral, "capture.json"),
+		CaptureLock:    filepath.Join(ephemeral, "capture.lock"),
+		CompareMarker:  filepath.Join(ephemeral, "compare.lock"),
+		BaselineDir:    filepath.Join(ephemeral, "baseline"),
+		SideDir:        filepath.Join(ephemeral, "side"),
+		SkipFile:       filepath.Join(ephemeral, "skip.txt"),
+		Runs:           filepath.Join(ephemeral, "runs.json"),
+	}
+}
+
+// DirRel returns the durable drift directory relative to the anchor root, `_lyx/drift`, always forward-slashed, for a commit pathspec.
+func DirRel() string {
+	return path.Join(lyxdirs.LyxDirName, driftDirName)
+}
diff --git a/internal/driftengine/records.go b/internal/driftengine/records.go
new file mode 100644
index 000000000..ddb769f83
--- /dev/null
+++ b/internal/driftengine/records.go
@@ -0,0 +1,267 @@
+// records.go — the scope record, the capture record and the Drift-Verify run counter, and their locked reads and writes.
+//
+// Every record is JSON written through internal/state, so a key a newer binary wrote survives an older binary's rewrite.
+
+package driftengine
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// The scope a task's regression covers.
+const (
+	// ScopeOff records that the task is not regression-checked.
+	ScopeOff = "off"
+	// ScopePartial records that the task is checked with some tests skipped.
+	ScopePartial = "partial"
+	// ScopeFull records that the task is checked whole.
+	ScopeFull = "full"
+)
+
+// Who accepted a drifted test.
+const (
+	// AcceptedByAgent marks an acceptance the Drift-Verify agent made.
+	AcceptedByAgent = "agent"
+	// AcceptedByCaller marks an acceptance a caller at a halt made.
+	AcceptedByCaller = "caller"
+)
+
+// Whether an acceptance under scope full was ruled on by the run's parent.
+const (
+	// RulingUnruled marks an acceptance the Drift-Verify agent session made that the run's parent has not yet ruled on.
+	RulingUnruled = "unruled"
+	// RulingRuled marks an acceptance the run's parent has ruled on or made itself.
+	RulingRuled = "ruled"
+)
+
+// The state of a capture.
+const (
+	// CaptureRunning records a capture in progress.
+	CaptureRunning = "running"
+	// CapturePassed records a capture that exited 0 and wrote a baseline.
+	CapturePassed = "passed"
+	// CaptureFailed records a capture that did not produce a baseline.
+	CaptureFailed = "failed"
+)
+
+// Acceptance is one drifted test accepted as intended.
+type Acceptance struct {
+	// Test is the accepted test.
+	Test string `json:"test"`
+	// Reason is why the drift is intended.
+	Reason string `json:"reason"`
+	// By is AcceptedByAgent or AcceptedByCaller.
+	By string `json:"by"`
+	// Ruling is RulingUnruled or RulingRuled under scope full, and empty otherwise.
+	Ruling string `json:"ruling"`
+	// At is the RFC 3339 time of the acceptance.
+	At string `json:"at"`
+}
+
+// ScopeRecord is the task's recorded regression scope and what has been decided about its drift.
+// The zero ScopeRecord is not valid; ReadScope reports an absent record as found false.
+type ScopeRecord struct {
+	// Scope is ScopeOff, ScopePartial or ScopeFull.
+	Scope string `json:"scope"`
+	// Skip is the tests the scope leaves out of the capture and the compare.
+	Skip []string `json:"skip"`
+	// RecordedAt is the RFC 3339 time the scope was recorded.
+	RecordedAt string `json:"recorded_at"`
+	// AwaitedAt is the RFC 3339 time a passed Drift-Await or a deferral set.
+	AwaitedAt string `json:"awaited_at"`
+	// Deferred is true when the caller deferred the baseline instead of capturing it.
+	Deferred bool `json:"deferred"`
+	// WaivedReason is why the caller waived the compare.
+	WaivedReason string `json:"waived_reason"`
+	// WaivedAt is the RFC 3339 time of the waiver.
+	WaivedAt string `json:"waived_at"`
+	// Accepted is the drifted tests accepted as intended.
+	Accepted []Acceptance `json:"accepted"`
+	// Withdrawn is the tests moved off Accepted, which the compare runs again.
+	Withdrawn []string `json:"withdrawn"`
+	// HaltNamed is the unruled tests a Drift-Verify decision halt last named.
+	HaltNamed []string `json:"halt_named"`
+	// HaltNamedAt is the time of that halt, formatted as time.RFC3339 in UTC.
+	HaltNamedAt string `json:"halt_named_at"`
+	// GateHaltAt is the time of the dirty-tree or test-gate Stuck Drift-Verify last returned, formatted as time.RFC3339 in UTC.
+	GateHaltAt string `json:"gate_halt_at"`
+}
+
+// Unruled returns the accepted entries whose ruling is RulingUnruled.
+func (s ScopeRecord) Unruled() []Acceptance {
+	var unruled []Acceptance
+	for _, acceptance := range s.Accepted {
+		if acceptance.Ruling == RulingUnruled {
+			unruled = append(unruled, acceptance)
+		}
+	}
+	return unruled
+}
+
+// CaptureRecord is the state of the latest main capture.
+type CaptureRecord struct {
+	// State is CaptureRunning, CapturePassed or CaptureFailed.
+	State string `json:"state"`
+	// Pid is the capture process, so a spawner tells its own child's record from an older one.
+	Pid int `json:"pid"`
+	// Head is the commit the capture ran on.
+	Head string `json:"head"`
+	// SlotAcquiredAt is the RFC 3339 time the capture got its gate slot.
+	SlotAcquiredAt string `json:"slot_acquired_at"`
+	// CommandStartedAt is the RFC 3339 time the capture command started.
+	CommandStartedAt string `json:"command_started_at"`
+	// EndedAt is the RFC 3339 time the capture ended.
+	EndedAt string `json:"ended_at"`
+	// ExitCode is the capture command's exit code.
+	ExitCode int `json:"exit_code"`
+	// Reason is why a capture failed.
+	Reason string `json:"reason"`
+	// Log is the capture command's log file.
+	Log string `json:"log"`
+}
+
+// runsRecord is the Drift-Verify agent session's run counter.
+type runsRecord struct {
+	Count       int    `json:"count"`
+	Head        string `json:"head"`
+	SessionOpen bool   `json:"session_open"`
+}
+
+// ErrRunsSpent marks a run refused because the agent session's run budget is spent.
+var ErrRunsSpent = errors.New("drift: the run budget is spent")
+
+// errNoRecord stops an update that has nothing to change.
+var errNoRecord = errors.New("drift: no record")
+
+// recordLock returns the lock file of a record named name, in the ephemeral drift directory, which it creates.
+func recordLock(p Paths, name string) (string, error) {
+	dir := filepath.Dir(p.Capture)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", fmt.Errorf("drift: create %s: %w", dir, err)
+	}
+	return filepath.Join(dir, name+".lock"), nil
+}
+
+// ReadScope reads the scope record, answering found false when none was written.
+func ReadScope(p Paths) (ScopeRecord, bool, error) {
+	lock, err := recordLock(p, "scope.json")
+	if err != nil {
+		return ScopeRecord{}, false, err
+	}
+	return state.ReadJSON[ScopeRecord](p.Scope, lock)
+}
+
+// UpdateScope applies mutate to the scope record under the record's lock and writes the result.
+// mutate receives the current record and whether one exists; its error stops the update and writes nothing.
+func UpdateScope(p Paths, mutate func(cur ScopeRecord, found bool) (ScopeRecord, error)) error {
+	lock, err := recordLock(p, "scope.json")
+	if err != nil {
+		return err
+	}
+	return state.UpdateJSON(p.Scope, lock, mutate)
+}
+
+// ReadCapture reads the capture record, answering found false when none was written.
+func ReadCapture(p Paths) (CaptureRecord, bool, error) {
+	lock, err := recordLock(p, "capture.json")
+	if err != nil {
+		return CaptureRecord{}, false, err
+	}
+	return state.ReadJSON[CaptureRecord](p.Capture, lock)
+}
+
+// WriteCapture replaces the capture record.
+func WriteCapture(p Paths, rec CaptureRecord) error {
+	lock, err := recordLock(p, "capture.json")
+	if err != nil {
+		return err
+	}
+	return state.WriteJSON(p.Capture, lock, rec)
+}
+
+// CountedCapture reports whether the capture record counts as the baseline the compare reads.
+// It counts when found and passed and, with awaitRow set, when the scope record also holds awaited_at;
+// without an await row a passed record alone counts.
+func CountedCapture(scope ScopeRecord, capture CaptureRecord, found bool, awaitRow bool) bool {
+	if !found || capture.State != CapturePassed {
+		return false
+	}
+	return !awaitRow || scope.AwaitedAt != ""
+}
+
+// updateRuns applies mutate to the run counter under its lock.
+func updateRuns(p Paths, mutate func(cur runsRecord, found bool) (runsRecord, error)) error {
+	lock, err := recordLock(p, "runs.json")
+	if err != nil {
+		return err
+	}
+	return state.UpdateJSON(p.Runs, lock, mutate)
+}
+
+// readRuns reads the run counter, answering found false when none was written.
+func readRuns(p Paths) (runsRecord, bool, error) {
+	lock, err := recordLock(p, "runs.json")
+	if err != nil {
+		return runsRecord{}, false, err
+	}
+	return state.ReadJSON[runsRecord](p.Runs, lock)
+}
+
+// TakeRun counts one compare or side-capture run of the Drift-Verify agent session and returns the new count.
+// At max it refuses with an error wrapping ErrRunsSpent and writes nothing.
+func TakeRun(p Paths, max int) (int, error) {
+	var taken int
+	err := updateRuns(p, func(cur runsRecord, _ bool) (runsRecord, error) {
+		if cur.Count >= max {
+			return cur, fmt.Errorf("%w: all %d runs of this attempt are taken", ErrRunsSpent, max)
+		}
+		cur.Count++
+		taken = cur.Count
+		return cur, nil
+	})
+	if err != nil {
+		return 0, err
+	}
+	return taken, nil
+}
+
+// ResetRuns zeroes the run count, records head as the attempt's start and opens the agent-session mark.
+// Drift-Verify calls it at each fresh spawn of its agent.
+func ResetRuns(p Paths, head string) error {
+	return updateRuns(p, func(runsRecord, bool) (runsRecord, error) {
+		return runsRecord{Head: head, SessionOpen: true}, nil
+	})
+}
+
+// AttemptHead returns the commit recorded at the attempt's start, and false when no attempt was recorded.
+func AttemptHead(p Paths) (string, bool, error) {
+	rec, found, err := readRuns(p)
+	return rec.Head, found, err
+}
+
+// CloseAgentSession closes the agent-session mark and keeps the run count and the attempt head.
+// With no record it changes nothing.
+func CloseAgentSession(p Paths) error {
+	err := updateRuns(p, func(cur runsRecord, found bool) (runsRecord, error) {
+		if !found {
+			return cur, errNoRecord
+		}
+		cur.SessionOpen = false
+		return cur, nil
+	})
+	if errors.Is(err, errNoRecord) {
+		return nil
+	}
+	return err
+}
+
+// AgentSessionOpen reports whether the agent-session mark is open, and false when no attempt was recorded.
+func AgentSessionOpen(p Paths) (bool, error) {
+	rec, _, err := readRuns(p)
+	return rec.SessionOpen, err
+}
diff --git a/internal/driftengine/records_test.go b/internal/driftengine/records_test.go
new file mode 100644
index 000000000..7276b141c
--- /dev/null
+++ b/internal/driftengine/records_test.go
@@ -0,0 +1,105 @@
+//go:build tier0
+
+// records_test.go — tier 0 tests for the counted-capture predicate and the Drift-Verify run counter.
+
+package driftengine
+
+import (
+	"errors"
+	"testing"
+)
+
+// TestCountedCapture covers a found and an absent capture, each state, awaited_at set or not, and a loom (await row) and a darn recipe.
+func TestCountedCapture(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		state    string
+		found    bool
+		awaited  bool
+		awaitRow bool
+		want     bool
+	}{
+		{"absent", CapturePassed, false, true, true, false},
+		{"running", CaptureRunning, true, true, true, false},
+		{"failed", CaptureFailed, true, true, true, false},
+		{"passed and awaited under an await row", CapturePassed, true, true, true, true},
+		{"passed but not awaited under an await row", CapturePassed, true, false, true, false},
+		{"passed and not awaited without an await row", CapturePassed, true, false, false, true},
+		{"failed without an await row", CaptureFailed, true, false, false, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			scope := ScopeRecord{}
+			if tt.awaited {
+				scope.AwaitedAt = "2026-01-01T00:00:00Z"
+			}
+			got := CountedCapture(scope, CaptureRecord{State: tt.state}, tt.found, tt.awaitRow)
+			if got != tt.want {
+				t.Errorf("CountedCapture() = %v; want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+// TestTakeRun covers taking runs up to the budget, the refusal wrapping ErrRunsSpent leaving the count, ResetRuns admitting again, AttemptHead and the agent-session mark.
+func TestTakeRun(t *testing.T) {
+	t.Parallel()
+	p := NewPaths(t.TempDir())
+
+	if _, found, err := AttemptHead(p); err != nil || found {
+		t.Fatalf("AttemptHead() with no record = _, %v, %v; want found false", found, err)
+	}
+	if open, err := AgentSessionOpen(p); err != nil || open {
+		t.Fatalf("AgentSessionOpen() with no record = %v, %v; want false", open, err)
+	}
+	if err := CloseAgentSession(p); err != nil {
+		t.Fatalf("CloseAgentSession() with no record = %v; want nil", err)
+	}
+	if _, found, _ := AttemptHead(p); found {
+		t.Fatalf("CloseAgentSession() with no record wrote one")
+	}
+
+	if err := ResetRuns(p, "abc"); err != nil {
+		t.Fatalf("ResetRuns() = %v; want nil", err)
+	}
+	for want := 1; want <= 2; want++ {
+		if got, err := TakeRun(p, 2); err != nil || got != want {
+			t.Fatalf("TakeRun() = %d, %v; want %d, nil", got, err, want)
+		}
+	}
+	if _, err := TakeRun(p, 2); !errors.Is(err, ErrRunsSpent) {
+		t.Fatalf("TakeRun() past the budget = %v; want it to wrap ErrRunsSpent", err)
+	}
+	if got, err := TakeRun(p, 3); err != nil || got != 3 {
+		t.Errorf("TakeRun() after a refusal = %d, %v; want 3, nil (the refusal left the count at 2)", got, err)
+	}
+
+	if err := CloseAgentSession(p); err != nil {
+		t.Fatalf("CloseAgentSession() = %v; want nil", err)
+	}
+	if open, _ := AgentSessionOpen(p); open {
+		t.Errorf("AgentSessionOpen() after CloseAgentSession = true; want false")
+	}
+	if head, found, _ := AttemptHead(p); !found || head != "abc" {
+		t.Errorf("AttemptHead() after CloseAgentSession = %q, %v; want abc, true", head, found)
+	}
+	if _, err := TakeRun(p, 3); !errors.Is(err, ErrRunsSpent) {
+		t.Errorf("TakeRun() after CloseAgentSession = %v; want the count kept, refusing at 3", err)
+	}
+
+	if err := ResetRuns(p, "def"); err != nil {
+		t.Fatalf("ResetRuns() = %v; want nil", err)
+	}
+	if got, err := TakeRun(p, 3); err != nil || got != 1 {
+		t.Errorf("TakeRun() after ResetRuns = %d, %v; want 1, nil", got, err)
+	}
+	if head, _, _ := AttemptHead(p); head != "def" {
+		t.Errorf("AttemptHead() after ResetRuns = %q; want def", head)
+	}
+	if open, _ := AgentSessionOpen(p); !open {
+		t.Errorf("AgentSessionOpen() after ResetRuns = false; want true")
+	}
+}
diff --git a/internal/driftengine/seats.go b/internal/driftengine/seats.go
new file mode 100644
index 000000000..ae5d29466
--- /dev/null
+++ b/internal/driftengine/seats.go
@@ -0,0 +1,238 @@
+// seats.go — the seat tables of the two drift agents, the baseline agent and the verify agent, and the told inputs they are built from.
+//
+// Each agent is one non-interactive lead seat whose one output is its report.
+// The builders are pure: they stat nothing they were not told to read, and spawn nothing.
+
+package driftengine
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/languageconfig"
+	"github.com/Knatte18/loomyard/internal/modelspec"
+	"github.com/Knatte18/loomyard/internal/pattern"
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+)
+
+// The agent roles and the stencils that open them.
+const (
+	baselineRole        = "drift-baseline"
+	verifyRole          = "drift-verify"
+	baselineStencilName = "drift-template-baseline"
+	verifyStencilName   = "drift-template-verify"
+)
+
+// The session timeouts of the two agents, since drift.yaml declares no timeout key.
+const (
+	baselineTimeout = 30 * time.Minute
+	verifyTimeout   = 120 * time.Minute
+)
+
+// The subject kinds a task's statement is read from.
+const (
+	// SubjectDecisionRecord reads the task from its decision record, as a loom run does.
+	SubjectDecisionRecord = "decision-record"
+	// SubjectBoardEntry reads the task from its board entry, as a darn run does.
+	SubjectBoardEntry = "board-entry"
+)
+
+// baselineSkills and verifySkills are the skills the two agents' spawns load, in order.
+var (
+	baselineSkills = []string{"scribe:prose"}
+	verifySkills   = []string{"scribe:prose", "scribe:code-quality", "scribe:testing"}
+)
+
+// subjectFields are the told values the task's subject is read from.
+type subjectFields struct {
+	// Subject is SubjectDecisionRecord or SubjectBoardEntry.
+	Subject string
+	// Slug is the board entry's slug; required for SubjectBoardEntry.
+	Slug string
+	// DecisionRecordPath is the absolute path of the decision record, whose Added after Discussion entries amend the task.
+	DecisionRecordPath string
+}
+
+// reading returns the sentence part that tells the agent where to read the task.
+func (s subjectFields) reading() (string, error) {
+	switch s.Subject {
+	case SubjectDecisionRecord:
+		return fmt.Sprintf("the decision record at `%s`, in which the `Added after Discussion` entries amend the task and win over the rest where they differ", s.DecisionRecordPath), nil
+	case SubjectBoardEntry:
+		if s.Slug == "" {
+			return "", fmt.Errorf("Slug must not be empty for the %s subject", SubjectBoardEntry)
+		}
+		slug, err := json.Marshal(map[string]string{"slug": s.Slug})
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("the board entry for task `%s`, read with `lyx board get '%s'`, where the `Added after Discussion` entries of the decision record at `%s` amend the entry and win over its body", s.Slug, slug, s.DecisionRecordPath), nil
+	}
+	return "", fmt.Errorf("Subject %q is neither %s nor %s", s.Subject, SubjectDecisionRecord, SubjectBoardEntry)
+}
+
+// requireTold returns the refusal naming the first empty field of fields, or nil.
+func requireTold(builder string, fields []struct{ field, value string }) error {
+	for _, f := range fields {
+		if f.value == "" {
+			return fmt.Errorf("drift: %s: %s must not be empty", builder, f.field)
+		}
+	}
+	return nil
+}
+
+// resolveModel parses the model-spec and resolves it against reg into the seat's model choice.
+func resolveModel(builder, spec string, reg modelspec.Registry) (shuttleengine.ModelChoice, error) {
+	parsed, err := modelspec.Parse(spec)
+	if err != nil {
+		return shuttleengine.ModelChoice{}, fmt.Errorf("drift: %s: model-spec: %w", builder, err)
+	}
+	resolved, err := reg.Resolve(parsed)
+	if err != nil {
+		return shuttleengine.ModelChoice{}, fmt.Errorf("drift: %s: model-spec: %w", builder, err)
+	}
+	return shuttleengine.NewModelChoice(resolved), nil
+}
+
+// BaselineInputs are the told values one Drift-Baseline agent spawn is composed from.
+type BaselineInputs struct {
+	// StencilsDir is the directory the agent's stencil and the directive stencils are read from.
+	StencilsDir string
+	// WorktreeRoot is the task worktree the agent works in.
+	WorktreeRoot string
+	// Subject is SubjectDecisionRecord or SubjectBoardEntry.
+	Subject string
+	// Slug is the board entry's slug; required for SubjectBoardEntry.
+	Slug string
+	// DecisionRecordPath is the absolute path of the task's decision record.
+	DecisionRecordPath string
+	// BaselineReportPath is the absolute path the agent writes baseline.md to.
+	BaselineReportPath string
+	// ScopeNote says that a scope is already recorded, so the agent writes baseline.md alone against it; empty when none is.
+	ScopeNote string
+}
+
+// BaselineTable builds the seatengine.Table of one Drift-Baseline spawn: one lead whose only output is baseline.md.
+// An empty required field of in is refused by name, and cfg.BaselineModel is resolved against reg.
+// The table carries no gate and no scope record output, since Go writes the record and a fresh spawn archives its outputs.
+func BaselineTable(in BaselineInputs, cfg Config, reg modelspec.Registry) (seatengine.Table, error) {
+	err := requireTold("BaselineTable", []struct{ field, value string }{
+		{"StencilsDir", in.StencilsDir},
+		{"WorktreeRoot", in.WorktreeRoot},
+		{"DecisionRecordPath", in.DecisionRecordPath},
+		{"BaselineReportPath", in.BaselineReportPath},
+	})
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+	reading, err := subjectFields{in.Subject, in.Slug, in.DecisionRecordPath}.reading()
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("drift: BaselineTable: %w", err)
+	}
+	choice, err := resolveModel("BaselineTable", cfg.BaselineModel, reg)
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+
+	return seatengine.Table{
+		RolePrefix: baselineRole,
+		Segment:    segmentcolor.Plan,
+		Timeout:    baselineTimeout,
+		Values: map[string]string{
+			"subject_reading": reading,
+			"baseline_path":   in.BaselineReportPath,
+			"scope_note":      in.ScopeNote,
+		},
+		Optional: []string{"scope_note"},
+		Seats: []seatengine.Seat{{
+			Stencil:     baselineStencilName,
+			ModelChoice: choice,
+			Outputs:     []string{in.BaselineReportPath},
+			Skills:      append([]string(nil), baselineSkills...),
+		}},
+	}, nil
+}
+
+// VerifyInputs are the told values one Drift-Verify agent spawn is composed from.
+type VerifyInputs struct {
+	// StencilsDir is the directory the agent's stencil and the directive stencils are read from.
+	StencilsDir string
+	// WorktreeRoot is the task worktree the agent works in and the PATTERN overview is read from.
+	WorktreeRoot string
+	// Subject is SubjectDecisionRecord or SubjectBoardEntry.
+	Subject string
+	// Slug is the board entry's slug; required for SubjectBoardEntry.
+	Slug string
+	// DecisionRecordPath is the absolute path of the task's decision record.
+	DecisionRecordPath string
+	// ScopePath is the absolute path of the scope record.
+	ScopePath string
+	// BaselineReportPath is the absolute path of baseline.md.
+	BaselineReportPath string
+	// VerifyReportPath is the absolute path the agent writes verify-report.md to.
+	VerifyReportPath string
+	// CompareLog is the absolute path of the compare's log.
+	CompareLog string
+	// BaselineHead is the commit the baseline was captured on.
+	BaselineHead string
+	// LanguageSkills are the hub's language skills the agent loads after its own; empty for none.
+	LanguageSkills []string
+}
+
+// VerifyTable builds the seatengine.Table of one Drift-Verify spawn: one lead whose only output is verify-report.md.
+// An empty required field of in is refused by name, and cfg.VerifyModel is resolved against reg.
+// The agent changes code, so the table also renders the PATTERN implementer directive.
+// The table carries no gate; the producer sets it.
+func VerifyTable(in VerifyInputs, cfg Config, reg modelspec.Registry) (seatengine.Table, error) {
+	err := requireTold("VerifyTable", []struct{ field, value string }{
+		{"StencilsDir", in.StencilsDir},
+		{"WorktreeRoot", in.WorktreeRoot},
+		{"DecisionRecordPath", in.DecisionRecordPath},
+		{"ScopePath", in.ScopePath},
+		{"BaselineReportPath", in.BaselineReportPath},
+		{"VerifyReportPath", in.VerifyReportPath},
+		{"CompareLog", in.CompareLog},
+		{"BaselineHead", in.BaselineHead},
+	})
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+	reading, err := subjectFields{in.Subject, in.Slug, in.DecisionRecordPath}.reading()
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("drift: VerifyTable: %w", err)
+	}
+	choice, err := resolveModel("VerifyTable", cfg.VerifyModel, reg)
+	if err != nil {
+		return seatengine.Table{}, err
+	}
+	patternDirective, err := pattern.Directive(in.WorktreeRoot, in.StencilsDir, pattern.RoleImplementer, nil)
+	if err != nil {
+		return seatengine.Table{}, fmt.Errorf("drift: VerifyTable: %w", err)
+	}
+
+	return seatengine.Table{
+		RolePrefix: verifyRole,
+		Segment:    segmentcolor.Review,
+		Timeout:    verifyTimeout,
+		Values: map[string]string{
+			"subject_reading":   reading,
+			"compare_log":       in.CompareLog,
+			"scope_path":        in.ScopePath,
+			"baseline_path":     in.BaselineReportPath,
+			"baseline_head":     in.BaselineHead,
+			"report_path":       in.VerifyReportPath,
+			"max_runs":          fmt.Sprint(cfg.VerifyMaxRuns),
+			"pattern_directive": patternDirective,
+		},
+		Optional: []string{"pattern_directive"},
+		Seats: []seatengine.Seat{{
+			Stencil:     verifyStencilName,
+			ModelChoice: choice,
+			Outputs:     []string{in.VerifyReportPath},
+			Skills:      languageconfig.AppendSkills(verifySkills, in.LanguageSkills),
+		}},
+	}, nil
+}
