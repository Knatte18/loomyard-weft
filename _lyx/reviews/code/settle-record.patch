+// newIntegrateHub builds a "." hub whose prime weft holds a local commit of _lyx/local.txt and whose upstream a second clone moved to sub, with the new tip fetched.
+// It returns the hub and the prime's Location at its own anchor.
+func newIntegrateHub(t *testing.T) (*hubforge.Hub, *lyxcwd.Location) {
+	t.Helper()
+
+	h := newAnchorHub(t)
+	second := hubforge.CloneSecond(t, h)
+	hubforge.ReanchorPair(t, second, second.Location.WorktreeName, "sub")
+	if _, err := fabricengine.CoalescePushBothAt(second.PrimeWorktree(), second.PrimeRecords(), fabricengine.SyncOptions{}); err != nil {
+		t.Fatalf("push the re-anchored prime from the second clone: %v", err)
+	}
+	gitkit.CommitFile(t, h.PrimeRecords(), lyxdirs.LyxDirName+"/local.txt", "local\n", "local commit")
+	gitkit.Git(t, h.PrimeRecords(), "fetch", "-q", "origin")
+	branch := gitkit.CurrentBranch(t, h.PrimeRecords())
+	gitkit.Git(t, h.PrimeRecords(), "branch", "-q", "--set-upstream-to=origin/"+branch, branch)
+	prime, err := lyxcwd.NamedWorktree(h.Path, h.Location.WorktreeName)
+	if err != nil {
+		t.Fatalf("NamedWorktree: %v", err)
+	}
+	return h, prime
+}
diff --git a/internal/fabricengine/anchormarker.go b/internal/fabricengine/anchormarker.go
new file mode 100644
index 000000000..485d32524
--- /dev/null
+++ b/internal/fabricengine/anchormarker.go
@@ -0,0 +1,335 @@
+// anchormarker.go writes, commits, reads from git and retires the `.lyx-anchor` markers: a worktree's own marker at the root of its weft branch, and the legacy hub-wide marker on the board.
+// It is the one marker writer outside the anchor move: clone's fresh bind, reconcile's migration and an adopted branch all record their marker through it.
+// It also refuses a marker left empty and derives the anchor of a branch that records none.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/gitexec"
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/lock"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+)
+
+// boltAnchorRemoved is the verdict retireBoltAnchorMarker reports once the hub-wide marker is gone.
+const boltAnchorRemoved = "removed"
+
+// boltAnchorKeptPrefix opens the verdict retireBoltAnchorMarker reports while the hub-wide marker stays, followed by the reason.
+const boltAnchorKeptPrefix = "kept: "
+
+// refuseEmptyOwnMarker returns nil when the marker file at the root of the weft worktree at weftPath is absent or holds a value.
+// It returns an error when the file is present and blank, naming the file and the way forward.
+// The way forward is restoring the file from git when the committed marker holds the anchor.
+// Otherwise it is writing the anchor (or "." for the repo root) into the file and committing it there; the verb is then re-run.
+// It touches nothing.
+func refuseEmptyOwnMarker(weftPath string) error {
+	markerPath := filepath.Join(weftPath, lyxcwd.AnchorFileName)
+	data, err := os.ReadFile(markerPath)
+	if err != nil || strings.TrimSpace(string(data)) != "" {
+		return nil
+	}
+
+	committed, showErr := gitexec.Run([]string{"show", "HEAD:" + lyxcwd.AnchorFileName}, weftPath)
+	if showErr == nil && strings.TrimSpace(committed) != "" {
+		return fmt.Errorf("%s at %s is empty, so its anchor is unreadable; run `git -C %s restore %s` to bring back the committed anchor, then re-run this verb",
+			lyxcwd.AnchorFileName, markerPath, weftPath, lyxcwd.AnchorFileName)
+	}
+	return fmt.Errorf("%s at %s is empty, so its anchor is unreadable; write the anchor (or \".\" for the repo root) into it and commit it there with `git -C %s`, then re-run this verb",
+		lyxcwd.AnchorFileName, markerPath, weftPath)
+}
+
+// commitAnchorMarker writes anchor plus a newline into the marker file at the root of the weft worktree at weftPath.
+// It then commits that one path under subject on the branch checked out there.
+// It holds the weft write lock for the write and the commit, pushes nothing, and returns the commit's SHA.
+// The write goes through an os.Root at weftPath, so a marker path replaced by a link cannot redirect it out of the worktree.
+// When the branch already holds the same bytes it commits nothing and returns an empty SHA.
+func commitAnchorMarker(rec *Mutations, weftPath, anchor, subject string) (string, error) {
+	lockDir, err := ensureWeftLockDirAt(weftPath)
+	if err != nil {
+		return "", err
+	}
+	writeLock, err := lock.AcquireWriteLock(filepath.Join(lockDir, weftWriteLockFile))
+	if err != nil {
+		return "", fmt.Errorf("fabricengine: acquire weft write lock: %w", err)
+	}
+	defer func() { _ = writeLock.Release() }()
+
+	root, err := os.OpenRoot(weftPath)
+	if err != nil {
+		return "", fmt.Errorf("fabricengine: open weft root %s: %w", weftPath, err)
+	}
+	defer func() { _ = root.Close() }()
+
+	if err := root.WriteFile(lyxcwd.AnchorFileName, []byte(anchor+"\n"), 0o644); err != nil {
+		return "", fmt.Errorf("fabricengine: write %s in %s: %w", lyxcwd.AnchorFileName, weftPath, err)
+	}
+	rec.Append(KindFileWritten, filepath.Join(weftPath, lyxcwd.AnchorFileName), "")
+
+	sha, committed, err := gitrepo.New(weftPath).StageAndCommit(subject, []string{lyxcwd.AnchorFileName})
+	if err != nil {
+		return "", fmt.Errorf("fabricengine: commit %s in %s: %w", lyxcwd.AnchorFileName, weftPath, err)
+	}
+	if committed {
+		rec.Append(KindCommitCreated, weftPath, sha)
+	}
+	return sha, nil
+}
+
+// committedMarker reads the marker file at the root of rev's tree in the repository at repoDir, through git objects only.
+// An absent file reports found false.
+// A file that is blank after trimming reports found true with an empty marker, so each caller decides what a blank record means.
+func committedMarker(repoDir, rev string) (marker string, found bool, err error) {
+	data, err := showFile(repoDir, rev, lyxcwd.AnchorFileName)
+	if err != nil {
+		return "", false, fmt.Errorf("read the committed %s at %s in %s: %w", lyxcwd.AnchorFileName, rev, repoDir, err)
+	}
+	if data == nil {
+		return "", false, nil
+	}
+	return strings.TrimSpace(string(data)), true, nil
+}
+
+// treeAnchor answers the anchor of the branch at rev in the repository at repoDir.
+// A committed marker that is not blank is the answer.
+// Without one, the answer is the shallowest directory of rev's tree that holds one of names, "." when the root holds one, a tie at one depth going to the byte-wise smaller path.
+// A tree holding none of names answers fallback.
+// A committed marker that is no usable anchor is an error naming it.
+func treeAnchor(repoDir, rev string, names []string, fallback string) (string, error) {
+	marker, found, err := committedMarker(repoDir, rev)
+	if err != nil {
+		return "", err
+	}
+	if found && marker != "" {
+		anchor, err := lyxcwd.ValidateAnchorRel(marker)
+		if err != nil {
+			return "", fmt.Errorf("the committed %s at %s in %s is unusable: %w", lyxcwd.AnchorFileName, rev, repoDir, err)
+		}
+		return anchor, nil
+	}
+
+	listed, err := gitexec.Run([]string{"ls-tree", "-r", "-d", "-z", "--name-only", rev}, repoDir)
+	if err != nil {
+		return "", fmt.Errorf("list the directories of %s in %s: %w", rev, repoDir, err)
+	}
+	wired := make(map[string]bool, len(names))
+	for _, name := range names {
+		wired[name] = true
+	}
+	holder, holderDepth := "", -1
+	for _, dir := range strings.Split(listed, "\x00") {
+		if dir == "" || !wired[path.Base(dir)] {
+			continue
+		}
+		parent, depth := path.Dir(dir), 0
+		if parent != "." {
+			depth = strings.Count(parent, "/") + 1
+		}
+		if holderDepth < 0 || depth < holderDepth || (depth == holderDepth && parent < holder) {
+			holder, holderDepth = parent, depth
+		}
+	}
+	if holderDepth < 0 {
+		return fallback, nil
+	}
+	return filepath.FromSlash(holder), nil
+}
+
+// recordAdoptedWeftAnchor gives the adopted weft branch checked out at weftPath the marker it lacks, and returns the Location of the pair slug at its own anchor.
+// A branch whose committed marker is absent or blank gets the anchor derived from its tip's tree committed on it, with names as the wired names;
+// a branch that carries a marker keeps it.
+func recordAdoptedWeftAnchor(rec *Mutations, hubPath, slug, weftPath string, names []string) (*lyxcwd.Location, error) {
+	marker, _, err := committedMarker(weftPath, "HEAD")
+	if err != nil {
+		return nil, err
+	}
+	if marker == "" {
+		current, err := lyxcwd.NamedWorktree(hubPath, slug)
+		if err != nil {
+			return nil, err
+		}
+		anchor, err := treeAnchor(weftPath, "HEAD", names, current.AnchorRel)
+		if err != nil {
+			return nil, err
+		}
+		if _, err := commitAnchorMarker(rec, weftPath, anchor, "fabric add: record anchor "+anchor); err != nil {
+			return nil, err
+		}
+	}
+	return lyxcwd.NamedWorktree(hubPath, slug)
+}
+
+// ParentRecordsAnchor answers the anchor of slug's pair and the anchor of the tree ResetRecordsToParent would reset its records to.
+// The second is the anchor of the parent records branch's tip, read from the local branch or else origin's remote-tracking ref, with the pair's own anchor as the answer for a tip that records none.
+// It reads no worktree of the parent, which need not be on this machine.
+// A pair with no origin record, a root pair, and a parent branch found nowhere are refused with the way forward ResetRecordsToParent names.
+func ParentRecordsAnchor(l *lyxcwd.Location, slug string) (own, parent string, err error) {
+	pair, err := lyxcwd.NamedWorktree(l.HubPath, slug)
+	if err != nil {
+		return "", "", err
+	}
+	origin, found, err := ReadOriginFor(l, slug)
+	if err != nil {
+		return "", "", err
+	}
+	if !found {
+		return "", "", missingOriginRecordError(pair, slug, RecordsWorktreePath(pair, slug))
+	}
+	if origin.ParentBranch == "" {
+		return "", "", rootPairNoParentError(slug)
+	}
+	weftRepoRoot, err := RecordsRepoRoot(l)
+	if err != nil {
+		return "", "", fmt.Errorf("resolve weft repo root: %w", err)
+	}
+	parentTip, err := recordsBranchTip(gitrepo.New(weftRepoRoot), RecordsBranchName(origin.ParentBranch))
+	if err != nil {
+		return "", "", err
+	}
+	names, err := RepoWiredNames(pair)
+	if err != nil {
+		return "", "", fmt.Errorf("load the wired names to read the parent's anchor: %w", err)
+	}
+	parent, err = treeAnchor(weftRepoRoot, parentTip, names, pair.AnchorRel)
+	if err != nil {
+		return "", "", err
+	}
+	return pair.AnchorRel, parent, nil
+}
+
+// retireBoltAnchorMarker removes the hub-wide marker from the board, and a leftover pre-rename marker beside it, once every worktree's own marker stands in for it.
+// The removal is one board commit pushed through Bolt, written only after Bolt is brought up to date, so it never writes over a stale board.
+// It reports "" for a hub with no board marker, "removed" once the marker is gone, and "kept: <reason>" while it stays:
+// a weft the census finds without a committed marker, or a board write that was skipped.
+// A board commit that landed but could not be pushed is reported "removed" with the push failure after it.
+func retireBoltAnchorMarker(rec *Mutations, l *lyxcwd.Location) (string, error) {
+	boardDir := BoardDir(l.HubPath)
+	if _, err := os.Stat(filepath.Join(boardDir, lyxcwd.AnchorFileName)); errors.Is(err, fs.ErrNotExist) {
+		return "", nil
+	} else if err != nil {
+		return "", fmt.Errorf("fabricengine: read the board's %s: %w", lyxcwd.AnchorFileName, err)
+	}
+
+	keeper, err := boltAnchorKeeper(l)
+	if err != nil {
+		return "", err
+	}
+	if keeper != "" {
+		return boltAnchorKeptPrefix + keeper, nil
+	}
+
+	bolt := NewBolt(boardDir)
+	res, err := bolt.PullThenCommitWritten([]BoltWrite{{
+		Message: "fabric reconcile: retire the hub-wide anchor marker",
+		Write:   func() ([]string, error) { return removeBoltAnchorMarkers(boardDir) },
+	}}, rec)
+	if err != nil {
+		return "", err
+	}
+	if res.Skipped != "" {
+		return fmt.Sprintf("%s%s: %s", boltAnchorKeptPrefix, res.Skipped, res.SkipDetail), nil
+	}
+	if err := bolt.PushRecorded(SyncOptions{}, rec); err != nil {
+		return fmt.Sprintf("%s; its board commit is not pushed: %v", boltAnchorRemoved, err), nil
+	}
+	return boltAnchorRemoved, nil
+}
+
+// removeBoltAnchorMarkers deletes both marker files from the board directory through an os.Root, skipping an absent one, and returns the board-relative names it deleted.
+func removeBoltAnchorMarkers(boardDir string) ([]string, error) {
+	root, err := os.OpenRoot(boardDir)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: open the board %s: %w", boardDir, err)
+	}
+	defer func() { _ = root.Close() }()
+
+	var removed []string
+	for _, name := range []string{lyxcwd.AnchorFileName, lyxcwd.StaleAnchorFileName} {
+		if err := root.Remove(name); err != nil {
+			if errors.Is(err, fs.ErrNotExist) {
+				continue
+			}
+			return nil, fmt.Errorf("fabricengine: remove %s from the board: %w", name, err)
+		}
+		removed = append(removed, name)
+	}
+	return removed, nil
+}
+
+// boltAnchorKeeper runs the census that decides whether the board's marker may go, and answers the first reason it may not, or "" when it may.
+// The prime's weft and every local pair's weft must carry a non-blank committed marker at HEAD.
+// So must every weft branch, local or fetched, whose warp sibling is on origin, read from its remote-tracking ref.
+// A branch whose ref is not among the fetched ones keeps the marker.
+// A weft branch with no warp sibling on origin is an orphan and is not counted.
+// It reads local refs only and makes no network call.
+func boltAnchorKeeper(l *lyxcwd.Location) (string, error) {
+	entries, err := List(l.WorktreePath())
+	if err != nil {
+		return "", fmt.Errorf("list worktrees: %w", err)
+	}
+	for _, entry := range entries {
+		if entry.Prunable {
+			continue
+		}
+		weftPath := RecordsWorktreePath(l, filepath.Base(filepath.Clean(filepath.FromSlash(entry.Path))))
+		if _, err := os.Stat(weftPath); errors.Is(err, fs.ErrNotExist) {
+			continue
+		} else if err != nil {
+			return "", err
+		}
+		marker, _, err := committedMarker(weftPath, "HEAD")
+		if err != nil {
+			return "", err
+		}
+		if marker == "" {
+			return fmt.Sprintf("the weft at %s carries no committed %s", weftPath, lyxcwd.AnchorFileName), nil
+		}
+	}
+
+	weftRepoRoot, err := RecordsRepoRoot(l)
+	if err != nil {
+		return "", err
+	}
+	trackingPrefix := "refs/remotes/" + originRemoteName + "/"
+	listed, err := gitexec.Run([]string{"for-each-ref", "--format=%(refname)", "refs/heads/", trackingPrefix}, weftRepoRoot)
+	if err != nil {
+		return "", fmt.Errorf("list the weft branches of %s: %w", weftRepoRoot, err)
+	}
+	warp, weft := gitrepo.New(l.WorktreePath()), gitrepo.New(weftRepoRoot)
+	counted := make(map[string]bool)
+	for _, ref := range strings.Fields(listed) {
+		branch := strings.TrimPrefix(strings.TrimPrefix(ref, "refs/heads/"), trackingPrefix)
+		warpBranch, isWeft := WeftWarpSlug(branch)
+		if !isWeft || counted[branch] {
+			continue
+		}
+		counted[branch] = true
+
+		if _, err := warp.RefSHA(trackingPrefix + warpBranch); errors.Is(err, gitrepo.ErrRefNotFound) {
+			continue
+		} else if err != nil {
+			return "", err
+		}
+		tracking := trackingPrefix + branch
+		if _, err := weft.RefSHA(tracking); errors.Is(err, gitrepo.ErrRefNotFound) {
+			return fmt.Sprintf("the weft branch %s is not among the fetched branches of %s", branch, originRemoteName), nil
+		} else if err != nil {
+			return "", err
+		}
+		marker, _, err := committedMarker(weftRepoRoot, tracking)
+		if err != nil {
+			return "", err
+		}
+		if marker == "" {
+			return fmt.Sprintf("the fetched %s/%s carries no committed %s", originRemoteName, branch, lyxcwd.AnchorFileName), nil
+		}
+	}
+	return "", nil
+}
diff --git a/internal/fabricengine/anchormove.go b/internal/fabricengine/anchormove.go
new file mode 100644
index 000000000..7d80ded58
--- /dev/null
+++ b/internal/fabricengine/anchormove.go
@@ -0,0 +1,134 @@
+// anchormove.go moves a weft worktree's content from one anchor to another in one commit.
+// It is the one step a change of an existing worktree's anchor and the creation of a worktree at an anchor share.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/gitexec"
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/lyxdirs"
+)
+
+// anchorFailHook, nil in production, stands in for a failure of the move's commit or of the integration's branch move.
+// It is called with afterCommit false just before the commit or the branch move, and with afterCommit true just after; an error it returns is that failure.
+// A test that sets it must not be parallel.
+var anchorFailHook func(afterCommit bool) error
+
+// weftHeadSHA reads the commit the weft worktree at weftPath is on.
+// It is a variable so a test can fail the read that follows the move commit.
+var weftHeadSHA = func(weftPath string) (string, error) {
+	return gitrepo.New(weftPath).CurrentSHA()
+}
+
+// runAnchorFailHook calls anchorFailHook when one is set.
+func runAnchorFailHook(afterCommit bool) error {
+	if anchorFailHook == nil {
+		return nil
+	}
+	return anchorFailHook(afterCommit)
+}
+
+// moveWeftContent moves the tracked content of each wired name in names from under the anchor from to under the anchor to in the weft worktree at weftPath.
+// It renames from/.lyx to to/.lyx when it exists, and then writes the marker to last through an os.Root at weftPath.
+// All of it is committed in one weft commit spanning from/<names>, to/<names> and the root marker.
+// The caller holds the weft write lock.
+// A name that is not tracked under from is left alone, and a path already standing where a name or `.lyx` would land is refused before anything moves.
+// A failure before the commit returns committed false and leaves the staged and moved paths for the caller to restore;
+// a failure after it, from reading the commit or from the hook, returns committed true beside the error.
+func moveWeftContent(rec *Mutations, weftPath, from, to string, names []string) (bool, error) {
+	root, err := os.OpenRoot(weftPath)
+	if err != nil {
+		return false, fmt.Errorf("fabricengine: open the weft root %s: %w", weftPath, err)
+	}
+	defer func() { _ = root.Close() }()
+
+	fromSlash, toSlash := filepath.ToSlash(from), filepath.ToSlash(to)
+	var moved []string
+	for _, name := range names {
+		if name == lyxdirs.DotLyxDirName {
+			continue
+		}
+		tracked, err := PathTracked(weftPath, anchorJoin(fromSlash, name))
+		if err != nil {
+			return false, err
+		}
+		if !tracked {
+			continue
+		}
+		if err := requireAbsent(root, anchorJoin(toSlash, name)); err != nil {
+			return false, err
+		}
+		moved = append(moved, name)
+	}
+	lyxFrom, lyxTo := anchorJoin(fromSlash, lyxdirs.DotLyxDirName), anchorJoin(toSlash, lyxdirs.DotLyxDirName)
+	lyxPresent := true
+	if _, err := root.Lstat(lyxFrom); errors.Is(err, fs.ErrNotExist) {
+		lyxPresent = false
+	} else if err != nil {
+		return false, fmt.Errorf("fabricengine: inspect %s in %s: %w", lyxFrom, weftPath, err)
+	}
+	if lyxPresent {
+		if err := requireAbsent(root, lyxTo); err != nil {
+			return false, err
+		}
+	}
+
+	if toSlash != "." {
+		if err := root.MkdirAll(toSlash, 0o755); err != nil {
+			return false, fmt.Errorf("fabricengine: create %s in %s: %w", toSlash, weftPath, err)
+		}
+	}
+	specs := []string{lyxcwd.AnchorFileName}
+	for _, name := range moved {
+		src, dst := anchorJoin(fromSlash, name), anchorJoin(toSlash, name)
+		if _, err := gitexec.Run([]string{"mv", "--", src, dst}, weftPath); err != nil {
+			return false, fmt.Errorf("fabricengine: move %s to %s in %s: %w", src, dst, weftPath, err)
+		}
+		rec.Append(KindPathRenamed, filepath.Join(weftPath, filepath.FromSlash(dst)), renamedFrom(weftPath, src))
+		specs = append(specs, src, dst)
+	}
+	if lyxPresent {
+		if err := root.Rename(lyxFrom, lyxTo); err != nil {
+			return false, fmt.Errorf("fabricengine: move %s to %s in %s: %w", lyxFrom, lyxTo, weftPath, err)
+		}
+		rec.Append(KindPathRenamed, filepath.Join(weftPath, filepath.FromSlash(lyxTo)), renamedFrom(weftPath, lyxFrom))
+	}
+	if err := root.WriteFile(lyxcwd.AnchorFileName, []byte(to+"\n"), 0o644); err != nil {
+		return false, fmt.Errorf("fabricengine: write %s in %s: %w", lyxcwd.AnchorFileName, weftPath, err)
+	}
+	rec.Append(KindFileWritten, filepath.Join(weftPath, lyxcwd.AnchorFileName), "")
+
+	if err := runAnchorFailHook(false); err != nil {
+		return false, err
+	}
+	commitArgs := append([]string{"commit", "-q", "-m", fmt.Sprintf("fabric anchor: move the weft from %s to %s", from, to), "--"}, specs...)
+	if _, err := gitexec.RunWithEnv(commitArgs, weftPath, []string{"GIT_LITERAL_PATHSPECS=1"}); err != nil {
+		return false, fmt.Errorf("fabricengine: commit the move of the weft from %s to %s: %w", from, to, err)
+	}
+	sha, err := weftHeadSHA(weftPath)
+	if err != nil {
+		return true, fmt.Errorf("fabricengine: read the weft's commit after the move of the weft from %s to %s: %w", from, to, err)
+	}
+	rec.Append(KindCommitCreated, weftPath, sha)
+	return true, runAnchorFailHook(true)
+}
+
+// requireAbsent returns an error unless nothing stands at rel in the weft root, naming the path.
+func requireAbsent(root *os.Root, rel string) error {
+	_, err := root.Lstat(rel)
+	switch {
+	case err == nil:
+		return fmt.Errorf("fabricengine: %s already exists in the weft, so the content cannot move there; move it out of the way and run the verb again", rel)
+	case errors.Is(err, fs.ErrNotExist):
+		return nil
+	default:
+		return fmt.Errorf("fabricengine: inspect %s in the weft: %w", rel, err)
+	}
+}
diff --git a/internal/fabricengine/anchorstop.go b/internal/fabricengine/anchorstop.go
new file mode 100644
index 000000000..dae09e398
--- /dev/null
+++ b/internal/fabricengine/anchorstop.go
@@ -0,0 +1,165 @@
+// anchorstop.go compares a weft's anchor marker with its upstream's and defines the stop that a difference, or a marker left empty, raises.
+// The weft pull, the fast-forward behind a landing and the replaying push all stop on it instead of crossing an anchor change.
+
+package fabricengine
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/gitrepo"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+)
+
+// ErrAnchorChange is wrapped by every stop that keeps a weft from crossing a change of its anchor marker, or from working with a marker it cannot read.
+var ErrAnchorChange = errors.New("fabricengine: weft anchor marker change")
+
+// PushFailureAnchorChange means the push was held back because the upstream carries another anchor marker than the weft, or the weft's own marker is empty.
+// The record carries the way forward the stop named.
+const PushFailureAnchorChange PushFailureClass = "anchor_change"
+
+// AnchorStopError is the stop of a weft operation that would have crossed an anchor change.
+// Reason says what differs, and WayForward names the commands that settle it.
+// It reports errors.Is(err, ErrAnchorChange), and its message is the reason alone: a caller adds the way forward where it prints one.
+type AnchorStopError struct {
+	Reason     string
+	WayForward string
+}
+
+// Error returns the reason of the stop.
+func (e *AnchorStopError) Error() string {
+	return "fabricengine: " + e.Reason
+}
+
+// Unwrap returns ErrAnchorChange, so errors.Is sees every anchor stop as one.
+func (e *AnchorStopError) Unwrap() error {
+	return ErrAnchorChange
+}
+
+// weftStop returns the stop as a *WeftStopError for branch, whose Err wraps ErrAnchorChange.
+func (e *AnchorStopError) weftStop(branch string) *WeftStopError {
+	return &WeftStopError{
+		Branch:     branch,
+		Err:        fmt.Errorf("%w: %s", ErrAnchorChange, e.Reason),
+		WayForward: e.WayForward,
+	}
+}
+
+// weftAnchorStop compares the anchor of the weft tip head with that of the upstream tip upstream, each read by treeAnchor with names and fallback.
+// It stops when upstream has commits head lacks and the two anchors differ:
+// taking upstream in, by fast-forward or by replay, would then leave a marker other than the checked-out one or carry local commits across a marker change.
+// A head that already contains upstream never stops, so a re-anchor not yet pushed goes through.
+// wantAnchor is the anchor that settles the stop: upstream's when head's anchor equals the merge base's, since only upstream moved it, and head's otherwise.
+// With reset, for a caller that replaces the checked-out tree with upstream's, ancestry is ignored:
+// any difference between the two anchors stops, and wantAnchor is upstream's.
+func weftAnchorStop(weftPath, head, upstream string, names []string, fallback string, reset bool) (wantAnchor string, stop bool, err error) {
+	repo := gitrepo.New(weftPath)
+	headSHA, err := repo.ResolveSHA(head)
+	if err != nil {
+		return "", false, err
+	}
+	upstreamSHA, err := repo.ResolveSHA(upstream)
+	if err != nil {
+		return "", false, err
+	}
+
+	headAnchor, err := treeAnchor(weftPath, headSHA, names, fallback)
+	if err != nil {
+		return "", false, err
+	}
+	upstreamAnchor, err := treeAnchor(weftPath, upstreamSHA, names, fallback)
+	if err != nil {
+		return "", false, err
+	}
+	if headAnchor == upstreamAnchor {
+		return "", false, nil
+	}
+	if reset {
+		return upstreamAnchor, true, nil
+	}
+
+	taken, err := repo.CommitsNotIn(upstreamSHA, headSHA)
+	if err != nil {
+		return "", false, err
+	}
+	if len(taken) == 0 {
+		return "", false, nil
+	}
+	baseSHA, err := repo.MergeBase(headSHA, upstreamSHA)
+	if err != nil {
+		return "", false, err
+	}
+	baseAnchor, err := treeAnchor(weftPath, baseSHA, names, fallback)
+	if err != nil {
+		return "", false, err
+	}
+	if headAnchor == baseAnchor {
+		return upstreamAnchor, true, nil
+	}
+	return headAnchor, true, nil
+}
+
+// emptyMarkerStop returns the stop for a weft worktree whose marker file is present but blank, and nil when it is not.
+// Its way forward is the refusal's own: restore the committed marker, or write the anchor and commit it.
+func emptyMarkerStop(weftPath string) *AnchorStopError {
+	err := refuseEmptyOwnMarker(weftPath)
+	if err == nil {
+		return nil
+	}
+	return &AnchorStopError{
+		Reason:     fmt.Sprintf("the weft's %s is empty", lyxcwd.AnchorFileName),
+		WayForward: err.Error(),
+	}
+}
+
+// refuseDropLocalAnchorChange refuses to move the weft worktree at weftPath of the pair slug onto origin's tip tracking while the anchors of the two differ.
+// A local weft ahead of origin with a re-anchor not yet pushed differs as well, since the comparison ignores ancestry.
+// An empty own marker is refused first.
+// Both refusals wrap ErrAnchorChange, and the difference names the anchor change and the adopt to run again.
+func refuseDropLocalAnchorChange(l *lyxcwd.Location, slug, weftPath, tracking string) error {
+	if stop := emptyMarkerStop(weftPath); stop != nil {
+		return fmt.Errorf("%w: %s", stop, stop.WayForward)
+	}
+	pair, err := lyxcwd.NamedWorktree(l.HubPath, slug)
+	if err != nil {
+		return err
+	}
+	names, err := RepoWiredNames(pair)
+	if err != nil {
+		return fmt.Errorf("load the wired names to compare anchor markers: %w", err)
+	}
+	want, stop, err := weftAnchorStop(weftPath, "HEAD", tracking, names, pair.AnchorRel, true)
+	if err != nil || !stop {
+		return err
+	}
+	return fmt.Errorf("%w: the weft of %s and origin's tip carry different anchors, origin's being %q, so moving it to origin's tip would cross an anchor change; run `lyx fabric anchor %s --set %s`, then run `lyx adopt %s --drop-local` again",
+		ErrAnchorChange, slug, want, slug, want, slug)
+}
+
+// upstreamAnchorStop compares the weft worktree at weftPath, as checked out, with the upstream tip upstream.
+// The pair's fallback anchor and wired names are read from its own recorded anchor, and codeWorktree is where the way forward runs.
+// It returns nil when the weft may take upstream in.
+func upstreamAnchorStop(weftPath, codeWorktree, upstream string) (*AnchorStopError, error) {
+	slug, ok := WeftWarpSlug(filepath.Base(weftPath))
+	if !ok {
+		return nil, fmt.Errorf("fabricengine: %s is no weft sibling worktree", weftPath)
+	}
+	pair, err := lyxcwd.NamedWorktree(filepath.Dir(weftPath), slug)
+	if err != nil {
+		return nil, err
+	}
+	names, err := RepoWiredNames(pair)
+	if err != nil {
+		return nil, fmt.Errorf("fabricengine: load the wired names to compare anchor markers: %w", err)
+	}
+	want, stop, err := weftAnchorStop(weftPath, "HEAD", upstream, names, pair.AnchorRel, false)
+	if err != nil || !stop {
+		return nil, err
+	}
+	return &AnchorStopError{
+		Reason: "origin's weft branch carries another anchor marker than this checkout, so its commits cannot be taken in without crossing an anchor change",
+		WayForward: fmt.Sprintf("run `lyx fabric anchor %s --set %s` in %s, which integrates the other marker, then re-run this command",
+			slug, want, codeWorktree),
+	}, nil
+}
