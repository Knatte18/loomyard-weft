@@ -0,0 +1,226 @@
+//go:build tier0
+
+// run_test.go — tests for run directories (run.go) and the process API (lymtemp.go).
+
+package lymtemp
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+func TestNewRun_HoldsItsLockUntilRemoved(t *testing.T) {
+	t.Parallel()
+	root := newTestRoot(t)
+
+	created, err := root.newRun()
+	if err != nil {
+		t.Fatalf("newRun: %v", err)
+	}
+	if filepath.Dir(created.dir) != root.Path() || !strings.HasPrefix(filepath.Base(created.dir), runPrefix) {
+		t.Fatalf("run directory = %q, want a %q-prefixed child of %q", created.dir, runPrefix, root.Path())
+	}
+	if !regexp.MustCompile(`^r[0-9a-f]{6}$`).MatchString(filepath.Base(created.dir)) {
+		t.Errorf("run directory name %q does not match r plus six hex digits", filepath.Base(created.dir))
+	}
+	info, err := os.Stat(created.dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if runtime.GOOS != "windows" && info.Mode().Perm() != 0o700 {
+		t.Errorf("mode = %04o, want 0700", info.Mode().Perm())
+	}
+	probe, acquired, err := lock.TryAcquireWriteLock(filepath.Join(created.dir, lockFileName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if acquired {
+		probe.Release()
+		t.Fatal("the run directory's lock was free while its owner lived")
+	}
+
+	if err := created.remove(); err != nil {
+		t.Fatalf("remove: %v", err)
+	}
+	if _, err := os.Lstat(created.dir); err == nil {
+		t.Error("run directory survived remove")
+	}
+}
+
+func TestNewRun_RetriesATakenNameUpToTheBound(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name string
+		// script yields the drawn names in order; the last repeats when the draws outrun it.
+		script []string
+		// breakRoot removes the root directory after openRoot, so creation fails with fs.ErrNotExist.
+		breakRoot bool
+		wantDraws int
+		wantErr   func(t *testing.T, err error, rootPath string)
+		wantDir   string
+	}{
+		{
+			name:      "a taken name is retried",
+			script:    []string{"rtaken", "rfresh"},
+			wantDraws: 2,
+			wantDir:   "rfresh",
+		},
+		{
+			name:      "the bound spent fails naming the root",
+			script:    []string{"rtaken"},
+			wantDraws: runNameAttempts,
+			wantErr: func(t *testing.T, err error, rootPath string) {
+				if !strings.Contains(err.Error(), rootPath) {
+					t.Errorf("error %q does not name the root %q", err, rootPath)
+				}
+			},
+		},
+		{
+			name:      "another mkdir error returns at once",
+			script:    []string{"rfresh"},
+			breakRoot: true,
+			wantDraws: 1,
+			wantErr: func(t *testing.T, err error, rootPath string) {
+				if !errors.Is(err, fs.ErrNotExist) {
+					t.Errorf("error %v is not fs.ErrNotExist", err)
+				}
+				if strings.Contains(err.Error(), "names taken") {
+					t.Errorf("error %q is the bound error", err)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			root := newTestRoot(t)
+			if err := os.Mkdir(filepath.Join(root.Path(), "rtaken"), 0o700); err != nil {
+				t.Fatal(err)
+			}
+			draws := 0
+			root.runName = func() string {
+				name := tt.script[min(draws, len(tt.script)-1)]
+				draws++
+				return name
+			}
+			if tt.breakRoot {
+				if err := os.RemoveAll(root.Path()); err != nil {
+					t.Fatal(err)
+				}
+			}
+
+			created, err := root.newRun()
+			if draws != tt.wantDraws {
+				t.Errorf("draws = %d, want %d", draws, tt.wantDraws)
+			}
+			if tt.wantErr != nil {
+				if err == nil {
+					t.Fatal("newRun succeeded, want an error")
+				}
+				tt.wantErr(t, err, root.Path())
+				if !tt.breakRoot {
+					entries, readErr := os.ReadDir(root.Path())
+					if readErr != nil {
+						t.Fatal(readErr)
+					}
+					if len(entries) != 1 {
+						t.Errorf("root holds %d entries, want only the pre-created one", len(entries))
+					}
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("newRun: %v", err)
+			}
+			t.Cleanup(func() { created.remove() })
+			if want := filepath.Join(root.Path(), tt.wantDir); created.dir != want {
+				t.Errorf("run directory = %q, want %q", created.dir, want)
+			}
+			probe, acquired, lockErr := lock.TryAcquireWriteLock(filepath.Join(created.dir, lockFileName))
+			if lockErr != nil {
+				t.Fatal(lockErr)
+			}
+			if acquired {
+				probe.Release()
+				t.Error("the fresh run directory was not locked")
+			}
+		})
+	}
+}
+
+func TestNewRun_InheritedRunDirectoryLandsBesideTheParents(t *testing.T) {
+	t.Parallel()
+	uid := os.Getuid()
+	later := func() time.Time { return fixedClock().Add(24 * time.Hour) }
+	parentRoot, err := openRoot(filepath.Join(t.TempDir(), rootName(uid)), uid, later)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parent, err := parentRoot.newRun()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { parent.remove() })
+	marker := filepath.Join(parent.dir, "marker")
+	if err := os.WriteFile(marker, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	childPath := resolveRootPath(parent.dir, uid)
+	if childPath != parentRoot.Path() {
+		t.Fatalf("resolveRootPath(parent run) = %q, want the parent's root %q", childPath, parentRoot.Path())
+	}
+	childRoot, err := openRoot(childPath, uid, later)
+	if err != nil {
+		t.Fatal(err)
+	}
+	child, err := childRoot.newRun()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { child.remove() })
+
+	if filepath.Dir(child.dir) != filepath.Dir(parent.dir) || child.dir == parent.dir {
+		t.Errorf("child run directory %q is not a sibling of %q", child.dir, parent.dir)
+	}
+	if _, err := os.Stat(marker); err != nil {
+		t.Errorf("the child's sweep touched the parent's run directory: %v", err)
+	}
+}
+
+// TestProcessDirectory_StaysOneDirectoryUnderTheRoot leaves the run directory in place: the test binary's own run directory is removed by its TestMain.
+func TestProcessDirectory_StaysOneDirectoryUnderTheRoot(t *testing.T) {
+	t.Parallel()
+	dir, err := Dir()
+	if err != nil {
+		t.Fatalf("Dir: %v", err)
+	}
+	again, err := Dir()
+	if err != nil || again != dir {
+		t.Fatalf("second Dir = %q, %v, want %q", again, err, dir)
+	}
+
+	made, err := MkdirTemp("made-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	file, err := CreateTemp("made-*.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	for _, path := range []string{made, file.Name()} {
+		if filepath.Dir(path) != dir {
+			t.Errorf("%q is not directly under the run directory %q", path, dir)
+		}
+	}
+}
diff --git a/internal/lymtemp/sweep.go b/internal/lymtemp/sweep.go
new file mode 100644
index 000000000..1dd4fc245
--- /dev/null
+++ b/internal/lymtemp/sweep.go
@@ -0,0 +1,146 @@
+// sweep.go — the lock-guarded removal of dead owners' run directories.
+
+package lymtemp
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// creationGrace is how long a run directory is left alone after its modification time, covering the window between its creation and its owner's lock.
+const creationGrace = 10 * time.Minute
+
+// removeRetryBudget is how long one sweep keeps retrying removals that hit the not-empty symptom, shared by all the directories it removes.
+const removeRetryBudget = time.Second
+
+// removeRetryDelay is the pause between symptom retries, long enough for a peer's lock probe to release a recreated lock file.
+const removeRetryDelay = 5 * time.Millisecond
+
+// SweepReport is the outcome of one sweep.
+type SweepReport struct {
+	// Candidates are the run directories a dead owner left: removed when the sweep applied, otherwise the ones it would remove.
+	Candidates []string
+	// Failures are the entries the sweep could not lock or remove; each is left in place.
+	Failures []SweepFailure
+}
+
+// SweepFailure is an entry a sweep could not handle.
+type SweepFailure struct {
+	Path string
+	Err  error
+}
+
+// Sweep finds the run directories under the root whose owner is dead and past the creation grace, and removes them when apply is true.
+// A dry run computes the same candidates and removes nothing.
+// An entry that vanishes under a concurrent sweeper is no failure.
+func (r *Root) Sweep(apply bool) SweepReport {
+	var report SweepReport
+	entries, err := os.ReadDir(r.path)
+	if err != nil {
+		if !errors.Is(err, fs.ErrNotExist) {
+			report.Failures = append(report.Failures, SweepFailure{Path: r.path, Err: err})
+		}
+		return report
+	}
+	now := r.now()
+	var deadline time.Time
+	for _, entry := range entries {
+		if !strings.HasPrefix(entry.Name(), runPrefix) {
+			continue
+		}
+		path := filepath.Join(r.path, entry.Name())
+		dead, err := ownerDead(path, now)
+		if err != nil {
+			report.Failures = append(report.Failures, SweepFailure{Path: path, Err: err})
+			continue
+		}
+		if !dead {
+			continue
+		}
+		if apply {
+			if err := removeRunDirectory(r, path, &deadline); err != nil {
+				report.Failures = append(report.Failures, SweepFailure{Path: path, Err: err})
+				continue
+			}
+		}
+		report.Candidates = append(report.Candidates, path)
+	}
+	return report
+}
+
+// removeRunDirectory removes path through r.remove, retrying while a concurrent sweeper's lock probe keeps recreating the lock file mid-removal.
+// deadline is the sweep's shared retry deadline, zero until the first symptom sets it to r.retryNow() plus removeRetryBudget.
+// A path that no longer exists counts as removed, and a failure that is not the symptom is returned after its one attempt.
+func removeRunDirectory(r *Root, path string, deadline *time.Time) error {
+	for {
+		err := r.remove(path)
+		if err == nil {
+			return nil
+		}
+		if _, statErr := os.Lstat(path); errors.Is(statErr, fs.ErrNotExist) {
+			return nil
+		}
+		if !isRemovalSymptom(err, path) {
+			return err
+		}
+		if deadline.IsZero() {
+			*deadline = r.retryNow().Add(removeRetryBudget)
+		}
+		if !r.retryNow().Before(*deadline) {
+			return err
+		}
+		r.sleep(removeRetryDelay)
+	}
+}
+
+// isRemovalSymptom reports whether err is the directory-not-empty failure of removing path itself, which a peer's lock probe recreating the lock file causes.
+// Both errors POSIX allows rmdir of a non-empty directory, and Windows' directory-not-empty error, satisfy fs.ErrExist.
+// A not-empty error on a path inside path is no symptom.
+func isRemovalSymptom(err error, path string) bool {
+	var pathErr *fs.PathError
+	return errors.As(err, &pathErr) &&
+		filepath.Clean(pathErr.Path) == filepath.Clean(path) &&
+		errors.Is(pathErr.Err, fs.ErrExist)
+}
+
+// ownerDead reports whether path is a run directory past the creation grace whose owner holds no lock.
+// The probe may briefly recreate a lock file a concurrent sweeper has just removed, and its own hold is released before ownerDead returns.
+// A path that is no directory, is a link, or vanishes mid-check is not dead and no error.
+func ownerDead(path string, now time.Time) (bool, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return false, ignoreNotExist(err)
+	}
+	if !info.Mode().IsDir() || now.Sub(info.ModTime()) <= creationGrace {
+		return false, nil
+	}
+	lockPath := filepath.Join(path, lockFileName)
+	if _, err := os.Lstat(lockPath); err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return true, nil
+		}
+		return false, err
+	}
+	held, acquired, err := lock.TryAcquireWriteLock(lockPath)
+	if err != nil {
+		return false, ignoreNotExist(err)
+	}
+	if !acquired {
+		return false, nil
+	}
+	return true, held.Release()
+}
+
+// ignoreNotExist turns a not-exist error into nil and returns any other error unchanged.
+func ignoreNotExist(err error) error {
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil
+	}
+	return err
+}
diff --git a/internal/lymtemp/sweep_test.go b/internal/lymtemp/sweep_test.go
new file mode 100644
index 000000000..f70820542
--- /dev/null
+++ b/internal/lymtemp/sweep_test.go
@@ -0,0 +1,280 @@
+//go:build tier0
+
+// sweep_test.go — tests for the dead-owner sweep (sweep.go).
+//
+// A dead owner is a run directory whose lock nobody holds, which is what a killed test binary leaves behind.
+
+package lymtemp
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/fslink"
+	"github.com/Knatte18/loomyard/internal/lock"
+)
+
+// newTestRoot opens a root over its own temp directory with the fixed clock.
+func newTestRoot(t *testing.T) *Root {
+	t.Helper()
+	uid := os.Getuid()
+	root, err := openRoot(filepath.Join(t.TempDir(), rootName(uid)), uid, fixedClock)
+	if err != nil {
+		t.Fatalf("openRoot: %v", err)
+	}
+	return root
+}
+
+// makeRunDirectory creates a directory at path with a lock file when withLock, aged by age against the fixed clock.
+func makeRunDirectory(t *testing.T, path string, withLock bool, age time.Duration) {
+	t.Helper()
+	if err := os.Mkdir(path, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if withLock {
+		if err := os.WriteFile(filepath.Join(path, lockFileName), nil, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	modified := fixedClock().Add(-age)
+	if err := os.Chtimes(path, modified, modified); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSweep(t *testing.T) {
+	t.Parallel()
+	past := creationGrace + time.Minute
+
+	rows := []struct {
+		name        string
+		entry       string
+		kind        string
+		withLock    bool
+		held        bool
+		age         time.Duration
+		wantRemoved bool
+	}{
+		{name: "dead owner past the grace", entry: "rdead", kind: "dir", withLock: true, age: past, wantRemoved: true},
+		{name: "lock-less directory past the grace", entry: "rbare", kind: "dir", age: past, wantRemoved: true},
+		{name: "live owner at any age", entry: "rlive", kind: "dir", withLock: true, held: true, age: 1000 * time.Hour},
+		{name: "dead owner within the grace", entry: "rfresh", kind: "dir", withLock: true, age: creationGrace - time.Minute},
+		{name: "unprefixed entry", entry: "other", kind: "dir", withLock: true, age: past},
+		{name: "prefixed file", entry: "rfile", kind: "file", age: past},
+		{name: "prefixed link", entry: "rlink", kind: "link", age: past},
+	}
+	for _, row := range rows {
+		t.Run(row.name, func(t *testing.T) {
+			t.Parallel()
+			root := newTestRoot(t)
+			path := filepath.Join(root.Path(), row.entry)
+			var linkTargetMarker string
+			switch row.kind {
+			case "dir":
+				makeRunDirectory(t, path, row.withLock, row.age)
+				if row.held {
+					held, err := lock.AcquireWriteLock(filepath.Join(path, lockFileName))
+					if err != nil {
+						t.Fatal(err)
+					}
+					t.Cleanup(func() { held.Release() })
+				}
+			case "file":
+				if err := os.WriteFile(path, nil, 0o600); err != nil {
+					t.Fatal(err)
+				}
+			case "link":
+				target := filepath.Join(t.TempDir(), "target")
+				makeRunDirectory(t, target, true, row.age)
+				linkTargetMarker = filepath.Join(target, lockFileName)
+				if err := fslink.CreateDirLink(path, target); err != nil {
+					t.Fatalf("create link: %v", err)
+				}
+			}
+
+			var want []string
+			if row.wantRemoved {
+				want = []string{path}
+			}
+			dry := root.Sweep(false)
+			if fmt.Sprint(dry.Candidates) != fmt.Sprint(want) || len(dry.Failures) != 0 {
+				t.Fatalf("dry run = %+v, want candidates %v and no failures", dry, want)
+			}
+			if _, err := os.Lstat(path); err != nil {
+				t.Fatalf("dry run removed %s: %v", path, err)
+			}
+
+			applied := root.Sweep(true)
+			if fmt.Sprint(applied.Candidates) != fmt.Sprint(want) || len(applied.Failures) != 0 {
+				t.Fatalf("apply = %+v, want candidates %v and no failures", applied, want)
+			}
+			_, err := os.Lstat(path)
+			if gone := err != nil; gone != row.wantRemoved {
+				t.Errorf("entry removed = %v, want %v", gone, row.wantRemoved)
+			}
+			if linkTargetMarker != "" {
+				if _, err := os.Stat(linkTargetMarker); err != nil {
+					t.Errorf("link target was touched: %v", err)
+				}
+			}
+		})
+	}
+
+	t.Run("two concurrent sweeps both succeed", func(t *testing.T) {
+		t.Parallel()
+		root := newTestRoot(t)
+		for i := range 20 {
+			makeRunDirectory(t, filepath.Join(root.Path(), fmt.Sprintf("rdead%02d", i)), true, past)
+		}
+		reports := make([]SweepReport, 2)
+		var wg sync.WaitGroup
+		for i := range reports {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				reports[i] = root.Sweep(true)
+			}()
+		}
+		wg.Wait()
+		for i, report := range reports {
+			if len(report.Failures) != 0 {
+				t.Errorf("sweep %d failures = %+v, want none", i, report.Failures)
+			}
+		}
+		if left := entryNames(t, root.Path()); len(left) != 0 {
+			t.Errorf("root holds %v, want every dead run directory removed", left)
+		}
+	})
+
+	// newRetryRoot returns a root whose retry clock is a retryClock, so no row sleeps, with a dead run directory per name.
+	newRetryRoot := func(t *testing.T, names ...string) (*Root, []string) {
+		t.Helper()
+		root := newTestRoot(t)
+		clock := &retryClock{current: fixedClock()}
+		root.retryNow, root.sleep = clock.now, clock.sleep
+		var paths []string
+		for _, name := range names {
+			path := filepath.Join(root.Path(), name)
+			makeRunDirectory(t, path, true, past)
+			paths = append(paths, path)
+		}
+		return root, paths
+	}
+	notEmpty := func(path string) error {
+		return &fs.PathError{Op: "unlinkat", Path: path, Err: syscall.ENOTEMPTY}
+	}
+
+	t.Run("symptom past three attempts then removed", func(t *testing.T) {
+		t.Parallel()
+		root, paths := newRetryRoot(t, "rdead")
+		attempts := 0
+		root.remove = func(path string) error {
+			attempts++
+			if attempts <= 5 {
+				return notEmpty(path)
+			}
+			return os.RemoveAll(path)
+		}
+		report := root.Sweep(true)
+		if len(report.Failures) != 0 || fmt.Sprint(report.Candidates) != fmt.Sprint(paths) {
+			t.Fatalf("report = %+v, want candidates %v and no failures", report, paths)
+		}
+		if _, err := os.Lstat(paths[0]); err == nil {
+			t.Error("run directory still in place")
+		}
+		if attempts != 6 {
+			t.Errorf("attempts = %d, want 6", attempts)
+		}
+	})
+
+	t.Run("symptom past the budget fails and shares it", func(t *testing.T) {
+		t.Parallel()
+		root, paths := newRetryRoot(t, "rdead1", "rdead2")
+		attempts := map[string]int{}
+		root.remove = func(path string) error {
+			attempts[path]++
+			return notEmpty(path)
+		}
+		report := root.Sweep(true)
+		if len(report.Candidates) != 0 || len(report.Failures) != 2 {
+			t.Fatalf("report = %+v, want two failures and no candidates", report)
+		}
+		for i, failure := range report.Failures {
+			if failure.Path != paths[i] || !errors.Is(failure.Err, syscall.ENOTEMPTY) {
+				t.Errorf("failure %d = %+v, want %s with ENOTEMPTY", i, failure, paths[i])
+			}
+			if _, err := os.Lstat(paths[i]); err != nil {
+				t.Errorf("run directory %s gone: %v", paths[i], err)
+			}
+		}
+		if want := int(removeRetryBudget/removeRetryDelay) + 1; attempts[paths[0]] != want {
+			t.Errorf("first directory attempts = %d, want %d", attempts[paths[0]], want)
+		}
+		if attempts[paths[1]] != 1 {
+			t.Errorf("second directory attempts = %d, want 1", attempts[paths[1]])
+		}
+	})
+
+	for _, row := range []struct {
+		name string
+		err  func(path string) error
+	}{
+		{"another error is reported after one attempt", func(path string) error {
+			return &fs.PathError{Op: "unlinkat", Path: path, Err: syscall.EACCES}
+		}},
+		{"not-empty on a path inside is another error", func(path string) error {
+			return &fs.PathError{Op: "unlinkat", Path: filepath.Join(path, lockFileName), Err: syscall.ENOTEMPTY}
+		}},
+	} {
+		t.Run(row.name, func(t *testing.T) {
+			t.Parallel()
+			root, paths := newRetryRoot(t, "rdead")
+			attempts := 0
+			root.remove = func(path string) error {
+				attempts++
+				return row.err(path)
+			}
+			report := root.Sweep(true)
+			if len(report.Failures) != 1 || len(report.Candidates) != 0 {
+				t.Fatalf("report = %+v, want one failure and no candidates", report)
+			}
+			if attempts != 1 {
+				t.Errorf("attempts = %d, want 1", attempts)
+			}
+			if _, err := os.Lstat(paths[0]); err != nil {
+				t.Errorf("run directory gone: %v", err)
+			}
+		})
+	}
+
+	t.Run("a path gone between attempts counts as removed", func(t *testing.T) {
+		t.Parallel()
+		root, paths := newRetryRoot(t, "rdead")
+		root.remove = func(path string) error {
+			if err := os.RemoveAll(path); err != nil {
+				return err
+			}
+			return notEmpty(path)
+		}
+		report := root.Sweep(true)
+		if len(report.Failures) != 0 || fmt.Sprint(report.Candidates) != fmt.Sprint(paths) {
+			t.Fatalf("report = %+v, want candidates %v and no failures", report, paths)
+		}
+	})
+}
+
+// retryClock is a retry clock that advances only by sleeping, so a sweep's whole retry budget passes without waiting.
+type retryClock struct {
+	current time.Time
+}
+
+func (c *retryClock) now() time.Time { return c.current }
+
+func (c *retryClock) sleep(d time.Duration) { c.current = c.current.Add(d) }
