+// TestConsumeAttempt covers the re-launch consumption over a temp status file and attempt directory with the real shedengine.Relaunch.
+// Rows with a refusal assert its message and the absent applied mark; success rows assert the applied mark and where the run stands.
+func TestConsumeAttempt(t *testing.T) {
+	t.Parallel()
+
+	const blocked = "Plan-Write"
+	baseStatus := shedengine.Status{
+		CurrentProducer: "Plan-Bouncer",
+		State:           shedengine.StateBlocked,
+		History:         []shedengine.HistoryEntry{{Producer: "Plan-Write", Outcome: shedengine.Done}, {Producer: "Plan-Bouncer", Outcome: shedengine.Done}},
+	}
+	resumeEnvelope := loomengine.ArbiterEnvelope{Verdict: loomengine.ArbiterVerdictResume, Reason: "safe"}
+	gotoPlanWriteEnvelope := loomengine.ArbiterEnvelope{Verdict: loomengine.ArbiterVerdictResume, Reason: "safe", Goto: blocked}
+	// verdictInEffect leaves the run as the verdict's own goto to Plan-Write would.
+	verdictInEffect := func(st *shedengine.Status) {
+		st.History = append(st.History, shedengine.HistoryEntry{Producer: "Plan-Write", Outcome: shedengine.OutcomeGoto})
+		st.CurrentProducer = "Plan-Write"
+		st.State = shedengine.StatePaused
+	}
+	tests := []struct {
+		name string
+		// envelope is written as envelope.json unless nil; rawEnvelope overrides it with raw bytes.
+		envelope    *loomengine.ArbiterEnvelope
+		rawEnvelope string
+		// verdictYAML is written as the agent's verdict.yaml when non-empty.
+		verdictYAML string
+		applied     bool
+		// mutate changes the status file after the attempt recorded its stop key and pause conditions.
+		mutate func(st *shedengine.Status)
+		// spawn changes the attempt record before it is written.
+		spawn func(a *loomengine.ArbiterAttempt)
+		// guard is the base request's goto guard.
+		guard       shedengine.GotoGuard
+		wantErr     string
+		wantProduce string
+		// wantHistory is the history length asserted on a success row when non-zero.
+		wantHistory int
+		// pauseAfterCall requests a plain pause once the call returned and expects it to survive.
+		pauseAfterCall bool
+	}{
+		{name: "missing envelope", wantErr: "unusable: the arbiter verb left no envelope"},
+		{name: "unparseable envelope", rawEnvelope: "{", wantErr: "unusable"},
+		{
+			name:     "hand-on envelope",
+			envelope: &loomengine.ArbiterEnvelope{Verdict: loomengine.ArbiterVerdictHandOn, Reason: "r", Question: "q"}, wantErr: "not a resume",
+		},
+		{
+			name:        "verdict file says resume under a precondition hand-on envelope",
+			envelope:    &loomengine.ArbiterEnvelope{Verdict: loomengine.ArbiterVerdictHandOn, Cause: sheddriver.CausePrecondition, Reason: "r", Question: "q"},
+			verdictYAML: resumeVerdict, wantErr: "not a resume",
+		},
+		{name: "already applied", envelope: &resumeEnvelope, applied: true, wantErr: "already applied"},
+		{
+			name: "stop key moved by a goto", envelope: &resumeEnvelope,
+			mutate: func(st *shedengine.Status) {
+				st.History = append(st.History, shedengine.HistoryEntry{Producer: "Plan-Write", Outcome: shedengine.OutcomeGoto})
+			},
+			wantErr: "the run moved since the arbiter spawned",
+		},
+		{
+			name: "a plain pause left by an older binary is carried through", envelope: &resumeEnvelope,
+			mutate:      func(st *shedengine.Status) { st.PauseRequested = true },
+			wantProduce: "Plan-Bouncer",
+		},
+		{
+			name: "pause before a row", envelope: &resumeEnvelope,
+			mutate:  func(st *shedengine.Status) { st.PauseBefore = "Plan-Bouncer" },
+			wantErr: "paused since the arbiter spawned",
+		},
+		{
+			name: "pause after a row", envelope: &resumeEnvelope,
+			mutate:  func(st *shedengine.Status) { st.PauseAfter = "Plan-Write" },
+			wantErr: "paused since the arbiter spawned",
+		},
+		{
+			name: "a refusing guard refuses the goto", envelope: &gotoPlanWriteEnvelope,
+			guard:   func(string) (string, error) { return "the Plan-Review verdict is settled", nil },
+			wantErr: "the Plan-Review verdict is settled",
+		},
+		{name: "resume without a target", envelope: &resumeEnvelope, wantProduce: "Plan-Bouncer"},
+		{
+			name:     "resume with a backward target",
+			envelope: &loomengine.ArbiterEnvelope{Verdict: loomengine.ArbiterVerdictResume, Reason: "safe", Goto: blocked}, wantProduce: blocked,
+		},
+		{
+			name: "verdict already in effect is consumed with no second goto", envelope: &gotoPlanWriteEnvelope,
+			mutate: verdictInEffect, wantProduce: "Plan-Write", wantHistory: 3,
+		},
+		{
+			name: "a pause the goto cleared does not refuse the in-effect admit", envelope: &gotoPlanWriteEnvelope,
+			spawn:  func(a *loomengine.ArbiterAttempt) { a.PauseBefore = "Plan-Bouncer" },
+			mutate: verdictInEffect, wantProduce: "Plan-Write", wantHistory: 3,
+		},
+		{
+			name: "a pause added since the spawn refuses the in-effect admit", envelope: &gotoPlanWriteEnvelope,
+			mutate: func(st *shedengine.Status) {
+				verdictInEffect(st)
+				st.PauseAfter = "Plan-Write"
+			},
+			wantErr: "paused since the arbiter spawned",
+		},
+		{
+			name: "an unmoved run whose pause was cleared by hand is refused", envelope: &resumeEnvelope,
+			spawn:   func(a *loomengine.ArbiterAttempt) { a.PauseBefore = "Plan-Bouncer" },
+			wantErr: "paused since the arbiter spawned",
+		},
+		{
+			name: "moved by a goto to another row is refused", envelope: &gotoPlanWriteEnvelope,
+			mutate: func(st *shedengine.Status) {
+				st.History = append(st.History, shedengine.HistoryEntry{Producer: "Plan-Bouncer", Outcome: shedengine.OutcomeGoto})
+				st.State = shedengine.StatePaused
+			},
+			wantErr: "the run moved",
+		},
+		{
+			name: "moved by a goto and then stepped is refused", envelope: &gotoPlanWriteEnvelope,
+			mutate: func(st *shedengine.Status) {
+				st.History = append(st.History,
+					shedengine.HistoryEntry{Producer: "Plan-Write", Outcome: shedengine.OutcomeGoto},
+					shedengine.HistoryEntry{Producer: "Plan-Write", Outcome: shedengine.Stuck},
+					shedengine.HistoryEntry{Producer: "Plan-Write", Outcome: shedengine.OutcomeGoto},
+				)
+				st.CurrentProducer = "Plan-Write"
+				st.State = shedengine.StatePaused
+			},
+			wantErr: "the run moved",
+		},
+		{name: "a plain pause written after the call survives", envelope: &resumeEnvelope, wantProduce: "Plan-Bouncer", pauseAfterCall: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			root := t.TempDir()
+			statusPath := filepath.Join(root, "status.json")
+			statusLock := filepath.Join(root, "scratch", "status.lock")
+			runLock := filepath.Join(root, "scratch", "run.lock")
+			attemptDir := filepath.Join(root, "arbiter", "attempt-1")
+
+			if err := os.MkdirAll(filepath.Dir(statusLock), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			if err := state.WriteJSON(statusPath, statusLock, baseStatus); err != nil {
+				t.Fatal(err)
+			}
+			attempt := loomengine.ArbiterAttempt{Number: 1, StopKey: sheddriver.StopKeyOf(baseStatus)}
+			if tt.spawn != nil {
+				tt.spawn(&attempt)
+			}
+			if err := loomengine.WriteArbiterAttempt(attemptDir, attempt); err != nil {
+				t.Fatal(err)
+			}
+			switch {
+			case tt.rawEnvelope != "":
+				if err := os.WriteFile(loomengine.ArbiterEnvelopePath(attemptDir), []byte(tt.rawEnvelope), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			case tt.envelope != nil:
+				if err := loomengine.WriteArbiterEnvelope(loomengine.ArbiterEnvelopePath(attemptDir), *tt.envelope); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tt.verdictYAML != "" {
+				writeVerdictFile(t, attemptDir, tt.verdictYAML)
+			}
+			if tt.applied {
+				if err := loomengine.MarkArbiterApplied(attemptDir); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tt.mutate != nil {
+				mutated := baseStatus
+				tt.mutate(&mutated)
+				if err := state.WriteJSON(statusPath, statusLock, mutated); err != nil {
+					t.Fatal(err)
+				}
+			}
+			producers := []shedengine.ProducerDef{{Name: "Plan-Write"}, {Name: "Plan-Bouncer"}, {Name: "Publish"}}
+			request := shedengine.RelaunchRequest{StatusPath: statusPath, LockPath: runLock, StatusLockPath: statusLock, Producers: producers, RunID: "self", Guard: tt.guard}
+			before, _, readErr := state.ReadJSON[shedengine.Status](statusPath, statusLock)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+
+			err := ConsumeAttempt(attemptDir, request)
+
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("ConsumeAttempt() error = %v; want it to contain %q", err, tt.wantErr)
+				}
+				// A guard's refusal comes from Shed with the guard's own way forward, not the attempt's.
+				if tt.guard == nil && !strings.Contains(err.Error(), loomengine.ArbiterVerdictPath(attemptDir)) {
+					t.Errorf("ConsumeAttempt() error = %v; want it to name the verdict path", err)
+				}
+				if applied, _ := loomengine.ArbiterApplied(attemptDir); applied != tt.applied {
+					t.Errorf("applied mark = %v after a refusal; want %v, as before the call", applied, tt.applied)
+				}
+				if after, _, _ := state.ReadJSON[shedengine.Status](statusPath, statusLock); !reflect.DeepEqual(after, before) {
+					t.Errorf("status after a refusal = %+v; want it unchanged from %+v", after, before)
+				}
+				return
+			}
+
+			if err != nil {
+				t.Fatalf("ConsumeAttempt() error = %v; want nil", err)
+			}
+			if applied, _ := loomengine.ArbiterApplied(attemptDir); !applied {
+				t.Error("applied mark is absent after a consumed attempt; want it written")
+			}
+			if tt.pauseAfterCall {
+				err := state.UpdateJSON(statusPath, statusLock, func(cur shedengine.Status, _ bool) (shedengine.Status, error) {
+					cur.PauseRequested = true
+					return cur, nil
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			got, _, readErr := state.ReadJSON[shedengine.Status](statusPath, statusLock)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			if got.CurrentProducer != tt.wantProduce {
+				t.Errorf("current producer = %q; want %q", got.CurrentProducer, tt.wantProduce)
+			}
+			if tt.wantHistory != 0 && len(got.History) != tt.wantHistory {
+				t.Errorf("history length = %d; want %d", len(got.History), tt.wantHistory)
+			}
+			if tt.pauseAfterCall && !got.PauseRequested {
+				t.Error("pause_requested = false after a pause written following the call; want it set for the next step")
+			}
+		})
+	}
+}
diff --git a/internal/shedarbiter/doc.go b/internal/shedarbiter/doc.go
new file mode 100644
index 000000000..a8341e31a
--- /dev/null
+++ b/internal/shedarbiter/doc.go
@@ -0,0 +1,25 @@
+// doc.go carries the package godoc for shedarbiter: the arbiter's place in a shed run's stop chain and the seams its callers fill.
+
+// Package shedarbiter is the arbiter call every shed-driven recipe's Go driver uses.
+// At a stop the driver's rule table and tackler could not settle, it spawns a cold, stronger-model agent through shuttle, waits for its verdict file and returns the validated verdict.
+//
+// It is a told-geometry package: every path, clock, shuttle and reader reaches it through Deps, and it imports no cwd resolver and no CLI package.
+// A recipe's driver builds Deps once and either settles a stop through NewCall and Call.Settle, or hands Seam to the shed driver.
+// The records an attempt leaves (attempt, marker, verdict, envelope) stay in loomengine, and the call writes and reads them there.
+//
+// # The call
+//
+// A call spawns at most Settings.MaxSpawns agents per run, counted from the attempt records on disk, so no restart resets the count, and it moves no run itself.
+// A call for a stop an earlier attempt already arbitrated spawns nothing: it returns that attempt's verdict, or waits on the attempt's live arbiter.
+// A verdict file that does not read, a run that timed out or died, and a resume whose precondition fails each end as a hand-on naming a cause.
+// Every refusal ends with Deps.HandBackWayForward, which names the verb that shows the stop.
+//
+// # The prompt
+//
+// Prompt fills the arbiter stencil over one stop's paths and the description of the recipe whose run it judges, so the stencil itself names no recipe.
+// Spec and VerdictGate compose the launch and the re-prompt gate that keeps an unreadable verdict from ending the run.
+//
+// # The resume
+//
+// ConsumeAttempt applies a resume verdict when the driver re-launches the loop naming its attempt: it checks the run against the attempt under the status lock, marks the attempt applied and performs the goto.
+package shedarbiter
diff --git a/internal/shedarbiter/prompt.go b/internal/shedarbiter/prompt.go
new file mode 100644
index 000000000..d4d8257a0
--- /dev/null
+++ b/internal/shedarbiter/prompt.go
@@ -0,0 +1,138 @@
+// prompt.go implements the arbiter session's launch prompt, shuttle spec and verdict gate.
+// The prompt and spec are pure composers: the arbiter stencil filled over one stop's paths and the recipe's description, and the spec the arbiter launches from.
+
+package shedarbiter
+
+import (
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/editdirective"
+	"github.com/Knatte18/loomyard/internal/loomengine"
+	"github.com/Knatte18/loomyard/internal/parentdirective"
+	"github.com/Knatte18/loomyard/internal/segmentcolor"
+	"github.com/Knatte18/loomyard/internal/sheddriver"
+	"github.com/Knatte18/loomyard/internal/shuttleengine"
+	"github.com/Knatte18/loomyard/internal/stencil"
+	"github.com/Knatte18/loomyard/internal/stencilstore"
+)
+
+// stencilName is the registered name of the arbiter's opening stencil.
+const stencilName = "loom-template-arbiter"
+
+// AbsentPath fills a path marker, and the recipe marker, when the stop has no such file.
+const AbsentPath = "none"
+
+// verdictGateAttempts is how many times the verdict gate re-prompts an arbiter whose verdict file does not read.
+const verdictGateAttempts = 2
+
+// skills is the skill list the arbiter loads before its launch prompt: none, since the prompt is its whole procedure.
+var skills = []string{}
+
+// PromptInput carries what the arbiter stencil's markers are filled from.
+// Recipe, ReportPath, BriefPath, CaseBriefPath, DecisionRecordPath, SupportLogPath and AmendmentTarget may be empty; every other field is required.
+// Recipe is the description of the run's recipe, including the repair verbs the arbiter may run.
+// AmendmentTarget is the row a plan amendment routes to.
+type PromptInput struct {
+	Recipe             string
+	RunID              string
+	Slug               string
+	Worktree           string
+	EnvelopePath       string
+	ReportPath         string
+	BriefPath          string
+	CaseBriefPath      string
+	DecisionRecordPath string
+	SupportLogPath     string
+	VerdictPath        string
+	AmendmentTarget    string
+}
+
+// Prompt composes the arbiter session's launch prompt.
+// The arbiter stencil is read from stencilsDir through stencilstore.Read and filled with in, parentdirective.Directive(stencilsDir, "", false) and editdirective.Directive(stencilsDir).
+// The no-parent directive is rendered because the verdict file is the arbiter's only channel.
+// An empty recipe description, report, brief, case brief, decision record, support log or amendment target is filled as the literal "none".
+// It returns the read or fill error wrapped with the stencil's name.
+func Prompt(stencilsDir string, in PromptInput) (string, error) {
+	directive, err := parentdirective.Directive(stencilsDir, "", false)
+	if err != nil {
+		return "", err
+	}
+	editDirective, err := editdirective.Directive(stencilsDir)
+	if err != nil {
+		return "", err
+	}
+	template, err := stencilstore.Read(stencilsDir, stencilName)
+	if err != nil {
+		return "", fmt.Errorf("loom: arbiter prompt: read stencil %q: %w", stencilName, err)
+	}
+	filled, err := stencil.Fill(template, map[string]string{
+		"recipe":                   pathOrNone(in.Recipe),
+		"run_id":                   in.RunID,
+		"slug":                     in.Slug,
+		"worktree":                 in.Worktree,
+		"envelope_path":            in.EnvelopePath,
+		"report_path":              pathOrNone(in.ReportPath),
+		"brief_path":               pathOrNone(in.BriefPath),
+		"case_brief_path":          pathOrNone(in.CaseBriefPath),
+		"decision_record_path":     pathOrNone(in.DecisionRecordPath),
+		"support_log_path":         pathOrNone(in.SupportLogPath),
+		"verdict_path":             in.VerdictPath,
+		"amendment_target":         pathOrNone(in.AmendmentTarget),
+		parentdirective.MarkerName: directive,
+		editdirective.MarkerName:   editDirective,
+	})
+	if err != nil {
+		return "", fmt.Errorf("loom: arbiter prompt: fill stencil %q: %w", stencilName, err)
+	}
+	return string(filled), nil
+}
+
+// pathOrNone returns path, or the literal "none" for an empty one.
+func pathOrNone(path string) string {
+	if path == "" {
+		return AbsentPath
+	}
+	return path
+}
+
+// Spec composes the shuttleengine.Spec the arbiter session launches from, from an already-composed prompt, the verdict path and the resolved arbiter settings.
+//
+// Prompt is the argument verbatim. Skills is empty, so the prompt is the arbiter's whole procedure.
+// OutputFiles is a single-entry slice holding verdictPath, so shuttle's completion check reads the verdict through allOutputFilesExist and reed drops a finished strand on resume.
+// ModelChoice is the settings' choice whole, which carries the RESOLVED engine, provider model id, effort and version.
+// Timeout is the settings' timeout, which bounds the arbiter's run.
+// Role is loomengine.ArbiterRole, which reed forms into `<shortname>:<slug>:arbiter`; NameOverride is left empty so a second attempt numbers its role.
+// Segment is the coordinator, the driver's, because the arbiter acts for the driver.
+// Interactive is false, shuttle's autonomous posture, which adds the operator-prompt deny an unattended session needs.
+// ForkSubagents is false and Parent is empty: the arbiter spawns nothing and has no session to message.
+// Display is left at its zero value.
+func Spec(prompt, verdictPath string, settings sheddriver.ArbiterSettings) shuttleengine.Spec {
+	return shuttleengine.Spec{
+		Prompt:        prompt,
+		Skills:        skills,
+		OutputFiles:   []string{verdictPath},
+		ModelChoice:   settings.ModelChoice,
+		Timeout:       settings.Timeout,
+		Role:          loomengine.ArbiterRole,
+		Segment:       segmentcolor.Coordinator,
+		Interactive:   false,
+		ForkSubagents: false,
+		Parent:        "",
+	}
+}
+
+// VerdictGate returns the gate the arbiter's run carries, which re-prompts the arbiter while the verdict file at verdictPath does not read as a valid verdict.
+// An absent file passes, so a run that ends without a verdict still reads as missing.
+// A file that fails the reader is a failed result whose findings carry the reader's error and the path to rewrite.
+// The entry lets the run through once its budget is spent, so the call's own read after the run still hands on with cause unparseable.
+func VerdictGate(verdictPath string) shuttleengine.GateSpec {
+	gate := func() (shuttleengine.GateResult, error) {
+		if _, _, err := loomengine.ReadArbiterVerdict(verdictPath); err != nil {
+			return shuttleengine.GateResult{
+				Findings: fmt.Sprintf("%s\n\nRewrite the verdict file (%s) so it reads: write reason, question and each verbs item as a literal block scalar (|-).", err.Error(), verdictPath),
+			}, nil
+		}
+		return shuttleengine.GateResult{Passed: true}, nil
+	}
+	return shuttleengine.GateSpec{{Name: "verdict", Gate: gate, Attempts: verdictGateAttempts, PassOnCap: true}}
+}
