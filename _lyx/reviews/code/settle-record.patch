+			t.Errorf("ParentBeamOf(a) = %q, %v; want beam", beam, err)
+		}
+		listed, err := b.ListTasksBrief(nil)
+		if err != nil {
+			t.Fatalf("ListTasksBrief() error = %v; want nil", err)
+		}
+		for _, brief := range listed {
+			if want := map[string]string{"a": "beam", "beam": ""}[brief.Slug]; brief.ParentBeam != want {
+				t.Errorf("listed parent_beam of %s = %q; want %q", brief.Slug, brief.ParentBeam, want)
+			}
+		}
+	})
+
+	t.Run("AFailingSeamLeavesTheCellEmptyAndTheListSucceeds", func(t *testing.T) {
+		t.Parallel()
+		errSeam := errors.New("origin record unreadable")
+		b := newProjectBoard(t, func(cfg *boardengine.Config) {
+			seedBoardJSON(t, cfg.Path, `{"id":0,"slug":"a","title":"A","kind":"task","labels":["bug"]}`)
+			cfg.ParentOf = func(string) (string, error) { return "beam", errSeam }
+		})
+		listed, err := b.ListTasksBrief(nil)
+		if err != nil || len(listed) != 1 || listed[0].ParentBeam != "" {
+			t.Errorf("ListTasksBrief() = %+v, %v; want one entry with an empty parent_beam and no error", listed, err)
+		}
+		if _, err := b.ParentBeamOf("a"); !errors.Is(err, errSeam) {
+			t.Errorf("ParentBeamOf(a) error = %v; want the seam's error", err)
+		}
+	})
+
+	t.Run("ReadTasksReadsTheLocalFileAndAnAbsentOneIsEmpty", func(t *testing.T) {
+		t.Parallel()
+		var boardPath string
+		newProjectBoard(t, func(cfg *boardengine.Config) {
+			boardPath = cfg.Path
+			seedBoardJSON(t, cfg.Path, `{"id":0,"slug":"a","title":"A","kind":"task","labels":["bug"]}`)
+		})
+		tasks, err := boardengine.ReadTasks(boardPath)
+		if err != nil || len(tasks) != 1 || tasks[0].Slug != "a" {
+			t.Errorf("ReadTasks() = %+v, %v; want entry a", tasks, err)
+		}
+		if tasks, err := boardengine.ReadTasks(t.TempDir()); err != nil || len(tasks) != 0 {
+			t.Errorf("ReadTasks() on an absent file = %+v, %v; want an empty list", tasks, err)
+		}
+	})
+}
diff --git a/internal/boardengine/project.go b/internal/boardengine/project.go
new file mode 100644
index 000000000..c695b5ade
--- /dev/null
+++ b/internal/boardengine/project.go
@@ -0,0 +1,142 @@
+// project.go — the write rules that keep a project's membership and its dependents consistent.
+//
+// checkProjectRules judges the entries a write leaves against the entries as loaded, inside the write critical section.
+
+package boardengine
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// checkProjectRules refuses a write that leaves a project in a state its rules forbid.
+// loaded is the entries before the write, under any rename the write made, and after the entries the write leaves.
+// pairExists reports whether an entry's pair exists on this machine; nil reads every pair as absent.
+// An entry is judged only for a field the write sets or changes, an entry new to the board counting as set,
+// so a stored state that is now refused keeps taking unrelated writes.
+func checkProjectRules(loaded, after []Task, pairExists func(slug string) bool) error {
+	loadedBySlug := make(map[string]Task, len(loaded))
+	for _, task := range loaded {
+		loadedBySlug[task.Slug] = task
+	}
+	afterBySlug := make(map[string]Task, len(after))
+	for _, task := range after {
+		afterBySlug[task.Slug] = task
+	}
+
+	for _, task := range after {
+		before, existed := loadedBySlug[task.Slug]
+		if !existed || !slices.Equal(before.DependsOn, task.DependsOn) {
+			for _, dep := range task.DependsOn {
+				if afterBySlug[dep].Kind == KindProject {
+					return dependsOnProjectError(task.Slug, dep, after)
+				}
+			}
+		}
+		if (!existed || before.Project != task.Project) && task.Project != "" {
+			if err := checkProjectField(task, afterBySlug); err != nil {
+				return err
+			}
+		}
+		if existed && before.Project != task.Project && pairExists != nil && pairExists(task.Slug) {
+			return fmt.Errorf("entry %q has a pair, and a change of its project moves its pair out from under its project's beam: end the pair first with `lyx batten cancel %s --remove`, then change project", task.Slug, task.Slug)
+		}
+		if (!existed || !slices.Equal(before.Order, task.Order)) && len(task.Order) > 0 {
+			if err := checkOrderField(task, afterBySlug); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// checkBeamPayload judges the beam key of an upsert payload against the entry's stored flag, the entry being new when the store holds none.
+// A value equal to the stored one, false for a new entry, is a no-op and is dropped from fields; any other value is refused, since only the beam verbs write the flag.
+// A payload without the key passes untouched.
+func checkBeamPayload(s *Store, fields map[string]any) error {
+	value, carried := fields["beam"]
+	if !carried {
+		return nil
+	}
+	slug, _ := fields["slug"].(string)
+	stored, held := s.GetTask(slug)
+	proposed, isBool := value.(bool)
+	if !isBool {
+		return fmt.Errorf("entry %q has a beam value that is not true or false: drop the beam key from the payload", slug)
+	}
+	if proposed == stored.Beam {
+		delete(fields, "beam")
+		return nil
+	}
+	if !proposed {
+		return fmt.Errorf("entry %q is a beam, and the beam flag stays set for the beam's life, which ends when `lyx beam land %s` lands it and marks the project done: drop the beam key from the payload", slug, slug)
+	}
+	kind, _ := fields["kind"].(string)
+	if held {
+		kind = stored.Kind
+	}
+	if kind == KindProject {
+		return fmt.Errorf("entry %q cannot be made a beam by a board write: run `lyx beam create %s` to make the project a beam, and drop the beam key from the payload", slug, slug)
+	}
+	return fmt.Errorf("entry %q cannot be made a beam by a board write: run `lyx beam promote %s` to turn the task into a beam, and drop the beam key from the payload", slug, slug)
+}
+
+// membershipError is the refusal of an entry's project or order field at slug, naming the way forward of correcting that slug or dropping it from the field.
+func membershipError(entry, field, slug, reason string) error {
+	return fmt.Errorf("entry %q has %s %q, which %s: correct the slug, or drop it from %s", entry, field, slug, reason, field)
+}
+
+// checkProjectField refuses task's project when it names an absent entry, a non-project, the entry itself, a done project, a run-held project or a chain of projects with a cycle.
+func checkProjectField(task Task, afterBySlug map[string]Task) error {
+	project, found := afterBySlug[task.Project]
+	switch {
+	case task.Project == task.Slug:
+		return membershipError(task.Slug, "project", task.Project, "is the entry itself")
+	case !found:
+		return membershipError(task.Slug, "project", task.Project, "names no entry")
+	case project.Kind != KindProject:
+		return membershipError(task.Slug, "project", task.Project, "is not a project")
+	case isDone(project):
+		return membershipError(task.Slug, "project", task.Project, "is done")
+	case IsRunStatus(project.Status):
+		return membershipError(task.Slug, "project", task.Project, "is held by a run")
+	}
+	visited := map[string]bool{task.Slug: true}
+	for current := task.Project; current != ""; current = afterBySlug[current].Project {
+		if visited[current] {
+			return membershipError(task.Slug, "project", task.Project, "is in a chain of projects that loops back on itself")
+		}
+		visited[current] = true
+	}
+	return nil
+}
+
+// checkOrderField refuses a project's order when it names an entry whose project is not this project, or names one entry twice.
+func checkOrderField(project Task, afterBySlug map[string]Task) error {
+	seen := make(map[string]bool, len(project.Order))
+	for _, slug := range project.Order {
+		if seen[slug] {
+			return membershipError(project.Slug, "order", slug, "is named twice")
+		}
+		seen[slug] = true
+		if afterBySlug[slug].Project != project.Slug {
+			return membershipError(project.Slug, "order", slug, "is no entry of this project")
+		}
+	}
+	return nil
+}
+
+// dependsOnProjectError refuses entry's dependency on project, naming the project's task members as what to depend on and set-deps as the way to drop it.
+func dependsOnProjectError(entry, project string, entries []Task) error {
+	var members []string
+	for _, task := range entries {
+		if task.Project == project && task.Kind == KindTask {
+			members = append(members, task.Slug)
+		}
+	}
+	if len(members) == 0 {
+		return fmt.Errorf("entry %q depends on project %q, and nothing depends on a project, which has no task member yet: drop the dependency with `lyx board set-deps`", entry, project)
+	}
+	return fmt.Errorf("entry %q depends on project %q, and nothing depends on a project: depend on its members (%s) instead, or drop the dependency with `lyx board set-deps`", entry, project, strings.Join(members, ", "))
+}
diff --git a/internal/boardengine/project_test.go b/internal/boardengine/project_test.go
new file mode 100644
index 000000000..7a0377bbf
--- /dev/null
+++ b/internal/boardengine/project_test.go
@@ -0,0 +1,173 @@
+//go:build tier0
+
+// project_test.go — the project kind's write rules (project.go): what a write may set on a project and its members, through a Board built from a board.yaml.
+
+package boardengine_test
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/configengine"
+)
+
+// newProjectBoard returns a board whose config LoadConfig reads from a board.yaml with the bug and enhancement type labels and the Home.md output, under t.TempDir().
+// configure, when non-nil, edits the loaded config before the board is built, so a test sets the seams it needs.
+func newProjectBoard(t *testing.T, configure func(cfg *boardengine.Config)) *boardengine.Board {
+	t.Helper()
+	configDir := writeBoardConfig(t, "readme: Home.md\ndesign_prefix: proposal-\ntypes:\n  bug: Broken\n  enhancement: New\nlabels:\n  undecided: Not decided\n")
+	cfg, err := boardengine.LoadConfig(configengine.Dirs{Board: configDir}, "board")
+	if err != nil {
+		t.Fatalf("LoadConfig() error = %v; want nil", err)
+	}
+	cfg.Path = t.TempDir()
+	cfg.SkipGit = true
+	cfg.Clock = func() time.Time { return time.Date(2026, 10, 1, 8, 0, 0, 0, time.UTC) }
+	if configure != nil {
+		configure(&cfg)
+	}
+	return boardengine.New(cfg)
+}
+
+// seedBoardJSON writes a board.json holding entries into the board directory of b's config, which only a stored state can hold when no upsert key reaches it.
+func seedBoardJSON(t *testing.T, boardPath string, entries ...string) {
+	t.Helper()
+	content := `{"version":1,"entries":[` + strings.Join(entries, ",") + `]}`
+	if err := os.WriteFile(filepath.Join(boardPath, "board.json"), []byte(content), 0o644); err != nil {
+		t.Fatalf("seed board.json: %v", err)
+	}
+}
+
+// TestProjectRules pins that a write setting or changing a task's depends_on to a project is refused naming the project's task members,
+// and that a stored dependency on a project takes any write that leaves it unchanged.
+func TestProjectRules(t *testing.T) {
+	t.Parallel()
+	var boardPath string
+	b := newProjectBoard(t, func(cfg *boardengine.Config) { boardPath = cfg.Path })
+	seedBoardJSON(t, boardPath,
+		`{"id":0,"slug":"proj","title":"Proj","kind":"project","labels":["bug"]}`,
+		`{"id":1,"slug":"member","title":"Member","kind":"task","labels":["bug"],"project":"proj"}`,
+		`{"id":2,"slug":"stale","title":"Stale","kind":"task","labels":["bug"],"depends_on":["proj"],"status":"done"}`,
+	)
+
+	writes := []struct {
+		name  string
+		write func() error
+	}{
+		{"an upsert of a new task", func() error {
+			_, err := b.UpsertTask(map[string]any{"slug": "fresh", "kind": "task", "labels": bugLabels, "depends_on": []string{"proj"}})
+			return err
+		}},
+		{"set-deps", func() error {
+			_, err := b.SetDeps("member", []string{"proj"})
+			return err
+		}},
+		{"a batch", func() error {
+			_, err := b.UpsertTasksBatch([]map[string]any{{"slug": "fresh", "kind": "task", "labels": bugLabels, "depends_on": []string{"proj"}}})
+			return err
+		}},
+	}
+	for _, tt := range writes {
+		err := tt.write()
+		if err == nil || !strings.Contains(err.Error(), `"proj"`) || !strings.Contains(err.Error(), "member") || !strings.Contains(err.Error(), "set-deps") {
+			t.Errorf("%s: error = %v; want a refusal naming proj, its member and set-deps", tt.name, err)
+		}
+	}
+	if got, _, err := b.GetTask("fresh"); err != nil || got.Slug != "" {
+		t.Errorf("GetTask(fresh) = %+v, %v; want no entry, since every refused write left the board as it was", got, err)
+	}
+
+	edited, err := b.UpsertTask(map[string]any{"slug": "stale", "body": "a later edit"})
+	if err != nil || edited.Body != "a later edit" {
+		t.Errorf("UpsertTask(stale) = %+v, %v; want the body edit to land, since its depends_on on proj is unchanged", edited, err)
+	}
+}
+
+// newMembershipBoard returns a board holding p1, an open project with the member m and a project member p2.
+// It also holds the done project pd, the run-held project ph, the tasks a and b with no project, and paired, a member of p1 whose pair exists.
+func newMembershipBoard(t *testing.T) *boardengine.Board {
+	t.Helper()
+	var boardPath string
+	b := newProjectBoard(t, func(cfg *boardengine.Config) {
+		boardPath = cfg.Path
+		cfg.PairExists = func(slug string) bool { return slug == "paired" }
+	})
+	seedBoardJSON(t, boardPath,
+		`{"id":0,"slug":"p1","title":"P1","kind":"project","labels":["bug"]}`,
+		`{"id":1,"slug":"p2","title":"P2","kind":"project","labels":["bug"],"project":"p1"}`,
+		`{"id":2,"slug":"pd","title":"Pd","kind":"project","labels":["bug"],"status":"done"}`,
+		`{"id":3,"slug":"ph","title":"Ph","kind":"project","labels":["bug"],"beam":true,"status":"running · Webster"}`,
+		`{"id":4,"slug":"a","title":"A","kind":"task","labels":["bug"]}`,
+		`{"id":5,"slug":"b","title":"B","kind":"task","labels":["bug"]}`,
+		`{"id":6,"slug":"m","title":"M","kind":"task","labels":["bug"],"project":"p1"}`,
+		`{"id":7,"slug":"paired","title":"Paired","kind":"task","labels":["bug"],"project":"p1"}`,
+	)
+	return b
+}
+
+// TestProjectRules_Membership pins each refusal of a write that sets or changes project or order, each naming the entry, the field and the slug at fault,
+// and the writes that pass: a valid membership, a valid order and a done-mark of a project its members still name.
+func TestProjectRules_Membership(t *testing.T) {
+	t.Parallel()
+	refused := []struct {
+		name    string
+		fields  map[string]any
+		wantHas []string
+	}{
+		{"ProjectNamingNoEntry", map[string]any{"slug": "a", "project": "ghost"}, []string{`"a"`, "project", `"ghost"`, "names no entry"}},
+		{"ProjectNamingANonProject", map[string]any{"slug": "a", "project": "b"}, []string{`"a"`, "project", `"b"`, "is not a project"}},
+		{"ProjectNamingItself", map[string]any{"slug": "p1", "project": "p1"}, []string{`"p1"`, "project", "is the entry itself"}},
+		{"ProjectNamingADoneProject", map[string]any{"slug": "a", "project": "pd"}, []string{`"a"`, "project", `"pd"`, "is done"}},
+		{"ProjectNamingARunHeldProject", map[string]any{"slug": "a", "project": "ph"}, []string{`"a"`, "project", `"ph"`, "held by a run"}},
+		{"ProjectChainWithACycle", map[string]any{"slug": "p1", "project": "p2"}, []string{`"p1"`, "project", `"p2"`, "loops back"}},
+		{"OrderNamingAnotherProjectsEntry", map[string]any{"slug": "p1", "order": []string{"m", "a"}}, []string{`"p1"`, "order", `"a"`, "no entry of this project"}},
+		{"OrderNamingAnEntryTwice", map[string]any{"slug": "p1", "order": []string{"m", "m"}}, []string{`"p1"`, "order", `"m"`, "named twice"}},
+		{"ProjectChangeOfAnEntryWithAPair", map[string]any{"slug": "paired", "project": "p2"}, []string{`"paired"`, "lyx batten cancel paired --remove"}},
+	}
+	for _, tt := range refused {
+		t.Run("Refused_"+tt.name, func(t *testing.T) {
+			t.Parallel()
+			b := newMembershipBoard(t)
+			_, err := b.UpsertTask(tt.fields)
+			if err == nil {
+				t.Fatalf("UpsertTask(%v) error = nil; want a refusal", tt.fields)
+			}
+			for _, want := range tt.wantHas {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("UpsertTask(%v) error = %q; want it to contain %q", tt.fields, err, want)
+				}
+			}
+		})
+	}
+
+	t.Run("ValidMembershipAndOrderPass", func(t *testing.T) {
+		t.Parallel()
+		b := newMembershipBoard(t)
+		if _, err := b.UpsertTask(map[string]any{"slug": "a", "project": "p1"}); err != nil {
+			t.Fatalf("UpsertTask(a project p1) error = %v; want nil", err)
+		}
+		project, err := b.UpsertTask(map[string]any{"slug": "p1", "order": []string{"m", "a"}})
+		if err != nil || !slices.Equal(project.Order, []string{"m", "a"}) {
+			t.Errorf("UpsertTask(p1 order) = %+v, %v; want order [m a]", project, err)
+		}
+		if _, err := b.UpsertTasksBatch([]map[string]any{
+			{"slug": "b", "project": "p1"},
+			{"slug": "p1", "order": []string{"b", "m", "a"}},
+		}); err != nil {
+			t.Errorf("UpsertTasksBatch(b into p1, then p1 order) error = %v; want nil, since the batch is judged as one write", err)
+		}
+	})
+
+	t.Run("DoneMarkOfAProjectItsMembersStillNamePasses", func(t *testing.T) {
+		t.Parallel()
+		b := newMembershipBoard(t)
+		if err := b.SetStatus("p1", strPtr("done")); err != nil {
+			t.Errorf("SetStatus(p1, done) error = %v; want nil, since no member's project changed", err)
+		}
+	})
+}
