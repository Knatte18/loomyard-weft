@@ -0,0 +1,29 @@
+//go:build tier1
+
+// create_integration_test.go runs "lyx beam create" through RunCLIIn over a hubforge hub, from a marked beam's anchor.
+
+package beamcli_test
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/beamcli"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/testkit/boardkit"
+	"github.com/Knatte18/loomyard/internal/testkit/envelope"
+)
+
+func TestCreate_RunsFromABeamAndReachesTheVerbsOwnRefusal(t *testing.T) {
+	t.Parallel()
+
+	boardkit.InstallReplay(t)
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	hubforge.AddPairWith(t, h, "b", fabricengine.AddOptions{SkipPush: true, Beam: true})
+
+	var out bytes.Buffer
+	beamcli.RunCLIIn(h.PairCodeWorktree("b"), &out, []string{"create", "ghost"})
+
+	envelope.RequireErr(t, out.String(), "not a project entry")
+}
diff --git a/internal/beamcli/create_test.go b/internal/beamcli/create_test.go
new file mode 100644
index 000000000..9c045fb88
--- /dev/null
+++ b/internal/beamcli/create_test.go
@@ -0,0 +1,255 @@
+//go:build tier0
+
+// create_test.go drives the create sequence over fake deps: each refusal with its text, a fresh create running its four steps in order, and a re-run finishing only the steps whose result is not yet there.
+
+package beamcli
+
+import (
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+const (
+	here  = "here"
+	there = "there"
+)
+
+// createWorld is the fake hub every createDeps seam reads and writes, and the log of the calls that changed it.
+type createWorld struct {
+	owners   boardengine.Owners
+	beams    map[string]string
+	pairs    map[string]bool
+	marked   map[string]bool
+	onOrigin map[string]bool
+	lost     map[string]string
+	addOpts  fabricengine.AddOptions
+	calls    []string
+}
+
+// newCreateWorld returns a hub owned by here with a grouping project, a beam project owned by there, a task, a note and a done project.
+func newCreateWorld() *createWorld {
+	return &createWorld{
+		owners: boardengine.Owners{Prime: here, Entries: map[string]boardengine.OwnerEntry{
+			"group":  {IsProject: true},
+			"theirs": {IsProject: true, Beam: true, Owner: there},
+			"task1":  {IsTask: true},
+			"note1":  {},
+			"old":    {IsProject: true, Done: true},
+		}},
+		beams:    map[string]string{},
+		pairs:    map[string]bool{},
+		marked:   map[string]bool{},
+		onOrigin: map[string]bool{},
+	}
+}
+
+func (w *createWorld) deps() createDeps {
+	return createDeps{
+		Machine:    func() (string, error) { return here, nil },
+		ReadOwners: func() (boardengine.Owners, error) { return w.owners, nil },
+		ParentOf:   func(string) (string, error) { return "", nil },
+		ParentBeam: func(slug string) (string, error) { return w.beams[slug], nil },
+		PairPresent: func(slug string) bool {
+			return w.pairs[slug]
+		},
+		BranchOnOrigin: func(slug string) (bool, error) { return w.onOrigin[slug], nil },
+		SetOwners: func(req boardengine.OwnerRequest) (boardengine.OwnerWrite, error) {
+			w.calls = append(w.calls, "owner")
+			slug := req.Slugs[0]
+			if owner, lost := w.lost[slug]; lost {
+				return boardengine.OwnerWrite{Lost: map[string]string{slug: owner}}, nil
+			}
+			entry := w.owners.Entries[slug]
+			entry.Owner, entry.Beam = req.Machine, req.Beam
+			if req.ToProject {
+				entry.IsProject, entry.IsTask = true, false
+			}
+			w.owners.Entries[slug] = entry
+			return boardengine.OwnerWrite{Recorded: []string{slug}}, nil
+		},
+		AddPair: func(slug string, opts fabricengine.AddOptions) (fabricengine.AddResult, error) {
+			w.calls = append(w.calls, "add")
+			w.addOpts = opts
+			w.pairs[slug], w.marked[slug] = true, opts.Beam
+			return fabricengine.AddResult{}, nil
+		},
+		MarkBeam: func(_ *fabricengine.Mutations, slug string) (bool, error) {
+			if w.marked[slug] {
+				return false, nil
+			}
+			w.calls = append(w.calls, "mark")
+			w.marked[slug] = true
+			return true, nil
+		},
+		SpawnPush: func(string) error {
+			w.calls = append(w.calls, "push")
+			return nil
+		},
+		RegenerateWorkspace: func(*fabricengine.Mutations) (string, error) {
+			w.calls = append(w.calls, "workspace")
+			return "/hub/repo.code-workspace", nil
+		},
+		WorktreePath: func(slug string) string { return "/hub/" + slug },
+		HubPath:      "/hub",
+	}
+}
+
+func TestCreate(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name  string
+		slug  string
+		setup func(w *createWorld)
+		// wantErr is empty for a create that finishes, else every substring the refusal names.
+		wantErr   []string
+		wantCalls []string
+		wantAdd   fabricengine.AddOptions
+	}{
+		{name: "AbsentEntryRefused", slug: "ghost", wantErr: []string{"lyx board upsert", "project"}},
+		{name: "NoteRefused", slug: "note1", wantErr: []string{"lyx board upsert", "project"}},
+		{name: "TaskRefused", slug: "task1", wantErr: []string{"lyx beam promote task1"}},
+		{name: "DoneProjectRefused", slug: "old", wantErr: []string{"done", "new project entry"}},
+		{name: "BeamOwnedElsewhereRefused", slug: "theirs", wantErr: []string{there, "lyx beam create theirs", "lyx adopt theirs"}},
+		{
+			name:      "FreshCreateRunsTheFourStepsInOrder",
+			slug:      "group",
+			wantCalls: []string{"owner", "add", "push", "workspace"},
+			wantAdd:   fabricengine.AddOptions{Beam: true},
+		},
+		{
+			name: "NestedBeamForksFromItsParentBeam",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.beams["group"] = "outer"
+				w.pairs["outer"] = true
+			},
+			wantCalls: []string{"owner", "add", "push", "workspace"},
+			wantAdd:   fabricengine.AddOptions{Parent: "outer", Beam: true},
+		},
+		{
+			name: "RerunAfterTheOwnerStepSkipsIt",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.owners.Entries["group"] = boardengine.OwnerEntry{IsProject: true, Beam: true, Owner: here}
+			},
+			wantCalls: []string{"add", "push", "workspace"},
+			wantAdd:   fabricengine.AddOptions{Beam: true},
+		},
+		{
+			name: "RerunAfterThePairStepAddsNoSecondPair",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.owners.Entries["group"] = boardengine.OwnerEntry{IsProject: true, Beam: true, Owner: here}
+				w.pairs["group"], w.marked["group"] = true, true
+			},
+			wantCalls: []string{"push", "workspace"},
+		},
+		{
+			name: "BeamProjectWithNoOwnerGetsOneAndItsPair",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.owners.Entries["group"] = boardengine.OwnerEntry{IsProject: true, Beam: true}
+			},
+			wantCalls: []string{"owner", "add", "push", "workspace"},
+			wantAdd:   fabricengine.AddOptions{Beam: true},
+		},
+		{
+			name: "UnmarkedPairIsMarkedAndNotAdded",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.pairs["group"] = true
+			},
+			wantCalls: []string{"owner", "mark", "push", "workspace"},
+		},
+		{
+			name: "ParentBeamAbsentOffOriginNamesItsCreate",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.beams["group"] = "outer"
+			},
+			wantErr:   []string{"outer", "lyx beam create outer"},
+			wantCalls: []string{"owner"},
+		},
+		{
+			name: "ParentBeamAbsentOnOriginNamesItsAdopt",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.beams["group"] = "outer"
+				w.onOrigin["outer"] = true
+			},
+			// The owner write comes first, and the refusal stops the pair step.
+			wantErr:   []string{"outer", "lyx adopt outer"},
+			wantCalls: []string{"owner"},
+		},
+		{
+			name: "OwnerWriteLostToAnotherMachineStopsTheCreate",
+			slug: "group",
+			setup: func(w *createWorld) {
+				w.lost = map[string]string{"group": there}
+			},
+			wantErr:   []string{there, "lyx adopt group"},
+			wantCalls: []string{"owner"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newCreateWorld()
+			if tt.setup != nil {
+				tt.setup(w)
+			}
+
+			got, err := create(w.deps(), tt.slug)
+
+			if len(tt.wantErr) > 0 {
+				if err == nil {
+					t.Fatalf("create(%q) = nil; want a refusal naming %v", tt.slug, tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("create(%q) error = %q; want it to name %q", tt.slug, err.Error(), want)
+					}
+				}
+				if !slices.Equal(w.calls, tt.wantCalls) {
+					t.Errorf("create(%q) ran %v; want %v", tt.slug, w.calls, tt.wantCalls)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("create(%q) = %v; want it to finish", tt.slug, err)
+			}
+			if !slices.Equal(w.calls, tt.wantCalls) {
+				t.Errorf("create(%q) ran %v; want %v", tt.slug, w.calls, tt.wantCalls)
+			}
+			if slices.Contains(tt.wantCalls, "add") && (w.addOpts.Parent != tt.wantAdd.Parent || w.addOpts.Beam != tt.wantAdd.Beam) {
+				t.Errorf("create(%q) added the pair with %+v; want %+v", tt.slug, w.addOpts, tt.wantAdd)
+			}
+			if got.Worktree != "/hub/"+tt.slug || !strings.Contains(got.WayForward, "lyx orch start") || !strings.Contains(got.WayForward, got.Worktree) {
+				t.Errorf("create(%q) envelope = %+v; want the beam's worktree and `lyx orch start` there", tt.slug, got)
+			}
+		})
+	}
+}
+
+func TestCreate_StepFailureNamesTheRerun(t *testing.T) {
+	t.Parallel()
+
+	w := newCreateWorld()
+	deps := w.deps()
+	deps.SpawnPush = func(string) error { return errors.New("spawn failed") }
+
+	got, err := create(deps, "group")
+
+	if err == nil || !strings.Contains(err.Error(), "spawn failed") || !strings.Contains(err.Error(), "lyx beam create group") {
+		t.Fatalf("create = %v; want the push failure and a re-run of `lyx beam create group`", err)
+	}
+	if !got.OwnerRecorded || !got.PairAdded || got.PushSpawned {
+		t.Errorf("result = %+v; want the owner and the pair done and no push", got)
+	}
+}
diff --git a/internal/beamcli/deps.go b/internal/beamcli/deps.go
new file mode 100644
index 000000000..2c044afeb
--- /dev/null
+++ b/internal/beamcli/deps.go
@@ -0,0 +1,133 @@
+// deps.go fills the verbs' deps over a real hub: the board reads and the owner write, the pair add, mark and records reset, the pair's push, the run's end and clear, and the workspace regeneration.
+
+package beamcli
+
+import (
+	"context"
+	"os"
+
+	"github.com/Knatte18/loomyard/internal/battencli"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/machinename"
+)
+
+// hubCreateDeps fills createDeps over the hub the prime belongs to.
+func hubCreateDeps(prime *lyxcwd.Location) (createDeps, error) {
+	config, err := fabricengine.LoadConfig(fabricengine.ConfigDirs(prime))
+	if err != nil {
+		return createDeps{}, err
+	}
+	topology := fabricengine.NewTopology(config)
+	boardDir := fabricengine.BoardDir(prime.HubPath)
+
+	return createDeps{
+		Machine:    machinename.Name,
+		ReadOwners: func() (boardengine.Owners, error) { return boardengine.ReadOwners(boardDir) },
+		ParentOf: func(slug string) (string, error) {
+			return hubgeom.ParentOf(prime, slug)
+		},
+		ParentBeam: func(slug string) (string, error) {
+			tasks, err := boardengine.ReadTasks(boardDir)
+			if err != nil {
+				return "", err
+			}
+			return boardengine.ParentBeam(tasks, slug), nil
+		},
+		PairPresent: func(slug string) bool { return pairWorktreePresent(prime, slug) },
+		BranchOnOrigin: func(slug string) (bool, error) {
+			return topology.TaskBranchOnOrigin(prime, slug)
+		},
+		SetOwners: func(req boardengine.OwnerRequest) (boardengine.OwnerWrite, error) {
+			return boardengine.SetOwners(boardDir, req)
+		},
+		AddPair: func(slug string, opts fabricengine.AddOptions) (fabricengine.AddResult, error) {
+			return topology.Add(prime, slug, opts)
+		},
+		MarkBeam: func(rec *fabricengine.Mutations, slug string) (bool, error) {
+			return fabricengine.MarkBeam(rec, prime, slug)
+		},
+		SpawnPush: func(slug string) error {
+			return spawnPairPush(prime, slug)
+		},
+		RegenerateWorkspace: func(rec *fabricengine.Mutations) (string, error) {
+			return fabricengine.RegenerateHubWorkspace(rec, prime)
+		},
+		WorktreePath: func(slug string) string { return fabricengine.WorktreePath(prime, slug) },
+		HubPath:      prime.HubPath,
+	}, nil
+}
+
+// hubPromoteDeps fills promoteDeps over the hub the prime belongs to.
+func hubPromoteDeps(prime *lyxcwd.Location) (promoteDeps, error) {
+	create, err := hubCreateDeps(prime)
+	if err != nil {
+		return promoteDeps{}, err
+	}
+	return promoteDeps{
+		createDeps: create,
+		ReadTasks: func() ([]boardengine.Task, error) {
+			return boardengine.ReadTasks(fabricengine.BoardDir(prime.HubPath))
+		},
+		OriginRecord: func(slug string) (fabricengine.Origin, bool, error) {
+			return fabricengine.ReadOriginFor(prime, slug)
+		},
+		EndRun: func(ctx context.Context, slug string) error {
+			return battencli.EndRunForPromote(ctx, prime, slug)
+		},
+		ClearRun: func(ctx context.Context, slug string) error {
+			return battencli.ClearRunForPromote(ctx, prime, slug)
+		},
+		ResetRecords: func(rec *fabricengine.Mutations, slug string) (fabricengine.ResetRecordsResult, error) {
+			return fabricengine.ResetRecordsToParent(rec, prime, slug)
+		},
+	}, nil
+}
+
+// hubLandDeps fills landDeps over the hub the prime belongs to.
+func hubLandDeps(prime *lyxcwd.Location) (landDeps, error) {
+	primeName, err := fabricengine.PrimeName(prime)
+	if err != nil {
+		return landDeps{}, err
+	}
+	return landDeps{
+		ReadOwners: func() (boardengine.Owners, error) {
+			return boardengine.ReadOwners(fabricengine.BoardDir(prime.HubPath))
+		},
+		PairPresent: func(slug string) bool { return pairWorktreePresent(prime, slug) },
+		OriginRecord: func(slug string) (fabricengine.Origin, bool, error) {
+			return fabricengine.ReadOriginFor(prime, slug)
+		},
+		ParentWorktree: func(slug string) (string, error) {
+			origin, found, err := fabricengine.ReadOriginFor(prime, slug)
+			if err != nil {
+				return "", err
+			}
+			if found && origin.ParentWorktree != "" {
+				return origin.ParentWorktree, nil
+			}
+			return primeName, nil
+		},
+		Refusal: func(slug string) error { return battencli.BeamLandRefusal(prime, slug) },
+		StartLanding: func(slug string) (map[string]any, error) {
+			return battencli.ResumeInWindow(prime, slug)
+		},
+	}, nil
+}
+
+// pairWorktreePresent reports whether this machine holds the worktree of slug's pair.
+func pairWorktreePresent(prime *lyxcwd.Location, slug string) bool {
+	info, err := os.Stat(fabricengine.WorktreePath(prime, slug))
+	return err == nil && info.IsDir()
+}
+
+// spawnPairPush launches the detached push of slug's pair, resolved from the prime's hub.
+func spawnPairPush(prime *lyxcwd.Location, slug string) error {
+	pair, err := lyxcwd.ResolveWorktree(fabricengine.WorktreePath(prime, slug))
+	if err != nil {
+		return err
+	}
+	return fabricengine.SpawnPairPush(pair)
+}
diff --git a/internal/beamcli/doc.go b/internal/beamcli/doc.go
new file mode 100644
index 000000000..7431f79ea
--- /dev/null
+++ b/internal/beamcli/doc.go
@@ -0,0 +1,71 @@
+// Package beamcli is the beam module: `lyx beam create <slug>`, the making of a beam from a board project entry, `lyx beam promote <slug>`, the turning of a spawned task into one, and `lyx beam land <slug>`, the landing of a beam into its parent.
+// It only calls each owning module's function in-process, so no module learns another's state, and it has no engine package of its own.
+//
+// # The verbs
+//
+// Every verb resolves its location through `battencli.ResolveBattenPrime`, so it runs from the hub's prime and from any beam, and acts on the prime's location.
+// The module is hub-only, so it declares no `cliwire.Module`.
+// A verb's seams are a deps struct that `hubCreateDeps` fills over the hub and `TestCreate` fakes.
+//
+// # create
+//
+// `create <slug>` takes an existing project entry that is not done, whose `beam` is false, or whose `beam` is true and whose effective owner is this machine or none.
+// The project's title, brief and labels are board writing, so the verb makes no entry.
+// It refuses an absent entry or a note (naming `lyx board upsert` of a project entry), a task (naming `lyx beam promote`), a done project, and a beam another machine owns (naming the owner, `lyx beam create` there and `lyx adopt`).
+//
+// The steps run in order, each skipped when its result is already there, so a re-run finishes a stopped create:
+//
+//  1. `boardengine.SetOwners` records this machine as the owner with the beam flag.
+//  2. `Topology.Add` makes the pair from the prime, or from the parent beam `boardengine.ParentBeam` names for a nested beam, with the beam mark in the same origin commit; an existing pair gets the mark through `fabricengine.MarkBeam`.
+//     A parent beam whose pair is absent here is refused naming `lyx beam create <parent>`, or `lyx adopt <parent>` when its branch is on origin.
+//  3. `fabricengine.SpawnPairPush` spawns the pair's push.
+//  4. `fabricengine.RegenerateHubWorkspace` rewrites the workspace files.
+//
+// Writing the flag first makes a member started mid-create stop at Worktree-Create and resume into the beam rather than fork from the prime for good.
+// Members already spawned under the grouping project keep the prime as their parent.
+// The envelope names the beam's worktree and `lyx orch start` there as the way to give it an orch; the verb starts none.
+//
+// # promote
+//
+// `promote <slug>` turns a spawned task into a beam, keeping its pair and the commits on its branch.
+// On a project whose `beam` is false it runs create's steps, and on a project whose `beam` is true and whose pair carries the mark it finishes the workspace step.
+// It refuses, each with its way forward:
+//   - a task never started, holding no owner and no run status, naming a new project entry through `lyx board upsert` and `lyx beam create` on it;
+//   - a started task with no pair on this machine, and a task another machine owns, naming `lyx adopt`;
+//   - a task whose run has passed Finalize's parent-side merge, naming `lyx batten run`, which the end of the run's own refusal says;
+//   - a task an open task depends on, naming each dependent and `lyx board set-deps`;
+//   - a task whose pair's origin record has an empty parent branch, a root pair made by `lyx fabric add --adopt-local` over the default branch, naming a new project entry and `lyx beam create`.
+//
+// The steps run in order, each skipped when its result is already there, so a re-run after any step finishes the promote:
+//
+//  1. `battencli.EndRunForPromote` ends the task's run processes and strands and keeps its pair, and removes the cancel marker when it ends; an unreachable origin makes it end-only, and promote stops there naming a re-run once origin answers, with no mark written.
+//     The end repeats while the task's claim stands and its pair is unmarked, since ending an ended run changes nothing.
+//  2. `fabricengine.MarkBeam` writes the beam mark into the pair's origin record in one records commit, and the pair's push is spawned.
+//  3. `battencli.ClearRunForPromote` removes the run's records and clears its claim, the rest of a cancel without `--remove`.
+//  4. `fabricengine.ResetRecordsToParent` resets the pair's records content to a fresh fork of its parent's, and the pair's push is spawned when it committed.
+//     Its refusal of uncommitted content outside the record pathspec names the paths and a re-run; promote takes no force flag.
+//  5. `boardengine.SetOwners` records this machine as the owner with `Beam` and `ToProject` in one Bolt write, turning the entry into a beam project and clearing its `depends_on`, `recipe`, `profile` and `run_settings`.
+//  6. `fabricengine.RegenerateHubWorkspace` rewrites the workspace files.
+//
+// Bound: promote ends a running run for good; nothing of the loom run survives in the pair's checkouts but its code commits, and its discussion, plan and run records stay reachable in the records history behind step 4's commit, on the beam's records branch and every member's forked from it.
+// A promote stopped before step 2 leaves the run claimed with its processes ended, as an interrupted cancel does: a resume would restart it, and a re-run of promote ends it again.
+// Batten's start guard refuses a task whose pair carries the mark, naming `lyx beam promote`, so an entry a promote left an open unclaimed task is never started.
+// A hand `lyx loom resume` inside the pair between steps 1 and 4, while its loom seed still stands, restarts the ended run, and a re-run of promote ends it again.
+//
+// # land
+//
+// `land <slug>` ends a beam with a short landing run over batten and the `beam` recipe.
+// It runs from the prime or a beam, and refuses when the acting worktree is the beam itself, since the landing removes the pair, naming the beam's parent worktree as where to run it.
+// It refuses an entry that is not a beam project of this machine with a pair that carries the mark, then applies `battencli.BeamLandRefusal`, then starts the landing with `battencli.ResumeInWindow`, whose window opens in the beam's parent worktree's session.
+//
+// `BeamLandRefusal` refuses, each with its way forward:
+//   - any open entry whose `hubgeom.ParentOf` is the beam, through any depth of grouping projects, naming landing it, `lyx batten cancel <slug> --remove`, or, for an entry with no pair, moving its `project` off the beam;
+//   - any local pair whose origin record names the beam as its parent worktree, naming `lyx batten run` and `lyx batten cancel --remove`;
+//   - the beam's orch strand live, or its watcher live, naming `lyx orch stop` in the beam's worktree and a re-run once `lyx orch status` there reports the watcher gone.
+//
+// Batten's start guard applies the same refusal to a project entry, and Worktree-Create applies it again after its claim, so a resume or a direct `lyx batten run` cannot skip it and a member added before the claim is caught.
+// The guard also refuses a run of any project entry before the claim unless it is a landable beam: a grouping project, naming `lyx beam create`, and a beam with no local pair, naming `lyx beam create` and `lyx adopt`.
+// A marked beam pair passes the guard's dirty-source and left-pair checks, so the landing reaches Worktree-Create, which finds the pair complete and skips; a landing forks no pair, and Worktree-Create never calls `Add` for a project.
+//
+// Bound: a pair on another machine whose origin names the beam is not seen when its entry no longer names the beam, as for a pair made by hand there with `--parent <beam>` and no board entry.
+package beamcli
diff --git a/internal/beamcli/land.go b/internal/beamcli/land.go
new file mode 100644
index 000000000..5c0cdce45
--- /dev/null
+++ b/internal/beamcli/land.go
@@ -0,0 +1,83 @@
+// land.go is the "lyx beam land" sequence: it judges the named beam, applies the refusal that stops a landing while work remains under it, and starts the landing run in a window.
+
+package beamcli
+
+import (
+	"fmt"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// landDeps holds the seam of every land step, which hubLandDeps fills over the hub and TestLand fakes.
+// ParentWorktree names the worktree the beam's pair was forked from, the prime's name when its record names none.
+// Refusal is the landing's refusal of a beam with work remaining under it.
+// StartLanding runs "lyx batten run <slug> --window" and returns the envelope that verb prints.
+type landDeps struct {
+	ReadOwners     func() (boardengine.Owners, error)
+	PairPresent    func(slug string) bool
+	OriginRecord   func(slug string) (fabricengine.Origin, bool, error)
+	ParentWorktree func(slug string) (string, error)
+	Refusal        func(slug string) error
+	StartLanding   func(slug string) (map[string]any, error)
+}
+
+// land starts the landing of the beam slug from the worktree named acting, and returns the envelope of the landing run's start.
+// The beam's pair is removed by the landing, so the verb refuses to run from inside the beam itself.
+func land(deps landDeps, acting, slug string) (map[string]any, error) {
+	if acting == slug {
+		parent, err := deps.ParentWorktree(slug)
+		if err != nil {
+			return nil, fmt.Errorf("lyx beam land: read the parent worktree of %s: %w", slug, err)
+		}
+		return nil, fmt.Errorf("lyx beam land: %s is the beam itself, and its landing removes the pair this verb runs in; way forward: run `lyx beam land %s` from its parent worktree %s", slug, slug, parent)
+	}
+
+	owners, err := deps.ReadOwners()
+	if err != nil {
+		return nil, fmt.Errorf("lyx beam land: read the board's owners: %w", err)
+	}
+	if err := judgeLandEntry(deps, owners, slug); err != nil {
+		return nil, err
+	}
+	if err := deps.Refusal(slug); err != nil {
+		return nil, err
+	}
+
+	envelope, err := deps.StartLanding(slug)
+	if err != nil {
+		return nil, fmt.Errorf("lyx beam land: start the landing run of %s: %w; way forward: fix the cause it names, then run `lyx beam land %s` again", slug, err, slug)
+	}
+	if ok, _ := envelope["ok"].(bool); !ok {
+		return envelope, fmt.Errorf("lyx beam land: the landing run of %s did not start: %v; way forward: fix the cause it names, then run `lyx beam land %s` again", slug, envelope["error"], slug)
+	}
+	return envelope, nil
+}
+
+// judgeLandEntry refuses the entry slug unless it is a beam project that is not done and whose pair is here, marked.
+func judgeLandEntry(deps landDeps, owners boardengine.Owners, slug string) error {
+	entry, held := owners.Entries[slug]
+	switch {
+	case !held || (!entry.IsTask && !entry.IsProject):
+		return fmt.Errorf("lyx beam land: %q is not a beam, as an absent entry or a note is not; way forward: `lyx board list` shows the entries", slug)
+	case entry.IsTask:
+		return fmt.Errorf("lyx beam land: %q is a task, not a beam; way forward: land a task with `lyx batten run %s`, or make it a beam with `lyx beam promote %s`", slug, slug, slug)
+	case entry.Done:
+		return fmt.Errorf("lyx beam land: the beam %q is done and already landed", slug)
+	case !entry.Beam:
+		return fmt.Errorf("lyx beam land: %q is a grouping project, not a beam; way forward: run `lyx beam create %s` to make it a beam", slug, slug)
+	case !deps.PairPresent(slug):
+		return fmt.Errorf("lyx beam land: the beam %s has no pair on this machine; way forward: run `lyx beam create %s` to finish the create, or `lyx adopt %s` when the beam's branch is on origin", slug, slug, slug)
+	}
+	origin, found, err := deps.OriginRecord(slug)
+	if err != nil {
+		return fmt.Errorf("lyx beam land: read the origin record of %s: %w", slug, err)
+	}
+	if !found {
+		return fmt.Errorf("lyx beam land: the pair of the beam %s has no readable origin record; way forward: run `lyx fabric reconcile` to restore its records worktree, then `lyx beam land %s`", slug, slug)
+	}
+	if !origin.Beam {
+		return fmt.Errorf("lyx beam land: the pair of %s does not carry the beam mark; way forward: run `lyx beam create %s`, which marks it", slug, slug)
+	}
+	return nil
+}
diff --git a/internal/beamcli/land_test.go b/internal/beamcli/land_test.go
new file mode 100644
index 000000000..92c4b6c16
--- /dev/null
+++ b/internal/beamcli/land_test.go
@@ -0,0 +1,184 @@
+//go:build tier0
+
+// land_test.go drives the land sequence over fake deps: the refusal from inside the beam, the entries that are not a landable beam, the work-remaining refusal passed through, and the window run started on a clean beam.
+
+package beamcli
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// landWorld is the fake hub every landDeps seam reads, and the log of the landing runs started.
+type landWorld struct {
+	owners     boardengine.Owners
+	pairs      map[string]bool
+	origins    map[string]fabricengine.Origin
+	refusal    error
+	envelope   map[string]any
+	startErr   error
+	started    []string
+	refusedFor []string
+}
+
+// newLandWorld returns a hub with a beam "b" whose pair is here and marked, forked from the worktree "outer", and a task, a grouping project and a done beam.
+func newLandWorld() *landWorld {
+	return &landWorld{
+		owners: boardengine.Owners{Prime: here, Entries: map[string]boardengine.OwnerEntry{
+			"b":      {IsProject: true, Beam: true, Owner: here},
+			"task1":  {IsTask: true},
+			"group":  {IsProject: true},
+			"landed": {IsProject: true, Beam: true, Done: true},
+			"note1":  {},
+		}},
+		pairs:    map[string]bool{"b": true, "landed": true},
+		origins:  map[string]fabricengine.Origin{"b": {ParentWorktree: "outer", Beam: true}, "landed": {Beam: true}},
+		envelope: map[string]any{"ok": true, "window": "batten:b"},
+	}
+}
+
+func (w *landWorld) deps() landDeps {
+	return landDeps{
+		ReadOwners:  func() (boardengine.Owners, error) { return w.owners, nil },
+		PairPresent: func(slug string) bool { return w.pairs[slug] },
+		OriginRecord: func(slug string) (fabricengine.Origin, bool, error) {
+			origin, found := w.origins[slug]
+			return origin, found, nil
+		},
+		ParentWorktree: func(slug string) (string, error) { return w.origins[slug].ParentWorktree, nil },
+		Refusal: func(slug string) error {
+			w.refusedFor = append(w.refusedFor, slug)
+			return w.refusal
+		},
+		StartLanding: func(slug string) (map[string]any, error) {
+			w.started = append(w.started, slug)
+			return w.envelope, w.startErr
+		},
+	}
+}
+
+func TestLand(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name   string
+		acting string
+		slug   string
+		setup  func(w *landWorld)
+		// wantErr is empty for a landing that starts, else every substring the refusal names.
+		wantErr []string
+		// wantRefusalRead says the work-remaining refusal was applied.
+		wantRefusalRead bool
+		wantStarted     bool
+	}{
+		{
+			name:    "FromInsideTheBeamRefusedNamingTheParentWorktree",
+			acting:  "b",
+			slug:    "b",
+			wantErr: []string{"the beam itself", "lyx beam land b", "outer"},
+		},
+		{name: "AbsentEntryRefused", acting: "prime", slug: "ghost", wantErr: []string{"not a beam", "lyx board list"}},
+		{name: "NoteRefused", acting: "prime", slug: "note1", wantErr: []string{"not a beam"}},
+		{name: "TaskRefusedNamingItsOwnLanding", acting: "prime", slug: "task1", wantErr: []string{"lyx batten run task1", "lyx beam promote task1"}},
+		{name: "GroupingProjectRefusedNamingCreate", acting: "prime", slug: "group", wantErr: []string{"grouping project", "lyx beam create group"}},
+		{name: "DoneBeamRefused", acting: "prime", slug: "landed", wantErr: []string{"already landed"}},
+		{
+			name:   "BeamWithNoPairHereRefusedNamingCreateAndAdopt",
+			acting: "prime",
+			slug:   "b",
+			setup: func(w *landWorld) {
+				w.pairs["b"] = false
+			},
+			wantErr: []string{"no pair on this machine", "lyx beam create b", "lyx adopt b"},
+		},
+		{
+			name:   "PairWithNoOriginRecordRefusedNamingReconcile",
+			acting: "prime",
+			slug:   "b",
+			setup: func(w *landWorld) {
+				delete(w.origins, "b")
+			},
+			wantErr: []string{"lyx fabric reconcile"},
+		},
+		{
+			name:   "UnmarkedPairRefusedNamingCreate",
+			acting: "prime",
+			slug:   "b",
+			setup: func(w *landWorld) {
+				w.origins["b"] = fabricengine.Origin{ParentWorktree: "outer"}
+			},
+			wantErr: []string{"beam mark", "lyx beam create b"},
+		},
+		{
+			name:   "WorkRemainingRefusalPassesThroughAndStartsNothing",
+			acting: "prime",
+			slug:   "b",
+			setup: func(w *landWorld) {
+				w.refusal = errors.New("the open entry m is a member of the beam")
+			},
+			wantErr:         []string{"the open entry m is a member of the beam"},
+			wantRefusalRead: true,
+		},
+		{
+			name:            "CleanBeamStartsTheWindowRun",
+			acting:          "prime",
+			slug:            "b",
+			wantRefusalRead: true,
+			wantStarted:     true,
+		},
+		{
+			name:            "LandsFromAnotherBeam",
+			acting:          "sibling",
+			slug:            "b",
+			wantRefusalRead: true,
+			wantStarted:     true,
+		},
+		{
+			name:   "RefusedWindowRunNamesTheRerun",
+			acting: "prime",
+			slug:   "b",
+			setup: func(w *landWorld) {
+				w.envelope = map[string]any{"ok": false, "error": "a hub pause covers the prime"}
+			},
+			wantErr:         []string{"a hub pause covers the prime", "lyx beam land b"},
+			wantRefusalRead: true,
+			wantStarted:     true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newLandWorld()
+			if tt.setup != nil {
+				tt.setup(w)
+			}
+
+			got, err := land(w.deps(), tt.acting, tt.slug)
+
+			if len(tt.wantErr) > 0 {
+				if err == nil {
+					t.Fatalf("land(%q, %q) = nil; want a refusal naming %v", tt.acting, tt.slug, tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("land(%q, %q) error = %q; want it to name %q", tt.acting, tt.slug, err.Error(), want)
+					}
+				}
+			} else if err != nil {
+				t.Fatalf("land(%q, %q) = %v; want the window run started", tt.acting, tt.slug, err)
+			} else if got["window"] != "batten:b" {
+				t.Errorf("land(%q, %q) envelope = %v; want the window run's envelope", tt.acting, tt.slug, got)
+			}
+			if read := len(w.refusedFor) > 0; read != tt.wantRefusalRead {
+				t.Errorf("land(%q, %q) applied the work-remaining refusal = %v; want %v", tt.acting, tt.slug, read, tt.wantRefusalRead)
+			}
+			if started := len(w.started) > 0; started != tt.wantStarted {
+				t.Errorf("land(%q, %q) started a landing = %v; want %v", tt.acting, tt.slug, started, tt.wantStarted)
+			}
+		})
+	}
+}
diff --git a/internal/beamcli/promote.go b/internal/beamcli/promote.go
new file mode 100644
index 000000000..b2d75274d
--- /dev/null
+++ b/internal/beamcli/promote.go
@@ -0,0 +1,229 @@
+// promote.go is the "lyx beam promote" sequence: it judges the named entry, then ends a task's run, marks its pair as a beam, clears the run's records and claim, resets the pair's records to its parent's, turns the entry into a beam project and regenerates the workspace files.
+
+package beamcli
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// promoteDeps holds the seam of every promote step beside create's, which hubPromoteDeps fills over the hub and TestPromote fakes.
+// OriginRecord reads the origin record of the slug's pair, false when there is none.
+// EndRun ends the slug's batten run and keeps its pair, and ClearRun removes the run's records and clears its claim.
+type promoteDeps struct {
+	createDeps
+	ReadTasks    func() ([]boardengine.Task, error)
+	OriginRecord func(slug string) (fabricengine.Origin, bool, error)
+	EndRun       func(ctx context.Context, slug string) error
+	ClearRun     func(ctx context.Context, slug string) error
+	ResetRecords func(rec *fabricengine.Mutations, slug string) (fabricengine.ResetRecordsResult, error)
+}
+
+// promoteResult is the verb's envelope: create's fields for a project it makes a beam of, and for a task what each step did.
+type promoteResult struct {
+	createResult
+	RunEnded     bool `json:"run_ended,omitempty"`
+	RunCleared   bool `json:"run_cleared,omitempty"`
+	RecordsReset bool `json:"records_reset,omitempty"`
+	Promoted     bool `json:"promoted,omitempty"`
+}
+
+// promote turns the entry slug into a beam on this machine, and returns what each step did.
+// A project entry is made a beam by create's steps, or by the workspace step alone when its beam stands with a marked pair.
+// A task goes through the six steps in order, each skipped when its result is already there; the end of the run repeats while the claim stands, since ending an ended run changes nothing.
+func promote(ctx context.Context, deps promoteDeps, slug string) (promoteResult, error) {
+	result := promoteResult{createResult: createResult{Slug: slug, Worktree: deps.WorktreePath(slug)}}
+
+	here, err := deps.Machine()
+	if err != nil {
+		return result, fmt.Errorf("lyx beam promote: read this machine's name: %w", err)
+	}
+	owners, err := deps.ReadOwners()
+	if err != nil {
+		return result, fmt.Errorf("lyx beam promote: read the board's owners: %w", err)
+	}
+	entry := owners.Entries[slug]
+
+	if entry.IsProject {
+		return promoteProject(deps, owners, here, slug, result)
+	}
+	if err := judgePromoteTask(ctx, deps, owners, here, slug); err != nil {
+		return result, err
+	}
+
+	rec := fabricengine.NewMutations(deps.HubPath)
+	finish := func() promoteResult {
+		result.Mutations = rec.Entries()
+		result.Partial = rec.Len() > 0
+		return result
+	}
+	if err := promoteSteps(ctx, deps, rec, entry, here, slug, &result); err != nil {
+		return finish(), err
+	}
+	return finish(), nil
+}
+
+// promoteProject finishes a promote named at a project entry: the workspace step alone for a beam whose pair is marked, create's steps otherwise.
+func promoteProject(deps promoteDeps, owners boardengine.Owners, here, slug string, result promoteResult) (promoteResult, error) {
+	if err := judgeCreateEntry(deps.createDeps, owners, here, slug); err != nil {
+		return result, err
+	}
+	if entry := owners.Entries[slug]; entry.Beam {
+		origin, found, err := deps.OriginRecord(slug)
+		if err != nil {
+			return result, fmt.Errorf("lyx beam promote: read the origin record of %s: %w", slug, err)
+		}
+		if found && origin.Beam {
+			rec := fabricengine.NewMutations(deps.HubPath)
+			workspace, err := deps.RegenerateWorkspace(rec)
+			result.Mutations, result.Partial = rec.Entries(), rec.Len() > 0
+			if err != nil {
+				return result, fmt.Errorf("lyx beam promote: regenerate the workspace files: %w; way forward: fix the cause it names, then run `lyx beam promote %s` again", err, slug)
+			}
+			result.Workspace = workspace
+			result.Promoted = true
+			result.WayForward = orchWayForward(result.Worktree)
+			return result, nil
+		}
+	}
+	created, err := create(deps.createDeps, slug)
+	result.createResult = created
+	return result, err
+}
+
+// judgePromoteTask refuses the entry slug unless it is a started task of this machine, with a pair here, that no open task depends on and whose pair has a parent to reset its records to.
+func judgePromoteTask(ctx context.Context, deps promoteDeps, owners boardengine.Owners, here, slug string) error {
+	entry, held := owners.Entries[slug]
+	switch {
+	case !held:
+		return fmt.Errorf("lyx beam promote: %q is not on the board; way forward: `lyx board list` shows the entries", slug)
+	case !entry.IsTask:
+		return fmt.Errorf("lyx beam promote: %q is a note, and a beam is made from a project entry; way forward: make one with `lyx board upsert` as a project under a slug of its own, then run `lyx beam create` on it", slug)
+	case entry.Done:
+		return fmt.Errorf("lyx beam promote: %q is done and already landed; way forward: make a new project entry with `lyx board upsert` under a slug of its own, then run `lyx beam create` on it", slug)
+	case entry.Owner == "" && !entry.RunHeld:
+		return fmt.Errorf("lyx beam promote: %q was never started, so there is no pair to keep; way forward: make a project entry with `lyx board upsert` under a slug of its own, then run `lyx beam create` on it", slug)
+	}
+	owner, err := owners.Effective(slug, deps.ParentOf)
+	if err != nil {
+		return fmt.Errorf("lyx beam promote: read the owner of %s: %w", slug, err)
+	}
+	if boardengine.OwnedElsewhere(owner, here) {
+		return fmt.Errorf("lyx beam promote: %s is owned by machine %s; way forward: run `lyx adopt %s` to take it over, then `lyx beam promote %s`", slug, owner, slug, slug)
+	}
+	if !deps.PairPresent(slug) {
+		return fmt.Errorf("lyx beam promote: %s has no pair on this machine; way forward: run `lyx adopt %s` to add it, then `lyx beam promote %s`", slug, slug, slug)
+	}
+
+	tasks, err := deps.ReadTasks()
+	if err != nil {
+		return fmt.Errorf("lyx beam promote: read the board for the tasks that depend on %s: %w", slug, err)
+	}
+	if dependents := openDependents(tasks, slug); len(dependents) > 0 {
+		return fmt.Errorf("lyx beam promote: the open tasks %s depend on %s, and a project has nothing depending on it; way forward: drop each dependency with `lyx board set-deps`, then run `lyx beam promote %s`", strings.Join(dependents, ", "), slug, slug)
+	}
+
+	origin, found, err := deps.OriginRecord(slug)
+	if err != nil {
+		return fmt.Errorf("lyx beam promote: read the origin record of %s: %w", slug, err)
+	}
+	if !found {
+		return fmt.Errorf("lyx beam promote: pair %q has no origin record; way forward: run `lyx fabric reconcile` to restore the records worktree, then `lyx beam promote %s`", slug, slug)
+	}
+	if origin.ParentBranch == "" {
+		return fmt.Errorf("lyx beam promote: the pair of %s is a root pair, made by `lyx fabric add --adopt-local` over the default branch, and cannot become a beam; way forward: make a project entry with `lyx board upsert` under a slug of its own, then run `lyx beam create` on it", slug)
+	}
+	return nil
+}
+
+// openDependents lists, sorted, the slugs of the open tasks that depend on slug.
+func openDependents(tasks []boardengine.Task, slug string) []string {
+	var dependents []string
+	for _, task := range tasks {
+		done := task.Status != nil && *task.Status == "done"
+		if task.Kind == boardengine.KindTask && !done && slices.Contains(task.DependsOn, slug) {
+			dependents = append(dependents, task.Slug)
+		}
+	}
+	slices.Sort(dependents)
+	return dependents
+}
+
+// promoteSteps runs the six steps in order, each skipped when its result stands, and records what it did on result.
+func promoteSteps(ctx context.Context, deps promoteDeps, rec *fabricengine.Mutations, entry boardengine.OwnerEntry, here, slug string, result *promoteResult) error {
+	rerun := "run `lyx beam promote " + slug + "` again"
+	fail := func(step string, err error) error {
+		return fmt.Errorf("lyx beam promote: %s of %s: %w; way forward: fix the cause it names, then %s", step, slug, err, rerun)
+	}
+
+	origin, _, err := deps.OriginRecord(slug)
+	if err != nil {
+		return fail("read the origin record", err)
+	}
+
+	if entry.RunHeld && !origin.Beam {
+		if err := deps.EndRun(ctx, slug); err != nil {
+			return err
+		}
+		result.RunEnded = true
+	}
+
+	if !origin.Beam {
+		marked, err := deps.MarkBeam(rec, slug)
+		if err != nil {
+			return fail("mark the pair as a beam", err)
+		}
+		result.BeamMarked = marked
+		if err := deps.SpawnPush(slug); err != nil {
+			return fail("spawn the push", err)
+		}
+		result.PushSpawned = true
+	}
+
+	if entry.RunHeld {
+		if err := deps.ClearRun(ctx, slug); err != nil {
+			return err
+		}
+		result.RunCleared = true
+	}
+
+	reset, err := deps.ResetRecords(rec, slug)
+	if err != nil {
+		return err
+	}
+	result.RecordsReset = reset.Committed
+	if reset.Committed {
+		if err := deps.SpawnPush(slug); err != nil {
+			return fail("spawn the push", err)
+		}
+		result.PushSpawned = true
+	}
+
+	write, err := deps.SetOwners(boardengine.OwnerRequest{Machine: here, Slugs: []string{slug}, Beam: true, ToProject: true, ParentOf: deps.ParentOf})
+	if err != nil {
+		return fail("turn the entry into a beam project", err)
+	}
+	if owner, lost := write.Lost[slug]; lost {
+		return fmt.Errorf("lyx beam promote: another machine recorded %s as the owner of %s while this write was in flight; way forward: run `lyx adopt %s` to take it over, then `lyx beam promote %s`", owner, slug, slug, slug)
+	}
+	result.OwnerRecorded = true
+	result.Promoted = true
+
+	workspace, err := deps.RegenerateWorkspace(rec)
+	if err != nil {
+		return fail("regenerate the workspace files", err)
+	}
+	result.Workspace = workspace
+	result.WayForward = orchWayForward(result.Worktree)
+	return nil
+}
+
+// orchWayForward names the step that gives a beam its orch, which no verb of the module starts.
+func orchWayForward(worktree string) string {
+	return fmt.Sprintf("run `lyx orch start` in %s to give the beam an orch", worktree)
+}
diff --git a/internal/beamcli/promote_test.go b/internal/beamcli/promote_test.go
new file mode 100644
index 000000000..9db047925
--- /dev/null
+++ b/internal/beamcli/promote_test.go
@@ -0,0 +1,215 @@
+//go:build tier0
+
+// promote_test.go drives the promote sequence over fake deps: each refusal with its text and no step run, the six steps in order for a running task, a re-run finishing the rest after a stop at each step, and a project made a beam by create's steps.
+
+package beamcli
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/battencli"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+)
+
+// promoteWorld is the fake hub of createWorld with the seams promote adds.
+type promoteWorld struct {
+	*createWorld
+	tasks        []boardengine.Task
+	parentBranch map[string]string
+	endErr       error
+	resetCommits bool
+}
+
+// newPromoteWorld returns a hub with a running task "run1" owned by here, its pair present, and the fixtures of newCreateWorld.
+func newPromoteWorld() *promoteWorld {
+	w := &promoteWorld{createWorld: newCreateWorld(), parentBranch: map[string]string{}, resetCommits: true}
+	w.owners.Entries["run1"] = boardengine.OwnerEntry{Owner: here, IsTask: true, RunHeld: true}
+	w.pairs["run1"] = true
+	return w
+}
+
+func (w *promoteWorld) deps() promoteDeps {
+	return promoteDeps{
+		createDeps: w.createWorld.deps(),
+		ReadTasks:  func() ([]boardengine.Task, error) { return w.tasks, nil },
+		OriginRecord: func(slug string) (fabricengine.Origin, bool, error) {
+			parent, set := w.parentBranch[slug]
+			if !set {
+				parent = "main"
+			}
+			return fabricengine.Origin{ParentBranch: parent, Beam: w.marked[slug]}, w.pairs[slug], nil
+		},
+		EndRun: func(context.Context, string) error {
+			w.calls = append(w.calls, "end")
+			return w.endErr
+		},
+		ClearRun: func(context.Context, string) error {
+			w.calls = append(w.calls, "clear")
+			return nil
+		},
+		ResetRecords: func(*fabricengine.Mutations, string) (fabricengine.ResetRecordsResult, error) {
+			w.calls = append(w.calls, "reset")
+			return fabricengine.ResetRecordsResult{Committed: w.resetCommits}, nil
+		},
+	}
+}
+
+func TestPromote(t *testing.T) {
+	t.Parallel()
+
+	open := "active"
+	tests := []struct {
+		name  string
+		slug  string
+		setup func(w *promoteWorld)
+		// wantErr is empty for a promote that finishes, else every substring the refusal names.
+		wantErr   []string
+		wantCalls []string
+	}{
+		{
+			name: "NeverStartedTaskRefusedNamingANewProjectAndItsCreate",
+			slug: "fresh",
+			setup: func(w *promoteWorld) {
+				w.owners.Entries["fresh"] = boardengine.OwnerEntry{IsTask: true}
+			},
+			wantErr: []string{"never started", "lyx board upsert", "lyx beam create"},
+		},
+		{name: "AbsentEntryRefused", slug: "ghost", wantErr: []string{"not on the board", "lyx board list"}},
+		{name: "NoteRefused", slug: "note1", wantErr: []string{"note", "lyx board upsert"}},
+		{
+			name: "TaskAnotherMachineOwnsRefusedNamingAdopt",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.owners.Entries["run1"] = boardengine.OwnerEntry{Owner: there, IsTask: true, RunHeld: true}
+			},
+			wantErr: []string{there, "lyx adopt run1"},
+		},
+		{
+			name: "StartedTaskWithNoPairRefusedNamingAdopt",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.pairs["run1"] = false
+			},
+			wantErr: []string{"no pair on this machine", "lyx adopt run1"},
+		},
+		{
+			name: "TaskAnOpenTaskDependsOnRefusedNamingEachDependent",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.tasks = []boardengine.Task{
+					{Slug: "dep-b", Kind: boardengine.KindTask, DependsOn: []string{"run1"}, Status: &open},
+					{Slug: "dep-a", Kind: boardengine.KindTask, DependsOn: []string{"run1"}},
+				}
+			},
+			wantErr: []string{"dep-a, dep-b", "lyx board set-deps"},
+		},
+		{
+			name: "RootPairRefusedNamingANewProjectAndItsCreate",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.parentBranch["run1"] = ""
+			},
+			wantErr: []string{"root pair", "lyx board upsert", "lyx beam create"},
+		},
+		{
+			name: "RunPastTheParentMergeRefusedBeforeAnyLaterStep",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.endErr = errors.New(`the work of run1 reached its parent; way forward: run "lyx batten run run1" to finish the landing`)
+			},
+			wantErr:   []string{"reached its parent", "lyx batten run run1"},
+			wantCalls: []string{"end"},
+		},
+		{
+			name: "EndOnlyFirstHalfStopsAfterStepOneNamingTheRerun",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.endErr = fmt.Errorf("%w; way forward: run \"lyx beam promote run1\" again once origin answers", battencli.ErrPromoteEndOnly)
+			},
+			wantErr:   []string{`"lyx beam promote run1" again once origin answers`},
+			wantCalls: []string{"end"},
+		},
+		{
+			name:      "RunningTaskRunsTheSixStepsInOrder",
+			slug:      "run1",
+			wantCalls: []string{"end", "mark", "push", "clear", "reset", "push", "owner", "workspace"},
+		},
+		{
+			name: "RerunAfterStepTwoFinishesTheRest",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.marked["run1"] = true
+			},
+			wantCalls: []string{"clear", "reset", "push", "owner", "workspace"},
+		},
+		{
+			name: "RerunAfterStepThreeFinishesTheRest",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.marked["run1"] = true
+				w.owners.Entries["run1"] = boardengine.OwnerEntry{Owner: here, IsTask: true}
+			},
+			wantCalls: []string{"reset", "push", "owner", "workspace"},
+		},
+		{
+			name: "RerunAfterStepFourSpawnsNoPushForAnUnchangedReset",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.marked["run1"] = true
+				w.owners.Entries["run1"] = boardengine.OwnerEntry{Owner: here, IsTask: true}
+				w.resetCommits = false
+			},
+			wantCalls: []string{"reset", "owner", "workspace"},
+		},
+		{
+			name: "RerunAfterStepFiveFinishesTheWorkspaceStepAlone",
+			slug: "run1",
+			setup: func(w *promoteWorld) {
+				w.marked["run1"] = true
+				w.owners.Entries["run1"] = boardengine.OwnerEntry{Owner: here, IsProject: true, Beam: true}
+			},
+			wantCalls: []string{"workspace"},
+		},
+		{
+			name:      "GroupingProjectRunsCreatesSteps",
+			slug:      "group",
+			wantCalls: []string{"owner", "add", "push", "workspace"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			w := newPromoteWorld()
+			if tt.setup != nil {
+				tt.setup(w)
+			}
+
+			got, err := promote(context.Background(), w.deps(), tt.slug)
+
+			if len(tt.wantErr) > 0 {
+				if err == nil {
+					t.Fatalf("promote(%q) = nil; want a refusal naming %v", tt.slug, tt.wantErr)
+				}
+				for _, want := range tt.wantErr {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("promote(%q) error = %q; want it to name %q", tt.slug, err.Error(), want)
+					}
+				}
+			} else if err != nil {
+				t.Fatalf("promote(%q) = %v; want it to finish", tt.slug, err)
+			}
+			if !slices.Equal(w.calls, tt.wantCalls) {
+				t.Errorf("promote(%q) ran %v; want %v", tt.slug, w.calls, tt.wantCalls)
+			}
+			if len(tt.wantErr) == 0 && !strings.Contains(got.WayForward, "lyx orch start") {
