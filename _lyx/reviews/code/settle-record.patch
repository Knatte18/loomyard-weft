+// refusedverb_helper_test.go holds the seeds, fakes and way-forward assertions the tests of every tier in this package share.
+
+package webstercli
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
