+)
+
+// seedBeamBoard seeds h's board with a beam project b holding tasks m and armed, a grouping project g holding task grouped, and a task left, whose local branch the caller leaves behind.
+func seedBeamBoard(t *testing.T, h *hubforge.Hub) {
+	t.Helper()
+	cfg, err := boardengine.LoadConfig(configengine.Dirs{Board: h.BoardDir()}, "board")
+	if err != nil {
+		t.Fatalf("load board config: %v", err)
+	}
+	cfg.Path = h.BoardDir()
+	board := boardengine.New(cfg)
+	entries := []map[string]any{
+		{"slug": "b", "kind": "project"},
+		{"slug": "g", "kind": "project"},
+		{"slug": "m", "kind": "task", "project": "b"},
+		{"slug": "armed", "kind": "task", "project": "b"},
+		{"slug": "left", "kind": "task", "project": "b"},
+		{"slug": "grouped", "kind": "task", "project": "g"},
+	}
+	for _, entry := range entries {
+		entry["title"] = entry["slug"]
+		entry["labels"] = []string{"bug"}
+		if _, err := board.UpsertTask(entry); err != nil {
+			t.Fatalf("seed board entry %v: %v", entry["slug"], err)
+		}
+	}
+	machine, err := machinename.Name()
+	if err != nil {
+		t.Fatalf("machine name: %v", err)
+	}
+	if _, err := boardengine.SetOwners(h.BoardDir(), boardengine.OwnerRequest{Machine: machine, Slugs: []string{"b"}, Beam: true}); err != nil {
+		t.Fatalf("flag b as a beam: %v", err)
+	}
+}
+
+// TestWorktreeCreate_ForksFromTheBeam asserts the create row forks a beam member's pair from the beam while the prime holds tracked dirt, and a task of a grouping project from the prime.
+// A run armed from the beam's own location forks the member from the beam, and a local branch left from a removed pair is refused with ErrBranchExists, since batten never adopts one.
+func TestWorktreeCreate_ForksFromTheBeam(t *testing.T) {
+	t.Parallel()
+
+	boardkit.InstallReplay(t)
+	h := hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	hubforge.AddPairWith(t, h, "b", fabricengine.AddOptions{SkipPush: true, Beam: true})
+	primeName, err := fabricengine.PrimeName(h.Location)
+	if err != nil {
+		t.Fatalf("prime name: %v", err)
+	}
+	seedBeamBoard(t, h)
+	cfg, err := fabricengine.LoadConfig(fabricengine.ConfigDirs(h.Location))
+	if err != nil {
+		t.Fatalf("load the fabric config: %v", err)
+	}
+	mustRunGit(t, h.PrimeWorktree(), "branch", cfg.BranchPrefix+"left")
+
+	readme := filepath.Join(h.PrimeWorktree(), "README")
+	clean, err := os.ReadFile(readme)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(readme, append(clean, "dirt\n"...), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	parentOf := func(t *testing.T, slug string) string {
+		t.Helper()
+		origin, found, err := fabricengine.ReadOriginFor(h.Location, slug)
+		if err != nil || !found {
+			t.Fatalf("read the origin record of %q: found=%v err=%v", slug, found, err)
+		}
+		return origin.ParentWorktree
+	}
+
+	t.Run("MemberForksFromTheBeamWhileThePrimeIsDirty", func(t *testing.T) {
+		c := wireForHub(t, h, "m", nil)
+		if err := c.env.CreateWorktree(context.Background()); err != nil {
+			t.Fatalf("CreateWorktree(m): %v", err)
+		}
+		if got := parentOf(t, "m"); got != "b" {
+			t.Errorf("origin of m names parent worktree %q; want b", got)
+		}
+	})
+
+	t.Run("RunArmedFromTheBeamStillForksTheMemberFromIt", func(t *testing.T) {
+		prime, err := ResolveBattenPrime(resolvePair(t, h, "b"))
+		if err != nil {
+			t.Fatalf("ResolveBattenPrime(b): %v", err)
+		}
+		c := &battenCLI{location: prime}
+		if err := c.wire(prime, "armed"); err != nil {
+			t.Fatalf("wire(armed): %v", err)
+		}
+		if err := c.env.CreateWorktree(context.Background()); err != nil {
+			t.Fatalf("CreateWorktree(armed): %v", err)
+		}
+		if got := parentOf(t, "armed"); got != "b" {
+			t.Errorf("origin of armed names parent worktree %q; want b", got)
+		}
+	})
+
+	t.Run("LocalBranchLeftFromARemovedPairIsRefused", func(t *testing.T) {
+		c := wireForHub(t, h, "left", nil)
+		err := c.env.CreateWorktree(context.Background())
+		var exists *fabricengine.ErrBranchExists
+		if !errors.As(err, &exists) {
+			t.Fatalf("CreateWorktree(left) = %v; want ErrBranchExists", err)
+		}
+	})
+
+	t.Run("TaskOfAGroupingProjectForksFromThePrime", func(t *testing.T) {
+		if err := os.WriteFile(readme, clean, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		c := wireForHub(t, h, "grouped", nil)
+		if err := c.env.CreateWorktree(context.Background()); err != nil {
+			t.Fatalf("CreateWorktree(grouped): %v", err)
+		}
+		if got := parentOf(t, "grouped"); got != primeName {
+			t.Errorf("origin of grouped names parent worktree %q; want the prime %q", got, primeName)
+		}
+	})
+}
diff --git a/internal/battencli/beamfork_test.go b/internal/battencli/beamfork_test.go
new file mode 100644
index 000000000..a15f53a74
--- /dev/null
+++ b/internal/battencli/beamfork_test.go
@@ -0,0 +1,108 @@
+//go:build tier0
+
+// beamfork_test.go covers beamForkPrecondition over told reads: each refusal that stops a beam member's create, the pass, and a probe error.
+
+package battencli
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/battenshed"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+)
+
+// TestBeamForkPrecondition asserts a beam member's create is stopped with a precondition naming the beam's create or adopt when the beam's pair is absent here, and the landing and the cancel of the member when the beam's entry is run-held, and passes otherwise.
+// A failed origin probe is returned as is.
+func TestBeamForkPrecondition(t *testing.T) {
+	t.Parallel()
+
+	held := boardengine.RunStatus("running", "Land")
+	probeErr := errors.New("origin unreachable")
+	tests := []struct {
+		name        string
+		entry       boardengine.Task
+		entryFound  bool
+		pairPresent bool
+		onOrigin    bool
+		probeErr    error
+		// wantUnmet and wantWayForward are substrings of the precondition's two fields; both empty want a pass.
+		wantUnmet      []string
+		wantWayForward []string
+		wantProbeErr   bool
+	}{
+		{
+			name:           "AbsentBeamPairOffOriginNamesTheBeamCreate",
+			entryFound:     true,
+			wantUnmet:      []string{"m belongs to beam b", "pair is not on this machine"},
+			wantWayForward: []string{`"lyx beam create b"`, `"lyx batten run m"`},
+		},
+		{
+			name:           "AbsentBeamPairOnOriginNamesTheAdopt",
+			entryFound:     true,
+			onOrigin:       true,
+			wantUnmet:      []string{"m belongs to beam b"},
+			wantWayForward: []string{`"lyx adopt b"`, `"lyx batten run m"`},
+		},
+		{
+			name:         "OriginProbeErrorIsReturned",
+			entryFound:   true,
+			probeErr:     probeErr,
+			wantProbeErr: true,
+		},
+		{
+			name:           "BeamHeldByItsLandingNamesTheLandingAndTheMembersCancel",
+			entry:          boardengine.Task{Slug: "b", Status: &held},
+			entryFound:     true,
+			pairPresent:    true,
+			wantUnmet:      []string{"m belongs to beam b", "its own landing holds", held},
+			wantWayForward: []string{`"lyx batten status b"`, `"lyx batten cancel m"`},
+		},
+		{
+			name:        "BeamWithItsPairAndNoRunPasses",
+			entry:       boardengine.Task{Slug: "b"},
+			entryFound:  true,
+			pairPresent: true,
+		},
+		{
+			name:        "BeamEntryNotFoundPasses",
+			pairPresent: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			err := beamForkPrecondition("m", "b", tt.entry, tt.entryFound, tt.pairPresent, func() (bool, error) { return tt.onOrigin, tt.probeErr })
+
+			if tt.wantProbeErr {
+				var precondition *battenshed.PreconditionError
+				if !errors.Is(err, probeErr) || errors.As(err, &precondition) {
+					t.Fatalf("beamForkPrecondition() error = %v; want the probe error, not a precondition", err)
+				}
+				return
+			}
+			if len(tt.wantUnmet) == 0 {
+				if err != nil {
+					t.Fatalf("beamForkPrecondition() = %v; want nil", err)
+				}
+				return
+			}
+			var precondition *battenshed.PreconditionError
+			if !errors.As(err, &precondition) {
+				t.Fatalf("beamForkPrecondition() = %v; want a *battenshed.PreconditionError", err)
+			}
+			for _, want := range tt.wantUnmet {
+				if !strings.Contains(precondition.Unmet, want) {
+					t.Errorf("Unmet = %q; want it to carry %q", precondition.Unmet, want)
+				}
+			}
+			for _, want := range tt.wantWayForward {
+				if !strings.Contains(precondition.WayForward, want) {
+					t.Errorf("WayForward = %q; want it to carry %q", precondition.WayForward, want)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/battencli/beamguard_integration_test.go b/internal/battencli/beamguard_integration_test.go
new file mode 100644
index 000000000..fbe9647dc
--- /dev/null
+++ b/internal/battencli/beamguard_integration_test.go
@@ -0,0 +1,196 @@
+//go:build tier1
+
+// beamguard_integration_test.go drives the prime-or-beam guard over a hubforge hub with a marked beam: the guard's verdicts, the batten verbs run through a beam's anchor, and the self-pair refusals.
+
+package battencli
+
+import (
+	"bytes"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/battenrecipe"
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubforge"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/testkit/boardkit"
+	"github.com/Knatte18/loomyard/internal/testkit/envelope"
+)
+
+// beamHub returns a hub with a marked beam "b", a member "m" forked from it, and a pair "p" forked from the prime, with the prime's worktree name.
+func beamHub(t *testing.T) (h *hubforge.Hub, primeName string) {
+	t.Helper()
+	h = hubforge.CopyHub(t, hubforge.Shape{Anchor: "."})
+	hubforge.AddPairWith(t, h, "b", fabricengine.AddOptions{SkipPush: true, Beam: true})
+	hubforge.AddPairWith(t, h, "m", fabricengine.AddOptions{SkipPush: true, Parent: "b"})
+	hubforge.AddPairWith(t, h, "p", fabricengine.AddOptions{SkipPush: true})
+	primeName, err := fabricengine.PrimeName(h.Location)
+	if err != nil {
+		t.Fatalf("prime name: %v", err)
+	}
+	return h, primeName
+}
+
+// resolvePair resolves the code worktree of slug in h.
+func resolvePair(t *testing.T, h *hubforge.Hub, slug string) *lyxcwd.Location {
+	t.Helper()
+	location, err := lyxcwd.ResolveWorktree(h.PairCodeWorktree(slug))
+	if err != nil {
+		t.Fatalf("resolve the worktree of %q: %v", slug, err)
+	}
+	return location
+}
+
+func TestResolveBattenPrime(t *testing.T) {
+	t.Parallel()
+
+	boardkit.InstallReplay(t)
+	h, primeName := beamHub(t)
+	recordsSibling, err := lyxcwd.Resolve(h.PrimeRecords())
+	if err != nil {
+		t.Fatalf("resolve the prime's records sibling: %v", err)
+	}
+
+	tests := []struct {
+		name     string
+		location *lyxcwd.Location
+		// wantErr is empty for an admitted worktree, else every substring the refusal names.
+		wantErr []string
+	}{
+		{"PrimeReturnsItself", h.Location, nil},
+		{"MarkedBeamReturnsThePrime", resolvePair(t, h, "b"), nil},
+		{"PairForkedFromThePrimeNamesThePrime", resolvePair(t, h, "p"), []string{`"p"`, `"` + primeName + `"`}},
+		{"PairForkedFromTheBeamNamesTheBeam", resolvePair(t, h, "m"), []string{`"m"`, `"b"`}},
+		{"PrimesRecordsSiblingIsStillRefused", recordsSibling, []string{"records sibling", "prime worktree or a beam"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := ResolveBattenPrime(tt.location)
+			if len(tt.wantErr) == 0 {
+				if err != nil {
+					t.Fatalf("ResolveBattenPrime(%s) = %v; want it admitted", tt.location.WorktreeName, err)
+				}
+				if got.WorktreeName != primeName {
+					t.Errorf("ResolveBattenPrime(%s) returned %q; want the prime %q", tt.location.WorktreeName, got.WorktreeName, primeName)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatalf("ResolveBattenPrime(%s) = nil; want a refusal", tt.location.WorktreeName)
+			}
+			for _, want := range tt.wantErr {
+				if !strings.Contains(err.Error(), want) {
+					t.Errorf("ResolveBattenPrime(%s) error = %q; want it to name %s", tt.location.WorktreeName, err.Error(), want)
+				}
+			}
+		})
+	}
+
+	t.Run("BeamHeldByItsLandingNamesTheLandingAndItsParent", func(t *testing.T) {
+		seedBoardTask(t, h, "b", "loom")
+		board, err := boardengine.OpenHub(h.Path)
+		if err != nil {
+			t.Fatalf("open the hub board: %v", err)
+		}
+		claim := "running · Land"
+		if err := board.SetStatus("b", &claim); err != nil {
+			t.Fatalf("claim the beam's entry: %v", err)
+		}
+
+		_, err = ResolveBattenPrime(resolvePair(t, h, "b"))
+
+		if err == nil {
+			t.Fatal("ResolveBattenPrime over a beam held by its landing = nil; want a refusal")
+		}
+		for _, want := range []string{"being landed", claim, `"` + primeName + `"`} {
+			if !strings.Contains(err.Error(), want) {
+				t.Errorf("refusal = %q; want it to name %s", err.Error(), want)
+			}
+		}
+	})
+}
+
+func TestVerbs_RunFromABeam(t *testing.T) {
+	t.Parallel()
+
+	boardkit.InstallReplay(t)
+	h, primeName := beamHub(t)
+	const runSlug = "prime-run"
+	const doneSlug = "finished-task"
+	seedCancelRun(t, h, runSlug, battenrecipe.NameWorktreeCreate, shedengine.StateBlocked, "running · Worktree-Create")
+	writeCleanupFile(t, shedrun.StatusFile(h.Location, doneSlug), statusJSON(t, "done"))
+	writeCleanupFile(t, shedrun.SeedFile(h.Location, doneSlug), []byte("{}"))
+	rels := []string{shedrun.SeedRel(h.Location, doneSlug), shedrun.StatusRel(h.Location, doneSlug)}
+	if _, committed, err := fabricengine.CommitAnchoredPaths(fabricengine.NewMutations(""), h.Location, rels, "test: finished run", fabricengine.EnvSyncOptions()); err != nil || !committed {
+		t.Fatalf("commit the finished run: committed=%v err=%v", committed, err)
+	}
+	beamCwd, memberCwd := h.PairCodeWorktree("b"), h.PairCodeWorktree("m")
+
+	run := func(cwd string, args ...string) string {
+		t.Helper()
+		var out bytes.Buffer
+		RunCLIIn(cwd, &out, args)
+		return out.String()
+	}
+
+	t.Run("StatusReadsTheRunSeededAtThePrime", func(t *testing.T) {
+		got := envelope.RequireOK(t, run(beamCwd, "status", runSlug))
+		if got.Raw["state"] != string(shedengine.StateBlocked) || got.Raw["current_producer"] != battenrecipe.NameWorktreeCreate {
+			t.Errorf("status from the beam = %v; want the prime's blocked run at Worktree-Create", got.Raw)
+		}
+	})
+
+	t.Run("ArmingResolvesTheReceiverToThePrime", func(t *testing.T) {
+		c := &battenCLI{}
+		if _, err := c.armAt(resolvePair(t, h, "b"), runSlug, true, "status"); err != nil {
+			t.Fatalf("armAt(status) from the beam = %v; want it admitted", err)
+		}
+		if c.location.WorktreeName != primeName {
+			t.Errorf("receiver location = %q; want the prime %q", c.location.WorktreeName, primeName)
+		}
+		wantStatus := shedrun.StatusFile(h.Location, runSlug)
+		if c.shedPaths.StatusPath != wantStatus {
+			t.Errorf("status path = %q; want it under the prime's anchor at %q", c.shedPaths.StatusPath, wantStatus)
+		}
+		if wantLock := shedrun.StatusLock(h.Location, runSlug); c.shedPaths.StatusLockPath != wantLock {
+			t.Errorf("status lock path = %q; want it under the prime's anchor at %q", c.shedPaths.StatusLockPath, wantLock)
+		}
+	})
+
+	t.Run("CancelOfAnUnknownSlugReachesTheCancelsOwnRefusal", func(t *testing.T) {
+		envelope.RequireErr(t, run(beamCwd, "cancel", "ghost"), "nothing of ghost is left to cancel")
+	})
+
+	t.Run("CleanupListsThePrimesRuns", func(t *testing.T) {
+		got := envelope.RequireOK(t, run(beamCwd, "cleanup"))
+		if removed := stringsOf(t, got.Raw["removed"]); !slices.Equal(removed, []string{doneSlug}) {
+			t.Errorf("cleanup from the beam removed = %v; want the prime's done run [%s]", removed, doneSlug)
+		}
+	})
+
+	t.Run("TheSameVerbsFromAPairForkedFromThePrimeNameThePrime", func(t *testing.T) {
+		pairCwd := h.PairCodeWorktree("p")
+		for _, args := range [][]string{{"status", runSlug}, {"cancel", "ghost"}, {"cleanup"}, {"lock", "list"}} {
+			envelope.RequireErr(t, run(pairCwd, args...), `"`+primeName+`"`)
+		}
+	})
+
+	t.Run("TheSameVerbsFromAPairForkedFromTheBeamNameTheBeam", func(t *testing.T) {
+		envelope.RequireErr(t, run(memberCwd, "status", runSlug), `"b"`)
+	})
+}
+
+func TestCancelCmd_RemoveRefusesFromInsideTheBeam(t *testing.T) {
+	t.Parallel()
+
+	h, primeName := beamHub(t)
+
+	var out bytes.Buffer
+	RunCLIIn(h.PairCodeWorktree("b"), &out, []string{"cancel", "b", "--remove"})
+
+	envelope.RequireErr(t, out.String(), `"`+primeName+`"`)
+}
diff --git a/internal/battencli/beamland.go b/internal/battencli/beamland.go
new file mode 100644
index 000000000..3b1ddc958
--- /dev/null
+++ b/internal/battencli/beamland.go
@@ -0,0 +1,188 @@
+// beamland.go holds the refusal that stops a beam's landing while anything still works under the beam: an open member entry, a local pair forked from it, or its orch.
+
+package battencli
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/Knatte18/loomyard/internal/boardengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/orchcli"
+	"github.com/Knatte18/loomyard/internal/orchengine"
+)
+
+// beamMember is an open board entry whose parent is a beam: Slug names it, and HasPair says whether this machine holds its pair.
+type beamMember struct {
+	Slug    string
+	HasPair bool
+}
+
+// landingSeams carries the reads Worktree-Create makes for a beam's landing, as function values.
+// A nil Project reads every entry as a task, which only a hand-populated receiver has.
+type landingSeams struct {
+	// Project reports whether the slug's board entry is a project.
+	Project func() (bool, error)
+	// Refusal applies BeamLandRefusal to the slug.
+	Refusal func() error
+}
+
+// hubLandingSeams builds the landingSeams over the hub of location.
+func hubLandingSeams(location *lyxcwd.Location, slug string) landingSeams {
+	return landingSeams{
+		Project: func() (bool, error) {
+			owners, err := boardengine.ReadOwners(fabricengine.BoardDir(location.HubPath))
+			if err != nil {
+				return false, err
+			}
+			return owners.Entries[slug].IsProject, nil
+		},
+		Refusal: func() error { return BeamLandRefusal(location, slug) },
+	}
+}
+
+// entryIsProject reports whether the receiver's slug is a project entry, which only a beam's landing runs.
+func (c *battenCLI) entryIsProject() (bool, error) {
+	if c.beam.Project == nil {
+		return false, nil
+	}
+	return c.beam.Project()
+}
+
+// BeamLandRefusal reads what still works under the beam slug and refuses its landing while anything does, naming each way forward.
+// The facts are the beam's open member entries, the local pairs forked from it, and whether its orch strand or watcher is live.
+func BeamLandRefusal(prime *lyxcwd.Location, slug string) error {
+	members, err := beamMembers(prime, slug)
+	if err != nil {
+		return err
+	}
+	childPairs, err := beamChildPairs(prime, slug)
+	if err != nil {
+		return err
+	}
+	orchLive, watcherLive, err := beamOrchLive(prime, slug)
+	if err != nil {
+		return err
+	}
+	return beamLandRefusal(slug, members, childPairs, orchLive, watcherLive)
+}
+
+// beamLandRefusal judges the facts BeamLandRefusal read and words one refusal naming every blocker with its way forward, or returns nil when none stands.
+func beamLandRefusal(slug string, members []beamMember, childPairs []string, orchLive, watcherLive bool) error {
+	var blockers []string
+	for _, member := range members {
+		if member.HasPair {
+			blockers = append(blockers, fmt.Sprintf("the open entry %s is a member of the beam: land it with `lyx batten run %s`, or end it with `lyx batten cancel %s --remove`", member.Slug, member.Slug, member.Slug))
+			continue
+		}
+		blockers = append(blockers, fmt.Sprintf("the open entry %s is a member of the beam and has no pair on this machine: move its `project` off the beam with `lyx board upsert`, or land it where it runs", member.Slug))
+	}
+	for _, pair := range childPairs {
+		blockers = append(blockers, fmt.Sprintf("the pair %s was forked from the beam: land it with `lyx batten run %s`, or end it with `lyx batten cancel %s --remove`", pair, pair, pair))
+	}
+	switch {
+	case orchLive && watcherLive:
+		blockers = append(blockers, fmt.Sprintf("the orch and its watcher of the beam %s are live: run `lyx orch stop` in the beam's worktree, and re-run once `lyx orch status` there reports the watcher gone", slug))
+	case orchLive:
+		blockers = append(blockers, fmt.Sprintf("the orch of the beam %s is live: run `lyx orch stop` in the beam's worktree, and re-run once `lyx orch status` there reports the watcher gone", slug))
+	case watcherLive:
+		blockers = append(blockers, fmt.Sprintf("the watcher of the beam %s is live: run `lyx orch stop` in the beam's worktree, and re-run once `lyx orch status` there reports the watcher gone", slug))
+	}
+	if len(blockers) == 0 {
+		return nil
+	}
+	return fmt.Errorf("battencli: the beam %s cannot land while work remains under it; way forward: %s", slug, strings.Join(blockers, "; "))
+}
+
+// beamMembers lists, sorted, the open tasks and beam projects whose parent, through any depth of grouping projects, is the beam slug.
+func beamMembers(prime *lyxcwd.Location, slug string) ([]beamMember, error) {
+	tasks, err := boardengine.ReadTasks(fabricengine.BoardDir(prime.HubPath))
+	if err != nil {
+		return nil, fmt.Errorf("battencli: read the board for the members of the beam %s: %w", slug, err)
+	}
+	var members []beamMember
+	for _, task := range tasks {
+		if task.Slug == slug || (task.Status != nil && *task.Status == "done") {
+			continue
+		}
+		if task.Kind != boardengine.KindTask && !(task.Kind == boardengine.KindProject && task.Beam) {
+			continue
+		}
+		parent, err := hubgeom.ParentOf(prime, task.Slug)
+		if err != nil {
+			return nil, fmt.Errorf("battencli: read the parent of %s for the beam %s: %w", task.Slug, slug, err)
+		}
+		if parent != slug {
+			continue
+		}
+		hasPair, err := pairPresent(prime, task.Slug)
+		if err != nil {
+			return nil, err
+		}
+		members = append(members, beamMember{Slug: task.Slug, HasPair: hasPair})
+	}
+	slices.SortFunc(members, func(a, b beamMember) int { return strings.Compare(a.Slug, b.Slug) })
+	return members, nil
+}
+
+// pairPresent reports whether this machine holds the worktree of slug's pair.
+func pairPresent(prime *lyxcwd.Location, slug string) (bool, error) {
+	info, err := os.Stat(fabricengine.WorktreePath(prime, slug))
+	if os.IsNotExist(err) {
+		return false, nil
+	}
+	return err == nil && info.IsDir(), err
+}
+
+// beamChildPairs lists, sorted, the local pairs whose origin record names the beam slug as their parent worktree.
+func beamChildPairs(prime *lyxcwd.Location, slug string) ([]string, error) {
+	worktrees, err := fabricengine.List(prime.AnchorPath())
+	if err != nil {
+		return nil, fmt.Errorf("battencli: list the worktrees for the pairs forked from the beam %s: %w", slug, err)
+	}
+	var pairs []string
+	for _, worktree := range worktrees {
+		if worktree.Main || worktree.Prunable {
+			continue
+		}
+		name := filepath.Base(filepath.Clean(filepath.FromSlash(worktree.Path)))
+		if name == slug {
+			continue
+		}
+		origin, found, err := fabricengine.ReadOriginFor(prime, name)
+		if err != nil {
+			return nil, fmt.Errorf("battencli: read the origin record of %s for the beam %s: %w", name, slug, err)
+		}
+		if found && origin.ParentWorktree == slug {
+			pairs = append(pairs, name)
+		}
+	}
+	slices.Sort(pairs)
+	return pairs, nil
+}
+
+// beamOrchLive reports whether the orch strand and the watcher of the beam slug are live; a beam with no pair on this machine has neither.
+func beamOrchLive(prime *lyxcwd.Location, slug string) (orchLive, watcherLive bool, err error) {
+	present, err := pairPresent(prime, slug)
+	if err != nil || !present {
+		return false, false, err
+	}
+	beam, err := lyxcwd.ResolveWorktree(fabricengine.WorktreePath(prime, slug))
+	if err != nil {
+		return false, false, fmt.Errorf("battencli: resolve the beam %s to read its orch: %w", slug, err)
+	}
+	orchLive, err = orchcli.OrchLive(beam)
+	if err != nil {
+		return false, false, fmt.Errorf("battencli: read whether the orch of the beam %s is live: %w", slug, err)
+	}
+	watcherLive, err = orchengine.WatcherLive(orchcli.PrimePaths(beam))
+	if err != nil {
+		return false, false, fmt.Errorf("battencli: read whether the watcher of the beam %s is live: %w", slug, err)
+	}
+	return orchLive, watcherLive, nil
+}
