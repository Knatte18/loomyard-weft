+		}
+		if marker := gitkit.Git(t, f.weft, "show", got.Tip+":"+lyxcwd.AnchorFileName); marker != "c" {
+			t.Errorf("marker = %q; want c", marker)
+		}
+	})
+
+	t.Run("A local commit that changed the marker is skipped", func(t *testing.T) {
+		t.Parallel()
