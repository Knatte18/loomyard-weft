+			verdict:     "verdict: resume\nreason: go back\ngoto: Plan-Write\n",
+			wantVerdict: loomengine.ArbiterVerdictResume, wantGoto: "Plan-Write",
+			wantRelaunch: "lyx shed step " + testRun + " --until-stop --arbiter-attempt 1",
