--- /dev/null
+++ b/internal/shedbuild/entrygate.go
@@ -0,0 +1,203 @@
+// entrygate.go parses a recipe row's entry_gate checks and builds them into the shedengine.EntryGate the row's definition carries.
+
+package shedbuild
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"regexp"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrecipe"
+)
+
+const (
+	// budgetModule is the operand module that names a segment's resolved soft cap instead of a config module.
+	budgetModule = "budget"
+
+	entryGateWayForward = "way forward: write each check as <operand>, <operand> == <literal> or <operand> != <literal>, an operand being module.key or budget.<Segment>"
+)
+
+// operandPattern is the shape of an entry gate operand: two dot-separated words.
+var operandPattern = regexp.MustCompile(`^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$`)
+
+// entryCheck is one parsed entry gate check.
+type entryCheck struct {
+	// text is the check as the recipe wrote it, trimmed.
+	text string
+	// module and key are the operand's two halves; module is budgetModule for a segment budget, and key is then the segment.
+	module string
+	key    string
+	// comparison is "==", "!=" or "" for a bare operand.
+	comparison string
+	// literal is the YAML scalar a comparison compares against.
+	literal any
+}
+
+// operand renders the check's operand as the recipe wrote it.
+func (c entryCheck) operand() string {
+	return c.module + "." + c.key
+}
+
+// parseEntryGate parses each of row's entry_gate checks.
+// A check is `<operand>`, `<operand> == <literal>` or `<operand> != <literal>` with a YAML scalar literal, an operand being `module.key` or `budget.<Segment>`.
+// Any other text is refused naming the row, the check and the way forward.
+func parseEntryGate(row Row) ([]entryCheck, error) {
+	checks := make([]entryCheck, 0, len(row.EntryGate))
+	for _, text := range row.EntryGate {
+		check, err := parseEntryCheck(text)
+		if err != nil {
+			return nil, fmt.Errorf("shedbuild: row %q: entry_gate check %q: %w; %s", row.Name, text, err, entryGateWayForward)
+		}
+		checks = append(checks, check)
+	}
+	return checks, nil
+}
+
+// parseEntryCheck parses one check's text.
+func parseEntryCheck(text string) (entryCheck, error) {
+	trimmed := strings.TrimSpace(text)
+	if trimmed == "" {
+		return entryCheck{}, errors.New("the check is empty")
+	}
+
+	at, comparison := -1, ""
+	for _, candidate := range []string{"==", "!="} {
+		if found := strings.Index(trimmed, candidate); found >= 0 && (at < 0 || found < at) {
+			at, comparison = found, candidate
+		}
+	}
+	operandText := trimmed
+	var literal any
+	if at >= 0 {
+		operandText = strings.TrimSpace(trimmed[:at])
+		var err error
+		if literal, err = parseEntryLiteral(trimmed[at+len(comparison):]); err != nil {
+			return entryCheck{}, err
+		}
+	}
+
+	if !operandPattern.MatchString(operandText) {
+		return entryCheck{}, fmt.Errorf("%q is not an operand of the form module.key or budget.<Segment>", operandText)
+	}
+	module, key, _ := strings.Cut(operandText, ".")
+	return entryCheck{text: trimmed, module: module, key: key, comparison: comparison, literal: literal}, nil
+}
+
+// parseEntryLiteral reads the text after a comparison as one YAML scalar.
+// An unquoted literal holding whitespace is refused, so a second comparison or an `&&` cannot hide in it.
+func parseEntryLiteral(text string) (any, error) {
+	text = strings.TrimSpace(text)
+	if text == "" {
+		return nil, errors.New("the literal after the comparison is empty")
+	}
+	var value any
+	if err := yaml.Unmarshal([]byte(text), &value); err != nil {
+		return nil, fmt.Errorf("the literal %q is not a YAML scalar: %w", text, err)
+	}
+	switch value.(type) {
+	case map[string]any, []any:
+		return nil, fmt.Errorf("the literal %q is not a YAML scalar", text)
+	case string:
+		if text[0] != '"' && text[0] != '\'' && strings.ContainsAny(text, " \t") {
+			return nil, fmt.Errorf("the literal %q holds whitespace; quote it to compare against a string", text)
+		}
+	}
+	return value, nil
+}
+
+// entryGateOf builds the EntryGate row's checks make, nil for a row with none.
+// It refuses, naming the row and the way forward, an operand the told Env cannot answer: a `module.key` that Env.SettingKnown rejects or that meets a nil Env.SettingKnown or Env.Setting, and a segment with no Env.Segments entry.
+// The returned gate reads every operand at each evaluation: a setting through Env.Setting and a segment budget as Env.Segments[<Segment>].MaxBounces.
+// It stops at the first check that does not hold and returns that check's reason.
+func entryGateOf(row Row, checks []entryCheck, env shedrecipe.Env) (shedengine.EntryGate, error) {
+	if len(checks) == 0 {
+		return nil, nil
+	}
+	for _, check := range checks {
+		if err := check.validate(row, env); err != nil {
+			return nil, err
+		}
+	}
+	return func() (bool, string, error) {
+		for _, check := range checks {
+			holds, reason, err := check.evaluate(row, env)
+			if err != nil || !holds {
+				return false, reason, err
+			}
+		}
+		return true, "", nil
+	}, nil
+}
+
+// validate refuses a check whose operand env cannot answer.
+func (c entryCheck) validate(row Row, env shedrecipe.Env) error {
+	if c.module == budgetModule {
+		if _, ok := env.Segments[c.key]; !ok {
+			return fmt.Errorf("shedbuild: row %q: entry_gate check %q: segment %q has no Env.Segments entry; way forward: name a review segment of the recipe, or wire the segment's settings in the caller's Env.Segments", row.Name, c.text, c.key)
+		}
+		return nil
+	}
+	if env.SettingKnown == nil {
+		return fmt.Errorf("shedbuild: row %q: entry_gate check %q names setting %s but Env.SettingKnown is nil; way forward: fill Env.SettingKnown in the caller that builds this recipe", row.Name, c.text, c.operand())
+	}
+	if env.Setting == nil {
+		return fmt.Errorf("shedbuild: row %q: entry_gate check %q names setting %s but Env.Setting is nil; way forward: fill Env.Setting in the caller that builds this recipe", row.Name, c.text, c.operand())
+	}
+	if err := env.SettingKnown(c.module, c.key); err != nil {
+		return fmt.Errorf("shedbuild: row %q: entry_gate check %q: %w", row.Name, c.text, err)
+	}
+	return nil
+}
+
+// evaluate reads the check's operand and reports whether the check holds.
+// The reason names the check with the value read.
+func (c entryCheck) evaluate(row Row, env shedrecipe.Env) (holds bool, reason string, err error) {
+	var value any
+	if c.module == budgetModule {
+		value = env.Segments[c.key].MaxBounces
+	} else if value, err = env.Setting(c.module, c.key); err != nil {
+		return false, "", fmt.Errorf("shedbuild: row %q: entry_gate check %q: read setting %s: %w", row.Name, c.text, c.operand(), err)
+	}
+
+	switch {
+	case c.comparison != "":
+		holds = valuesEqual(value, c.literal) == (c.comparison == "==")
+		reason = fmt.Sprintf("%s (%s = %v)", c.text, c.operand(), value)
+	case c.module == budgetModule:
+		holds = value != 0
+		reason = fmt.Sprintf("%s = %v", c.operand(), value)
+	default:
+		enabled, isBool := value.(bool)
+		if !isBool {
+			return false, "", fmt.Errorf("shedbuild: row %q: entry_gate check %q: setting %s holds %v, not a bool; way forward: run `lyx config %s --resolved` in the task worktree to see the layer holding the value, then fix it there: with `lyx config %s` from the prime for a hub or default layer, or with `lyx config %s --layer local --set %s=<bool>` in the task worktree for a value the local layer holds; then %s", row.Name, c.text, c.operand(), value, c.module, c.module, c.module, c.key, env.Resume)
+		}
+		holds = enabled
+		reason = fmt.Sprintf("%s = %v", c.operand(), value)
+	}
+	return holds, reason, nil
+}
+
+// valuesEqual reports whether a setting value equals a literal, comparing any two numbers by value.
+func valuesEqual(value, literal any) bool {
+	if left, ok := numberOf(value); ok {
+		right, ok := numberOf(literal)
+		return ok && left == right
+	}
+	return reflect.DeepEqual(value, literal)
+}
+
+// numberOf returns v as a float64 when v is an int or a float64.
+func numberOf(v any) (float64, bool) {
+	switch n := v.(type) {
+	case int:
+		return float64(n), true
+	case float64:
+		return n, true
+	}
+	return 0, false
+}
diff --git a/internal/shedbuild/entrygate_test.go b/internal/shedbuild/entrygate_test.go
new file mode 100644
index 000000000..7886cf590
--- /dev/null
+++ b/internal/shedbuild/entrygate_test.go
@@ -0,0 +1,139 @@
+//go:build tier0
+
+// entrygate_test.go covers the entry gate Build makes from a parsed recipe's entry_gate key, evaluated against a fake setting lookup and no worktree.
+
+package shedbuild
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/configreg"
+	"github.com/Knatte18/loomyard/internal/shedrecipe"
+)
+
+func TestBuild_EntryGate(t *testing.T) {
+	t.Parallel()
+
+	const setting = "loom.plan_auto_accept"
+	tests := []struct {
+		name string
+		// gate is the YAML value of the row's entry_gate key; empty leaves the key out.
+		gate string
+		// value is what the fake lookup answers for setting, an error value failing the read.
+		value any
+		// budget is the soft cap of the Code-Review segment.
+		budget      int
+		wantNilGate bool
+		wantHolds   bool
+		// wantReason is a substring of the reason a false gate returns.
+		wantReason string
+		// wantErrSubs are substrings of the evaluation error, which makes the gate undecided.
+		wantErrSubs []string
+		// rereadAs, when non-nil, replaces the setting's value after the first evaluation, and wantHoldsAfter is the second evaluation's answer.
+		rereadAs       any
+		wantHoldsAfter bool
+	}{
+		{name: "a row with no entry_gate carries no gate", wantNilGate: true},
+		{name: "a bare setting holding true holds", gate: setting, value: true, wantHolds: true},
+		{name: "a bare setting holding false does not hold and the reason shows the value read", gate: setting, value: false, wantReason: setting + " = false"},
+		{name: "equality against a number holds on an equal setting", gate: `"` + setting + ` == 3"`, value: 3, wantHolds: true},
+		{name: "inequality against a number does not hold on an equal setting", gate: `"` + setting + ` != 3"`, value: 3, wantReason: setting + " != 3 (" + setting + " = 3)"},
+		{name: "equality against a bare word compares strings", gate: `"` + setting + ` == fast"`, value: "fast", wantHolds: true},
+		{name: "a list holds when every check does", gate: `[` + setting + `, budget.Code-Review]`, value: true, budget: 2, wantHolds: true},
+		{name: "a list stops at the first check that does not hold", gate: `[` + setting + `, budget.Code-Review]`, value: true, budget: 0, wantReason: "budget.Code-Review = 0"},
+		{name: "a segment budget above zero holds", gate: "budget.Code-Review", budget: 1, wantHolds: true},
+		{name: "a segment budget of zero does not hold", gate: "budget.Code-Review", budget: 0, wantReason: "budget.Code-Review = 0"},
+		{name: "a segment budget compares against a literal", gate: `"budget.Code-Review == 0"`, budget: 0, wantHolds: true},
+		{
+			name:        "a bare setting holding a string is an evaluation error naming the config command and the resume command",
+			gate:        setting,
+			value:       "no",
+			wantErrSubs: []string{`row "Gated"`, setting, "holds no, not a bool", "lyx config loom --resolved", "lyx config loom --layer local --set plan_auto_accept=<bool>", "lyx loom resume"},
+		},
+		{
+			name:        "a bare setting holding a number is an evaluation error",
+			gate:        setting,
+			value:       1,
+			wantErrSubs: []string{setting, "holds 1, not a bool", "lyx loom resume"},
+		},
+		{
+			name:        "a failed read is an evaluation error naming the row and the check",
+			gate:        setting,
+			value:       errors.New("layer unreadable"),
+			wantErrSubs: []string{`row "Gated"`, `entry_gate check "` + setting + `"`, "layer unreadable"},
+		},
+		{name: "the gate reads the setting at each evaluation", gate: setting, value: true, wantHolds: true, rereadAs: false, wantHoldsAfter: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			current := tt.value
+			env := shedrecipe.Env{
+				Setting: func(module, key string) (any, error) {
+					if err, failed := current.(error); failed {
+						return nil, err
+					}
+					return current, nil
+				},
+				SettingKnown: configreg.CheckSettingKey,
+				Segments:     map[string]shedrecipe.SegmentSettings{"Code-Review": {MaxBounces: tt.budget}},
+				Resume:       "lyx loom resume",
+			}
+			gateLine := ""
+			if tt.gate != "" {
+				gateLine = "    entry_gate: " + tt.gate + "\n"
+			}
+			recipe, err := Parse([]byte(fmt.Sprintf("version: 1\nentry: Gated\nterminals: [Gated]\nproducers:\n  - name: Gated\n    engine: Stub\n%s", gateLine)))
+			if err != nil {
+				t.Fatalf("Parse() error = %v; want nil", err)
+			}
+
+			defs, err := Build(recipe, env)
+			if err != nil {
+				t.Fatalf("Build() error = %v; want nil", err)
+			}
+			gate := defs[0].EntryGate
+			if tt.wantNilGate {
+				if gate != nil {
+					t.Fatal("EntryGate is set; want nil for a row with no entry_gate")
+				}
+				return
+			}
+			if gate == nil {
+				t.Fatal("EntryGate = nil; want a gate")
+			}
+
+			holds, reason, err := gate()
+			if len(tt.wantErrSubs) > 0 {
+				if err == nil {
+					t.Fatalf("gate() = (%v, %q, nil); want an evaluation error", holds, reason)
+				}
+				for _, want := range tt.wantErrSubs {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("gate() error = %v; want it to contain %q", err, want)
+					}
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("gate() error = %v; want nil", err)
+			}
+			if holds != tt.wantHolds {
+				t.Errorf("gate() holds = %v; want %v (reason %q)", holds, tt.wantHolds, reason)
+			}
+			if !holds && !strings.Contains(reason, tt.wantReason) {
+				t.Errorf("gate() reason = %q; want it to contain %q", reason, tt.wantReason)
+			}
+
+			if tt.rereadAs != nil {
+				current = tt.rereadAs
+				if again, _, err := gate(); err != nil || again != tt.wantHoldsAfter {
+					t.Errorf("second gate() = (%v, %v); want (%v, nil) after the setting changed", again, err, tt.wantHoldsAfter)
+				}
+			}
+		})
+	}
+}
