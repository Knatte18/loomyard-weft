diff --git a/internal/driftcli/wiring.go b/internal/driftcli/wiring.go
new file mode 100644
index 000000000..caf9bf9eb
--- /dev/null
+++ b/internal/driftcli/wiring.go
@@ -0,0 +1,118 @@
+// wiring.go — resolves the worktree a drift verb runs in and builds the seams the driftengine functions are told: the run status, the git facts and the gate slots.
+
+package driftcli
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"time"
+
+	"github.com/spf13/cobra"
+
+	"github.com/Knatte18/loomyard/internal/driftengine"
+	"github.com/Knatte18/loomyard/internal/fabricengine"
+	"github.com/Knatte18/loomyard/internal/gateslot"
+	"github.com/Knatte18/loomyard/internal/hubgeom"
+	"github.com/Knatte18/loomyard/internal/lyxcwd"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+	"github.com/Knatte18/loomyard/internal/shedrun"
+	"github.com/Knatte18/loomyard/internal/state"
+)
+
+// worktree is the task worktree a drift verb runs in, with its drift paths.
+type worktree struct {
+	location *lyxcwd.Location
+	paths    driftengine.Paths
+}
+
+// openWorktree resolves the worktree of the command's cwd.
+func openWorktree(cmd *cobra.Command) (*worktree, error) {
+	cwd, err := lyxcwd.CwdFrom(cmd.Context())
+	if err != nil {
+		return nil, err
+	}
+	location, err := lyxcwd.Resolve(cwd)
+	if err != nil {
+		return nil, err
+	}
+	return &worktree{location: location, paths: driftengine.NewPaths(location.AnchorPath())}, nil
+}
+
+// root returns the worktree root a drift command's relative dir is joined onto.
+func (w *worktree) root() string {
+	return w.location.WorktreePath()
+}
+
+// config loads the hub's drift config strictly.
+func (w *worktree) config() (driftengine.Config, error) {
+	return driftengine.LoadConfig(fabricengine.ConfigDirs(w.location))
+}
+
+// verbStatus reads the run status under its lock, the recipe from the run's seed, the capture lock and the agent-session mark.
+func (w *worktree) verbStatus() (driftengine.VerbStatus, error) {
+	status, found, err := state.ReadJSONNoMkdir[shedengine.Status](shedrun.StatusFile(w.location, shedrun.SelfRunID), shedrun.StatusLock(w.location, shedrun.SelfRunID))
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return driftengine.VerbStatus{}, err
+	}
+	if !found {
+		return driftengine.VerbStatus{}, errors.New("drift: this worktree has no run status; way forward: lyx drift verbs run inside a loom or darn run's worktree")
+	}
+	seed, seedFound, err := shedrun.ReadSeed(w.location, shedrun.SelfRunID)
+	if err != nil {
+		return driftengine.VerbStatus{}, err
+	}
+	if !seedFound {
+		return driftengine.VerbStatus{}, errors.New("drift: this worktree's run has no seed; way forward: lyx drift verbs run inside a loom or darn run's worktree")
+	}
+	captureHeld, err := driftengine.ProbeLock(w.paths.CaptureLock)
+	if err != nil {
+		return driftengine.VerbStatus{}, err
+	}
+	agentSession, err := driftengine.AgentSessionOpen(w.paths)
+	if err != nil {
+		return driftengine.VerbStatus{}, err
+	}
+	return driftengine.VerbStatus{
+		Status:       status,
+		AwaitRow:     seed.Recipe == shedrun.RecipeLoom,
+		CaptureHeld:  captureHeld,
+		AgentSession: agentSession,
+	}, nil
+}
+
+// gitFacts reads HEAD, the branch point and the tracked dirty paths of the code checkout.
+// The branch point is the merge base of HEAD with the parent branch the pair's origin record names.
+func (w *worktree) gitFacts() (head, branchPoint string, dirty []string, err error) {
+	fabric, err := fabricengine.Open(w.location)
+	if err != nil {
+		return "", "", nil, err
+	}
+	if head, err = fabric.HeadSHA(); err != nil {
+		return "", "", nil, err
+	}
+	origin, found, err := fabricengine.ReadOrigin(w.location)
+	if err != nil {
+		return "", "", nil, err
+	}
+	if !found {
+		return "", "", nil, errors.New("drift: this worktree has no origin record, so its branch point is unknown; way forward: lyx fabric reconcile")
+	}
+	if branchPoint, err = fabric.MergeBase(origin.ParentBranch); err != nil {
+		return "", "", nil, fmt.Errorf("drift: find the branch point against %s: %w", origin.ParentBranch, err)
+	}
+	if _, dirty, err = fabric.CodeDirtyPaths(); err != nil {
+		return "", "", nil, err
+	}
+	return head, branchPoint, dirty, nil
+}
+
+// slots returns the hub's gate-slot pool and the directory a step's wait record goes to.
+func (w *worktree) slots() (*gateslot.Pool, string) {
+	return hubgeom.GateSlots(w.location), gateslot.WaitDir(w.location.AnchorPath())
+}
+
+// stepTimeout returns how long a declared step may run.
+func stepTimeout(step driftengine.CommandStep) time.Duration {
+	return time.Duration(step.TimeoutMin) * time.Minute
+}
diff --git a/internal/driftengine/await.go b/internal/driftengine/await.go
new file mode 100644
index 000000000..3aad2002f
--- /dev/null
+++ b/internal/driftengine/await.go
@@ -0,0 +1,116 @@
+// await.go — the Drift-Await producer: the mechanical row that holds the run until the baseline capture exists, or the parent deferred it.
+
+package driftengine
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// DriftAwait is the Drift-Await ShedProducer.
+type DriftAwait struct {
+	name string
+	deps Deps
+}
+
+var _ shedengine.ShedProducer = (*DriftAwait)(nil)
+
+// NewDriftAwait returns the Drift-Await producer identified as name.
+func NewDriftAwait(name string, deps Deps) *DriftAwait {
+	return &DriftAwait{name: name, deps: deps}
+}
+
+// Call runs one Drift-Await pass and commits the durable drift directory, the capture log included, on every way out.
+// It is Done with no scope record, with scope off, with awaited_at set whatever HEAD is, and when a passed capture was taken at HEAD, which it records as awaited_at.
+// A capture holding the lock is waited on without a bound of its own, and the capture record is read only after the lock reads free.
+// A missing, failed or unfinished capture, and a passed one taken at another commit than HEAD, are a Stuck naming its ways forward.
+func (p *DriftAwait) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	d := p.deps
+	err := requireSeams(p.name,
+		seam{"Head", d.Head != nil},
+		seam{"BranchPoint", d.BranchPoint != nil},
+		seam{"Commit", d.Commit != nil},
+		seam{"Sleep", d.Sleep != nil},
+	)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	outcome, pointer, err := p.await(ctx)
+	return commitOnExit(p.name, d.Commit, []string{DirRel()}, outcome, pointer, err)
+}
+
+// await is Call without the commit.
+func (p *DriftAwait) await(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	d := p.deps
+	scope, found, err := ReadScope(d.Paths)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	if !found || scope.Scope == ScopeOff || scope.AwaitedAt != "" {
+		return shedengine.Done, shedengine.OutputPointer{}, nil
+	}
+
+	if err := awaitCaptureEnd(ctx, d.Paths, d.Sleep); err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	capture, captureFound, err := ReadCapture(d.Paths)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	head, err := d.Head()
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	branchPoint, err := d.BranchPoint()
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+
+	stuck := func(what string) (shedengine.Outcome, shedengine.OutputPointer, error) {
+		return shedengine.Stuck, shedengine.OutputPointer{Reason: fmt.Sprintf("drift: %s; way forward: %s", what, awaitWaysForward(head == branchPoint))}, nil
+	}
+	switch {
+	case !captureFound:
+		return stuck("no baseline capture exists")
+	case capture.State == CaptureRunning:
+		return stuck(fmt.Sprintf("the baseline capture record reads running, but no capture holds the lock%s", logClause(capture.Log)))
+	case capture.State != CapturePassed:
+		return stuck(fmt.Sprintf("the baseline capture ended %s (%s)%s", capture.State, capture.Reason, logClause(capture.Log)))
+	case capture.Head != head:
+		return stuck(fmt.Sprintf("HEAD %s moved off the commit %s the baseline was captured at, and no capture may run on changed code", head, capture.Head))
+	}
+
+	now := d.Now
+	if now == nil {
+		now = time.Now
+	}
+	err = UpdateScope(d.Paths, func(cur ScopeRecord, _ bool) (ScopeRecord, error) {
+		cur.AwaitedAt = stamp(now())
+		return cur, nil
+	})
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	return shedengine.Done, shedengine.OutputPointer{}, nil
+}
+
+// awaitWaysForward names the ways forward of a Drift-Await Stuck.
+// A capture is one of them only while HEAD is on the branch point.
+func awaitWaysForward(onBranchPoint bool) string {
+	deferring := "lyx drift defer followed by lyx loom resume, which goes on with regression deferred"
+	if !onBranchPoint {
+		return deferring
+	}
+	return "lyx drift capture followed by lyx loom resume, which captures again on the branch point and re-enters this row, or " + deferring
+}
+
+// logClause returns ", log <path>", or nothing when log is empty.
+func logClause(log string) string {
+	if log == "" {
+		return ""
+	}
+	return ", log " + log
+}
diff --git a/internal/driftengine/await_test.go b/internal/driftengine/await_test.go
new file mode 100644
index 000000000..027a2c912
--- /dev/null
+++ b/internal/driftengine/await_test.go
@@ -0,0 +1,198 @@
+//go:build tier0
+
+// await_test.go — tier 0 tests for the Drift-Await producer over the fake Deps the baseline tests use.
+
+package driftengine
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// TestDriftAwait covers each Done and Stuck way out of the row, the wait on a held capture lock, awaited_at written on a passed capture, a deferral and the commit of the durable directory on every pass.
+func TestDriftAwait(t *testing.T) {
+	t.Parallel()
+
+	const awaited = "2026-01-01T00:00:00Z"
+	passedAtHead := CaptureRecord{State: CapturePassed, Head: "aaa"}
+	capturePath := "lyx drift capture followed by lyx loom resume"
+	deferPath := "lyx drift defer followed by lyx loom resume"
+
+	tests := []struct {
+		name        string
+		setup       func(f *baselineFixture)
+		want        shedengine.Outcome
+		wantReason  []string
+		wantNoWays  []string
+		wantAwaited bool
+		check       func(t *testing.T, f *baselineFixture)
+	}{
+		{name: "no scope record is Done", want: shedengine.Done},
+		{
+			name:  "scope off is Done",
+			setup: func(f *baselineFixture) { f.seedScopeRecord(ScopeRecord{Scope: ScopeOff}, false) },
+			want:  shedengine.Done,
+		},
+		{
+			name: "awaited_at set is Done with HEAD moved",
+			setup: func(f *baselineFixture) {
+				f.head = "ccc"
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull, AwaitedAt: awaited}, false)
+			},
+			want: shedengine.Done,
+		},
+		{
+			name: "a missing record under partial is Stuck naming capture and defer",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopePartial, Skip: []string{"s"}}, false)
+			},
+			want:       shedengine.Stuck,
+			wantReason: []string{"no baseline capture", capturePath, deferPath},
+		},
+		{
+			name: "a failed record is Stuck naming the log",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				f.writeCapture(CaptureRecord{State: CaptureFailed, Reason: "exit 1", Log: "capture.log"})
+			},
+			want:       shedengine.Stuck,
+			wantReason: []string{"ended failed (exit 1)", "log capture.log", capturePath},
+		},
+		{
+			name: "a timed-out record is Stuck naming the log",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				f.writeCapture(CaptureRecord{State: CaptureFailed, Reason: "timed out after 30m", Log: "capture.log"})
+			},
+			want:       shedengine.Stuck,
+			wantReason: []string{"timed out after 30m", "log capture.log"},
+		},
+		{
+			name: "a running record with a free lock is Stuck naming the log",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				f.writeCapture(CaptureRecord{State: CaptureRunning, Pid: 1, Log: "capture.log"})
+			},
+			want:       shedengine.Stuck,
+			wantReason: []string{"reads running", "log capture.log"},
+		},
+		{
+			name: "a held lock is waited on and the passed record is Done with awaited_at written",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				release := f.holdCaptureLock()
+				f.onSleep = func(int) {
+					f.writeCapture(passedAtHead)
+					release()
+				}
+			},
+			want:        shedengine.Done,
+			wantAwaited: true,
+			check: func(t *testing.T, f *baselineFixture) {
+				if len(f.sleeps) != 1 {
+					t.Errorf("sleeps = %v; want one, through the fake Sleep that released the lock", f.sleeps)
+				}
+			},
+		},
+		{
+			name: "a record flipped from running to passed as the lock is released is read as passed",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				f.writeCapture(CaptureRecord{State: CaptureRunning, Pid: 1})
+				release := f.holdCaptureLock()
+				f.onSleep = func(int) {
+					f.writeCapture(passedAtHead)
+					release()
+				}
+			},
+			want:        shedengine.Done,
+			wantAwaited: true,
+		},
+		{
+			name: "a passed record at HEAD is Done with awaited_at written",
+			setup: func(f *baselineFixture) {
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				f.writeCapture(passedAtHead)
+			},
+			want:        shedengine.Done,
+			wantAwaited: true,
+		},
+		{
+			name: "a passed record with HEAD moved before the first await is Stuck naming only defer",
+			setup: func(f *baselineFixture) {
+				f.head = "bbb"
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				f.writeCapture(passedAtHead)
+			},
+			want:       shedengine.Stuck,
+			wantReason: []string{"moved off", deferPath},
+			wantNoWays: []string{"lyx drift capture"},
+		},
+		{
+			name: "after Defer the row is Done on every later entry",
+			setup: func(f *baselineFixture) {
+				f.head = "bbb"
+				f.seedScopeRecord(ScopeRecord{Scope: ScopeFull}, false)
+				blocked := statusAt("Drift-Await", shedengine.StateBlocked, "", false)
+				if err := Defer(f.paths, blocked); err != nil {
+					f.t.Fatal(err)
+				}
+			},
+			want: shedengine.Done,
+			check: func(t *testing.T, f *baselineFixture) {
+				for range 2 {
+					if outcome, _, err := NewDriftAwait("Drift-Await", f.deps).Call(context.Background()); err != nil || outcome != shedengine.Done {
+						t.Errorf("a later Call() = %q, %v; want Done after the deferral", outcome, err)
+					}
+				}
+				if len(f.commits) != 3 {
+					t.Errorf("commits = %d; want one per Call", len(f.commits))
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			f := newBaselineFixture(t)
+			if tt.setup != nil {
+				tt.setup(f)
+			}
+
+			before, _, _ := ReadScope(f.paths)
+			outcome, pointer, err := NewDriftAwait("Drift-Await", f.deps).Call(context.Background())
+			if err != nil {
+				t.Fatalf("Call() error = %v; want nil", err)
+			}
+			if outcome != tt.want {
+				t.Errorf("Call() outcome = %q (%s); want %q", outcome, pointer.Reason, tt.want)
+			}
+			for _, want := range tt.wantReason {
+				if !strings.Contains(pointer.Reason, want) {
+					t.Errorf("Call() reason = %q; want it to name %q", pointer.Reason, want)
+				}
+			}
+			for _, banned := range tt.wantNoWays {
+				if strings.Contains(pointer.Reason, banned) {
+					t.Errorf("Call() reason = %q; want it to omit %q", pointer.Reason, banned)
+				}
+			}
+			if strings.Contains(pointer.Reason, "decision halt") {
+				t.Errorf("Call() reason = %q; want no decision halt prefix, so the arbiter may settle it", pointer.Reason)
+			}
+			if after, _, _ := ReadScope(f.paths); (after.AwaitedAt != "" && after.AwaitedAt != before.AwaitedAt) != tt.wantAwaited {
+				t.Errorf("awaited_at %q after %q; want written = %v", after.AwaitedAt, before.AwaitedAt, tt.wantAwaited)
+			}
+			if len(f.commits) == 0 || !slices.Equal(f.commits[0], []string{DirRel()}) {
+				t.Errorf("commits = %v; want the whole durable directory", f.commits)
+			}
+			if tt.check != nil {
+				tt.check(t, f)
+			}
+		})
+	}
+}
diff --git a/internal/driftengine/baseline.go b/internal/driftengine/baseline.go
new file mode 100644
index 000000000..cb48b0d83
--- /dev/null
+++ b/internal/driftengine/baseline.go
@@ -0,0 +1,188 @@
+// baseline.go — the Drift-Baseline producer: it has the baseline agent record the task's regression scope and report, then takes the baseline capture the scope calls for.
+
+package driftengine
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+
+	"github.com/Knatte18/loomyard/internal/seatengine"
+	"github.com/Knatte18/loomyard/internal/shedadapters"
+	"github.com/Knatte18/loomyard/internal/shedengine"
+)
+
+// DriftBaseline is the Drift-Baseline ShedProducer.
+type DriftBaseline struct {
+	name string
+	row  Row
+	deps Deps
+}
+
+var _ shedengine.ShedProducer = (*DriftBaseline)(nil)
+
+// NewDriftBaseline returns the Drift-Baseline producer identified as name.
+func NewDriftBaseline(name string, row Row, deps Deps) *DriftBaseline {
+	return &DriftBaseline{name: name, row: row, deps: deps}
+}
+
+// Call runs one Drift-Baseline pass and commits the drift records on every way out.
+// It has the baseline agent record the scope and write baseline.md when either is missing, then, by the recorded scope, takes the baseline capture:
+// scope off, a set awaited_at and a passed capture take none, and a capture that holds the lock is waited on under WaitCapture and left running otherwise.
+// Without WaitCapture the capture is a detached child and the pass returns once the child's record exists;
+// with WaitCapture, and when a detached start is refused breakaway, the capture runs in this process.
+// A failed or refused capture is a Stuck whose reason opens with CaptureHaltPrefix and names its ways forward.
+// Only the scope record and baseline.md are committed while a detached capture may still write its logs; all of the durable drift directory is committed once a capture has ended in this process.
+func (p *DriftBaseline) Call(ctx context.Context) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	d := p.deps
+	err := requireSeams(p.name,
+		seam{"Config", d.Config != nil},
+		seam{"Status", d.Status != nil},
+		seam{"Head", d.Head != nil},
+		seam{"BranchPoint", d.BranchPoint != nil},
+		seam{"DirtyPaths", d.DirtyPaths != nil},
+		seam{"Commit", d.Commit != nil},
+		seam{"Seats", d.Seats != nil},
+		seam{"BaselineTable", d.BaselineTable != nil},
+		seam{"StartCapture", d.StartCapture != nil},
+		seam{"RunCapture", d.RunCapture != nil},
+		seam{"Sleep", d.Sleep != nil || !p.row.WaitCapture},
+	)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+
+	commitAll := p.row.WaitCapture
+	outcome, pointer, err := p.drive(ctx, &commitAll)
+
+	paths := []string{
+		path.Join(DirRel(), filepath.Base(d.Paths.Scope)),
+		path.Join(DirRel(), filepath.Base(d.Paths.BaselineReport)),
+	}
+	if commitAll {
+		paths = []string{DirRel()}
+	}
+	return commitOnExit(p.name, d.Commit, paths, outcome, pointer, err)
+}
+
+// drive is Call without the commit; it sets commitAll once a capture has ended in this process.
+func (p *DriftBaseline) drive(ctx context.Context, commitAll *bool) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	d := p.deps
+	done := shedengine.OutputPointer{Path: d.Paths.BaselineReport}
+
+	scope, found, err := ReadScope(d.Paths)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	if _, statErr := os.Stat(d.Paths.BaselineReport); !found || statErr != nil {
+		note := ""
+		if found {
+			note = fmt.Sprintf("The scope is already recorded as %s; write baseline.md alone against it, and expect `lyx drift scope` to refuse a second call.", scope.Scope)
+		}
+		tables := func() (seatengine.Table, error) { return d.BaselineTable(note) }
+		agent := shedadapters.NewMultiLLMProducerSourced(p.name, tables, d.Seats, d.Now, nil)
+		outcome, pointer, err := agent.Call(ctx)
+		if err != nil || outcome != shedengine.Done {
+			return outcome, pointer, err
+		}
+		if scope, found, err = ReadScope(d.Paths); err != nil {
+			return "", shedengine.OutputPointer{}, err
+		}
+		if !found {
+			return shedengine.Stuck, shedengine.OutputPointer{Reason: "drift: the baseline agent recorded no scope; way forward: lyx loom resume, which spawns it again"}, nil
+		}
+	}
+
+	if scope.Scope == ScopeOff || scope.AwaitedAt != "" {
+		return shedengine.Done, done, nil
+	}
+
+	held, err := ProbeLock(d.Paths.CaptureLock)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	if held && !p.row.WaitCapture {
+		return shedengine.Done, done, nil
+	}
+	if held {
+		if err := awaitCaptureEnd(ctx, d.Paths, d.Sleep); err != nil {
+			return "", shedengine.OutputPointer{}, err
+		}
+	}
+	capture, captureFound, err := ReadCapture(d.Paths)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	if captureFound && capture.State == CapturePassed {
+		return shedengine.Done, done, nil
+	}
+	return p.captureAgain(ctx, commitAll)
+}
+
+// captureAgain checks the capture's precondition and takes the capture, detached or in this process.
+func (p *DriftBaseline) captureAgain(ctx context.Context, commitAll *bool) (shedengine.Outcome, shedengine.OutputPointer, error) {
+	d := p.deps
+	done := shedengine.OutputPointer{Path: d.Paths.BaselineReport}
+
+	cfg, err := d.Config()
+	if err == nil {
+		_, err = cfg.Step(stepCapture)
+	}
+	if err != nil {
+		return shedengine.Stuck, shedengine.OutputPointer{Reason: fmt.Sprintf("%v; then lyx loom resume", err)}, nil
+	}
+	refusal, err := p.checkCapture()
+	if err != nil {
+		return "", shedengine.OutputPointer{}, err
+	}
+	if refusal != nil {
+		return shedengine.Stuck, shedengine.OutputPointer{Reason: CaptureHaltPrefix + refusal.Error()}, nil
+	}
+
+	if !p.row.WaitCapture {
+		startErr := d.StartCapture()
+		switch {
+		case startErr == nil:
+			return shedengine.Done, done, nil
+		case !errors.Is(startErr, ErrBreakawayRefused):
+			return "", shedengine.OutputPointer{}, fmt.Errorf("drift: %s: start the baseline capture: %w", p.name, startErr)
+		}
+	}
+
+	*commitAll = true
+	record, err := d.RunCapture(ctx)
+	if err != nil {
+		return "", shedengine.OutputPointer{}, fmt.Errorf("drift: %s: run the baseline capture: %w", p.name, err)
+	}
+	if record.State == CapturePassed {
+		return shedengine.Done, done, nil
+	}
+	reason := fmt.Sprintf("%sthe capture ended %s (%s), log %s; way forward: lyx drift capture followed by lyx loom resume to capture again, or lyx drift defer followed by lyx loom resume to go on with regression deferred", CaptureHaltPrefix, record.State, record.Reason, record.Log)
+	return shedengine.Stuck, shedengine.OutputPointer{Reason: reason}, nil
+}
+
+// checkCapture reads the run's status, HEAD, branch point and dirty paths and returns the main capture's refusal, or nil when it may run.
+// A failed read is the error.
+func (p *DriftBaseline) checkCapture() (refusal, err error) {
+	d := p.deps
+	status, err := d.Status()
+	if err != nil {
+		return nil, err
+	}
+	head, err := d.Head()
+	if err != nil {
+		return nil, err
+	}
+	branchPoint, err := d.BranchPoint()
+	if err != nil {
+		return nil, err
+	}
+	dirty, err := d.DirtyPaths()
+	if err != nil {
+		return nil, err
+	}
+	return CheckMainCapture(status, head, branchPoint, dirty), nil
+}
