+		{"linux_test.go", "", ""},
+		{"proc_linux_test.go", "linux", ""},
+		{"x_windows_amd64_test.go", "windows", "amd64"},
+		{"x_arm64_test.go", "", "arm64"},
+		{"proc_alive_windows_test.go", "windows", ""},
